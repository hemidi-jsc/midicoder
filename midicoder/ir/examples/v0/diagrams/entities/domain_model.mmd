---
title: Domain Model
---
erDiagram

    feature_flag {
        string key PK
        string description nullable
        string state
        string rollout_percentage nullable
    }

    invoice {
        string id PK
        string organization_id
        string amount
        string status
        string issued_at
    }

    organization {
        string id PK
        string name
        string plan
        string owner_user_id
        string created_at
    }

    subscription {
        string id PK
        string organization_id
        string plan
        string status
        string current_period
    }

    user {
        string id PK
        string email
        string full_name nullable
        string status
        string tenant_id
    }

    billing_period {
        string start
        string end
    }

    contact_info {
        string email
        string phone nullable
    }

    geo_location {
        string lat
        string lng
    }

    money {
        string amount
        string currency
    }

    postal_address {
        string line1
        string city
        string country
    }

    invoice ||--|| organization : "organization_id"
    invoice ||--|| money : "amount"
    organization ||--|| user : "owner_user_id"
    subscription ||--|| organization : "organization_id"
    subscription ||--|| billing_period : "current_period"