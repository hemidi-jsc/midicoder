/**
* NotificationToastComponent — hiển thị realtime toast notifications
* Sinh bởi CP22 AngularRealtimeEmitter
*/

import { Component, Input, OnInit, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ChannelSubscriptionService } from './channel-subscription.service';

{% if ui_framework == "material" %}
import { MatAlertModule } from '@angular/material/alert';
{% elif ui_framework == "bootstrap" %}
import { NgbdModule } from 'ng-bootstrap';
{% elif ui_framework == "antd" %}
import { NzAlertModule } from 'ng-zorro-antd/alert';
{% elif ui_framework == "carbon" %}
import { NotificationModule } from '@carbon/angular';
{% endif %}

export type NotificationType = 'info' | 'success' | 'warning' | 'error';

export interface NotificationData {
id: string;
message: string;
type: NotificationType;
duration: number;
actionLabel?: string;
timestamp: string;
}

@Component({
selector: 'midicoder-notification-toast',
standalone: true,
imports: [
CommonModule,
{% if ui_framework == "material" %}
MatAlertModule,
{% elif ui_framework == "bootstrap" %}
NgbdModule,
{% elif ui_framework == "antd" %}
NzAlertModule,
{% elif ui_framework == "carbon" %}
NotificationModule,
{% endif %}
],
template: `
{% if ui_framework == "material" %}
<div [ngStyle]="positionStyle"
    style="z-index: 9999; display: flex; flex-direction: column; gap: 8px; max-width: 360px;">
    <ng-container *ngFor="let notif of notifications.slice(0, maxVisible)">
        <mat-alert [role]="alert" [type]="notif.type" (click)="dismiss(notif.id)" style="cursor: pointer;">
            {{ notif.message }}
            <br />
            <span style="font-size: 10px; opacity: 0.7;">{{ notif.timestamp | date:'HH:mm:ss' }}</span>
            <button *ngIf="notif.actionLabel" mat-button color="primary"
                (click)="$event.stopPropagation(); dismiss(notif.id)">
                {{ notif.actionLabel }}
            </button>
        </mat-alert>
    </ng-container>
    <button *ngIf="notifications.length > 0" (click)="clearAll()"
        style="align-self: flex-end; background: none; border: none; color: #666; cursor: pointer; font-size: 12px;">
        Clear all ({{ notifications.length }})
    </button>
</div>
{% elif ui_framework == "tailwind" %}
<div [ngStyle]="positionStyle" class="z-[9999] flex flex-col gap-2 max-w-[360px]">
    <ng-container *ngFor="let notif of notifications.slice(0, maxVisible)">
        <div class="p-3 rounded shadow-lg cursor-pointer border-l-4" [class]="{
            'bg-blue-50 border-blue-500': notif.type === 'info',
            'bg-green-50 border-green-500': notif.type === 'success',
            'bg-orange-50 border-orange-500': notif.type === 'warning',
            'bg-red-50 border-red-500': notif.type === 'error'
          }" (click)="dismiss(notif.id)">
            <div class="text-sm font-medium">{{ notif.message }}</div>
            <div class="text-[10px] text-gray-400 mt-1">{{ notif.timestamp | date:'HH:mm:ss' }}</div>
            <button *ngIf="notif.actionLabel" class="mt-2 px-3 py-1 text-white border-0 rounded text-sm"
                (click)="$event.stopPropagation(); dismiss(notif.id)">
                {{ notif.actionLabel }}
            </button>
        </div>
    </ng-container>
    <button *ngIf="notifications.length > 0"
        class="self-end bg-transparent border-0 text-gray-500 cursor-pointer text-xs" (click)="clearAll()">
        Clear all ({{ notifications.length }})
    </button>
</div>
{% elif ui_framework == "bootstrap" %}
<div [ngStyle]="positionStyle"
    style="z-index: 9999; display: flex; flex-direction: column; gap: 8px; max-width: 360px;">
    <ng-container *ngFor="let notif of notifications.slice(0, maxVisible)">
        <alert [variant]="notif.type" (click)="dismiss(notif.id)" style="cursor: pointer;">
            <div style="font-size: 14px; font-weight: 500;">{{ notif.message }}</div>
            <div style="font-size: 10px; color: #999; margin-top: 4px;">{{ notif.timestamp | date:'HH:mm:ss' }}</div>
            <button *ngIf="notif.actionLabel" class="btn btn-sm btn-light mt-2"
                (click)="$event.stopPropagation(); dismiss(notif.id)">
                {{ notif.actionLabel }}
            </button>
        </alert>
    </ng-container>
    <button *ngIf="notifications.length > 0" class="btn btn-sm btn-link text-end" (click)="clearAll()">
        Clear all ({{ notifications.length }})
    </button>
</div>
{% elif ui_framework == "antd" %}
<div [ngStyle]="positionStyle"
    style="z-index: 9999; display: flex; flex-direction: column; gap: 8px; max-width: 360px;">
    <ng-container *ngFor="let notif of notifications.slice(0, maxVisible)">
        <nz-alert [nzType]="notif.type" [nzMessage]="notif.message" [nzDescription]="notif.timestamp | date:'HH:mm:ss'"
            nzClosable (nzOnClose)="dismiss(notif.id)">
            <button *ngIf="notif.actionLabel" nz-button nzType="primary"
                (click)="$event.stopPropagation(); dismiss(notif.id)">
                {{ notif.actionLabel }}
            </button>
        </nz-alert>
    </ng-container>
    <button *ngIf="notifications.length > 0"
        style="align-self: flex-end; background: none; border: none; color: #666; cursor: pointer; font-size: 12px;"
        (click)="clearAll()">
        Clear all ({{ notifications.length }})
    </button>
</div>
{% elif ui_framework == "carbon" %}
<div [ngStyle]="positionStyle"
    style="z-index: 9999; display: flex; flex-direction: column; gap: 8px; max-width: 360px;">
    <ng-container *ngFor="let notif of notifications.slice(0, maxVisible)">
        <cds-toast-notification [kind]="notif.type === 'info' ? 'information' : notif.type" [title]="notif.message"
            (closeButton)="dismiss(notif.id)" [caption]="notif.timestamp | date:'HH:mm:ss'"
            [actionButtonText]="notif.actionLabel" (actionButtonClick)="dismiss(notif.id)" />
    </ng-container>
    <button *ngIf="notifications.length > 0"
        style="align-self: flex-end; background: none; border: none; color: #666; cursor: pointer; font-size: 12px;"
        (click)="clearAll()">
        Clear all ({{ notifications.length }})
    </button>
</div>
{% endif %}
`,
})
export class NotificationToastComponent implements OnInit, OnDestroy {
@Input() channel = 'notification.toast';
@Input() maxVisible = 5;
@Input() defaultDuration = 5000;
@Input() position: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left' = 'top-right';
{% if has_tenant_scope %}
@Input() tenantId?: string;
{% endif %}

notifications: NotificationData[] = [];
private timers = new Map<string, ReturnType<typeof setTimeout>>();

    typeStyles: Record<NotificationType, { bg: string; border: string }> = {
        info: { bg: '#e3f2fd', border: '#2196f3' },
        success: { bg: '#e8f5e9', border: '#4caf50' },
        warning: { bg: '#fff3e0', border: '#ff9800' },
        error: { bg: '#ffebee', border: '#f44336' },
        };

        positionStyle: Record<string, Record<string, string | number>> = {
            'top-right': { position: 'fixed', top: 16, right: 16 },
            'top-left': { position: 'fixed', top: 16, left: 16 },
            'bottom-right': { position: 'fixed', bottom: 16, right: 16 },
            'bottom-left': { position: 'fixed', bottom: 16, left: 16 },
            };

            constructor(private channelService: ChannelSubscriptionService) {}

            ngOnInit() {
            this.channelService.subscribe(this.channel{% if has_tenant_scope %}, { tenantId: this.tenantId }{% endif
            %}).subscribe((msg) => {
            const data = msg.data as Partial<NotificationData>;
                if (data && data.message) {
                const notif: NotificationData = {
                id: data.id || `notif-${Date.now()}-${Math.random()}`,
                message: data.message,
                type: data.type || 'info',
                duration: data.duration ?? this.defaultDuration,
                timestamp: data.timestamp || new Date().toISOString(),
                };
                this.notifications = [notif, ...this.notifications].slice(0, this.maxVisible * 2);
                if (notif.duration > 0) {
                this.timers.set(notif.id, setTimeout(() => this.dismiss(notif.id), notif.duration));
                }
                }
                });
                }

                dismiss(id: string) {
                this.notifications = this.notifications.filter((n) => n.id !== id);
                const timer = this.timers.get(id);
                if (timer) {
                clearTimeout(timer);
                this.timers.delete(id);
                }
                }

                clearAll() {
                this.notifications.forEach((n) => this.dismiss(n.id));
                this.timers.clear();
                }

                ngOnDestroy() {
                this.timers.forEach((t) => clearTimeout(t));
                this.timers.clear();
                }
                }