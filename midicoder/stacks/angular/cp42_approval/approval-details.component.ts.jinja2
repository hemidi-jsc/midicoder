/**
* ApprovalDetailsComponent — Chi tiet yeu cau phe duyet.
*
* Hien thi thong tin chi tiet cua mot yeu cau phe duyet cu the. Truc quan hoa
* Chuỗi phê duyệt (số bước, người phê duyệt, trạng thái). Nút phê duyệt/từ chối
* voi o nhan xet. Timeline lich su quyet dinh.
*
* Tao tu dong boi CP42 — khong sua thu cong.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
inject,
signal,
computed,
effect
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatChipsModule } from '@angular/material/chips';
import { MatStepperModule } from '@angular/material/stepper';
import { MatInputModule } from '@angular/material/input';
{% elif ui_framework == "tailwind" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
inject,
signal,
computed,
effect
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
inject,
signal,
computed,
effect
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
inject,
signal,
computed,
effect
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Ant Design khong dung cho Angular
{% elif ui_framework == "carbon" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
inject,
signal,
computed,
effect
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Carbon khong dung cho Angular
{% endif %}

import { ApprovalService } from './approval.service';
import { ApprovalStore } from './approval.store';
import {
ApprovalRequest,
ApprovalStep,
ApprovalDecision,
ApprovalStatus,
ApprovalType,
ApprovalEvent
} from './approval-types';

// ===========================================================================
// Cấu hình từ template
// ===========================================================================

/** Cờ bật hệ thống sự kiện realtime. */
const USE_EVENTS: boolean = {{ 'true' if use_events else 'false' }};

/** Số bước phê duyệt mẫu. */
const NUM_STEPS: number = {{ num_steps }};

/**
* ApprovalDetailsComponent — Chi tiết yêu cầu phê duyệt.
*
* Sử dụng:
* <app-approval-details [requestId]="'req_123'"></app-approval-details>
*/
@Component({
selector: 'app-approval-details',
standalone: true,
imports: [CommonModule, FormsModule],
changeDetection: ChangeDetectionStrategy.OnPush,

template:
{% raw %}
`
<div class="approval-details" *ngIf="currentRequest(); else noRequest">
    <!-- Đầu trang: thông tin yêu cầu -->
    <header class="details-header">
        <div class="header-main">
            <h1>{{ currentRequest()?.title || 'Chi Tiết Phê Duyệt' }}</h1>
            <span class="request-id">#{{ currentRequest()?.requestId }}</span>
        </div>
        <div class="header-status">
            <span class="status-badge" [class]="getStatusClass(currentRequest()?.status)">
                {{ getStatusLabel(currentRequest()?.status) }}
            </span>
            <span class="type-badge">{{ getTypeLabel(currentRequest()?.approvalType) }}</span>
        </div>
    </header>

    <!-- Mô tả -->
    <section class="description-section">
        <h2>Mô Tả</h2>
        <p class="description-text">{{ currentRequest()?.description || 'Không có mô tả' }}</p>
    </section>

    <!-- Thông tin metadata -->
    <section class="metadata-section">
        <h2>Thông Tin</h2>
        <div class="metadata-grid">
            <div class="meta-item">
                <span class="meta-label">Người khởi tạo:</span>
                <span class="meta-value">{{ currentRequest()?.initiatorId }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Loại thực thể:</span>
                <span class="meta-value">{{ currentRequest()?.entityType }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">ID thực thể:</span>
                <span class="meta-value">{{ currentRequest()?.entityId }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Ngày tạo:</span>
                <span class="meta-value">{{ currentRequest()?.createdAt | date:'dd/MM/yyyy HH:mm' }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Thời hạn:</span>
                <span class="meta-value deadline" [class.overdue]="isDeadlinePassed()">
                    {{ currentRequest()?.deadline | date:'dd/MM/yyyy HH:mm' }}
                </span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Bước hiện tại:</span>
                <span class="meta-value">{{ currentRequest()?.currentStep }}/{{ currentRequest()?.totalSteps }}</span>
            </div>
        </div>
    </section>

    <!-- Trực quan hóa chuỗi phê duyệt -->
    <section class="chain-section">
        <h2>Chuỗi Phê Duyệt</h2>
        <div class="chain-container">
            <div class="chain-step" *ngFor="let step of stepsForCurrentRequest(); let i = index; let last = last"
                [class]="getStepClass(step)">
                <!-- Số bước và trạng thái -->
                <div class="step-node">
                    <span class="step-number">{{ step.stepNumber }}</span>
                    <span class="step-status-icon" [class]="getStepIconClass(step.status)">
                        {{ getStepIcon(step.status) }}
                    </span>
                </div>

                <!-- Thông tin bước -->
                <div class="step-info">
                    <div class="step-approver">
                        <span class="approver-label">Người phê duyệt:</span>
                        <span class="approver-id">{{ step.approverId }}</span>
                    </div>
                    <div class="step-role">
                        <span class="role-label">Vai trò:</span>
                        <span class="role-value">{{ step.approverRole }}</span>
                    </div>
                    <div class="step-deadline">
                        <span>Hạn: {{ step.actionDeadline | date:'dd/MM/yyyy HH:mm' }}</span>
                    </div>
                </div>

                <!-- Nút kết nối sang bước tiếp theo -->
                <div class="step-connector" *ngIf="!last">
                    <span class="connector-line"></span>
                    <span class="connector-arrow">{{ isStepCompleted(step) ? '→' : '↓' }}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Khu vực ra quyết định (chỉ hiển thị nếu là người phê duyệt hiện tại) -->
    <section class="decision-section" *ngIf="canDecide()">
        <h2>Quyết Định Của Bạn</h2>
        <div class="decision-form">
            <div class="decision-buttons">
                <button class="btn-decide btn-approve" (click)="onApprove()" [disabled]="isDeciding()">
                    {{ isDeciding() ? 'Đang xử lý...' : '✓ Phê Duyệt' }}
                </button>
                <button class="btn-decide btn-reject" (click)="onReject()" [disabled]="isDeciding()">
                    {{ isDeciding() ? 'Đang xử lý...' : '✕ Từ Chối' }}
                </button>
            </div>
            <div class="comment-area">
                <label for="decision-comment">Nhận xét (tùy chọn):</label>
                <textarea id="decision-comment" [(ngModel)]="decisionComment"
                    placeholder="Nhập lý do phê duyệt hoặc từ chối..." rows="3" [disabled]="isDeciding()"></textarea>
            </div>
        </div>
    </section>

    <!-- Timeline lịch sử quyết định -->
    <section class="history-section">
        <h2>Lịch Sử Quyết Định</h2>
        <div class="timeline" *ngIf="decisionHistory().length; else noHistory">
            <div class="timeline-item" *ngFor="let decision of decisionHistory()" [class]="decision.decision">
                <div class="timeline-dot" [class.approved]="decision.decision === 'approved'"
                    [class.rejected]="decision.decision === 'rejected'"></div>
                <div class="timeline-content">
                    <div class="timeline-header">
                        <span class="timeline-action" [class]="decision.decision">
                            {{ decision.decision === 'approved' ? '✓ Đã Phê Duyệt' : '✕ Đã Từ Chối' }}
                        </span>
                        <span class="timeline-approver">{{ decision.approverId }}</span>
                    </div>
                    <div class="timeline-comment" *ngIf="decision.comment">
                        {{ decision.comment }}
                    </div>
                    <div class="timeline-time">
                        {{ decision.createdAt | date:'dd/MM/yyyy HH:mm:ss' }}
                    </div>
                </div>
            </div>
        </div>
        <ng-template #noHistory>
            <div class="empty-history">
                <p>Chưa có quyết định nào. Đây là bước phê duyệt đầu tiên.</p>
            </div>
        </ng-template>
    </section>
</div>

<!-- Trạng thái khi không có yêu cầu -->
<ng-template #noRequest>
    <div class="no-request">
        <p>Không có yêu cầu phê duyệt nào được chọn.</p>
        <button class="btn-back" (click)="onGoBack()">Quay Lại Danh Sách</button>
    </div>
</ng-template>
`,
{% endraw %}
