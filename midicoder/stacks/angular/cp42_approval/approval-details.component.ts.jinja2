})
export class ApprovalDetailsComponent implements OnInit, OnDestroy {
// ===========================================================================
// Inject dependencies
// ===========================================================================

private readonly approvalService = inject(ApprovalService);
private readonly approvalStore = inject(ApprovalStore);

// ===========================================================================
// Local state
// ===========================================================================

/** Nhận xét khi ra quyết định. */
public decisionComment: string = '';

/** Cờ đang xử lý quyết định. */
public readonly isDeciding = signal<boolean>(false);

    /** ID yêu cầu phê duyệt hiện tại. */
    private currentRequestId: string | null = null;

    // ===========================================================================
    // Computed từ store
    // ===========================================================================

    /** Yêu cầu đang xem chi tiết. */
    public readonly currentRequest = this.approvalStore.currentRequest;

    /** Danh sách tất cả bước phê duyệt. */
    private readonly allSteps = this.approvalStore.steps;

    /** Danh sách tất cả quyết định. */
    private readonly allDecisions = this.approvalStore.decisions;

    /** Các bước thuộc yêu cầu hiện tại (sắp xếp theo stepNumber). */
    public readonly stepsForCurrentRequest = computed<ApprovalStep[]>(() => {
        const requestId = this.currentRequest()?.requestId;
        if (!requestId) return [];
        return this.allSteps()
        .filter(s => s.requestId === requestId)
        .sort((a, b) => a.stepNumber - b.stepNumber);
        });

        /** Lịch sử quyết định của yêu cầu hiện tại (sắp xếp theo thời gian). */
        public readonly decisionHistory = computed<ApprovalDecision[]>(() => {
            const requestId = this.currentRequest()?.requestId;
            if (!requestId) return [];
            return this.allDecisions()
            .filter(d => d.requestId === requestId)
            .sort((a, b) => {
            const aTime = a.createdAt ? new Date(a.createdAt).getTime() : 0;
            const bTime = b.createdAt ? new Date(b.createdAt).getTime() : 0;
            return aTime - bTime;
            });
            });

            /** Người dùng hiện tại có thể ra quyết định cho yêu cầu này không. */
            public readonly canDecide = computed<boolean>(() => {
                const request = this.currentRequest();
                if (!request) return false;
                // Chỉ cho phép quyết định khi trạng thái là pending.
                if (request.status !== ApprovalStatus.PENDING) return false;
                // TODO: Kiểm tra người dùng hiện tại có phải là approver của bước hiện tại.
                return true;
                });

                /** Thời hạn có đã qua chưa. */
                public readonly isDeadlinePassed = computed<boolean>(() => {
                    const request = this.currentRequest();
                    if (!request?.deadline) return false;
                    return new Date(request.deadline).getTime() < Date.now(); });
                        //===========================================================================// Effect — tải dữ
                        liệu phụ thuộc khi có currentRequest
                        //===========================================================================private readonly
                        dataLoadEffect=effect(()=> {
                        const req = this.currentRequest();
                        if (req) {
                        this.currentRequestId = req.requestId;
                        // Tải các bước của yêu cầu.
                        this.approvalService.fetchSteps(req.requestId).subscribe(steps => {
                        // Store will update automatically via service events.
                        });
                        // Tải lịch sử quyết định.
                        this.approvalService.fetchDecisions(req.requestId).subscribe();
                        }
                        });

                        // ===========================================================================
                        // Lifecycle
                        // ===========================================================================

                        ngOnInit(): void {
                        // Lắng nghe sự kiện realtime cho yêu cầu hiện tại.
                        if (USE_EVENTS) {
                        this.approvalService.connectWebSocket().pipe(takeUntilDestroyed()).subscribe();
                        this.approvalService.events$.pipe(takeUntilDestroyed()).subscribe((event: ApprovalEvent) => {
                        this.handleRealtimeEvent(event);
                        });
                        }
                        }

                        ngOnDestroy(): void {
                        // Dọn dẹp effect khi hủy component.
                        // (Angular tự động dọn effect khi component bị hủy)
                        }

                        // ===========================================================================
                        // Xử lý quyết định
                        // ===========================================================================

                        /**
                        * Xử lý khi nhấn nút phê duyệt.
                        */
                        onApprove(): void {
                        const request = this.currentRequest();
                        if (!request) return;

                        this.isDeciding.set(true);
                        this.approvalService.decide(request.requestId, 'approved', this.decisionComment)
                        .pipe(takeUntilDestroyed())
                        .subscribe({
                        next: () => {
                        this.decisionComment = '';
                        this.isDeciding.set(false);
                        },
                        error: (err) => {
                        console.error('[ApprovalDetails] Lỗi khi phê duyệt:', err);
                        this.isDeciding.set(false);
                        }
                        });
                        }

                        /**
                        * Xử lý khi nhấn nút từ chối.
                        */
                        onReject(): void {
                        const request = this.currentRequest();
                        if (!request) return;

                        this.isDeciding.set(true);
                        this.approvalService.decide(request.requestId, 'rejected', this.decisionComment)
                        .pipe(takeUntilDestroyed())
                        .subscribe({
                        next: () => {
                        this.decisionComment = '';
                        this.isDeciding.set(false);
                        },
                        error: (err) => {
                        console.error('[ApprovalDetails] Lỗi khi từ chối:', err);
                        this.isDeciding.set(false);
                        }
                        });
                        }

                        // ===========================================================================
                        // Xử lý sự kiện realtime
                        // ===========================================================================

                        /**
                        * Xử lý sự kiện realtime — chỉ quan tâm đến yêu cầu hiện tại.
                        */
                        private handleRealtimeEvent(event: ApprovalEvent): void {
                        if (event.requestId !== this.currentRequestId) return;

                        switch (event.eventType) {
                        case 'decision_made':
                        this.approvalStore.addDecision(event.payload as any);
                        break;
                        case 'request_updated':
                        this.approvalStore.updateRequest(event.requestId, event.payload as any);
                        break;
                        case 'escalated':
                        this.approvalStore.escalateRequest(event.requestId);
                        break;
                        default:
                        // Không xử lý các sự kiện khác cho trang chi tiết.
                        break;
                        }
                        }

                        // ===========================================================================
                        // Điều hướng
                        // ===========================================================================

                        /**
                        * Quay lại danh sách yêu cầu.
                        */
                        onGoBack(): void {
                        this.approvalStore.clearCurrentRequest();
                        }

                        // ===========================================================================
                        // Helper methods
                        // ===========================================================================

                        /**
                        * Lấy class CSS cho trạng thái yêu cầu.
                        */
                        getStatusClass(status: string | undefined): string {
                        return status ? 'status-' + status : '';
                        }

                        /**
                        * Lấy nhãn tiếng Việt cho trạng thái yêu cầu.
                        */
                        getStatusLabel(status: string | undefined): string {
                        if (!status) return 'Không rõ';
                        const labelMap: Record<string, string> = {
                            pending: 'Đang chờ',
                            approved: 'Đã phê duyệt',
                            rejected: 'Đã từ chối',
                            escalated: 'Đã leo thang',
                            delegated: 'Đã ủy quyền',
                            expired: 'Hết hạn',
                            cancelled: 'Đã hủy'
                            };
                            return labelMap[status] || status;
                            }

                            /**
                            * Lấy nhãn tiếng Việt cho loại phê duyệt.
                            */
                            getTypeLabel(type: string | undefined): string {
                            if (!type) return '';
                            const labelMap: Record<string, string> = {
                                sequential: 'Tuần tự',
                                parallel: 'Song song',
                                matrix: 'Ma trận',
                                voting: 'Biểu quyết',
                                single: 'Đơn lẻ'
                                };
                                return labelMap[type] || type;
                                }

                                /**
                                * Lấy class CSS cho bước phê duyệt.
                                */
                                getStepClass(step: ApprovalStep): string {
                                const request = this.currentRequest();
                                if (!request) return '';

                                // Bước hiện tại.
                                if (step.stepNumber === request.currentStep) {
                                return 'current';
                                }
                                // Bước đã hoàn thành.
                                if (step.stepNumber < request.currentStep) { return 'completed ' + step.status; } //
                                    Bước tiếp theo (chưa đến lượt). return 'blocked' ; } /** * Kiểm tra bước có đã hoàn
                                    thành chưa. */ isStepCompleted(step: ApprovalStep): boolean { return
                                    step.status===ApprovalStatus.APPROVED || step.status===ApprovalStatus.REJECTED ||
                                    step.status===ApprovalStatus.ESCALATED; } /** * Lấy class CSS cho icon trạng thái
                                    bước. */ getStepIconClass(status: string): string { return 'icon-' + status; } /** *
                                    Lấy icon cho trạng thái bước. */ getStepIcon(status: string): string { const
                                    iconMap: Record<string, string> = {
                                    pending: '⏳',
                                    approved: '✓',
                                    rejected: '✗',
                                    escalated: '↑',
                                    delegated: '⇄',
                                    expired: '⏰',
                                    cancelled: '⊘'
                                    };
                                    return iconMap[status] || '?';
                                    }
                                    }