/** Button Component - Versatile button with multiple variants and states. */

import { Component, Input, Output, EventEmitter, OnInit, HostBinding } from "@angular/core";
import { CommonModule } from "@angular/common";
{% if ui_framework == "material" %}
import { MatButtonModule } from "@angular/material/button";
import { MatIconModule } from "@angular/material/icon";
{% endif %}

export type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'text' | 'danger';
export type ButtonSize = 'sm' | 'md' | 'lg';

@Component({
  selector: 'app-button',
  standalone: true,
  imports: [
    CommonModule,
    {% if ui_framework == "material" %}
    MatButtonModule,
    MatIconModule,
    {% endif %}
  ],
  template: `
{% if ui_framework == "material" %}
<button
  mat-flat-button
  [color]="materialColor"
  [disabled]="isDisabled"
  [ngClass]="{'mat-button-raised': variant === 'outline', 'mat-button-unthemed': variant === 'text'}"
  [matTooltip]="tooltip"
  (click)="onClick($event)"
>
  <mat-icon *ngIf="iconPosition === 'before' && icon">{% raw %}{{ icon }}{% endraw %}</mat-icon>
  <span>{% raw %}{{ label }}{% endraw %}</span>
  <mat-icon *ngIf="iconPosition === 'after' && icon">{% raw %}{{ icon }}{% endraw %}</mat-icon>
  <mat-progress-spinner *ngIf="isLoading" diameter="16" mode="indeterminate"></mat-progress-spinner>
</button>
{% elif ui_framework == "tailwind" %}
<button
  [ngClass]="buttonClasses"
  [ngStyle]="buttonStyles"
  [disabled]="isDisabled"
  (click)="onClick($event)"
  type="{% raw %}{{ type }}{% endraw %}"
>
  <span *ngIf="isLoading" class="inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin me-2"></span>
  <span *ngIf="iconPosition === 'before' && icon" class="me-2">{% raw %}{{ icon }}{% endraw %}</span>
  <span>{% raw %}{{ label }}{% endraw %}</span>
  <span *ngIf="iconPosition === 'after' && icon" class="ms-2">{% raw %}{{ icon }}{% endraw %}</span>
</button>
{% elif ui_framework == "bootstrap" %}
<button
  [ngClass]="'btn ' + bootstrapClasses"
  [disabled]="isDisabled"
  (click)="onClick($event)"
  type="{% raw %}{{ type }}{% endraw %}"
>
  <span *ngIf="isLoading" class="spinner-border spinner-border-sm me-2" role="status"></span>
  {% raw %}{{ label }}{% endraw %}
</button>
{% elif ui_framework == "antd" %}
<button
  [ngClass]="'ant-btn ' + antdClasses"
  [disabled]="isDisabled"
  (click)="onClick($event)"
  type="{% raw %}{{ type }}{% endraw %}"
>
  <span *ngIf="isLoading" class="ant-btn-icon-a">
    <i class="anticon anticon-loading">
      <svg viewBox="64 64 896 896" width="1em"><path fill="currentColor" d="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z"/><path fill="currentColor" d="M846.5 411.5l-51.8 24.6c-4.3 2-7.3 6.2-8 10.9-6.5 44-30.6 82.9-67 108.2-36.4 25.3-80.9 34.6-124.1 25.9-4.8-1-9.8 0.8-13.2 4.6l-33.9 37.8c-3.2 3.6-3.8 8.8-1.5 13 20.7 38.2 53.9 67.5 94.1 82.5 40.2 15 84.2 14.3 123.9-2 39.7-16.3 71.7-46.3 90.5-84.5 18.8-38.2 22.7-81.7 11.1-122.5-1.3-4.5-0.3-9.4 2.7-12.9l40.5-46.3c3.6-4.1 4.3-10 1.7-14.8-2.6-4.8-8-7.3-13.3-6z"/></svg>
    </i>
  </span>
  {% raw %}{{ label }}{% endraw %}
</button>
{% elif ui_framework == "carbon" %}
<button
  [ngClass]="'cds--btn ' + carbonClasses"
  [disabled]="isDisabled"
  (click)="onClick($event)"
  type="{% raw %}{{ type }}{% endraw %}"
>
  {% raw %}{{ label }}{% endraw %}
</button>
{% endif %}
  `,
})
export class ButtonComponent implements OnInit {
  @Input() label: string = 'Button';
  @Input() variant: ButtonVariant = 'primary';
  @Input() size: ButtonSize = 'md';
  @Input() isDisabled: boolean = false;
  @Input() isLoading: boolean = false;
  @Input() isFullWidth: boolean = false;
  @Input() icon: string = '';
  @Input() iconPosition: 'before' | 'after' = 'before';
  @Input() tooltip: string = '';
  @Input() type: 'button' | 'submit' | 'reset' = 'button';
  @Output() click = new EventEmitter<Event>();

  ngOnInit() {}

  get materialColor(): 'primary' | 'accent' | 'warn' {
    const map: Record<string, 'primary' | 'accent' | 'warn'> = {
      primary: 'primary',
      secondary: 'accent',
      danger: 'warn',
      outline: 'primary',
      text: 'primary',
    };
    return map[this.variant] || 'primary';
  }

  get buttonClasses(): string {
    const base = 'inline-flex items-center justify-center font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2';
    const variantMap: Record<string, string> = {
      primary: 'bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-500',
      secondary: 'bg-gray-200 text-gray-800 hover:bg-gray-300 focus:ring-gray-500',
      outline: 'border border-gray-300 text-gray-700 hover:bg-gray-50 focus:ring-blue-500',
      text: 'text-blue-600 hover:bg-blue-50 focus:ring-blue-500',
      danger: 'bg-red-600 text-white hover:bg-red-700 focus:ring-red-500',
    };
    const sizeMap: Record<string, string> = {
      sm: 'px-3 py-1.5 text-sm',
      md: 'px-4 py-2 text-sm',
      lg: 'px-6 py-3 text-base',
    };
    const disabled = this.isDisabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer';
    const fullWidth = this.isFullWidth ? 'w-full' : '';
    return `${base} ${variantMap[this.variant] || variantMap.primary} ${sizeMap[this.size] || sizeMap.md} ${disabled} ${fullWidth}`;
  }

  get buttonStyles(): { [key: string]: string } {
    const styles: { [key: string]: string } = {};
    if (this.isFullWidth) styles.width = '100%';
    return styles;
  }

  get bootstrapClasses(): string {
    const variantMap: Record<string, string> = {
      primary: 'btn-primary',
      secondary: 'btn-secondary',
      outline: 'btn-outline-primary',
      text: 'btn-link',
      danger: 'btn-danger',
    };
    return variantMap[this.variant] || 'btn-primary';
  }

  get antdClasses(): string {
    const variantMap: Record<string, string> = {
      primary: 'ant-btn-primary',
      secondary: '',
      outline: 'ant-btn-outline',
      text: 'ant-btn-text',
      danger: 'ant-btn-dangerous',
    };
    const sizeMap: Record<string, string> = {
      sm: 'ant-btn-sm',
      md: '',
      lg: 'ant-btn-lg',
    };
    return `${variantMap[this.variant] || ''} ${sizeMap[this.size] || ''}`.trim();
  }

  get carbonClasses(): string {
    const variantMap: Record<string, string> = {
      primary: 'cds--btn--primary',
      secondary: 'cds--btn--secondary',
      outline: 'cds--btn--ghost',
      text: 'cds--btn--tertiary',
      danger: 'cds--btn--danger',
    };
    const sizeMap: Record<string, string> = {
      sm: 'cds--btn--sm',
      md: '',
      lg: 'cds--btn--lg',
    };
    return `${variantMap[this.variant] || ''} ${sizeMap[this.size] || ''}`.trim();
  }

  onClick(event: Event) {
    if (!this.isDisabled) {
      this.click.emit(event);
    }
  }
}
