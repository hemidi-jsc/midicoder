/*
 * Midicoder CP19 - Data Input: FileUpload
 * Standalone file upload component with drag-and-drop support.
 */
import { Component, Input, forwardRef, Output, EventEmitter } from '@angular/core';
import { ControlValueAccessor, NG_VALUE_ACCESSOR, ReactiveFormsModule, AbstractControl, FormGroup, FormControl } from '@angular/forms';
import { CommonModule } from '@angular/common';

export interface UploadedFile {
  file: File;
  name: string;
  size: number;
  type: string;
  preview?: string;
  progress?: number;
}

@Component({
  selector: 'app-file-upload',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  providers: [
    {
      provide: NG_VALUE_ACCESSOR,
      useExisting: forwardRef(() => FileUploadComponent),
      multi: true,
    },
  ],
  template: `
{% if ui_framework == "material" %}
<div class="w-full">
  {% if label %}<div style="font-weight:500; margin-bottom:8px;">{{ label }}{% if required %} <span style="color:#d32f2f;">*</span>{% endif %}</div>{% endif %}
  <div (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
       [style.borderColor]="isDragging ? '#3f51b5' : (hasError ? '#d32f2f' : '#e0e0e0')"
       style="border:2px dashed #e0e0e0; border-radius:8px; padding:24px; text-align:center; cursor:pointer; transition:border-color 0.3s; background:{{ isDragging ? '#e8eaf6' : '#fff' }};"
       (click)="fileInput.click()">
    <input #fileInput type="file" [multiple]="multiple" [accept]="accept" (change)="onFileSelected($event)" style="display:none;" />
    <div style="font-size:48px; color:#9e9e9e;">&#128193;</div>
    <div style="font-size:14px; color:#757575; margin-top:8px;">
      {{ isDragging ? 'Drop files here' : ('Drag & drop files here or ' + '<span style="color:#3f51b5; text-decoration:underline;">browse</span>') }}
    </div>
    <div style="font-size:12px; color:#bdbdbd; margin-top:4px;">{{ acceptHint }}</div>
  </div>
  {% if uploadedFiles.length > 0 %}
  <div style="margin-top:12px;">
    <div *ngFor="let f of uploadedFiles" style="display:flex; align-items:center; padding:8px; border:1px solid #e0e0e0; border-radius:4px; margin-bottom:4px;">
      <img *ngIf="f.preview" [src]="f.preview" style="width:40px; height:40px; object-fit:cover; border-radius:4px; margin-right:8px;" />
      <span *ngIf="!f.preview" style="font-size:24px; margin-right:8px;">&#128196;</span>
      <div style="flex:1; min-width:0;">
        <div style="font-size:13px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ f.name }}</div>
        <div style="font-size:11px; color:#757575;">{{ formatSize(f.size) }}</div>
      </div>
      <button (click)="removeFile(f)" style="background:none; border:none; cursor:pointer; color:#d32f2f; font-size:18px;">&times;</button>
    </div>
  </div>
  {% endif %}
  {% if hint %}<div style="margin-top:4px; font-size:12px; color:#757575;">{{ hint }}</div>{% endif %}
</div>

{% elif ui_framework == "tailwind" %}
<div class="w-full">
  {% if label %}<label class="block text-sm font-medium text-gray-700 mb-1">{{ label }}{% if required %} <span class="text-red-500">*</span>{% endif %}</label>{% endif %}
  <div (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
       class="border-2 border-dashed rounded-lg p-6 text-center cursor-pointer transition-colors"
       [class.border-blue-500.bg-blue-50]="isDragging"
       [class.border-red-300]="hasError && !isDragging"
       [class.border-gray-300]="!isDragging && !hasError"
       (click)="fileInput.click()">
    <input #fileInput type="file" [multiple]="multiple" [accept]="accept" (change)="onFileSelected($event)" class="hidden" />
    <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
      <path d="M28 8H12a4 4 0 00-4 4v20m32-12v20a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-9-9m0 0l-9 9m9-9V12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <p class="mt-2 text-sm text-gray-600">
      {{ isDragging ? 'Drop files here' : 'Drag & drop or <span class="text-blue-600 underline">browse</span> }}
    </p>
    <p class="mt-1 text-xs text-gray-500">{{ acceptHint }}</p>
  </div>
  {% if uploadedFiles.length > 0 %}
  <div class="mt-3 space-y-2">
    <div *ngFor="let f of uploadedFiles" class="flex items-center p-2 border border-gray-200 rounded">
      <img *ngIf="f.preview" [src]="f.preview" class="w-10 h-10 object-cover rounded mr-2" />
      <span *ngIf="!f.preview" class="text-2xl mr-2">&#128196;</span>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium truncate">{{ f.name }}</div>
        <div class="text-xs text-gray-500">{{ formatSize(f.size) }}</div>
      </div>
      <button (click)="removeFile(f)" class="text-red-500 hover:text-red-700 text-lg">&times;</button>
    </div>
  </div>
  {% endif %}
  {% if hint %}<p class="mt-1 text-sm text-gray-500">{{ hint }}</p>{% endif %}
</div>

{% elif ui_framework == "bootstrap" %}
<div class="w-100">
  {% if label %}<label class="form-label">{{ label }}{% if required %} <span class="text-danger">*</span>{% endif %}</label>{% endif %}
  <div (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
       [ngClass]="{'border-primary bg-light': isDragging, 'border-danger': hasError}"
       class="border-2 border-dashed rounded p-4 text-center cursor-pointer" style="border-color:{{ isDragging ? '0d6efd' : (hasError ? 'dc3545' : 'dee2e6') }};"
       (click)="fileInput.click()">
    <input #fileInput type="file" [multiple]="multiple" [accept]="accept" (change)="onFileSelected($event)" class="d-none" />
    <div class="fs-1 text-muted">&#128193;</div>
    <small class="text-muted">{{ isDragging ? 'Drop files here' : 'Drag & drop or browse' }}</small>
    <br /><small class="text-muted">{{ acceptHint }}</small>
  </div>
  {% if uploadedFiles.length > 0 %}
  <div class="mt-2">
    <div *ngFor="let f of uploadedFiles" class="d-flex align-items-center p-2 border rounded mb-1">
      <img *ngIf="f.preview" [src]="f.preview" class="w-25 me-2" style="height:40px; object-fit:cover;" />
      <span *ngIf="!f.preview" class="fs-4 me-2">&#128196;</span>
      <div class="flex-grow-1 text-truncate">
        <small class="fw-bold">{{ f.name }}</small>
        <br /><small class="text-muted">{{ formatSize(f.size) }}</small>
      </div>
      <button (click)="removeFile(f)" class="btn btn-sm btn-outline-danger">&times;</button>
    </div>
  </div>
  {% endif %}
  {% if hint %}<small class="form-text text-muted">{{ hint }}</small>{% endif %}
</div>

{% elif ui_framework == "antd" %}
<div style="width:100%; margin-bottom:16px;">
  {% if label %}<div style="font-size:14px; margin-bottom:4px; color:#262626;">{{ label }}{% if required %} <span style="color:#ff4d4f;">*</span>{% endif %}</div>{% endif %}
  <div (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
       style="border:2px dashed #d9d9d9; border-radius:6px; padding:24px; text-align:center; cursor:pointer; transition:border-color 0.3s;"
       [style.borderColor]="isDragging ? '#1677ff' : (hasError ? '#ff4d4f' : '#d9d9d9')"
       [style.background]="isDragging ? '#e6f4ff' : '#fff'"
       (click)="fileInput.click()">
    <input #fileInput type="file" [multiple]="multiple" [accept]="accept" (change)="onFileSelected($event)" style="display:none;" />
    <div style="font-size:32px; color:#bfbfbf;">&#128193;</div>
    <div style="font-size:14px; color:#8c8c8c; margin-top:8px;">
      {{ isDragging ? 'Drop files here' : 'Click or drag file to upload' }}
    </div>
    <div style="font-size:12px; color:#bfbfbf;">{{ acceptHint }}</div>
  </div>
  {% if uploadedFiles.length > 0 %}
  <div style="margin-top:12px;">
    <div *ngFor="let f of uploadedFiles" style="display:flex; align-items:center; padding:8px; border:1px solid #f0f0f0; border-radius:4px; margin-bottom:4px;">
      <span style="font-size:20px; margin-right:8px;">&#128196;</span>
      <div style="flex:1; min-width:0;">
        <div style="font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ f.name }}</div>
        <div style="font-size:11px; color:#8c8c8c;">{{ formatSize(f.size) }}</div>
      </div>
      <button (click)="removeFile(f)" style="background:none; border:none; cursor:pointer; color:#ff4d4f;">&times;</button>
    </div>
  </div>
  {% endif %}
  {% if hint %}<div style="color:#8c8c8c; font-size:12px; margin-top:4px;">{{ hint }}</div>{% endif %}
</div>

{% elif ui_framework == "carbon" %}
<div style="width:100%; margin-bottom:1rem;">
  {% if label %}<div style="font-size:0.75rem; font-weight:400; color:#525252; margin-bottom:0.25rem;">{{ label }}{% if required %} <span style="color:#da1e28;">*</span>{% endif %}</div>{% endif %}
  <div (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
       style="border:2px dashed #8d8d8d; padding:1.5rem; text-align:center; cursor:pointer; transition:border-color 0.3s;"
       [style.borderColor]="isDragging ? '#0f62fe' : (hasError ? '#da1e28' : '#8d8d8d')"
       [style.background]="isDragging ? '#edf5ff' : '#fff'"
       (click)="fileInput.click()">
    <input #fileInput type="file" [multiple]="multiple" [accept]="accept" (change)="onFileSelected($event)" style="display:none;" />
    <div style="font-size:32px; color:#8d8d8d;">&#128193;</div>
    <div style="font-size:0.875rem; color:#6f6f6f; margin-top:0.5rem;">
      {{ isDragging ? 'Drop files here' : 'Click or drag file to upload' }}
    </div>
  </div>
  {% if uploadedFiles.length > 0 %}
  <div style="margin-top:0.75rem;">
    <div *ngFor="let f of uploadedFiles" style="display:flex; align-items:center; padding:0.5rem; border:1px solid #e0e0e0; margin-bottom:0.25rem;">
      <span style="font-size:20px; margin-right:0.5rem;">&#128196;</span>
      <div style="flex:1; min-width:0;">
        <div style="font-size:0.875rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ f.name }}</div>
        <div style="font-size:0.75rem; color:#6f6f6f;">{{ formatSize(f.size) }}</div>
      </div>
      <button (click)="removeFile(f)" style="background:none; border:none; cursor:pointer; color:#da1e28;">&times;</button>
    </div>
  </div>
  {% endif %}
  {% if hint %}<p style="font-size:0.75rem; color:#6f6f6f; margin:0.25rem 0;">{{ hint }}</p>{% endif %}
</div>

{% endif %}
  `,
})
export class FileUploadComponent implements ControlValueAccessor {
  @Input() label = '';
  @Input() hint = '';
  @Input() required = false;
  @Input() disabled = false;
  @Input() multiple = false;
  @Input() accept = '*/*';
  @Input() maxFileSize = 10 * 1024 * 1024; // 10MB default
  @Output() filesChanged = new EventEmitter<UploadedFile[]>();

  protected uploadedFiles: UploadedFile[] = [];
  protected isDragging = false;
  protected hasError = false;
  protected control: AbstractControl | null = null;

  get acceptHint(): string {
    if (this.accept === '*/*') return 'Any file type';
    return `Accepted: ${this.accept}`;
  }

  private _onChange: (value: any) => void = () => {};
  private _onTouched: () => void = () => {};

  writeValue(value: any): void {
    if (value) this.uploadedFiles = value;
  }
  registerOnChange(fn: any): void { this._onChange = fn; }
  registerOnTouched(fn: any): void { this._onTouched = fn; }
  setDisabledState(isDisabled: boolean): void { this.disabled = isDisabled; }

  onDragOver(event: DragEvent): void {
    event.preventDefault();
    this.isDragging = true;
  }

  onDragLeave(): void {
    this.isDragging = false;
  }

  onDrop(event: DragEvent): void {
    event.preventDefault();
    this.isDragging = false;
    if (event.dataTransfer?.files) {
      this.processFiles(Array.from(event.dataTransfer.files));
    }
  }

  onFileSelected(event: Event): void {
    const input = event.target as HTMLInputElement;
    if (input.files) {
      this.processFiles(Array.from(input.files));
    }
  }

  private processFiles(files: File[]): void {
    for (const file of files) {
      if (file.size > this.maxFileSize) {
        this.hasError = true;
        continue;
      }
      const uploaded: UploadedFile = {
        file,
        name: file.name,
        size: file.size,
        type: file.type,
      };
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = () => {
          uploaded.preview = reader.result as string;
          this._onChange([...this.uploadedFiles]);
        };
        reader.readAsDataURL(file);
      }
      this.uploadedFiles.push(uploaded);
    }
    this._onChange([...this.uploadedFiles]);
    this.filesChanged.emit([...this.uploadedFiles]);
  }

  removeFile(file: UploadedFile): void {
    this.uploadedFiles = this.uploadedFiles.filter((f) => f !== file);
    this._onChange([...this.uploadedFiles]);
    this.filesChanged.emit([...this.uploadedFiles]);
  }

  formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }
}
