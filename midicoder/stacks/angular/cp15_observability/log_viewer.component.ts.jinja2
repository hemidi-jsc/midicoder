{#
Jinja2 template cho Log Viewer Component — Angular với Signal-based state.

Tự động generate component hiển thị bảng log với filter (level/service/time range),
search input, pagination, và log detail drawer.

Usage:
context = {
"service_name": "my-service",
}
template.render(**context)

Author: Midicoder Team
Version: 1.0.0
#}

/**
* Log Viewer Component — Angular với Signal-based state
*
* Tự động generate — không sửa tay.
*
* Pattern: B12 — Log Viewer & Search UI (CP15)
*
* Mục đích:
* - Hiển thị bảng log entries với filter theo level, service, time range
* - Tìm kiếm theo từ khóa với debounce
* - Phân trang
* - Log detail drawer để xem chi tiết
*
* Usage:
* <app-log-viewer [serviceName]="'my-service'"></app-log-viewer>
*/
import {
Component,
signal,
computed,
effect,
OnInit,
OnDestroy,
ChangeDetectionStrategy,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Subject } from 'rxjs';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';

/**
* LogLevel — mức độ log entry.
*/
export type LogLevel = 'DEBUG' | 'INFO' | 'WARN' | 'ERROR' | 'FATAL';

/**
* LogEntry — một dòng log từ backend.
*/
export interface LogEntry {
id: string;
timestamp: string;
level: LogLevel;
service: string;
component?: string;
message: string;
correlationId?: string;
fields?: Record<string, unknown>;
    stack?: string;
    }

    /**
    * Bộ lọc log.
    */
    interface LogFilter {
    level: LogLevel | null;
    service: string;
    search: string;
    fromTime: string;
    toTime: string;
    }

    @Component({
    selector: 'app-log-viewer',
    standalone: true,
    imports: [CommonModule, FormsModule],
    changeDetection: ChangeDetectionStrategy.OnPush,
    template: `
    <div class="log-viewer">
        <h2>Log Viewer</h2>

        <!-- Filter controls -->
        <div class="log-viewer__filters">
            <label>Mức độ:
                <select [(ngModel)]="filter.level" (ngModelChange)="onFilterChange()">
                    <option [ngValue]="null">Tất cả</option>
                    <option *ngFor="let l of levels" [value]="l">{{ l }}</option>
                </select>
            </label>
            <label>Dịch vụ:
                <input type="text" [(ngModel)]="filter.service" placeholder="Lọc theo service..."
                    (input)="onFilterChange()" />
            </label>
            <label>Từ:
                <input type="datetime-local" [(ngModel)]="filter.fromTime" (change)="onFilterChange()" />
            </label>
            <label>Đến:
                <input type="datetime-local" [(ngModel)]="filter.toTime" (change)="onFilterChange()" />
            </label>
            <label>Tìm kiếm:
                <input type="text" [(ngModel)]="filter.search" (input)="onSearchDebounce()"
                    placeholder="Tìm theo nội dung..." />
            </label>
            <button (click)="loadLogs()" [disabled]="loading()">Làm mới</button>
        </div>

        <!-- Log table -->
        <div *ngIf="loading()" class="log-viewer__loading">Đang tải log...</div>
        <div *ngIf="!loading() && logs().length === 0" class="log-viewer__empty">
            Không có log entry nào.
        </div>
        <table *ngIf="!loading() && logs().length > 0" class="log-viewer__table">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Mức độ</th>
                    <th>Dịch vụ</th>
                    <th>Thông điệp</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr *ngFor="let entry of logs()"
                    [class]="'log-viewer__row log-viewer__row--' + entry.level.toLowerCase()">
                    <td>{{ entry.timestamp | date:'medium' }}</td>
                    <td>{{ entry.level }}</td>
                    <td>{{ entry.service }}</td>
                    <td>{{ entry.message }}</td>
                    <td><button (click)="selectLog(entry)">Chi tiết</button></td>
                </tr>
            </tbody>
        </table>

        <!-- Pagination -->
        <div *ngIf="totalPages() > 1" class="log-viewer__pagination">
            <button (click)="goToPage(page() - 1)" [disabled]="page() === 0">Trước</button>
            <span>Trang {{ page() + 1 }} / {{ totalPages() }}</span>
            <button (click)="goToPage(page() + 1)" [disabled]="page() >= totalPages() - 1">Sau</button>
        </div>

        <!-- Detail drawer -->
        <div *ngIf="selectedLog()" class="log-viewer__drawer" (click)="closeDrawer($event)">
            <div class="log-viewer__drawer-content" (click)="$event.stopPropagation()">
                <h3>Chi tiết Log</h3>
                <button (click)="selectedLog.set(null)">Đóng</button>
                <dl *ngIf="selectedLog()">
                    <ng-template #entryLet let-entry="selectedLog()">
                        <dt>Thời gian</dt>
                        <dd>{{ entry.timestamp | date:'medium' }}</dd>
                        <dt>Mức độ</dt>
                        <dd>{{ entry.level }}</dd>
                        <dt>Dịch vụ</dt>
                        <dd>{{ entry.service }}</dd>
                        <dt>Correlation ID</dt>
                        <dd>{{ entry.correlationId || '-' }}</dd>
                        <dt>Thông điệp</dt>
                        <dd>{{ entry.message }}</dd>
                        <dt *ngIf="entry.stack">Stack Trace</dt>
                        <dd *ngIf="entry.stack">
                            <pre>{{ entry.stack }}</pre>
                        </dd>
                        <dt *ngIf="entry.fields">Fields</dt>
                        <dd *ngIf="entry.fields">
                            <pre>{{ entry.fields | json }}</pre>
                        </dd>
                    </ng-template>
                </dl>
            </div>
        </div>
    </div>
    `,
    styles: [`
    .log-viewer { padding: 16px; font-family: monospace; }
    .log-viewer__filters { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; align-items: center; }
    .log-viewer__table { width: 100%; border-collapse: collapse; }
    .log-viewer__table th, .log-viewer__table td { padding: 8px; text-align: left; border-bottom: 1px solid #eee; }
    .log-viewer__row--error { background: #ffe0e0; }
    .log-viewer__row--warn { background: #fff3e0; }
    .log-viewer__row--fatal { background: #ffcdd2; font-weight: bold; }
    .log-viewer__pagination { display: flex; gap: 12px; margin-top: 16px; align-items: center; }
    .log-viewer__drawer { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; justify-content:
    flex-end; z-index: 1000; }
    .log-viewer__drawer-content { width: 480px; max-width: 90vw; background: #fff; padding: 24px; overflow-y: auto; }
    .log-viewer__loading, .log-viewer__empty { text-align: center; padding: 32px; color: #666; }
    dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; }
    dt { font-weight: bold; }
    pre { white-space: pre-wrap; word-break: break-all; font-size: 12px; }
    `],
    })
    export class LogViewerComponent implements OnInit, OnDestroy {
    // Signal-based state
    readonly logs = signal<LogEntry[]>([]);
        readonly loading = signal(false);
        readonly page = signal(0);
        readonly total = signal(0);
        readonly selectedLog = signal<LogEntry | null>(null);

            // Computed: tổng số trang
            readonly totalPages = computed(() => Math.max(1, Math.ceil(this.total() / 50)));

            readonly levels: LogLevel[] = ['DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'];

            // Filter state
            filter: LogFilter = {
            level: null,
            service: '',
            search: '',
            fromTime: '',
            toTime: '',
            };

            private destroy$ = new Subject<void>();
                private searchTimeout?: ReturnType<typeof setTimeout>;

                    constructor() {
                    // Auto-load khi page thay đổi
                    effect(() => {
                    this.page();
                    this.loadLogs();
                    });
                    }

                    ngOnInit(): void {
                    this.loadLogs();
                    }

                    ngOnDestroy(): void {
                    this.destroy$.next();
                    this.destroy$.complete();
                    if (this.searchTimeout) clearTimeout(this.searchTimeout);
                    }

                    loadLogs(): void {
                    this.loading.set(true);
                    // TODO: gọi API logs với filter, pagination
                    // this.logService.queryLogs(this.buildQuery()).pipe(takeUntilDestroyed()).subscribe(...)
                    this.loading.set(false);
                    }

                    onFilterChange(): void {
                    this.page.set(0);
                    this.loadLogs();
                    }

                    onSearchDebounce(): void {
                    if (this.searchTimeout) clearTimeout(this.searchTimeout);
                    this.searchTimeout = setTimeout(() => {
                    this.page.set(0);
                    this.loadLogs();
                    }, 300);
                    }

                    goToPage(p: number): void {
                    this.page.set(p);
                    }

                    selectLog(entry: LogEntry): void {
                    this.selectedLog.set(entry);
                    }

                    closeDrawer(e: Event): void {
                    if (e.target === e.currentTarget) {
                    this.selectedLog.set(null);
                    }
                    }
                    }