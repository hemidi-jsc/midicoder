export class BulkJobDetailsComponent implements OnInit, OnDestroy {
  private readonly store = inject(BulkStore);
  private readonly dialog = inject(MatDialog);
  private readonly snackBar = inject(MatSnackBar);

  // Exposed signals
  readonly loading = this.store.loading;
  readonly error = this.store.error;
  readonly progress = this.store.progress;
  readonly chunks = this.store.chunks;
  readonly dlqEntries = this.store.dlqEntries;

  // Các cột hiển thị cho bảng chunks
  readonly chunkColumns: string[] = ['chunk_id', 'index', 'entity_count', 'status', 'retry_count', 'timing'];

  // Các cột hiển thị cho bảng DLQ
{% if dlq_enabled %}
  readonly dlqColumns: string[] = ['entity_id', 'error_type', 'error', 'retry_count', 'failed_at', 'replayed', 'actions'];
{% else %}
  readonly dlqColumns: string[] = [];
{% endif %}

  // Input: Job ID để xem chi tiết
  @Input() jobId!: string;

  // Output: phát ra khi đóng
  @Output() close = new EventEmitter<void>();

  // SSE connection
  private eventSource: EventSource | null = null;

  /**
   * Computed: job hiện tại từ store.
   */
  currentJob = computed<BulkJob | null>(() => this.store.selectedJob());

  /**
   * Computed: phần trăm tiến độ.
   */
  progressPercentage = computed<number>(() => {
    const job = this.currentJob();
    if (!job || !job.entity_ids.length) return 0;
    return Math.round((job.processed / job.entity_ids.length) * 100);
  });

  /**
   * Computed: job có đang chạy không.
   */
  isRunning = computed<boolean>(() => {
    return this.currentJob()?.status === JobStatus.RUNNING;
  });

  /**
   * Computed: có thể huỷ job không.
   */
  canCancel = computed<boolean>(() => {
    const job = this.currentJob();
    return !!job && (job.status === JobStatus.RUNNING || job.status === JobStatus.PENDING);
  });

  /**
   * Computed: số entities chưa xử lý.
   */
  pendingCount = computed<number>(() => {
    const job = this.currentJob();
    if (!job) return 0;
    return job.entity_ids.length - job.processed;
  });

  /**
   * Computed: có entities chưa xử lý không.
   */
  hasPending = computed<boolean>(() => this.pendingCount() > 0);

  /**
   * Computed: có entries có thể replay không.
   */
  hasReplayable = computed<boolean>(() => {
    return this.dlqEntries().some(e => !e.replayed);
  });

  ngOnInit(): void {
    // Load chi tiết job từ store
    this.store.selectJob(this.jobId);
    // Kết nối SSE cho tiến độ real-time
    this.connectSSE();
  }

  ngOnDestroy(): void {
    // Cleanup SSE connection
    this.disconnectSSE();
    // Clear selection khi component bị destroy
    this.store.clearSelection();
  }

  /**
   * Kết nối SSE để nhận tiến độ real-time.
   */
  private connectSSE(): void {
    this.disconnectSSE();

    const eventSource = new EventSource(`/api/bulk/jobs/${this.jobId}/progress/sse`);

    eventSource.onmessage = (event: MessageEvent) => {
      try {
        const progress: BulkProgress = JSON.parse(event.data);
        // Store sẽ tự động cập nhật thông qua signal
        this.store['refreshProgress']?.();

        // Tự động đóng khi job kết thúc
        if (progress.status === 'completed' || progress.status === 'failed' || progress.status === 'cancelled') {
          eventSource.close();
          this.eventSource = null;
        }
      } catch (error) {
        console.error('[BulkJobDetails] Lỗi parse SSE data:', error);
      }
    };

    eventSource.onerror = () => {
      console.warn('[BulkJobDetails] Kết nối SSE bị mất');
      eventSource.close();
      this.eventSource = null;
      // Tự động reconnect sau 3 giây
      setTimeout(() => this.connectSSE(), 3000);
    };

    this.eventSource = eventSource;
  }

  /**
   * Đóng SSE connection.
   */
  private disconnectSSE(): void {
    if (this.eventSource) {
      this.eventSource.close();
      this.eventSource = null;
    }
  }

  /**
   * Huỷ job hiện tại.
   */
  cancelJob(): void {
    const job = this.currentJob();
    if (!job || !this.canCancel()) return;

    this.store.cancelJob(this.jobId);
    this.snackBar.open('Đã gửi yêu cầu huỷ job', 'Đóng', {
      duration: 3000,
      horizontalPosition: 'end',
      verticalPosition: 'top',
    });
  }

  /**
   * Làm mới dữ liệu job.
   */
  retryLoad(): void {
    this.store.selectJob(this.jobId);
    this.connectSSE();
  }

  /**
   * Lấy nhãn trạng thái job.
   *
   * @param status - JobStatus
   * @returns Label string
   */
  getStatusLabel(status: JobStatus | string): string {
    if (status in JOB_STATUS_LABELS) {
      return JOB_STATUS_LABELS[status as JobStatus];
    }
    return status;
  }

  /**
   * Lấy màu sắc cho trạng thái job.
   *
   * @param status - JobStatus
   * @returns Màu CSS
   */
  getStatusColor(status: JobStatus | string): string {
    const colorMap: Record<string, string> = {
      'pending': '#9e9e9e',
      'running': '#2196f3',
      'completed': '#4caf50',
      'failed': '#f44336',
      'cancelled': '#9e9e9e',
      'timeout': '#ff9800',
    };
    return colorMap[status] || '#9e9e9e';
  }

  /**
   * Lấy nhãn hành động.
   *
   * @param action - BulkAction
   * @returns Label string
   */
  getActionLabel(action: string): string {
    const labels: Record<string, string> = {
      'batch_create': 'Tạo hàng loạt',
      'batch_update': 'Cập nhật hàng loạt',
      'batch_delete': 'Xoá hàng loạt',
      'batch_read': 'Đọc hàng loạt',
    };
    return labels[action] || action;
  }

  /**
   * Lấy nhãn trạng thái chunk.
   *
   * @param status - ChunkStatus
   * @returns Label string
   */
  getChunkStatusLabel(status: ChunkStatus): string {
    return CHUNK_STATUS_LABELS[status] || status;
  }

  /**
   * Lấy màu sắc cho trạng thái chunk.
   *
   * @param status - ChunkStatus
   * @returns Màu CSS
   */
  getChunkStatusColor(status: ChunkStatus): string {
    const colorMap: Record<ChunkStatus, string> = {
      [ChunkStatus.PENDING]: '#9e9e9e',
      [ChunkStatus.PROCESSING]: '#2196f3',
      [ChunkStatus.COMPLETED]: '#4caf50',
      [ChunkStatus.FAILED]: '#f44336',
    };
    return colorMap[status] || '#9e9e9e';
  }

  /**
   * Xem chi tiết DLQ entry trong dialog.
   *
   * @param entry - DLQEntry cần xem
   */
  viewDlqEntry(entry: DLQEntry): void {
    this.dialog.open(DlqEntryDetailDialog, {
      width: '600px',
      data: { entry },
    });
  }

  /**
   * Replay một DLQ entry.
   *
   * @param entryId - DLQ Entry ID
   */
  replayEntry(entryId: string): void {
    this.store.replayDLQEntry(entryId);
    this.snackBar.open('Đã gửi yêu cầu chạy lại entry', 'Đóng', {
      duration: 3000,
      horizontalPosition: 'end',
      verticalPosition: 'top',
    });
  }

  /**
   * Replay tất cả DLQ entries chưa được replay.
   */
  async replayAll(): Promise<void> {
    const replayable = this.dlqEntries().filter(e => !e.replayed);
    if (!replayable.length) return;

    for (const entry of replayable) {
      this.store.replayDLQEntry(entry.entry_id);
    }

    this.snackBar.open(`Đã gửi yêu cầu chạy lại ${replayable.length} entries`, 'Đóng', {
      duration: 4000,
      horizontalPosition: 'end',
      verticalPosition: 'top',
    });
  }
}
