/**
* Import Wizard Component — CP38: Data Import/Export/ETL.
*{% raw %}
* UI Framework: {{{ ui_framework }}}{% endraw %}
*
* Component standalone cho luu ong import du lieu da buoc:
* Buoc 1: Tai len file (CSV/JSON) voi drag-and-drop, kiem tra file
* Buoc 2: Anh xa cot (chon entity dich, anh xa cot voi dropdown)
* Buoc 3: Xem truoc (hien thi N hang dau trong bang)
* Buoc 4: Xac nhan va bat dau import
*
* Su dung @angular/cdk/drag-drop cho file upload, @angular/material
* cho stepper, bang, nut bam.
*/

import {
Component,
OnInit,
OnDestroy,
ViewChild,
ChangeDetectorRef,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule, ReactiveFormsModule, FormBuilder, FormGroup, Validators } from '@angular/forms';

{% if ui_framework == "material" %}
import {
MatStepperModule,
MatStepper,
} from '@angular/material/stepper';
import { MatButtonModule } from '@angular/material/button';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { MatTableModule } from '@angular/material/table';
import { MatPaginatorModule } from '@angular/material/paginator';
import { MatSortModule } from '@angular/material/sort';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatIconModule } from '@angular/material/icon';
import { MatChipModule } from '@angular/material/chips';
import { MatCardModule } from '@angular/material/card';
import { MatListModule } from '@angular/material/list';
import { MatSnackBar, MatSnackBarModule } from '@angular/material/snack-bar';
{% elif ui_framework == "tailwind" %}
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
// Ant Design khong ung dung cho Angular
{% elif ui_framework == "carbon" %}
// Carbon khong ung dung cho Angular
{% endif %}

import {
CdkDragDrop,
moveItemInArray,
transferArrayItem,
DragDropModule,
} from '@angular/cdk/drag-drop';
import { Subscription } from 'rxjs';
import { ImportService } from './import.service';
{% raw %}

// =========================================================================
// Giao diện dữ liệu
// =========================================================================

/**
* Thông tin cột từ file được tải lên.
*/
interface SourceColumn {
name: string;
type: string;
sampleValues: string[];
}

/**
* Ánh xạ giữa cột nguồn và cột đích.
*/
interface ColumnMapping {
sourceColumn: string;
targetColumn: string;
}

/**
* Dữ liệu xem trước mỗi hàng.
*/
interface PreviewRow {
[key: string]: any;
}

/**
* Danh sách các entity đích có sẵn để ánh xạ.
*/
interface TargetEntity {
name: string;
label: string;
columns: { name: string; label: string; type: string }[];
}

/**
* Kết quả từ ImportService.
*/
interface ImportJobResult {
jobKey: string;
status: string;
message?: string;
}

// =========================================================================
// Component
// =========================================================================

@Component({
selector: 'mc-import-wizard',
standalone: true,
imports: [
CommonModule,
FormsModule,
ReactiveFormsModule,
{% if ui_framework == "material" %}
MatStepperModule,
MatButtonModule,
MatProgressBarModule,
MatTableModule,
MatPaginatorModule,
MatSortModule,
MatFormFieldModule,
MatInputModule,
MatSelectModule,
MatIconModule,
MatChipModule,
MatCardModule,
MatListModule,
MatSnackBarModule,
{% elif ui_framework == "antd" %}
{% endif %}
DragDropModule,
],
template: `
<div class="mc-import-wizard">
    <!-- Tiêu đề -->
    <h2 class="mc-wizard-title">Nhập dữ liệu</h2>

    <!-- Stepper đa bước -->
    <mat-stepper #stepper linear [linear]="true" color="primary" class="mc-stepper">
        <!-- =================================================================
             Bước 1: Tải lên file
             ================================================================= -->
        <mat-step [stepControl]="uploadForm" label="Tải file lên">
            <ng-template matStepLabel>Tải file lên</ng-template>

            <div class="mc-step-content">
                <!-- Khu vực drag-and-drop -->
                <div class="mc-drop-zone" [class.drag-over]="isDragOver" (dragover)="onDragOver($event)"
                    (dragover.prevent)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"
                    cdkDropZone>
                    <mat-icon class="mc-drop-icon">cloud_upload</mat-icon>
                    <p class="mc-drop-text">
                        {{ isDragOver ? 'Thả file vào đây' : 'Kéo thả file vào đây hoặc nhấn để chọn' }}
                    </p>
                    <p class="mc-drop-hint">
                        Hỗ trợ: CSV, JSON — Tối đa {{ maxSize / 1024 / 1024 | number:'1.0-0' }}MB
                    </p>
                    <input #fileInput type="file" accept=".csv,.json" (change)="onFileSelected($event)"
                        class="mc-file-input" style="display: none" />
                    <button mat-raised-button color="primary" (click)="fileInput.click()">
                        <mat-icon>folder_open</mat-icon>
                        Chọn file
                    </button>
                </div>

                <!-- Thông tin file đã chọn -->
                <div *ngIf="selectedFile" class="mc-file-info">
                    <mat-card class="mc-selected-file-card">
                        <mat-card-content>
                            <div class="mc-file-meta">
                                <mat-icon class="mc-file-icon">
                                    {{ getFileIcon(selectedFile.name) }}
                                </mat-icon>
                                <div class="mc-file-details">
                                    <span class="mc-file-name">{{ selectedFile.name }}</span>
                                    <span class="mc-file-size">
                                        {{ selectedFile.size / 1024 | number:'1.0-0' }} KB
                                    </span>
                                </div>
                                <button mat-icon-button (click)="clearFile()" aria-label="Xóa file">
                                    <mat-icon>close</mat-icon>
                                </button>
                            </div>
                            <!-- Chip hiển thị định dạng file -->
                            <mat-chip-set class="mc-format-chips">
                                <mat-chip color="primary">
                                    {{ detectedFormat | uppercase }}
                                </mat-chip>
                            </mat-chip-set>
                        </mat-card-content>
                    </mat-card>
                </div>

                <!-- Hiển thị lỗi validation -->
                <div *ngIf="fileError" class="mc-file-error">
                    <mat-icon color="warn">error</mat-icon>
                    <span>{{ fileError }}</span>
                </div>

                <!-- Danh sách các cột phát hiện được từ file -->
                <div *ngIf="sourceColumns.length > 0" class="mc-detected-columns">
                    <h4>Các cột phát hiện được:</h4>
                    <mat-chip-set>
                        <mat-chip *ngFor="let col of sourceColumns">
                            {{ col.name }} ({{ col.type }})
                        </mat-chip>
                    </mat-chip-set>
                </div>
            </div>

            <div class="mc-step-actions">
                <button mat-button matStepperNext [disabled]="!canProceedToStep(1)">
                    Tiếp tục
                </button>
            </div>
        </mat-step>

        <!-- =================================================================
             Bước 2: Ánh xạ cột
             ================================================================= -->
        <mat-step [stepControl]="mappingForm" label="Ánh xạ cột">
            <ng-template matStepLabel>Ánh xạ cột</ng-template>

            <div class="mc-step-content">
                <!-- Chọn entity đích -->
                <mat-form-field class="mc-full-width">
                    <mat-label>Chọn thực thể đích</mat-label>
                    <mat-select [(ngModel)]="selectedEntity" (selectionChange)="onEntitySelected()" name="targetEntity">
                        <mat-option *ngFor="let entity of targetEntities" [value]="entity.name">
                            {{ entity.label }}
                        </mat-option>
                    </mat-select>
                </mat-form-field>

                <!-- Bảng ánh xạ cột -->
                <div *ngIf="selectedEntity" class="mc-mapping-table">
                    <h4>Ánh xạ cột nguồn sang cột đích</h4>
                    <table mat-table [dataSource]="columnMappings" class="mc-mapping-grid">
                        <!-- Cột nguồn -->
                        <ng-container matColumnDef="source">
                            <th mat-header-cell *matHeaderCellDef>Cột nguồn</th>
                            <td mat-cell *matCellDef="let mapping">
                                <mat-chip color="accent">{{ mapping.sourceColumn }}</mat-chip>
                            </td>
                        </ng-container>

                        <!-- Mũi tên ánh xạ -->
                        <ng-container matColumnDef="arrow">
                            <th mat-header-cell *matHeaderCellDef></th>
                            <td mat-cell *matCellDef="let mapping">
                                <mat-icon>arrow_forward</mat-icon>
                            </td>
                        </ng-container>

                        <!-- Dropdown chọn cột đích -->
                        <ng-container matColumnDef="target">
                            <th mat-header-cell *matHeaderCellDef>Cột đích</th>
                            <td mat-cell *matCellDef="let mapping; let i = index">
                                <mat-form-field class="mc-mapping-select">
                                    <mat-label>Chọn cột đích</mat-label>
                                    <mat-select [(value)]="columnMappings[i].targetColumn"
                                        (selectionChange)="onMappingChanged()">
                                        <mat-option value="">-- Không ánh xạ --</mat-option>
                                        <mat-option *ngFor="let col of getTargetColumns()" [value]="col.name">
                                            {{ col.label }} <small>({{ col.type }})</small>
                                        </mat-option>
                                    </mat-select>
                                </mat-form-field>
                            </td>
                        </ng-container>

                        <tr mat-header-row *matHeaderRowDef="mappingDisplayColumns"></tr>
                        <tr mat-row *matRowDef="let row; columns: mappingDisplayColumns;"></tr>
                    </table>
                </div>

                <!-- Lưu ý -->
                <div *ngIf="selectedEntity && !columnMappings.length" class="mc-mapping-empty">
                    <mat-icon>info</mat-icon>
                    <span>Chưa có cột để ánh xạ. Vui lòng tải file ở bước trước.</span>
                </div>
            </div>

            <div class="mc-step-actions">
                <button mat-button matStepperPrevious>Quay lại</button>
                <button mat-button matStepperNext [disabled]="!canProceedToStep(2)">
                    Tiếp tục
                </button>
            </div>
        </mat-step>

        <!-- =================================================================
             Bước 3: Xem trước dữ liệu
             ================================================================= -->
        <mat-step label="Xem trước">
            <ng-template matStepLabel>Xem trước</ng-template>

            <div class="mc-step-content">
                <div class="mc-preview-header">
                    <h4>Xem trước {{ previewData.length }} hàng đầu</h4>
                    <mat-form-field class="mc-preview-limit">
                        <mat-label>Số hàng xem trước</mat-label>
                        <input matInput type="number" [(ngModel)]="previewLimit" (change)="loadPreview()" min="1"
                            max="100" />
                    </mat-form-field>
                </div>

                <!-- Bảng xem trước với thanh cuộn -->
                <div class="mc-preview-table-wrapper">
                    <table mat-table [dataSource]="previewData" matSort class="mc-preview-table">
                        <!-- Cột động cho từng source column -->
                        <ng-container *ngFor="let col of sourceColumns" [matColumnDef]="col.name">
                            <th mat-header-cell *matHeaderCellDef mat-sort-header>
                                {{ col.name }}
                            </th>
                            <td mat-cell *matCellDef="let row">
                                {{ row[col.name] ?? '(null)' }}
                            </td>
                        </ng-container>

                        <tr mat-header-row *matHeaderRowDef="previewColumns"></tr>
                        <tr mat-row *matRowDef="let row; columns: previewColumns;"></tr>

                        <!-- Hàng khi không có dữ liệu -->
                        <tr class="mat-row" *matNoDataRow>
                            <td class="mat-cell" [colSpan]="previewColumns.length">
                                Không có dữ liệu để xem trước
                            </td>
                        </tr>
                    </table>
                </div>

                <mat-paginator [pageSize]="10" [pageSizeOptions]="[5, 10, 25, 50]" showFirstLastButtons>
                </mat-paginator>
            </div>

            <div class="mc-step-actions">
                <button mat-button matStepperPrevious>Quay lại</button>
                <button mat-button matStepperNext [disabled]="!canProceedToStep(3)">
                    Tiếp tục
                </button>
            </div>
        </mat-step>

        <!-- =================================================================
             Bước 4: Xác nhận và bắt đầu import
             ================================================================= -->
        <mat-step label="Xác nhận">
            <ng-template matStepLabel>Xác nhận</ng-template>

            <div class="mc-step-content">
                <mat-card class="mc-confirm-card">
                    <mat-card-header>
                        <mat-card-title>Xác nhận thông tin import</mat-card-title>
                    </mat-card-header>
                    <mat-card-content>
                        <table class="mc-confirm-table">
                            <tr>
                                <th>File:</th>
                                <td>{{ selectedFile?.name }}</td>
                            </tr>
                            <tr>
                                <th>Định dạng:</th>
                                <td><mat-chip color="primary">{{ detectedFormat | uppercase }}</mat-chip></td>
                            </tr>
                            <tr>
                                <th>Entity đích:</th>
                                <td>{{ getSelectedEntityLabel() }}</td>
                            </tr>
                            <tr>
                                <th>Các cột ánh xạ:</th>
                                <td>
                                    <mat-chip-set>
                                        <mat-chip *ngFor="let m of columnMappings" [disabled]="!m.targetColumn">
                                            {{ m.sourceColumn }} &rarr; {{ m.targetColumn || '—' }}
                                        </mat-chip>
                                    </mat-chip-set>
                                </td>
                            </tr>
                            <tr>
                                <th>Số hàng:</th>
                                <td>{{ totalRowCount }}</td>
                            </tr>
                        </table>

                        <!-- Tùy chọn import -->
                        <div class="mc-import-options">
                            <h4>Tùy chọn</h4>
                            <mat-checkbox [(ngModel)]="importOptions.overwriteExisting">
                                Ghi đè dữ liệu hiện có
                            </mat-checkbox>
                            <mat-checkbox [(ngModel)]="importOptions.validateBeforeImport">
                                Kiểm tra dữ liệu trước khi import
                            </mat-checkbox>
                            <mat-checkbox [(ngModel)]="importOptions.continueOnError">
                                Tiếp tục khi gặp lỗi hàng
                            </mat-checkbox>
                        </div>
                    </mat-card-content>
                </mat-card>

                <!-- Hiển thị trạng thái import đang chạy -->
                <div *ngIf="isImporting" class="mc-import-progress">
                    <mat-progress-bar mode="indeterminate"></mat-progress-bar>
                    <p>Đang gửi yêu cầu import...</p>
                </div>

                <!-- Hiển thị kết quả import -->
                <div *ngIf="importResult" class="mc-import-result">
                    <mat-card [class.mc-success-card]="importResult.status === 'completed'"
                        [class.mc-error-card]="importResult.status === 'failed'">
                        <mat-card-content>
                            <mat-icon [color]="importResult.status === 'completed' ? 'accent' : 'warn'">
                                {{ importResult.status === 'completed' ? 'check_circle' : 'error' }}
                            </mat-icon>
                            <span>{{ importResult.message }}</span>
                        </mat-card-content>
                    </mat-card>
                </div>
            </div>

            <div class="mc-step-actions">
                <button mat-button matStepperPrevious>Quay lại</button>
                <button mat-raised-button color="primary" (click)="startImport()"
                    [disabled]="isImporting || !!importResult">
                    <mat-icon>import_export</mat-icon>
                    {{ isImporting ? 'Đang xử lý...' : 'Bắt đầu import' }}
                </button>
                <button *ngIf="importResult" mat-raised-button color="accent" (click)="resetWizard()">
                    Import file mới
                </button>
            </div>
        </mat-step>
    </mat-stepper>
</div>
`,
styles: [
`
