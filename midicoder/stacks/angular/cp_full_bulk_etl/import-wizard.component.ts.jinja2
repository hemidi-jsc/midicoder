export class ImportWizardComponent implements OnInit, OnDestroy {
// =========================================================================
// Tham chiếu đến stepper
// =========================================================================

/** Tham chiếu đến MatStepper để điều hướng giữa các bước */
@ViewChild('stepper') stepper!: MatStepper;

// =========================================================================
// Form Reactive
// =========================================================================

/** Form cho bước tải file lên */
uploadForm: FormGroup;

/** Form cho bước ánh xạ cột */
mappingForm: FormGroup;

// =========================================================================
// Bước 1: Tải file lên
// =========================================================================

/** File được chọn bởi người dùng */
selectedFile: File | null = null;

/** Đang kéo file qua khu vực drop chưa */
isDragOver: boolean = false;

/** Thông báo lỗi validation file */
fileError: string = '';

/** Kích thước tối đa của file (10MB) */
maxSize: number = 10 * 1024 * 1024;

/** Định dạng file được phát hiện (csv hoặc json) */
detectedFormat: string = '';

/** Danh sách các cột phát hiện được từ file */
sourceColumns: SourceColumn[] = [];

// =========================================================================
// Bước 2: Ánh xạ cột
// =========================================================================

/** Danh sách các entity đích có thể chọn (từ context) */
targetEntities: TargetEntity[] = [
{
name: 'users',
label: 'Người dùng',
columns: [
{ name: 'username', label: 'Tên đăng nhập', type: 'string' },
{ name: 'email', label: 'Email', type: 'string' },
{ name: 'full_name', label: 'Họ và tên', type: 'string' },
{ name: 'phone', label: 'Số điện thoại', type: 'string' },
{ name: 'role', label: 'Vai trò', type: 'string' },
],
},
{
name: 'products',
label: 'Sản phẩm',
columns: [
{ name: 'sku', label: 'Mã sản phẩm', type: 'string' },
{ name: 'name', label: 'Tên sản phẩm', type: 'string' },
{ name: 'price', label: 'Giá', type: 'number' },
{ name: 'category', label: 'Danh mục', type: 'string' },
{ name: 'stock', label: 'Kho', type: 'number' },
],
},
{
name: 'orders',
label: 'Đơn hàng',
columns: [
{ name: 'order_id', label: 'Mã đơn hàng', type: 'string' },
{ name: 'customer_name', label: 'Tên khách hàng', type: 'string' },
{ name: 'total_amount', label: 'Tổng tiền', type: 'number' },
{ name: 'status', label: 'Trạng thái', type: 'string' },
{ name: 'order_date', label: 'Ngày đặt hàng', type: 'date' },
],
},
];

/** Entity đích đang được chọn */
selectedEntity: string = '';

/** Danh sách ánh xạ cột */
columnMappings: ColumnMapping[] = [];

/** Các cột hiển thị trong bảng ánh xạ */
mappingDisplayColumns: string[] = ['source', 'arrow', 'target'];

// =========================================================================
// Bước 3: Xem trước
// =========================================================================

/** Dữ liệu xem trước */
previewData: PreviewRow[] = [];

/** Số hàng xem trước */
previewLimit: number = 10;

/** Các cột hiển thị trong bảng xem trước */
previewColumns: string[] = [];

/** Tổng số hàng trong file */
totalRowCount: number = 0;

// =========================================================================
// Bước 4: Xác nhận và import
// =========================================================================

/** Các tùy chọn import */
importOptions = {
overwriteExisting: false,
validateBeforeImport: true,
continueOnError: false,
};

/** Đang thực hiện import chưa */
isImporting: boolean = false;

/** Kết quả import job */
importResult: ImportJobResult | null = null;

// =========================================================================
// Subscription
// =========================================================================

/** Collection subscriptions để hủy khi destroy */
private subscriptions: Subscription = new Subscription();

// =========================================================================
// Context variables từ Jinja2
// =========================================================================

/** Các định dạng import được hỗ trợ */
supportedFormats: Readonly<string[]> = {{ import_formats | tojson if import_formats else ['csv', 'json'] | tojson }};

    /** Các trạng thái job */
    jobStatuses: Readonly<string[]> = {{ job_statuses | tojson if job_statuses else ['pending', 'running', 'completed',
        'failed', 'cancelled'] | tojson }};

        /** Các loại transform */
        transformTypes: Readonly<string[]> = {{ transform_types | tojson if transform_types else [] | tojson }};

            /** Các nguồn extract */
            extractSources: Readonly<string[]> = {{ extract_sources | tojson if extract_sources else [] | tojson }};

                /** Các chế độ load */
                loadModes: Readonly<string[]> = {{ load_modes | tojson if load_modes else ['insert', 'update', 'upsert']
                    | tojson }};

                    // =========================================================================
                    // Lifecycle
                    // =========================================================================

                    constructor(
                    private fb: FormBuilder,
                    private importService: ImportService,
                    private snackBar: MatSnackBar,
                    private cdr: ChangeDetectorRef,
                    ) {
                    // Khởi tạo form cho bước upload
                    this.uploadForm = this.fb.group({});
                    // Khởi tạo form cho bước mapping
                    this.mappingForm = this.fb.group({});
                    }

                    /**
                    * OnInit — khởi tạo component.
                    */
                    ngOnInit(): void {
                    // Không cần khởi tạo thêm ở đây
                    }

                    /**
                    * OnDestroy — cleanup subscriptions và timer.
                    */
                    ngOnDestroy(): void {
                    this.subscriptions.unsubscribe();
                    }

                    // =========================================================================
                    // Bước 1: Handlers cho drag-and-drop và file input
                    // =========================================================================

                    /**
                    * Xử lý khi kéo file vào khu vực drop.
                    *
                    * @param event — DragEvent
                    */
                    onDragOver(event: DragEvent): void {
                    event.preventDefault();
                    event.stopPropagation();
                    this.isDragOver = true;
                    }

                    /**
                    * Xử lý khi kéo file ra khỏi khu vực drop.
                    *
                    * @param event — DragEvent
                    */
                    onDragLeave(event: DragEvent): void {
                    event.preventDefault();
                    event.stopPropagation();
                    this.isDragOver = false;
                    }

                    /**
                    * Xử lý khi thả file vào khu vực drop.
                    *
                    * @param event — DragEvent chứa file list
                    */
                    onDrop(event: DragEvent): void {
                    event.preventDefault();
                    event.stopPropagation();
                    this.isDragOver = false;

                    const files = event.dataTransfer?.files;
                    if (files && files.length > 0) {
                    this.processFile(files[0]);
                    }
                    }

                    /**
                    * Xử lý khi chọn file qua input[type=file].
                    *
                    * @param event — Event từ HTMLInputElement
                    */
                    onFileSelected(event: Event): void {
                    const input = event.target as HTMLInputElement;
                    if (input.files && input.files.length > 0) {
                    this.processFile(input.files[0]);
                    }
                    // Reset input để cho phép chọn cùng file
                    input.value = '';
                    }

                    /**
                    * Xử lý file đã chọn: validate, phát hiện format, đọc cột.
                    *
                    * @param file — File cần xử lý
                    */
                    private processFile(file: File): void {
                    this.selectedFile = file;
                    this.fileError = '';
                    this.sourceColumns = [];
                    this.detectedFormat = '';

                    // Kiểm tra kích thước file
                    if (file.size > this.maxSize) {
                    const mb = (file.size / 1024 / 1024).toFixed(1);
                    this.fileError = `File quá lớn: ${mb}MB (tối đa ${this.maxSize / 1024 / 1024}MB)`;
                    return;
                    }

                    // Phát hiện định dạng từ phần mở rộng
                    const ext = file.name.split('.').pop()?.toLowerCase();
                    if (ext === 'csv') {
                    this.detectedFormat = 'csv';
                    } else if (ext === 'json') {
                    this.detectedFormat = 'json';
                    } else {
                    this.fileError = 'Định dạng không được hỗ trợ. Vui lòng chọn file CSV hoặc JSON.';
                    return;
                    }

                    // Đọc file và phân tích các cột
                    this.parseFileColumns(file);
                    }

                    /**
                    * Đọc và phân tích các cột từ file CSV/JSON.
                    *
                    * @param file — File cần phân tích
                    */
                    private parseFileColumns(file: File): void {
                    const reader = new FileReader();

                    reader.onload = () => {
                    const content = reader.result as string;

                    if (this.detectedFormat === 'csv') {
                    this.parseCSVColumns(content);
                    } else {
                    this.parseJSONColumns(content);
                    }

                    this.cdr.detectChanges();
                    };

                    reader.onerror = () => {
                    this.fileError = 'Không thể đọc file. Vui lòng thử lại.';
                    };

                    reader.readAsText(file);
                    }

                    /**
                    * Phân tích các cột từ nội dung CSV.
                    *
                    * @param content — Chuỗi nội dung CSV
                    */
                    private parseCSVColumns(content: string): void {
                    const lines = content.trim().split('\n');
                    if (!lines.length) {
                    this.fileError = 'File CSV rỗng.';
                    return;
                    }

                    // Lấy dòng tiêu đề (hàng đầu tiên)
                    const headers = lines[0].split(',').map((h) => h.trim().replace(/^"|"$/g, ''));

                    // Phân loại kiểu dữ liệu dựa trên giá trị mẫu
                    this.sourceColumns = headers.map((name) => {
                    const sampleValues: string[] = [];
                    // Lấy giá trị mẫu từ 5 hàng tiếp theo
                    for (let i = 1; i < Math.min(lines.length, 6); i++) { const values=lines[i].split(','); if
                        (values.length> headers.indexOf(name)) {
                        sampleValues.push(values[headers.indexOf(name)].trim());
                        }
                        }

                        return {
                        name,
                        type: this.inferColumnType(sampleValues),
                        sampleValues,
                        };
                        });

                        this.totalRowCount = Math.max(0, lines.length - 1);

                        // Tải dữ liệu xem trước
                        this.loadPreview();
                        }

                        /**
                        * Phân tích các cột từ nội dung JSON.
                        *
                        * @param content — Chuỗi nội dung JSON
                        */
                        private parseJSONColumns(content: string): void {
                        let data: any[] = [];

                        try {
                        const parsed = JSON.parse(content);
                        data = Array.isArray(parsed) ? parsed : [parsed];
                        } catch (e) {
                        this.fileError = 'JSON không hợp lệ: Không thể phân tích cú pháp.';
                        return;
                        }

                        if (!data.length) {
                        this.fileError = 'File JSON không chứa dữ liệu.';
                        return;
                        }

                        // Lấy các key từ object đầu tiên
                        const keys = Object.keys(data[0]);
                        this.sourceColumns = keys.map((name) => {
                        const sampleValues: string[] = [];
                        for (let i = 0; i < Math.min(data.length, 5); i++) { const val=data[i][name];
                            sampleValues.push(val !==null && val !==undefined ? String(val) : '' ); } return { name,
                            type: this.inferColumnType(sampleValues), sampleValues, }; });
                            this.totalRowCount=data.length; // Tải dữ liệu xem trước this.previewData=data.slice(0,
                            this.previewLimit); this.previewColumns=keys; } /** * Suy luận kiểu dữ liệu từ các giá trị
                            mẫu. * * @param values — Danh sách giá trị mẫu * @returns Kiểu dữ liệu (number, date,
                            boolean, string) */ private inferColumnType(values: string[]): string { if (!values.length
                            || !values[0]) return 'string' ; // Kiểm tra number if (values.every((v)=> v !== '' &&
                            !isNaN(Number(v)))) {
                            return 'number';
                            }

                            // Kiểm tra boolean
                            const lowerVals = values.map((v) => v.toLowerCase());
                            if (lowerVals.every((v) => ['true', 'false', '0', '1', ''].includes(v))) {
                            return 'boolean';
                            }

                            // Kiểm tra date (ISO format)
                            if (values.every((v) => !v || !isNaN(Date.parse(v)))) {
                            return 'date';
                            }

                            return 'string';
                            }

                            /**
                            * Tải lại dữ liệu xem trước dựa trên previewLimit.
                            */
                            loadPreview(): void {
                            if (!this.selectedFile || !this.sourceColumns.length) return;

                            const reader = new FileReader();
                            reader.onload = () => {
                            const content = reader.result as string;

                            if (this.detectedFormat === 'csv') {
                            const lines = content.trim().split('\n');
                            const headers = lines[0].split(',').map((h) => h.trim().replace(/^"|"$/g, ''));
                            this.previewColumns = headers;
                            this.previewData = lines
                            .slice(1, 1 + this.previewLimit)
                            .map((line) => {
                            const vals = line.split(',');
                            const row: PreviewRow = {};
                            headers.forEach((h, i) => {
                            row[h] = vals[i]?.trim() ?? null;
                            });
                            return row;
                            });
                            } else {
                            try {
                            const parsed = JSON.parse(content);
                            const data = Array.isArray(parsed) ? parsed : [parsed];
                            this.previewColumns = Object.keys(data[0] || {});
                            this.previewData = data.slice(0, this.previewLimit);
                            } catch (e) {
                            this.previewData = [];
                            }
                            }
                            };
                            reader.readAsText(this.selectedFile);
                            }

                            /**
                            * Xóa file đã chọn và reset trạng thái bước 1.
                            */
                            clearFile(): void {
                            this.selectedFile = null;
                            this.fileError = '';
                            this.detectedFormat = '';
                            this.sourceColumns = [];
                            this.previewData = [];
                            this.previewColumns = [];
                            }

                            /**
                            * Trả về icon phù hợp với loại file.
                            *
                            * @param fileName — Tên file
                            * @returns Tên icon Material
                            */
                            getFileIcon(fileName: string): string {
                            const ext = fileName.split('.').pop()?.toLowerCase();
                            if (ext === 'csv') return 'table_chart';
                            if (ext === 'json') return 'code';
                            return 'insert_drive_file';
                            }

                            // =========================================================================
                            // Bước 2: Handlers cho ánh xạ cột
                            // =========================================================================

                            /**
                            * Xử lý khi chọn entity đích.
                            *
                            * Tự động tạo ánh xạ ban đầu dựa trên tên cột giống nhau.
                            */
                            onEntitySelected(): void {
                            this.columnMappings = this.sourceColumns.map((srcCol) => {
                            // Thử tìm cột đích có tên tương tự
                            const entity = this.targetEntities.find((e) => e.name === this.selectedEntity);
                            const matchedTarget = entity?.columns.find(
                            (tCol) => tCol.name.toLowerCase() === srcCol.name.toLowerCase()
                            );

                            return {
                            sourceColumn: srcCol.name,
                            targetColumn: matchedTarget?.name || '',
                            };
                            });
                            }

                            /**
                            * Xử lý khi thay đổi ánh xạ cột.
                            *
                            * Có thể thêm logic validate ở đây.
                            */
                            onMappingChanged(): void {
                            // Trigger detection để cập nhật state
                            this.cdr.detectChanges();
                            }

                            /**
                            * Trả về danh sách cột của entity đích đã chọn.
                            *
                            * @returns Mảng cột đích
                            */
                            getTargetColumns(): TargetEntity['columns'] {
                            const entity = this.targetEntities.find((e) => e.name === this.selectedEntity);
                            return entity?.columns || [];
                            }

                            /**
                            * Trả về nhãn của entity đang chọn.
                            *
                            * @returns Nhãn entity hoặc chuỗi rỗng
                            */
                            getSelectedEntityLabel(): string {
                            const entity = this.targetEntities.find((e) => e.name === this.selectedEntity);
                            return entity?.label || '';
                            }

                            // =========================================================================
                            // Bước 4: Xác nhận và import
                            // =========================================================================

                            /**
                            * Bắt đầu quá trình import — gọi ImportService.
                            */
                            startImport(): void {
                            this.isImporting = true;
                            this.importResult = null;

                            // Xây dựng cấu hình import job
                            const config = {
                            fileName: this.selectedFile?.name,
                            format: this.detectedFormat,
                            targetEntity: this.selectedEntity,
                            columnMappings: this.columnMappings,
                            totalRows: this.totalRowCount,
                            options: this.importOptions,
                            };

                            // Gửi file và tạo import job
                            const sub = this.importService
                            .uploadFile(this.selectedFile!, this.detectedFormat)
                            .subscribe({
                            next: (uploadResponse: any) => {
                            // Sau khi upload thành công, tạo import job
                            const jobSub = this.importService
                            .createImportJob(config)
                            .subscribe({
                            next: (jobResult: ImportJobResult) => {
                            this.isImporting = false;
                            this.importResult = jobResult;
                            this.showSnackBar(`Job import đã được tạo: ${jobResult.jobKey}`, 'success');
                            },
                            error: (err: any) => {
                            this.isImporting = false;
                            this.importResult = {
                            jobKey: '',
                            status: 'failed',
                            message: `Không thể tạo job: ${err.message || err}`,
                            };
                            this.showSnackBar('Không thể tạo job import', 'error');
                            },
                            });
                            this.subscriptions.add(jobSub);
                            },
                            error: (err: any) => {
                            this.isImporting = false;
                            this.importResult = {
                            jobKey: '',
                            status: 'failed',
                            message: `Lỗi upload file: ${err.message || err}`,
                            };
                            this.showSnackBar('Lỗi khi upload file', 'error');
                            },
                            });

                            this.subscriptions.add(sub);
                            }

                            /**
                            * Đặt lại wizard về trạng thái ban đầu.
                            */
                            resetWizard(): void {
                            this.clearFile();
                            this.selectedEntity = '';
                            this.columnMappings = [];
                            this.previewData = [];
                            this.totalRowCount = 0;
                            this.isImporting = false;
                            this.importResult = null;
                            this.importOptions = {
                            overwriteExisting: false,
                            validateBeforeImport: true,
                            continueOnError: false,
                            };
                            if (this.stepper) {
                            this.stepper.reset();
                            }
                            }

                            // =========================================================================
                            // Kiểm tra điều kiện chuyển bước
                            // =========================================================================

                            /**
                            * Kiểm tra có thể chuyển tiếp từ bước hiện tại không.
                            *
                            * @param step — Số bước (1-indexed)
                            * @returns true nếu có thể chuyển tiếp
                            */
                            canProceedToStep(step: number): boolean {
                            switch (step) {
                            case 1:
                            // Bước 1: Phải có file hợp lệ với các cột
                            return !!this.selectedFile && !this.fileError && this.sourceColumns.length > 0;
                            case 2:
                            // Bước 2: Phải chọn entity và có ít nhất 1 ánh xạ
                            return !!this.selectedEntity && this.columnMappings.some((m) => m.targetColumn);
                            case 3:
                            // Bước 3: Phải có dữ liệu xem trước
                            return this.previewData.length > 0;
                            default:
                            return true;
                            }
                            }

                            // =========================================================================
                            // Tiện ích hiển thị thông báo
                            // =========================================================================

                            /**
                            * Hiển thị thông báo snackbar.
                            *
                            * @param message — Nội dung thông báo
                            * @param type — Loại thông báo (success/error)
                            */
                            private showSnackBar(message: string, type: 'success' | 'error'): void {
                            this.snackBar.open(message, 'Đóng', {
                            duration: 5000,
                            horizontalPosition: 'center',
                            verticalPosition: 'bottom',
                            });
                            }
                            }