/**
* Job Status Component — CP38: Data Import/Export/ETL.
*{% raw %}
* UI Framework: {{{ ui_framework }}}{% endraw %}
*
* Component standalone hien thi tien trinh cua job (import/export/ETL):
* - Thanh tien trinh voi phan tram
* - Badge trang thai (pending/running/completed/failed/cancelled)
* - Dem hang (tong/thanh cong/that bai)
* - Danh sach loi voi chi tiet tung hang
* - Nut huy (neu job dang chay)
* - Tu dong lam moi voi polling
*
* Su dung @angular/material cho progress bar, badge, bang, nut bam.
*/

import {
Component,
OnInit,
OnDestroy,
Input,
Output,
EventEmitter,
ChangeDetectorRef,
} from '@angular/core';
import { CommonModule } from '@angular/common';

{% if ui_framework == "material" %}
import { MatButtonModule } from '@angular/material/button';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
import { MatIconModule } from '@angular/material/icon';
import { MatCardModule } from '@angular/material/card';
import { MatChipModule } from '@angular/material/chips';
import { MatTableModule } from '@angular/material/table';
import { MatDividerModule } from '@angular/material/divider';
import { MatTooltipModule } from '@angular/material/tooltip';
import { MatSnackBar, MatSnackBarModule } from '@angular/material/snack-bar';
import { MatListModule } from '@angular/material/list';
import { MatExpansionModule } from '@angular/material/expansion';
{% elif ui_framework == "tailwind" %}
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
// Ant Design khong ung dung cho Angular
{% elif ui_framework == "carbon" %}
// Carbon khong ung dung cho Angular
{% endif %}

import { interval, Subscription } from 'rxjs';
import {
ImportService,
JobStatusInfo,
} from './import.service';
import {
ExportService,
ExportStatusInfo,
} from './export.service';
{% raw %}

// =========================================================================
// Giao diện dữ liệu
// =========================================================================

/**
* Các trạng thái job có thể có.
*/
export type JobStatus = 'pending' | 'running' | 'completed' | 'failed' | 'cancelled';

/**
* Một lỗi chi tiết từ hàng dữ liệu.
*/
export interface RowError {
/** Số hàng (1-indexed) */
rowNumber: number;
/** Nội dung lỗi */
message: string;
/** Dữ liệu hàng gây lỗi */
rowData?: Record<string, any>;
    }

    /**
    * Loại job (import, export, etl).
    */
    export type JobType = 'import' | 'export' | 'etl';

    /**
    * Cấu hình hiển thị trạng thái job.
    */
    interface StatusDisplayConfig {
    /** Mã trạng thái */
    status: JobStatus;
    /** Nhãn hiển thị (tiếng Việt) */
    label: string;
    /** Màu badge */
    color: 'primary' | 'accent' | 'warn' | '';
    /** Icon Material */
    icon: string;
    /** Có phải trạng thái cuối cùng không */
    isTerminal: boolean;
    }

    // =========================================================================
    // Cấu hình hiển thị cho từng trạng thái
    // =========================================================================

    const STATUS_CONFIG: Record<JobStatus, StatusDisplayConfig> = {
        pending: {
        status: 'pending',
        label: 'Đang chờ',
        color: '',
        icon: 'schedule',
        isTerminal: false,
        },
        running: {
        status: 'running',
        label: 'Đang xử lý',
        color: 'primary',
        icon: 'download',
        isTerminal: false,
        },
        completed: {
        status: 'completed',
        label: 'Hoàn thành',
        color: 'accent',
        icon: 'check_circle',
        isTerminal: true,
        },
        failed: {
        status: 'failed',
        label: 'Thất bại',
        color: 'warn',
        icon: 'error',
        isTerminal: true,
        },
        cancelled: {
        status: 'cancelled',
        label: 'Đã hủy',
        color: '',
        icon: 'cancel',
        isTerminal: true,
        },
        };

        // =========================================================================
        // Component
        // =========================================================================

        @Component({
        selector: 'mc-job-status',
        standalone: true,
        imports: [
        CommonModule,
        {% if ui_framework == "material" %}
        MatButtonModule,
        MatProgressBarModule,
        MatProgressSpinnerModule,
        MatIconModule,
        MatCardModule,
        MatChipModule,
        MatTableModule,
        MatDividerModule,
        MatTooltipModule,
        MatSnackBarModule,
        MatListModule,
        MatExpansionModule,
        {% elif ui_framework == "antd" %}
        {% endif %}
        ],
        template: `
        <div class="mc-job-status" [class.mc-terminal]="isTerminal">
            <!-- =================================================================
           Header: Trạng thái và phần trăm
           ================================================================= -->
            <mat-card class="mc-status-card">
                <mat-card-content>
                    <!-- Hàng tiêu đề: icon + trạng thái + phần trăm -->
                    <div class="mc-header">
                        <div class="mc-status-left">
                            <!-- Spinner khi đang chạy -->
                            <mat-progress-spinner *ngIf="status === 'running'" [diameter]="24" mode="indeterminate"
                                color="primary" class="mc-running-spinner">
                            </mat-progress-spinner>

                            <!-- Icon trạng thái -->
                            <mat-icon class="mc-status-icon" [color]="statusConfig?.color || ''">
                                {{ statusConfig?.icon || 'help' }}
                            </mat-icon>

                            <div class="mc-status-text">
                                <span class="mc-status-label">
                                    {{ statusConfig?.label || status }}
                                </span>
                                <span class="mc-job-type-badge">
                                    {{ jobType | uppercase }}
                                </span>
                            </div>
                        </div>

                        <!-- Phần trăm và badge trạng thái -->
                        <div class="mc-status-right">
                            <span class="mc-percentage">
                                {{ progress }}%
                            </span>
                            <mat-chip [color]="statusConfig?.color || ''" [disabled]="status === 'running'"
                                class="mc-status-chip">
                                {{ statusConfig?.label || status }}
                            </mat-chip>
                        </div>
                    </div>

                    <!-- =================================================================
               Thanh tiến trình
               ================================================================= -->
                    <div class="mc-progress-section">
                        <mat-progress-bar mode="determinate" [value]="progress"
                            [color]="status === 'failed' ? 'warn' : 'primary'">
                        </mat-progress-bar>

                        <!-- Hiển thị thời gian -->
                        <div class="mc-time-info">
                            <span *ngIf="startedAt" class="mc-started">
                                Bắt đầu: {{ startedAt | date:'HH:mm:ss dd/MM/yyyy' }}
                            </span>
                            <span *ngIf="completedAt" class="mc-completed">
                                Hoàn thành: {{ completedAt | date:'HH:mm:ss dd/MM/yyyy' }}
                            </span>
                            <span *ngIf="elapsedSeconds > 0 && !completedAt" class="mc-elapsed">
                                Đã chạy: {{ elapsedSeconds }}s
                            </span>
                        </div>
                    </div>
                </mat-card-content>
            </mat-card>

            <!-- =================================================================
           Thống kê hàng (row counts)
           ================================================================= -->
            <mat-card class="mc-stats-card">
                <mat-card-content>
                    <div class="mc-stats-grid">
                        <!-- Tổng số hàng -->
                        <div class="mc-stat-item">
                            <div class="mc-stat-value mc-stat-total">{{ totalRows || 0 }}</div>
                            <div class="mc-stat-label">Tổng số hàng</div>
                        </div>

                        <!-- Thành công -->
                        <div class="mc-stat-item mc-stat-success">
                            <div class="mc-stat-value">{{ successRows || 0 }}</div>
                            <div class="mc-stat-label">Thành công</div>
                            <mat-icon>check</mat-icon>
                        </div>

                        <!-- Thất bại -->
                        <div class="mc-stat-item mc-stat-failed"
                            [class.mc-has-errors]="!!(failedRows && failedRows > 0)">
                            <div class="mc-stat-value">{{ failedRows || 0 }}</div>
                            <div class="mc-stat-label">Thất bại</div>
                            <mat-icon *ngIf="failedRows && failedRows > 0">error</mat-icon>
                        </div>

                        <!-- Đã xử lý (tổng cộng) -->
                        <div class="mc-stat-item mc-stat-processed">
                            <div class="mc-stat-value">{{ processedRows || 0 }}</div>
                            <div class="mc-stat-label">Đã xử lý</div>
                            <mat-icon>done_all</mat-icon>
                        </div>
                    </div>
                </mat-card-content>
            </mat-card>

            <!-- =================================================================
           Danh sách lỗi (nếu có)
           ================================================================= -->
            <mat-card *ngIf="errors.length > 0" class="mc-errors-card">
                <mat-card-header>
                    <mat-card-title>
                        <mat-icon color="warn">warning</mat-icon>
                        Chi tiết lỗi ({{ errors.length }} hàng)
                    </mat-card-title>
                </mat-card-header>
                <mat-card-content>
                    <!-- Bảng hiển thị các lỗi -->
                    <div class="mc-errors-table-wrapper">
                        <table mat-table [dataSource]="errors" class="mc-errors-table">
                            <!-- Cột số hàng -->
                            <ng-container matColumnDef="rowNumber">
                                <th mat-header-cell *matHeaderCellDef>
                                    Số hàng
                                </th>
                                <td mat-cell *matCellDef="let error">
                                    {{ error.rowNumber }}
                                </td>
                            </ng-container>

                            <!-- Cột thông báo lỗi -->
                            <ng-container matColumnDef="message">
                                <th mat-header-cell *matHeaderCellDef>
                                    Lỗi
                                </th>
                                <td mat-cell *matCellDef="let error">
                                    <span class="mc-error-message" [matTooltip]="error.message">
                                        {{ error.message }}
                                    </span>
                                </td>
                            </ng-container>

                            <!-- Cột dữ liệu hàng (accordion để mở rộng) -->
                            <ng-container matColumnDef="data">
                                <th mat-header-cell *matHeaderCellDef>
                                    Dữ liệu
                                </th>
                                <td mat-cell *matCellDef="let error">
                                    <button mat-icon-button (click)="toggleErrorDetail(error)"
                                        [matTooltip]="error.rowData ? 'Xem chi tiết dữ liệu' : 'Không có dữ liệu'">
                                        <mat-icon>
                                            {{ expandedErrors.has(error) ? 'expand_less' : 'expand_more' }}
                                        </mat-icon>
                                    </button>
                                    <div *ngIf="expandedErrors.has(error) && error.rowData" class="mc-error-detail">
                                        <pre>{{ error.rowData | json }}</pre>
                                    </div>
                                </td>
                            </ng-container>

                            <tr mat-header-row *matHeaderRowDef="errorDisplayColumns"></tr>
                            <tr mat-row *matRowDef="let row; columns: errorDisplayColumns;"></tr>
                        </table>
                    </div>

                    <!-- Hiển thị thêm các lỗi vượt quá giới hạn -->
                    <div *ngIf="errors.length > maxDisplayedErrors" class="mc-more-errors">
                        <button mat-stroked-button (click)="showAllErrors = !showAllErrors">
                            {{ showAllErrors ? 'Thu gọn' : 'Xem tất cả ' + errors.length + ' lỗi' }}
                        </button>
                    </div>
                </mat-card-content>
            </mat-card>

            <!-- =================================================================
           Các hành động
           ================================================================= -->
            <div class="mc-actions">
                <!-- Nút hủy (chỉ hiển thị nếu job đang chạy hoặc chờ) -->
                <button *ngIf="canCancel" mat-raised-button color="warn" (click)="onCancel()" [disabled]="cancelling">
                    <mat-icon>stop</mat-icon>
                    {{ cancelling ? 'Đang hủy...' : 'Hủy job' }}
                </button>

                <!-- Nút thử lại (chỉ hiển thị nếu job thất bại) -->
                <button *ngIf="status === 'failed'" mat-raised-button color="primary" (click)="onRetry()">
                    <mat-icon>replay</mat-icon>
                    Thử lại
                </button>

                <!-- Nút đóng (khi job hoàn thành) -->
                <button *ngIf="isTerminal" mat-button (click)="onClose()">
                    Đóng
                </button>
            </div>

            <!-- Nút tắt/mở tự động làm mới -->
            <div class="mc-auto-refresh">
                <span class="mc-refresh-label">
                    Tự động làm mới: {{ autoRefresh ? 'Bật' : 'Tắt' }}
                </span>
                <button mat-icon-button (click)="toggleAutoRefresh()"
                    [matTooltip]="autoRefresh ? 'Tắt tự động làm mới' : 'Bật tự động làm mới'">
                    <mat-icon [class.mc-spinning]="autoRefresh && status === 'running'">
                        refresh
                    </mat-icon>
                </button>
            </div>
        </div>
        `,
        styles: [
        `
        :host {
        display: block;
        }

        .mc-job-status {
        padding: 16px;
        max-width: 720px;
        margin: 0 auto;
        }

        .mc-job-status.mc-terminal {
        opacity: 0.95;
        }

        /* ==========================================================================
        Header trạng thái
        ========================================================================== */
        .mc-status-card {
        margin-bottom: 16px;
        }

        .mc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        }

        .mc-status-left {
        display: flex;
