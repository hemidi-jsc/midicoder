        ],
        })
        export class JobStatusComponent implements OnInit, OnDestroy {
        // =========================================================================
        // Inputs
        // =========================================================================

        /**
        * Khóa của job cần theo dõi.
        */
        @Input() jobKey: string = '';

        /**
        * Loại job (import, export, etl) — dùng để chọn service phù hợp.
        */
        @Input() jobType: JobType = 'import';

        /**
        * Khoảng thời gian polling (ms) — mặc định 2000ms (2 giây).
        */
        @Input() pollingInterval: number = 2000;

        /**
        * Số lần polling tối đa — mặc định 300 (10 phút với 2s interval).
        */
        @Input() maxPollAttempts: number = 300;

        /**
        * Bật tự động làm mới ngay khi khởi tạo — mặc định true.
        */
        @Input() autoRefresh: boolean = true;

        /**
        * Số lỗi tối đa hiển thị trong bảng (tránh render quá nhiều).
        */
        @Input() maxDisplayedErrors: number = 100;

        // =========================================================================
        // Outputs
        // =========================================================================

        /**
        * Phát ra khi trạng thái job thay đổi.
        */
        @Output() statusChanged = new EventEmitter<JobStatus>();

            /**
            * Phát ra khi job hoàn thành (thành công hoặc thất bại).
            */
            @Output() jobCompleted = new EventEmitter<{ status: JobStatus; successRows: number; failedRows: number;
                totalRows: number; }>();

                /**
                * Phát ra khi người dùng yêu cầu hủy job.
                */
                @Output() jobCancelled = new EventEmitter<string>();

                    /**
                    * Phát ra khi người dùng yêu cầu thử lại.
                    */
                    @Output() jobRetry = new EventEmitter<string>();

                        /**
                        * Phát ra khi người dùng đóng component.
                        */
                        @Output() closed = new EventEmitter<void>();

                            // =========================================================================
                            // Trạng thái nội bộ
                            // =========================================================================

                            /**
                            * Trạng thái hiện tại của job.
                            */
                            status: JobStatus = 'pending';

                            /**
                            * Phần trăm hoàn thành (0-100).
                            */
                            progress: number = 0;

                            /**
                            * Tổng số hàng.
                            */
                            totalRows: number = 0;

                            /**
                            * Số hàng thành công.
                            */
                            successRows: number = 0;

                            /**
                            * Số hàng thất bại.
                            */
                            failedRows: number = 0;

                            /**
                            * Số hàng đã xử lý (thành công + thất bại).
                            */
                            processedRows: number = 0;

                            /**
                            * Danh sách lỗi chi tiết.
                            */
                            errors: RowError[] = [];

                            /**
                            * Thời gian bắt đầu job.
                            */
                            startedAt: string | null = null;

                            /**
                            * Thời gian hoàn thành job.
                            */
                            completedAt: string | null = null;

                            /**
                            * Số giây đã chạy (chỉ hiển thị khi job đang chạy).
                            */
                            elapsedSeconds: number = 0;

                            /**
                            * Cấu hình hiển thị cho trạng thái hiện tại.
                            */
                            statusConfig: StatusDisplayConfig = STATUS_CONFIG['pending'];

                            /**
                            * Kiểm tra có phải là trạng thái cuối cùng không.
                            */
                            get isTerminal(): boolean {
                            return this.statusConfig?.isTerminal || false;
                            }

                            /**
                            * Kiểm tra có thể hủy job không (chỉ khi pending hoặc running).
                            */
                            get canCancel(): boolean {
                            return this.status === 'pending' || this.status === 'running';
                            }

                            /**
                            * Đang thực hiện hủy job chưa.
                            */
                            cancelling: boolean = false;

                            /**
                            * Hiển thị tất cả lỗi (hay chỉ hiển thị giới hạn).
                            */
                            showAllErrors: boolean = false;

                            /**
                            * Các lỗi đang được mở rộng để xem chi tiết.
                            */
                            expandedErrors: Set<RowError> = new Set();

                                /**
                                * Các cột hiển thị trong bảng lỗi.
                                */
                                errorDisplayColumns: string[] = ['rowNumber', 'message', 'data'];

                                // =========================================================================
                                // Subscription
                                // =========================================================================

                                /**
                                * Collection subscriptions để hủy khi destroy.
                                */
                                private subscriptions: Subscription = new Subscription();

                                /**
                                * Timer tính thời gian đã chạy.
                                */
                                private elapsedTimer: ReturnType<typeof setInterval> | null = null;

                                    /**
                                    * Đếm số lần polling hiện tại.
                                    */
                                    private pollCount: number = 0;

                                    // =========================================================================
                                    // Context variables từ Jinja2
                                    // =========================================================================

                                    /** Danh sách job import (từ context) */
                                    private importJobs: Readonly<any[]> = {{ import_jobs | tojson if import_jobs else []
                                        | tojson }};

                                        /** Danh sách job export (từ context) */
                                        private exportJobs: Readonly<any[]> = {{ export_jobs | tojson if export_jobs
                                            else [] | tojson }};

                                            /** Danh sách job ETL (từ context) */
                                            private etlJobs: Readonly<any[]> = {{ etl_jobs | tojson if etl_jobs else []
                                                | tojson }};

                                                /** Các trạng thái job (từ context) */
                                                jobStatuses: Readonly<string[]> = {{ job_statuses | tojson if
                                                    job_statuses else ['pending', 'running', 'completed', 'failed',
                                                    'cancelled'] | tojson }};

                                                    /** Các loại transform (từ context) */
                                                    transformTypes: Readonly<string[]> = {{ transform_types | tojson if
                                                        transform_types else [] | tojson }};

                                                        /** Các nguồn extract (từ context) */
                                                        extractSources: Readonly<string[]> = {{ extract_sources | tojson
                                                            if extract_sources else [] | tojson }};

                                                            /** Các chế độ load (từ context) */
                                                            loadModes: Readonly<string[]> = {{ load_modes | tojson if
                                                                load_modes else ['insert', 'update', 'upsert'] | tojson
                                                                }};

                                                                //
                                                                =========================================================================
                                                                // Lifecycle
                                                                //
                                                                =========================================================================

                                                                constructor(
                                                                private importService: ImportService,
                                                                private exportService: ExportService,
                                                                private snackBar: MatSnackBar,
                                                                private cdr: ChangeDetectorRef,
                                                                ) {}

                                                                /**
                                                                * OnInit — bắt đầu theo dõi job.
                                                                */
                                                                ngOnInit(): void {
                                                                if (this.jobKey) {
                                                                this.startPolling();
                                                                }
                                                                }

                                                                /**
                                                                * OnDestroy — dừng polling và cleanup.
                                                                */
                                                                ngOnDestroy(): void {
                                                                this.subscriptions.unsubscribe();
                                                                this.stopElapsedTimer();
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Polling
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Bắt đầu polling trạng thái job.
                                                                */
                                                                private startPolling(): void {
                                                                if (!this.jobKey) {
                                                                console.warn('[JobStatusComponent] jobKey không được
                                                                cung cấp, không thể polling');
                                                                return;
                                                                }

                                                                // Sử dụng ImportService.pollJobStatus cho cả import và
                                                                export
                                                                // (ETL có thể dùng service riêng nếu có)
                                                                const pollSub =
                                                                this.getJobStatusObservable(this.jobKey).subscribe({
                                                                next: (statusInfo: any) => {
                                                                this.pollCount++;
                                                                this.updateState(statusInfo);

                                                                // Kiểm tra nếu đã đạt trạng thái cuối cùng
                                                                if (this.isTerminal) {
                                                                this.stopElapsedTimer();
                                                                this.subscriptions.unsubscribe();
                                                                this.showJobCompletedNotification();
                                                                return;
                                                                }

                                                                // Kiểm tra nếu đạt số lần polling tối đa
                                                                if (this.pollCount >= this.maxPollAttempts) {
                                                                console.warn(
                                                                `[JobStatusComponent] Đã đạt số lần polling tối đa
                                                                ${this.maxPollAttempts}`,
                                                                );
                                                                this.status = 'failed';
                                                                this.statusConfig = STATUS_CONFIG['failed'];
                                                                this.statusChanged.emit(this.status);
                                                                this.subscriptions.unsubscribe();
                                                                }
                                                                },
                                                                error: (err: any) => {
                                                                console.error('[JobStatusComponent] Lỗi polling:', err);
                                                                this.status = 'failed';
                                                                this.statusConfig = STATUS_CONFIG['failed'];
                                                                this.progress = 0;
                                                                this.subscriptions.unsubscribe();
                                                                this.showSnackBar('Lỗi khi kiểm tra trạng thái job',
                                                                'error');
                                                                },
                                                                });

                                                                this.subscriptions.add(pollSub);

                                                                // Bắt đầu timer tính thời gian đã chạy
                                                                this.startElapsedTimer();
                                                                }

                                                                /**
                                                                * Lấy Observable trạng thái job phù hợp với loại job.
                                                                *
                                                                * @param jobKey — Khóa job
                                                                * @returns Observable chứa thông tin trạng thái
                                                                */
                                                                private getJobStatusObservable(jobKey: string): any {
                                                                if (this.jobType === 'export') {
                                                                return this.exportService.getExportStatus(jobKey);
                                                                } else {
                                                                // Import và ETL đều dùng polling qua ImportService
                                                                // (ETL có thể dùng service riêng nếu triển khai)
                                                                return this.importService.pollJobStatus(
                                                                jobKey,
                                                                this.pollingInterval,
                                                                this.maxPollAttempts,
                                                                );
                                                                }
                                                                }

                                                                /**
                                                                * Lấy trạng thái job một lần (không polling).
                                                                *
                                                                * @param jobKey — Khóa job
                                                                * @returns Observable chứa thông tin trạng thái
                                                                */
                                                                private getJobStatusOnce(jobKey: string): any {
                                                                if (this.jobType === 'export') {
                                                                return this.exportService.getExportStatus(jobKey);
                                                                }
                                                                return this.importService.getJobStatus(jobKey);
                                                                }

                                                                /**
                                                                * Cập nhật trạng thái nội bộ từ thông tin job.
                                                                *
                                                                * @param statusInfo — Thông tin trạng thái từ backend
                                                                */
                                                                private updateState(statusInfo: JobStatusInfo |
                                                                ExportStatusInfo): void {
                                                                const rawStatus = (statusInfo as any).status as string;

                                                                // Ánh xạ trạng thái từ backend sang JobStatus
                                                                let normalizedStatus: JobStatus;
                                                                if (rawStatus === 'done' || rawStatus === 'completed') {
                                                                normalizedStatus = 'completed';
                                                                } else if (rawStatus === 'error' || rawStatus ===
                                                                'failed') {
                                                                normalizedStatus = 'failed';
                                                                } else if (rawStatus === 'cancelled' || rawStatus ===
                                                                'canceled') {
                                                                normalizedStatus = 'cancelled';
                                                                } else if (rawStatus === 'running' || rawStatus ===
                                                                'processing') {
                                                                normalizedStatus = 'running';
                                                                } else {
                                                                normalizedStatus = 'pending';
                                                                }

                                                                this.status = normalizedStatus;
                                                                this.statusConfig = STATUS_CONFIG[normalizedStatus] ||
                                                                STATUS_CONFIG['pending'];
                                                                this.progress = (statusInfo as any).progress || 0;
                                                                this.totalRows = (statusInfo as any).totalRows || 0;
                                                                this.successRows = (statusInfo as any).successRows ||
                                                                (statusInfo as any).exportedRows || 0;
                                                                this.failedRows = (statusInfo as any).failedRows || 0;
                                                                this.processedRows = (statusInfo as any).processedRows
                                                                ||
                                                                (statusInfo as any).exportedRows ||
                                                                (this.successRows + this.failedRows);
                                                                this.startedAt = (statusInfo as any).startedAt || null;
                                                                this.completedAt = (statusInfo as any).completedAt ||
                                                                null;

                                                                // Cập nhật danh sách lỗi
                                                                const rawErrors = (statusInfo as any).errors;
                                                                if (Array.isArray(rawErrors) && rawErrors.length > 0) {
                                                                this.errors = rawErrors.map((e: any) => ({
                                                                rowNumber: e.rowNumber || 0,
                                                                message: e.message || 'Lỗi không xác định',
                                                                rowData: e.rowData || undefined,
                                                                }));
                                                                }

                                                                // Phát sự kiện thay đổi trạng thái
                                                                this.statusChanged.emit(this.status);

                                                                // Nếu là terminal state, phát sự kiện hoàn thành
                                                                if (this.isTerminal) {
                                                                this.jobCompleted.emit({
                                                                status: this.status,
                                                                successRows: this.successRows,
                                                                failedRows: this.failedRows,
                                                                totalRows: this.totalRows,
                                                                });
                                                                }

                                                                // Trigger change detection
                                                                this.cdr.detectChanges();
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Timer tính thời gian đã chạy
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Bắt đầu timer đếm giây đã chạy.
                                                                */
                                                                private startElapsedTimer(): void {
                                                                this.stopElapsedTimer();
                                                                this.elapsedSeconds = 0;
                                                                this.elapsedTimer = setInterval(() => {
                                                                if (this.status === 'running' || this.status ===
                                                                'pending') {
                                                                this.elapsedSeconds++;
                                                                this.cdr.detectChanges();
                                                                } else {
                                                                this.stopElapsedTimer();
                                                                }
                                                                }, 1000);
                                                                }

                                                                /**
                                                                * Dừng timer đếm giây đã chạy.
                                                                */
                                                                private stopElapsedTimer(): void {
                                                                if (this.elapsedTimer) {
                                                                clearInterval(this.elapsedTimer);
                                                                this.elapsedTimer = null;
                                                                }
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Tự động làm mới
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Bật/tắt tự động làm mới.
                                                                */
                                                                toggleAutoRefresh(): void {
                                                                this.autoRefresh = !this.autoRefresh;

                                                                if (this.autoRefresh && this.canCancel && this.jobKey) {
                                                                // Bắt đầu polling lại
                                                                this.pollCount = 0;
                                                                this.startPolling();
                                                                } else if (!this.autoRefresh) {
                                                                // Dừng polling
                                                                this.subscriptions.unsubscribe();
                                                                }
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Hủy job
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Xử lý khi người dùng nhấn nút hủy.
                                                                */
                                                                onCancel(): void {
                                                                if (!this.jobKey || !this.canCancel) return;

                                                                this.cancelling = true;

                                                                let cancelSub: Subscription;

                                                                if (this.jobType === 'export') {
                                                                // ExportService chưa có cancelJob, dùng ImportService
                                                                tạm thời
                                                                // hoặc tùy thuộc vào backend implementation
                                                                cancelSub =
                                                                this.importService.cancelJob(this.jobKey).subscribe({
                                                                next: (result) => {
                                                                this.cancelling = false;
                                                                this.status = 'cancelled';
                                                                this.statusConfig = STATUS_CONFIG['cancelled'];
                                                                this.statusChanged.emit(this.status);
                                                                this.stopElapsedTimer();
                                                                this.subscriptions.unsubscribe();
                                                                this.jobCancelled.emit(this.jobKey);
                                                                this.showSnackBar(result.message || 'Job đã được hủy',
                                                                'success');
                                                                },
                                                                error: (err: any) => {
                                                                this.cancelling = false;
                                                                this.showSnackBar(`Không thể hủy job: ${err.message ||
                                                                err}`, 'error');
                                                                },
                                                                });
                                                                } else {
                                                                cancelSub =
                                                                this.importService.cancelJob(this.jobKey).subscribe({
                                                                next: (result) => {
                                                                this.cancelling = false;
                                                                this.status = 'cancelled';
                                                                this.statusConfig = STATUS_CONFIG['cancelled'];
                                                                this.statusChanged.emit(this.status);
                                                                this.stopElapsedTimer();
                                                                this.subscriptions.unsubscribe();
                                                                this.jobCancelled.emit(this.jobKey);
                                                                this.showSnackBar(result.message || 'Job đã được hủy',
                                                                'success');
                                                                },
                                                                error: (err: any) => {
                                                                this.cancelling = false;
                                                                this.showSnackBar(`Không thể hủy job: ${err.message ||
                                                                err}`, 'error');
                                                                },
                                                                });
                                                                }

                                                                this.subscriptions.add(cancelSub);
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Thử lại job
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Xử lý khi người dùng nhấn nút thử lại.
                                                                */
                                                                onRetry(): void {
                                                                this.jobRetry.emit(this.jobKey);
                                                                this.showSnackBar('Đang yêu cầu thử lại job...',
                                                                'info');
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Đóng component
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Xử lý khi người dùng nhấn nút đóng.
                                                                */
                                                                onClose(): void {
                                                                this.subscriptions.unsubscribe();
                                                                this.stopElapsedTimer();
                                                                this.closed.emit();
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Hiển thị chi tiết lỗi
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Chuyển đổi mở/đóng chi tiết dữ liệu của một lỗi.
                                                                *
                                                                * @param error — Đối tượng lỗi cần toggle
                                                                */
                                                                toggleErrorDetail(error: RowError): void {
                                                                if (this.expandedErrors.has(error)) {
                                                                this.expandedErrors.delete(error);
                                                                } else {
                                                                this.expandedErrors.add(error);
                                                                }
                                                                }

                                                                /**
                                                                * Lấy danh sách lỗi cần hiển thị (có giới hạn nếu chưa
                                                                xem tất cả).
                                                                *
                                                                * @returns Mảng lỗi cần render
                                                                */
                                                                get errorsToDisplay(): RowError[] {
                                                                if (this.showAllErrors) {
                                                                return this.errors;
                                                                }
                                                                return this.errors.slice(0, this.maxDisplayedErrors);
                                                                }

                                                                //
                                                                =========================================================================
                                                                // Thông báo
                                                                //
                                                                =========================================================================

                                                                /**
                                                                * Hiển thị thông báo khi job hoàn thành.
                                                                */
                                                                private showJobCompletedNotification(): void {
                                                                if (this.status === 'completed') {
                                                                this.showSnackBar(
                                                                `Job hoàn thành: ${this.successRows} hàng thành công` +
                                                                (this.failedRows > 0 ? `, ${this.failedRows} hàng lỗi` :
                                                                ''),
                                                                'success',
                                                                );
                                                                } else if (this.status === 'failed') {
                                                                this.showSnackBar(
                                                                `Job thất bại: ${this.failedRows} hàng lỗi trong
                                                                ${this.totalRows} hàng`,
                                                                'error',
                                                                );
                                                                }
                                                                }

                                                                /**
                                                                * Hiển thị thông báo snackbar.
                                                                *
                                                                * @param message — Nội dung thông báo
                                                                * @param type — Loại thông báo (success/error/info)
                                                                */
                                                                private showSnackBar(message: string, type: 'success' |
                                                                'error' | 'info'): void {
                                                                const duration = type === 'error' ? 8000 : type ===
                                                                'success' ? 5000 : 3000;
                                                                this.snackBar.open(message, 'Đóng', {
                                                                duration,
                                                                horizontalPosition: 'center',
                                                                verticalPosition: 'bottom',
                                                                });
                                                                }
                                                                }