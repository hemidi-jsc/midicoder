/** Reset Password Component - CP21.
*
* Trang đặt lại mật khẩu mới (sau khi click link từ email).
*
* UI Framework: [{ui_framework}]
*/

import { Component, OnInit } from "@angular/core";
import { CommonModule } from "@angular/common";
import { RouterModule } from "@angular/router";
import { ActivatedRoute, Router } from "@angular/router";
import { FormBuilder, FormGroup, Validators, ReactiveFormsModule } from "@angular/forms";
{% set fw = ui_framework | default("material") %}
{% if fw == "material" %}
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatIconModule } from '@angular/material/icon';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
{% elif fw == "tailwind" %}
{# Tailwind uses utility classes, no UI library imports needed #}
{% elif fw == "bootstrap" %}
import { NgbModule } from '@ng-bootstrap/ng-bootstrap';
{% elif fw == "antd" %}
import { NzFormModule } from 'ng-zorro-antd/form';
import { NzInputModule } from 'ng-zorro-antd/input';
import { NzButtonModule } from 'ng-zorro-antd/button';
import { NzCardModule } from 'ng-zorro-antd/card';
{% elif fw == "carbon" %}
import { AngularCarbonModule } from '@carbon/angular';
{% endif %}

@Component({
selector: "app-reset-password",
standalone: true,
imports: [
CommonModule, ReactiveFormsModule, RouterModule,
{% if fw == "material" %}
MatFormFieldModule,
MatInputModule,
MatButtonModule,
MatCardModule,
MatIconModule,
MatProgressSpinnerModule,
{% elif fw == "tailwind" %}
// Tailwind — no additional imports, utility classes only
{% elif fw == "bootstrap" %}
NgbModule,
{% elif fw == "antd" %}
NzFormModule,
NzInputModule,
NzButtonModule,
NzCardModule,
{% elif fw == "carbon" %}
AngularCarbonModule,
{% endif %}
],
templateUrl: './reset-password.component.html',
})
export class ResetPasswordComponent implements OnInit {
resetForm!: FormGroup;
token: string = "";
loading = false;
error: string | null = null;
success = false;

constructor(
private readonly fb: FormBuilder,
private readonly route: ActivatedRoute,
private readonly router: Router,
) {}

ngOnInit(): void {
this.token = this.route.snapshot.queryParamMap.get('token') || "";
this.resetForm = this.fb.group({
password: ['', [Validators.required, Validators.minLength(8)]],
confirmPassword: ['', [Validators.required]],
});
}

/** Submit form đặt lại mật khẩu. */
onSubmit(): void {
if (this.resetForm.invalid) return;
if (this.resetForm.value.password !== this.resetForm.value.confirmPassword) {
this.error = "Mật khẩu xác nhận không khớp.";
return;
}
this.loading = true;
}

get password() { return this.resetForm.get('password')!; }
get confirmPassword() { return this.resetForm.get('confirmPassword')!; }
}