{% elif ui_framework == "carbon" %}import { Component, OnInit, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: '{{ selector }}',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './{{ template_file_name }}.html',
  styles: []
})
export class {{ component_class_name }}Component implements OnInit {
  @Input() value: string = '';
  @Input() type: 'default' | 'filter' | 'selection' | 'tag' = 'default';
  @Input() size: 'sm' | 'md' | 'lg' = 'sm';
  @Input() simple: boolean = false;

  @Output() closed = new EventEmitter<void>();

  ngOnInit(): void {}

  onClose(): void {
    this.closed.emit();
  }

  get sizeClass(): string {
    switch (this.size) {
      case 'sm': return 'text-xs py-0.5 px-1';
      case 'lg': return 'text-sm py-1 px-2';
      default: return 'text-xs py-0.5 px-1';
    }
  }
}
