/**
 * HttpClient Service — Typed API client for Angular
 *
 * Generated by midicoder — do not edit manually.
 * Uses Angular Material snackbar for error feedback.
 */

import { Injectable, Inject } from '@angular/core';
import { HttpClient, HttpHeaders, HttpParams } from '@angular/common/http';
import { Observable, throwError } from 'rxjs';
import { catchError, map } from 'rxjs/operators';
import { MatSnackBar } from '@angular/material/snack-bar';

{% if api_base_url %}
const API_BASE = '{{ api_base_url }}';
{% else %}
const API_BASE = '';
{% endif %}

export interface ApiResponse<T> {
  data: T;
  total?: number;
  page?: number;
  pageSize?: number;
  hasMore?: boolean;
}

export interface ApiListResponse<T> {
  items: T[];
  total: number;
  page: number;
  pageSize: number;
}

export interface PaginationParams {
  page?: number;
  pageSize?: number;
  sortField?: string;
  sortOrder?: 'asc' | 'desc';
}

@Injectable({
  providedIn: 'root',
})
export class HttpClientService {
  constructor(
    private http: HttpClient,
    private snackbar: MatSnackBar,
  ) {}

  private getHeaders(headers: Record<string, string> = {}): HttpHeaders {
    return new HttpHeaders({
      'Content-Type': 'application/json',
      ...headers,
    });
  }

  private handleError(error: any): Observable<never> {
    const message = error?.error?.message || error?.message || 'An error occurred';
    this.snackbar.open(message, 'Close', { duration: 5000 });
    return throwError(() => new Error(message));
  }

  // ── CRUD Operations ──────────────────────────────────────

  getAll<T>(entity: string, params?: PaginationParams): Observable<ApiListResponse<T>> {
    let url = `${API_BASE}/${entity}`;
    let httpParams = new HttpParams();

    if (params?.page) httpParams = httpParams.set('page', params.page.toString());
    if (params?.pageSize) httpParams = httpParams.set('pageSize', params.pageSize.toString());
    if (params?.sortField) httpParams = httpParams.set('sortField', params.sortField);
    if (params?.sortOrder) httpParams = httpParams.set('sortOrder', params.sortOrder);

    return this.http
      .get<ApiListResponse<T>>(url, { params: httpParams })
      .pipe(catchError(this.handleError));
  }

  getById<T>(entity: string, id: string | number): Observable<ApiResponse<T>> {
    return this.http
      .get<ApiResponse<T>>(`${API_BASE}/${entity}/${id}`)
      .pipe(catchError(this.handleError));
  }

  create<T>(entity: string, data: T): Observable<ApiResponse<T>> {
    return this.http
      .post<ApiResponse<T>>(`${API_BASE}/${entity}`, data)
      .pipe(catchError(this.handleError));
  }

  update<T>(entity: string, id: string | number, data: Partial<T>): Observable<ApiResponse<T>> {
    return this.http
      .put<ApiResponse<T>>(`${API_BASE}/${entity}/${id}`, data)
      .pipe(catchError(this.handleError));
  }

  delete(entity: string, id: string | number): Observable<void> {
    return this.http
      .delete<void>(`${API_BASE}/${entity}/${id}`)
      .pipe(catchError(this.handleError));
  }

  // ── Custom Query ──────────────────────────────────────────

  query<T>(url: string, params?: Record<string, any>): Observable<T> {
    let httpParams = new HttpParams();
    if (params) {
      Object.entries(params).forEach(([key, value]) => {
        if (value !== undefined && value !== null) {
          httpParams = httpParams.set(key, String(value));
        }
      });
    }
    return this.http
      .get<T>(`${API_BASE}${url}`, { params: httpParams })
      .pipe(catchError(this.handleError));
  }

  post<T>(url: string, data: any): Observable<T> {
    return this.http
      .post<T>(`${API_BASE}${url}`, data)
      .pipe(catchError(this.handleError));
  }
}

