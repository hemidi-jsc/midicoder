  post<T = any>(endpoint: string, body?: any): Observable<ApiResponse<T>> {
    return this.http
      .post<ApiResponse<T>>(this.buildUrl(endpoint), body, {
        headers: this.buildHeaders(),
        observe: 'response',
      })
      .pipe(
        map((res: HttpResponse<ApiResponse<T>>) => ({
