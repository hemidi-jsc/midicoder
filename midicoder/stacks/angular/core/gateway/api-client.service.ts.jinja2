  /**
   * Build full URL từ endpoint.
   *
   * @param endpoint - API endpoint
   * @returns Full URL string
   */
  private buildUrl(endpoint: string): string {
    const prefix = this.config.apiPrefix;
    const path = endpoint.startsWith('/') ? endpoint : `/${endpoint}`;
    return `${this.config.baseUrl}${prefix}${path}`;
  }

  /**
   * Build HTTP headers với auto-auth và tenant isolation.
   *
   * @returns HttpHeaders instance
   */
  private buildHeaders(): HttpHeaders {
    let headers = new HttpHeaders();

    // Tự động attach JWT token
    if (this.config.autoAuth) {
      const token = localStorage.getItem('access_token');
      if (token) {
        headers = headers.set('Authorization', `Bearer ${token}`);
      }
    }

    // KPI-029: Tenant isolation
    if (this.config.tenantScoped) {
      const tenantId = localStorage.getItem('tenant_id');
      if (tenantId) {
        headers = headers.set('X-Tenant-ID', tenantId);
      }
    }

    return headers.set('Content-Type', 'application/json');
  }

  /**
   * Handle API errors.
   *
   * @param error - HTTP error object
   * @returns Error Observable
   */
  private handleError(error: any): Observable<never> {
    let message = 'Lỗi không xác định từ server';

    if (error.error?.detail) {
      message = error.error.detail;
    } else if (error.status === 0) {
      message = 'Không thể kết nối đến server. Kiểm tra kết nối mạng.';
    } else if (error.status === 401) {
      message = 'Phiên đăng nhập hết hạn. Vui lòng đăng nhập lại.';
      localStorage.removeItem('access_token');
      localStorage.removeItem('refresh_token');
      window.location.href = '/login';
    } else if (error.status === 403) {
      message = 'Không có quyền truy cập tài nguyên này.';
    } else if (error.status >= 500) {
      message = 'Lỗi server nội bộ. Vui lòng thử lại sau.';
    }

    return throwError(() => new Error(message));
  }
