/**
* ApprovalService — Dịch vụ HTTP và WebSocket cho quy trình phê duyệt.
*
* Cung cấp các phương thức HTTP để thao tác CRUD với yêu cầu phê duyệt,
* ra quyết định, leo thang, ủy quyền. Quản lý kết nối WebSocket cho cập nhật
* realtime với cơ chế tự động kết nối lại.
*
* Tạo tự động bởi CP42 — không sửa thủ công.
*/

import { Injectable, inject } from '@angular/core';
import { HttpClient, HttpHeaders, HttpParams } from '@angular/common/http';
import { BehaviorSubject, Observable, Subject, of, timer } from 'rxjs';
import { switchMap, take, delay, catchError, retry, tap, shareReplay, finalize } from 'rxjs/operators';

import {
ApprovalRequest,
ApprovalStep,
ApprovalDecision,
EscalationRule,
DelegationRecord,
ApprovalEvent,
ApprovalStatus,
ApprovalType,
EscalationStrategy,
DelegationType,
NotificationConfig
} from './approval-types';

// ===========================================================================
// Cấu hình từ template
// ===========================================================================

/** URL API backend. */
const API_BASE_URL: string = '/api/approvals';

/** Cờ bật hệ thống sự kiện realtime. */
const USE_EVENTS: boolean = {{ 'true' if use_events else 'false' }};

/** URL WebSocket. */
const WS_URL: string = '{{ notification_config["webSocketUrl"] | default("ws://localhost:8080/ws/approvals") }}';;

/** Thời gian (ms) để tự động kết nối lại WebSocket. */
const WS_RECONNECT_DELAY: number = 3000;

/** Số lần kết nối lại tối đa trước khi bỏ cuộc. */
const WS_MAX_RECONNECT_ATTEMPTS: number = 5;

/**
* Trạng thái kết nối WebSocket.
*/
export interface WebSocketStatus {
/** Trạng thái: connected, disconnected, reconnecting, error */
status: 'connected' | 'disconnected' | 'reconnecting' | 'error';
/** Số lần kết nối lại hiện tại */
reconnectAttempts: number;
/** Thời điểm kết nối cuối cùng */
lastConnectedAt: string | null;
}

/**
* ApprovalService — Dịch vụ HTTP và WebSocket cho phê duyệt.
*/
@Injectable({
providedIn: 'root'
})
export class ApprovalService {
// ===========================================================================
// Inject dependencies
// ===========================================================================

private readonly http = inject(HttpClient);

// ===========================================================================
// WebSocket client
// ===========================================================================

/** Socket WebSocket hiện tại. */
private ws: WebSocket | null = null;

/** Subject phát ra sự kiện realtime từ WebSocket. */
private readonly eventSubject = new Subject<ApprovalEvent>();

    /** Subject theo dõi trạng thái kết nối WebSocket. */
    private readonly statusSubject = new BehaviorSubject<WebSocketStatus>({
        status: 'disconnected',
        reconnectAttempts: 0,
        lastConnectedAt: null
        });

        /** Cờ đang reconnect. */
        private isReconnecting: boolean = false;

        /** Số lần reconnect hiện tại. */
        private reconnectAttempts: number = 0;

        // ===========================================================================
        // Observable public
        // ===========================================================================

        /** Stream sự kiện realtime. */
        public readonly events$: Observable<ApprovalEvent> = this.eventSubject.asObservable();

            /** Stream trạng thái kết nối WebSocket. */
            public readonly connectionStatus$: Observable<WebSocketStatus> = this.statusSubject.asObservable();

                // ===========================================================================
                // HTTP Methods — CRUD cho ApprovalRequest
                // ===========================================================================

                /**
                * Lấy tất cả yêu cầu phê duyệt.
                *
                * @param status Lọc theo trạng thái (tùy chọn).
                * @param type Lọc theo loại phê duyệt (tùy chọn).
                * @param page Số trang (mặc định 0).
                * @param pageSize Số lượng trên mỗi trang (mặc định 25).
                * @returns Observable danh sách yêu cầu.
                */
                fetchAllRequests(
                status?: string,
                type?: string,
                page: number = 0,
                pageSize: number = 25
                ): Observable<ApprovalRequest[]> {
                    let params = new HttpParams()
                    .set('page', String(page))
                    .set('pageSize', String(pageSize));

                    if (status) {
                    params = params.set('status', status);
                    }
                    if (type) {
                    params = params.set('type', type);
                    }

                    return this.http.get<ApprovalRequest[]>(API_BASE_URL + '/requests', { params });
                        }

                        /**
                        * Lấy một yêu cầu phê duyệt theo ID.
                        *
                        * @param requestId ID yêu cầu phê duyệt.
                        * @returns Observable yêu cầu phê duyệt.
                        */
                        fetchRequestById(requestId: string): Observable<ApprovalRequest> {
                            return this.http.get<ApprovalRequest>(API_BASE_URL + '/requests/' +
                                encodeURIComponent(requestId));
                                }

                                /**
                                * Tạo yêu cầu phê duyệt mới.
                                *
                                * @param request Dữ liệu yêu cầu cần tạo.
                                * @returns Observable yêu cầu đã tạo.
                                */
                                createRequest(request: Partial<ApprovalRequest>): Observable<ApprovalRequest> {
                                        return this.http.post<ApprovalRequest>(API_BASE_URL + '/requests', request);
                                            }

                                            /**
                                            * Cập nhật yêu cầu phê duyệt.
                                            *
                                            * @param requestId ID yêu cầu.
                                            * @param updates Dữ liệu cập nhật.
                                            * @returns Observable yêu cầu đã cập nhật.
                                            */
                                            updateRequest(requestId: string, updates: Partial<ApprovalRequest>):
                                                Observable<ApprovalRequest> {
                                                    return this.http.patch<ApprovalRequest>(
                                                        API_BASE_URL + '/requests/' + encodeURIComponent(requestId),
                                                        updates
                                                        );
                                                        }

                                                        /**
                                                        * Xóa yêu cầu phê duyệt.
                                                        *
                                                        * @param requestId ID yêu cầu cần xóa.
                                                        * @returns Observable thông báo kết quả.
                                                        */
                                                        deleteRequest(requestId: string): Observable<void> {
                                                            return this.http.delete<void>(API_BASE_URL + '/requests/' +
                                                                encodeURIComponent(requestId));
                                                                }

                                                                //
                                                                ===========================================================================
                                                                // HTTP Methods — ApprovalStep
                                                                //
                                                                ===========================================================================

                                                                /**
                                                                * Lấy tất cả bước phê duyệt của một yêu cầu.
                                                                *
                                                                * @param requestId ID yêu cầu phê duyệt.
                                                                * @returns Observable danh sách bước.
                                                                */
                                                                fetchSteps(requestId: string): Observable
                                                                <ApprovalStep[]> {
                                                                    return this.http.get<ApprovalStep[]>(
                                                                        API_BASE_URL + '/requests/' +
                                                                        encodeURIComponent(requestId) + '/steps'
                                                                        );
                                                                        }

                                                                        /**
                                                                        * Thêm bước phê duyệt mới vào chuỗi.
                                                                        *
                                                                        * @param requestId ID yêu cầu cha.
                                                                        * @param step Dữ liệu bước cần thêm.
                                                                        * @returns Observable bước đã tạo.
                                                                        */
                                                                        addStep(requestId: string, step: Partial
                                                                        <ApprovalStep>): Observable<ApprovalStep> {
                                                                                return this.http.post<ApprovalStep>(
                                                                                    API_BASE_URL + '/requests/' +
                                                                                    encodeURIComponent(requestId) +
                                                                                    '/steps',
                                                                                    step
                                                                                    );
                                                                                    }

                                                                                    /**
                                                                                    * Cập nhật bước phê duyệt.
                                                                                    *
                                                                                    * @param requestId ID yêu cầu cha.
                                                                                    * @param stepId ID bước cần cập
                                                                                    nhật.
                                                                                    * @param updates Dữ liệu cập nhật.
                                                                                    * @returns Observable bước đã cập
                                                                                    nhật.
                                                                                    */
                                                                                    updateStep(requestId: string,
                                                                                    stepId: string, updates: Partial
                                                                                    <ApprovalStep>): Observable
                                                                                        <ApprovalStep> {
                                                                                            return this.http.patch
                                                                                            <ApprovalStep>(
                                                                                                API_BASE_URL +
                                                                                                '/requests/' +
                                                                                                encodeURIComponent(requestId)
                                                                                                + '/steps/' +
                                                                                                encodeURIComponent(stepId),
                                                                                                updates
                                                                                                );
                                                                                                }

