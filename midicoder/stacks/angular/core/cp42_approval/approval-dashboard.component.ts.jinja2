/**
* ApprovalDashboardComponent — Bang dieu khien tong quan phe duyet.
*
* Hien thi tong quan cac yeu cau phe duyet dang cho xu ly. Thong ke nhanh
* theo trang thai (pending/approved/rejected/escalated). Nut hanh dong nhanh.
* Loc theo loai phe duyet va trang thai. Tap hop WebSocket cho cap nhat realtime.
*
* Tao tu dong boi CP42 — khong sua thu cong.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectorRef,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatTabsModule } from '@angular/material/tabs';
import { MatChipsModule } from '@angular/material/chips';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
{% elif ui_framework == "tailwind" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectorRef,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectorRef,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectorRef,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Ant Design khong dung cho Angular
{% elif ui_framework == "carbon" %}
import {
Component,
OnInit,
OnDestroy,
ChangeDetectorRef,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
// Carbon khong dung cho Angular
{% endif %}

import { ApprovalService } from './approval.service';
import { ApprovalStore } from './approval.store';
import {
ApprovalRequest,
ApprovalStatus,
ApprovalType,
ApprovalEvent,
NotificationConfig
} from './approval-types';

// ===========================================================================
// Cấu hình từ template
// ===========================================================================

/** Cờ bật hệ thống sự kiện realtime. */
const USE_EVENTS: boolean = {{ 'true' if use_events else 'false' }};

/** Số yêu cầu phê duyệt mẫu. */
const NUM_REQUESTS: number = {{ num_requests }};

/**
* Cấu hình thông báo mặc định.
*/
const NOTIFICATION_CONFIG: NotificationConfig = {
emailEnabled: {{ 'true' if notification_config.get('emailEnabled', false) else 'false' }},
pushEnabled: {{ 'true' if notification_config.get('pushEnabled', false) else 'false' }},
notifyOnStepAssigned: {{ 'true' if notification_config.get('notifyOnStepAssigned', false) else 'false' }},
notifyOnDeadlineApproaching: {{ 'true' if notification_config.get('notifyOnDeadlineApproaching', false) else 'false' }},
deadlineWarningHours: {{ notification_config.get('deadlineWarningHours', 24) }},
notifyOnEscalation: {{ 'true' if notification_config.get('notifyOnEscalation', false) else 'false' }},
notifyOnDelegation: {{ 'true' if notification_config.get('notifyOnDelegation', false) else 'false' }}
};

/**
* ApprovalDashboardComponent — Bảng điều khiển tổng quan phê duyệt.
*
* Sử dụng:
* <app-approval-dashboard></app-approval-dashboard>
*/
@Component({
selector: 'app-approval-dashboard',
standalone: true,
imports: [CommonModule, FormsModule],
changeDetection: ChangeDetectionStrategy.OnPush,

template:
{% raw %}
`
<div class="approval-dashboard">
    <!-- Tiêu đề -->
    <header class="dashboard-header">
        <h1>Bảng Điều Khiên Phê Duyệt</h1>
        <span class="event-indicator" [class.active]="isEventsEnabled()">
            {{ isEventsEnabled() ? '● Realtime' : '○ Offline' }}
        </span>
    </header>

    <!-- Thẻ thống kê -->
    <section class="stats-cards">
        <div class="stat-card pending" (click)="onFilterByStatus('pending')">
            <div class="stat-value">{{ pendingCount() }}</div>
            <div class="stat-label">Đang Chờ</div>
        </div>
        <div class="stat-card approved" (click)="onFilterByStatus('approved')">
            <div class="stat-value">{{ approvedCount() }}</div>
            <div class="stat-label">Đã Phê Duyệt</div>
        </div>
        <div class="stat-card rejected" (click)="onFilterByStatus('rejected')">
            <div class="stat-value">{{ rejectedCount() }}</div>
            <div class="stat-label">Đã Từ Chối</div>
        </div>
        <div class="stat-card escalated" (click)="onFilterByStatus('escalated')">
            <div class="stat-value">{{ escalatedCount() }}</div>
            <div class="stat-label">Đã Leo Thang</div>
        </div>
    </section>

    <!-- Bộ lọc -->
    <section class="filter-bar">
        <label for="type-filter">Lọc theo loại:</label>
        <select id="type-filter" [(ngModel)]="selectedType" (change)="onFilterChange()">
            <option value="">Tất cả</option>
            <option value="sequential">Tuần tự</option>
            <option value="parallel">Song song</option>
            <option value="matrix">Ma trận</option>
            <option value="voting">Biểu quyết</option>
            <option value="single">Đơn lẻ</option>
        </select>

        <label for="status-filter">Lọc theo trạng thái:</label>
        <select id="status-filter" [(ngModel)]="selectedStatus" (change)="onFilterChange()">
            <option value="">Tất cả</option>
            <option value="pending">Đang chờ</option>
            <option value="approved">Đã phê duyệt</option>
            <option value="rejected">Đã từ chối</option>
            <option value="escalated">Đã leo thang</option>
            <option value="expired">Hết hạn</option>
            <option value="cancelled">Đã hủy</option>
        </select>
    </section>

    <!-- Nút hành động nhanh -->
    <section class="quick-actions">
        <button class="btn-action" (click)="refreshRequests()">
            Làm mới dữ liệu
        </button>
        <button class="btn-action btn-export" (click)="exportPending()">
            Xuất danh sách đang chờ
        </button>
    </section>

    <!-- Danh sách yêu cầu đang chờ -->
    <section class="requests-list">
        <h2>Yêu Cầu Đang Chờ Xử Lý</h2>
        <div class="request-items" *ngIf="filteredRequests().length; else emptyState">
            <div class="request-item" *ngFor="let request of filteredRequests()" (click)="onSelectRequest(request)"
                [class]="getRequestStatusClass(request.status)">
                <div class="request-header">
                    <span class="request-id">#{{ request.requestId }}</span>
                    <span class="request-title">{{ request.title }}</span>
                </div>
                <div class="request-meta">
                    <span class="request-type">{{ getApprovalTypeLabel(request.approvalType) }}</span>
                    <span class="request-step">Bước {{ request.currentStep }}/{{ request.totalSteps }}</span>
                    <span class="request-deadline">Hạn: {{ request.deadline | date:'dd/MM/yyyy' }}</span>
                </div>
            </div>
        </div>
        <ng-template #emptyState>
            <div class="empty-state">
                <p>Không có yêu cầu nào phù hợp với bộ lọc.</p>
            </div>
        </ng-template>
    </section>

    <!-- Log sự kiện realtime -->
    <section class="event-log" *ngIf="isEventsEnabled()">
        <h2>Sự Kiện Realtime</h2>
        <div class="event-items">
            <div class="event-item" *ngFor="let event of recentEvents()">
                <span class="event-type">{{ event.eventType }}</span>
                <span class="event-request">#{{ event.requestId }}</span>
                <span class="event-time">{{ event.timestamp | date:'HH:mm:ss' }}</span>
            </div>
        </div>
    </section>
</div>
`,
{% endraw %}
