export class ApprovalDashboardComponent implements OnInit, OnDestroy {
// ===========================================================================
// Inject dependencies
// ===========================================================================

private readonly cd = inject(ChangeDetectorRef);
private readonly approvalService = inject(ApprovalService);
private readonly approvalStore = inject(ApprovalStore);

// ===========================================================================
// Local state
// ===========================================================================

/** Loại phê duyệt đang lọc. */
public selectedType: string = '';

/** Trạng thái đang lọc. */
public selectedStatus: string = '';

/** Cờ bật sự kiện realtime. */
public readonly isEventsEnabled = signal<boolean>(USE_EVENTS);

    /** Sự kiện realtime gần đây (tối đa 20). */
    public readonly recentEvents = signal<ApprovalEvent[]>([]);

        // ===========================================================================
        // Computed từ store
        // ===========================================================================

        /** Danh sách tất cả yêu cầu từ store. */
        public readonly allRequests = this.approvalStore.pendingRequests;

        /** Số lượng yêu cầu đang chờ. */
        public readonly pendingCount = computed<number>(() => {
            return this.allRequests().filter(r => r.status === ApprovalStatus.PENDING).length;
            });

            /** Số lượng yêu cầu đã phê duyệt. */
            public readonly approvedCount = computed<number>(() => {
                return this.allRequests().filter(r => r.status === ApprovalStatus.APPROVED).length;
                });

                /** Số lượng yêu cầu đã từ chối. */
                public readonly rejectedCount = computed<number>(() => {
                    return this.allRequests().filter(r => r.status === ApprovalStatus.REJECTED).length;
                    });

                    /** Số lượng yêu cầu đã leo thang. */
                    public readonly escalatedCount = computed<number>(() => {
                        return this.allRequests().filter(r => r.status === ApprovalStatus.ESCALATED).length;
                        });

                        /** Danh sách yêu cầu đã lọc theo loại và trạng thái. */
                        public readonly filteredRequests = computed<ApprovalRequest[]>(() => {
                            let requests = this.allRequests();

                            // Lọc theo loại phê duyệt.
                            if (this.selectedType) {
                            requests = requests.filter(r => r.approvalType === this.selectedType as ApprovalType);
                            }

                            // Lọc theo trạng thái.
                            if (this.selectedStatus) {
                            requests = requests.filter(r => r.status === this.selectedStatus as ApprovalStatus);
                            }

                            return requests;
                            });

                            // ===========================================================================
                            // Lifecycle
                            // ===========================================================================

                            ngOnInit(): void {
                            // Tải danh sách yêu cầu ban đầu.
                            this.approvalService.fetchAllRequests().pipe(takeUntilDestroyed()).subscribe(requests => {
                            this.approvalStore.setRequests(requests);
                            });

                            // Tích hợp WebSocket cho cập nhật realtime.
                            if (USE_EVENTS) {
                            this.approvalService.connectWebSocket().pipe(takeUntilDestroyed()).subscribe();

                            // Lắng nghe sự kiện realtime.
                            this.approvalService.events$.pipe(takeUntilDestroyed()).subscribe((event: ApprovalEvent) =>
                            {
                            this.addRecentEvent(event);
                            this.handleRealtimeEvent(event);
                            });
                            }
                            }

                            ngOnDestroy(): void {
                            // Ngắt kết nối WebSocket khi hủy component.
                            if (USE_EVENTS) {
                            this.approvalService.disconnectWebSocket();
                            }
                            }

                            // ===========================================================================
                            // Xử lý lọc
                            // ===========================================================================

                            /**
                            * Xử lý khi thay đổi bộ lọc.
                            */
                            onFilterChange(): void {
                            this.cd.markForCheck();
                            }

                            /**
                            * Lọc theo trạng thái từ thẻ thống kê.
                            */
                            onFilterByStatus(status: string): void {
                            this.selectedStatus = status;
                            this.onFilterChange();
                            }

                            /**
                            * Chọn một yêu cầu để xem chi tiết.
                            */
                            onSelectRequest(request: ApprovalRequest): void {
                            this.approvalStore.setCurrentRequest(request);
                            console.info('[ApprovalDashboard] Chọn yêu cầu:', request.requestId);
                            }

                            // ===========================================================================
                            // Hành động nhanh
                            // ===========================================================================

                            /**
                            * Làm mới danh sách yêu cầu từ server.
                            */
                            refreshRequests(): void {
                            this.approvalService.fetchAllRequests().subscribe(requests => {
                            this.approvalStore.setRequests(requests);
                            });
                            }

                            /**
                            * Xuất danh sách yêu cầu đang chờ dưới dạng CSV.
                            */
                            exportPending(): void {
                            const pending = this.allRequests().filter(r => r.status === ApprovalStatus.PENDING);
                            const csv = this.generateCSV(pending);
                            this.downloadCSV(csv, 'pending-approvals.csv');
                            }

                            /**
                            * Tạo nội dung CSV từ danh sách yêu cầu.
                            */
                            private generateCSV(requests: ApprovalRequest[]): string {
                            const header = 'ID,Ti\u00eau \u0110\u1ec1,Loại,Tr\u1ea1ng th\u00e1i,B\u01b0\u1edbc,Hạn';
                            const rows = requests.map(r =>
                            [r.requestId, r.title, r.approvalType, r.status,
                            r.currentStep + '/' + r.totalSteps, r.deadline || ''].join(',')
                            );
                            return [header, ...rows].join('\n');
                            }

                            /**
                            * Tải file CSV về máy.
                            */
                            private downloadCSV(content: string, filename: string): void {
                            const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
                            const link = document.createElement('a');
                            link.href = URL.createObjectURL(blob);
                            link.download = filename;
                            link.click();
                            URL.revokeObjectURL(link.href);
                            }

                            // ===========================================================================
                            // Xử lý sự kiện realtime
                            // ===========================================================================

                            /**
                            * Thêm sự kiện vào danh sách gần đây.
                            */
                            private addRecentEvent(event: ApprovalEvent): void {
                            const current = this.recentEvents();
                            const updated = [event, ...current].slice(0, 20);
                            this.recentEvents.set(updated);
                            }

                            /**
                            * Xử lý sự kiện realtime — cập nhật store tương ứng.
                            */
                            private handleRealtimeEvent(event: ApprovalEvent): void {
                            switch (event.eventType) {
                            case 'request_created':
                            this.approvalStore.addRequest(event.payload as any);
                            break;
                            case 'request_updated':
                            this.approvalStore.updateRequest(event.requestId, event.payload as any);
                            break;
                            case 'decision_made':
                            this.approvalStore.addDecision(event.payload as any);
                            break;
                            case 'escalated':
                            this.approvalStore.escalateRequest(event.requestId);
                            break;
                            case 'delegated':
                            this.approvalStore.delegateRequest(event.requestId, event.payload as any);
                            break;
                            default:
                            console.info('[ApprovalDashboard] Sự kiện chưa xử lý:', event.eventType);
                            }
                            }

                            // ===========================================================================
                            // Helper methods
                            // ===========================================================================

                            /**
                            * Lấy class CSS cho trạng thái yêu cầu.
                            */
                            getRequestStatusClass(status: string): string {
                            const classMap: Record<string, string> = {
                                pending: 'status-pending',
                                approved: 'status-approved',
                                rejected: 'status-rejected',
                                escalated: 'status-escalated',
                                expired: 'status-expired',
                                cancelled: 'status-cancelled'
                                };
                                return classMap[status] || '';
                                }

                                /**
                                * Lấy nhãn tiếng Việt cho loại phê duyệt.
                                */
                                getApprovalTypeLabel(type: string): string {
                                const labelMap: Record<string, string> = {
                                    sequential: 'Tuần tự',
                                    parallel: 'Song song',
                                    matrix: 'Ma trận',
                                    voting: 'Biểu quyết',
                                    single: 'Đơn lẻ'
                                    };
                                    return labelMap[type] || type;
                                    }
                                    }