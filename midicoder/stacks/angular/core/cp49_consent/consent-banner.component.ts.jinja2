* CP49 Consent & Preference Management — Consent Banner Component.
*
* Banner thông báo cookie và thu thập đồng ý từ người dùng.
* Tuân thủ GDPR với các tùy chọn: Chấp nhận tất cả, Từ chối tất cả,
* Tùy chỉnh, Cài đặt chi tiết.
*
* Sử dụng Signal-based state management của Angular.
*
* Tạo tự động bởi CP49 — không sửa thủ công.
*/
{% if ui_framework == "material" %}
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatCheckboxModule } from '@angular/material/checkbox';
import { MatDialogModule } from '@angular/material/dialog';
{% elif ui_framework == "tailwind" %}
