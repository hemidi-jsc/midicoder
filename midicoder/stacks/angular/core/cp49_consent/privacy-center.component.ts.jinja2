import { Component, inject, OnInit, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Observable, firstValueFrom } from 'rxjs';
import { ConsentService } from './consent.service';
import {
ConsentRecord,
ConsentPurpose,
ConsentCategory,
ConsentStatus,
CookiePreference,
CommunicationPreference,
ErasureRequest,
ErasureScope,
ConsentStats,
} from './consent-types';

/**
* Tab đang hoạt động trong Privacy Center.
*/
type PrivacyCenterTab = 'consents' | 'cookies' | 'communication' | 'erasure' | 'stats';

/**
* PrivacyCenterComponent — Trung tâm quyền riêng tư.
*
* Cung cấp giao diện thống nhất để người dùng quản lý:
* - Bản ghi đồng ý (xem, cấp, hủy)
* - Tùy chọn cookie (chấp nhận, từ chối, tùy chỉnh)
* - Tùy chọn liên lạc (bật/tắt theo kênh)
* - Yêu cầu xóa dữ liệu (GDPR Art.17)
* - Thống kê đồng ý tổng quan
*
* Sử dụng tab navigation để tổ chức các chức năng.
*/
@Component({
selector: 'app-privacy-center',
standalone: true,
imports: [CommonModule, FormsModule],
templateUrl: './privacy-center.component.html',
styleUrl: './privacy-center.component.css',
})
export class PrivacyCenterComponent implements OnInit {
// ===========================================================================
// Inject dependencies
// ===========================================================================

/** Dịch vụ HTTP cho consent API. */
private readonly consentService = inject(ConsentService);

// ===========================================================================
// Signals
// ===========================================================================

/** Tab đang hoạt động. */
readonly activeTab = signal<PrivacyCenterTab>('consents');

    /** Danh sách bản ghi đồng ý. */
    readonly consents = signal<ConsentRecord[]>([]);

        /** Tùy chọn cookie hiện tại. */
        readonly cookiePreference = signal<CookiePreference | null>(null);

            /** Tùy chọn liên lạc hiện tại. */
            readonly commPreference = signal<CommunicationPreference | null>(null);

                /** Danh sách yêu cầu xóa. */
                readonly erasureRequests = signal<ErasureRequest[]>([]);

                    /** Thống kê đồng ý. */
                    readonly stats = signal<ConsentStats | null>(null);

                        /** Đang tải dữ liệu. */
                        readonly isLoading = signal<boolean>(false);

                            /** Thông báo lỗi. */
                            readonly error = signal<string | null>(null);

                                /** Đang hiển thị modal xác nhận. */
                                readonly showConfirmModal = signal<boolean>(false);

                                    /** Callback xác nhận. */
                                    readonly confirmCallback = signal<()=> void>(() => {});

                                        /** Tiêu đề modal xác nhận. */
                                        readonly confirmTitle = signal<string>('');

                                            //
                                            ===========================================================================
                                            // Lifecycle
                                            //
                                            ===========================================================================

                                            /**
                                            * Khởi tạo component — tải dữ liệu ban đầu.
                                            */
                                            async ngOnInit(): Promise<void> {
                                                await this.loadAllData();
                                                }

                                                //
                                                ===========================================================================
                                                // Data loading
                                                //
                                                ===========================================================================

                                                /**
                                                * Tải tất cả dữ liệu cần thiết cho Privacy Center.
                                                */
                                                private async loadAllData(): Promise<void> {
                                                    this.isLoading.set(true);
                                                    this.error.set(null);

                                                    try {
                                                    // Tải song song tất cả dữ liệu
                                                    const [consents, cookiePref, commPref, erasureReqs, stats] = await
                                                    Promise.all([
                                                    firstValueFrom(this.consentService.getUserConsents()),
                                                    firstValueFrom(this.consentService.getCookiePreference()),
                                                    firstValueFrom(this.consentService.getCommPreference()),
                                                    firstValueFrom(this.consentService.getErasureRequests()),
                                                    firstValueFrom(this.consentService.getTenantStats()),
                                                    ]);

                                                    this.consents.set(consents);
                                                    this.cookiePreference.set(cookiePref);
                                                    this.commPreference.set(commPref);
                                                    this.erasureRequests.set(erasureReqs);
                                                    this.stats.set(stats);
                                                    } catch (err: any) {
                                                    this.error.set(err.message || 'Lỗi khi tải dữ liệu');
                                                    console.error('[CP49] Lỗi tải dữ liệu Privacy Center:', err);
                                                    } finally {
                                                    this.isLoading.set(false);
                                                    }
                                                    }

                                                    //
                                                    ===========================================================================
                                                    // Tab navigation
                                                    //
                                                    ===========================================================================

                                                    /**
                                                    * Chuyển đổi tab đang hoạt động.
                                                    *
                                                    * @param tab - Tab cần chuyển đến.
                                                    */
                                                    switchTab(tab: PrivacyCenterTab): void {
                                                    this.activeTab.set(tab);
                                                    }

                                                    /**
                                                    * Kiểm tra tab có đang hoạt động không.
                                                    *
                                                    * @param tab - Tab cần kiểm tra.
                                                    * @returns True nếu tab đang hoạt động.
                                                    */
                                                    isActiveTab(tab: PrivacyCenterTab): boolean {
                                                    return this.activeTab() === tab;
                                                    }

                                                    //
                                                    ===========================================================================
                                                    // Consent actions
                                                    //
                                                    ===========================================================================

                                                    /**
                                                    * Hủy đồng ý theo ID bản ghi.
                                                    *
                                                    * Hiển thị modal xác nhận trước khi thực hiện.
                                                    *
                                                    * @param recordId - ID bản ghi đồng ý cần hủy.
                                                    */
                                                    confirmRevokeConsent(recordId: string): void {
                                                    this.confirmTitle.set('Xác nhận hủy đồng ý');
                                                    this.confirmCallback.set(async () => {
                                                    this.isLoading.set(true);
                                                    try {
                                                    await firstValueFrom(this.consentService.revokeConsent(recordId));
                                                    await this.loadAllData();
                                                    } catch (err: any) {
                                                    this.error.set(err.message || 'Lỗi khi hủy đồng ý');
                                                    } finally {
                                                    this.isLoading.set(false);
                                                    this.showConfirmModal.set(false);
                                                    }
                                                    });
                                                    this.showConfirmModal.set(true);
                                                    }

                                                    /**
                                                    * Xác nhận hành động từ modal.
                                                    */
                                                    async confirmAction(): Promise<void> {
                                                        await this.confirmCallback()();
                                                        }

                                                        /**
                                                        * Hủy hành động từ modal.
                                                        */
                                                        cancelAction(): void {
                                                        this.showConfirmModal.set(false);
                                                        }

                                                        //
                                                        ===========================================================================
                                                        // Cookie actions
                                                        //
                                                        ===========================================================================

                                                        /**
                                                        * Chấp nhận tất cả cookie.
                                                        */
                                                        async acceptAllCookies(): Promise<void> {
                                                            this.isLoading.set(true);
                                                            try {
                                                            await
                                                            firstValueFrom(this.consentService.acceptAllCookies());
                                                            await this.loadAllData();
                                                            } catch (err: any) {
                                                            this.error.set(err.message || 'Lỗi khi chấp nhận cookie');
                                                            } finally {
                                                            this.isLoading.set(false);
                                                            }
                                                            }

                                                            /**
                                                            * Từ chối tất cả cookie không cần thiết.
                                                            */
                                                            async rejectNonNecessaryCookies(): Promise<void> {
                                                                this.isLoading.set(true);
                                                                try {
                                                                await
                                                                firstValueFrom(this.consentService.rejectNonNecessaryCookies());
                                                                await this.loadAllData();
                                                                } catch (err: any) {
                                                                this.error.set(err.message || 'Lỗi khi từ chối cookie');
                                                                } finally {
                                                                this.isLoading.set(false);
                                                                }
                                                                }

                                                                //
                                                                ===========================================================================
                                                                // Erasure actions
                                                                //
                                                                ===========================================================================

                                                                /**
                                                                * Tạo yêu cầu xóa dữ liệu mới.
                                                                *
                                                                * @param scope - Phạm vi xóa.
                                                                * @param reason - Lý do xóa.
                                                                */
                                                                async createErasureRequest(scope: ErasureScope, reason:
                                                                string): Promise<void> {
                                                                    this.isLoading.set(true);
                                                                    try {
                                                                    await firstValueFrom(
                                                                    this.consentService.createErasureRequest({ scope,
                                                                    reason })
                                                                    );
                                                                    await this.loadAllData();
                                                                    } catch (err: any) {
                                                                    this.error.set(err.message || 'Lỗi khi tạo yêu cầu
                                                                    xóa');
                                                                    } finally {
                                                                    this.isLoading.set(false);
                                                                    }
                                                                    }

                                                                    //
                                                                    ===========================================================================
                                                                    // Utility
                                                                    //
                                                                    ===========================================================================

                                                                    /**
                                                                    * Lấy nhãn hiển thị cho mục đích đồng ý.
                                                                    *
                                                                    * @param purpose - Mục đích đồng ý.
                                                                    * @returns Chuỗi nhãn hiển thị.
                                                                    */
                                                                    getPurposeLabel(purpose: ConsentPurpose): string {
                                                                    const labels: Record<ConsentPurpose, string> = {
                                                                        analytics: 'Phân tích',
                                                                        marketing: 'Tiếp thị',
                                                                        advertising: 'Quảng cáo',
                                                                        personalization: 'Cá nhân hóa',
                                                                        essential: 'Cốt lõi',
                                                                        communication: 'Liên lạc',
                                                                        };
                                                                        return labels[purpose] || purpose;
                                                                        }

                                                                        /**
                                                                        * Lấy màu trạng thái đồng ý.
                                                                        *
                                                                        * @param status - Trạng thái đồng ý.
                                                                        * @returns Chuỗi màu CSS.
                                                                        */
                                                                        getStatusColor(status: ConsentStatus): string {
                                                                        const colors: Record<ConsentStatus, string> = {
                                                                            active: '#22c55e',
                                                                            revoked: '#ef4444',
                                                                            expired: '#f59e0b',
                                                                            pending: '#6366f1',
                                                                            };
                                                                            return colors[status] || '#6b7280';
                                                                            }

                                                                            /**
                                                                            * Refresh toàn bộ dữ liệu.
                                                                            */
                                                                            async refresh(): Promise<void> {
                                                                                await this.loadAllData();
                                                                                }
                                                                                }
                                                                                {% endraw %}