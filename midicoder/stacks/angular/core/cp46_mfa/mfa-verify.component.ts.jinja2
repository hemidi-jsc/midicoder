import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MfaService } from './mfa.service';
import { MFAMethod } from './mfa-types';

@Component({
  selector: 'app-mfa-verify',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './mfa-verify.component.html',
})
export class MfaVerifyComponent implements OnInit {
  verifyForm!: FormGroup;
  sessionId: string | null = null;
  loading = false;
  error: string | null = null;
  remainingAttempts = 5;
  methods = MFAMethod;

  constructor(
    private fb: FormBuilder,
    private mfaService: MfaService,
  ) {}

  ngOnInit(): void {
    this.verifyForm = this.fb.group({
      method: [MFAMethod.TOTP, Validators.required],
      otpCode: ['', [Validators.required, Validators.minLength(6), Validators.maxLength(6)]],
    });
  }

  async createChallenge(): Promise<void> {
    this.loading = true;
    this.error = null;
    try {
      const method = this.verifyForm.get('method')?.value;
      const response = await this.mfaService.createChallenge('current-user', method);
      this.sessionId = response.sessionId;
      this.remainingAttempts = response.remainingAttempts;
    } catch (err: any) {
      this.error = err.message || 'Challenge creation failed';
    } finally {
      this.loading = false;
    }
  }

  async verify(): Promise<void> {
    if (!this.sessionId) return;
    this.loading = true;
    this.error = null;
    try {
      const otpCode = this.verifyForm.get('otpCode')?.value;
      await this.mfaService.verifyChallenge(this.sessionId, otpCode);
      console.log('MFA verified successfully');
    } catch (err: any) {
      this.error = err.message || 'Verification failed';
      this.remainingAttempts -= 1;
    } finally {
      this.loading = false;
    }
  }
}
