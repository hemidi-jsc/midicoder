import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MfaService } from './mfa.service';
import { MFACredential, MFAMethod } from './mfa-types';

@Component({
selector: 'app-mfa-methods',
standalone: true,
imports: [CommonModule],
templateUrl: './mfa-methods.component.html',
})
export class MfaMethodsComponent implements OnInit {
credentials: MFACredential[] = [];
loading = false;
error: string | null = null;
isMfaEnabled = false;
methods = MFAMethod;

constructor(private mfaService: MfaService) {}

ngOnInit(): void {
this.loadStatus();
}

async loadStatus(): Promise<void> {
    this.loading = true;
    try {
    const status = await this.mfaService.getStatus('current-user');
    this.isMfaEnabled = status.isMfaEnabled;
    this.credentials = status.methods || [];
    } catch (err: any) {
    this.error = err.message || 'Failed to load MFA status';
    } finally {
    this.loading = false;
    }
    }

    async disableCredential(credentialId: string): Promise<void> {
        try {
        await this.mfaService.disable(credentialId);
        await this.loadStatus();
        } catch (err: any) {
        this.error = err.message || 'Failed to disable credential';
        }
        }

        async revokeCredential(credentialId: string): Promise<void> {
            try {
            await this.mfaService.revoke(credentialId);
            await this.loadStatus();
            } catch (err: any) {
            this.error = err.message || 'Failed to revoke credential';
            }
            }
            }