    display: flex;
    gap: 8px;
    }

    .mc-column-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 8px 16px;
    }

    .mc-column-name {
    font-weight: 500;
    font-size: 0.9rem;
    }

