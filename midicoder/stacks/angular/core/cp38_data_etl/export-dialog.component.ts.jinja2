/**
* Export Dialog Component — CP38: Data Import/Export/ETL.
*{% raw %}
* UI Framework: {{{ ui_framework }}}{% endraw %}
*
* Component standalone hien thi dialog de cau hinh export du lieu:
* - Chon thuc the, dinh dang (CSV/JSON), cac cot can xuat
* - Bo loc tuy chon (khoang ngay, trang thai)
* - Nut Xem truoc, Nut Xuat
* - Thanh tien trinh trong khi export
*
* Su dung @angular/material/dialog, @angular/material/checkbox,
* @angular/material/select, @angular/material/date-picker.
*/

import {
Component,
OnInit,
Inject,
ChangeDetectorRef,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule, ReactiveFormsModule, FormBuilder, FormGroup, Validators } from '@angular/forms';

{% if ui_framework == "material" %}
import {
MatDialogRef,
MAT_DIALOG_DATA,
MatDialogModule,
} from '@angular/material/dialog';
import { MatButtonModule } from '@angular/material/button';
import { MatCheckboxModule } from '@angular/material/checkbox';
import { MatSelectModule } from '@angular/material/select';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
import { MatIconModule } from '@angular/material/icon';
import { MatDividerModule } from '@angular/material/divider';
import { MatCardModule } from '@angular/material/card';
import { MatChipsModule } from '@angular/material/chips';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { MatNativeDateModule } from '@angular/material/core';
import { MatTableModule } from '@angular/material/table';
import { MatPaginatorModule } from '@angular/material/paginator';
import { MatSnackBar, MatSnackBarModule } from '@angular/material/snack-bar';
{% elif ui_framework == "tailwind" %}
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
// Ant Design khong ung dung cho Angular
{% elif ui_framework == "carbon" %}
// Carbon khong ung dung cho Angular
{% endif %}

import { Subscription } from 'rxjs';
import { ExportService } from './export.service';
{% raw %}

// =========================================================================
// Giao diện dữ liệu
// =========================================================================

/**
* Dữ liệu đầu vào từ cha truyền vào dialog.
*/
interface ExportDialogInput {
/** Entity mặc định đã chọn (nếu có) */
defaultEntity?: string;
/** Chế độ chỉ xem trước */
previewOnly?: boolean;
}

/**
* Một cột có thể chọn để export.
*/
interface ExportableColumn {
name: string;
label: string;
type: string;
selected: boolean;
}

/**
* Định dạng export được hỗ trợ.
*/
interface ExportFormat {
value: string;
label: string;
mimeType: string;
extension: string;
}

/**
* Kết quả xem trước export.
*/
interface PreviewRow {
[key: string]: any;
}

/**
* Cấu hình export đã hoàn chỉnh.
*/
interface ExportConfig {
entity: string;
format: string;
columns: string[];
filters: ExportFilters;
}

/**
* Bộ lọc cho export.
*/
interface ExportFilters {
dateField?: string;
dateFrom?: Date | null;
dateTo?: Date | null;
statusField?: string;
statusValues?: string[];
}

/**
* Kết quả từ ExportService.
*/
interface ExportJobResult {
jobKey: string;
status: string;
message?: string;
}

// =========================================================================
// Định nghĩa dữ liệu cố định
// =========================================================================

/**
* Danh sách các định dạng export được hỗ trợ.
*/
const EXPORT_FORMATS: ExportFormat[] = [
{ value: 'csv', label: 'CSV', mimeType: 'text/csv', extension: '.csv' },
{ value: 'json', label: 'JSON', mimeType: 'application/json', extension: '.json' },
];

/**
* Định nghĩa các entity có thể export với cột tương ứng.
*/
const ENTITY_DEFINITIONS: Record<string, ExportableColumn[]> = {
    users: [
    { name: 'id', label: 'Mã người dùng', type: 'number', selected: true },
    { name: 'username', label: 'Tên đăng nhập', type: 'string', selected: true },
    { name: 'email', label: 'Email', type: 'string', selected: true },
    { name: 'full_name', label: 'Họ và tên', type: 'string', selected: true },
    { name: 'phone', label: 'Số điện thoại', type: 'string', selected: false },
    { name: 'role', label: 'Vai trò', type: 'string', selected: false },
    { name: 'created_at', label: 'Ngày tạo', type: 'date', selected: false },
    { name: 'status', label: 'Trạng thái', type: 'string', selected: false },
    ],
    products: [
    { name: 'id', label: 'Mã sản phẩm', type: 'number', selected: true },
    { name: 'sku', label: 'Mã SKU', type: 'string', selected: true },
    { name: 'name', label: 'Tên sản phẩm', type: 'string', selected: true },
    { name: 'price', label: 'Giá', type: 'number', selected: true },
    { name: 'category', label: 'Danh mục', type: 'string', selected: false },
    { name: 'stock', label: 'Số lượng kho', type: 'number', selected: false },
    { name: 'status', label: 'Trạng thái', type: 'string', selected: false },
    { name: 'created_at', label: 'Ngày tạo', type: 'date', selected: false },
    ],
    orders: [
    { name: 'id', label: 'Mã đơn hàng', type: 'number', selected: true },
    { name: 'order_id', label: 'Số đơn hàng', type: 'string', selected: true },
    { name: 'customer_name', label: 'Tên khách hàng', type: 'string', selected: true },
    { name: 'total_amount', label: 'Tổng tiền', type: 'number', selected: true },
    { name: 'status', label: 'Trạng thái', type: 'string', selected: false },
    { name: 'order_date', label: 'Ngày đặt hàng', type: 'date', selected: false },
    { name: 'shipping_address', label: 'Địa chỉ giao hàng', type: 'string', selected: false },
    { name: 'notes', label: 'Ghi chú', type: 'string', selected: false },
    ],
    };

    /**
    * Các giá trị trạng thái có thể lọc.
    */
    const STATUS_OPTIONS = [
    { value: 'active', label: 'Hoạt động' },
    { value: 'inactive', label: 'Không hoạt động' },
    { value: 'pending', label: 'Chờ xử lý' },
    { value: 'completed', label: 'Hoàn thành' },
    { value: 'cancelled', label: 'Đã hủy' },
    { value: 'failed', label: 'Thất bại' },
    ];

    // =========================================================================
    // Component
    // =========================================================================

    @Component({
    selector: 'mc-export-dialog',
    standalone: true,
    imports: [
    CommonModule,
    FormsModule,
    ReactiveFormsModule,
    {% if ui_framework == "material" %}
    MatDialogModule,
    MatButtonModule,
    MatCheckboxModule,
    MatSelectModule,
    MatFormFieldModule,
    MatInputModule,
    MatProgressBarModule,
    MatProgressSpinnerModule,
    MatIconModule,
    MatDividerModule,
    MatCardModule,
    MatChipsModule,
    MatDatepickerModule,
    MatNativeDateModule,
    MatTableModule,
    MatPaginatorModule,
    MatSnackBarModule,
    {% elif ui_framework == "antd" %}
    {% endif %}
    ],
    template: `
    <div class="mc-export-dialog">
        <!-- Tiêu đề dialog -->
        <h2 mat-dialog-title class="mc-dialog-title">
            <mat-icon>download</mat-icon>
            Xuất dữ liệu
        </h2>

        <mat-dialog-content class="mc-dialog-content">
            <!-- Form cấu hình export -->
            <form [formGroup]="exportForm" class="mc-export-form">

                <!-- =================================================================
               Chọn thực thể và định dạng
               ================================================================= -->
                <div class="mc-form-row">
                    <!-- Chọn entity -->
                    <mat-form-field class="mc-form-field" appearance="outline">
                        <mat-label>Chọn thực thể</mat-label>
                        <mat-select formControlName="entity" (selectionChange)="onEntityChanged()">
                            <mat-option *ngFor="let entity of availableEntities" [value]="entity.value">
                                {{ entity.label }}
                            </mat-option>
                        </mat-select>
                    </mat-form-field>

                    <!-- Chọn định dạng -->
                    <mat-form-field class="mc-form-field" appearance="outline">
                        <mat-label>Định dạng xuất</mat-label>
                        <mat-select formControlName="format">
                            <mat-option *ngFor="let fmt of exportFormats" [value]="fmt.value">
                                {{ fmt.label }} <small>({{ fmt.extension }})</small>
                            </mat-option>
                        </mat-select>
                    </mat-form-field>
                </div>

                <!-- =================================================================
               Chọn các cột cần xuất
               ================================================================= -->
                <div class="mc-section" *ngIf="exportColumns.length > 0">
                    <div class="mc-section-header">
                        <h4>Các cột cần xuất ({{ getSelectedColumnCount() }}/{{ exportColumns.length }})</h4>
                        <div class="mc-column-actions">
                            <button mat-stroked-button (click)="selectAllColumns()" type="button"
                                class="mc-select-all-btn">
                                Chọn tất cả
                            </button>
                            <button mat-stroked-button (click)="deselectAllColumns()" type="button"
                                class="mc-deselect-all-btn">
                                Bỏ chọn tất cả
                            </button>
                        </div>
                    </div>

                    <!-- Checkbox grid cho từng cột -->
                    <div class="mc-column-grid">
                        <mat-checkbox *ngFor="let col of exportColumns; let i = index" [formControlName]="'col_' + i"
                            (change)="onColumnToggle()">
                            <span class="mc-column-name">{{ col.label }}</span>
                            <span class="mc-column-type">({{ col.type }})</span>
                        </mat-checkbox>
                    </div>
                </div>

                <mat-divider class="mc-section-divider"></mat-divider>

                <!-- =================================================================
               Bộ lọc (tùy chọn)
               ================================================================= -->
                <div class="mc-section">
                    <h4>Bộ lọc (tùy chọn)</h4>

                    <!-- Lọc theo khoảng ngày -->
                    <div class="mc-form-row">
                        <mat-form-field class="mc-form-field" appearance="outline">
                            <mat-label>Từ ngày</mat-label>
                            <input matInput [matDatepicker]="fromPicker" formControlName="dateFrom"
                                (dateChange)="onFilterChanged()" />
                            <mat-datepicker #fromPicker></mat-datepicker>
                            <mat-icon matSuffix>calendar_today</mat-icon>
                        </mat-form-field>

                        <mat-form-field class="mc-form-field" appearance="outline">
                            <mat-label>Đến ngày</mat-label>
                            <input matInput [matDatepicker]="toPicker" formControlName="dateTo"
                                (dateChange)="onFilterChanged()" />
                            <mat-datepicker #toPicker></mat-datepicker>
                            <mat-icon matSuffix>calendar_today</mat-icon>
                        </mat-form-field>
                    </div>

                    <!-- Lọc theo trạng thái -->
                    <div class="mc-form-row">
                        <mat-form-field class="mc-full-width" appearance="outline">
                            <mat-label>Lọc theo trạng thái</mat-label>
                            <mat-select formControlName="statusFilter" multiple (selectionChange)="onFilterChanged()">
                                <mat-option *ngFor="let status of statusOptions" [value]="status.value">
                                    {{ status.label }}
                                </mat-option>
                            </mat-select>
                        </mat-form-field>
                    </div>
                </div>

                <mat-divider class="mc-section-divider"></mat-divider>

                <!-- =================================================================
               Thanh tiến trình export
               ================================================================= -->
                <div *ngIf="exporting" class="mc-export-progress">
                    <mat-progress-bar mode="indeterminate" color="primary"></mat-progress-bar>
                    <p class="mc-progress-text">
                        <mat-icon>hourglass_top</mat-icon>
                        Đang tạo file xuất... vui lòng chờ
                    </p>
                </div>

                <!-- =================================================================
               Bảng xem trước dữ liệu
               ================================================================= -->
                <div *ngIf="previewData.length > 0" class="mc-preview-section">
                    <div class="mc-section-header">
                        <h4>Xem trước ({{ previewData.length }} hàng đầu)</h4>
                    </div>

                    <div class="mc-preview-table-wrapper">
                        <table mat-table [dataSource]="previewData" class="mc-preview-table">
                            <!-- Cột động cho preview -->
                            <ng-container *ngFor="let col of previewColumns" [matColumnDef]="col">
                                <th mat-header-cell *matHeaderCellDef>
                                    {{ col }}
                                </th>
                                <td mat-cell *matCellDef="let row">
                                    {{ row[col] ?? '(null)' }}
                                </td>
                            </ng-container>

                            <tr mat-header-row *matHeaderRowDef="previewColumnNames"></tr>
                            <tr mat-row *matRowDef="let row; columns: previewColumnNames;"></tr>

                            <tr class="mat-row" *matNoDataRow>
                                <td class="mat-cell" [colSpan]="previewColumnNames.length">
                                    Không có dữ liệu xem trước
                                </td>
                            </tr>
                        </table>
                    </div>

                    <mat-paginator [pageSize]="5" [pageSizeOptions]="[5]" showFirstLastButtons>
                    </mat-paginator>
                </div>

                <!-- Hiển thị lỗi từ service -->
                <div *ngIf="errorMessage" class="mc-error-message">
                    <mat-icon color="warn">error</mat-icon>
                    <span>{{ errorMessage }}</span>
                </div>
            </form>
        </mat-dialog-content>

        <!-- =================================================================
           Footer — các nút hành động
           ================================================================= -->
        <mat-dialog-actions align="end" class="mc-dialog-actions">
            <button mat-button (click)="onClose()" [disabled]="exporting">
                Hủy
            </button>
            <button mat-stroked-button color="accent" (click)="loadPreview()"
                [disabled]="!canExport || exporting || !!previewData.length">
                <mat-icon>visibility</mat-icon>
                Xem trước
            </button>
            <button mat-raised-button color="primary" (click)="executeExport()" [disabled]="!canExport || exporting">
                <mat-icon>download</mat-icon>
                {{ exporting ? 'Đang xuất...' : 'Xuất dữ liệu' }}
            </button>
        </mat-dialog-actions>
    </div>
    `,
    styles: [
    `
    :host {
    display: block;
    }

    .mc-export-dialog {
    min-width: 640px;
    max-width: 900px;
    }

    .mc-dialog-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 1.25rem;
    color: #333;
    }

