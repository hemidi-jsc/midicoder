    max-height: 70vh;
    overflow-y: auto;
    padding: 16px 24px;
    }

    .mc-export-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    }

    /* ==========================================================================
    Hàng form
    ========================================================================== */
    .mc-form-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    }

