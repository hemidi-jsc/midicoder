    ],
    })
    export class ExportDialogComponent implements OnInit {
    // =========================================================================
    // Form Reactive
    // =========================================================================

    /** Form chứa tất cả cấu hình export */
    exportForm: FormGroup;

    // =========================================================================
    // Dữ liệu dialog
    // =========================================================================

    /** Dữ liệu đầu vào từ MatDialog.open() */
    inputData: ExportDialogInput;

    // =========================================================================
    // Danh sách tùy chọn
    // =========================================================================

    /** Các định dạng export */
    exportFormats: ExportFormat[] = EXPORT_FORMATS;

    /** Các entity có thể export */
    availableEntities: { value: string; label: string }[] = [
    { value: 'users', label: 'Người dùng' },
    { value: 'products', label: 'Sản phẩm' },
    { value: 'orders', label: 'Đơn hàng' },
    ];

    /** Các tùy chọn trạng thái để lọc */
    statusOptions = STATUS_OPTIONS;

    // =========================================================================
    // Trạng thái động
    // =========================================================================

    /** Các cột của entity đang chọn */
    exportColumns: ExportableColumn[] = [];

    /** Dữ liệu xem trước */
    previewData: PreviewRow[] = [];

    /** Danh sách tên cột trong preview */
    previewColumns: string[] = [];

    /** Tên cột để render trong bảng preview */
    previewColumnNames: string[] = [];

    /** Đang export chưa */
    exporting: boolean = false;

    /** Thông báo lỗi */
    errorMessage: string = '';

    /** Tổng số hàng ước lượng */
    estimatedRowCount: number = 0;

    // =========================================================================
    // Subscription
    // =========================================================================

    /** Collection subscriptions để hủy khi destroy */
    private subscriptions: Subscription = new Subscription();

    // =========================================================================
    // Context variables từ Jinja2
    // =========================================================================

    /** Các định dạng import/export được hỗ trợ */
    supportedFormats: Readonly<string[]> = {{ import_formats | tojson if import_formats else ['csv', 'json'] | tojson
        }};

        /** Các trạng thái job */
        jobStatuses: Readonly<string[]> = {{ job_statuses | tojson if job_statuses else ['pending', 'running',
            'completed', 'failed', 'cancelled'] | tojson }};

            /** Các loại transform */
            transformTypes: Readonly<string[]> = {{ transform_types | tojson if transform_types else [] | tojson }};

                /** Các nguồn extract */
                extractSources: Readonly<string[]> = {{ extract_sources | tojson if extract_sources else [] | tojson }};

                    /** Các chế độ load */
                    loadModes: Readonly<string[]> = {{ load_modes | tojson if load_modes else ['insert', 'update',
                        'upsert'] | tojson }};

                        // =========================================================================
                        // Lifecycle
                        // =========================================================================

                        constructor(
                        public dialogRef: MatDialogRef<ExportDialogComponent>,
                            @Inject(MAT_DIALOG_DATA) public data: ExportDialogInput | null,
                            private fb: FormBuilder,
                            private exportService: ExportService,
                            private snackBar: MatSnackBar,
                            private cdr: ChangeDetectorRef,
                            ) {
                            this.inputData = data || {};

                            // Khởi tạo form nhóm
                            this.exportForm = this.fb.group({
                            entity: ['', Validators.required],
                            format: ['csv', Validators.required],
                            dateFrom: [null],
                            dateTo: [null],
                            statusFilter: [[]],
                            });
                            }

                            /**
                            * OnInit — khởi tạo form và load dữ liệu ban đầu.
                            */
                            ngOnInit(): void {
                            // Đặt entity mặc định nếu có
                            if (this.inputData.defaultEntity && ENTITY_DEFINITIONS[this.inputData.defaultEntity]) {
                            this.exportForm.patchValue({ entity: this.inputData.defaultEntity });
                            this.onEntityChanged();
                            }
                            }

                            // =========================================================================
                            // Chọn entity
                            // =========================================================================

                            /**
                            * Xử lý khi thay đổi entity đã chọn.
                            *
                            * Tự động tải danh sách cột tương ứng và tạo form controls.
                            */
                            onEntityChanged(): void {
                            const entity = this.exportForm.get('entity')?.value;
                            this.errorMessage = '';
                            this.previewData = [];
                            this.previewColumns = [];
                            this.previewColumnNames = [];

                            if (!entity || !ENTITY_DEFINITIONS[entity]) {
                            this.exportColumns = [];
                            return;
                            }

                            // Sao chép cột để tránh mutate dữ liệu gốc
                            this.exportColumns = ENTITY_DEFINITIONS[entity].map((col) => ({ ...col }));

                            // Thêm form controls cho từng cột checkbox
                            this.exportColumns.forEach((col, i) => {
                            this.exportForm.addControl(`col_${i}`, this.fb.control(col.selected));
                            });
                            }

                            /**
                            * Xử lý khi toggle checkbox cột.
                            *
                            * Cập nhật trạng thái selected của cột.
                            */
                            onColumnToggle(): void {
                            this.exportColumns.forEach((col, i) => {
                            const ctrl = this.exportForm.get(`col_${i}`);
                            if (ctrl) {
                            col.selected = ctrl.value === true;
                            }
                            });
                            }

                            // =========================================================================
                            // Bộ lọc
                            // =========================================================================

                            /**
                            * Xử lý khi thay đổi bộ lọc.
                            *
                            * Hiện tại chỉ reset preview nếu đang hiển thị.
                            */
                            onFilterChanged(): void {
                            // Nếu có dữ liệu preview, đánh dấu cần tải lại
                            if (this.previewData.length > 0) {
                            this.previewData = [];
                            this.previewColumns = [];
                            this.previewColumnNames = [];
                            }
                            }

                            // =========================================================================
                            // Chọn cột
                            // =========================================================================

                            /**
                            * Chọn tất cả cột.
                            */
                            selectAllColumns(): void {
                            this.exportColumns.forEach((col, i) => {
                            col.selected = true;
                            const ctrl = this.exportForm.get(`col_${i}`);
                            if (ctrl) ctrl.setValue(true);
                            });
                            this.cdr.detectChanges();
                            }

                            /**
                            * Bỏ chọn tất cả cột.
                            */
                            deselectAllColumns(): void {
                            this.exportColumns.forEach((col, i) => {
                            col.selected = false;
                            const ctrl = this.exportForm.get(`col_${i}`);
                            if (ctrl) ctrl.setValue(false);
                            });
                            this.cdr.detectChanges();
                            }

                            /**
                            * Đếm số cột đang được chọn.
                            *
                            * @returns Số cột selected
                            */
                            getSelectedColumnCount(): number {
                            return this.exportColumns.filter((c) => c.selected).length;
                            }

                            // =========================================================================
                            // Điều kiện export
                            // =========================================================================

                            /**
                            * Kiểm tra có thể thực hiện export không.
                            *
                            * @returns true nếu form hợp lệ và có cột được chọn
                            */
                            get canExport(): boolean {
                            return (
                            this.exportForm.valid &&
                            this.getSelectedColumnCount() > 0
                            );
                            }

                            // =========================================================================
                            // Xem trước
                            // =========================================================================

                            /**
                            * Tải dữ liệu xem trước từ backend.
                            */
                            loadPreview(): void {
                            const config = this.buildExportConfig();
                            this.errorMessage = '';

                            const sub = this.exportService
                            .previewExport('preview', 10)
                            .subscribe({
                            next: (data: any) => {
                            const rows = Array.isArray(data) ? data : data.rows || [];
                            this.previewData = rows.slice(0, 10);

                            if (this.previewData.length > 0) {
                            this.previewColumns = Object.keys(this.previewData[0]);
                            // Chỉ lấy các cột đã chọn
                            const selectedColNames = this.getSelectedColumnNames();
                            this.previewColumnNames = this.previewColumns.filter((c) =>
                            selectedColNames.includes(c)
                            );
                            }

                            this.estimatedRowCount = data.totalCount || rows.length;
                            this.cdr.detectChanges();
                            },
                            error: (err: any) => {
                            this.errorMessage = `Không thể xem trước: ${err.message || err}`;
                            console.error('Lỗi xem trước export:', err);
                            },
                            });

                            this.subscriptions.add(sub);
                            }

                            // =========================================================================
                            // Thực hiện export
                            // =========================================================================

                            /**
                            * Tạo và gửi yêu cầu export đến backend.
                            */
                            executeExport(): void {
                            if (!this.canExport) return;

                            this.exporting = true;
                            this.errorMessage = '';

                            const config = this.buildExportConfig();

                            // Bước 1: Tạo export job
                            const createSub = this.exportService
                            .createExportJob(config)
                            .subscribe({
                            next: (jobResult: ExportJobResult) => {
                            // Bước 2: Polling trạng thái job
                            this.pollAndDownload(jobResult.jobKey);
                            },
                            error: (err: any) => {
                            this.exporting = false;
                            this.errorMessage = `Không thể tạo job export: ${err.message || err}`;
                            console.error('Lỗi tạo export job:', err);
                            },
                            });

                            this.subscriptions.add(createSub);
                            }

                            /**
                            * Polling trạng thái job và tải về file khi hoàn thành.
                            *
                            * @param jobKey — Khóa của export job
                            */
                            private pollAndDownload(jobKey: string): void {
                            const pollSub = this.exportService
                            .getExportStatus(jobKey)
                            .subscribe({
                            next: (status: any) => {
                            if (status.status === 'completed' || status.status === 'done') {
                            // Job hoàn thành — tải về file
                            this.exporting = false;
                            this.downloadFile(jobKey);
                            this.showSnackBar('Xuất dữ liệu thành công!', 'success');
                            this.dialogRef.close({ success: true, jobKey });
                            } else if (
                            status.status === 'failed' ||
                            status.status === 'error'
                            ) {
                            this.exporting = false;
                            this.errorMessage = `Export thất bại: ${status.message || 'Lỗi không xác định'}`;
                            this.showSnackBar('Xuất dữ liệu thất bại', 'error');
                            } else {
                            // Vẫn đang chạy — polling sau 2 giây
                            setTimeout(() => this.pollAndDownload(jobKey), 2000);
                            }
                            },
                            error: (err: any) => {
                            this.exporting = false;
                            this.errorMessage = `Không thể kiểm tra trạng thái: ${err.message || err}`;
                            },
                            });

                            this.subscriptions.add(pollSub);
                            }

                            /**
                            * Tải file export về máy.
                            *
                            * @param jobKey — Khóa export job
                            */
                            private downloadFile(jobKey: string): void {
                            const downloadSub = this.exportService
                            .downloadExport(jobKey)
                            .subscribe({
                            next: (blob: Blob) => {
                            // Tạo URL và kích hoạt tải về
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;

                            // Lấy phần mở rộng từ định dạng đã chọn
                            const format = this.exportForm.get('format')?.value || 'csv';
                            const fmtDef = this.exportFormats.find((f) => f.value === format);
                            const ext = fmtDef?.extension || '.csv';
                            const entity = this.exportForm.get('entity')?.value || 'data';

                            a.download = `${entity}_export${ext}`;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            window.URL.revokeObjectURL(url);
                            },
                            error: (err: any) => {
                            console.error('Lỗi tải file export:', err);
                            this.showSnackBar('Không thể tải file', 'error');
                            },
                            });

                            this.subscriptions.add(downloadSub);
                            }

                            // =========================================================================
                            // Xây dựng cấu hình export
                            // =========================================================================

                            /**
                            * Xây dựng đối tượng ExportConfig từ form.
                            *
                            * @returns ExportConfig hoàn chỉnh
                            */
                            private buildExportConfig(): ExportConfig {
                            const selectedColumns = this.getSelectedColumnNames();
                            const statusValues = this.exportForm.get('statusFilter')?.value || [];

                            return {
                            entity: this.exportForm.get('entity')?.value || '',
                            format: this.exportForm.get('format')?.value || 'csv',
                            columns: selectedColumns,
                            filters: {
                            dateFrom: this.exportForm.get('dateFrom')?.value || undefined,
                            dateTo: this.exportForm.get('dateTo')?.value || undefined,
                            statusValues: Array.isArray(statusValues) ? statusValues : [],
                            },
                            };
                            }

                            /**
                            * Lấy danh sách tên cột đã chọn.
                            *
                            * @returns Mảng tên cột
                            */
                            private getSelectedColumnNames(): string[] {
                            return this.exportColumns
                            .filter((c) => c.selected)
                            .map((c) => c.name);
                            }

                            // =========================================================================
                            // Đóng dialog
                            // =========================================================================

                            /**
                            * Đóng dialog mà không thực hiện export.
                            */
                            onClose(): void {
                            this.subscriptions.unsubscribe();
                            this.dialogRef.close({ success: false });
                            }

                            // =========================================================================
                            // Tiện ích hiển thị thông báo
                            // =========================================================================

                            /**
                            * Hiển thị thông báo snackbar.
                            *
                            * @param message — Nội dung thông báo
                            * @param type — Loại thông báo
                            */
                            private showSnackBar(message: string, type: 'success' | 'error'): void {
                            this.snackBar.open(message, 'Đóng', {
                            duration: type === 'success' ? 4000 : 6000,
                            horizontalPosition: 'center',
                            verticalPosition: 'bottom',
                            });
                            }
                            }