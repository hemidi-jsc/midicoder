    padding: 8px 0;
    }

    .mc-preview-table-wrapper {
    max-height: 240px;
    overflow: auto;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    }

    .mc-preview-table {
    width: 100%;
    font-size: 0.85rem;
    }

    /* ==========================================================================
