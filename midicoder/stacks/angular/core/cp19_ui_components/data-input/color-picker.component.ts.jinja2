/*
 * Midicoder CP19 - Data Input: ColorPicker
 * Standalone color picker component.
 */
import { Component, Input, forwardRef, OnInit } from '@angular/core';
import { ControlValueAccessor, NG_VALUE_ACCESSOR, ReactiveFormsModule, AbstractControl, FormControl } from '@angular/forms';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-color-picker',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  providers: [
    {
      provide: NG_VALUE_ACCESSOR,
      useExisting: forwardRef(() => ColorPickerComponent),
      multi: true,
    },
  ],
  template: `
{% if ui_framework == "material" %}
<div class="w-full">
  {% if label %}<div style="font-weight:500; margin-bottom:8px; color:#333;">{{ label }}{% if required %} <span style="color:#d32f2f;">*</span>{% endif %}</div>{% endif %}
  <div style="display:flex; align-items:center; gap:12px;">
    <div style="position:relative; width:48px; height:48px; border-radius:8px; overflow:hidden; border:2px solid #e0e0e0; cursor:pointer;"
         (click)="colorInput.click()">
      <input #colorInput type="color"
             [formControl]="control"
             [disabled]="disabled"
             style="opacity:0; width:100%; height:100%; cursor:pointer; position:absolute; top:0; left:0;" />
      <div style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"
           [style.background]="control?.value || '#000000'"></div>
    </div>
    <input type="text"
           [formControl]="hexControl"
           placeholder="#000000"
           maxlength="7"
           style="flex:1; padding:8px 12px; border:1px solid #e0e0e0; border-radius:4px; font-family:monospace; font-size:14px;" />
  </div>
  {% if hint %}<div style="margin-top:4px; font-size:12px; color:#757575;">{{ hint }}</div>{% endif %}
</div>

{% elif ui_framework == "tailwind" %}
<div class="w-full">
  {% if label %}
  <label class="block text-sm font-medium text-gray-700 mb-1">{{ label }}{% if required %} <span class="text-red-500">*</span>{% endif %}</label>
  {% endif %}
  <div class="flex items-center gap-3">
    <div class="relative w-12 h-12 rounded-lg overflow-hidden border-2 border-gray-200 cursor-pointer hover:border-gray-400 transition-colors"
         (click)="colorInput.click()">
      <input #colorInput type="color"
             [formControl]="control"
             [disabled]="disabled"
             class="opacity-0 w-full h-full cursor-pointer absolute top-0 left-0" />
      <div class="absolute inset-0 pointer-events-none" [style.background]="control?.value || '#000000'"></div>
    </div>
    <input type="text"
           [formControl]="hexControl"
           placeholder="#000000"
           maxlength="7"
           class="flex-1 px-3 py-2 border border-gray-300 rounded-md shadow-sm font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
  </div>
  {% if hint %}<p class="mt-1 text-sm text-gray-500">{{ hint }}</p>{% endif %}
</div>

{% elif ui_framework == "bootstrap" %}
<div class="w-100">
  {% if label %}<label class="form-label">{{ label }}{% if required %} <span class="text-danger">*</span>{% endif %}</label>{% endif %}
  <div class="d-flex align-items-center gap-3">
    <div class="position-relative" style="width:48px; height:48px; border-radius:0.5rem; overflow:hidden; border:2px solid #dee2e6; cursor:pointer;"
         (click)="colorInput.click()">
      <input #colorInput type="color"
             [formControl]="control"
             [disabled]="disabled"
             style="opacity:0; width:100%; height:100%; cursor:pointer; position:absolute; top:0; left:0;" />
      <div style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"
           [style.background]="control?.value || '#000000'"></div>
    </div>
    <input type="text"
           [formControl]="hexControl"
           placeholder="#000000"
           maxlength="7"
           class="form-control font-monospace" style="flex:1;" />
  </div>
  {% if hint %}<small class="form-text text-muted">{{ hint }}</small>{% endif %}
</div>

{% elif ui_framework == "antd" %}
<div style="width:100%; margin-bottom:16px;">
  {% if label %}<div style="font-size:14px; margin-bottom:4px; color:#262626;">{{ label }}{% if required %} <span style="color:#ff4d4f;">*</span>{% endif %}</div>{% endif %}
  <div style="display:flex; align-items:center; gap:12px;">
    <div style="width:48px; height:48px; border-radius:6px; overflow:hidden; border:1px solid #d9d9d9; cursor:pointer;"
         (click)="colorInput.click()">
      <input #colorInput type="color"
             [formControl]="control"
             [disabled]="disabled"
             style="opacity:0; width:100%; height:100%; cursor:pointer; position:absolute; top:0; left:0;" />
      <div style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"
           [style.background]="control?.value || '#000000'"></div>
    </div>
    <input type="text"
           [formControl]="hexControl"
           placeholder="#000000"
           maxlength="7"
           style="flex:1; padding:8px 11px; border:1px solid #d9d9d9; border-radius:6px; font-size:14px; font-family:monospace; outline:none;" />
  </div>
  {% if hint %}<div style="color:#8c8c8c; font-size:12px; margin-top:4px;">{{ hint }}</div>{% endif %}
</div>

{% elif ui_framework == "carbon" %}
<div style="width:100%; margin-bottom:1rem;">
  {% if label %}<div style="font-size:0.75rem; font-weight:400; color:#525252; margin-bottom:0.25rem;">{{ label }}{% if required %} <span style="color:#da1e28;">*</span>{% endif %}</div>{% endif %}
  <div style="display:flex; align-items:center; gap:0.75rem;">
    <div style="width:48px; height:48px; overflow:hidden; border:1px solid #8d8d8d; cursor:pointer;"
         (click)="colorInput.click()">
      <input #colorInput type="color"
             [formControl]="control"
             [disabled]="disabled"
             style="opacity:0; width:100%; height:100%; cursor:pointer; position:absolute; top:0; left:0;" />
      <div style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"
           [style.background]="control?.value || '#000000'"></div>
    </div>
    <input type="text"
           [formControl]="hexControl"
           placeholder="#000000"
           maxlength="7"
           style="flex:1; padding:10px 12px; border:none; border-bottom:1px solid #8d8d8d; font-size:0.875rem; font-family:monospace; outline:none; background:transparent;" />
  </div>
  {% if hint %}<p style="font-size:0.75rem; color:#6f6f6f; margin:0.25rem 0;">{{ hint }}</p>{% endif %}
</div>

{% endif %}
  `,
})
export class ColorPickerComponent implements ControlValueAccessor, OnInit {
  @Input() label = '';
  @Input() hint = '';
  @Input() required = false;
  @Input() disabled = false;

  protected control: AbstractControl | null = null;
  protected hexControl = new FormControl('#000000');

  ngOnInit(): void {
    this.hexControl?.valueChanges.subscribe((hex: string) => {
      if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
        this.control?.setValue(hex, { emitEvent: false });
      }
    });
    this.control?.valueChanges.subscribe((value: string) => {
      if (value && value !== this.hexControl?.value) {
        this.hexControl?.setValue(value, { emitEvent: false });
      }
    });
  }

  private _onChange: (value: any) => void = () => {};
  private _onTouched: () => void = () => {};

  writeValue(value: any): void {
    this.control?.setValue(value, { emitEvent: false });
    this.hexControl?.setValue(value, { emitEvent: false });
  }
  registerOnChange(fn: any): void { this._onChange = fn; }
  registerOnTouched(fn: any): void { this._onTouched = fn; }
  setDisabledState(isDisabled: boolean): void { this.disabled = isDisabled; }
}
