/*
 * Midicoder CP19 - Data Input: Input
 * Standalone text input component with validation support.
 */
import { Component, Input, forwardRef } from '@angular/core';
import { ControlValueAccessor, NG_VALUE_ACCESSOR, ReactiveFormsModule, Validators, AbstractControl } from '@angular/forms';
{% if ui_framework == "material" %}
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatIconModule } from '@angular/material/icon';
{% elif ui_framework == "bootstrap" %}
import { NgbModule } from '@ng-bootstrap/ng-bootstrap';
{% endif %}
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-input',
  standalone: true,
  imports: [
    CommonModule,
    ReactiveFormsModule,
{% if ui_framework == "material" %}
    MatFormFieldModule,
    MatInputModule,
    MatIconModule,
{% elif ui_framework == "bootstrap" %}
    NgbModule,
{% endif %}
  ],
  providers: [
    {
      provide: NG_VALUE_ACCESSOR,
      useExisting: forwardRef(() => InputComponent),
      multi: true,
    },
  ],
  template: `
{% if ui_framework == "material" %}
<mat-form-field appearance="outline" class="w-full" [color]="color">
  <mat-label>{{ label }}{% if required %} *{% endif %}</mat-label>
  <mat-icon *ngIf="prefixIcon" matPrefix>{{ prefixIcon }}</mat-icon>
  <input matInput
         [type]="showPassword ? 'text' : type"
         [placeholder]="placeholder"
         [disabled]="disabled"
         [readonly]="readonly"
         [formControl]="control" />
  <mat-icon *ngIf="suffixIcon" matSuffix>{{ suffixIcon }}</mat-icon>
  <mat-icon *ngIf="type === 'password'" matSuffix (click)="togglePassword()" style="cursor:pointer;">
    {{ showPassword ? 'visibility_off' : 'visibility' }}
  </mat-icon>
  <mat-hint *ngIf="hint">{{ hint }}</mat-hint>
  <mat-hint *ngIf="maxLength" align="end">{% raw %}{{ control?.value?.length || 0 }}{% endraw %}/{{ maxLength }}</mat-hint>
  <mat-error *ngIf="control?.hasError('required')">
    {% raw %}{{ requiredMessage || (label + ' is required') }}{% endraw %}
  </mat-error>
  <mat-error *ngIf="control?.hasError('email')">
    {% raw %}{{ errorMessage || 'Please enter a valid email address' }}{% endraw %}
  </mat-error>
  <mat-error *ngIf="control?.hasError('minlength')">
    Minimum {% raw %}{{ control?.errors?.['minlength']?.requiredLength }}{% endraw %} characters required
  </mat-error>
  <mat-error *ngIf="control?.hasError('maxlength')">
    Maximum {% raw %}{{ control?.errors?.['maxlength']?.requiredLength }}{% endraw %} characters allowed
  </mat-error>
  <mat-error *ngIf="control?.hasError('pattern')">
    {% raw %}{{ patternMessage || 'Invalid input format' }}{% endraw %}
  </mat-error>
</mat-form-field>

{% elif ui_framework == "tailwind" %}
<div class="w-full">
  {% if label %}
  <label class="block text-sm font-medium text-gray-700 mb-1" [attr.for]="inputId">
    {{ label }}
    <span *ngIf="required" class="text-red-500 ml-1">*</span>
  </label>
  {% endif %}
  <div class="relative">
    <span *ngIf="prefixIcon" class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" [attr.d]="prefixIcon"/>
      </svg>
    </span>
    <input [id]="inputId"
           [type]="showPassword ? 'text' : type"
           [placeholder]="placeholder"
           [disabled]="disabled"
           [readonly]="readonly"
           [formControl]="control"
           [class]="baseInputClasses + (control?.invalid && (control?.dirty || control?.touched) ? ' border-red-300 focus:ring-red-500 focus:border-red-500' : '')" />
    <button *ngIf="type === 'password'" type="button" (click)="togglePassword()"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
      <svg *ngIf="showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"/>
      </svg>
      <svg *ngIf="!showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
      </svg>
    </button>
    <span *ngIf="suffixIcon" class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" [attr.d]="suffixIcon"/>
      </svg>
    </span>
  </div>
  {% if hint %}<p class="mt-1 text-sm text-gray-500">{{ hint }}</p>{% endif %}
  {% if maxLength %}<p class="mt-1 text-xs text-gray-400 text-right">{% raw %}{{ control?.value?.length || 0 }}{% endraw %}/{{ maxLength }}</p>{% endif %}
  <p *ngIf="control?.invalid && (control?.dirty || control?.touched)" class="mt-1 text-sm text-red-600">
    <span *ngIf="control?.hasError('required')">{% raw %}{{ requiredMessage || (label + ' is required') }}{% endraw %}</span>
    <span *ngIf="control?.hasError('email')">{% raw %}{{ errorMessage || 'Please enter a valid email address' }}{% endraw %}</span>
    <span *ngIf="control?.hasError('minlength')">Minimum {% raw %}{{ control?.errors?.['minlength']?.requiredLength }}{% endraw %} characters required</span>
    <span *ngIf="control?.hasError('maxlength')">Maximum {% raw %}{{ control?.errors?.['maxlength']?.requiredLength }}{% endraw %} characters allowed</span>
    <span *ngIf="control?.hasError('pattern')">{% raw %}{{ patternMessage || 'Invalid input format' }}{% endraw %}</span>
  </p>
</div>

{% elif ui_framework == "bootstrap" %}
<div class="form-group w-100">
  {% if label %}
  <label [attr.for]="inputId" class="form-label">
    {{ label }}
    <span *ngIf="required" class="text-danger">*</span>
  </label>
  {% endif %}
  <div class="input-group">
    <span *ngIf="prefixIcon" class="input-group-text">
      <i class="material-icons">{{ prefixIcon }}</i>
    </span>
    <input [id]="inputId"
           [type]="showPassword ? 'text' : type"
           [placeholder]="placeholder"
           [disabled]="disabled"
           [readonly]="readonly"
           [formControl]="control"
           [ngClass]="{'is-invalid': control?.invalid && (control?.dirty || control?.touched)}"
           class="form-control" />
    <span *ngIf="suffixIcon" class="input-group-text">
      <i class="material-icons">{{ suffixIcon }}</i>
    </span>
    <button *ngIf="type === 'password'" type="button" (click)="togglePassword()"
            class="input-group-text">
      <i class="material-icons">{{ showPassword ? 'visibility_off' : 'visibility' }}</i>
    </button>
  </div>
  {% if hint %}<small class="form-text text-muted">{{ hint }}</small>{% endif %}
  {% if maxLength %}<small class="form-text text-muted float-end">{% raw %}{{ control?.value?.length || 0 }}{% endraw %}/{{ maxLength }}</small>{% endif %}
  <div *ngIf="control?.invalid && (control?.dirty || control?.touched)" class="invalid-feedback d-block">
    <span *ngIf="control?.hasError('required')">{% raw %}{{ requiredMessage || (label + ' is required') }}{% endraw %}</span>
    <span *ngIf="control?.hasError('email')">{% raw %}{{ errorMessage || 'Please enter a valid email address' }}{% endraw %}</span>
  </div>
</div>

{% elif ui_framework == "antd" %}
<div style="width:100%; margin-bottom:16px;">
  {% if label %}
  <label style="display:block; font-size:14px; margin-bottom:4px; color:#262626;">
    {{ label }}
    <span *ngIf="required" style="color:#ff4d4f; margin-left:4px;">*</span>
  </label>
  {% endif %}
  <div style="position:relative;">
    <span *ngIf="prefixIcon" style="position:absolute; left:11px; top:50%; transform:translateY(-50%); color:#bfbfbf; font-size:14px;">
      {{ prefixIcon }}
    </span>
    <input [type]="showPassword ? 'text' : type"
           [placeholder]="placeholder"
           [disabled]="disabled"
           [readonly]="readonly"
           [formControl]="control"
           [style.paddingLeft]="prefixIcon ? '28px' : '11px'"
           [style.paddingRight]="(suffixIcon || type === 'password') ? '28px' : '11px'"
           style="width:100%; padding:8px 11px; border:1px solid #d9d9d9; border-radius:6px; font-size:14px; outline:none; transition:border-color 0.3s;"
           [style.borderColor]="control?.invalid && (control?.dirty || control?.touched) ? '#ff4d4f' : '#d9d9d9'" />
    <button *ngIf="type === 'password'" type="button" (click)="togglePassword()"
            style="position:absolute; right:11px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#bfbfbf; font-size:14px;">
      {{ showPassword ? '🙈' : '👁' }}
    </button>
  </div>
  {% if hint %}<div style="color:#8c8c8c; font-size:12px; margin-top:4px;">{{ hint }}</div>{% endif %}
  <div *ngIf="control?.invalid && (control?.dirty || control?.touched)" style="color:#ff4d4f; font-size:12px; margin-top:4px;">
    <span *ngIf="control?.hasError('required')">{% raw %}{{ requiredMessage || (label + ' is required') }}{% endraw %}</span>
    <span *ngIf="control?.hasError('email')">{% raw %}{{ errorMessage || 'Please enter a valid email address' }}{% endraw %}</span>
  </div>
</div>

{% elif ui_framework == "carbon" %}
<div style="width:100%; margin-bottom:1rem;">
  {% if label %}
  <label [attr.for]="inputId" style="display:block; font-size:0.75rem; font-weight:400; color:#525252; margin-bottom:0.25rem;">
    {{ label }}
    <span *ngIf="required" style="color:#da1e28; margin-left:0.25rem;">*</span>
  </label>
  {% endif %}
  <input [id]="inputId"
         [type]="showPassword ? 'text' : type"
         [placeholder]="placeholder"
         [disabled]="disabled"
         [readonly]="readonly"
         [formControl]="control"
         style="width:100%; padding:10px 12px; border:none; border-bottom:1px solid #8d8d8d; font-size:0.875rem; outline:none; background:transparent; transition:border-color 0.15s;"
         [style.borderColor]="control?.invalid && (control?.dirty || control?.touched) ? '#da1e28' : '#8d8d8d'" />
  {% if hint %}<p style="font-size:0.75rem; color:#6f6f6f; margin:0.25rem 0;">{{ hint }}</p>{% endif %}
  <p *ngIf="control?.invalid && (control?.dirty || control?.touched)" style="font-size:0.75rem; color:#da1e28; margin:0.25rem 0;">
    <span *ngIf="control?.hasError('required')">{% raw %}{{ requiredMessage || (label + ' is required') }}{% endraw %}</span>
    <span *ngIf="control?.hasError('email')">{% raw %}{{ errorMessage || 'Please enter a valid email address' }}{% endraw %}</span>
  </p>
</div>

{% endif %}
  `,
  styles: [`
{% if ui_framework == "tailwind" %}
input.base-input {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm
         focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
         disabled:bg-gray-100 disabled:cursor-not-allowed;
}
{% endif %}
  `],
})
export class InputComponent implements ControlValueAccessor {
  @Input() label = '';
  @Input() placeholder = '';
  @Input() type: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' = 'text';
  @Input() hint = '';
  @Input() required = false;
  @Input() requiredMessage = '';
  @Input() errorMessage = '';
  @Input() patternMessage = '';
  @Input() disabled = false;
  @Input() readonly = false;
  @Input() maxLength: number | null = null;
  @Input() prefixIcon: string | null = null;
  @Input() suffixIcon: string | null = null;
  @Input() color = 'primary';
  @Input() inputId = `inp-${Math.random().toString(36).slice(2, 9)}`;

  protected control: AbstractControl | null = null;
  protected showPassword = false;

  get baseInputClasses(): string {
    const padding = [];
    if (this.prefixIcon) padding.push('pl-10');
    if (this.suffixIcon || this.type === 'password') padding.push('pr-10');
    return `w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100 ${padding.join(' ')}`;
  }

  private _onChange: (value: any) => void = () => {};
  private _onTouched: () => void = () => {};

  writeValue(value: any): void {
    this.control?.setValue(value, { emitEvent: false });
  }

  registerOnChange(fn: any): void { this._onChange = fn; }
  registerOnTouched(fn: any): void { this._onTouched = fn; }
  setDisabledState(isDisabled: boolean): void { this.disabled = isDisabled; }

  togglePassword(): void {
    this.showPassword = !this.showPassword;
  }
}
