  @Input() clickable: boolean = false;
  @Input() disabled: boolean = false;

  ngOnInit(): void {}

  onCardClick(): void {
    if (this.clickable && !this.disabled) {
      // emit click event
    }
  }
}
{% elif ui_framework == "tailwind" %}import { Component, OnInit, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: '{{ selector }}',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './{{ template_file_name }}.html',
  styleUrls: ['./{{ style_file_name }}.css']
})
export class {{ component_class_name }}Component implements OnInit {
  @Input() title: string = '';
  @Input() subtitle: string = '';
  @Input() description: string = '';
  @Input() imageUrl: string = '';
  @Input() imageAlt: string = '';
  @Input() actions: { label: string; icon?: string; action: () => void }[] = [];
  @Input() variant: 'default' | 'interactive' | 'plain' = 'default';
  @Input() horizontal: boolean = false;
  @Input() bordered: boolean = false;

  ngOnInit(): void {}

  get cardClasses(): string {
    const classes: string[] = ['rounded-lg'];
    if (this.variant === 'default') {
      classes.push('bg-white', 'shadow-md', 'hover:shadow-lg', 'transition-shadow');
    } else if (this.variant === 'interactive') {
      classes.push('bg-white', 'shadow-md', 'hover:shadow-lg', 'cursor-pointer', 'transition-all', 'hover:-translate-y-0.5');
    } else {
      classes.push('bg-transparent', 'shadow-none');
    }
    if (this.bordered) {
      classes.push('border', 'border-gray-200');
    }
    return classes.join(' ');
  }
}
