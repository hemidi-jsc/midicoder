{% if ui_framework == "material" %}import { Component, OnInit, Input } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatListModule } from '@angular/material/list';
import { MatIconModule } from '@angular/material/icon';
import { MatDividerModule } from '@angular/material/divider';
import { MatButtonModule } from '@angular/material/button';

@Component({
  selector: '{{ selector }}',
  standalone: true,
  imports: [
    CommonModule,
    MatListModule,
    MatIconModule,
    MatDividerModule,
    MatButtonModule
  ],
  templateUrl: './{{ template_file_name }}.html',
  styleUrls: ['./{{ style_file_name }}.css']
})
export class {{ component_class_name }}Component implements OnInit {
  @Input() items: {{ data_interface_name }}[] = [];
  @Input() type: 'simple' | 'one-line' | 'two-line' | 'three-line' = 'two-line';
  @Input() withAvatar: boolean = false;
  @Input() withActions: boolean = false;
  @Input() clickable: boolean = false;
  @Input() selected: number | null = null;

  ngOnInit(): void {}

  isSelected(index: number): boolean {
    return this.selected === index;
  }
}
