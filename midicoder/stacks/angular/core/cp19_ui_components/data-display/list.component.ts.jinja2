{% elif ui_framework == "carbon" %}import { Component, OnInit, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: '{{ selector }}',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './{{ template_file_name }}.html',
  styleUrls: ['./{{ style_file_name }}.css']
})
export class {{ component_class_name }}Component implements OnInit {
  @Input() items: {{ data_interface_name }}[] = [];
  @Input() selection: 'single' | 'multi' = 'single';
  @Input() selectedItems: number[] = [];
  @Input() size: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' = 'md';
  @Input() divider: boolean = true;

  ngOnInit(): void {}

  isItemSelected(index: number): boolean {
    return this.selectedItems.includes(index);
  }
}
