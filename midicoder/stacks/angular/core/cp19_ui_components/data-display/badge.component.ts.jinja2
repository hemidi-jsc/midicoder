{% elif ui_framework == "carbon" %}import { Component, OnInit, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: '{{ selector }}',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './{{ template_file_name }}.html',
  styleUrls: ['./{{ style_file_name }}.css']
})
export class {{ component_class_name }}Component implements OnInit {
  @Input() value: string | number = '';
  @Input() type: 'red' | 'magenta' | 'purple' | 'blue' | 'cyan' | 'teal' | 'green' | 'gray' | 'cool-gray' | 'warm-gray' = 'cool-gray';
  @Input() size: 'sm' | 'md' | 'lg' = 'sm';

  ngOnInit(): void {}

  get typeColor(): string {
    const colors: { [key: string]: string } = {
      red: 'bg-[#da1e28] text-white',
      magenta: 'bg-[#a2189e] text-white',
      purple: 'bg-[#6929c4] text-white',
      blue: 'bg-[#0f62fe] text-white',
      cyan: 'bg-[#0070b8] text-white',
      teal: 'bg-[#005396] text-white',
      green: 'bg-[#198038] text-white',
      gray: 'bg-[#8d8d8d] text-white',
      'cool-gray': 'bg-[#6b6e72] text-white',
      'warm-gray': 'bg-[#707070] text-white'
    };
    return colors[this.type] || colors['cool-gray'];
  }

  get sizeClass(): string {
    switch (this.size) {
      case 'sm': return 'text-xs px-2 py-0.5';
      case 'lg': return 'text-sm px-3 py-1';
      default: return 'text-xs px-2 py-0.5';
    }
  }
}
