/** Card List Component - Card grid layout. */

import { Component, Input, Output, EventEmitter, OnInit } from "@angular/core";
import { CommonModule } from "@angular/common";

export interface CardItem {
id: string;
title: string;
subtitle?: string;
description?: string;
avatar?: string;
actions?: CardAction[];
[key: string]: any;
}

export interface CardAction {
label: string;
icon?: string;
action: string;
}

@Component({
selector: 'app-card-list',
standalone: true,
imports: [CommonModule],
template: `
{% if ui_framework == "material" %}
<div class="card-grid" [style]="gridStyle">
    <mat-card *ngFor="let item of items" class="card-item" (click)="cardClick.emit(item)">
        <mat-card-header>
            <mat-card-title>{% raw %}{{ item.title }}{% endraw %}</mat-card-title>
            <mat-card-subtitle *ngIf="item.subtitle">{% raw %}{{ item.subtitle }}{% endraw %}</mat-card-subtitle>
        </mat-card-header>
        <mat-card-content>
            <p *ngIf="item.description">{% raw %}{{ item.description }}{% endraw %}</p>
        </mat-card-content>
        <mat-card-actions *ngIf="item.actions">
            <button *ngFor="let action of item.actions" mat-button
                (click)="$event.stopPropagation(); cardAction.emit({item, action})">
                {% raw %}{{ action.label }}{% endraw %}
            </button>
        </mat-card-actions>
    </mat-card>
</div>
{% elif ui_framework == "tailwind" %}
<div class="grid gap-6" [style]="gridStyle">
    <div *ngFor="let item of items"
        class="bg-white rounded-lg shadow-md p-6 cursor-pointer hover:shadow-lg transition-shadow"
        (click)="cardClick.emit(item)">
        <h3 class="text-lg font-semibold text-gray-900">{% raw %}{{ item.title }}{% endraw %}</h3>
        <p *ngIf="item.subtitle" class="text-sm text-gray-500 mt-1">{% raw %}{{ item.subtitle }}{% endraw %}</p>
        <p *ngIf="item.description" class="text-gray-700 mt-2">{% raw %}{{ item.description }}{% endraw %}</p>
        <div *ngIf="item.actions" class="mt-4 flex gap-2">
            <button *ngFor="let action of item.actions"
                (click)="$event.stopPropagation(); cardAction.emit({item, action})"
                class="px-3 py-1 text-sm bg-blue-500 text-white rounded hover:bg-blue-600">
                {% raw %}{{ action.label }}{% endraw %}
            </button>
        </div>
    </div>
</div>
{% else %}
<div class="card-grid" [style]="gridStyle">
    <div *ngFor="let item of items" class="card" (click)="cardClick.emit(item)">
        <h3>{% raw %}{{ item.title }}{% endraw %}</h3>
        <p *ngIf="item.subtitle">{% raw %}{{ item.subtitle }}{% endraw %}</p>
        <p *ngIf="item.description">{% raw %}{{ item.description }}{% endraw %}</p>
    </div>
</div>
{% endif %}
`,
})
export class CardListComponent implements OnInit {
@Input() items: CardItem[] = [];
@Input() gridCols: number = 3;
@Output() cardClick = new EventEmitter<CardItem>();
    @Output() cardAction = new EventEmitter<{ item: CardItem; action: CardAction }>();

        gridStyle: string = '';

        ngOnInit() {
        {% if ui_framework == "tailwind" %}
        this.gridStyle = `grid-template-columns: repeat(${this.gridCols}, 1fr)`;
        {% else %}
        this.gridStyle = `display: grid; grid-template-columns: repeat(${this.gridCols}, 1fr); gap: 1rem;`;
        {% endif %}
        }
        }