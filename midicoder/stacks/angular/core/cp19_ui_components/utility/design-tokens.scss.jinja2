{% if ui_framework == "material" %}
/**
 * Material Design Tokens
 *
 * Generated by midicoder — do not edit manually.
 */

@import '~@angular/material/prebuilt-themes/indigo-pink.css';

:root {
  /* ===== Colors ===== */
  --md-primary:        #3f51b5;
  --md-primary-variant:#303f9f;
  --md-secondary:       #b0bec5;
  --md-secondary-variant:#78909c;
  --md-tertiary:        #7e57c2;
  --md-surface:         #ffffff;
  --md-background:      #f5f5f5;
  --md-error:           #f44336;
  --md-warn:            #ff9800;
  --md-info:            #2196f3;
  --md-success:         #4caf50;

  /* ===== Typography ===== */
  --md-font-family:     Roboto, 'Helvetica Neue', sans-serif;
  --md-font-size-xs:    0.75rem;
  --md-font-size-sm:    0.875rem;
  --md-font-size-base:  1rem;
  --md-font-size-lg:    1.125rem;
  --md-font-size-xl:    1.25rem;
  --md-font-size-2xl:   1.5rem;
  --md-font-size-3xl:   1.875rem;
  --md-line-height-tight:   1.25;
  --md-line-height-normal:  1.5;
  --md-line-height-relaxed: 1.75;

  /* ===== Spacing ===== */
  --md-spacing-xs:   4px;
  --md-spacing-sm:   8px;
  --md-spacing-md:   16px;
  --md-spacing-lg:   24px;
  --md-spacing-xl:   32px;
  --md-spacing-2xl:  48px;

  /* ===== Border Radius ===== */
  --md-radius-none:  0;
  --md-radius-sm:    4px;
  --md-radius-md:    8px;
  --md-radius-lg:    12px;
  --md-radius-xl:    16px;
  --md-radius-full:  9999px;

  /* ===== Elevation ===== */
  --md-elevation-0:  none;
  --md-elevation-1:  0 2px 1px -1px rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.14), 0 1px 3px 0 rgba(0,0,0,0.12);
  --md-elevation-2:  0 3px 1px -2px rgba(0,0,0,0.2), 0 2px 2px 0 rgba(0,0,0,0.14), 0 1px 5px 0 rgba(0,0,0,0.12);
  --md-elevation-3:  0 3px 3px -2px rgba(0,0,0,0.3), 0 3px 4px 0 rgba(0,0,0,0.14), 0 1px 8px 0 rgba(0,0,0,0.12);
  --md-elevation-4:  0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12);
  --md-elevation-5:  0 3px 5px -1px rgba(0,0,0,0.2), 0 5px 8px 0 rgba(0,0,0,0.14), 0 1px 14px 0 rgba(0,0,0,0.12);

  /* ===== Z-Index ===== */
  --md-z-dropdown:   1000;
  --md-z-overlay:    1100;
  --md-z-modal:      1200;
  --md-z-snackbar:   1300;
  --md-z-tooltip:    1400;

  /* ===== Transition ===== */
  --md-transition-duration: 200ms;
  --md-transition-timing:   cubic-bezier(0.4, 0, 0.2, 1);
}

