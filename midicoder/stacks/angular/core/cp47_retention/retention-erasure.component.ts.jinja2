                export class RetentionErasureComponent implements OnInit {
                // ── Inject ──
                private readonly store = inject(RetentionStore);
                private readonly dialog = inject(MatDialog);
                private readonly snackBar = inject(MatSnackBar);

                // ── Signals ──
                readonly searchQuery = signal<string>('');
                    private readonly debounceTimer = signal<ReturnType<typeof setTimeout> | null>(null);

                        // ── Computed từ store ──
                        readonly erasureRequests = this.store.erasureRequests;
                        readonly erasureLoading = this.store.erasureLoading;
                        readonly erasurePagination = this.store.erasurePagination;
                        readonly selectedRequest = this.store.selectedErasureRequest;

                        // ── Computed local ──
                        /** Số yêu cầu đang chờ xử lý */
                        readonly pendingCount = computed(() => {
                        return this.erasureRequests().filter(
                        (r) => r.status === 'pending' || r.status === 'processing'
                        ).length;
                        });

                        // ── Dữ liệu tĩnh ──
                        readonly displayedColumns: string[] = [
                        'subjectName', 'subjectEmail', 'status', 'progressPercent',
                        'dataTypes', 'createdAt', 'completedAt', 'actions',
                        ];

                        readonly statusOptions = computed(() =>
                        Object.entries(ERASURE_STATUS_LABELS).map(([value, label]) => ({
                        value: value as ErasureRequestStatus,
                        label,
                        }))
                        );

                        readonly statusLabels = computed(() => ERASURE_STATUS_LABELS);
                        readonly statusColorMap = computed(() => ERASURE_STATUS_COLORS);
                        readonly dataTypeLabels = computed(() => DATA_TYPE_LABELS);

                        // ── Lifecycle ──
                        ngOnInit(): void {
                        this.store.loadErasureRequests();

                        // Effect: cảnh báo lỗi
                        effect(() => {
                        const err = this.store.erasureError();
                        if (err) {
                        this.showWarning(`Lỗi: ${err.message}`);
                        }
                        });
                        }

                        // ── Event handlers ──

                        handleCreateErasure(): void {
                        this.dialog.open(ErasureFormDialogComponent, {
                        width: '640px',
                        maxWidth: '95vw',
                        disableClose: false,
                        });
                        }

                        handleSelectRequest(req: ErasureRequest): void {
                        this.store.selectErasureRequest(req.id);
                        }

                        handleDeselect(): void {
                        this.store.selectErasureRequest('');
                        }

                        handleApprove(req: ErasureRequest): void {
                        const confirmed = window.confirm(
                        `Phê duyệt yêu cầu xóa của "${req.subjectName}"?\n\n` +
                        `Hành động này sẽ bắt đầu xóa ${req.totalRecords} bản ghi.\n` +
                        `Dữ liệu sẽ bị xóa vĩnh viễn và không thể khôi phục.`
                        );
                        if (confirmed) {
                        this.store.approveErasure(req.id);
                        this.showSuccess('Đã phê duyệt yêu cầu xóa');
                        }
                        }

                        handleDeny(req: ErasureRequest): void {
                        this.dialog.open(ErasureDenyDialogComponent, {
                        width: '480px',
                        data: { requestId: req.id },
                        });
                        }

                        // ── Filter handlers ──

                        onSearch(event: Event): void {
                        const target = event.target as HTMLInputElement;
                        const value = target.value;
                        this.searchQuery.set(value);

                        if (this.debounceTimer()) {
                        clearTimeout(this.debounceTimer());
                        }
                        this.debounceTimer.set(
                        setTimeout(() => {
                        this.store.setErasureFilters({ search: value, page: 1 });
                        }, 300)
                        );
                        }

                        onStatusFilter(status: ErasureRequestStatus | 'all'): void {
                        this.store.setErasureFilters({ status, page: 1 });
                        }

                        onPageChange(event: PageEvent): void {
                        this.store.setErasureFilters({
                        page: event.pageIndex + 1,
                        pageSize: event.pageSize,
                        });
                        }

                        // ── Helpers ──

                        formatShortDate(iso: string | null): string {
                        return formatShortDate(iso);
                        }

                        /**
                        * Xác định màu progress bar theo trạng thái.
                        */
                        getProgressColor(status: ErasureRequestStatus): 'primary' | 'accent' | 'warn' {
                        switch (status) {
                        case 'completed': return 'accent';
                        case 'denied': return 'warn';
                        case 'expired': return 'warn';
                        default: return 'primary';
                        }
                        }

                        /**
                        * Xác định CSS class cho step trong progress stepper.
                        */
                        getStepClass(req: ErasureRequest, stepStatus: string): string {
                        const statusOrder = [
                        'pending',
                        'processing',
                        'verified',
                        'erasing',
                        'completed',
                        ];

                        const currentIndex = statusOrder.indexOf(req.status);
                        const stepIndex = statusOrder.indexOf(stepStatus);

                        if (req.status === 'denied' || req.status === 'expired') {
                        // Nếu bị từ chối/hết hạn: các step trước là done, step hiện tại là current
                        if (stepIndex <= 0) return 'done' ; return 'pending' ; } if (stepIndex < currentIndex)
                            return 'done' ; if (stepIndex===currentIndex) return 'current' ; return 'pending' ; } // ──
                            Snackbar ── private showSuccess(msg: string): void { this.snackBar.open(msg, 'Đóng' , {
                            duration: 3000, horizontalPosition: 'end' , verticalPosition: 'bottom' , }); } private
                            showWarning(msg: string): void { this.snackBar.open(msg, 'Đóng' , { duration: 5000,
                            panelClass: ['cp47-snackbar-warn'], horizontalPosition: 'end' , verticalPosition: 'bottom' ,
                            }); } } {% endraw %}