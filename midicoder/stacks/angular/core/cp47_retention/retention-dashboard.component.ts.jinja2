                </mat-card-title>
            </mat-card-header>
            <mat-card-content>
                @for (policy of s.expiringPolicies; track policy.id) {
                <div class="expiring-policy-item">
                    <div>
                        <strong>{{ policy.name }}</strong>
                        <div style="font-size:12px;color:#757575">
                            Hết hạn: {{ policy.expirationDate | date:'dd/MM/yyyy' }}
                        </div>
                    </div>
                    <span class="days-badge" [class]="getDaysBadgeClass(policy.daysRemaining)">
                        {{ policy.daysRemaining }} ngày
