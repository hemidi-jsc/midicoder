                        <th mat-header-cell *matHeaderCellDef>Dung lượng</th>
                        <td mat-cell *matCellDef="let record">
                            {{ formatSizeMB(record.sizeMB) }}
                        </td>
                    </ng-container>

                    <!-- Số bản ghi -->
                    <ng-container matColumnDef="recordCount">
                        <th mat-header-cell *matHeaderCellDef>Bản ghi</th>
                        <td mat-cell *matCellDef="let record">
                            {{ record.recordCount | number }}
                        </td>
                    </ng-container>

                    <!-- Ngày lưu -->
                    <ng-container matColumnDef="archivedAt">
                        <th mat-header-cell *matHeaderCellDef>Ngày lưu</th>
                        <td mat-cell *matCellDef="let record">
                            {{ formatShortDate(record.archivedAt) }}
                        </td>
                    </ng-container>

                    <!-- Định dạng -->
                    <ng-container matColumnDef="format">
                        <th mat-header-cell *matHeaderCellDef>Định dạng</th>
                        <td mat-cell *matCellDef="let record">
                            <code style="background:#eee;padding:2px 6px;border-radius:4px">
                      {{ record.format }}
                    </code>
                        </td>
                    </ng-container>

                    <!-- Kiểm tra -->
                    <ng-container matColumnDef="integrity">
                        <th mat-header-cell *matHeaderCellDef>Kiểm tra</th>
                        <td mat-cell *matCellDef="let record">
                            @if (record.integrity === 'ready') {
                            <mat-chip chosen avatar=<mat-icon style="color:#4caf50">check_circle</mat-icon>
                                >
                                OK
                            </mat-chip>
