                        <div class="stat-value">
                            @if (card.valueKey === 'compliancePercentage') {
                            {{ currentStats[card.valueKey] | percent:'1.0-0' }}
                            } @else if (card.valueKey === 'totalArchivedMB') {
                            {{ formatStatValue(currentStats[card.valueKey]) }}
                            } @else {
                            {{ currentStats[card.valueKey] | number }}
                            }
                        </div>
                        @if (card.trend) {
                        <div class="stat-trend" [class]="card.trend.direction">
                            @if (card.trend.direction === 'up') {
                            <mat-icon
                                style="font-size:14px;width:14px;height:14px;vertical-align:middle">trending_up</mat-icon>
                            +{{ card.trend.value }}% ({{ card.trend.period }})
                            } @else {
                            <mat-icon
                                style="font-size:14px;width:14px;height:14px;vertical-align:middle">trending_down</mat-icon>
                            -{{ card.trend.value }}% ({{ card.trend.period }})
                            }
