            </mat-card-content>
        </mat-card>
        }
        }
    </div>
</div>

<!-- ── Footer ── -->
@if (statsLastUpdated()) {
<div class="dashboard-footer">
    Cập nhật cuối: {{ statsLastUpdated() | date:'HH:mm:ss dd/MM/yyyy' }}
    &middot; Tự động làm mới mỗi 60 giây
</div>
}
`,
})
export class RetentionDashboardComponent implements OnInit, OnDestroy {
// ── Dependency injection ──
private readonly store = inject(RetentionStore);
private readonly snackBar = inject(MatSnackBar);

// ── Timer ID cho tự động làm mới ──
private refreshTimerId: ReturnType<typeof setInterval> | null = null;

    // ── Signal trạng thái ──
    /** Đang làm mới thủ công */
    readonly refreshing = signal<boolean>(false);

        // ── Computed từ store ──
        readonly stats = this.store.stats;
        readonly statsLoading = this.store.statsLoading;
        readonly statsLastUpdated = this.store.statsLastUpdated;
        readonly archives = this.store.archives;
        readonly archivesLoading = this.store.archivesLoading;

        // ── Cấu hình tĩnh ──
        /** Các card thống kê hiển thị */
        readonly statCards = signal<StatCardConfig[]>(STAT_CARDS);

            /** Các hành động nhanh */
            readonly quickActions = signal<QuickActionConfig[]>(QUICK_ACTIONS);

                /** Cột hiển thị trong bảng */
                readonly displayedColumns: string[] = [
                'name',
                'dataType',
                'sizeMB',
                'recordCount',
                'archivedAt',
                'format',
                'integrity',
                'actions',
                ];

                /** Mapping label loại dữ liệu */
                readonly dataTypeLabels = computed(() => DATA_TYPE_LABELS);

                // ── Lifecycle ──

                ngOnInit(): void {
                // Tải dữ liệu ban đầu
                this.store.initialize();

                // Thiết lập tự động làm mới
                this.setupAutoRefresh();

                // Effect: hiển thị snackbar khi có lỗi từ store
                effect(() => {
                const error = this.store.statsError();
                if (error) {
                this.showError(`Lỗi tải thống kê: ${error.message}`);
                }
                });

                // Effect: log khi archives thay đổi
                effect(() => {
                const count = this.archives().length;
                if (count > 0) {
                console.log(`[CP47 Dashboard] Đã tải ${count} bản ghi lưu trữ`);
                }
                });
                }

                ngOnDestroy(): void {
                this.stopAutoRefresh();
                }

                // ── Auto-refresh ──

                /**
                * Thiết lập bộ đếm tự động làm mới mỗi 60s.
                * Dùng setInterval để đồng bộ với chu kỳ server.
                */
                private setupAutoRefresh(): void {
                this.refreshTimerId = setInterval(() => {
                console.log('[CP47 Dashboard] Tự động làm mới thống kê...');
                this.store.refreshStats();
                this.store.loadArchives();
                }, DASHBOARD_REFRESH_INTERVAL);
                }

                /** Dừng bộ đếm tự động làm mới */
                private stopAutoRefresh(): void {
                if (this.refreshTimerId !== null) {
                clearInterval(this.refreshTimerId);
                this.refreshTimerId = null;
                }
                }

                // ── Event handlers ──

                /**
                * Xử lý làm mới thủ công bằng nút refresh.
                * Hiển thị trạng thái loading trong khi tải.
                */
                handleRefresh(): void {
                this.refreshing.set(true);

                // Reload tất cả dữ liệu
                Promise.all([
                this.reloadAndAwait('stats'),
                this.reloadAndAwait('archives'),
                ]).finally(() => {
                this.refreshing.set(false);
                this.showSuccess('Đã làm mới dữ liệu');
                });
                }

                /**
                * Helper: reload và trả về Promise resolve khi xong.
                * Dùng Promise wrapper để await nhiều thao tác cùng lúc.
                */
                private reloadAndAwait(
                type: 'stats' | 'archives'
                ): Promise<void> {
                    return new Promise((resolve) => {
                    if (type === 'stats') {
                    this.store.refreshStats();
                    // Stats load nhanh — delay nhỏ để UI cập nhật
                    setTimeout(resolve, 500);
                    } else {
                    this.store.loadArchives();
                    setTimeout(resolve, 500);
                    }
                    });
                    }

                    /**
                    * Xử lý hành động nhanh được click.
                    * Mỗi loại hành động sẽ điều hướng hoặc mở dialog tương ứng.
                    */
                    handleQuickAction(action: QuickActionConfig): void {
                    if (action.disabled) return;

                    switch (action.type) {
                    case QuickActionType.CreatePolicy:
                    this.store.openCreatePolicyDialog();
                    break;

                    case QuickActionType.BulkArchive:
                    this.showInfo('Chức năng lưu trữ hàng loạt — đang phát triển');
                    break;

                    case QuickActionType.SubmitErasure:
                    this.store.openErasureForm();
                    break;

                    case QuickActionType.ExportCompliance:
                    this.handleExportCompliance();
                    break;

                    case QuickActionType.RefreshCounts:
                    this.handleRefresh();
                    break;

                    case QuickActionType.AuditLog:
                    this.showInfo('Mở nhật ký thính giác — đang phát triển');
                    break;
                    }
                    }

                    /**
                    * Xử lý xuất báo cáo tuân thủ.
                    * Tải file PDF về máy người dùng.
                    */
                    handleExportCompliance(): void {
                    const endDate = new Date();
                    const startDate = new Date();
                    startDate.setMonth(startDate.getMonth() - 1);

                    // Gọi API export thông qua service
                    // Lưu ý: service.exportComplianceReport() trả về Blob
