min-width: 0;
}

.stat-info .stat-title {
font-size: 12px;
color: #757575;
text-transform: uppercase;
letter-spacing: 0.5px;
}

.stat-info .stat-value {
font-size: 28px;
font-weight: 600;
color: #212121;
line-height: 1.2;
}

.stat-info .stat-trend {
font-size: 11px;
margin-top: 2px;
}

.stat-trend.up { color: #4caf50; }
.stat-trend.down { color: #f44336; }

/* ── Main content: 2 cột ── */
.main-content {
display: grid;
grid-template-columns: 1fr 340px;
gap: 24px;
align-items: start;
}

@media (max-width: 1100px) {
.main-content {
grid-template-columns: 1fr;
}
}

/* ── Bảng ── */
.table-card {
overflow: hidden;
}

.table-card mat-card-header {
display: flex;
justify-content: space-between;
align-items: center;
}

table {
width: 100%;
}

.row-clickable {
