                        }
                    </div>
                </div>
            </mat-card>
        </mat-grid-tile>
        }
    </mat-grid-list>
</div>
} @else if (statsLoading()) {
<div class="loading-overlay">
    <mat-progress-spinner diameter="40" mode="indeterminate" color="primary" />
    <p style="margin-top:16px;color:#757575">Đang tải thống kê...</p>
</div>
}

<!-- ── Nội dung chính: 2 cột ── -->
<div class="main-content">

    <!-- Cột trái: Bảng lưu trữ gần đây -->
    <mat-card class="table-card">
        <mat-card-header>
            <mat-card-title>
                Lưu trữ gần đây
                <mat-badge [badgeContent]="archives().length" color="primary" position="after" />
            </mat-card-title>
            <button mat-icon-button routerLink="/retention/archives" matTooltip="Xem tất cả">
                <mat-icon>open_in_new</mat-icon>
            </button>
        </mat-card-header>
        <mat-card-content>
            @if (archivesLoading()) {
            <div class="loading-overlay">
                <mat-progress-spinner diameter="32" mode="indeterminate" />
            </div>
            } @else if (archives().length === 0) {
            <div class="empty-state">
                <mat-icon>archive</mat-icon>
                <p>Chưa có bản ghi lưu trữ nào</p>
            </div>
            } @else {
            <div style="overflow-x:auto">
                <table mat-table [dataSource]="archives()">
                    <!-- Tên -->
                    <ng-container matColumnDef="name">
                        <th mat-header-cell *matHeaderCellDef>Tên</th>
                        <td mat-cell *matCellDef="let record">
                            <strong>{{ record.name }}</strong>
                        </td>
                    </ng-container>

                    <!-- Loại -->
                    <ng-container matColumnDef="dataType">
                        <th mat-header-cell *matHeaderCellDef>Loại</th>
                        <td mat-cell *matCellDef="let record">
                            <mat-chip-set>
                                <mat-chip selected color="primary" variant="filled">
                                    {{ dataTypeLabels()[record.dataType] ?? record.dataType }}
