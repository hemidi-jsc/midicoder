`,
template: `
<!-- Thanh tiến độ tải thống kê -->
@if (statsLoading()) {
<mat-progress-bar mode="indeterminate" />
}

<!-- ── Header ── -->
<div class="dashboard-header">
    <h1>Bảng điều khiển — Quản lý chu kỳ dữ liệu</h1>
    <div class="header-actions">
        <button mat-icon-button (click)="handleRefresh()" [disabled]="refreshing()" matTooltip="Làm mới dữ liệu">
            <mat-icon>{{ refreshing() ? 'hourglass_empty' : 'refresh' }}</mat-icon>
        </button>
        <button mat-flat-button color="primary" routerLink="/retention/policies">
            <mat-icon>policy</mat-icon>
            Quản lý chính sách
        </button>
    </div>
</div>

<!-- ── Thống kê Cards ── -->
@if (stats(); as currentStats) {
<div class="stats-grid">
    <mat-grid-list [cols]="getGridCols()" rowHeight="100px" gutterSize="16px">
        @for (card of statCards(); track card.title) {
        <mat-grid-tile>
            <mat-card class="stat-card">
                <div class="card-content">
                    <div class="stat-icon" [class]="card.color">
                        <mat-icon>{{ card.icon }}</mat-icon>
                    </div>
