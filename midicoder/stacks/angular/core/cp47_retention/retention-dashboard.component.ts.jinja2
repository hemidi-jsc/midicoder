        <!-- Chính sách sắp hết hạn -->
        @if (stats(); as s) {
        @if (s.expiringPolicies.length > 0) {
        <mat-card class="expiring-warning">
            <mat-card-header>
                <mat-card-title>
                    <mat-icon style="color:#f44336;margin-right:8px">
                        warning
