 * CP47 — Quản lý chu kỳ dữ liệu (Data Retention & Lifecycle Management)
 * Định nghĩa kiểu TypeScript cho module retention.
 *
 * Mô-đun này cung cấp các interface, type alias, và enum
 * phục vụ cho việc quản lý chính sách lưu trữ, lưu trữ dữ liệu,
 * và yêu cầu xóa dữ liệu theo GDPR.
 */

import { Type } from '@angular/core';
import { MatDialogRef } from '@angular/material/dialog';

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

/** Trạng thái chính sách lưu trữ */
export enum RetentionPolicyStatus {
  /** Đang hoạt động — chính sách được áp dụng tự động */
  Active = 'active',
  /** Tạm ngưng — chính sách được giữ lại nhưng không áp dụng */
  Suspended = 'suspended',
  /** Đã hoàn thành — chính sách đã chạy hết chu kỳ */
  Completed = 'completed',
  /** Đã vô hiệu hóa — chính sách bị huỷ bỏ */
  Disabled = 'disabled',
}

/** Loại đối tượng dữ liệu được quản lý bởi chính sách */
export enum RetentionDataType {
  /** Nhật ký hệ thống */
  Logs = 'logs',
  /** Dữ liệu phiên người dùng */
  Sessions = 'sessions',
  /** Bản nháp mã nguồn */
  CodeDrafts = 'code_drafts',
  /** Kết quả phân tích */
  Analytics = 'analytics',
  /** Sao lưu cơ sở dữ liệu */
  DatabaseBackups = 'database_backups',
  /** Tệp đa phương tiện */
  MediaAssets = 'media_assets',
  /** Nhắn tin nội bộ */
  InternalMessages = 'internal_messages',
  /** Dữ liệu người dùng cá nhân (PII) */
  PersonalData = 'personal_data',
}

/** Đơn vị thời gian cho chu kỳ lưu trữ */
export enum RetentionPeriodUnit {
  /** Theo ngày */
  Days = 'days',
  /** Theo tuần */
  Weeks = 'weeks',
  /** Theo tháng */
  Months = 'months',
  /** Theo năm */
  Years = 'years',
}

/** Trạng thái yêu cầu xóa dữ liệu (GDPR Erasure) */
export enum ErasureRequestStatus {
  /** Mới tạo — chưa được xem xét */
  Pending = 'pending',
  /** Đang được xử lý */
  Processing = 'processing',
  /** Đã xác minh danh tính */
  Verified = 'verified',
  /** Đang xóa dữ liệu */
  Erasing = 'erasing',
  /** Đã xóa thành công */
  Completed = 'completed',
  /** Đã từ chối */
  Denied = 'denied',
  /** Đã hết hạn */
  Expired = 'expired',
}

/** Lý do từ chối yêu cầu xóa */
export enum ErasureDenialReason {
  /** Yêu cầu thiếu thông tin xác minh */
  InsufficientVerification = 'insufficient_verification',
  /** Dữ liệu bắt buộc phải lưu theo luật */
  LegalHold = 'legal_hold',
  /** Vượt quá tần suất yêu cầu */
  RateLimitExceeded = 'rate_limit_exceeded',
  /** Không tìm thấy dữ liệu liên quan */
  NoDataFound = 'no_data_found',
  /** Khác — cần mô tả tự do */
  Other = 'other',
}

/** Hành động nhanh trên dashboard */
export enum QuickActionType {
  /** Tạo chính sách mới */
  CreatePolicy = 'create_policy',
  /** Khởi tạo lưu trữ hàng loạt */
  BulkArchive = 'bulk_archive',
  /** Gửi yêu cầu xóa */
  SubmitErasure = 'submit_erasure',
  /** Xuất báo cáo tuân thủ */
  ExportCompliance = 'export_compliance',
  /** Làm mới bộ đếm */
  RefreshCounts = 'refresh_counts',
  /** Kiểm tra nhật ký thính giác */
  AuditLog = 'audit_log',
}

/** Sắp xếp cho bảng dữ liệu */
export enum SortDirection {
  Asc = 'asc',
  Desc = 'desc',
  None = '',
}

/** Loại tab trong dialog chính sách */
export enum PolicyDialogMode {
  /** Tạo mới */
  Create = 'create',
  /** Chỉnh sửa */
  Edit = 'edit',
  /** Xem chi tiết (chỉ đọc) */
  View = 'view',
}

// ──────────────────────────────────────────────
// Interfaces — Chính sách lưu trữ
// ──────────────────────────────────────────────

/** Chính sách lưu trữ dữ liệu */
export interface RetentionPolicy {
  /** Định danh duy nhất */
  id: string;
  /** Tên hiển thị */
  name: string;
  /** Mô tả chi tiết */
  description: string;
  /** Loại dữ liệu áp dụng */
  dataType: RetentionDataType;
  /** Số lượng chu kỳ */
  periodCount: number;
  /** Đơn vị chu kỳ */
  periodUnit: RetentionPeriodUnit;
  /** Trạng thái hiện tại */
  status: RetentionPolicyStatus;
  /** Ngày bắt đầu áp dụng (ISO 8601) */
  startDate: string;
  /** Ngày hết hạn (ISO 8601) — null nếu không giới hạn */
  expirationDate: string | null;
  /** Hành động khi hết hạn: 'archive' | 'delete' | 'notify' */
  onExpiration: 'archive' | 'delete' | 'notify';
  /** Số lượng bản ghi đang được quản lý */
  recordCount: number;
  /** Dung lượng dữ liệu (MB) */
  dataUsageMB: number;
  /** Người tạo */
  createdBy: string;
  /** Thời gian tạo (ISO 8601) */
  createdAt: string;
  /** Thời gian cập nhật cuối (ISO 8601) */
  updatedAt: string;
  /** Cờ: có áp dụng ngay không */
  enforceImmediately: boolean;
  /** Cờ: thông báo trước khi hết hạn (số ngày) */
  notifyBeforeDays: number;
}

/** Form tạo/chỉnh sửa chính sách */
export interface RetentionPolicyForm {
  name: string;
  description: string;
  dataType: RetentionDataType;
  periodCount: number;
  periodUnit: RetentionPeriodUnit;
  onExpiration: 'archive' | 'delete' | 'notify';
  enforceImmediately: boolean;
  notifyBeforeDays: number;
  /** chỉ dùng khi Edit — id chính sách gốc */
  policyId?: string;
}

/** Lọc danh sách chính sách */
export interface RetentionPolicyFilters {
  search?: string;
  dataType?: RetentionDataType | 'all';
  status?: RetentionPolicyStatus | 'all';
  sortBy?: keyof RetentionPolicy;
  sortOrder?: SortDirection;
  page?: number;
  pageSize?: number;
}

// ──────────────────────────────────────────────
// Interfaces — Lưu trữ (Archive)
// ──────────────────────────────────────────────

/** Một bản ghi lưu trữ */
export interface ArchiveRecord {
  /** Định danh */
  id: string;
  /** Tên dữ liệu được lưu */
  name: string;
  /** Loại dữ liệu */
  dataType: RetentionDataType;
  /** Chính sách đã áp dụng (id) */
  policyId: string;
  /** Dung lượng (MB) */
  sizeMB: number;
  /** Số bản ghi */
  recordCount: number;
  /** Ngày lưu trữ (ISO 8601) */
  archivedAt: string;
  /** Người khởi tạo */
  archivedBy: string;
  /** Định dạng lưu: 'zip' | 'tar.gz' | 'parquet' */
  format: 'zip' | 'tar.gz' | 'parquet';
  /** URL download */
  downloadUrl: string;
  /** Trạng thái: 'ready' | 'corrupt' | 'deleted' */
  integrity: 'ready' | 'corrupt' | 'deleted';
}

// ──────────────────────────────────────────────
// Interfaces — Yêu cầu xóa dữ liệu (GDPR Erasure)
// ──────────────────────────────────────────────

/** Yêu cầu xóa dữ liệu */
export interface ErasureRequest {
  /** Định danh */
  id: string;
  /** Họ tên chủ thể dữ liệu */
  subjectName: string;
  /** Địa chỉ email */
  subjectEmail: string;
  /** Số điện thoại liên hệ */
  subjectPhone: string;
  /** Phương thức xác minh: 'email' | 'phone' | 'document' */
  verificationMethod: 'email' | 'phone' | 'document';
  /** Đã xác minh chưa */
  isVerified: boolean;
  /** Trạng thái yêu cầu */
  status: ErasureRequestStatus;
  /** Các loại dữ liệu cần xóa */
  dataTypes: RetentionDataType[];
  /** Lý do xóa (mô tả tự do) */
  reason: string;
  /** Lý do từ chối (nếu bị từ chối) */
  denialReason?: ErasureDenialReason;
  /** Mô tả bổ sung khi từ chối */
  denialNote?: string;
  /** Phần trăm tiến độ xóa (0–100) */
  progressPercent: number;
  /** Người tạo yêu cầu */
  createdBy: string;
  /** Người phê duyệt */
  approvedBy: string | null;
  /** Thời gian tạo (ISO 8601) */
  createdAt: string;
  /** Thời gian cập nhật cuối (ISO 8601) */
  updatedAt: string;
  /** Thời gian hoàn thành (ISO 8601) */
  completedAt: string | null;
  /** Số bản ghi đã xóa */
  recordsErased: number;
  /** Tổng số bản ghi cần xóa */
  totalRecords: number;
}

/** Form tạo yêu cầu xóa */
export interface ErasureRequestForm {
  subjectName: string;
  subjectEmail: string;
  subjectPhone: string;
  verificationMethod: 'email' | 'phone' | 'document';
  dataTypes: RetentionDataType[];
  reason: string;
}

/** Lọc danh sách yêu cầu xóa */
export interface ErasureRequestFilters {
  search?: string;
  status?: ErasureRequestStatus | 'all';
  sortBy?: keyof ErasureRequest;
  sortOrder?: SortDirection;
  page?: number;
  pageSize?: number;
}

// ──────────────────────────────────────────────
// Interfaces — Thống kê Dashboard
// ──────────────────────────────────────────────

/** Thống kê tổng quan về chính sách */
export interface RetentionStats {
  /** Tổng số chính sách */
  totalPolicies: number;
  /** Số chính sách đang hoạt động */
  activePolicies: number;
  /** Số chính sách tạm ngưng */
  suspendedPolicies: number;
  /** Tổng bản ghi đang được quản lý */
  totalManagedRecords: number;
  /** Tổng dung lượng (MB) */
  totalDataUsageMB: number;
  /** Số bản ghi đã lưu trữ */
  totalArchivedRecords: number;
  /** Dung lượng đã lưu (MB) */
  totalArchivedMB: number;
  /** Số yêu cầu xóa đang chờ */
  pendingErasureRequests: number;
  /** Số yêu cầu xóa đã hoàn thành trong tháng */
  completedErasureThisMonth: number;
  /** Tỷ lệ tuân thủ (%) */
  compliancePercentage: number;
  /** Số cảnh báo sắp hết hạn */
  expiringSoonCount: number;
  /** Chính sách sắp hết hạn (tối đa 5) */
  expiringPolicies: Array<{
    id: string;
    name: string;
    expirationDate: string;
    daysRemaining: number;
  }>;
}

