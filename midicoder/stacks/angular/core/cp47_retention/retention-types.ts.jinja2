/** Phản hồi phân trang chung */
export interface PaginatedResponse<T> {
  /** Danh sách bản ghi */
  items: T[];
  /** Tổng số bản ghi */
  total: number;
  /** Trang hiện tại (1-based) */
  page: number;
  /** Kích thước trang */
  pageSize: number;
  /** Tổng số trang */
  totalPages: number;
  /** Còn có trang tiếp theo không */
  hasMore: boolean;
}

/** Phản hồi lỗi chuẩn */
export interface ApiError {
  /** Mã lỗi */
  code: string;
  /** Tin nhắn lỗi */
  message: string;
  /** Chi tiết lỗi (tùy chọn) */
  details?: Record<string, unknown>;
  /** Dấu thời gian (ISO 8601) */
  timestamp: string;
}

