/** Label hiển thị cho trạng thái chính sách */
export type PolicyStatusLabel = {
  [K in RetentionPolicyStatus]: string;
};

/** Label hiển thị cho loại dữ liệu */
export type DataTypeLabel = {
  [K in RetentionDataType]: string;
};

/** Label hiển thị cho trạng thái yêu cầu xóa */
export type ErasureStatusLabel = {
  [K in ErasureRequestStatus]: string;
};

/** Cấu hình màu chip cho trạng thái */
export type StatusColorConfig = Record<string, 'primary' | 'accent' | 'warn' | 'basic'>;

/** Cấu hình hành động nhanh */
export type QuickActionConfig = {
  type: QuickActionType;
  label: string;
  icon: string;
  permission?: string;
  disabled?: boolean;
};

/** Hàm handler cho sự kiện bảng */
export type TableEventHandler<K extends string, P = unknown> = (
  event: { key: K; payload: P }
) => void;

/** Kiểu dialog tham chiếu chung */
export type PolicyDialogRef = MatDialogRef<unknown, RetentionPolicyForm>;

/** Cấu hình cột bảng */
export type ColumnConfig<T> = {
  key: keyof T;
  header: string;
  sortable: boolean;
  width?: string;
  cellTemplate?: Type<unknown>;
};

/** Kết hợp chính sách với thông tin người dùng */
export interface RetentionPolicyWithUser extends RetentionPolicy {
  createdByDisplayName: string;
  createdByAvatarUrl: string;
}

/** Kết hợp yêu cầu xóa với progress chi tiết */
export interface ErasureRequestWithProgress extends ErasureRequest {
  progressSteps: Array<{
    step: string;
    status: 'done' | 'current' | 'pending';
    completedAt?: string;
  }>;
}

/** Cấu hình bộ đếm dashboard card */
export interface StatCardConfig {
  title: string;
  valueKey: keyof RetentionStats;
  icon: string;
  color: 'primary' | 'accent' | 'warn' | 'info';
  trend?: {
    value: number;
    direction: 'up' | 'down';
    period: string;
  };
}

