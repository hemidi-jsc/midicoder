/** Auth UI Module - CP21.
 *
 * Module gom tất cả auth UI components, guards và services.
 * Import module này vào feature module để sử dụng auth UI.
 *
 * UI Framework: [{ui_framework}]
 */

import { NgModule } from "@angular/core";
import { CommonModule } from "@angular/common";
import { ReactiveFormsModule } from "@angular/forms";
import { RouterModule } from "@angular/router";
{% if ui_framework == 'material' %}
import { MatFormFieldModule } from "@angular/material/form-field";
import { MatInputModule } from "@angular/material/input";
import { MatButtonModule } from "@angular/material/button";
import { MatCardModule } from "@angular/material/card";
import { MatDividerModule } from "@angular/material/divider";
{% elif ui_framework == 'bootstrap' %}
import { NgBootstrapModule } from "ng-bootstrap";
{% elif ui_framework == 'antd' %}
import { NzFormModule } from "ng-zorro-antd/form";
import { NzInputModule } from "ng-zorro-antd/input";
import { NzButtonModule } from "ng-zorro-antd/button";
{% elif ui_framework == 'carbon' %}
import { CarbonComponentsAngularModule } from "@carbon/angular";
{% endif %}
import { authRoutes } from "./auth.routes";

@NgModule({
  imports: [
    CommonModule,
    ReactiveFormsModule,
    RouterModule.forChild(authRoutes),
{% if ui_framework == 'material' %}
    MatFormFieldModule,
    MatInputModule,
    MatButtonModule,
    MatCardModule,
    MatDividerModule,
{% elif ui_framework == 'bootstrap' %}
    NgBootstrapModule,
{% elif ui_framework == 'antd' %}
    NzFormModule,
    NzInputModule,
    NzButtonModule,
{% elif ui_framework == 'carbon' %}
    CarbonComponentsAngularModule,
{% endif %}
  ],
  declarations: [],
  exports: [RouterModule],
  providers: [
{% if include_role_guard %}
    // RoleGuard — providedIn: root, không cần declare
{% endif %}
{% if include_permission_guard %}
    // PermissionGuard — providedIn: root, không cần declare
{% endif %}
  ],
})
export class AuthUIModule {}
