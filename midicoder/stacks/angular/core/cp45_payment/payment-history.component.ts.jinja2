/**
* CP45 Payment Gateway — Payment History Component
*
* Thanh phan hien thi lich su giao dich thanh toan voi:
* - Bang giao dich phan trang
* - Bo loc theo trang thai, phuong thuc, khoang ngay, so tien
* - Tim kiem theo tu khoa
* - Sap xep theo cot
* - Hanh dong: xem chi tiet, hoan tien, huy giao dich
*
* Su dung Signal Store va Angular signals hien dai.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
ChangeDetectionStrategy,
inject,
computed,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { MatButtonModule } from '@angular/material/button';
import { MatTableModule } from '@angular/material/table';
import { MatPaginatorModule } from '@angular/material/paginator';
import { MatSortModule } from '@angular/material/sort';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatChipsModule } from '@angular/material/chips';
import { MatDialogModule } from '@angular/material/dialog';
{% elif ui_framework == "tailwind" %}
import {
Component,
ChangeDetectionStrategy,
inject,
computed,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
import {
Component,
ChangeDetectionStrategy,
inject,
computed,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
import {
Component,
ChangeDetectionStrategy,
inject,
computed,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Ant Design khong dung cho Angular
{% elif ui_framework == "carbon" %}
import {
Component,
ChangeDetectionStrategy,
inject,
computed,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Carbon khong dung cho Angular
