export class PaymentHistoryComponent {
/* ---------------------------------------------------------------
* Store — inject theo kiểu hiện đại
* --------------------------------------------------------------- */

private readonly store = inject(PaymentStore);

/** Danh sách giao dịch (trang hiện tại) */
readonly transactions = this.store.transactions;

/** Tổng số bản ghi */
readonly total = this.store.total;

/** Tổng số trang */
readonly totalPages = this.store.totalPages;

/** Số trang hiện tại — derived signal từ pagination */
readonly currentPage = computed(() => this.store.pagination().page);

/** Đang tải lịch sử */
readonly loadingHistory = this.store.history;

/** Lỗi */
readonly error = this.store.currentError;

/* ---------------------------------------------------------------
* Local state — bộ lọc
* --------------------------------------------------------------- */

/** Bộ lọc cục bộ (chưa áp dụng) */
localFilters: {
search: string;
status: PaymentStatus | null;
methodType: PaymentMethodType | null;
fromDate: string;
toDate: string;
minAmount: number | null;
maxAmount: number | null;
} = {
search: '',
status: null,
methodType: null,
fromDate: '',
toDate: '',
minAmount: null,
maxAmount: null,
};

/* ---------------------------------------------------------------
* Local state — dialog
* --------------------------------------------------------------- */

/** Nhảy đến trang */
jumpPage = 1;

/** Giao dịch đang chờ hoàn tiền */
refundTarget: PaymentTransactionSummary | null = null;

/** Form hoàn tiền */
refundForm: { amount: number | null; reason: string } = {
amount: null,
reason: '',
};

/** ID giao dịch đang chờ hủy */
cancellingId: string | null = null;

/* ---------------------------------------------------------------
* Tùy chọn enum hiển thị
* --------------------------------------------------------------- */

statusOptions = [
PaymentStatus.PENDING,
PaymentStatus.COMPLETED,
PaymentStatus.FAILED,
PaymentStatus.CANCELLED,
PaymentStatus.AWAITING_CONFIRMATION,
PaymentStatus.REFUNDED,
];

methodTypeOptions = [
PaymentMethodType.CARD,
PaymentMethodType.BANK_TRANSFER,
PaymentMethodType.E_WALLET,
PaymentMethodType.COD,
PaymentMethodType.QR_CODE,
PaymentMethodType.VOUCHER,
];

/* ---------------------------------------------------------------
* Lifecycle
* --------------------------------------------------------------- */

constructor() {
// Dữ liệu đã được tự động tải từ PaymentStore.onInit hook
}

/* ---------------------------------------------------------------
* Methods — Bộ lọc
* --------------------------------------------------------------- */

/** Áp dụng bộ lọc */
onApplyFilters(): void {
const filters: any = {};

if (this.localFilters.search?.trim()) {
filters.search = this.localFilters.search.trim();
}
if (this.localFilters.status) {
filters.status = this.localFilters.status;
}
if (this.localFilters.methodType) {
filters.methodType = this.localFilters.methodType;
}
if (this.localFilters.fromDate) {
filters.fromDate = this.localFilters.fromDate;
}
if (this.localFilters.toDate) {
filters.toDate = this.localFilters.toDate;
}
if (this.localFilters.minAmount !== null && this.localFilters.minAmount !== undefined) {
filters.minAmount = this.localFilters.minAmount;
}
if (this.localFilters.maxAmount !== null && this.localFilters.maxAmount !== undefined) {
filters.maxAmount = this.localFilters.maxAmount;
}

this.store.updateFilters(filters);
}

/** Xóa toàn bộ bộ lọc */
onClearFilters(): void {
this.localFilters = {
search: '',
status: null,
methodType: null,
fromDate: '',
toDate: '',
minAmount: null,
maxAmount: null,
};
this.store.clearFilters();
}

/* ---------------------------------------------------------------
* Methods — Sắp xếp
* --------------------------------------------------------------- */

/** Sắp xếp theo trường */
onSortBy(field: string): void {
this.store.sortBy(field);
}

/** Lấy ký hiệu sắp xếp cho cột */
getSortIndicator(field: string): string {
const pagination = this.store.pagination();
if (pagination.sortBy !== field) return '';
return pagination.sortOrder === 'asc' ? ' \u25B2' : ' \u25BC';
}

/* ---------------------------------------------------------------
* Methods — Phân trang
* --------------------------------------------------------------- */

/** Chuyển đến trang */
onGoToPage(page: number): void {
this.store.goToPage(page);
}

/** Nhảy đến trang (từ input) */
onJumpToPage(): void {
const page = Math.max(1, Math.min(this.jumpPage, this.totalPages()));
this.store.goToPage(page);
this.jumpPage = page;
}

/* ---------------------------------------------------------------
* Methods — Hành động giao dịch
* --------------------------------------------------------------- */

/** Xem chi tiết giao dịch */
onViewDetails(id: string): void {
// Điều hướng đến trang chi tiết giao dịch
window.location.hash = `#/payments/transactions/${id}`;
}

/** Mở dialog hủy giao dịch */
onCancelTransaction(id: string): void {
this.cancellingId = id;
}

/** Xác nhận hủy giao dịch */
onConfirmCancel(): void {
if (this.cancellingId) {
this.store.cancelTransaction(this.cancellingId);
}
this.cancellingId = null;
}

/** Hủy dialog hủy giao dịch */
onCancelCancel(): void {
this.cancellingId = null;
}

/** Mở dialog hoàn tiền */
onOpenRefundDialog(tx: PaymentTransactionSummary): void {
this.refundTarget = tx;
this.refundForm = { amount: null, reason: '' };
}

/** Xác nhận hoàn tiền */
onConfirmRefund(): void {
if (!this.refundTarget) return;

const dto: RefundPaymentDto = {
amount: this.refundForm.amount ?? undefined,
reason: this.refundForm.reason.trim(),
};

if (!dto.reason) {
return; // Lý do bắt buộc
}

this.store.refundPayment(this.refundTarget.id, dto);
this.refundTarget = null;
}

/** Hủy dialog hoàn tiền */
onCancelRefund(): void {
this.refundTarget = null;
}

/** Xóa thông báo lỗi */
onClearError(): void {
this.store.clearError();
}

/* ---------------------------------------------------------------
* Methods — Tiện ích hiển thị
* --------------------------------------------------------------- */

/** Định dạng tiền tệ */
formatCurrency(value: number): string {
return value.toLocaleString('vi-VN', {
minimumFractionDigits: 0,
maximumFractionDigits: 0,
});
}

/** Lấy class CSS cho trạng thái */
getStatusClass(status: PaymentStatus): string {
return `status-${status.toLowerCase()}`;
}

/** Lấy nhãn tiếng Việt cho trạng thái */
getStatusLabel(status: PaymentStatus): string {
const labels: Record<PaymentStatus, string> = {
    [PaymentStatus.PENDING]: 'Đang chờ',
    [PaymentStatus.COMPLETED]: 'Thành công',
    [PaymentStatus.FAILED]: 'Thất bại',
    [PaymentStatus.CANCELLED]: 'Đã hủy',
    [PaymentStatus.AWAITING_CONFIRMATION]: 'Chờ xác nhận',
    [PaymentStatus.REFUNDED]: 'Đã hoàn tiền',
    };
    return labels[status] ?? status;
    }
    }