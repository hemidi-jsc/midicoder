import { PaymentStore } from './payment.store';
import {
PaymentStatus,
PaymentMethodType,
PaymentTransactionSummary,
RefundPaymentDto,
} from './payment-types';

@Component({
selector: 'app-payment-history',
standalone: true,
imports: [CommonModule, FormsModule],
changeDetection: ChangeDetectionStrategy.OnPush,
{% raw %}template: `
<div class="payment-history-page">
    <!-- Tiêu đề -->
    <header class="page-header">
        <h1>Lịch Sử Giao Dịch</h1>
        <span class="record-count">
            {{ total() }} giao dịch
        </span>
    </header>

    <!-- Hiển thị lỗi -->
    <div *ngIf="error()" class="error-banner">
        <strong>Lỗi:</strong> {{ error() }}
        <button (click)="onClearError()">Đóng</button>
    </div>

    <!-- Bộ lọc -->
    <section class="filters-section">
        <div class="filters-grid">
            <!-- Tìm kiếm -->
            <div class="filter-item">
                <label for="search">Tìm kiếm</label>
                <input id="search" type="text" [(ngModel)]="localFilters.search" (keyup.enter)="onApplyFilters()"
                    placeholder="Từ khóa, mô tả..." />
            </div>

            <!-- Trạng thái -->
            <div class="filter-item">
                <label for="status-filter">Trạng thái</label>
                <select id="status-filter" [(ngModel)]="localFilters.status">
                    <option [ngValue]="null">Tất cả</option>
                    <option [ngValue]="status" *ngFor="let status of statusOptions">
                        {{ getStatusLabel(status) }}
                    </option>
                </select>
            </div>

            <!-- Phương thức -->
            <div class="filter-item">
                <label for="method-filter">Phương thức</label>
                <select id="method-filter" [(ngModel)]="localFilters.methodType">
                    <option [ngValue]="null">Tất cả</option>
                    <option [ngValue]="type" *ngFor="let type of methodTypeOptions">
                        {{ type }}
                    </option>
                </select>
            </div>

            <!-- Từ ngày -->
            <div class="filter-item">
                <label for="from-date">Từ ngày</label>
                <input id="from-date" type="date" [(ngModel)]="localFilters.fromDate" />
            </div>

            <!-- Đến ngày -->
            <div class="filter-item">
                <label for="to-date">Đến ngày</label>
                <input id="to-date" type="date" [(ngModel)]="localFilters.toDate" />
            </div>

            <!-- Số tiền tối thiểu -->
            <div class="filter-item">
                <label for="min-amount">Từ số tiền</label>
                <input id="min-amount" type="number" [(ngModel)]="localFilters.minAmount" min="0" placeholder="0" />
            </div>

            <!-- Số tiền tối đa -->
            <div class="filter-item">
                <label for="max-amount">Đến số tiền</label>
                <input id="max-amount" type="number" [(ngModel)]="localFilters.maxAmount" min="0"
                    placeholder="Không giới hạn" />
            </div>
        </div>

        <!-- Nút hành động -->
        <div class="filter-actions">
            <button class="apply-btn" (click)="onApplyFilters()">Áp dụng bộ lọc</button>
            <button class="clear-btn" (click)="onClearFilters()">Xóa bộ lọc</button>
        </div>
    </section>

    <!-- Đang tải -->
    <div *ngIf="loadingHistory()" class="loading-state">
        <p>Đang tải lịch sử giao dịch...</p>
    </div>

    <!-- Bảng giao dịch -->
    <section *ngIf="!loadingHistory() && transactions().length; else emptyState" class="table-section">
        <table class="transactions-table">
            <thead>
                <tr>
                    <th (click)="onSortBy('createdAt')">
                        Ngày tạo {{ getSortIndicator('createdAt') }}
                    </th>
                    <th>Mô Tả</th>
                    <th (click)="onSortBy('amount')">
                        Số Tiền {{ getSortIndicator('amount') }}
                    </th>
                    <th>Phương Thức</th>
                    <th (click)="onSortBy('status')">
                        Trạng Thái {{ getSortIndicator('status') }}
                    </th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <tr *ngFor="let tx of transactions()">
                    <td class="date-cell">{{ tx.createdAt | date:'mediumDate' }}</td>
                    <td class="desc-cell">{{ tx.description || '(không mô tả)' }}</td>
                    <td class="amount-cell">{{ formatCurrency(tx.amount) }} {{ tx.currency }}</td>
                    <td class="method-cell">{{ tx.paymentMethodName }}</td>
                    <td>
                        <span class="status-badge" [class]="getStatusClass(tx.status)">
                            {{ getStatusLabel(tx.status) }}
                        </span>
                    </td>
                    <td class="actions-cell">
                        <button (click)="onViewDetails(tx.id)">Chi tiết</button>
                        <button *ngIf="tx.status === 'pending'" (click)="onCancelTransaction(tx.id)" class="cancel-btn">
                            Hủy
                        </button>
                        <button *ngIf="tx.status === 'completed'" (click)="onOpenRefundDialog(tx)" class="refund-btn">
                            Hoàn tiền
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Phân trang -->
        <nav class="pagination" *ngIf="totalPages() > 1">
            <button [disabled]="currentPage() <= 1" (click)="onGoToPage(currentPage() - 1)">
                &laquo; Trước
            </button>

            <span class="page-info">
                Trang {{ currentPage() }} / {{ totalPages() }}
            </span>

            <button [disabled]="currentPage() >= totalPages()" (click)="onGoToPage(currentPage() + 1)">
                Sau &raquo;
            </button>

            <!-- Nhảy đến trang -->
            <div class="jump-to-page">
                <input type="number" [(ngModel)]="jumpPage" (keyup.enter)="onJumpToPage()" [min]="1"
                    [max]="totalPages()" placeholder="Trang..." />
                <button (click)="onJumpToPage()">Nhảy</button>
            </div>
        </nav>
    </section>

    <!-- Trạng thái rỗng -->
    <ng-template #emptyState>
        <div class="empty-state">
            <p>Không có giao dịch nào phù hợp với bộ lọc hiện tại.</p>
            <button class="clear-btn" (click)="onClearFilters()">Xóa bộ lọc</button>
        </div>
    </ng-template>

    <!-- Dialog hoàn tiền -->
    <div *ngIf="refundTarget" class="confirm-overlay">
        <div class="confirm-dialog">
            <h3>Yêu Cầu Hoàn Tiền</h3>
            <p>Hoàn tiền cho giao dịch: <strong>{{ refundTarget.description }}</strong></p>
            <p>Số tiền gốc: <strong>{{ formatCurrency(refundTarget.amount) }} {{ refundTarget.currency }}</strong></p>

            <div class="form-row">
                <label for="refund-amount">Số tiền hoàn lại (để trống = hoàn toàn bộ)</label>
                <input id="refund-amount" type="number" [(ngModel)]="refundForm.amount" [max]="refundTarget.amount"
                    min="1" placeholder="Toàn bộ" />
            </div>

            <div class="form-row">
                <label for="refund-reason">Lý do hoàn tiền</label>
                <textarea id="refund-reason" [(ngModel)]="refundForm.reason" rows="3" required></textarea>
            </div>

            <div class="confirm-actions">
                <button class="refund-confirm-btn" (click)="onConfirmRefund()">Xác nhận hoàn tiền</button>
                <button (click)="onCancelRefund()">Hủy</button>
            </div>
        </div>
    </div>

    <!-- Dialog hủy giao dịch -->
    <div *ngIf="cancellingId" class="confirm-overlay">
        <div class="confirm-dialog">
            <h3>Xác Nhận Hủy Giao Dịch</h3>
            <p>Bạn có chắc muốn hủy giao dịch này?</p>
            <div class="confirm-actions">
                <button class="cancel-confirm-btn" (click)="onConfirmCancel()">Hủy giao dịch</button>
                <button (click)="onCancelCancel()">Không hủy</button>
            </div>
        </div>
    </div>
</div>
`,
{% endraw %}
