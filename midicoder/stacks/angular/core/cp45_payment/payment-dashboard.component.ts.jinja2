})
export class PaymentDashboardComponent {
/* ---------------------------------------------------------------
* SignalStore — inject theo kiểu hiện đại
* --------------------------------------------------------------- */

/** Store — inject để truy cập signals và methods */
private readonly store = inject(PaymentStore);

/** Dữ liệu thống kê */
readonly stats = this.store.data;

/** Danh sách phương thức */
readonly list = this.store.list;

/** Phương thức mặc định */
readonly defaultMethod = this.store.defaultMethod;

/** Số phương thức kích hoạt */
readonly activeMethodsCount = this.store.activeMethodsCount;

/** Đang tải */
readonly isLoading = this.store.isLoading;

/** Thông báo lỗi */
readonly error = this.store.currentError;

/* ---------------------------------------------------------------
* Lifecycle
* --------------------------------------------------------------- */

constructor() {
// Dữ liệu đã được tự động tải từ PaymentStore.onInit hook
}

/* ---------------------------------------------------------------
* Methods
* --------------------------------------------------------------- */

/** Làm mới tất cả dữ liệu */
onRefresh(): void {
this.store.reloadAll();
}

/** Xóa thông báo lỗi */
onClearError(): void {
this.store.clearError();
}

/** Tính phần trăm so với tổng */
calculatePercent(value: number, total: number): number {
if (total === 0) return 0;
return Math.round((value / total) * 100);
}

/** Tính chiều cao tối đa của thanh xu hướng */
maxPeriodAmount(): number {
const stats = this.stats();
if (!stats || !stats.byPeriod.length) return 100;
return Math.max(...stats.byPeriod.map((p) => p.amount), 1);
}

/** Tính chiều cao thanh xu hướng */
calculateTrendHeight(amount: number, max: number): number {
if (max === 0) return 4;
return Math.max(Math.round((amount / max) * 140), 4);
}

/** Định dạng tiền tệ */
formatCurrency(value: number): string {
return value.toLocaleString('vi-VN', {
minimumFractionDigits: 0,
maximumFractionDigits: 0,
});
}

/** Lấy icon cho loại phương thức */
getMethodIcon(type: string): string {
const icons: Record<string, string> = {
    card: '\uD83D\uDCB3',
    bank_transfer: '\uD83C\uDFE6',
    e_wallet: '\uD83D\uDCB0',
    cod: '\uD83D\uDCB1',
    qr_code: '\uD83D\uDD0D',
    voucher: '\uD83C\uDF81',
    };
    return icons[type] ?? '\uD83D\uDCB2';
    }

    /** Lấy nhãn tiếng Việt cho loại phương thức */
    getMethodLabel(type: string): string {
    const labels: Record<string, string> = {
        card: 'Thẻ tín dụng / ghi nợ',
        bank_transfer: 'Chuyển khoản ngân hàng',
        e_wallet: 'Ví điện tử',
        cod: 'Thanh toán khi nhận hàng',
        qr_code: 'Mã QR',
        voucher: 'Mã giảm giá',
        };
        return labels[type] ?? type;
        }
        }
        {% endraw %}