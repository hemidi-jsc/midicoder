/**
* CP45 Payment Gateway — Dashboard Component
*
* Hien thi bang dieu khien thanh toan voi:
* - Cac chi so chinh (tong doanh thu, so giao dich, ty le thanh cong)
* - Bieu do phan bo theo phuong thuc thanh toan
* - Bieu do xu huong theo thoi gian
* - Trang thai phuong thuc mac dinh
*
* Su dung Signal Store va Angular signals hien dai.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatProgressBarModule } from '@angular/material/progress-bar';
{% elif ui_framework == "tailwind" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
// Ant Design khong dung cho Angular
{% elif ui_framework == "carbon" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
// Carbon khong dung cho Angular
{% endif %}

import { PaymentStore } from './payment.store';
import { PaymentMethodBreakdown, PaymentPeriodBreakdown, PaymentStats } from './payment-types';

@Component({
selector: 'app-payment-dashboard',
standalone: true,
imports: [CommonModule],
changeDetection: ChangeDetectionStrategy.OnPush,
template: `
<div class="payment-dashboard">
    <!-- Tiêu đề -->
    <header class="dashboard-header">
        <h1>Bảng Điều Khiển Thanh Toán</h1>
        <p class="subtitle">CP45: Payment Gateway</p>
        <button class="refresh-btn" (click)="onRefresh()" [disabled]="isLoading()">
            {{ isLoading() ? 'Đang tải...' : 'Làm mới' }}
        </button>
    </header>

    <!-- Hiển thị lỗi nếu có -->
    <div *ngIf="error()" class="error-banner">
        <strong>Lỗi:</strong> {{ error() }}
        <button (click)="onClearError()">Đóng</button>
    </div>

    <!-- Đang tải toàn bộ -->
    <div *ngIf="isLoading() && !stats()" class="loading-state">
        <p>Đang tải dữ liệu thanh toán...</p>
    </div>

    <!-- Nội dung chính -->
    <ng-container *ngIf="stats() as statsData">
        <!-- Hàng chỉ số chính -->
        <section class="kpi-row">
            <div class="kpi-card">
                <span class="kpi-label">Tổng Doanh Thu</span>
                <span class="kpi-value primary">{{ formatCurrency(statsData.successfulAmount) }} VND</span>
                <span class="kpi-sub">{{ statsData.successfulCount }} giao dịch thành công</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Tổng Giao Dịch</span>
                <span class="kpi-value">{{ statsData.totalTransactions }}</span>
                <span class="kpi-sub">Tỷ lệ thành công: {{ (statsData.successRate * 100 | number:'1.1-1') }}%</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Đang Chờ Xử Lý</span>
                <span class="kpi-value warning">{{ formatCurrency(statsData.pendingAmount) }} VND</span>
                <span class="kpi-sub">{{ statsData.failedCount }} giao dịch thất bại</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Số Tiền Hoàn Lại</span>
                <span class="kpi-value danger">{{ formatCurrency(statsData.refundedAmount) }} VND</span>
                <span class="kpi-sub">Tổng giá trị hoàn tiền</span>
            </div>
        </section>

        <!-- Phương thức mặc định -->
        <section class="default-method-section">
            <h2>Phương Thức Mặc Định</h2>
            <div *ngIf="defaultMethod() as method; else noDefault">
                <div class="method-badge">
                    <span class="method-icon">{{ getMethodIcon(method.type) }}</span>
                    <span class="method-name">{{ method.displayName }}</span>
                    <span class="method-type-label">{{ getMethodLabel(method.type) }}</span>
                </div>
            </div>
            <ng-template #noDefault>
                <p class="empty-text">Chưa có phương thức mặc định nào.</p>
            </ng-template>
        </section>

        <!-- Phân bổ theo phương thức -->
        <section class="breakdown-section">
            <h2>Phân Bổ Theo Phương Thức</h2>
            <div class="method-bars">
                <div *ngFor="let b of statsData.byMethod" class="method-bar-row">
                    <span class="bar-label">{{ getMethodLabel(b.methodType) }}</span>
                    <div class="bar-track">
                        <div class="bar-fill" [style.width.%]="calculatePercent(b.amount, statsData.successfulAmount)">
                        </div>
                    </div>
                    <span class="bar-value">
                        {{ b.count }} giao dịch — {{ formatCurrency(b.amount) }} VND
                    </span>
                </div>
            </div>
        </section>

        <!-- Xu hướng theo thời gian -->
        <section class="trend-section">
            <h2>Xu Hướng Theo Thời Gian</h2>
            <div class="trend-bars">
                <div *ngFor="let p of statsData.byPeriod" class="trend-bar-col">
                    <div class="trend-bar" [style.height.px]="calculateTrendHeight(p.amount, maxPeriodAmount())"
                        [title]="p.period + ': ' + formatCurrency(p.amount) + ' VND'"></div>
                    <span class="trend-label">{{ p.period }}</span>
                    <span class="trend-count">{{ p.count }}</span>
                </div>
            </div>
            <p *ngIf="!statsData.byPeriod.length" class="empty-text">
                Chưa có dữ liệu theo thời gian.
            </p>
        </section>

        <!-- Số lượng phương thức -->
        <section class="methods-summary">
            <h2>Tổng Quan Phương Thức</h2>
            <div class="methods-count-grid">
                <div class="count-item">
                    <span class="count-number">{{ activeMethodsCount() }}</span>
                    <span class="count-label">Đang Kích Hoạt</span>
                </div>
                <div class="count-item">
                    <span class="count-number">{{ list().length }}</span>
                    <span class="count-label">Tổng Số</span>
                </div>
                <div class="count-item">
                    <span class="count-number">{{ list().length - activeMethodsCount() }}</span>
                    <span class="count-label">Bị Vô Hiệu Hóa</span>
                </div>
            </div>
        </section>
    </ng-container>
</div>
`,
styles: [`
