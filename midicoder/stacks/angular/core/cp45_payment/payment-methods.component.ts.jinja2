/**
* CP45 Payment Gateway — Payment Methods Component (CRUD)
*
* Thanh phan quan ly phuong thuc thanh toan:
* - Hien thi danh sach phuong thuc dang co
* - Tao moi phuong thuc thanh toan
* - Cap nhat / vo hieu hoa phuong thuc
* - Xoa phuong thuc (co xac nhan)
* - Dat phuong thuc lam mac dinh
*
* Su dung Signal Store va Angular signals hien dai.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatChipsModule } from '@angular/material/chips';
import { MatDialogModule } from '@angular/material/dialog';
import { MatIconModule } from '@angular/material/icon';
{% elif ui_framework == "tailwind" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Su dung Tailwind utility classes trong template
{% elif ui_framework == "bootstrap" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Su dung Bootstrap classes trong template
{% elif ui_framework == "antd" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Ant Design khong dung cho Angular
{% elif ui_framework == "carbon" %}
import {
Component,
ChangeDetectionStrategy,
inject,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
// Carbon khong dung cho Angular
{% endif %}

import { PaymentStore } from './payment.store';
import {
PaymentMethod,
PaymentMethodType,
CreatePaymentMethodDto,
UpdatePaymentMethodDto,
} from './payment-types';

@Component({
selector: 'app-payment-methods',
standalone: true,
imports: [CommonModule, FormsModule],
changeDetection: ChangeDetectionStrategy.OnPush,
template: `
<div class="payment-methods-page">
    <!-- Tiêu đề -->
    <header class="page-header">
        <h1>Quản Lý Phương Thức Thanh Toán</h1>
        <button class="add-btn" (click)="onOpenCreateForm()">+ Thêm mới</button>
    </header>

    <!-- Hiển thị lỗi -->
    <div *ngIf="error()" class="error-banner">
        <strong>Lỗi:</strong> {{ error() }}
        <button (click)="onClearError()">Đóng</button>
    </div>

    <!-- Đang tải -->
    <div *ngIf="loadingMethods()" class="loading-state">
        <p>Đang tải phương thức thanh toán...</p>
    </div>

    <!-- Form tạo mới -->
    <section *ngIf="isCreating()" class="form-section">
        <h2>Thêm Phương Thức Mới</h2>
        <form (ngSubmit)="onCreateMethod()" class="method-form">
            <div class="form-row">
                <label for="new-type">Loại phương thức</label>
                <select id="new-type" [(ngModel)]="newForm.type" name="type" required>
                    <option value="" disabled>-- Chọn loại --</option>
                    <option *ngFor="let opt of methodTypeOptions" [value]="opt.value">
                        {{ opt.label }}
                    </option>
                </select>
            </div>

            <div class="form-row">
                <label for="new-displayName">Tên hiển thị</label>
                <input id="new-displayName" type="text" [(ngModel)]="newForm.displayName" name="displayName"
                    placeholder="Ví dụ: Thẻ Visa •••• 4242" required />
            </div>

            <div class="form-row">
                <label for="new-details">Chi tiết (JSON tùy chọn)</label>
                <textarea id="new-details" [(ngModel)]="newForm.metadataJson" name="metadataJson" rows="3"
                    placeholder='{"bank_code": "VNB", "last4": "4242"}'></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" [disabled]="loadingMethods()">Tạo mới</button>
                <button type="button" (click)="onCancelCreate()">Hủy</button>
            </div>
        </form>
    </section>

    <!-- Form chỉnh sửa -->
    <section *ngIf="editingMethod" class="form-section edit-section">
        <h2>Chỉnh Sửa Phương Thức</h2>
        <form (ngSubmit)="onUpdateMethod()" class="method-form">
            <div class="form-row">
                <label for="edit-displayName">Tên hiển thị</label>
                <input id="edit-displayName" type="text" [(ngModel)]="editForm.displayName" name="editDisplayName"
                    required />
            </div>

            <div class="form-row checkbox-row">
                <label>
                    <input type="checkbox" [(ngModel)]="editForm.isActive" name="editIsActive" />
                    Đang kích hoạt
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" [disabled]="loadingMethods()">Lưu thay đổi</button>
                <button type="button" (click)="onCancelEdit()">Hủy</button>
            </div>
        </form>
    </section>

    <!-- Danh sách phương thức -->
    <section *ngIf="!loadingMethods() && list().length; else emptyState" class="methods-list">
        <h2>Danh Sách Phương Thức ({{ list().length }})</h2>
        <div class="method-cards">
            <div *ngFor="let method of list()" class="method-card" [class.is-default]="method.isDefault"
                [class.inactive]="!method.isActive">
                <!-- Thẻ mặc định -->
                <span *ngIf="method.isDefault" class="default-badge">Mặc định</span>

                <div class="method-card-header">
                    <span class="method-icon">{{ getMethodIcon(method.type) }}</span>
                    <div class="method-info">
                        <h3 class="method-name">{{ method.displayName }}</h3>
                        <span class="method-type">{{ getMethodLabel(method.type) }}</span>
                    </div>
                    <span class="method-status" [class]="method.isActive ? 'active' : 'inactive'">
                        {{ method.isActive ? 'Kích hoạt' : 'Vô hiệu' }}
                    </span>
                </div>

                <div class="method-card-meta">
                    <span>Tạo: {{ method.createdAt | date:'mediumDate' }}</span>
                    <span *ngIf="method.updatedAt !== method.createdAt">
                        Sửa: {{ method.updatedAt | date:'mediumDate' }}
                    </span>
                </div>

                <!-- Hành động -->
                <div class="method-actions">
                    <button *ngIf="!method.isDefault" (click)="onSetDefault(method.id)" [disabled]="loadingMethods()">
                        Đặt mặc định
                    </button>
                    <button (click)="onEditMethod(method)">Chỉnh sửa</button>
                    <button class="toggle-btn" (click)="onToggleActive(method)" [disabled]="loadingMethods()">
                        {{ method.isActive ? 'Vô hiệu hóa' : 'Kích hoạt' }}
                    </button>
                    <button class="delete-btn" (click)="onDeleteMethod(method.id, method.displayName)"
                        [disabled]="loadingMethods()">
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Trạng thái rỗng -->
    <ng-template #emptyState>
        <div class="empty-state">
            <p>Chưa có phương thức thanh toán nào.</p>
            <button class="add-btn" (click)="onOpenCreateForm()">+ Thêm phương thức đầu tiên</button>
        </div>
    </ng-template>

    <!-- Xác nhận xóa -->
    <div *ngIf="deletingId" class="confirm-overlay">
        <div class="confirm-dialog">
            <h3>Xác Nhận Xóa</h3>
            <p>Bạn có chắc muốn xóa phương thức "<strong>{{ deletingName }}</strong>"?</p>
            <p class="warning-text">Hành động này không thể hoàn tác.</p>
            <div class="confirm-actions">
                <button class="delete-btn" (click)="onConfirmDelete()">Xóa</button>
                <button (click)="onCancelDelete()">Hủy</button>
            </div>
        </div>
    </div>
</div>
`,
styles: [`
