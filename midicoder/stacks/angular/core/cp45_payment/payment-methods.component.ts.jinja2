export class PaymentMethodsComponent {
/* ---------------------------------------------------------------
* Store
* --------------------------------------------------------------- */

private readonly store = inject(PaymentStore);

/** Danh sách phương thức */
readonly list = this.store.list;

/** Đang tải */
readonly loadingMethods = this.store.methods;

/** Lỗi */
readonly error = this.store.currentError;

/* ---------------------------------------------------------------
* Local state — form
* --------------------------------------------------------------- */

/** Đang mở form tạo mới hay không */
isCreating = (): boolean => this._isCreating;
private _isCreating = false;

/** Form dữ liệu tạo mới */
newForm: Omit<CreatePaymentMethodDto, 'metadata'> & { metadataJson: string } = {
    type: PaymentMethodType.CARD,
    displayName: '',
    metadataJson: '',
    };

    /** Phương thức đang chỉnh sửa */
    editingMethod: PaymentMethod | null = null;

    /** Form dữ liệu chỉnh sửa */
    editForm: UpdatePaymentMethodDto & { displayName: string; isActive: boolean } = {
    displayName: '',
    isActive: true,
    };

    /** ID và tên đang chờ xác nhận xóa */
    deletingId: string | null = null;
    deletingName = '';

    /** Các tùy chọn enum cho loại phương thức */
    methodTypeOptions: { value: PaymentMethodType; label: string }[] = [
    { value: PaymentMethodType.CARD, label: 'Thẻ tín dụng / ghi nợ' },
    { value: PaymentMethodType.BANK_TRANSFER, label: 'Chuyển khoản ngân hàng' },
    { value: PaymentMethodType.E_WALLET, label: 'Ví điện tử' },
    { value: PaymentMethodType.COD, label: 'Thanh toán khi nhận hàng' },
    { value: PaymentMethodType.QR_CODE, label: 'Mã QR' },
    { value: PaymentMethodType.VOUCHER, label: 'Mã giảm giá / voucher' },
    ];

    /* ---------------------------------------------------------------
    * Methods — Form tạo mới
    * --------------------------------------------------------------- */

    /** Mở form tạo mới */
    onOpenCreateForm(): void {
    this._isCreating = true;
    this.newForm = {
    type: PaymentMethodType.CARD,
    displayName: '',
    metadataJson: '',
    };
    }

    /** Hủy form tạo mới */
    onCancelCreate(): void {
    this._isCreating = false;
    }

    /** Gửi form tạo mới */
    onCreateMethod(): void {
    let metadata: Record<string, unknown> = {};
        if (this.newForm.metadataJson.trim()) {
        try {
        metadata = JSON.parse(this.newForm.metadataJson);
        } catch {
        // JSON không hợp lệ — bỏ qua, gửi metadata rỗng
        metadata = {};
        }
        }

        this.store.createPaymentMethod({
        type: this.newForm.type,
        displayName: this.newForm.displayName.trim(),
        metadata,
        });

        this._isCreating = false;
        }

        /* ---------------------------------------------------------------
        * Methods — Form chỉnh sửa
        * --------------------------------------------------------------- */

        /** Mở form chỉnh sửa cho phương thức */
        onEditMethod(method: PaymentMethod): void {
        this.editingMethod = method;
        this.editForm = {
        displayName: method.displayName,
        isActive: method.isActive,
        };
        }

        /** Hủy form chỉnh sửa */
        onCancelEdit(): void {
        this.editingMethod = null;
        }

        /** Gửi form chỉnh sửa */
        onUpdateMethod(): void {
        if (!this.editingMethod) return;

        this.store.updatePaymentMethod(this.editingMethod.id, {
        displayName: this.editForm.displayName.trim(),
        isActive: this.editForm.isActive,
        });

        this.editingMethod = null;
        }

        /* ---------------------------------------------------------------
        * Methods — Hành động CRUD
        * --------------------------------------------------------------- */

        /** Đặt phương thức làm mặc định */
        onSetDefault(id: string): void {
        this.store.setDefaultMethod(id);
        }

        /** Bật / tắt phương thức */
        onToggleActive(method: PaymentMethod): void {
        this.store.updatePaymentMethod(method.id, {
        isActive: !method.isActive,
        });
        }

        /** Mở hộp thoại xác nhận xóa */
        onDeleteMethod(id: string, name: string): void {
        this.deletingId = id;
        this.deletingName = name;
        }

        /** Xác nhận xóa */
        onConfirmDelete(): void {
        if (this.deletingId) {
        this.store.deletePaymentMethod(this.deletingId);
        }
        this.deletingId = null;
        this.deletingName = '';
        }

        /** Hủy xóa */
        onCancelDelete(): void {
        this.deletingId = null;
        this.deletingName = '';
        }

        /** Xóa lỗi */
        onClearError(): void {
        this.store.clearError();
        }

        /* ---------------------------------------------------------------
        * Methods — Tiện ích hiển thị
        * --------------------------------------------------------------- */

        /** Lấy icon cho loại phương thức */
        getMethodIcon(type: PaymentMethodType): string {
        const icons: Record<string, string> = {
            [PaymentMethodType.CARD]: '\uD83D\uDCB3',
            [PaymentMethodType.BANK_TRANSFER]: '\uD83C\uDFE6',
            [PaymentMethodType.E_WALLET]: '\uD83D\uDCB0',
            [PaymentMethodType.COD]: '\uD83D\uDCB1',
            [PaymentMethodType.QR_CODE]: '\uD83D\uDD0D',
            [PaymentMethodType.VOUCHER]: '\uD83C\uDF81',
            };
            return icons[type] ?? '\uD83D\uDCB2';
            }

            /** Lấy nhãn tiếng Việt cho loại phương thức */
            getMethodLabel(type: PaymentMethodType): string {
            const labels: Record<string, string> = {
                [PaymentMethodType.CARD]: 'Thẻ tín dụng / ghi nợ',
                [PaymentMethodType.BANK_TRANSFER]: 'Chuyển khoản ngân hàng',
                [PaymentMethodType.E_WALLET]: 'Ví điện tử',
                [PaymentMethodType.COD]: 'Thanh toán khi nhận hàng',
                [PaymentMethodType.QR_CODE]: 'Mã QR',
                [PaymentMethodType.VOUCHER]: 'Mã giảm giá / voucher',
                };
                return labels[type] ?? type;
                }
                }
                {% endraw %}