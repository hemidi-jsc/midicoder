})
export class AuditLogListComponent implements OnInit {
/** Entity type để filter (từ parent) */
@Input() defaultEntityType: string = "";

/** Tenant ID để filter (từ parent) */
@Input() defaultTenantId: string = "";

/** Số lượng entries mỗi page */
@Input() limit: number = 50;

/** Danh sách audit log entries */
entries: AuditLogEntry[] = [];

/** Tổng số entries */
total: number = 0;

/** Offset hiện tại cho pagination */
offset: number = 0;

/** Đang loading không */
loading: boolean = false;

/** Error message */
error: string = "";

/** Filter theo entity type */
filterEntityType: string = "";

/** Filter theo actor ID */
filterActorId: string = "";

/** Filter theo action */
filterAction: string = "";

constructor(
private auditLogger: AuditLoggerService,
private cdr: ChangeDetectorRef,
) {}

/**
* Lifecycle hook - init component.
*/
ngOnInit(): void {
this.filterEntityType = this.defaultEntityType;
if (this.defaultTenantId) {
this.auditLogger.setTenantId(this.defaultTenantId);
}
this.loadEntries();
}

/**
* Load audit log entries từ API.
*/
loadEntries(): void {
this.loading = true;
this.error = "";

const params: AuditQueryParams = {
limit: this.limit,
offset: this.offset,
};
if (this.filterEntityType) params.entity_type = this.filterEntityType;
if (this.filterActorId) params.actor_id = this.filterActorId;
if (this.filterAction) params.action = this.filterAction;
if (this.defaultTenantId) params.tenant_id = this.defaultTenantId;

this.auditLogger.query(params).subscribe({
next: (result) => {
this.entries = result.entries;
this.total = result.total;
this.loading = false;
this.cdr.detectChanges();
},
error: (err) => {
this.error = `Lỗi tải audit logs: ${err.message || "Không rõ lỗi"}`;
this.loading = false;
this.entries = [];
this.cdr.detectChanges();
},
});
}

/**
* Xử lý filter theo entity type.
*/
onFilterEntityType(event: Event): void {
const input = event.target as HTMLInputElement;
this.filterEntityType = input.value;
this.offset = 0;
this.loadEntries();
}

/**
* Xử lý filter theo actor ID.
*/
onFilterActorId(event: Event): void {
const input = event.target as HTMLInputElement;
this.filterActorId = input.value;
this.offset = 0;
this.loadEntries();
}

/**
* Xử lý filter theo action.
*/
onFilterAction(event: Event): void {
const select = event.target as HTMLSelectElement;
this.filterAction = select.value;
this.offset = 0;
this.loadEntries();
}

/**
* Load page trước.
*/
loadPreviousPage(): void {
if (this.offset > 0) {
this.offset -= this.limit;
this.loadEntries();
}
}

/**
* Load page sau.
*/
loadNextPage(): void {
if (this.offset + this.entries.length < this.total) { this.offset +=this.limit; this.loadEntries(); } } /** * Lấy CSS
    class cho action type. */ getActionClass(action: string): string { return `action-${action}`; } }