/**
* Audit Log List Component - CP14.
*
* Angular component hiển thị danh sách audit logs với filter và pagination.
* Cho phép lọc theo entity_type, actor_id, action.
* Hiển thị thông tin chi tiết của mỗi audit entry.
*/

import {
Component,
OnInit,
Input,
ChangeDetectorRef,
} from "@angular/core";
import { AuditLoggerService, AuditLogEntry, AuditQueryParams } from "./audit_logger_service";

@Component({
selector: "app-audit-log-list",
template: `
<div class="audit-log-list">
    <!-- Header -->
    <div class="audit-log-list__header">
        <h2 class="audit-log-list__title">Audit Logs</h2>
        <span class="audit-log-list__count">Tổng: {{ total }} entries</span>
    </div>

    <!-- Filters -->
    <div class="audit-log-list__filters">
        <input type="text" placeholder="Filter theo entity type..." [value]="filterEntityType"
            (input)="onFilterEntityType($event)" class="audit-log-list__filter-input" />
        <input type="text" placeholder="Filter theo actor ID..." [value]="filterActorId"
            (input)="onFilterActorId($event)" class="audit-log-list__filter-input" />
        <select [value]="filterAction" (change)="onFilterAction($event)" class="audit-log-list__filter-select">
            <option value="">Tất cả actions</option>
            <option value="CREATE">CREATE</option>
            <option value="UPDATE">UPDATE</option>
            <option value="DELETE">DELETE</option>
            <option value="READ">READ</option>
            <option value="LOGIN">LOGIN</option>
            <option value="LOGOUT">LOGOUT</option>
            <option value="EXPORT">EXPORT</option>
            <option value="APPROVE">APPROVE</option>
            <option value="REJECT">REJECT</option>
            <option value="CUSTOM">CUSTOM</option>
        </select>
    </div>

    <!-- Loading -->
    <div *ngIf="loading" class="audit-log-list__loading">
        Đang tải audit logs...
    </div>

    <!-- Error -->
    <div *ngIf="error" class="audit-log-list__error">
        {{ error }}
    </div>

    <!-- Audit log entries -->
    <div *ngIf="!loading && !error" class="audit-log-list__entries">
        <div *ngFor="let entry of entries" class="audit-log-list__entry"
            [class.audit-log-list__entry--valid]="entry.immutable_hash && entry.immutable_hash.length === 64"
            [class.audit-log-list__entry--invalid]="!entry.immutable_hash || entry.immutable_hash.length !== 64">
            <!-- Entry header -->
            <div class="audit-log-list__entry-header">
                <span class="audit-log-list__entry-action" [class]="getActionClass(entry.action)">
                    {{ entry.action }}
                </span>
                <span class="audit-log-list__entry-entity">
                    {{ entry.entity_type }}:{{ entry.entity_id }}
                </span>
                <span class="audit-log-list__entry-timestamp">
                    {{ entry.timestamp | date:'yyyy-MM-dd HH:mm:ss' }}
                </span>
                <span class="audit-log-list__entry-actor">
                    {{ entry.actor_type }}: {{ entry.actor_id }}
                </span>
            </div>

            <!-- Entry details -->
            <div class="audit-log-list__entry-details">
                <div *ngIf="entry.old_values && Object.keys(entry.old_values).length > 0"
                    class="audit-log-list__entry-values">
                    <strong>Giá trị cũ:</strong>
                    <pre>{{ entry.old_values | json }}</pre>
                </div>
                <div *ngIf="entry.new_values && Object.keys(entry.new_values).length > 0"
                    class="audit-log-list__entry-values">
                    <strong>Giá trị mới:</strong>
                    <pre>{{ entry.new_values | json }}</pre>
                </div>
                <div *ngIf="entry.metadata && Object.keys(entry.metadata).length > 0"
                    class="audit-log-list__entry-metadata">
                    <strong>Metadata:</strong>
                    <pre>{{ entry.metadata | json }}</pre>
                </div>
            </div>

            <!-- Hash verification -->
            <div class="audit-log-list__entry-hash">
                <span class="audit-log-list__entry-hash-label">Hash:</span>
                <span class="audit-log-list__entry-hash-value">{{ entry.immutable_hash }}</span>
            </div>
        </div>

        <!-- Empty state -->
        <div *ngIf="entries.length === 0" class="audit-log-list__empty">
            Không có audit logs nào.
        </div>
    </div>

    <!-- Pagination -->
    <div *ngIf="!loading && !error && total > limit" class="audit-log-list__pagination">
        <button (click)="loadPreviousPage()" [disabled]="offset === 0" class="audit-log-list__pagination-btn">
            ← Trước
        </button>
        <span class="audit-log-list__pagination-info">
            {{ offset + 1 }}-{{ offset + entries.length }} / {{ total }}
        </span>
        <button (click)="loadNextPage()" [disabled]="offset + entries.length >= total"
            class="audit-log-list__pagination-btn">
            Sau →
        </button>
    </div>
</div>
`,
styles: [`
