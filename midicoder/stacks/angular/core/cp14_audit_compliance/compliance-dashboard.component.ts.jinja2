/**
* Compliance Dashboard Component — CP14: Audit Trail & Compliance
*
* Angular component: compliance status cards (GDPR/HIPAA/SOX/PCI),
* audit log viewer, tamper detection alerts.
*/

import { Component, OnInit } from '@angular/core';
import { HttpClient } from '@angular/common/http';

export type ComplianceStatus = 'compliant' | 'non-compliant' | 'partial' | 'not-assessed';

export interface ComplianceStandard {
id: string; name: string; status: ComplianceStatus;
lastAssessed: string; controlsCount: number; controlsPassed: number; violationsCount: number;
}

export interface TamperAlert {
id: string; timestamp: string; entityType: string; entityId: string;
description: string; severity: 'low' | 'medium' | 'high' | 'critical';
}

@Component({
selector: 'app-compliance-dashboard',
template: `{% raw %}
<div class="cd">
    <h2 class="cd-title">Bảng Điều Khiển Tuân Thủ</h2>

    <!-- Status Cards -->
    <section class="cd-section">
        <h3>Tình Trạng Tuân Thủ</h3>
        <div class="cd-cards">
            <div *ngFor="let s of standards" class="cd-card" [class]="s.status">
                <div class="cd-card-h">
                    <span class="cd-icon">{{ s.id | wfIcon }}</span>
                    <span class="cd-name">{{ s.name }}</span>
                    <span class="cd-badge" [class]="s.status">{{ s.status | wfLabel }}</span>
                </div>
                <div class="cd-prog">
                    <div class="cd-bar" [style.width.%]="(s.controlsPassed / s.controlsCount * 100)"></div>
                </div>
                <div class="cd-stats">
                    <span>Đạt: {{ s.controlsPassed }}/{{ s.controlsCount }}</span>
                    <span>Violations: {{ s.violationsCount }}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Tamper Alerts -->
    <section class="cd-section">
        <h3>Cảnh Báo Phát Hiện Thay Đổi</h3>
        <div *ngIf="!alerts.length" class="cd-ok">Không có cảnh báo. Ledger đang toàn vẹn.</div>
        <div *ngFor="let a of alerts" class="cd-alert" [class]="a.severity">
            <span class="cd-sev">{{ a.severity | uppercase }}</span>
            <span class="cd-desc">{{ a.description }}</span>
            <span class="cd-time">{{ a.timestamp | date:'medium' }}</span>
        </div>
    </section>

    <!-- Recent Audit Logs -->
    <section class="cd-section">
        <h3>Audit Logs Gần Đây</h3>
        <div *ngIf="loading">Đang tải...</div>
        <table *ngIf="!loading && logs.length" class="cd-table">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Actor</th>
                    <th>Hash</th>
                </tr>
            </thead>
            <tbody>
                <tr *ngFor="let l of logs">
                    <td>{{ l.timestamp | date:'medium' }}</td>
                    <td><span class="cd-action">{{ l.action }}</span></td>
                    <td>{{ l.entityType }}:{{ l.entityId }}</td>
                    <td>{{ l.actorId }}</td>
                    <td class="cd-hash">{{ (l.hash || '') | slice:0:16 }}...</td>
                </tr>
            </tbody>
        </table>
        <div *ngIf="!loading && !logs.length">Không có audit logs.</div>
    </section>
</div>
{% endraw %}`,
styles: [`
.cd { font-family: system-ui, sans-serif; padding: 24px; max-width: 1200px; }
.cd-title { margin: 0 0 24px; font-size: 1.5rem; }
.cd-section { margin-bottom: 32px; }
.cd-section h3 { margin: 0 0 16px; font-size: 1.1rem; color: #333; }
.cd-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
.cd-card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; }
.cd-card.compliant { border-left: 4px solid #4caf50; }
.cd-card.non-compliant { border-left: 4px solid #f44336; }
.cd-card.partial { border-left: 4px solid #ff9800; }
.cd-card.not-assessed { border-left: 4px solid #9e9e9e; }
.cd-card-h { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
.cd-icon { font-size: 1.5rem; }
.cd-name { font-weight: 600; flex: 1; }
.cd-badge { padding: 2px 8px; border-radius: 10px; font-size: 0.7rem; font-weight: 600; color: #fff; }
.cd-badge.compliant { background: #4caf50; }
.cd-badge.non-compliant { background: #f44336; }
.cd-badge.partial { background: #ff9800; }
.cd-badge.not-assessed { background: #9e9e9e; }
.cd-prog { height: 6px; background: #e0e0e0; border-radius: 3px; margin-bottom: 8px; overflow: hidden; }
.cd-bar { height: 100%; border-radius: 3px; background: #4caf50; }
.cd-stats { display: flex; justify-content: space-between; font-size: 0.85rem; color: #666; }
.cd-alert { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: 6px; margin-bottom: 8px;
font-size: 0.9rem; }
.cd-alert.critical { background: #ffebee; border-left: 4px solid #c62828; color: #c62828; }
.cd-alert.high { background: #fff3e0; border-left: 4px solid #e65100; color: #e65100; }
.cd-alert.medium { background: #fffde7; border-left: 4px solid #f9a825; color: #f57f17; }
.cd-alert.low { background: #e8f5e9; border-left: 4px solid #2e7d32; color: #2e7d32; }
.cd-sev { font-weight: 700; font-size: 0.75rem; }
.cd-desc { flex: 1; }
.cd-time { font-size: 0.8rem; color: #666; white-space: nowrap; }
.cd-ok { padding: 16px; text-align: center; color: #4caf50; font-weight: 500; }
.cd-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.cd-table th, .cd-table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid #eee; }
.cd-table th { background: #f5f5f5; }
.cd-action { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 0.75rem; font-weight: 600; color:
#fff; background: #2196f3; }
.cd-hash { font-family: monospace; font-size: 0.8rem; color: #999; }
`],
})
export class ComplianceDashboardComponent implements OnInit {
standards: ComplianceStandard[] = [];
alerts: TamperAlert[] = [];
logs: any[] = [];
loading = false;

constructor(private http: HttpClient) {}

ngOnInit(): void {
this.loading = true;
Promise.all([
this.http.get<ComplianceStandard[]>('/api/compliance/standards').toPromise(),
    this.http.get<TamperAlert[]>('/api/ledger/alerts').toPromise(),
        this.http.get<any[]>('/api/audit/logs?limit=10').toPromise(),
            ]).then(([s, a, l]) => { this.standards = s; this.alerts = a; this.logs = l; })
            .catch((e) => console.error(e)).finally(() => { this.loading = false; });
            }
            }