/**
 * State Machine Service — CP32: State Machine Engine.
 *
 * Tự động sinh bởi Midicoder CE — không sửa thủ công.
 *
 * Angular service để tương tác với state machine backend API.
 * Cung cấp các phương thức cho việc quản lý state instances
 * và thực hiện transitions.
 */

import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable, of } from 'rxjs';

/** Cấu hình state machine từ backend */
export interface StateMachineConfig {
  machineId: string;
  entityType: string;
  states: string[];
  initialState: string;
  transitions: Record<string, string[]>;
  finalStates?: string[];
}

/** Một bản ghi lịch sử transition */
export interface TransitionRecord {
  entity_id: string;
  from_state: string;
  to_state: string;
  user_id: string | null;
  timestamp: string;
  metadata: Record<string, any>;
}

/** State instance hiện tại */
export interface StateInstanceState {
  entity_id: string;
  machine_id: string;
  current_state: string;
  history: TransitionRecord[];
  created_at: string;
  updated_at: string;
}

/** Kết quả của một transition API call */
export interface TransitionResult {
  success: boolean;
  entity_id: string;
  from_state: string;
  to_state: string;
  error?: string;
}

/** Dữ liệu để tạo instance mới */
export interface CreateInstanceRequest {
  entity_id: string;
  machine_id: string;
}

/** Dữ liệu để thực hiện transition */
export interface TransitionRequest {
  to_state: string;
  user_id?: string;
}

