/**
 * Subscription Panel Component — bảng quản lý subscription.
 *
 * Tự động sinh bởi Midicoder CE — CP36: Tenant Onboarding & Subscription.
 *
 * Chức năng:
 * - Hiển thị gói hiện tại, chu kỳ thanh toán, giá, ngày thanh toán tiếp theo
 * - Nút upgrade và cancel subscription
 * - Fetch dữ liệu subscription từ OnboardingService
 * - Cleanup subscriptions trong ngOnDestroy
 */

import {
  Component,
  Input,
  OnInit,
  OnDestroy,
  ChangeDetectionStrategy,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { Subject, Subscription, Observable } from 'rxjs';
import { takeUntil } from 'rxjs/operators';
{% raw %}
/** Trạng thái subscription */
export type SubscriptionStatus = 'trial' | 'active' | 'past_due' | 'cancelled' | 'expired';

/** Chu kỳ thanh toán */
export type BillingCycle = 'monthly' | 'yearly';

/** Mô hình subscription từ API */
export interface SubscriptionData {
  tenant_id: string;
  plan: string;
  billing_cycle: BillingCycle;
  status: SubscriptionStatus;
  start_date: string;
  end_date?: string;
  price: string;
  currency: string;
  next_billing_date?: string;
}

/** Label hiển thị cho từng trạng thái subscription */
const STATUS_LABELS: Record<SubscriptionStatus, string> = {
  trial: 'Dùng Thử',
  active: 'Đang Hoạt Động',
  past_due: 'Quá Hạn Thanh Toán',
  cancelled: 'Đã Hủy',
  expired: 'Hết Hạn',
};

/** Label hiển thị cho chu kỳ thanh toán */
const BILLING_CYCLE_LABELS: Record<BillingCycle, string> = {
  monthly: 'Hàng Tháng',
  yearly: 'Hàng Năm',
};

@Component({
  selector: 'app-subscription-panel',
  standalone: true,
  imports: [CommonModule],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="subscription-panel">
      <header class="panel-header">
        <h1>Quản Lý Subscription</h1>
      </header>

      <!-- Loading state -->
      <div *ngIf="isLoading" class="loading-state">
        <p>Đang tải thông tin subscription...</p>
      </div>

      <!-- Error state -->
      <div *ngIf="errorMessage && !isLoading" class="alert alert-error">
        <span class="alert-icon">&#9888;</span>
        {{ errorMessage }}
      </div>

      <!-- Subscription details -->
      <div *ngIf="subscription && !isLoading" class="subscription-details">
        <!-- Current plan -->
        <div class="detail-card">
          <h2>Gói Hiện Tại</h2>
          <div class="plan-info">
            <span class="plan-name">{{ subscription.plan | uppercase }}</span>
            <span class="status-badge" [class]="getStatusClass(subscription.status)">
              {{ STATUS_LABELS[subscription.status] }}
            </span>
          </div>
        </div>

        <!-- Billing info -->
        <div class="detail-card">
          <h2>Thông Tin Thanh Toán</h2>
          <table class="billing-table">
            <tbody>
              <tr>
                <th>Chu kỳ thanh toán:</th>
                <td>{{ BILLING_CYCLE_LABELS[subscription.billing_cycle] }}</td>
              </tr>
              <tr>
                <th>Giá:</th>
                <td class="price">{{ formatPrice(subscription.price, subscription.currency) }}</td>
              </tr>
              <tr>
                <th>Ngày bắt đầu:</th>
                <td>{{ subscription.start_date | date:'dd/MM/yyyy' }}</td>
              </tr>
              <tr *ngIf="subscription.next_billing_date">
                <th>Ngày thanh toán tiếp theo:</th>
                <td>{{ subscription.next_billing_date | date:'dd/MM/yyyy' }}</td>
              </tr>
              <tr *ngIf="subscription.end_date">
                <th>Ngày kết thúc:</th>
                <td>{{ subscription.end_date | date:'dd/MM/yyyy' }}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Action buttons -->
        <div class="action-buttons">
          <button
            *ngIf="canUpgrade"
            (click)="onUpgrade()"
            [disabled]="isUpgrading"
            class="btn btn-upgrade"
          >
            <span *ngIf="isUpgrading">Đang xử lý...</span>
            <span *ngIf="!isUpgrading">Nâng Cấp Gói</span>
          </button>
          <button
            *ngIf="canCancel"
            (click)="onCancel()"
            [disabled]="isCancelling"
            class="btn btn-cancel"
          >
            <span *ngIf="isCancelling">Đang xử lý...</span>
            <span *ngIf="!isCancelling">Hủy Subscription</span>
          </button>
        </div>

        <!-- Confirmation dialog -->
        <div *ngIf="showCancelConfirm" class="confirm-dialog">
          <div class="dialog-overlay" (click)="closeCancelConfirm()"></div>
          <div class="dialog-content">
            <h3>Xác Nhận Hủy Subscription</h3>
            <p>Bạn có chắc chắn muốn hủy subscription?</p>
            <p class="warning">Gói của bạn sẽ hết hạn vào {{ subscription.end_date | date:'dd/MM/yyyy' }}</p>
            <div class="dialog-actions">
              <button (click)="confirmCancel()" class="btn btn-danger">Xác Nhận Hủy</button>
              <button (click)="closeCancelConfirm()" class="btn btn-secondary">Hủy Bỏ</button>
            </div>
          </div>
        </div>
      </div>

      <!-- No subscription -->
      <div *ngIf="!subscription && !isLoading && !errorMessage" class="empty-state">
        <p>Chưa có subscription nào. Vui lòng đăng ký gói phù hợp.</p>
      </div>
    </div>
  `,
  styles: [`
    .subscription-panel {
      max-width: 700px;
      margin: 0 auto;
      padding: 24px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .panel-header {
      margin-bottom: 24px;
    }
    .panel-header h1 {
      font-size: 24px;
      color: #1a1a1a;
      margin: 0;
    }
    .loading-state {
      text-align: center;
      padding: 48px;
      color: #888;
    }
    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .alert-error {
      background: #ffebee;
      color: #c62828;
      border: 1px solid #ef9a9a;
    }
    .alert-icon {
      font-size: 18px;
    }
    .subscription-details {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .detail-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 12px;
      padding: 20px;
    }
    .detail-card h2 {
      font-size: 16px;
      color: #333;
      margin: 0 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 1px solid #eee;
    }
    .plan-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .plan-name {
      font-size: 20px;
      font-weight: 700;
      color: #1976d2;
    }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 16px;
      font-size: 12px;
      font-weight: 600;
    }
    .status-trial {
      background: #e3f2fd;
      color: #1565c0;
    }
    .status-active {
      background: #e8f5e9;
      color: #2e7d32;
    }
    .status-past_due {
      background: #fff3e0;
      color: #e65100;
    }
    .status-cancelled {
      background: #f5f5f5;
      color: #757575;
    }
    .status-expired {
      background: #ffebee;
      color: #c62828;
    }
    .billing-table {
      width: 100%;
    }
    .billing-table th,
    .billing-table td {
      text-align: left;
      padding: 8px 0;
      border-bottom: 1px solid #f5f5f5;
    }
    .billing-table th {
      color: #666;
      font-weight: 500;
      width: 50%;
    }
    .billing-table td {
      color: #333;
      font-weight: 600;
    }
    .price {
      color: #1976d2 !important;
      font-size: 16px;
    }
    .action-buttons {
      display: flex;
      gap: 12px;
      margin-top: 8px;
    }
    .btn {
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
