      border: 1px solid #c62828;
    }
    .btn-cancel:hover:not(:disabled) {
      background: #ffebee;
    }
    .btn-danger {
      background: #c62828;
      color: white;
    }
    .btn-secondary {
      background: #f5f5f5;
      color: #333;
    }
    .confirm-dialog {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dialog-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
    }
    .dialog-content {
      position: relative;
      background: white;
      border-radius: 12px;
      padding: 24px;
      max-width: 400px;
      width: 90%;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }
    .dialog-content h3 {
      margin: 0 0 12px 0;
      color: #333;
    }
    .dialog-content p {
      margin: 8px 0;
      color: #555;
    }
    .warning {
      color: #c62828 !important;
      font-size: 13px;
    }
    .dialog-actions {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      justify-content: flex-end;
    }
    .empty-state {
      text-align: center;
      padding: 48px;
      color: #888;
      background: #f5f5f5;
      border-radius: 12px;
    }
  `],
})
export class SubscriptionPanelComponent implements OnInit, OnDestroy {
  /** Tenant ID để fetch subscription data */
  @Input() tenantId: string = '';

  /** Dữ liệu subscription hiện tại */
  subscription: SubscriptionData | null = null;

  /** Trạng thái đang tải */
  isLoading: boolean = false;

  /** Thông báo lỗi */
  errorMessage: string = '';

  /** Đang xử lý upgrade */
  isUpgrading: boolean = false;

  /** Đang xử lý cancel */
  isCancelling: boolean = false;

  /** Hiển thị dialog xác nhận cancel */
  showCancelConfirm: boolean = false;

  /** Subject để cleanup subscriptions khi component bị phá hủy */
  private destroy$ = new Subject<void>();

  /** Subscription cho getSubscription */
  private fetchSubscription: Subscription | null = null;

  /** Có thể upgrade không (tùy thuộc vào trạng thái hiện tại) */
  get canUpgrade(): boolean {
    if (!this.subscription) return false;
    return this.subscription.status === 'active' || this.subscription.status === 'trial';
  }

  /** Có thể cancel không (chỉ khi active hoặc past_due) */
  get canCancel(): boolean {
    if (!this.subscription) return false;
    return this.subscription.status === 'active' || this.subscription.status === 'past_due';
  }

  constructor(private onboardingService: any) {}

  ngOnInit(): void {
    // Fetch subscription data khi component được khởi tạo
    this.loadSubscription();
  }

  ngOnDestroy(): void {
    // Cleanup: hủy subject và tất cả subscriptions để tránh memory leak
    this.destroy$.next();
    this.destroy$.complete();
    if (this.fetchSubscription) {
      this.fetchSubscription.unsubscribe();
    }
  }

  /** Tải thông tin subscription từ API */
  private loadSubscription(): void {
    if (!this.tenantId) {
      this.errorMessage = 'Thiếu tenant ID';
      return;
    }

    this.isLoading = true;
    this.errorMessage = '';

    // Hủy subscription cũ nếu có
    if (this.fetchSubscription) {
      this.fetchSubscription.unsubscribe();
    }

    this.fetchSubscription = this.onboardingService
      .getSubscription(this.tenantId)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (data: SubscriptionData) => {
          this.isLoading = false;
          this.subscription = data;
        },
        error: (error) => {
          this.isLoading = false;
          if (error.status === 404) {
            this.errorMessage = 'Không tìm thấy subscription cho tenant này';
          } else {
            this.errorMessage = 'Không thể tải thông tin subscription';
          }
        },
      });
  }

  /** Xử lý nút upgrade */
  onUpgrade(): void {
    // TODO: điều hướng đến trang chọn gói nâng cấp
    this.isUpgrading = true;
    // Hiện tại chỉ placeholder, có thể mở modal hoặc navigate
    console.log('[SubscriptionPanel] Upgrade được yêu cầu cho tenant:', this.tenantId);
    this.isUpgrading = false;
  }

  /** Xử lý nút cancel — mở dialog xác nhận */
  onCancel(): void {
    this.showCancelConfirm = true;
  }

  /** Đóng dialog xác nhận cancel */
  closeCancelConfirm(): void {
    this.showCancelConfirm = false;
  }

  /** Xác nhận cancel subscription */
  confirmCancel(): void {
    if (!this.subscription) return;

    this.isCancelling = true;
    this.showCancelConfirm = false;

    this.onboardingService
      .cancelSubscription(this.tenantId)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: () => {
          this.isCancelling = false;
          // Reload subscription data sau khi cancel thành công
          this.loadSubscription();
        },
        error: (error) => {
          this.isCancelling = false;
          this.errorMessage = 'Không thể hủy subscription, vui lòng thử lại';
        },
      });
  }

  /** Lấy CSS class cho status badge */
  getStatusClass(status: SubscriptionStatus): string {
    return `status-${status}`;
  }

  /** Format giá tiền với currency */
  formatPrice(price: string, currency: string): string {
    const numericPrice = parseFloat(price);
    return new Intl.NumberFormat('vi-VN', {
      style: 'currency',
      currency: currency,
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(numericPrice);
  }
}
