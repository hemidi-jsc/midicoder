export class RegistrationFormComponent implements OnInit, OnDestroy {
/** Danh sách plan nhận từ parent qua @Input */
@Input() plans: PlanPricing[] = PLANS_DATA;

/** Form đăng ký với Reactive Forms */
registrationForm: FormGroup;

/** Subject để cleanup subscriptions khi component bị phá hủy */
private destroy$ = new Subject<void>();

    /** Subscription để hủy đăng ký trong ngOnDestroy */
    private submitSubscription: Subscription | null = null;

    /** Trạng thái đang tải */
    isLoading: boolean = false;

    /** Thông báo lỗi */
    errorMessage: string = '';

    /** Đăng ký thành công */
    registrationSuccess: boolean = false;

    /** Plan được chọn */
    selectedPlan: string = '';

    /** Tenant ID trả về sau khi đăng ký */
    tenantId: string = '';

    /** Email đã submit */
    submittedEmail: string = '';

    constructor(
    private fb: FormBuilder,
    private onboardingService: any
    ) {
    // Khởi tạo form với Validators
    this.registrationForm = this.fb.group({
    email: new FormControl('', [
    Validators.required,
    Validators.email,
    ]),
    companyName: new FormControl('', [
    Validators.required,
    Validators.minLength(2),
    ]),
    plan: new FormControl('', [Validators.required]),
    });
    }

    ngOnInit(): void {
    // Chọn plan đầu tiên mặc định nếu có
    if (this.plans.length > 0) {
    this.selectPlan(this.plans[0].plan);
    }
    }

    ngOnDestroy(): void {
    // Cleanup: hủy subject và subscription để tránh memory leak
    this.destroy$.next();
    this.destroy$.complete();
    if (this.submitSubscription) {
    this.submitSubscription.unsubscribe();
    }
    }

    /** Getter cho các form control để dùng trong template */
    get email() {
    return this.registrationForm.get('email');
    }

    get companyName() {
    return this.registrationForm.get('companyName');
    }

    get form() {
    return this.registrationForm;
    }

    /** Chọn plan và cập nhật form control */
    selectPlan(plan: string): void {
    this.selectedPlan = plan;
    this.registrationForm.patchValue({ plan });
    }

    /** Xử lý submit form đăng ký */
    onSubmit(): void {
    // Ngăn submit nếu form không hợp lệ
    if (this.registrationForm.invalid) {
    // Đánh dấu tất cả controls để hiển thị lỗi
    this.registrationForm.markAllAsTouched();
    this.errorMessage = 'Vui lòng điền đầy đủ thông tin và chọn một gói';
    return;
    }

    this.isLoading = true;
    this.errorMessage = '';

    const formData = this.registrationForm.value;

    // Gọi API đăng ký tenant
    this.submitSubscription = this.onboardingService
    .register({
    email: formData.email,
    company_name: formData.companyName,
    plan: formData.plan,
    trial_days: {{ default_trial_days }},
    })
    .pipe(takeUntil(this.destroy$))
    .subscribe({
    next: (response: RegistrationResponse) => {
    this.isLoading = false;
    this.registrationSuccess = true;
    this.tenantId = response.tenant_id;
    this.submittedEmail = response.email;
    },
    error: (error) => {
    this.isLoading = false;
    if (error.status === 409) {
    this.errorMessage = 'Email này đã được đăng ký';
    } else if (error.status === 400) {
    this.errorMessage = error.message || 'Thông tin đăng ký không hợp lệ';
    } else {
    this.errorMessage = 'Đăng ký thất bại, vui lòng thử lại sau';
    }
    },
    });
    }
    }
