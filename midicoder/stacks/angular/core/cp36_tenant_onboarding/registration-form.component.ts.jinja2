/** Mô hình plan pricing — cấu hình gói đăng ký */
export interface PlanPricing {
plan: string;
label: string;
monthly_price: string;
yearly_price: string;
features: string[];
max_users: number;
max_storage_gb: number;
}

/** Response từ API đăng ký */
export interface RegistrationResponse {
tenant_id: string;
email: string;
company_name: string;
status: string;
verification_token?: string;
}

/** Dữ liệu plan từ server */
const PLANS_DATA: PlanPricing[] = [
{% endraw %}
{% for plan in plans %}
{
plan: '{{ plan.plan }}',
label: '{{ plan.label }}',
monthly_price: '{{ plan.monthly_price }}',
yearly_price: '{{ plan.yearly_price }}',
features: {{ plan.features | tojson }},
max_users: {{ plan.max_users }},
max_storage_gb: {{ plan.max_storage_gb }},
},
{% endfor %}
{% raw %}
];

@Component({
selector: 'app-registration-form',
standalone: true,
imports: [
CommonModule,
ReactiveFormsModule,
{% if ui_framework == "material" %}
MatButtonModule,
MatFormFieldModule,
MatInputModule,
MatSelectModule,
MatCardModule,
MatSnackBarModule,
MatProgressBarModule,
{% elif ui_framework == "antd" %}
NzFormModule,
NzInputModule,
NzSelectModule,
NzCardModule,
{% elif ui_framework == "carbon" %}
{% endif %}
],
changeDetection: ChangeDetectionStrategy.OnPush,
template: `
<div class="registration-form">
    <header class="form-header">
        <h1>Đăng Ký Tenant</h1>
        <p class="subtitle">Tạo tài khoản công ty mới và chọn gói phù hợp</p>
    </header>

    <!-- Thông báo lỗi tổng -->
    <div *ngIf="errorMessage" class="alert alert-error">
        <span class="alert-icon">&#9888;</span>
        {{ errorMessage }}
    </div>

    <!-- Thông báo thành công -->
    <div *ngIf="registrationSuccess" class="alert alert-success">
        <span class="alert-icon">&#10004;</span>
        Đăng ký thành công! Vui lòng kiểm tra email để xác minh tài khoản.
    </div>

    <!-- Form đăng ký -->
    <form [formGroup]="registrationForm" (ngSubmit)="onSubmit()" *ngIf="!registrationSuccess">
        <!-- Email -->
        <div class="form-group">
            <label for="email">Email <span class="required">*</span></label>
            <input id="email" type="email" formControlName="email" placeholder="example@company.com"
                [class.ng-invalid]="email?.invalid && email?.touched" />
            <div *ngIf="email?.invalid && email?.touched" class="field-error">
                <span *ngIf="email?.errors?.['required']">Email là bắt buộc</span>
                <span *ngIf="email?.errors?.['email']">Email không hợp lệ</span>
            </div>
        </div>

        <!-- Tên công ty -->
        <div class="form-group">
            <label for="companyName">Tên Công Ty <span class="required">*</span></label>
            <input id="companyName" type="text" formControlName="companyName" placeholder="Nhập tên công ty của bạn"
                [class.ng-invalid]="companyName?.invalid && companyName?.touched" />
            <div *ngIf="companyName?.invalid && companyName?.touched" class="field-error">
                <span *ngIf="companyName?.errors?.['required']">Tên công ty là bắt buộc</span>
                <span *ngIf="companyName?.errors?.['minlength']">Tên công ty phải có ít nhất 2 ký tự</span>
            </div>
        </div>

        <!-- Chọn gói -->
        <div class="form-group">
            <label>Chọn Gói <span class="required">*</span></label>
            <div class="plan-cards">
                <div *ngFor="let plan of plans" class="plan-card" [class.selected]="selectedPlan === plan.plan"
                    (click)="selectPlan(plan.plan)">
                    <div class="plan-header">
                        <h3>{{ plan.label }}</h3>
                        <span class="plan-price">
                            ${{ plan.monthly_price }}/{{ 'tháng' }}
                        </span>
                    </div>
                    <ul class="plan-features">
                        <li *ngFor="let feature of plan.features">{{ feature }}</li>
                        <li>Người dùng: tối đa {{ plan.max_users }}</li>
                        <li>Storage: {{ plan.max_storage_gb }} GB</li>
                    </ul>
                    <input type="radio" name="plan" [value]="plan.plan" [checked]="selectedPlan === plan.plan"
                        class="plan-radio" />
                </div>
            </div>
            <div *ngIf="form.get('plan')?.invalid && form.get('plan')?.touched" class="field-error">
                Vui lòng chọn một gói
            </div>
        </div>

        <!-- Nút submit -->
        <div class="form-actions">
            <button type="submit" [disabled]="registrationForm.invalid || isLoading" class="submit-btn">
                <span *ngIf="isLoading">Đang đăng ký...</span>
                <span *ngIf="!isLoading">Đăng Ký Ngay</span>
            </button>
        </div>
    </form>

    <!-- Hiển thị sau khi đăng ký thành công -->
    <div *ngIf="registrationSuccess" class="success-message">
        <p>Tenant ID: <strong>{{ tenantId }}</strong></p>
        <p>Chúng tôi đã gửi email xác minh đến <strong>{{ submittedEmail }}</strong></p>
    </div>
</div>
`,
