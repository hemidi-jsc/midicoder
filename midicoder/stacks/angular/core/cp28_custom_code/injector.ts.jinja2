/**
 * CustomCodeInjector — Dịch vụ tiêm mã tùy chỉnh vào các khối code.
 *
 * Cung cấp phương thức inject() để chèn code vào một khối hiện có
 * theo vị trí được chỉ định (top, bottom, replace).
 *
 * @see {{ stack_config.project_name }}/docs/custom-code-injection.md
 */
import { Injectable } from '@angular/core';
import { Logger } from '@angular/core';

@Injectable({ providedIn: 'root' })
export class CustomCodeInjector {
  constructor(private logger: Logger) {}

  /**
   * Tiêm mã tùy chỉnh vào một khối code theo vị trí được chỉ định.
   *
   * @param content — Nội dung code gốc
   * @param blockCode — Mã tùy chỉnh cần tiêm
   * @param position — Vị trí tiêm: 'top' | 'bottom' | 'replace'
   * @returns Kết quả: { success, output, error }
   */
  inject(
    content: string,
    blockCode: string,
    position: 'top' | 'bottom' | 'replace'
  ): { success: boolean; output: string; error?: string } {
    try {
      const wrapped = this._wrapSandbox(blockCode);

      let output: string;
      switch (position) {
        case 'top':
          output = `${wrapped}\n\n${content}`;
          break;
        case 'bottom':
          output = `${content}\n\n${wrapped}`;
          break;
        case 'replace':
          output = wrapped;
          break;
        default:
          throw new Error(`Vị trí tiêm không hợp lệ: ${position}`);
      }

      this.logger.debug(`[CustomCodeInjector] Tiêm thành công ở vị trí "${position}"`);
      return { success: true, output };
    } catch (e: any) {
      const errMsg = `CustomCodeInjector.inject: ${e.message}`;
      this.logger.error(errMsg);
      return { success: false, output: content, error: errMsg };
    }
  }

  /**
   * Đưa đoạn code vào môi trường an toàn với try-catch.
   *
   * @param code — Mã thô cần bao bọc
   * @returns Mã đã bao bọc trong try-catch
   */
  private _wrapSandbox(code: string): string {
    return `try {
${code}
} catch (e) {
  console.error('[CustomCodeInjector] Lỗi trong code tùy chỉnh:', e);
}`;
  }
}
