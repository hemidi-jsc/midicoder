/**
 * CustomCodeRegistry — Dịch vụ quản lý toàn bộ mã tùy chỉnh.
 *
 * Tập hợp và cung cấp truy cập thống nhất vào các khối code,
 * hooks, và quy tắc vá. Đây là điểm vào chính cho CP28.
 *
 * @see {{ stack_config.project_name }}/docs/custom-code-injection.md
 */
import { Injectable } from '@angular/core';
import { Logger } from '@angular/core';
import { CodeBlock, CODE_BLOCKS } from './blocks';
import { Hook, HOOK_REGISTRY, registerHook } from './hooks';
import { PatchRule, PATCH_RULES } from './patches';

@Injectable({ providedIn: 'root' })
export class CustomCodeRegistry {
  private blocks: CodeBlock[] = [];
  private patches: PatchRule[] = [];

  constructor(private logger: Logger) {}

  /**
   * Khởi tạo registry từ các danh sách mặc định.
   */
  initialize(): void {
    this.blocks = [...CODE_BLOCKS];
    this.patches = [...PATCH_RULES];
    this.logger.info(
      `[CustomCodeRegistry] Khởi tạo: ${this.blocks.length} blocks, ` +
      `${this.patches.length} patches, ${Object.keys(HOOK_REGISTRY).length} hook events`
    );
  }

  /**
   * Lấy một khối code theo định danh.
   *
   * @param id — Định danh khối code
   * @returns Khối code hoặc undefined
   */
  getBlock(id: string): CodeBlock | undefined {
    return this.blocks.find((b) => b.id === id);
  }

  /**
   * Lấy tất cả hooks cho một sự kiện cụ thể.
   *
   * @param event — Tên sự kiện
   * @returns Mảng hooks hoặc mảng rỗng
   */
  getHooksForEvent(event: string): Hook[] {
    return HOOK_REGISTRY[event] || [];
  }

  /**
   * Lấy quy tắc vá theo định danh.
   *
   * @param id — Định danh quy tắc vá
   * @returns Quy tắc vá hoặc undefined
   */
  getPatchRule(id: string): PatchRule | undefined {
    return this.patches.find((p) => p.id === id);
  }

  /**
   * Trả về tất cả khối code.
   */
  getAllBlocks(): CodeBlock[] {
    return [...this.blocks];
  }

  /**
   * Trả về tất cả quy tắc vá đang kích hoạt.
   */
  getAllEnabledPatches(): PatchRule[] {
    return this.patches.filter((p) => p.enabled);
  }

  /**
   * Trả về thông kê tổng quan về registry.
   */
  getStats(): { blocks: number; enabledPatches: number; hookEvents: number; totalHooks: number } {
    const totalHooks = Object.values(HOOK_REGISTRY).reduce(
      (sum, arr) => sum + arr.length,
      0
    );
    return {
      blocks: this.blocks.length,
      enabledPatches: this.patches.filter((p) => p.enabled).length,
      hookEvents: Object.keys(HOOK_REGISTRY).length,
      totalHooks,
    };
  }
}

/**
 * Đơn lẻ toàn cục — sử dụng để truy cập nhanh ngoài dependency injection.
 */
export const registry = new CustomCodeRegistry(new (class {
  debug(_m: any) {}
  info(_m: any) {}
  warn(_m: any) {}
  error(_m: any) {}
})() as unknown as Logger);
