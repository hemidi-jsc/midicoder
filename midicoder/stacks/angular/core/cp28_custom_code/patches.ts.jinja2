/**
 * PatchRule — Giao diện và PatchEngine service cho việc vá nội dung code.
 *
 * PatchEngine cho phép thay thế các đoạn code theo mẫu regex
 * một cách an toàn và có kiểm soát.
 *
 * @see {{ stack_config.project_name }}/docs/custom-code-injection.md
 */
import { Injectable } from '@angular/core';
import { Logger } from '@angular/core';

/**
 * Quy tắc vá: định nghĩa mẫu tìm kiếm và nội dung thay thế.
 */
export interface PatchRule {
  /** Định danh duy nhất của quy tắc */
  id: string;
  /** Mẫu regex để tìm đoạn code cần vá */
  targetPattern: string;
  /** Nội dung thay thế (có thể chứa backreferences) */
  replacement: string;
  /** Quy tắc có được kích hoạt hay không */
  enabled: boolean;
  /** Metadata bổ sung */
  metadata?: Record<string, any>;
}

/**
 * Danh sách các quy tắc vá mặc định.
 */
export const PATCH_RULES: PatchRule[] = [
  // Ví dụ:
  // {
  //   id: 'remove-deprecated-call',
  //   targetPattern: 'deprecatedFunction\\(\\)',
  //   replacement: 'newFunction()',
  //   enabled: true,
  //   metadata: { reason: 'API migration v2' }
  // },
];

@Injectable({ providedIn: 'root' })
export class PatchEngine {
  constructor(private logger: Logger) {}

  /**
   * Áp dụng các quy tắc vá vào nội dung code.
   *
   * @param content — Nội dung code gốc
   * @param rules — Danh sách quy tắc; mặc định dùng PATCH_RULES
   * @returns Kết quả: { success, output, applied, error }
   */
  apply(
    content: string,
    rules: PatchRule[] = PATCH_RULES
  ): { success: boolean; output: string; applied: string[]; error?: string } {
    try {
      let output = content;
      const applied: string[] = [];

      const enabledRules = rules.filter((r) => r.enabled);

      for (const rule of enabledRules) {
        try {
          const regex = new RegExp(rule.targetPattern, 'g');
          const hasMatch = regex.test(output);

          if (hasMatch) {
            output = output.replace(regex, rule.replacement);
            applied.push(rule.id);
            this.logger.debug(`[PatchEngine] Đã áp dụng patch "${rule.id}"`);
          }
        } catch (e: any) {
          this.logger.warn(`[PatchEngine] Bỏ qua patch "${rule.id}": ${e.message}`);
        }
      }

      return { success: true, output, applied };
    } catch (e: any) {
      const errMsg = `PatchEngine.apply: ${e.message}`;
      this.logger.error(errMsg);
      return { success: false, output: content, applied: [], error: errMsg };
    }
  }
}
