/**
* LiveFeedComponent — hiển thị realtime event feed (activity stream)
* Sinh bởi CP22 AngularRealtimeEmitter
*/

import { Component, Input, OnInit, AfterViewChecked, ViewChild, ElementRef } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ChannelSubscriptionService, MessagePayload } from './channel-subscription.service';

{% if ui_framework == "material" %}
import { MatListModule } from '@angular/material/list';
import { MatCardModule } from '@angular/material/card';
import { MatChipsModule } from '@angular/material/chips';
{% elif ui_framework == "bootstrap" %}
import { NgbdModule } from 'ng-bootstrap';
{% elif ui_framework == "antd" %}
import { NzListModule } from 'ng-zorro-antd/list';
import { NzTagModule } from 'ng-zorro-antd/tag';
{% elif ui_framework == "carbon" %}
import { DataTableModule } from '@carbon/angular';
{% endif %}

export interface FeedItem {
id: string;
channel: string;
data: unknown;
timestamp: string;
}

@Component({
selector: 'midicoder-live-feed',
standalone: true,
imports: [
CommonModule,
{% if ui_framework == "material" %}
MatListModule,
MatCardModule,
MatChipsModule,
{% elif ui_framework == "bootstrap" %}
NgbdModule,
{% elif ui_framework == "antd" %}
NzListModule,
NzTagModule,
{% elif ui_framework == "carbon" %}
DataTableModule,
{% endif %}
],
template: `
{% if ui_framework == "material" %}
<mat-card class="midicoder-live-feed">
    <div class="header" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
        <span>
            Live Feed
            <mat-chip [color]="isConnected ? 'primary' : 'warn'" style="margin-left: 8px;"></mat-chip>
        </span>
        <span>{{ items.length }} items</span>
        <button mat-button (click)="clearFeed()">Clear</button>
    </div>
    <div #scrollRef style="max-height: 400px; overflow-y: auto;">
        <div *ngIf="items.length === 0" style="text-align: center; color: #999; padding: 20px;">
            Chờ event...
        </div>
        <mat-list>
            <mat-list-item *ngFor="let item of items">
                <div matListItemTitle>
                    <mat-chip>{{ item.channel }}</mat-chip>
                    {{ item.data | json }}
                </div>
                <div matListItemLine>
                    {{ item.timestamp | date:'HH:mm:ss' }}
                </div>
            </mat-list-item>
        </mat-list>
    </div>
</mat-card>
{% elif ui_framework == "tailwind" %}
<div class="midicoder-live-feed">
    <div class="flex justify-between items-center mb-2 p-2">
        <span class="font-medium">
            Live Feed
            <span
                [class]="isConnected ? 'ml-2 inline-block w-2 h-2 rounded-full bg-green-500' : 'ml-2 inline-block w-2 h-2 rounded-full bg-red-500'"
                [title]="isConnected ? 'Connected' : 'Disconnected'"></span>
        </span>
        <span class="text-gray-500 text-sm">{{ items.length }} items</span>
        <button class="text-blue-500 hover:text-blue-700" (click)="clearFeed()">Clear</button>
    </div>
    <div #scrollRef class="max-h-[400px] overflow-y-auto border border-gray-200 rounded p-2">
        <div *ngIf="items.length === 0" class="text-center text-gray-400 py-5">
            Chờ event...
        </div>
        <div *ngFor="let item of items" class="py-1 border-b border-gray-100">
            <span class="font-bold text-xs bg-blue-100 px-1 rounded">{{ item.channel }}</span>&nbsp;
            <span class="text-sm">{{ item.data | json }}</span>
            <span class="text-xs text-gray-400 ml-2">{{ item.timestamp | date:'HH:mm:ss' }}</span>
        </div>
    </div>
</div>
{% elif ui_framework == "bootstrap" %}
<div class="midicoder-live-feed">
    <div class="d-flex justify-content-between mb-2">
        <span>
            Live Feed
            <span class="badge rounded-pill ms-2" [class]="isConnected ? 'bg-success' : 'bg-danger'"></span>
        </span>
        <small class="text-muted">{{ items.length }} items</small>
        <button class="btn btn-sm btn-link" (click)="clearFeed()">Clear</button>
    </div>
    <div #scrollRef style="max-height: 400px; overflow-y: auto;">
        <div *ngIf="items.length === 0" class="text-center text-muted py-4">
            Chờ event...
        </div>
        <div class="list-group">
            <div *ngFor="let item of items" class="list-group-item list-group-item-action">
                <span class="badge bg-info me-1">{{ item.channel }}</span>
                {{ item.data | json }}
                <small class="float-end text-muted">{{ item.timestamp | date:'HH:mm:ss' }}</small>
            </div>
        </div>
    </div>
</div>
{% elif ui_framework == "antd" %}
<div class="midicoder-live-feed">
    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
        <span>
            Live Feed
            <nz-tag [nzColor]="isConnected ? 'green' : 'red'" style="margin-left: 8px;"></nz-tag>
        </span>
        <span class="text-muted">{{ items.length }} items</span>
        <button (click)="clearFeed()">Clear</button>
    </div>
    <div #scrollRef style="max-height: 400px; overflow-y: auto;">
        <div *ngIf="items.length === 0" style="text-align: center; color: #999; padding: 20px;">
            Chờ event...
        </div>
        <nz-list [nzDataSource]="items" nzBordered>
            <ng-template nz-list-item *ngFor="let item of items">
                <nz-tag>{{ item.channel }}</nz-tag>
                {{ item.data | json }}
                <span style="font-size: 10px; color: #999; margin-left: 8px;">
                    {{ item.timestamp | date:'HH:mm:ss' }}
                </span>
            </ng-template>
        </nz-list>
    </div>
</div>
{% elif ui_framework == "carbon" %}
<div class="midicoder-live-feed">
    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
        <span>
            Live Feed
            <cds-tag [type]="isConnected ? 'green' : 'red'" style="margin-left: 8px;"></cds-tag>
        </span>
        <span style="font-size: 12px; color: #666;">{{ items.length }} items</span>
        <button (click)="clearFeed()">Clear</button>
    </div>
    <div #scrollRef style="max-height: 400px; overflow-y: auto;">
        <div *ngIf="items.length === 0" style="text-align: center; color: #999; padding: 20px;">
            Chờ event...
        </div>
        <div *ngFor="let item of items" style="padding: 4px 0; border-bottom: 1px solid #e0e0e0;">
            <cds-tag>{{ item.channel }}</cds-tag>
            {{ item.data | json }}
            <span style="font-size: 10px; color: #999; margin-left: 8px;">
                {{ item.timestamp | date:'HH:mm:ss' }}
            </span>
        </div>
    </div>
</div>
{% endif %}
`,
})
export class LiveFeedComponent implements OnInit, AfterViewChecked {
@ViewChild('scrollRef') scrollRef?: ElementRef;

@Input() channel = 'default';
@Input() maxItems = {[{ max_items or 50 }]};
@Input() autoScroll = {[{ auto_scroll | default(true) | lower }]};
{% if has_tenant_scope %}
@Input() tenantId?: string;
{% endif %}

items: FeedItem[] = [];
isConnected = false;

constructor(private channelService: ChannelSubscriptionService) {}

ngOnInit() {
this.channelService.subscribe(this.channel{% if has_tenant_scope %}, { tenantId: this.tenantId }{% endif
%}).subscribe((msg) => {
this.isConnected = true;
const data = msg.data as Record<string, unknown>;
    const item: FeedItem = {
    id: (data && 'id' in data ? String(data.id) : `evt-${Date.now()}`) as string,
    channel: msg.channel,
    data: msg.data,
    timestamp: msg.timestamp || new Date().toISOString(),
    };
    this.items = [...this.items, item].slice(-this.maxItems);
    });
    }

    ngAfterViewChecked() {
    if (this.autoScroll && this.scrollRef) {
    const el = this.scrollRef.nativeElement as HTMLElement;
    el.scrollTop = el.scrollHeight;
    }
    }

    clearFeed() {
    this.items = [];
    }
    }