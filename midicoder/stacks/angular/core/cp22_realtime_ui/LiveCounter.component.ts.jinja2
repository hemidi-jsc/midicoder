/**
 * LiveCounterComponent — hiển thị số realtime với animated transitions
 *
 * Sinh bởi CP22 AngularRealtimeEmitter
 * UI Framework: {[{ ui_framework }]}
 * Widget Type: {[{ widget_type }]}
 */

import { Component, Input, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ChannelSubscriptionService } from './channel-subscription.service';

@Component({
  selector: 'midicoder-live-counter',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="midicoder-live-counter" style="text-align: center; padding: 16px;">
      <div [style.color]="color" style="font-size: 48px; font-weight: bold; transition: color 0.3s ease;">
        {{ formattedValue }}
      </div>
      <div style="font-size: 14px; color: #666;">
        {{ trendIcon }} {{ isConnected ? 'live' : 'offline' }}
      </div>
    </div>
  `,
})
export class LiveCounterComponent implements OnInit {
  @Input() channel = 'default';
  @Input() initialValue = 0;
  @Input() format: 'number' | 'currency' | 'percentage' = 'number';
  @Input() locale = 'vi-VN';
{% if has_tenant_scope %}  @Input() tenantId?: string;
{% endif %}

  value = 0;
  prevValue = 0;
  formattedValue = '0';
  color = '#1976d2';
  trendIcon = '—';
  isConnected = false;

  constructor(private channelService: ChannelSubscriptionService) {
    this.value = this.initialValue;
    this.prevValue = this.initialValue;
  }

  ngOnInit() {
    this.channelService.subscribe(this.channel{% if has_tenant_scope %}, { tenantId: this.tenantId }{% endif %}).subscribe((msg) => {
      this.isConnected = true;
      const data = msg.data as Record<string, unknown>;
      const num = typeof data === 'number' ? data : (data && 'value' in data ? Number(data.value) : undefined);
      if (num !== undefined) {
        this.prevValue = this.value;
        this.value = num;
        this.updateDisplay();
      }
    });
    this.updateDisplay();
  }

  private updateDisplay() {
    this.trendIcon = this.value > this.prevValue ? '↑' : this.value < this.prevValue ? '↓' : '—';
    try {
      if (this.format === 'currency') {
        this.formattedValue = new Intl.NumberFormat(this.locale, { style: 'currency', currency: 'VND' }).format(this.value);
      } else if (this.format === 'percentage') {
        this.formattedValue = new Intl.NumberFormat(this.locale, { style: 'percent', maximumFractionDigits: 1 }).format(this.value / 100);
      } else {
        this.formattedValue = new Intl.NumberFormat(this.locale).format(this.value);
      }
    } catch {
      this.formattedValue = String(this.value);
    }
    this.color = '#1976d2';
  }
}
