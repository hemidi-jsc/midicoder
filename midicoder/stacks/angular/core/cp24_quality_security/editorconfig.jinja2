# Cấu hình EditorConfig cho dự án Angular
#
# Đảm bảo tính nhất quán giữa các IDE và text editor
# Cài đặt plugin EditorConfig cho IDE của bạn:
#   - VS Code: EditorConfig for VS Code
#   - WebStorm: tích hợp sẵn
#   - Vim/Neovim: editorconfig-vim
#
# Sinh bởi CP24 AngularQualityEmitter

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_size = 2

[*.html]
indent_size = 2

[package.json]
indent_size = 2
