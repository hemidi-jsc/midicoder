/** Dialog Component - Modal dialog wrapper. */

import { Component, Input, Output, EventEmitter, OnInit, ViewChild, TemplateRef } from "@angular/core";
import { CommonModule } from "@angular/common";
{% if ui_framework == "material" %}
import { MatDialogModule, MatDialogRef } from "@angular/material/dialog";
import { MatButtonModule } from "@angular/material/button";
{% endif %}

@Component({
selector: 'app-dialog',
standalone: true,
imports: [
CommonModule,
{% if ui_framework == "material" %}
MatDialogModule,
MatButtonModule,
{% endif %}
],
template: `
{% if ui_framework == "material" %}
<div mat-dialog-content>
    <h2 mat-dialog-title>{% raw %}{{ title }}{% endraw %}</h2>
    <div class="dialog-body">
        <ng-container *ngTemplateOutlet="contentTemplate || defaultContent"></ng-container>
        <ng-template #defaultContent>
            <p>{% raw %}{{ message }}{% endraw %}</p>
        </ng-template>
    </div>
    <div mat-dialog-actions class="dialog-actions">
        {% if showCancel %}<button mat-button (click)="onCancel()">Hủy</button>{% endif %}
        <button mat-raised-button color="primary" (click)="onConfirm()">Xác nhận</button>
    </div>
</div>
{% elif ui_framework == "tailwind" %}
<div *ngIf="isOpen" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="fixed inset-0 bg-black bg-opacity-50" (click)="onCancel()"></div>
    <div class="bg-white rounded-lg shadow-xl z-10 w-full max-w-lg mx-4">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h2 class="text-xl font-semibold">{% raw %}{{ title }}{% endraw %}</h2>
            <button (click)="onCancel()" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>
        <div class="px-6 py-4">
            <ng-container *ngTemplateOutlet="contentTemplate || defaultContent"></ng-container>
            <ng-template #defaultContent>
                <p>{% raw %}{{ message }}{% endraw %}</p>
            </ng-template>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t">
            {% if showCancel %}<button (click)="onCancel()"
                class="px-4 py-2 text-gray-600 border rounded hover:bg-gray-50">Hủy</button>{% endif %}
            <button (click)="onConfirm()" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">Xác
                nhận</button>
        </div>
    </div>
</div>
{% else %}
<div *ngIf="isOpen" class="dialog-overlay">
    <div class="dialog-container">
        <div class="dialog-header">
            <h2>{% raw %}{{ title }}{% endraw %}</h2>
            <button (click)="onCancel()">&times;</button>
        </div>
        <div class="dialog-body">
            <ng-container *ngTemplateOutlet="contentTemplate || defaultContent"></ng-container>
            <ng-template #defaultContent>
                <p>{% raw %}{{ message }}{% endraw %}</p>
            </ng-template>
        </div>
        <div class="dialog-footer">
            {% if showCancel %}<button (click)="onCancel()">Hủy</button>{% endif %}
            <button (click)="onConfirm()">Xác nhận</button>
        </div>
    </div>
</div>
{% endif %}
`,
})
export class DialogComponent implements OnInit {
@Input() title: string = 'Thông báo';
@Input() message: string = '';
@Input() isOpen: boolean = false;
@Input() showCancel: boolean = true;
@Input() contentTemplate: TemplateRef<any> | null = null;
    @Output() confirm = new EventEmitter<void>();
        @Output() cancel = new EventEmitter<void>();

            ngOnInit() {}

            onConfirm() {
            this.confirm.emit();
            }

            onCancel() {
            this.cancel.emit();
            }
            }