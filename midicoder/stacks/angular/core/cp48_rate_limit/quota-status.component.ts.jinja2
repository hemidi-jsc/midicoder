/**
 * Quota Status Component - CP48 Rate Limiting.
 *
 * Hiển thị trạng thái quota theo cấp độ (user, tenant, endpoint, global)
 * với chu kỳ tính toán và cảnh báo khi gần đạt giới hạn.
 */

import { Component, Input, ChangeDetectionStrategy, OnInit, OnDestroy, inject, signal, computed, effect } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { MatIconModule } from '@angular/material/icon';
import { MatDivider } from '@angular/material/divider';
import { MatChipsModule } from '@angular/material/chips';
import { MatTooltipModule } from '@angular/material/tooltip';
import { MatSnackBar, MatSnackBarModule } from '@angular/material/snack-bar';
import { RateLimitService, QuotaInfo } from './rate-limit.service';

/** Nhãn cấp độ quota tiếng Việt */
const LEVEL_LABELS: Record<string, string> = {
  'global': 'Toàn cục',
  'tenant': 'Tenant',
  'user': 'Người dùng',
  'endpoint': 'Endpoint',
  'api_key': 'API Key',
  'ip': 'Địa chỉ IP',
};

/** Nhãn chu kỳ tính toán tiếng Việt */
const PERIOD_LABELS: Record<string, string> = {
  'minute': 'Phút',
  'hour': 'Giờ',
  'day': 'Ngày',
  'week': 'Tuần',
  'month': 'Tháng',
};

/** Nhãn chu kỳ hiển thị chi tiết */
const PERIOD_DISPLAY: Record<string, string> = {
  'minute': 'trong 1 phút',
  'hour': 'trong 1 giờ',
  'day': 'trong 1 ngày',
  'week': 'trong 1 tuần',
  'month': 'trong 1 tháng',
};

/**
 * Dữ liệu hiển thị cho mỗi quota card.
 *
 * Kết hợp thông tin quota với mức độ cảnh báo
 * và phần trăm sử dụng.
 */
interface QuotaDisplay {
  quota: QuotaInfo;
  percentage: number;
  warningLevel: 'safe' | 'warning' | 'danger' | 'exceeded';
  levelLabel: string;
  periodLabel: string;
  periodDisplay: string;
}

/**
 * QuotaStatusComponent - Hiển thị trạng thái quota.
 *
 * Hiển thị:
 * - Các thẻ quota theo cấp độ (user, tenant, endpoint, global)
 * - Chu kỳ tính toán (phút/giờ/ngày/tuần/tháng) và số còn lại
 * - Thanh tiến độ cho mỗi quota
 * - Chỉ báo cảnh báo khi gần đạt giới hạn
 *   - Dưới 70%: an toàn (xanh lá)
 *   - 70-89%: cảnh báo (cam)
 *   - 90-99%: nguy hiểm (đỏ nhạt)
 *   - 100%+: đã vượt (đỏ đậm)
 * - Thời gian reset tiếp theo
 * - Nút làm mới dữ liệu
 *
 * Sử dụng Angular Signals và OnPush change detection.
 * Auto-refresh mỗi 30 giây để cập nhật quota remaining.
 */
@Component({
  selector: 'app-quota-status',
  standalone: true,
  imports: [
    CommonModule,
    MatButtonModule,
    MatCardModule,
    MatProgressBarModule,
    MatIconModule,
    MatDivider,
    MatChipsModule,
    MatTooltipModule,
    MatSnackBarModule,
  ],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="quota-status">
      <!-- Thanh tiêu đề -->
      <div class="quota-header">
        <div class="header-left">
          <h2>Trạng Thái Quota</h2>
          <p class="subtitle">Giới hạn sử dụng theo cấp độ và chu kỳ</p>
        </div>
        <div class="header-right">
          <span class="last-updated" *ngIf="lastUpdated()">
            Cập nhật: {{ lastUpdated() | date:'HH:mm:ss' }}
          </span>
          <button
            mat-icon-button
            (click)="refresh()"
            [disabled]="loading()"
            matTooltip="Làm mới quota"
            aria-label="Làm mới"
          >
            <mat-icon [style.transform]="loading() ? 'rotate(360deg)' : 'none'">refresh</mat-icon>
          </button>
        </div>
      </div>

      <!-- Thanh tiến độ loading -->
      <mat-progress-bar
        *ngIf="loading()"
        mode="indeterminate"
        class="loading-bar"
      ></mat-progress-bar>

      <!-- Thông báo lỗi -->
      <div class="error-banner" *ngIf="error()">
        <mat-icon>error</mat-icon>
        <span>{{ error() }}</span>
        <button mat-button (click)="clearError()">Đóng</button>
      </div>

      <!-- Lọc theo cấp độ -->
      <div class="filter-chips">
        <mat-chip-set>
          <mat-chip
            *ngFor="let level of availableLevels()"
            [selected]="selectedLevel() === level"
            (click)="selectLevel(level)"
            selectable="false"
          >
            {{ getLevelLabel(level) }}
          </mat-chip>
        </mat-chip-set>
      </div>

      <!-- Lưới thẻ quota -->
      <div class="quota-grid">
        <mat-card
          class="quota-card"
          *ngFor="let display of filteredQuotas()"
          [class]="getWarningLevelClass(display.warningLevel)"
        >
          <!-- Header của card: cấp độ và chu kỳ -->
          <div class="quota-card-header">
            <div class="quota-title">
              <mat-icon [class]="getLevelIconClass(display.quota.level)">
                {{ getLevelIcon(display.quota.level) }}
              </mat-icon>
              <div class="quota-title-text">
                <span class="level-name">{{ display.levelLabel }}</span>
                <span class="period-badge">{{ display.periodLabel }}</span>
              </div>
            </div>
            <div class="quota-status-badge">
              <mat-chip
                [style.background]="getWarningColor(display.warningLevel)"
                [style.color]="'white'"
                disabled
                size="small"
              >
                {{ getWarningLabel(display.warningLevel) }}
              </mat-chip>
            </div>
          </div>

          <mat-divider></mat-divider>

          <!-- Nội dung chính: số liệu và thanh tiến độ -->
          <div class="quota-card-body">
            <!-- Số còn lại - hiển thị nổi bật -->
            <div class="remaining-display">
              <span class="remaining-value" [class.exceeded]="display.warningLevel === 'exceeded'">
                {{ display.quota.remaining }}
              </span>
              <span class="remaining-label">còn lại</span>
            </div>

            <!-- Thanh tiến độ -->
            <div class="progress-section">
              <div class="progress-header">
                <span class="used-count">{{ display.quota.current_usage }} / {{ display.quota.max_requests }}</span>
                <span class="progress-percentage" [class]="getWarningLevelClass(display.warningLevel)">
                  {{ display.percentage }}%
                </span>
              </div>
              <mat-progress-bar
                mode="determinate"
                [value]="display.percentage"
                class="quota-progress-bar"
              ></mat-progress-bar>
            </div>

            <!-- Thông tin chi tiết -->
            <div class="quota-details">
              <div class="detail-row">
                <mat-icon>schedule</mat-icon>
                <span>Giới hạn {{ display.quota.max_requests }} yêu cầu {{ display.periodDisplay }}</span>
              </div>
              <div class="detail-row">
                <mat-icon>update</mat-icon>
                <span>Reset: {{ display.quota.reset_at | date:'dd/MM/yyyy HH:mm' }}</span>
              </div>
              <!-- Hiển thị tenant_id nếu có -->
              <div class="detail-row" *ngIf="display.quota.tenant_id">
                <mat-icon>business</mat-icon>
                <span>Tenant: {{ display.quota.tenant_id }}</span>
              </div>
              <!-- Hiển thị endpoint nếu có -->
              <div class="detail-row" *ngIf="display.quota.endpoint">
                <mat-icon>link</mat-icon>
                <span>Endpoint: {{ display.quota.endpoint }}</span>
              </div>
            </div>

            <!-- Cảnh báo khi gần hết quota -->
            <div class="quota-warning" *ngIf="display.warningLevel === 'warning'">
              <mat-icon>warning</mat-icon>
              <span>Quota sắp hết - vui lòng giảm tần suất yêu cầu</span>
            </div>
            <div class="quota-warning danger" *ngIf="display.warningLevel === 'danger'">
              <mat-icon>error</mat-icon>
              <span>Cảnh báo: Quota gần như đã cạn kiệt</span>
            </div>
            <div class="quota-warning exceeded" *ngIf="display.warningLevel === 'exceeded'">
              <mat-icon>block</mat-icon>
              <span>Đã vượt quá giới hạn - yêu cầu sẽ bị từ chối đến khi reset</span>
            </div>
          </div>

          <!-- Footer: trạng thái bật/tắt -->
          <div class="quota-card-footer">
            <mat-chip
              [style.background]="display.quota.enabled ? '#4caf50' : '#9e9e9e'"
              [style.color]="'white'"
              disabled
              size="small"
            >
              {{ display.quota.enabled ? 'Đang hoạt động' : 'Tạm ngưng' }}
            </mat-chip>
            <span class="config-id">{{ display.quota.config_id }}</span>
          </div>
        </mat-card>
      </div>

      <!-- Trạng thái rỗng khi không có quotas -->
{% if has_quotas %}
      <div class="empty-state" *ngIf="!loading() && quotas().length === 0">
        <mat-icon>dashboard</mat-icon>
        <p>Chưa có cấu hình quota nào</p>
        <p class="empty-hint">Cấu hình quota để giới hạn sử dụng theo cấp độ</p>
      </div>
{% else %}
      <div class="no-quotas-notice">
        <mat-icon>info</mat-icon>
        <p>Module quotas chưa được kích hoạt trong cấu hình hiện tại</p>
      </div>
{% endif %}

      <!-- Thống kê tổng quan phía dưới -->
      <div class="quota-summary" *ngIf="quotas().length > 0">
        <mat-divider></mat-divider>
        <div class="summary-grid">
          <div class="summary-item" *ngFor="let s of summaryStats()">
            <span class="summary-value" [style.color]="s.color">{{ s.value }}</span>
            <span class="summary-label">{{ s.label }}</span>
          </div>
        </div>
      </div>
    </div>
  `,
  styles: `
