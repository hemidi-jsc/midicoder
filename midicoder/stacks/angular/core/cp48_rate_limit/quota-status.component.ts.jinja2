})
export class QuotaStatusComponent implements OnInit, OnDestroy {
  private readonly rateLimitService = inject(RateLimitService);
  private readonly snackBar = inject(MatSnackBar);

  // Private writable signals
  private _quotas = signal<QuotaInfo[]>([]);
  private _loading = signal<boolean>(false);
  private _error = signal<string | null>(null);
  private _selectedLevel = signal<string>('all');
  private _lastUpdated = signal<Date | null>(null);

  // Readonly exposed signals
  quotas = this._quotas.asReadonly();
  loading = this._loading.asReadonly();
  error = this._error.asReadonly();
  selectedLevel = this._selectedLevel.asReadonly();
  lastUpdated = this._lastUpdated.asReadonly();

  // Interval ID cho auto-refresh
  private refreshInterval: ReturnType<typeof setInterval> | null = null;

  /**
   * Effect: hiển thị snackbar cảnh báo khi có quota vượt hạn.
   */
  constructor() {
    effect(() => {
      const exceededQuotas = this._quotas().filter(q => q.remaining <= 0);
      if (exceededQuotas.length > 0) {
        const names = exceededQuotas.map(q => q.level).join(', ');
        this.snackBar.open(
          `Cảnh báo: Quota của ${names} đã vượt quá giới hạn`,
          'Đóng',
          { duration: 10000, panelClass: ['quota-warning-snackbar'] }
        );
      }
    });
  }

  /**
   * Computed: danh sách các cấp độ duy nhất từ quotas.
   */
  availableLevels = computed<string[]>(() => {
    const levels = this._quotas().map(q => q.level);
    return ['all', ...[...new Set(levels)].sort()];
  });

  /**
   * Computed: danh sách quota display đã lọc theo cấp độ được chọn.
   */
  filteredQuotas = computed<QuotaDisplay[]>(() => {
    const quotasArr = this._quotas();
    const level = this._selectedLevel();

    const filtered = level === 'all'
      ? quotasArr
      : quotasArr.filter(q => q.level === level);

    return filtered.map(quota => {
      const percentage = this.calculatePercentage(quota);
      return {
        quota,
        percentage,
        warningLevel: this.getWarningLevelForPercentage(percentage),
        levelLabel: this.getLevelLabel(quota.level),
        periodLabel: this.getPeriodLabel(quota.period),
        periodDisplay: this.getPeriodDisplay(quota.period),
      };
    });
  });

  /**
   * Computed: thống kê tổng quan.
   */
  summaryStats = computed<{ label: string; value: number; color: string }[]>(() => {
    const quotasArr = this._quotas();
    const total = quotasArr.length;
    const active = quotasArr.filter(q => q.enabled).length;
    const exceeded = quotasArr.filter(q => q.remaining <= 0).length;
    const low = quotasArr.filter(q => {
      const pct = this.calculatePercentage(q);
      return pct >= 80 && q.remaining > 0;
    }).length;

    return [
      { label: 'Tổng Quota', value: total, color: '#1976d2' },
      { label: 'Đang Hoạt Động', value: active, color: '#4caf50' },
      { label: 'Gần Hết', value: low, color: '#ff9800' },
      { label: 'Đã Vượt', value: exceeded, color: '#f44336' },
    ];
  });

  /**
   * Khởi tạo: tải quota ban đầu và thiết lập auto-refresh.
   */
  ngOnInit(): void {
    this.loadQuotas();
    this.startAutoRefresh();
  }

  /**
   * Cleanup: dừng auto-refresh khi component bị huỷ.
   */
  ngOnDestroy(): void {
    this.stopAutoRefresh();
  }

  /**
   * Tải danh sách quota còn lại từ API.
   */
  loadQuotas(): void {
    this._loading.set(true);
    this._error.set(null);

    this.rateLimitService.getQuotaRemaining().subscribe({
      next: (quotasArr: QuotaInfo[]) => {
        this._quotas.set(quotasArr);
        this._lastUpdated.set(new Date());
        this._loading.set(false);
      },
      error: (err: unknown) => {
        this._error.set(this.formatError(err, 'Tải quota thất bại'));
        this._loading.set(false);
      },
    });
  }

  /**
   * Làm mới dữ liệu thủ công.
   */
  refresh(): void {
    this.loadQuotas();
  }

  /**
   * Xóa thông báo lỗi hiện tại.
   */
  clearError(): void {
    this._error.set(null);
  }

  /**
   * Chọn cấp độ để lọc.
   *
   * @param level - Cấp độ quota hoặc 'all'
   */
  selectLevel(level: string): void {
    this._selectedLevel.set(level);
  }

  /**
   * Tính toán phần trăm sử dụng từ quota info.
   *
   * @param quota - QuotaInfo object
   * @returns Phần trăm số nguyên (0-100), max 100
   */
  private calculatePercentage(quota: QuotaInfo): number {
    if (quota.max_requests === 0) return 0;
    const pct = Math.round((quota.current_usage / quota.max_requests) * 100);
    return Math.min(pct, 100);
  }

  /**
   * Xác định mức cảnh báo dựa trên phần trăm sử dụng.
   *
   * @param percentage - Phần trăm sử dụng (0-100)
   * @returns Warning level
   */
  private getWarningLevelForPercentage(percentage: number): 'safe' | 'warning' | 'danger' | 'exceeded' {
    if (percentage >= 100) return 'exceeded';
    if (percentage >= 90) return 'danger';
    if (percentage >= 70) return 'warning';
    return 'safe';
  }

  /**
   * Lấy nhãn cấp độ tiếng Việt.
   *
   * @param level - Tên cấp độ
   * @returns Label tiếng Việt
   */
  getLevelLabel(level: string): string {
    return LEVEL_LABELS[level] || level;
  }

  /**
   * Lấy nhãn chu kỳ tiếng Việt.
   *
   * @param period - Tên chu kỳ
   * @returns Label tiếng Việt
   */
  getPeriodLabel(period: string): string {
    return PERIOD_LABELS[period] || period;
  }

  /**
   * Lấy hiển thị chi tiết chu kỳ.
   *
   * @param period - Tên chu kỳ
   * @returns Chuỗi hiển thị
   */
  getPeriodDisplay(period: string): string {
    return PERIOD_DISPLAY[period] || period;
  }

  /**
   * Lấy biểu tượng cho cấp độ quota.
   *
   * @param level - Tên cấp độ
   * @returns Material icon name
   */
  getLevelIcon(level: string): string {
    const iconMap: Record<string, string> = {
      'global': 'public',
      'tenant': 'business',
      'user': 'person',
      'endpoint': 'link',
      'api_key': 'key',
      'ip': 'dns',
    };
    return iconMap[level] || 'dashboard';
  }

  /**
   * Lấy màu biểu tượng cho cấp độ.
   *
   * @param level - Tên cấp độ
   * @returns Màu icon
   */
  getLevelIconClass(level: string): string {
    const classMap: Record<string, string> = {
      'global': 'icon-global',
      'tenant': 'icon-tenant',
      'user': 'icon-user',
      'endpoint': 'icon-endpoint',
      'api_key': 'icon-apikey',
      'ip': 'icon-ip',
    };
    return classMap[level] || '';
  }

  /**
   * Lấy màu nền cho badge cảnh báo.
   *
   * @param level - Warning level
   * @returns Màu nền CSS
   */
  getWarningColor(level: string): string {
    const colorMap: Record<string, string> = {
      'safe': '#4caf50',
      'warning': '#ff9800',
      'danger': '#f44336',
      'exceeded': '#b71c1c',
    };
    return colorMap[level] || '#9e9e9e';
  }

  /**
   * Lấy nhãn cảnh báo tiếng Việt.
   *
   * @param level - Warning level
   * @returns Label tiếng Việt
   */
  getWarningLabel(level: string): string {
    const labelMap: Record<string, string> = {
      'safe': 'An toàn',
      'warning': 'Cảnh báo',
      'danger': 'Nguy hiểm',
      'exceeded': 'Đã vượt',
    };
    return labelMap[level] || level;
  }

  /**
   * Lấy CSS class cho card dựa trên mức cảnh báo.
   *
   * @param level - Warning level
   * @returns CSS class name
   */
  getWarningLevelClass(level: string): string {
    return level; // safe, warning, danger, exceeded
  }

  /**
   * Bắt đầu auto-refresh interval (30 giây).
   */
  private startAutoRefresh(): void {
    this.stopAutoRefresh();
    this.refreshInterval = setInterval(() => {
      this.loadQuotas();
    }, 30000);
  }

  /**
   * Dừng auto-refresh interval.
   */
  private stopAutoRefresh(): void {
    if (this.refreshInterval) {
      clearInterval(this.refreshInterval);
      this.refreshInterval = null;
    }
  }

  /**
   * Format error message.
   *
   * @param error - Error object từ HTTP response
   * @param defaultMessage - Thông báo mặc định
   * @returns Message string
   */
  private formatError(error: unknown, defaultMessage: string): string {
    if (error instanceof Error) {
      return error.message || defaultMessage;
    }
    if (typeof error === 'string') {
      return error;
    }
    return defaultMessage;
  }
}
