import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MfaService } from './mfa.service';
import { MFAMethod } from './mfa-types';

@Component({
selector: 'app-mfa-setup',
standalone: true,
imports: [CommonModule, ReactiveFormsModule],
templateUrl: './mfa-setup.component.html',
})
export class MfaSetupComponent implements OnInit {
setupForm!: FormGroup;
qrCodeData: string | null = null;
loading = false;
error: string | null = null;
methods = MFAMethod;

constructor(
private fb: FormBuilder,
private mfaService: MfaService,
) {}

ngOnInit(): void {
this.setupForm = this.fb.group({
method: [MFAMethod.TOTP, Validators.required],
deviceName: [''],
phoneNumber: [''],
issuer: ['Midicoder'],
});
}

async enroll(): Promise<void> {
    this.loading = true;
    this.error = null;
    try {
    const { method, deviceName, phoneNumber, issuer } = this.setupForm.value;
    const response = await this.mfaService.enroll({
    userId: 'current-user',
    method,
    deviceName,
    phoneNumber,
    issuer,
    });
    this.qrCodeData = response.qrCodeData || null;
    } catch (err: any) {
    this.error = err.message || 'Enrollment failed';
    } finally {
    this.loading = false;
    }
    }

    async verifyEnrollment(enrollmentId: string, code: string): Promise<void> {
        this.loading = true;
        try {
        await this.mfaService.verifyEnrollment(enrollmentId, code);
        console.log('MFA enrolled successfully');
        } catch (err: any) {
        this.error = err.message || 'Verification failed';
        } finally {
        this.loading = false;
        }
        }
        }