})
export class PreferenceCenterComponent implements OnInit {
// ===========================================================================
// Inputs / Outputs
// ===========================================================================

/**
* Danh sách các phần tùy chọn.
*
* Mỗi phần chứa nhóm các mục liên quan (thông báo, giao diện, riêng tư...).
*/
@Input() sections = signal<PreferenceSection[]>([]);

/**
* Sự kiện phát ra khi người dùng lưu thay đổi.
*
* Payload là bản đồ { sectionId: { itemKey: value } } cho tất cả các phần.
*/
@Output() saved = new EventEmitter<Record<string, Record<string, string | boolean>>>();

// ===========================================================================
// Signals
// ===========================================================================

/**
* Bản đồ giá trị hiện tại của tất cả mục tùy chọn.
*
* Cấu trúc: { sectionId: { itemKey: value } }
*/
readonly currentValues = signal<Record<string, Record<string, string | boolean>>>({});

/**
* Giá trị ban đầu — dùng để hủy bỏ thay đổi.
*/
readonly initialValues = signal<Record<string, Record<string, string | boolean>>>({});

/**
* Đang hiển thị thông báo lưu thành công.
*/
readonly saved = signal<boolean>(false);

// ===========================================================================
// Lifecycle
// ===========================================================================

/**
* Khởi tạo component — xây dựng bản đồ giá trị ban đầu từ sections.
*/
ngOnInit(): void {
this.buildInitialMap();

// Tự động cập nhật bản đồ khi sections thay đổi
effect(() => {
this.buildInitialMap();
});
}

/**
* Xây dựng bản đồ giá trị ban đầu từ danh sách sections.
*/
private buildInitialMap(): void {
const map: Record<string, Record<string, string | boolean>> = {};
const secs = this.sections();
secs.forEach((section) => {
map[section.id] = {};
section.items.forEach((item) => {
map[section.id][item.key] = item.value;
});
});
this.currentValues.set({ ...map });
this.initialValues.set({ ...map });
}

// ===========================================================================
// Data access
// ===========================================================================

/**
* Lấy giá trị hiện tại của mục tùy chọn.
*
* @param sectionId - ID phần chứa mục.
* @param itemKey - Khóa của mục.
* @returns Giá trị hiện tại (string | boolean).
*/
getValue(sectionId: string, itemKey: string): string | boolean {
return this.currentValues()[sectionId]?.[itemKey] ?? false;
}

/**
* Cập nhật giá trị của mục tùy chọn trong bản đồ.
*
* @param sectionId - ID phần chứa mục.
* @param itemKey - Khóa của mục.
* @param value - Giá trị mới.
*/
private updateValue(sectionId: string, itemKey: string, value: string | boolean): void {
this.currentValues.update((prev) => ({
...prev,
[sectionId]: {
...(prev[sectionId] || {}),
[itemKey]: value,
},
}));
}

// ===========================================================================
// Event handlers — Điều khiển
// ===========================================================================

/**
* Xử lý thay đổi từ nút bật/tắt (toggle).
*
* @param sectionId - ID phần.
* @param itemKey - Khóa mục.
* @param checked - Trạng thái bật/tắt mới.
*/
onToggleChange(sectionId: string, itemKey: string, checked: boolean): void {
this.updateValue(sectionId, itemKey, checked);
}

/**
* Xử lý thay đổi từ dropdown chọn (select).
*
* @param sectionId - ID phần.
* @param itemKey - Khóa mục.
* @param value - Giá trị được chọn.
*/
onSelectChange(sectionId: string, itemKey: string, value: string): void {
this.updateValue(sectionId, itemKey, value);
}

/**
* Xử lý thay đổi từ ô nhập văn bản (input).
*
* @param sectionId - ID phần.
* @param itemKey - Khóa mục.
* @param value - Văn bản nhập mới.
*/
onInputChange(sectionId: string, itemKey: string, value: string): void {
this.updateValue(sectionId, itemKey, value);
}

// ===========================================================================
// Actions — Lưu / Hủy
// ===========================================================================

/**
* Lưu tất cả thay đổi và phát sự kiện saved.
*
* Tự động ẩn thông báo thành công sau 3 giây.
*/
saveChanges(): void {
const values = this.currentValues();
this.saved.emit(values);
this.saved.set(true);

// Tự động ẩn thông báo sau 3 giây
setTimeout(() => {
this.saved.set(false);
}, 3000);
}

/**
* Hủy bỏ tất cả thay đổi — khôi phục về giá trị ban đầu.
*/
cancelChanges(): void {
this.currentValues.set(this.initialValues());
}
}
