import { Component, Input, Output, EventEmitter, OnInit, signal, computed, effect } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';

{% if ui_framework == "material" %}
const UI_MODULES = [
MatButtonModule,
MatCardModule,
MatIconModule,
MatCheckboxModule,
MatSelectModule,
MatInputModule,
MatFormFieldModule,
MatChipsModule,
];
{% elif ui_framework == "tailwind" %}
const UI_MODULES = [];
{% elif ui_framework == "bootstrap" %}
const UI_MODULES = [];
{% elif ui_framework == "antd" %}
const UI_MODULES = [];
{% elif ui_framework == "carbon" %}
const UI_MODULES = [];
{% endif %}

/**
* Giao diện phần tùy chọn.
*
* Mỗi phần chứa một nhóm các mục tùy chọn liên quan.
*/
export interface PreferenceSection {
id: string;
title: string;
items: PreferenceItem[];
}

/**
* Giao diện mục tùy chọn.
*
* Hỗ trợ ba loại điều khiển: toggle (bật/tắt), select (chọn danh sách), input (nhập văn bản).
*/
export interface PreferenceItem {
key: string;
label: string;
type: 'toggle' | 'select' | 'input';
value: string | boolean;
options?: Array<{ value: string; label: string }>;
}

/**
* PreferenceCenterComponent — Thành phần quản lý tùy chọn người dùng.
*
* Cung cấp giao diện thống nhất để người dùng điều chỉnh:
* - Tùy chọn thông báo (bật/tắt theo kênh)
* - Tùy chọn giao diện (ngôn ngữ, chủ đề)
* - Tùy chọn riêng tư (chia sẻ dữ liệu, theo dõi)
*
* Dữ liệu được truyền qua @Input() sections và sự kiện lưu được phát qua @Output() saved.
*/
@Component({
selector: 'app-preference-center',
standalone: true,
imports: [CommonModule, FormsModule, ...UI_MODULES],
template: `
<div class="preference-center">
    <!-- Header -->
    <div class="header">
        <h1>Tùy chọn người dùng</h1>
        <p class="subtitle">
            Quản lý các tùy chọn cá nhân: thông báo, ngôn ngữ, giao diện, và hơn nữa
        </p>
    </div>

    <!-- Thông báo thành công -->
    <div *ngIf="saved() === true" class="success-banner">
        Đã lưu tất cả thay đổi thành công.
    </div>

    <!-- Danh sách các phần tùy chọn -->
    <div *ngFor="let section of sections()" class="section-card">
        <h2 class="section-title">{{ section.title }}</h2>

        <!-- Duyệt từng mục trong phần -->
        <div *ngFor="let item of section.items" class="item-row">
            <div class="item-info">
                <span class="item-label">{{ item.label }}</span>
                <span class="item-key">{{ item.key }}</span>
            </div>

            <!-- Điều khiển tùy chọn theo loại -->
            <ng-container [ngSwitch]="item.type">
                <!-- Toggle: nút bật/tắt -->
                <input
                    *ngSwitchCase="'toggle'"
                    type="checkbox"
                    [checked]="getValue(section.id, item.key) as boolean"
                    (change)="onToggleChange(section.id, item.key, ($event.target as HTMLInputElement).checked)"
                    class="toggle-input"
                />

                <!-- Select: dropdown chọn -->
                <select
                    *ngSwitchCase="'select'"
                    [value]="getValue(section.id, item.key) as string"
                    (change)="onSelectChange(section.id, item.key, ($event.target as HTMLSelectElement).value)"
                    class="select-input"
                >
                    <option *ngFor="let opt of item.options" [value]="opt.value">
                        {{ opt.label }}
                    </option>
                </select>

                <!-- Input: ô nhập văn bản -->
                <input
                    *ngSwitchCase="'input'"
                    type="text"
                    [value]="getValue(section.id, item.key) as string"
                    (input)="onInputChange(section.id, item.key, ($event.target as HTMLInputElement).value)"
                    class="text-input"
                />
            </ng-container>
        </div>
    </div>

    <!-- Footer hành động -->
    <div class="footer">
        <button class="btn-secondary" (click)="cancelChanges()">Hủy bỏ</button>
        <button class="btn-primary" (click)="saveChanges()">Lưu thay đổi</button>
    </div>
</div>
`,
styles: [`
