// ===========================================================================
// Interface / kiểu dữ liệu cục bộ cho Timeline
// ===========================================================================

/** Kiểu trạng thái của bước thời hạn. */
export type TimelineStepStatus = 'pending' | 'approved' | 'rejected' | 'delegated';

/** Interface cho một bước trong thời hạn phê duyệt. */
export interface TimelineStep {
/** ID duy nhất của bước */
id: string;
/** Hành động cần thực hiện */
action: string;
/** Người thực hiện bước */
actor: string;
/** Thời điểm thực hiện (ISO 8601) */
timestamp: string | null;
/** Trạng thái của bước */
status: TimelineStepStatus;
}

// ===========================================================================
// ApprovalTimelineComponent — Thành phần hiển thị thời hạn phê duyệt
// ===========================================================================

/**
* ApprovalTimelineComponent — Hiển thị lịch sử các bước phê duyệt.
*
* Sử dụng:
* <app-approval-timeline * [requestId]="'req_001'" * [steps]="timelineSteps" * (stepClick)="onStepSelected($event)">
    * </app-approval-timeline>
*/
@Component({
selector: 'app-approval-timeline',
standalone: true,
imports: [CommonModule],
changeDetection: ChangeDetectionStrategy.OnPush,

template:
{% raw %}
`
<div class="approval-timeline">
    <!-- Tiêu đề -->
    <header class="timeline-header">
        <h2>Thời Hạn Phê Duyệt</h2>
        <span class="request-id">{{ requestId }}</span>
    </header>

    <!-- Thanh tiến trình -->
    <section class="progress-section">
        <div class="progress-track">
            <div class="progress-fill" [style.width.%]="progressPercent"></div>
        </div>
        <div class="progress-text">
            {{ progressPercent }}% — {{ completedCount() }}/{{ steps.length }} bước đã hoàn thành
        </div>
    </section>

    <!-- Danh sách thời hạn -->
    <section class="timeline-list" *ngIf="steps.length; else emptyState">
        <div class="timeline-step" *ngFor="let step of steps; let i = index; let last = last"
            [class.hovered]="hoveredStepId() === step.id" (click)="onStepClick(step.id)"
            (mouseenter)="onHoverStep(step.id)" (mouseleave)="onHoverStep(null)">
            <!-- Cột chỉ số bên trái -->
            <div class="step-indicator">
                <div class="step-dot" [class]="getDotClass(step.status)">
                    {{ getStepIcon(step.status) }}
                </div>
                <div class="step-line" *ngIf="!last" [class]="getLineClass(step.status)"></div>
            </div>

            <!-- Nội dung bước -->
            <div class="step-content">
                <div class="step-action">{{ step.action }}</div>
                <div class="step-actor">Người thực hiện: {{ step.actor }}</div>
                <div class="step-time">
                    {{ step.timestamp ? (step.timestamp | date:'dd/MM/yyyy HH:mm') : 'Chưa được thực hiện' }}
                </div>
                <div class="step-badge">
                    <span class="badge" [class]="getBadgeClass(step.status)">
                        {{ getStatusLabel(step.status) }}
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Trạng thái trống -->
    <ng-template #emptyState>
        <div class="empty-state">
            <p>Không có bước phê duyệt nào.</p>
        </div>
    </ng-template>
</div>
`,
{% endraw %}
