export class ApprovalTimelineComponent implements OnInit, OnDestroy {
// ===========================================================================
// @Input() — Dữ liệu đầu vào
// ===========================================================================

/** ID yêu cầu phê duyệt. */
@Input() public requestId: string = '';

/** Danh sách các bước trong thời hạn. */
@Input() public steps: TimelineStep[] = [];

// ===========================================================================
// @Output() — Sự kiện đầu ra
// ===========================================================================

/** Sự kiện khi người dùng click vào một bước. */
@Output() public readonly stepClick = new EventEmitter<string>();

    // ===========================================================================
    // Local state
    // ===========================================================================

    /** ID của bước đang hover. */
    public readonly hoveredStepId = signal<string | null>(null);

        // ===========================================================================
        // Computed từ đầu vào
        // ===========================================================================

        /** Số bước đã hoàn thành. */
        public readonly completedCount = computed<number>(() => {
            return this.steps.filter(s =>
            s.status === 'approved' || s.status === 'delegated'
            ).length;
            });

            /** Tỷ lệ phần trăm hoàn thành. */
            public readonly progressPercent = computed<number>(() => {
                if (!this.steps.length) return 0;
                return Math.round((this.completedCount() / this.steps.length) * 100);
                });

                // ===========================================================================
                // Lifecycle
                // ===========================================================================

                ngOnInit(): void {
                console.info('[ApprovalTimeline] Khởi tạo cho yêu cầu:', this.requestId);
                }

                ngOnDestroy(): void {
                // Dọn dẹp nếu cần
                }

                // ===========================================================================
                // Xử lý sự kiện
                // ===========================================================================

                /**
                * Xử lý khi click vào một bước trong thời hạn.
                */
                onStepClick(stepId: string): void {
                this.stepClick.emit(stepId);
                console.info('[ApprovalTimeline] Chọn bước:', stepId);
                }

                /**
                * Xử lý khi hover vào một bước.
                */
                onHoverStep(stepId: string | null): void {
                this.hoveredStepId.set(stepId);
                }

                // ===========================================================================
                // Helper methods — Lấy class CSS theo trạng thái
                // ===========================================================================

                /**
                * Lấy class CSS cho chấm trạng thái.
                */
                getDotClass(status: TimelineStepStatus): string {
                return `step-dot dot-${status}`;
                }

                /**
                * Lấy class CSS cho đường nối.
                */
                getLineClass(status: TimelineStepStatus): string {
                return `step-line line-${status}`;
                }

                /**
                * Lấy class CSS cho badge trạng thái.
                */
                getBadgeClass(status: TimelineStepStatus): string {
                return `badge badge-${status}`;
                }

                /**
                * Lấy icon cho trạng thái.
                */
                getStepIcon(status: TimelineStepStatus): string {
                const iconMap: Record<TimelineStepStatus, string> = {
                    pending: '...',
                    approved: '✓',
                    rejected: '✕',
                    delegated: '↗'
                    };
                    return iconMap[status] || '?';
                    }

                    /**
                    * Lấy nhãn tiếng Việt cho trạng thái.
                    */
                    getStatusLabel(status: TimelineStepStatus): string {
                    const labelMap: Record<TimelineStepStatus, string> = {
                        pending: 'Đang chờ',
                        approved: 'Đã phê duyệt',
                        rejected: 'Đã từ chối',
                        delegated: 'Đã chuyển giao'
                        };
                        return labelMap[status] || status;
                        }
                        }