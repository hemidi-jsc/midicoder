import { ApprovalService } from './approval.service';
import { ApprovalStore } from './approval.store';
import {
ApprovalRequest,
ApprovalStatus,
ApprovalType
} from './approval-types';

// ===========================================================================
// Cấu hình từ template
// ===========================================================================

/** Số yêu cầu phê duyệt mẫu. */
const NUM_REQUESTS: number = {{ num_requests }};

/**
* ApprovalHistoryComponent — Lịch sử phê duyệt.
*
* Sử dụng:
* <app-approval-history></app-approval-history>
*/
@Component({
selector: 'app-approval-history',
standalone: true,
imports: [CommonModule, FormsModule],
changeDetection: ChangeDetectionStrategy.OnPush,

template:
{% raw %}
`
<div class="approval-history">
    <!-- Tiêu đề -->
    <header class="history-header">
        <h1>Lịch Sử Phê Duyệt</h1>
        <span class="total-count">Tổng: {{ totalCount() }} yêu cầu</span>
    </header>

    <!-- Bộ lọc -->
    <section class="filter-section">
        <!-- Lọc theo khoảng thời gian -->
        <div class="date-range-filter">
            <label for="date-from">Từ ngày:</label>
            <input id="date-from" type="date" [(ngModel)]="dateFrom" (change)="onDateFilterChange()" />

            <label for="date-to">Đến ngày:</label>
            <input id="date-to" type="date" [(ngModel)]="dateTo" (change)="onDateFilterChange()" />

            <button class="btn-clear-date" (click)="clearDateFilter()">
                Xóa lọc ngày
            </button>
        </div>

        <!-- Lọc theo loại và trạng thái -->
        <div class="combined-filter">
            <label for="history-type-filter">Loại:</label>
            <select id="history-type-filter" [(ngModel)]="selectedType" (change)="applyFilters()">
                <option value="">Tất cả</option>
                <option value="sequential">Tuần tự</option>
                <option value="parallel">Song song</option>
                <option value="matrix">Ma trận</option>
                <option value="voting">Biểu quyết</option>
                <option value="single">Đơn lẻ</option>
            </select>

            <label for="history-status-filter">Trạng thái:</label>
            <select id="history-status-filter" [(ngModel)]="selectedStatus" (change)="applyFilters()">
                <option value="">Tất cả</option>
                <option value="pending">Đang chờ</option>
                <option value="approved">Đã phê duyệt</option>
                <option value="rejected">Đã từ chối</option>
                <option value="escalated">Đã leo thang</option>
                <option value="delegated">Đã ủy quyền</option>
                <option value="expired">Hết hạn</option>
                <option value="cancelled">Đã hủy</option>
            </select>

            <label for="search-input">Tìm kiếm:</label>
            <input id="search-input" type="text" [(ngModel)]="searchText" (input)="onSearchInput()"
                placeholder="Tìm theo ID hoặc tiêu đề..." />
        </div>
    </section>

    <!-- Nút hành động -->
    <section class="action-bar">
        <button class="btn-action" (click)="loadHistory()">Làm mới</button>
        <button class="btn-action btn-export" (click)="exportToCSV()">Xuất CSV</button>
    </section>

    <!-- Bảng dữ liệu -->
    <section class="datatable-section">
        <table class="approval-table">
            <thead>
                <tr>
                    <th (click)="onSortChange('requestId')" class="sortable">
                        ID {{ getSortIndicator('requestId') }}
                    </th>
                    <th (click)="onSortChange('title')" class="sortable">
                        Tiêu Đề {{ getSortIndicator('title') }}
                    </th>
                    <th (click)="onSortChange('approvalType')" class="sortable">
                        Loại {{ getSortIndicator('approvalType') }}
                    </th>
                    <th (click)="onSortChange('status')" class="sortable">
                        Trạng Thái {{ getSortIndicator('status') }}
                    </th>
                    <th (click)="onSortChange('currentStep')" class="sortable">
                        Bước {{ getSortIndicator('currentStep') }}
                    </th>
                    <th (click)="onSortChange('createdAt')" class="sortable">
                        Ngày Tạo {{ getSortIndicator('createdAt') }}
                    </th>
                    <th (click)="onSortChange('deadline')" class="sortable">
                        Hạn {{ getSortIndicator('deadline') }}
                    </th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <tr *ngFor="let request of paginatedRequests()">
                    <td class="cell-id">#{{ request.requestId }}</td>
                    <td class="cell-title">{{ request.title }}</td>
                    <td>{{ getTypeLabel(request.approvalType) }}</td>
                    <td>
                        <span class="status-pill" [class]="getStatusClass(request.status)">
                            {{ getStatusLabel(request.status) }}
                        </span>
                    </td>
                    <td>{{ request.currentStep }}/{{ request.totalSteps }}</td>
                    <td>{{ request.createdAt | date:'dd/MM/yyyy' }}</td>
                    <td>
                        <span [class.overdue]="isOverdue(request.deadline)">
                            {{ request.deadline | date:'dd/MM/yyyy' }}
                        </span>
                    </td>
                    <td>
                        <button class="btn-view" (click)="onViewDetails(request)">
                            Xem chi tiết
                        </button>
                    </td>
                </tr>
                <tr *ngIf="!paginatedRequests().length">
                    <td colspan="8" class="empty-row">
                        Không có dữ liệu phù hợp với bộ lọc.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>

    <!-- Phân trang -->
    <section class="pagination-section" *ngIf="totalCount() > pageSize()">
        <div class="pagination-info">
            Hiển thị {{ paginatedRequests().length }} / {{ totalCount() }} kết quả
            (Trang {{ currentPage() + 1 }}/{{ totalPages() }})
        </div>
        <div class="pagination-controls">
            <button class="btn-page" (click)="goToFirstPage()" [disabled]="currentPage() === 0">
                « Đầu
            </button>
            <button class="btn-page" (click)="goToPrevPage()" [disabled]="currentPage() === 0">
                ‹ Trước
            </button>

            <!-- Các nút trang -->
            <button class="btn-page" *ngFor="let page of visiblePages(); let i = index" (click)="goToPage(i)"
                [class.active]="i === currentPage()" [disabled]="i === currentPage()">
                {{ i + 1 }}
            </button>

            <button class="btn-page" (click)="goToNextPage()" [disabled]="currentPage() >= totalPages() - 1">
                Tiếp ›
            </button>
            <button class="btn-page" (click)="goToLastPage()" [disabled]="currentPage() >= totalPages() - 1">
                Cuối »
            </button>
        </div>

        <!-- Chọn số lượng trên mỗi trang -->
        <div class="page-size-selector">
            <label for="page-size">Mỗi trang:</label>
            <select id="page-size" [(ngModel)]="pageSizeValue" (change)="onPageSizeChange()">
                <option [value]="10">10</option>
                <option [value]="25">25</option>
                <option [value]="50">50</option>
                <option [value]="100">100</option>
            </select>
        </div>
    </section>
</div>
`,
{% endraw %}
