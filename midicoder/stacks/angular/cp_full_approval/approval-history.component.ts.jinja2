/**
* ApprovalHistoryComponent — Lich su phe duyet.
*
* Hien thi bang du lieu cac yeu cau phe duyet da xu ly voi tinh nang sap xep,
* Loc, phan trang. Ho tro loc theo khoang thoi gian. Tuy xuat du lieu
* duoi dang CSV.
*
* Tao tu dong boi CP42 — khong sua thu cong.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import {
Component,
OnInit,
ChangeDetectionStrategy,
inject,
signal,
computed
} from '@angular/core';
