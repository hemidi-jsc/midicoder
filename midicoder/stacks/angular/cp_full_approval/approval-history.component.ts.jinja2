})
export class ApprovalHistoryComponent implements OnInit {
// ===========================================================================
// Inject dependencies
// ===========================================================================

private readonly approvalService = inject(ApprovalService);
private readonly approvalStore = inject(ApprovalStore);

// ===========================================================================
// Local state — bộ lọc
// ===========================================================================

/** Ngày bắt đầu lọc. */
public dateFrom: string = '';

/** Ngày kết thúc lọc. */
public dateTo: string = '';

/** Loại phê duyệt đang lọc. */
public selectedType: string = '';

/** Trạng thái đang lọc. */
public selectedStatus: string = '';

/** Từ khóa tìm kiếm. */
public searchText: string = '';

/** Thời gian debounce cho tìm kiếm. */
private searchDebounce: ReturnType<typeof setTimeout> | null = null;

    // ===========================================================================
    // Local state — sắp xếp
    // ===========================================================================

    /** Trường sắp xếp hiện tại. */
    private sortField: string = 'createdAt';

    /** Hướng sắp xếp: 'asc' hoặc 'desc'. */
    private sortDirection: 'asc' | 'desc' = 'desc';

    // ===========================================================================
    // Local state — phân trang
    // ===========================================================================

    /** Trang hiện tại (0-based). */
    public readonly currentPage = signal<number>(0);

        /** Số lượng trên mỗi trang. */
        public readonly pageSize = signal<number>(25);

            /** Giá trị select số lượng trên mỗi trang. */
            public pageSizeValue: number = 25;

            // ===========================================================================
            // Computed
            // ===========================================================================

            /** Tất cả yêu cầu từ store. */
            private readonly allRequests = this.approvalStore.pendingRequests;

            /** Danh sách đã lọc (theo ngày, loại, trạng thái, từ khóa). */
            private readonly filteredRequests = computed<ApprovalRequest[]>(() => {
                let requests = this.allRequests();

                // Lọc theo khoảng ngày.
                if (this.dateFrom) {
                const from = new Date(this.dateFrom).getTime();
                requests = requests.filter(r => {
                if (!r.createdAt) return false;
                return new Date(r.createdAt).getTime() >= from;
                });
                }
                if (this.dateTo) {
                const to = new Date(this.dateTo);
                to.setHours(23, 59, 59, 999);
                const toTime = to.getTime();
                requests = requests.filter(r => {
                if (!r.createdAt) return false;
                return new Date(r.createdAt).getTime() <= toTime; }); } // Lọc theo loại phê duyệt. if
                    (this.selectedType) { requests=requests.filter(r=> r.approvalType === this.selectedType as
                    ApprovalType);
                    }

                    // Lọc theo trạng thái.
                    if (this.selectedStatus) {
                    requests = requests.filter(r => r.status === this.selectedStatus as ApprovalStatus);
                    }

                    // Lọc theo từ khóa tìm kiếm.
                    if (this.searchText.trim()) {
                    const query = this.searchText.trim().toLowerCase();
                    requests = requests.filter(r =>
                    r.requestId.toLowerCase().includes(query) ||
                    r.title.toLowerCase().includes(query)
                    );
                    }

                    return requests;
                    });

                    /** Danh sách đã sắp xếp. */
                    private readonly sortedRequests = computed<ApprovalRequest[]>(() => {
                        const requests = this.filteredRequests();
                        const field = this.sortField;
                        const dir = this.sortDirection === 'asc' ? 1 : -1;

                        return [...requests].sort((a, b) => {
                        const aVal = a[field as keyof ApprovalRequest];
                        const bVal = b[field as keyof ApprovalRequest];

                        // So sánh chuỗi.
                        if (typeof aVal === 'string' && typeof bVal === 'string') {
                        return aVal.localeCompare(bVal) * dir;
                        }
                        // So sánh số.
                        if (typeof aVal === 'number' && typeof bVal === 'number') {
                        return (aVal - bVal) * dir;
                        }
                        // So sánh ngày (chuỗi ISO).
                        if (typeof aVal === 'string' && typeof bVal === 'string') {
                        const aTime = aVal ? new Date(aVal).getTime() : 0;
                        const bTime = bVal ? new Date(bVal).getTime() : 0;
                        return (aTime - bTime) * dir;
                        }

                        return 0;
                        });
                        });

                        /** Tổng số kết quả sau khi lọc. */
                        public readonly totalCount = computed<number>(() => {
                            return this.filteredRequests().length;
                            });

                            /** Tổng số trang. */
                            public readonly totalPages = computed<number>(() => {
                                return Math.max(1, Math.ceil(this.totalCount() / this.pageSize()));
                                });

                                /** Danh sách yêu cầu của trang hiện tại. */
                                public readonly paginatedRequests = computed<ApprovalRequest[]>(() => {
                                    const sorted = this.sortedRequests();
                                    const start = this.currentPage() * this.pageSize();
                                    const end = start + this.pageSize();
                                    return sorted.slice(start, end);
                                    });

                                    /** Các trang hiển thị (tối đa 7 trang xung quanh trang hiện tại). */
                                    public readonly visiblePages = computed<number[]>(() => {
                                        const total = this.totalPages();
                                        const current = this.currentPage();
                                        const pages: number[] = [];

                                        // Hiển thị tối đa 7 trang.
                                        const half = 3;
                                        let start = Math.max(0, current - half);
                                        let end = Math.min(total - 1, current + half);

                                        // Điều chỉnh để luôn có 7 trang (nếu đủ).
                                        if (end - start + 1 < 7) { if (start===0) { end=Math.min(total - 1, start + 6);
                                            } else if (end===total - 1) { start=Math.max(0, end - 6); } } for (let
                                            i=start; i <=end; i++) { pages.push(i); } return pages; });
                                            //===========================================================================//
                                            Lifecycle
                                            //===========================================================================ngOnInit():
                                            void { // Tải lịch sử yêu cầu phê duyệt. this.loadHistory(); }
                                            //===========================================================================//
                                            Tải dữ liệu
                                            //===========================================================================/**
                                            * Tải danh sách yêu cầu từ server. */ loadHistory(): void {
                                            this.approvalService.fetchAllRequests().pipe(takeUntilDestroyed()).subscribe(requests=>
                                            {
                                            this.approvalStore.setRequests(requests);
                                            });
                                            }

                                            //
                                            ===========================================================================
                                            // Bộ lọc
                                            //
                                            ===========================================================================

                                            /**
                                            * Xử lý khi thay đổi bộ lọc ngày.
                                            */
                                            onDateFilterChange(): void {
                                            this.applyFilters();
                                            }

                                            /**
                                            * Xóa bộ lọc ngày.
                                            */
                                            clearDateFilter(): void {
                                            this.dateFrom = '';
                                            this.dateTo = '';
                                            this.applyFilters();
                                            }

                                            /**
                                            * Áp dụng tất cả bộ lọc — reset về trang đầu.
                                            */
                                            applyFilters(): void {
                                            this.currentPage.set(0);
                                            }

                                            /**
                                            * Xử lý khi nhập từ khóa tìm kiếm (debounce 300ms).
                                            */
                                            onSearchInput(): void {
                                            if (this.searchDebounce) {
                                            clearTimeout(this.searchDebounce);
                                            }
                                            this.searchDebounce = setTimeout(() => {
                                            this.currentPage.set(0);
                                            }, 300);
                                            }

                                            //
                                            ===========================================================================
                                            // Sắp xếp
                                            //
                                            ===========================================================================

                                            /**
                                            * Xử lý khi thay đổi trường sắp xếp.
                                            */
                                            onSortChange(field: string): void {
                                            // Nếu click cùng trường thì đảo hướng, nếu khác trường thì sắp xếp giảm.
                                            if (this.sortField === field) {
                                            this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
                                            } else {
                                            this.sortField = field;
                                            this.sortDirection = 'desc';
                                            }
                                            this.currentPage.set(0);
                                            }

                                            /**
                                            * Lấy ký chỉ thị sắp xếp cho trường.
                                            */
                                            getSortIndicator(field: string): string {
                                            if (this.sortField !== field) return '';
                                            return this.sortDirection === 'asc' ? '▲' : '▼';
                                            }

                                            //
                                            ===========================================================================
                                            // Phân trang
                                            //
                                            ===========================================================================

                                            /**
                                            * Về trang đầu tiên.
                                            */
                                            goToFirstPage(): void {
                                            this.currentPage.set(0);
                                            }

                                            /**
                                            * Về trang trước.
                                            */
                                            goToPrevPage(): void {
                                            this.currentPage.update(page => Math.max(0, page - 1));
                                            }

                                            /**
                                            * Về trang tiếp theo.
                                            */
                                            goToNextPage(): void {
                                            this.currentPage.update(page => Math.min(this.totalPages() - 1, page + 1));
                                            }

                                            /**
                                            * Về trang cuối cùng.
                                            */
                                            goToLastPage(): void {
                                            this.currentPage.set(this.totalPages() - 1);
                                            }

                                            /**
                                            * Đi đến trang cụ thể.
                                            */
                                            goToPage(page: number): void {
                                            this.currentPage.set(page);
                                            }

                                            /**
                                            * Xử lý khi thay đổi số lượng trên mỗi trang.
                                            */
                                            onPageSizeChange(): void {
                                            this.pageSize.set(this.pageSizeValue);
                                            this.currentPage.set(0);
                                            }

                                            //
                                            ===========================================================================
                                            // Xuất dữ liệu
                                            //
                                            ===========================================================================

                                            /**
                                            * Xuất danh sách đã lọc sang file CSV.
                                            */
                                            exportToCSV(): void {
                                            const data = this.sortedRequests();
                                            const csv = this.generateCSV(data);
                                            this.downloadCSV(csv, 'approval-history.csv');
                                            }

                                            /**
                                            * Tạo nội dung CSV.
                                            */
                                            private generateCSV(requests: ApprovalRequest[]): string {
                                            const header = 'ID,Ti\u00eau \u0110\u1ec1,Loại,Tr\u1ea1ng
                                            th\u00e1i,B\u01b0\u1edbc,Hạn,Ng\u00e0y t\u1ea1o';
                                            const rows = requests.map(r =>
                                            [
                                            r.requestId, r.title, r.approvalType, r.status,
                                            r.currentStep + '/' + r.totalSteps,
                                            r.deadline || '', r.createdAt || ''
                                            ].join(',')
                                            );
                                            return [header, ...rows].join('\n');
                                            }

                                            /**
                                            * Tải file CSV về máy.
                                            */
                                            private downloadCSV(content: string, filename: string): void {
                                            const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
                                            const link = document.createElement('a');
                                            link.href = URL.createObjectURL(blob);
                                            link.download = filename;
                                            link.click();
                                            URL.revokeObjectURL(link.href);
                                            }

                                            //
                                            ===========================================================================
                                            // Điều hướng
                                            //
                                            ===========================================================================

                                            /**
                                            * Xem chi tiết một yêu cầu.
                                            */
                                            onViewDetails(request: ApprovalRequest): void {
                                            this.approvalStore.setCurrentRequest(request);
                                            }

                                            //
                                            ===========================================================================
                                            // Helper methods
                                            //
                                            ===========================================================================

                                            /**
                                            * Lấy class CSS cho trạng thái.
                                            */
                                            getStatusClass(status: string): string {
                                            return status ? 'status-' + status : '';
                                            }

                                            /**
                                            * Lấy nhãn tiếng Việt cho trạng thái.
                                            */
                                            getStatusLabel(status: string): string {
                                            const labelMap: Record<string, string> = {
                                                pending: 'Đang chờ',
                                                approved: 'Đã phê duyệt',
                                                rejected: 'Đã từ chối',
                                                escalated: 'Đã leo thang',
                                                delegated: 'Đã ủy quyền',
                                                expired: 'Hết hạn',
                                                cancelled: 'Đã hủy'
                                                };
                                                return labelMap[status] || status;
                                                }

                                                /**
                                                * Lấy nhãn tiếng Việt cho loại phê duyệt.
                                                */
                                                getTypeLabel(type: string): string {
                                                const labelMap: Record<string, string> = {
                                                    sequential: 'Tuần tự',
                                                    parallel: 'Song song',
                                                    matrix: 'Ma trận',
                                                    voting: 'Biểu quyết',
                                                    single: 'Đơn lẻ'
                                                    };
                                                    return labelMap[type] || type;
                                                    }

                                                    /**
                                                    * Kiểm tra thời hạn có đã qua chưa.
                                                    */
                                                    isOverdue(deadline: string | null): boolean {
                                                    if (!deadline) return false;
                                                    return new Date(deadline).getTime() < Date.now(); } }