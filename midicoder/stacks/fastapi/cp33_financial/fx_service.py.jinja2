"""
FX Rate Service — dịch vụ tỷ giá ngoại hối.

Tự động sinh bởi Midicoder CE — CP33: Financial Engine.

Module này cung cấp FXRateService để quản lý:
- Lấy tỷ giá (get_rate) cho currency pair
- Đồng bộ tỷ giá (sync_rates) từ nguồn ngoài
- Tính toán conversion giữa các currency
- Cache tỷ giá với timestamp

KPI-029: Tenant Isolation
"""

from __future__ import annotations

import logging
from datetime import datetime, timedelta
from decimal import Decimal, ROUND_HALF_UP, InvalidOperation
from typing import Any, Callable, Dict, List, Optional

logger = logging.getLogger(__name__)


class FXError(Exception):
    """Lỗi chung của FX Service."""

    pass


class RateNotFoundError(FXError):
    """Không tìm thấy tỷ giá."""

    pass


class InvalidPairError(FXError):
    """Currency pair không hợp lệ."""

    pass


class FXRateService:
    """Dịch vụ tỷ giá ngoại hối.

    Quản lý tỷ giá giữa các currency, hỗ trợ:
    - Lookup trực tiếp và đảo ngược (USD/EUR → EUR/USD)
    - Cross-rate tính toán (A/C = A/B * B/C)
    - Cache với expiration
    - Source priority
    """

    def __init__(
        self,
        base_currency: str = "{{ base_currency | default('USD') }}",
        event_bus: Any = None,
        audit_logger: Any = None,
    ) -> None:
        """Khởi tạo FXRateService.

        Args:
            base_currency: Currency cơ sở cho quote (mặc định USD).
            event_bus: CP05 EventBus để publish events.
            audit_logger: CP14 Audit logger.
        """
        self.base_currency = base_currency
        self.event_bus = event_bus
        self.audit_logger = audit_logger

        # In-memory rate store: {(base, quote): {"rate": Decimal, "timestamp": datetime, "source": str}}
        self._rates: Dict[tuple, Dict[str, Any]] = {}
        self._rate_history: List[Dict[str, Any]] = []

        # Khởi tạo rates từ DSL context
