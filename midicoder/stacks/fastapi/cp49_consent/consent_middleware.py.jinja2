# ----------------------------------------------------------
# CP49 Consent & Preference Management — Middleware kiểm tra đồng ý
# ----------------------------------------------------------
# Sinh bởi CP49ConsentEmitter
# Class: ConsentMiddleware - ASGI middleware kiem tra dong y
# ----------------------------------------------------------

import logging
from typing import Any, Dict, List, Optional, Set

from fastapi import HTTPException, status
from starlette.middleware.base import BaseHTTPMiddleware, RequestResponseEndpoint
from starlette.requests import Request
from starlette.responses import JSONResponse, Response


logger = logging.getLogger(__name__)


class ConsentMiddleware(BaseHTTPMiddleware):
    """
    Middleware ASGI kiem tra dong y truoc khi truy cap API.

    Kiem tra xem nguoi dung co dong y cho muc dich/danh muc yeu cau
    hay khong. Neu khong co dong y va duoc yeu cau, tra ve 403 Forbidden.

    Bỏ qua kiem tra cho:
    - Health endpoints (/health, /healthcheck)
    - Auth endpoints (/auth/*, /login, /register, /token)
    - Consent endpoints (/consent/*, /cookie-preferences, /communication-preferences)

    Cau hinh qua bien `consent_required_purposes` — danh sach muc dich
    ma middleware se kiem tra dong y.
    """

    # Danh sach path bo qua kiem tra dong y
    SKIP_PATHS: Set[str] = {
        "/health",
        "/healthcheck",
        "/docs",
        "/openapi.json",
        "/redoc",
    }

    # Danh sach prefix bo qua kiem tra dong y
    SKIP_PREFIXES: List[str] = [
        "/auth/",
        "/login",
        "/register",
        "/token",
        "/consent/",
        "/consent",
        "/cookie-preferences",
        "/communication-preferences",
        "/erasure-requests",
    ]

    def __init__(
        self,
        app: Any,
        consent_required_purposes: Optional[List[str]] = None,
        consent_service_factory: Optional[Any] = None,
    ) -> None:
        """
        Khoi tao middleware voi cau hinh kiem tra dong y.

        Tham so:
            app: ASGI application (FastAPI app).
            consent_required_purposes: Danh sach muc dich can kiem tra dong y.
                Neu None, mac dinh kiem tra tat ca muc dich khong phai essential.
            consent_service_factory: Factory de tao ConsentService moi cho tung request.
        """
        super().__init__(app)

        # Muc dich mac dinh can dong y (khong bao gom essential)
        self.consent_required_purposes: List[str] = consent_required_purposes or [
            "analytics",
            "marketing",
            "personalization",
            "third_party",
        ]

        self._consent_service_factory = consent_service_factory

    async def dispatch(
        self,
        request: Request,
        call_next: RequestResponseEndpoint,
    ) -> Response:
        """
        Xuly yeu cau HTTP va kiem tra dong y truoc khi goi tiep pipeline.

        Luu truc:
        1. Kiem tra xem path co nen bo qua kiem tra khong
        2. Lay thong tin nguoi dung tu request state
        3. Xac dinh muc dich cua request
        4. Kiem tra dong y neu can thiet
        5. Goi tiep pipeline neu dong y hop le

        Tham so:
            request: DOI tuong Request cua Starlette.
            call_next: Endpoint de goi tiep pipeline ASGI.

        Tra ve:
            Response tu app hoac 403 Forbidden neu khong co dong y.
        """
        # Bo qua neu path trong danh sach skip
        if self._should_skip(request.url.path):
            return await call_next(request)

        # Lay thong tin nguoi dung tu request state
        user_id = self._extract_user_id(request)
        tenant_id = self._extract_tenant_id(request)

        # Neu khong co thong tin nguoi dung, phep truy cap (khong kiem tra dong y)
        if not user_id or not tenant_id:
            return await call_next(request)

        # Xac dinh muc dich cua request dua tren path
        purpose = self._determine_purpose(request.url.path)

        # Neu muc dich khong trong danh sach can dong y, phep truy cap
        if purpose not in self.consent_required_purposes:
            return await call_next(request)

        # Kiem tra dong y
        try:
            has_consent = await self._check_consent(user_id, tenant_id, purpose)

            if not has_consent:
                logger.warning(
                    "Nguoi dung %s trong tenant %s khong co dong y cho %s - bi chan truy cap %s",
                    user_id,
                    tenant_id,
                    purpose,
                    request.url.path,
                )

                return JSONResponse(
                    status_code=status.HTTP_403_FORBIDDEN,
                    content={
                        "detail": "Thieu dong y de truy cap tai nguyen nay",
                        "purpose": purpose,
                        "message": "Ban can cap dong y cho muc dich '{}' truoc khi truy cap".format(
                            purpose
                        ),
                        "consent_endpoint": "/consent/grant",
                    },
                )

        except Exception as e:
            # Neu co loi khi kiem tra dong y, log va phep truy cap
            # (khong muon block nguoi dung do loi he thong)
            logger.error(
                "Loi khi kiem tra dong y: user=%s, purpose=%s, error=%s",
                user_id,
                purpose,
                str(e),
            )
            # Cho phep truy cap neu ko kiem tra duoc
            pass

        return await call_next(request)

    # --------------------------------------------------------------
    # Phuong thuc noi bo
    # --------------------------------------------------------------

    def _should_skip(self, path: str) -> bool:
        """
        Kiem tra xem path co nen bo qua kiem tra dong y khong.

        Tham so:
            path: URL path cua request.

        Tra ve:
            True neu nen bo qua, False neu can kiem tra.
        """
        # Kiem tra path chinh xac
        if path in self.SKIP_PATHS:
            return True

        # Kiem tra prefix
        for prefix in self.SKIP_PREFIXES:
            if path.startswith(prefix):
                return True

        return False

    def _extract_user_id(self, request: Request) -> Optional[str]:
        """
        Lay user_id tu request state (duoc cap boi auth middleware).

        Tham so:
            request: DOI tuong Request.

        Tra ve:
            user_id hoac None neu khong tim thay.
        """
        # Thu lay tu request state (typical CP03 auth pattern)
        if hasattr(request.state, "user_id"):
            return getattr(request.state, "user_id", None)

        # Thu lay tu header Authorization (fallback)
        auth_header = request.headers.get("x-user-id")
        if auth_header:
            return auth_header

        return None

    def _extract_tenant_id(self, request: Request) -> Optional[str]:
        """
        Lay tenant_id tu request state (duoc cap boi tenant middleware).

        Tham so:
            request: DOI tuong Request.

        Tra ve:
            tenant_id hoac None neu khong tim thay.
        """
        # Thu lay tu request state (typical CP02 tenant pattern)
        if hasattr(request.state, "tenant_id"):
            return getattr(request.state, "tenant_id", None)

        # Thu lay tu header (fallback)
        tenant_header = request.headers.get("x-tenant-id")
        if tenant_header:
            return tenant_header

        return None

    def _determine_purpose(self, path: str) -> str:
        """
        Xac dinh muc dich dong y dua tren URL path.

        Tham so:
            path: URL path cua request.

        Tra ve:
            Muc dich dong y (analytics, marketing, personalization, third_party, essential).
        """
        # Map path -> purpose
        purpose_map: Dict[str, str] = {
            "/analytics": "analytics",
            "/tracking": "analytics",
            "/marketing": "marketing",
            "/promotions": "marketing",
            "/personalization": "personalization",
            "/recommendations": "personalization",
            "/ads": "third_party",
            "/third-party": "third_party",
        }

        for prefix, purpose in purpose_map.items():
            if path.startswith(prefix):
                return purpose

        # Mac dinh: essential (khong can dong y bo sung)
        return "essential"

    async def _check_consent(
        self,
        user_id: str,
        tenant_id: str,
        purpose: str,
    ) -> bool:
        """
        Kiem tra neu nguoi dung co dong y dang hoat dong cho muc dich.

        Su dung ConsentService de kiem tra dong y. Neu khong co
        consent_service_factory, su dung logic fallback.

        Tham so:
            user_id: ID nguoi dung.
            tenant_id: ID tenant.
            purpose: Muc dich dong y can kiem tra.

        Tra ve:
            True neu co dong y, False neu khong.
        """
        # Co ban: essential luon duoc cho phep
        if purpose == "essential":
            return True

        if self._consent_service_factory is not None:
            try:
                service = self._consent_service_factory()
                return await service.check_consent(user_id, tenant_id, purpose)
            except Exception as e:
                logger.error("Loi kiem tra dong y qua service: %s", str(e))
                return False

        # Fallback: tra ve True neu khong co service factory
        # (cho phep truy cap de tranh block nguoi dung)
        return True
