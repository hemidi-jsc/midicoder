class AuditActionType(str, Enum):
    """Audit action types — matches CP14 models."""
    CREATE = "CREATE"
    UPDATE = "UPDATE"
    DELETE = "DELETE"
    READ = "READ"
    LOGIN = "LOGIN"
    LOGOUT = "LOGOUT"
    EXPORT = "EXPORT"
    APPROVE = "APPROVE"
    REJECT = "REJECT"
    CUSTOM = "CUSTOM"


@dataclass
class AuditRecord:
    """
    Audit record structure.

    Attributes:
        id: UUID định danh duy nhất
        timestamp: Thời điểm event (UTC)
        action: Hành động audit
        entity_type: Tên entity bị ảnh hưởng
        entity_id: ID của entity
        actor_id: ID người thực hiện
        actor_type: Loại actor (user/system/background_job)
        tenant_id: Tenant scope
        old_values: Giá trị cũ
        new_values: Giá trị mới
        metadata: Metadata mở rộng
        immutable_hash: SHA-256 hash cho tamper-evidence
    """
    action: str
    entity_type: str
    entity_id: str
    actor_id: str
    actor_type: str = "system"
    tenant_id: str = "default"
    id: str = ""
    timestamp: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
    old_values: Optional[dict[str, Any]] = None
    new_values: Optional[dict[str, Any]] = None
    metadata: Optional[dict[str, Any]] = None
    immutable_hash: str = ""

    def compute_hash(self) -> str:
        """Tính SHA-256 hash cho tamper-evidence (từ các fields hiện tại)."""
        data = {
            "id": self.id,
            "timestamp": self.timestamp.isoformat(),
            "action": self.action,
            "entity_type": self.entity_type,
            "entity_id": self.entity_id,
            "actor_id": self.actor_id,
            "actor_type": self.actor_type,
            "tenant_id": self.tenant_id,
            "old_values": self.old_values or {},
            "new_values": self.new_values or {},
            "metadata": self.metadata or {},
        }
        canonical = json.dumps(data, sort_keys=True, default=str)
        return hashlib.sha256(canonical.encode("utf-8")).hexdigest()

    def to_dict(self) -> dict[str, Any]:
        """Chuyển AuditRecord sang dictionary."""
        return {
            "id": self.id,
            "timestamp": self.timestamp.isoformat(),
            "action": self.action,
            "entity_type": self.entity_type,
            "entity_id": self.entity_id,
            "actor_id": self.actor_id,
            "actor_type": self.actor_type,
            "tenant_id": self.tenant_id,
            "old_values": self.old_values,
            "new_values": self.new_values,
            "metadata": self.metadata,
            "immutable_hash": self.immutable_hash,
        }


class AuditLogger:
    """
    Audit Logger — dual write (database + append-only file).

    Ghi audit log vào cả database VÀ append-only JSONL file
    cho redundancy và tamper-evidence.

{% if entities %}
    Configured entities: {{ entities|join(", ") }}
{% endif %}

    Usage:
        audit_logger = AuditLogger(db_session, log_dir=".midicoder/audit_logs")
        await audit_logger.log(
            action="CREATE",
            entity_type="Order",
            entity_id="order_123",
            actor_id="user_456",
            tenant_id="tenant_1",
        )
    """

    def __init__(
        self,
        db_session=None,
        log_dir: str = ".midicoder/audit_logs",
    ) -> None:
        """
        Khởi tạo AuditLogger.

        Args:
            db_session: Database session (optional)
            log_dir: Thư mục chứa audit log files
        """
        self._db_session = db_session
        self._log_dir = Path(log_dir)
        self._log_dir.mkdir(parents=True, exist_ok=True)
        self._sensitive_fields = {"password", "secret", "token", "credit_card", "ssn"}

    async def log(
        self,
        action: str,
        entity_type: str,
        entity_id: str,
        actor_id: str,
        actor_type: str = "system",
        tenant_id: str = "default",
        old_values: Optional[dict[str, Any]] = None,
        new_values: Optional[dict[str, Any]] = None,
        metadata: Optional[dict[str, Any]] = None,
    ) -> str:
        """
        Log audit entry.

        Args:
            action: Hành động audit
            entity_type: Tên entity
            entity_id: ID entity
            actor_id: ID người thực hiện
            actor_type: Loại actor
            tenant_id: Tenant scope
            old_values: Giá trị cũ
            new_values: Giá trị mới
            metadata: Metadata mở rộng

        Returns:
            Audit record ID
        """
        import uuid

        # Mask sensitive data
        if old_values:
            old_values = self._mask_sensitive_data(old_values)
        if new_values:
            new_values = self._mask_sensitive_data(new_values)

        entry_id = str(uuid.uuid4())
        now = datetime.now(timezone.utc)

        # Compute immutable hash
        hash_data = {
            "id": entry_id,
            "timestamp": now.isoformat(),
            "action": action,
            "entity_type": entity_type,
            "entity_id": entity_id,
            "actor_id": actor_id,
            "actor_type": actor_type,
            "tenant_id": tenant_id,
            "old_values": old_values or {},
            "new_values": new_values or {},
            "metadata": metadata or {},
        }
        immutable_hash = hashlib.sha256(
            json.dumps(hash_data, sort_keys=True, default=str).encode("utf-8")
        ).hexdigest()

        record = AuditRecord(
            id=entry_id,
            timestamp=now,
            action=action,
            entity_type=entity_type,
            entity_id=entity_id,
            actor_id=actor_id,
            actor_type=actor_type,
            tenant_id=tenant_id,
            old_values=old_values,
            new_values=new_values,
            metadata=metadata,
            immutable_hash=immutable_hash,
        )

        # Write to append-only JSONL file
        date_str = now.strftime("%Y-%m-%d")
        log_file = self._log_dir / f"audit_{date_str}.jsonl"
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(json.dumps(record.to_dict(), default=str, ensure_ascii=False) + "\n")

        # Store to database
        if self._db_session:
            # TODO: Store to database via ORM
            pass

        logger.info(
            f"Audit: {action} | "
            f"User: {actor_id} | "
            f"Tenant: {tenant_id} | "
            f"Resource: {entity_type}:{entity_id}"
        )

        return entry_id

