# ============================================================================
# Event handlers
# ============================================================================

@events.test_start.add_listener
def on_test_start(environment, **kwargs):
    """Log khi test bắt đầu."""
    print(f"Bắt đầu load testing với {len(environment.user_classes)} user classes")


@events.test_stop.add_listener
def on_test_stop(environment, **kwargs):
    """Log khi test kết thúc."""
    stats = environment.runner.stats
    print(f"Test hoàn tất. Tổng requests: {stats.num_requests}")
    print(f"Tỷ lệ lỗi: {stats.total_fail_ratio:.2%}")
    if stats.num_requests > 0:
        print(f"Response time p95: {stats.get_response_time_percentile(0.95):.0f}ms")
