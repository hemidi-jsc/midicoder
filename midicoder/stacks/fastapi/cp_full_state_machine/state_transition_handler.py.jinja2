    def add_guard(
        self,
        machine_id: str,
        from_state: str,
        to_state: str,
        guard_fn: GuardFn,
    ) -> None:
        """Thêm guard function cho một transition.

        Args:
            machine_id: ID state machine.
            from_state: State hiện tại.
            to_state: State mục tiêu.
            guard_fn: Guard function.
        """
        key = (from_state, to_state)
        if machine_id not in self._guards:
            self._guards[machine_id] = {}
        if key not in self._guards[machine_id]:
            self._guards[machine_id][key] = []
        self._guards[machine_id][key].append(guard_fn)

    def add_effect(
        self,
        machine_id: str,
        from_state: str,
        to_state: str,
        effect_fn: EffectFn,
    ) -> None:
        """Thêm effect function cho một transition.

        Args:
            machine_id: ID state machine.
            from_state: State hiện tại.
            to_state: State mục tiêu.
            effect_fn: Effect function.
        """
        key = (from_state, to_state)
        if machine_id not in self._effects:
            self._effects[machine_id] = {}
        if key not in self._effects[machine_id]:
            self._effects[machine_id][key] = []
        self._effects[machine_id][key].append(effect_fn)

    def evaluate_guards(
        self,
        machine_id: str,
        from_state: str,
        to_state: str,
        context: TransitionContext,
    ) -> List[GuardResult]:
        """Đánh giá tất cả guards cho một transition.

        Args:
            machine_id: ID state machine.
            from_state: State hiện tại.
            to_state: State mục tiêu.
            context: Transition context.

        Returns:
            Danh sách GuardResult.
        """
        key = (from_state, to_state)
        guards = self._guards.get(machine_id, {}).get(key, [])
        return [fn(context) for fn in guards]

    def execute_effects(
        self,
        machine_id: str,
        from_state: str,
        to_state: str,
        context: TransitionContext,
    ) -> None:
        """Thực thi tất cả effects cho một transition.

        Args:
            machine_id: ID state machine.
            from_state: State hiện tại.
            to_state: State mục tiêu.
            context: Transition context.
        """
        key = (from_state, to_state)
        effects = self._effects.get(machine_id, {}).get(key, [])
        for fn in effects:
            fn(context)

    def auto_register(self) -> None:
        """Tự động đăng ký guard/effect functions được generate."""
