"""
Mô-đun State Transition Handler — guard & effect functions.

Tự động tạo bởi Midicoder CE — không chỉnh sửa thủ công.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from typing import Any, Awaitable, Callable, Dict, List, Optional


@dataclass
class GuardResult:
    """Kết quả của guard function.

    Attributes:
        allowed: Transition có được phép không.
        reason: Lý do nếu bị chặn.
        metadata: Metadata bổ sung.
    """

    allowed: bool
    reason: Optional[str] = None
    metadata: Dict[str, Any] = field(default_factory=dict)


@dataclass
class TransitionContext:
    """Context cho guard/effect function.

    Attributes:
        entity_id: ID của entity.
        machine_id: ID của state machine.
        from_state: State hiện tại.
        to_state: State mục tiêu.
        user_id: ID người thực hiện.
        metadata: Metadata bổ sung.
    """

    entity_id: str
    machine_id: str
    from_state: str
    to_state: str
    user_id: Optional[str] = None
    metadata: Dict[str, Any] = field(default_factory=dict)


# Guard function type: nhận context, trả về GuardResult
GuardFn = Callable[[TransitionContext], GuardResult]
# Effect function type: nhận context, void (có thể async)
EffectFn = Callable[[TransitionContext], None]


class StateTransitionHandler:
    """Quản lý guard và effect functions cho state transitions.

    Guard: chạy TRƯỚC transition, có thể chặn.
    Effect: chạy SAU transition, không thể chặn.

    Usage:
        handler = StateTransitionHandler()
        handler.add_guard("order", "pending", "confirmed", my_guard_fn)
        handler.add_effect("order", "confirmed", "shipped", my_effect_fn)
    """

    def __init__(self):
        """Khởi tạo handler."""
        # guards[machine_id][(from_state, to_state)] = [GuardFn, ...]
        self._guards: Dict[str, List[GuardFn]] = {}
        # effects[machine_id][(from_state, to_state)] = [EffectFn, ...]
        self._effects: Dict[str, List[EffectFn]] = {}

