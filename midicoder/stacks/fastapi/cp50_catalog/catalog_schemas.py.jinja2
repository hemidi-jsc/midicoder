# ----------------------------------------------------------
# CP50 Catalog & Taxonomy Engine — Pydantic v2 schemas cho validation
# ----------------------------------------------------------
# Sinh bởi CP50CatalogEmitter
# Schemas: Product, Category, ProductVariant, AttributeDefinition,
#          AttributeValue, FacetedSearch
# ----------------------------------------------------------

from datetime import datetime
from enum import Enum
from typing import Any, Dict, List, Optional

from pydantic import BaseModel, Field, field_validator


# ====================================================================
# Enum Definitions
# ====================================================================


class ProductStatus(str, Enum):
    """Trang thai vong doi cua san pham."""
    DRAFT = "draft"
    ACTIVE = "active"
    INACTIVE = "inactive"
    ARCHIVED = "archived"


class AttributeType(str, Enum):
    """Loai du lieu cua thuoc tinh san pham."""
    STRING = "string"
    NUMBER = "number"
    BOOLEAN = "boolean"
    DATE = "date"
    ENUM = "enum"
    COLOR = "color"


class Visibility(str, Enum):
    """Che do hien thi cua san pham."""
    PUBLIC = "public"
    INTERNAL = "internal"
    RESTRICTED = "restricted"


# ====================================================================
# Product Schemas
# ====================================================================


class ProductCreate(BaseModel):
    """Schema tao san pham moi."""
    product_id: str = Field(
        ..., min_length=1, max_length=64,
        description="ID duy nhat cua san pham"
    )
    name: str = Field(
        ..., min_length=1, max_length=512,
        description="Ten san pham (hien thi)"
    )
    slug: Optional[str] = Field(
        None, max_length=512,
        description="Duong dan URL than thien (tu dong tu neu de trong)"
    )
    sku: str = Field(
        ..., min_length=1, max_length=128,
        description="Ma SKU duy nhat cua san pham"
    )
    description: Optional[str] = Field(
        None, max_length=10000,
        description="Mo ta chi tiet san pham"
    )
    category_id: Optional[str] = Field(
        None, max_length=64,
        description="ID danh muc phan loai"
    )
    brand_id: Optional[str] = Field(
        None, max_length=64,
        description="ID thuong hieu"
    )
    price: float = Field(
        ..., ge=0,
        description="Gia ban"
    )
    cost_price: float = Field(
        0.0, ge=0,
        description="Gia von"
    )
    compare_at_price: Optional[float] = Field(
        None, ge=0,
        description="Gia so sanh (gia goc/gia cu)"
    )
    currency: str = Field(
        "VND", max_length=8,
        description="Don vi tien te (mac dinh VND)"
    )
    weight: float = Field(
        0.0, ge=0,
        description="Khoi luong san pham"
    )
    dimensions: Optional[Dict[str, float]] = Field(
        None,
        description="Kich thuoc (length, width, height)"
    )
    status: ProductStatus = Field(
        ProductStatus.DRAFT,
        description="Trang thai vong doi san pham"
    )
    visibility: Visibility = Field(
        Visibility.PUBLIC,
        description="Che do hien thi"
    )
    tags: List[str] = Field(
        default_factory=list,
        description="Danh sach the phan loai"
    )
    seo_metadata: Optional[Dict[str, str]] = Field(
        None,
        description="Metadata cho SEO (title, description, keywords)"
    )
    images: List[str] = Field(
        default_factory=list,
        description="Danh sach URL anh xung"
    )
    metadata: Optional[Dict[str, Any]] = Field(
        None,
        description="Du lieu bo sung tuy chinh"
    )
    tenant_id: str = Field(
        ..., min_length=1, max_length=64,
        description="ID tenant so huu san pham"
    )


