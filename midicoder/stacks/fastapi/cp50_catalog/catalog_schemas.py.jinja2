class AttributeValueCreate(BaseModel):
    """Schema tao gia tri thuoc tinh moi."""
    attribute_value_id: str = Field(
        ..., min_length=1, max_length=64,
        description="ID duy nhat cua gia tri thuoc tinh"
    )
    attribute_id: str = Field(
        ..., min_length=1, max_length=64,
        description="ID thuoc tinh dinh nghia"
    )
    product_id: Optional[str] = Field(
        None, max_length=64,
        description="ID san pham (neu gan o cap product)"
    )
    variant_id: Optional[str] = Field(
        None, max_length=64,
        description="ID bien the (neu gan o cap variant)"
    )
    value: Any = Field(
        ...,
        description="Gia tri thuc te (str/int/float/bool/list)"
    )

    @field_validator("value")
    @classmethod
    def validate_value_not_none(cls, v: Any) -> Any:
        """Kiem tra value khong duoc la None."""
        if v is None:
            raise ValueError("value khong duoc de trong hoac None")
        return v


class AttributeValueResponse(BaseModel):
    """Schema tra ve gia tri thuoc tinh."""
    attribute_value_id: str = Field(..., description="ID duy nhat")
    attribute_id: str = Field(..., description="ID thuoc tinh")
    product_id: Optional[str] = Field(None, description="ID san pham")
    variant_id: Optional[str] = Field(None, description="ID bien the")
    value: Any = Field(..., description="Gia tri")

    model_config = {"from_attributes": True}


