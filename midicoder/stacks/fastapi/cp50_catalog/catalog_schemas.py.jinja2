class AttributeDefinitionCreate(BaseModel):
    """Schema tao dinh nghia thuoc tinh moi."""
    attribute_id: str = Field(
        ..., min_length=1, max_length=64,
        description="ID duy nhat cua thuoc tinh"
    )
    name: str = Field(
        ..., min_length=1, max_length=256,
        description="Ten hien thi cua thuoc tinh"
    )
    key: Optional[str] = Field(
        None, max_length=128,
        description="Khoa may doc (tu dong tu neu de trong)"
    )
    attribute_type: AttributeType = Field(
        AttributeType.STRING,
        description="Loai du lieu (STRING, NUMBER, BOOLEAN, DATE, ENUM, COLOR)"
    )
    is_required: bool = Field(
        False,
        description="Bat buoc phai co gia tri"
    )
    validation_rules: Optional[Dict[str, Any]] = Field(
        None,
        description="Quy tac kiem tra (min, max, pattern)"
    )
    options: List[str] = Field(
        default_factory=list,
        description="Danh sach gia tri cho ENUM"
    )
    unit: Optional[str] = Field(
        None, max_length=32,
        description="Don vi (kg, cm, ml, v.v.)"
    )
    is_searchable: bool = Field(
        False,
        description="Co the tim kiem theo thuoc tinh nay"
    )
    is_filterable: bool = Field(
        False,
        description="Co the loc theo thuoc tinh nay"
    )
    is_visible: bool = Field(
        True,
        description="Hien thi tren giao dien"
    )
    sort_order: int = Field(
        0,
        description="Thu tu sap xep"
    )
    metadata: Optional[Dict[str, Any]] = Field(
        None,
        description="Du lieu bo sung tuy chinh"
    )

    @field_validator("options")
    @classmethod
    def validate_enum_options(cls, v: List[str], info) -> List[str]:
        """Kiem tra options chi co su dung voi ENUM type."""
        # Validation chi bat buoc neu attribute_type la ENUM va options de trong
        # Neu co options, moi phan tu khong duoc de trong
        if v:
            for opt in v:
                if not opt.strip():
                    raise ValueError("Moi tu chon ENUM khong duoc de trong")
        return v


class AttributeDefinitionResponse(BaseModel):
    """Schema tra ve dinh nghia thuoc tinh."""
    attribute_id: str = Field(..., description="ID duy nhat")
    name: str = Field(..., description="Ten hien thi")
    key: str = Field(..., description="Khoa may doc")
    attribute_type: str = Field(..., description="Loai du lieu")
    is_required: bool = Field(..., description="Co bat buoc khong")
    validation_rules: Optional[Dict[str, Any]] = Field(None, description="Quy tac kiem tra")
    options: List[str] = Field(default_factory=list, description="Danh sach tu chon")
    unit: Optional[str] = Field(None, description="Don vi")
    is_searchable: bool = Field(..., description="Co the tim kiem khong")
    is_filterable: bool = Field(..., description="Co the loc khong")
    is_visible: bool = Field(..., description="Co hien thi khong")
    sort_order: int = Field(..., description="Thu tu sap xep")
    metadata: Optional[Dict[str, Any]] = Field(None, description="Du lieu bo sung")
    created_at: datetime = Field(..., description="Thoi diem tao")
    updated_at: datetime = Field(..., description="Thoi diem cap nhat")

    model_config = {"from_attributes": True}


