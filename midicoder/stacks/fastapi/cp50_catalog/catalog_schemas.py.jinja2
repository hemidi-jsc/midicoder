class FacetedSearchRequest(BaseModel):
    """Schema yeu cau tim kiem voi bo loc (faceted search)."""
    query: Optional[str] = Field(
        None, max_length=512,
        description="Tu khoa tim kiem (ten, mo ta)"
    )
    status: Optional[str] = Field(
        None, max_length=16,
        description="Loc theo trang thai san pham"
    )
    category_id: Optional[str] = Field(
        None, max_length=64,
        description="Loc theo danh muc"
    )
    brand_id: Optional[str] = Field(
        None, max_length=64,
        description="Loc theo thuong hieu"
    )
    price_min: Optional[float] = Field(
        None, ge=0,
        description="Gia toi thieu"
    )
    price_max: Optional[float] = Field(
        None, ge=0,
        description="Gia toi da"
    )
    tags: Optional[List[str]] = Field(
        None,
        description="Loc theo tags"
    )
    visibility: Optional[str] = Field(
        None, max_length=16,
        description="Loc theo che do hien thi"
    )
    attributes: Optional[Dict[str, Any]] = Field(
        None,
        description="Loc theo gia tri thuoc tinh (key -> value)"
    )
    page: int = Field(
        1, ge=1,
        description="So trang"
    )
    page_size: int = Field(
        20, ge=1, le=100,
        description="So phan tu tren trang"
    )


class AggregationResponse(BaseModel):
    """Schema tra ve tong hop ket qua tim kiem."""
    label: str = Field(..., description="Nhien cua tong hop")
    type: str = Field(..., description="Loai tong hop (count, range)")
    buckets: List[Dict[str, Any]] = Field(
        ...,
        description="Danh sach bucket (key, count, min, max, ...)"
    )


class FacetedSearchResponse(BaseModel):
    """Schema tra ve ket qua tim kiem voi bo loc."""
    total: int = Field(..., description="Tong so ket qua")
    page: int = Field(..., description="So trang hien tai")
    page_size: int = Field(..., description="So phan tu tren trang")
    products: List[ProductResponse] = Field(
        ...,
        description="Danh sach san pham trong trang hien tai"
    )
    aggregations: List[AggregationResponse] = Field(
        default_factory=list,
        description="Danh sach tong hop (category, brand, price_range, attributes)"
    )
