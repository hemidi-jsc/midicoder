# --------------------------------------------------------------
# Route: tao danh muc
# --------------------------------------------------------------

@router.post(
    "/categories",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tao danh muc",
    description="Tao danh muc moi trong taxonomy.",
)
async def create_category(
    payload: Dict[str, Any],
    service: "CategoryService" = Depends(get_category_service),
) -> Dict[str, Any]:
    """
    Tao danh muc moi trong taxonomy.

    Payload can bao gom:
    - category_id (bat buoc): ID duy nhat
    - name (bat buoc): Ten danh muc
    - parent_id: ID danh muc cha (None = cap goc)
    - description: Mo ta
    - sort_order: Thu tu sap xep
    - icon: Bieu tuong
    - is_active: Trang thai hoat dong
    """
    # Kiem tra du lieu bat buoc
    required_fields = ["category_id", "name"]
    for field in required_fields:
        if not payload.get(field):
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="{} la bat buoc".format(field),
            )

    try:
        from catalog_schemas import CategoryCreate
        data = CategoryCreate(**payload)
        category = await service.create_category(data)
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        elif "vong quan he" in error_msg or "cycle" in error_msg.lower():
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(e),
        )

    return category.__dict__


