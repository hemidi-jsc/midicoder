# ----------------------------------------------------------
# CP50 Catalog & Taxonomy Engine — Router FastAPI cho catalog
# ----------------------------------------------------------
# Sinh bởi CP50CatalogEmitter
# Routes: CRUD san pham, CRUD danh muc (flat + cay), CRUD thuoc tinh,
#         CRUD bien the, tim kiem voi bo loc (faceted search)
# ----------------------------------------------------------

import logging
from typing import Any, Dict, List, Optional

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession


logger = logging.getLogger(__name__)

# Dinh danh router
router = APIRouter(prefix="/catalog", tags=["catalog"])


# --------------------------------------------------------------
# Phu thuoc — injection
# --------------------------------------------------------------

def get_product_service(session: AsyncSession = Depends(lambda: None)) -> "ProductService":
    """
    Cung cap dich vu san pham cho cac route.
    Day la diem phu thuoc injection cho ProductService.
    """
    from product_service import ProductService
    return ProductService(session)


def get_category_service(session: AsyncSession = Depends(lambda: None)) -> "CategoryService":
    """
    Cung cap dich vu danh muc cho cac route.
    """
    from category_service import CategoryService
    return CategoryService(session)


def get_attribute_service(session: AsyncSession = Depends(lambda: None)) -> "AttributeService":
    """
    Cung cap dich vu thuoc tinh cho cac route.
    """
    from attribute_service import AttributeService
    return AttributeService(session)


def get_faceted_search_service(
    session: AsyncSession = Depends(lambda: None),
    tenant_id: str = Query("default", description="ID tenant"),
) -> "FacetedSearchService":
    """
    Cung cap dich vu tim kiem voi bo loc cho route /search.
    """
    from faceted_search_service import FacetedSearchService
    return FacetedSearchService(session, tenant_id=tenant_id)


# ===========================================================
# SAN PHAM — CRUD
# ===========================================================

# --------------------------------------------------------------
# Route: liet ke san pham
# --------------------------------------------------------------

@router.get(
    "/products",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Liet ke san pham",
    description="Lay danh sach san pham voi cac bo loc va phan trang.",
)
async def list_products(
    tenant_id: str = Query(..., description="ID tenant"),
    status_filter: Optional[str] = Query(None, alias="status", description="Loc theo trang thai"),
    category_id: Optional[str] = Query(None, description="Loc theo danh muc"),
    brand_id: Optional[str] = Query(None, description="Loc theo thuong hieu"),
    search: Optional[str] = Query(None, description="Tu khoa tim kiem"),
    visibility: Optional[str] = Query(None, description="Loc theo che do hien thi"),
    page: int = Query(1, ge=1, description="So trang"),
    page_size: int = Query(20, ge=1, le=100, description="So phan tu tren trang"),
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Lay danh sach san pham voi cac bo loc.

    Query params:
    - tenant_id (bat buoc): ID tenant
    - status: Trang thai san pham (draft, active, inactive, archived)
    - category_id: ID danh muc
    - brand_id: ID thuong hieu
    - search: Tu khoa tim kiem (name, description)
    - visibility: Che do hien thi (public, internal, restricted)
    - page: So trang (mac dinh 1)
    - page_size: So phan tu tren trang (mac dinh 20, toi da 100)
    """
    result = await service.list_products(
        tenant_id=tenant_id,
        status=status_filter,
        category_id=category_id,
        brand_id=brand_id,
        search=search,
        visibility=visibility,
        page=page,
        page_size=page_size,
    )

    return {
        "items": [item.__dict__ for item in result["items"]],
        "total": result["total"],
        "page": result["page"],
        "page_size": result["page_size"],
    }


# --------------------------------------------------------------
# Route: lay san pham chi tiet
# --------------------------------------------------------------

@router.get(
    "/products/{product_id}",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Lay san pham chi tiet",
    description="Lay thong tin chi tiet cua mot san pham theo ID.",
)
async def get_product(
    product_id: str,
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Lay thong tin chi tiet cua mot san pham.
    """
    product = await service.get_product(product_id)

    if product is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Khong tim thay san pham voi ID: {}".format(product_id),
        )

    return product.__dict__


# --------------------------------------------------------------
# Route: tao san pham
# --------------------------------------------------------------

@router.post(
    "/products",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tao san pham",
    description="Tao san pham moi trong catalog.",
)
async def create_product(
    payload: Dict[str, Any],
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Tao san pham moi trong catalog.

    Payload can bao gom:
    - product_id (bat buoc): ID duy nhat
    - name (bat buoc): Ten san pham
    - sku (bat buoc): Ma SKU duy nhat
    - tenant_id (bat buoc): ID tenant
    - description: Mo ta chi tiet
    - category_id: ID danh muc
    - brand_id: ID thuong hieu
    - price (bat buoc): Gia ban
    - cost_price: Gia von (mac dinh 0)
    - currency: Don vi tien te (mac dinh VND)
    - status: Trang thai (mac dinh draft)
    - visibility: Che do hien thi (mac dinh public)
    - tags: Danh sach tags
    - seo_metadata: Metadata SEO
    - images: Danh sach anh
    - va cac truong khac
    """
    # Kiem tra du lieu bat buoc
    required_fields = ["product_id", "name", "sku", "tenant_id", "price"]
    for field in required_fields:
        if not payload.get(field):
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="{} la bat buoc".format(field),
            )

    try:
        from catalog_schemas import ProductCreate
        data = ProductCreate(**payload)
        product = await service.create_product(data)
    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(e),
        )
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(e),
        )

    return product.__dict__


# --------------------------------------------------------------
# Route: cap nhat san pham
# --------------------------------------------------------------

@router.put(
    "/products/{product_id}",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Cap nhat san pham",
    description="Cap nhat thong tin san pham (partial update).",
)
async def update_product(
    product_id: str,
    payload: Dict[str, Any],
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Cap nhat thong tin san pham.
    Chi cac truong duoc cung cap moi duoc cap nhat.
    """
    try:
        from catalog_schemas import ProductUpdate
        data = ProductUpdate(**payload)
        product = await service.update_product(product_id, data)
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        elif "da ton tai" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_409_CONFLICT,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(e),
        )

    return product.__dict__


# --------------------------------------------------------------
# Route: xoa san pham (soft delete)
# --------------------------------------------------------------

@router.delete(
    "/products/{product_id}",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Xoa san pham (soft delete)",
    description="Xoa san pham theo cach thuc soft delete.",
)
async def delete_product(
    product_id: str,
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Xoa san pham (soft delete).
    San pham se duoc danh dau la da xoa, khong bi xoa khoi co so du lieu.
    """
    try:
        product = await service.delete_product(product_id)
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )

    return product.__dict__


# --------------------------------------------------------------
# Route: khoi phuc san pham
# --------------------------------------------------------------

@router.post(
    "/products/{product_id}/restore",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Khoi phuc san pham",
    description="Khoi phuc san pham da bi soft delete.",
