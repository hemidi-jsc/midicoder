# --------------------------------------------------------------
# Route: tao thuoc tinh
# --------------------------------------------------------------

@router.post(
    "/attributes",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tao thuoc tinh",
    description="Tao dinh nghia thuoc tinh moi cho catalog.",
)
async def create_attribute(
    payload: Dict[str, Any],
    service: "AttributeService" = Depends(get_attribute_service),
) -> Dict[str, Any]:
    """
    Tao dinh nghia thuoc tinh moi.

    Payload can bao gom:
    - attribute_id (bat buoc): ID duy nhat
    - name (bat buoc): Ten hien thi
    - attribute_type: Loai du lieu (STRING, NUMBER, BOOLEAN, DATE, ENUM, COLOR)
    - is_required: Bat buoc phai co gia tri
    - validation_rules: Quy tac kiem tra
    - options: Danh sach gia tri cho ENUM
    - unit: Don vi
    - is_searchable: Co the tim kiem
    - is_filterable: Co the loc
    - is_visible: Hien thi tren giao dien
    """
    # Kiem tra du lieu bat buoc
    required_fields = ["attribute_id", "name"]
    for field in required_fields:
        if not payload.get(field):
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="{} la bat buoc".format(field),
            )

    try:
        from catalog_schemas import AttributeDefinitionCreate
        data = AttributeDefinitionCreate(**payload)
        attribute = await service.create_attribute(data)
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(e),
        )

    return attribute.__dict__


# ===========================================================
# TIM KIEM — FACETED SEARCH
# ===========================================================

# --------------------------------------------------------------
# Route: tim kiem voi bo loc
# --------------------------------------------------------------

@router.get(
    "/search",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Tim kiem voi bo loc",
    description="Tim kiem san pham voi cac bo loc va tra ve aggregations (faceted search).",
)
async def faceted_search(
    tenant_id: str = Query(..., description="ID tenant"),
    query: Optional[str] = Query(None, description="Tu khoa tim kiem"),
    status_filter: Optional[str] = Query(None, alias="status", description="Loc theo trang thai"),
    category_id: Optional[str] = Query(None, description="Loc theo danh muc"),
    brand_id: Optional[str] = Query(None, description="Loc theo thuong hieu"),
    price_min: Optional[float] = Query(None, ge=0, description="Gia toi thieu"),
    price_max: Optional[float] = Query(None, ge=0, description="Gia toi da"),
    visibility: Optional[str] = Query(None, description="Loc theo hien thi"),
    page: int = Query(1, ge=1, description="So trang"),
    page_size: int = Query(20, ge=1, le=100, description="So phan tu tren trang"),
    service: "FacetedSearchService" = Depends(get_faceted_search_service),
) -> Dict[str, Any]:
    """
    Tim kiem san pham voi toan bo cac bo loc va tra ve aggregations.

    Query params:
    - tenant_id (bat buoc): ID tenant
    - query: Tu khoa tim kiem (name, description)
    - status: Trang thai san pham
    - category_id: ID danh muc
    - brand_id: ID thuong hieu
    - price_min: Gia toi thieu
    - price_max: Gia toi da
    - visibility: Che do hien thi
    - page: So trang
    - page_size: So phan tu tren trang

    Tra ve:
    - total: Tong so ket qua
    - page: So trang hien tai
    - page_size: So phan tu tren trang
    - products: Danh sach san pham trong trang
    - aggregations: Danh sach tong hop (category, brand, price_range, attributes)
    """
    result = await service.search_products(
        query=query,
        status=status_filter,
        category_id=category_id,
        brand_id=brand_id,
        price_min=price_min,
        price_max=price_max,
        visibility=visibility,
        page=page,
        page_size=page_size,
    )

    return {
        "total": result["total"],
        "page": result["page"],
        "page_size": result["page_size"],
        "products": [p.__dict__ for p in result["products"]],
        "aggregations": result["aggregations"],
    }
