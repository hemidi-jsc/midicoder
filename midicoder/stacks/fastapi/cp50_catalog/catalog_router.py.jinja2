        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )

    return product.__dict__


# --------------------------------------------------------------
# Route: liet ke bien the cua san pham
# --------------------------------------------------------------

@router.get(
    "/products/{product_id}/variants",
    response_model=List[Dict[str, Any]],
    status_code=status.HTTP_200_OK,
    summary="Liet ke bien the cua san pham",
    description="Lay tat ca bien the cua mot san pham.",
)
async def list_variants(
    product_id: str,
    service: "ProductService" = Depends(get_product_service),
) -> List[Dict[str, Any]]:
    """
    Lay tat ca bien the cua mot san pham.
    """
    # Kiem tra san pham ton tai
    product = await service.get_product(product_id)
    if product is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Khong tim thay san pham voi ID: {}".format(product_id),
        )

    variants = await service.get_variants_for_product(product_id)
    return [v.__dict__ for v in variants]


# --------------------------------------------------------------
# Route: tao bien the moi
# --------------------------------------------------------------

@router.post(
    "/products/{product_id}/variants",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tao bien the san pham",
    description="Tao bien the moi cho san pham.",
)
async def create_variant(
    product_id: str,
    payload: Dict[str, Any],
    service: "ProductService" = Depends(get_product_service),
) -> Dict[str, Any]:
    """
    Tao bien the moi cho san pham.

    Payload can bao gom:
    - variant_id (bat buoc): ID duy nhat cua bien the
    - sku (bat buoc): Ma SKU duy nhat
    - price (bat buoc): Gia ban
    - name: Ten bien the
    - attribute_values: Gia tri thuoc tinh
    - barcode: Ma vạch
    - images: Danh sach anh
    - va cac truong khac
    """
    # Kiem tra du lieu bat buoc
    required_fields = ["variant_id", "sku", "price"]
    for field in required_fields:
        if not payload.get(field) and payload.get(field) != 0:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="{} la bat buoc".format(field),
            )

    try:
        from catalog_schemas import VariantCreate
        data = VariantCreate(**payload)
        variant = await service.create_variant(product_id, data)
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        elif "da ton tai" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_409_CONFLICT,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(e),
        )

    return variant.__dict__


