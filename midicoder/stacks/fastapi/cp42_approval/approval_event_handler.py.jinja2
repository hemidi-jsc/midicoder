# ----------------------------------------------------------
# CP42 Approval Workflow — Event handler qua CP05
# ----------------------------------------------------------
# Sinh boi CP42ApprovalEmitter
# Event topics: approval.requested, approval.decided,
#               approval.escalated, approval.delegated
# ----------------------------------------------------------

import asyncio
import json
import logging
from datetime import datetime, timezone
from typing import Any, Callable, Dict, List, Optional


logger = logging.getLogger(__name__)


# ============================================================================
# Approval Event Handler — Láng nghe domain events qua CP05
# ============================================================================


class ApprovalEventHandler:
    """
    Event handler cho he thong phê duyêt — láng nghe domain events
    va tu dong tao yeu cau phê duyêt khi event khop dieu kien.

    Event topics:
    - approval.requested: Yeu cau phê duyêt moi da duoc tao
    - approval.decided: Quyet dinh phê duyêt da duoc dua ra
    - approval.escalated: Yeu cau da duoc leo thang
    - approval.delegated: Yeu cau da duoc uy quyen

    Attributes:
        session_factory: Factory de tao AsyncSession moi cho moi event.
        event_bus: EventBus instance de subscribe events.
    """

    def __init__(
        self,
        session_factory: Any,
        event_bus: Optional[Any] = None,
    ) -> None:
        """
        Khoi tao ApprovalEventHandler voi session factory va event bus.

        Tham so:
            session_factory: Factory de tao AsyncSession moi.
            event_bus: EventBus instance tu CP05 (tu chon).
        """
        self._session_factory = session_factory
        self._event_bus = event_bus
        self._handlers: Dict[str, List[Callable]] = {
            "approval.requested": [],
            "approval.decided": [],
            "approval.escalated": [],
            "approval.delegated": [],
        }

        # Dang ky cac handler mac dinh
        self._register_default_handlers()

        # Subscribe den event bus neu co
        if self._event_bus is not None:
            self._subscribe_to_topics()

    def _register_default_handlers(self) -> None:
        """Dang ky cac handler mac dinh cho moi event topic."""
        self._handlers["approval.requested"].append(self._on_approval_requested)
        self._handlers["approval.decided"].append(self._on_approval_decided)
        self._handlers["approval.escalated"].append(self._on_approval_escalated)
        self._handlers["approval.delegated"].append(self._on_approval_delegated)

    def _subscribe_to_topics(self) -> None:
        """Dang ky subscribe den cac event topics tren CP05 event bus."""
        topics = [
            "approval.requested",
            "approval.decided",
            "approval.escalated",
            "approval.delegated",
        ]

        for topic in topics:
            self._event_bus.subscribe(topic, self.handle_event)
            logger.info("Da subscribe den topic: %s", topic)

    async def handle_event(self, event: Any) -> None:
        """
        Xy ly event nhan duoc tu CP05 event bus.

        Route event den cac handler phu hop theo event type.

        Tham so:
            event: EventMessage hoac dict chua du lieu event.
        """
        # Trich chuot event type va payload
        if isinstance(event, dict):
            event_type = event.get("event_type", event.get("type", ""))
            payload = event.get("payload", event)
        else:
            event_type = getattr(event, "event_id", "") or getattr(event, "type", "")
            payload = getattr(event, "payload", {})

        if not event_type:
            logger.warning("Event khong co event_type, bo qua")
            return

        logger.info("Nhan duoc event: type=%s", event_type)

        # Route den cac handler phu hop
        handlers = self._handlers.get(event_type, [])
        if not handlers:
            logger.debug("Khong co handler cho event type: %s", event_type)
            return

        for handler in handlers:
            try:
                if asyncio.iscoroutinefunction(handler):
                    await handler(payload)
                else:
                    handler(payload)
            except Exception as e:
                logger.error(
                    "Loi xu ly event '%s': %s",
                    event_type,
                    str(e),
                    exc_info=True,
                )

    # --------------------------------------------------------------
    # Handler: approval.requested
    # --------------------------------------------------------------

    async def _on_approval_requested(self, payload: Dict[str, Any]) -> None:
        """
        Xu ly event approval.requested — yeu cau phê duyêt moi da duoc tao.

        Xu ly: (1) kiem tra dieu kien auto-create neu co,
        (2) phat thanh thong bao cho cac buôc phê duyêt lien quan,
        (3) ghi log audit trail.

        Tham so:
            payload: Du lieu event chua request_id, initiator_id, v.v.
        """
        request_id = payload.get("request_id", "")
        initiator_id = payload.get("initiator_id", "")
        entity_type = payload.get("entity_type", "")
        entity_id = payload.get("entity_id", "")

        logger.info(
            "Xu ly event approval.requested: request=%s, entity=%s:%s, initiator=%s",
            request_id, entity_type, entity_id, initiator_id,
        )

        # Kiem tra co can tao tu dong yeu cau phê duyêt phu hoac khong
        # (vi du: neu entity_type la "purchase_order" va gia tri > ngông old)
        await self._check_auto_approval_conditions(entity_type, entity_id, payload)

        # Ghi log audit
        await self._log_audit_event(
            event_type="approval.requested",
            request_id=request_id,
            actor_id=initiator_id,
            metadata=payload,
        )

    # --------------------------------------------------------------
    # Handler: approval.decided
    # --------------------------------------------------------------

    async def _on_approval_decided(self, payload: Dict[str, Any]) -> None:
        """
        Xu ly event approval.decided — quyet dinh da duoc dua ra.

        Xu ly: (1) cap nhat trang thai cac system lien quan,
        (2) gui thong bao cho initiator va cac phuong lien quan,
        (3)ghi log audit trail.

        Tham so:
            payload: Du lieu event chua decision, approver_id, comment, v.v.
        """
        request_id = payload.get("request_id", "")
        step_id = payload.get("step_id", "")
        approver_id = payload.get("approver_id", "")
        decision = payload.get("decision", "")
        comment = payload.get("comment", "")

        logger.info(
            "Xu ly event approval.decided: request=%s, step=%s, decision=%s, approver=%s",
            request_id, step_id, decision, approver_id,
        )

        # Gui thong bao cho cac phuong lien quan
        await self._notify_stakeholders(request_id, decision, comment)

        # Neu da approved toan bo, co the trigger cac actions tiep theo
        if decision == "approved":
            await self._check_completion_and_trigger(request_id)

        # Ghi log audit
        await self._log_audit_event(
            event_type="approval.decided",
            request_id=request_id,
            actor_id=approver_id,
            metadata=payload,
        )

    # --------------------------------------------------------------
    # Handler: approval.escalated
    # --------------------------------------------------------------

    async def _on_approval_escalated(self, payload: Dict[str, Any]) -> None:
        """
        Xu ly event approval.escalated — yeu cau da duoc leo thang.

        Xu ly: (1) gui thong bao cap nhat cho new_approver,
        (2) cap nhat thoi han hanh dong,
        (3) ghi log audit trail.

        Tham so:
            payload: Du lieu event chua request_id, escalation_rules, v.v.
        """
        request_id = payload.get("request_id", "")
        escalated_rules = payload.get("escalated_rules", [])

        logger.info(
            "Xu ly event approval.escalated: request=%s, rules=%s",
            request_id, escalated_rules,
        )

        # Gui thong bao ve viec leo thang
        await self._notify_escalation(request_id)

        # Ghi log audit
        await self._log_audit_event(
            event_type="approval.escalated",
            request_id=request_id,
            actor_id="system",
            metadata=payload,
        )

    # --------------------------------------------------------------
    # Handler: approval.delegated
    # --------------------------------------------------------------

    async def _on_approval_delegated(self, payload: Dict[str, Any]) -> None:
        """
        Xu ly event approval.delegated — yeu cau da duoc uy quyen.

        Xu ly: (1) gui thong bao cho delegatee,
        (2) xac minh uy quyen hieu luc,
        (3) ghi log audit trail.

        Tham so:
            payload: Du lieu event chua delegation_id, delegatee_id, v.v.
        """
        request_id = payload.get("request_id", "")
        delegation_id = payload.get("delegation_id", "")
        delegatee_id = payload.get("delegatee_id", "")
        delegator_id = payload.get("delegator_id", "")

        logger.info(
            "Xu ly event approval.delegated: request=%s, tu=%s, den=%s, delegation=%s",
            request_id, delegator_id, delegatee_id, delegation_id,
        )

        # Gui thong bao cho ngươI duoc uy quyen
        await self._notify_delegation(delegatee_id, request_id, delegator_id)

        # Ghi log audit
        await self._log_audit_event(
            event_type="approval.delegated",
            request_id=request_id,
            actor_id=delegator_id,
            metadata=payload,
        )

    # --------------------------------------------------------------
    # Auto-create approval request khi event khop dieu kien
    # --------------------------------------------------------------

    async def _check_auto_approval_conditions(
        self,
        entity_type: str,
        entity_id: str,
        payload: Dict[str, Any],
