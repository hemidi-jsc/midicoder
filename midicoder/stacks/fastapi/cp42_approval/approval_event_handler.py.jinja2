        """
        Kiem tra cac dieu kien de tu dong tao yeu cau phê duyêt phu.

        Vi du:
        - Purchase order > $10,000 can extra approval
        - Leave request > 5 ngay can manager approval
        - Contract change can legal review

        Tham so:
            entity_type: Loai thuc the (purchase_order, leave_request, ...).
            entity_id: ID thuc the.
            payload: Du lieu event toan bo.
        """
        # Placeholder cho cac dieu kien auto-create
        # Trong he thong thuc te, se doc config tu database hoac config file

        amount = payload.get("amount")
        if entity_type == "purchase_order" and amount is not None:
            if amount > 10000:
                logger.info(
                    "Purchase order %s voi gia tri %s vuot ngong old, can phê duyêt them",
                    entity_id, amount,
                )
                # Tu dong tao yeu cau phê duyêt them
                # await self._create_extra_approval(entity_type, entity_id, payload)

        days = payload.get("days")
        if entity_type == "leave_request" and days is not None:
            if days > 5:
                logger.info(
                    "Leave request %s voi %s ngay vuot gioi han, can manager phê duyêt",
                    entity_id, days,
                )

    async def _create_extra_approval(
        self,
        entity_type: str,
        entity_id: str,
        payload: Dict[str, Any],
    ) -> None:
        """
        Tu dong tao yeu cau phê duyêt phu khi dieu kien duoc thoa man.

        Goi ApprovalService de tao yeu cau moi voi cac buôc phê duyêt
        phu hop voi dieu kien.

        Tham so:
            entity_type: Loai thuc the.
            entity_id: ID thuc the.
            payload: Du lieu event.
        """
        async with self._session_factory() as session:
            from approval_service import ApprovalService
            service = ApprovalService(session)

            extra_request = await service.create_request({
                "title": "Phê duyêt them: {} {}".format(entity_type, entity_id),
                "description": "Tu dong tao tu event: {}".format(payload.get("event_type", "")),
                "entity_type": entity_type,
                "entity_id": entity_id,
                "approval_type": "sequential",
                "initiator_id": payload.get("initiator_id", "system"),
                "total_steps": 2,
            })

            logger.info(
                "Da tao yeu cau phê duyêt them: id=%s, entity=%s:%s",
                extra_request.request_id, entity_type, entity_id,
            )

    # --------------------------------------------------------------
    # Phuong thuc noi bo — Thong bao
    # --------------------------------------------------------------

    async def _notify_stakeholders(
        self, request_id: str, decision: str, comment: str
    ) -> None:
        """
        Gui thong bao cho cac phuong lien quan sau quyet dinh.

        Tham so:
            request_id: ID yeu cau phê duyêt.
            decision: Quyet dinh (approved/rejected).
            comment: Nhan xet.
        """
        # Placeholder cho notification — tang hop voi CP12 Notification
        logger.info(
            "Gui thong bao ve quyet dinh %s cho yeu cau %s",
            decision, request_id,
        )

    async def _notify_escalation(self, request_id: str) -> None:
        """
        Gui thong bao ve viec leo thang yeu cau phê duyêt.

        Tham so:
            request_id: ID yeu cau phê duyêt.
        """
        # Placeholder cho notification ve leo thang
        logger.info("Gui thong bao leo thang cho yeu cau %s", request_id)

    async def _notify_delegation(
        self, delegatee_id: str, request_id: str, delegator_id: str
    ) -> None:
        """
        Gui thong bao cho ngươI duoc uy quyen.

        Tham so:
            delegatee_id: ID ngươI duoc uy quyen.
            request_id: ID yeu cau phê duyêt.
            delegator_id: ID ngươI uy quyen.
        """
        # Placeholder cho notification ve uy quyen
        logger.info(
            "Gui thong bao uy quyen den %s cho yeu cau %s (tu %s)",
            delegatee_id, request_id, delegator_id,
        )

    async def _check_completion_and_trigger(self, request_id: str) -> None:
        """
        Kiem tra yeu cau da duoc approved toan bo va trigger actions.

        Tham so:
            request_id: ID yeu cau phê duyêt.
        """
        # Placeholder cho completion check
        # Vi du: update entity status, trigger workflow, v.v.
        logger.debug("Kiem tra hoan tat cho yeu cau %s", request_id)

    # --------------------------------------------------------------
    # Phuong thuc noi bo — Audit log
    # --------------------------------------------------------------

    async def _log_audit_event(
        self,
        event_type: str,
        request_id: str,
        actor_id: str,
        metadata: Dict[str, Any],
    ) -> None:
        """
        Ghi log audit trail cho event phê duyêt.

        Tang hop voi CP14 Audit Compliance deghi nhan toan bo
        cac thao tac trong quy trinh phê duyêt.

        Tham so:
            event_type: Loai event.
            request_id: ID yeu cau phê duyêt.
            actor_id: ID ngươI thuc hien thao tac.
            metadata: Du lieu bo sung cua event.
        """
        audit_entry = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event_type": event_type,
            "request_id": request_id,
            "actor_id": actor_id,
            "metadata": metadata,
        }
        logger.info("Audit log: %s", json.dumps(audit_entry, default=str))


# ============================================================================
# Factory function
# ============================================================================


def create_approval_event_handler(
    session_factory: Any,
    event_bus: Optional[Any] = None,
) -> ApprovalEventHandler:
    """
    Tao ApprovalEventHandler moi voi config.

    Tham so:
        session_factory: Factory de tao AsyncSession.
        event_bus: EventBus instance tu CP05 (tu chon).

    Tra ve:
        ApprovalEventHandler instance.
    """
    return ApprovalEventHandler(
        session_factory=session_factory,
        event_bus=event_bus,
    )

