class RetentionScanService:
    """
    Service quét và phát hiện dữ liệu vượt quá retention period.

    Duyệt qua các chính sách active, tìm các thực thể đã vượt quá
    số ngày lưu trữ, và tạo các yêu cầu archive/purge/erase tương ứng.
    """

    def __init__(self, db: Session) -> None:
        """
        Khởi tạo RetentionScanService.

        Args:
            db: SQLAlchemy Session.
        """
        self.db: Session = db
        self.policy_service = RetentionPolicyService(db)
        self.archive_service = ArchiveService(db)
        self.erasure_service = ErasureService(db)

    def scan_policy(
        self,
        policy: RetentionPolicyModel,
        batch_size: int = {{ batch_size | default(100) }},
        dry_run: bool = False,
    ) -> RetentionScanResult:
        """
        Quét một chính sách cụ thể để tìm dữ liệu vượt quá retention.

        Tìm tất cả thực thể thuộc entity_type của chính sách
        đã tồn tại quá retention_days, sau đó thực hiện hành động
        tương ứng (archive, purge, erase) hoặc chỉ đếm (dry_run).

        Args:
            policy: Chính sách cần quét.
            batch_size: Số bản ghi xử lý mỗi batch.
            dry_run: Chỉ đếm, không thực hiện hành động.

        Returns:
            RetentionScanResult với kết quả quét.
        """
        scan_id = str(uuid.uuid4())
        start_time = datetime.now(timezone.utc)

        logger.info(
            "Bắt đầu quét chính sách '%s': entity='%s', retention=%d days, "
            "batch_size=%d, dry_run=%s",
            policy.policy_id,
            policy.entity_type,
            policy.retention_days,
            batch_size,
            dry_run,
        )

        # Tính thời điểm cutoff
        cutoff_date = datetime.now(timezone.utc) - timedelta(days=policy.retention_days)

        # Lấy danh sách archived records chưa xử lý cho chính sách này
        # (Trong production: query thực tế entity table theo cutoff_date)
        pending_count = (
            self.db.query(ArchivedRecordModel)
            .filter(
                ArchivedRecordModel.policy_id == policy.id,
                ArchivedRecordModel.status == ArchiveStatus.PENDING,
            )
            .count()
        )

        # Xử lý batch
        processed = 0
        failed = 0
        errors: list[dict[str, Any]] = []

        if not dry_run:
            # Xử lý các bản ghi PENDING
            pending_records = (
                self.db.query(ArchivedRecordModel)
                .filter(
                    ArchivedRecordModel.policy_id == policy.id,
                    ArchivedRecordModel.status == ArchiveStatus.PENDING,
                )
                .limit(batch_size)
                .all()
            )

            for record in pending_records:
                try:
                    # Cập nhật sang COMPLETED (giả sử archive đã được thực hiện)
                    record.status = ArchiveStatus.COMPLETED
                    record.completed_at = datetime.now(timezone.utc)
                    processed += 1
                except Exception as e:
                    failed += 1
                    errors.append({
                        "entity_id": record.source_entity_id,
                        "error": str(e),
                    })

            self.db.commit()

            # Tạo erasure requests nếu chính sách có action = ERASE
            if policy.action == RetentionAction.ERASE:
                erasure_count = min(batch_size, max(0, pending_count - processed))
                for _ in range(erasure_count):
                    try:
                        self.erasure_service.create_erasure_request(
                            data=ErasureRequestCreate(
                                target_entity_type=policy.entity_type,
                                target_entity_id=f"auto-{uuid.uuid4().hex[:12]}",
                                reason=ErasureReason.DATA_RETENTION_EXPIRED,
                                scope=["users", "sessions", "logs"],
                                initiated_by="retention_scan",
                            ),
                            policy_id=policy.id,
                        )
                        processed += 1
                    except Exception as e:
                        failed += 1
                        errors.append({"error": str(e)})

        duration = (datetime.now(timezone.utc) - start_time).total_seconds()

        result = RetentionScanResult(
            scan_id=scan_id,
            policy_id=policy.policy_id,
            entity_type=policy.entity_type,
            total_found=pending_count,
            total_processed=processed,
            total_failed=failed,
            errors=errors,
            duration_seconds=round(duration, 3),
            scanned_at=start_time,
        )

        logger.info(
            "Hoàn tất quét chính sách '%s': found=%d, processed=%d, failed=%d, "
            "duration=%.2fs",
            policy.policy_id,
            pending_count,
            processed,
            failed,
            duration,
        )

        return result

    def batch_scan(
        self,
        request: BatchScanRequest,
    ) -> BatchScanResponse:
        """
        Thực hiện batch scan — quét nhiều chính sách cùng lúc.

        Duyệt qua các chính sách được chỉ định (hoặc tất cả active policies),
        thực hiện scan cho từng cái và tổng hợp kết quả.

        Args:
            request: Yêu cầu batch scan.

        Returns:
            BatchScanResponse với kết quả tổng hợp.
        """
        scan_id = str(uuid.uuid4())
        start_time = datetime.now(timezone.utc)

        logger.info(
            "Bắt đầu batch scan: policy_ids=%s, entity_types=%s, batch_size=%d, dry_run=%s",
            request.policy_ids,
            request.entity_types,
            request.batch_size,
            request.dry_run,
        )

        # Lấy danh sách chính sách cần quét
        query = self.db.query(RetentionPolicyModel).filter(
            RetentionPolicyModel.status == PolicyStatus.ACTIVE
        )

        if request.policy_ids:
            query = query.filter(RetentionPolicyModel.policy_id.in_(request.policy_ids))
        if request.entity_types:
            query = query.filter(RetentionPolicyModel.entity_type.in_(request.entity_types))

        policies = query.all()

        # Quét từng chính sách
        results: list[RetentionScanResult] = []
        for policy in policies:
            result = self.scan_policy(
                policy=policy,
                batch_size=request.batch_size,
                dry_run=request.dry_run,
            )
            results.append(result)

        # Tổng hợp
        total_found = sum(r.total_found for r in results)
        total_processed = sum(r.total_processed for r in results)
        total_failed = sum(r.total_failed for r in results)
        duration = (datetime.now(timezone.utc) - start_time).total_seconds()

        response = BatchScanResponse(
            scan_id=scan_id,
            results=results,
            total_found=total_found,
            total_processed=total_processed,
            total_failed=total_failed,
            duration_seconds=round(duration, 3),
            scanned_at=start_time,
        )

        logger.info(
            "Hoàn tất batch scan: total_found=%d, processed=%d, failed=%d, "
            "policies=%d, duration=%.2fs",
            total_found,
            total_processed,
            total_failed,
            len(policies),
            duration,
        )

        return response


