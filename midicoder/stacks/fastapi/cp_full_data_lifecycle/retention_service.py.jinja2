            query = query.filter(ErasureRequestModel.reason == reason)
        if target_entity_type:
            query = query.filter(ErasureRequestModel.target_entity_type == target_entity_type)

        offset = (page - 1) * page_size
        requests = (
            query.order_by(ErasureRequestModel.created_at.desc())
            .limit(page_size)
            .offset(offset)
            .all()
        )

        return [ErasureRequestRead.model_validate(r) for r in requests]

    def process_erasure_request(self, request_id: str) -> ErasureRequestRead:
        """
        Xử lý yêu cầu xóa dữ liệu.

        Chuyển trạng thái sang IN_PROGRESS, xử lý xóa theo từng
        hệ thống trong scope, và cập nhật tiến độ.

        Sau khi xử lý xong tất cả hệ thống, chuyển sang COMPLETED
        hoặc FAILED nếu có lỗi.

        Args:
            request_id: UUID của yêu cầu xóa.

        Returns:
            ErasureRequestRead đã cập nhật.

        Raises:
            ValueError: Nếu không tìm thấy yêu cầu hoặc đã được xử lý.
        """
        request = (
            self.db.query(ErasureRequestModel)
            .filter(ErasureRequestModel.id == request_id)
            .first()
        )
        if not request:
            raise ValueError(f"Không tìm thấy yêu cầu xóa với id='{request_id}'")

        # Chỉ xử lý yêu cầu đang ở trạng thái PENDING
        if request.status != ErasureStatus.PENDING:
            raise ValueError(
                f"Yêu cầu xóa '{request_id}' đang ở trạng thái {request.status.value} "
                f"— chỉ có thể xử lý yêu cầu PENDING"
            )

        # Chuyển sang IN_PROGRESS
        request.status = ErasureStatus.IN_PROGRESS
        self.db.commit()

        # Xử lý xóa theo từng hệ thống trong scope
        all_success = True
        now = datetime.now(timezone.utc)

        for system_name in request.scope:
            system_result = {
                "system": system_name,
                "status": "completed",
                "timestamp": now.isoformat(),
                "details": f"Đã xóa dữ liệu từ hệ thống '{system_name}'",
            }

            try:
                # Thực hiện xóa dữ liệu từ hệ thống
                self._erase_from_system(system_name, request)
            except Exception as e:
                all_success = False
                system_result["status"] = "failed"
                system_result["error"] = str(e)
                logger.error(
                    "Lỗi khi xóa dữ liệu từ hệ thống '%s' (request: %s): %s",
                    system_name,
                    request_id,
                    str(e),
                )

            request.systems_processed.append(system_result)

        # Cập nhật trạng thái cuối cùng
        if all_success:
            request.status = ErasureStatus.COMPLETED
            request.completed_at = now
            logger.info(
                "Đã hoàn thành yêu cầu xóa '%s': target='%s:%s'",
                request_id,
                request.target_entity_type,
                request.target_entity_id,
            )
        else:
            request.status = ErasureStatus.FAILED
            failed_systems = [
                s["system"]
                for s in request.systems_processed
                if s["status"] == "failed"
            ]
            request.error_message = (
                f"Xóa thất bại ở các hệ thống: {', '.join(failed_systems)}"
            )
            logger.warning(
                "Yêu cầu xóa '%s' thất bại ở một số hệ thống: %s",
                request_id,
                failed_systems,
            )

        self.db.commit()
        self.db.refresh(request)

        return ErasureRequestRead.model_validate(request)

    def _erase_from_system(
        self,
        system_name: str,
        request: ErasureRequestModel,
    ) -> None:
        """
        Thực hiện xóa dữ liệu từ một hệ thống cụ thể.

        Phương thức nội bộ — gọi các phương thức xóa cụ thể
        cho từng hệ thống được cấu hình trong scope.

        Args:
            system_name: Tên hệ thống cần xóa.
            request: Yêu cầu xóa dữ liệu.
        """
        logger.info(
            "Đang xóa dữ liệu từ hệ thống '%s' cho entity '%s:%s'",
            system_name,
            request.target_entity_type,
            request.target_entity_id,
        )

        # Logic xóa dữ liệu theo hệ thống
        # Trong production: gọi API/database của từng hệ thống
        # để xóa dữ liệu liên quan đến target entity
        systems_map = {
            "users": self._erase_user_data,
            "sessions": self._erase_session_data,
            "logs": self._erase_log_data,
            "payments": self._erase_payment_data,
            "profiles": self._erase_profile_data,
        }

        erase_func = systems_map.get(system_name)
        if erase_func:
            erase_func(request)
        else:
            # Hệ thống không có handler riêng — ghi log
            logger.info(
                "Hệ thống '%s' không có handler xóa riêng — ghi log audit",
                system_name,
            )

    def _erase_user_data(self, request: ErasureRequestModel) -> None:
        """Xóa dữ liệu user — anonymize thay vì xóa cứng."""
        logger.info("Đã anonymize dữ liệu user '%s'", request.target_entity_id)

    def _erase_session_data(self, request: ErasureRequestModel) -> None:
        """Xóa tất cả session liên quan đến user."""
        logger.info("Đã xóa session data cho user '%s'", request.target_entity_id)

    def _erase_log_data(self, request: ErasureRequestModel) -> None:
        """Xóa log data — giữ audit log, anonymize chi tiết."""
        logger.info("Đã anonymize log data cho entity '%s'", request.target_entity_id)

    def _erase_payment_data(self, request: ErasureRequestModel) -> None:
        """Xóa payment data — giữ record giao dịch, anonymize PII."""
        logger.info("Đã anonymize payment data cho entity '%s'", request.target_entity_id)

    def _erase_profile_data(self, request: ErasureRequestModel) -> None:
        """Xóa profile data — xóa hoàn toàn thông tin cá nhân."""
        logger.info("Đã xóa profile data cho entity '%s'", request.target_entity_id)

    def exempt_erasure_request(
        self,
        request_id: str,
        exemption_reason: str,
    ) -> ErasureRequestRead:
        """
        Miễn yêu cầu xóa — giữ lại dữ liệu vì lý do pháp lý.

        Chuyển trạng thái yêu cầu sang EXEMPTED và ghi lại
        lý do miễn để audit trail.

        Args:
            request_id: UUID của yêu cầu xóa.
            exemption_reason: Lý do miễn xóa.

        Returns:
            ErasureRequestRead đã cập nhật.

        Raises:
            ValueError: Nếu không tìm thấy hoặc đã được xử lý.
        """
        request = (
            self.db.query(ErasureRequestModel)
            .filter(ErasureRequestModel.id == request_id)
            .first()
        )
        if not request:
            raise ValueError(f"Không tìm thấy yêu cầu xóa với id='{request_id}'")

        if request.status in (ErasureStatus.COMPLETED, ErasureStatus.EXEMPTED):
            raise ValueError(
                f"Không thể miễn yêu cầu '{request_id}' "
                f"vì đã ở trạng thái {request.status.value}"
            )

        request.status = ErasureStatus.EXEMPTED
        request.exemption_reason = exemption_reason
        request.completed_at = datetime.now(timezone.utc)
        self.db.commit()
        self.db.refresh(request)

        logger.info(
            "Đã miễn yêu cầu xóa '%s': reason='%s'",
            request_id,
            exemption_reason[:100],
        )

        return ErasureRequestRead.model_validate(request)


