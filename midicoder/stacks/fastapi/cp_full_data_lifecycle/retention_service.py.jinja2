class ArchiveService:
    """
    Service quản lý việc lưu trữ dữ liệu vào kho lạnh.

    Xử lý toàn bộ quy trình lưu trữ: tạo bản ghi archived record,
    di chuyển dữ liệu, xác minh checksum, và cập nhật trạng thái.
    """

    def __init__(self, db: Session) -> None:
        """
        Khởi tạo ArchiveService.

        Args:
            db: SQLAlchemy Session.
        """
        self.db: Session = db

    def create_archive_record(
        self,
        policy_id: uuid.UUID,
        source_entity_type: str,
        source_entity_id: str,
        archive_location: str,
        archive_data: bytes,
        archive_format: str = "json",
        initiated_by: str = "system",
    ) -> ArchivedRecordRead:
        """
        Tạo bản ghi lưu trữ mới và xử lý dữ liệu.

        Tính checksum SHA-256 từ dữ liệu gốc, tạo bản ghi PENDING,
        sau đó cập nhật sang COMPLETED khi lưu trữ thành công.

        Args:
            policy_id: UUID của chính sách đã áp dụng.
            source_entity_type: Loại thực thể gốc.
            source_entity_id: ID của thực thể gốc.
            archive_location: Vị trí lưu trữ (S3 path, cold storage URL).
            archive_data: Dữ liệu thô cần lưu trữ.
            archive_format: Định dạng lưu trữ (json, parquet, avro, csv).
            initiated_by: Người/quy trình khởi tạo.

        Returns:
            ArchivedRecordRead với thông tin bản ghi lưu trữ.

        Raises:
            ValueError: Nếu chính sách không tồn tại.
        """
        # Kiểm tra chính sách tồn tại
        policy = self.db.query(RetentionPolicyModel).filter(RetentionPolicyModel.id == policy_id).first()
        if not policy:
            raise ValueError(f"Không tìm thấy chính sách với id='{policy_id}'")

        # Tính checksum
        checksum = hashlib.sha256(archive_data).hexdigest()
        archive_size = len(archive_data)

        # Tạo bản ghi lưu trữ
        record = ArchivedRecordModel(
            policy_id=policy_id,
            source_entity_type=source_entity_type,
            source_entity_id=source_entity_id,
            archive_location=archive_location,
            archive_size_bytes=archive_size,
            archive_format=archive_format,
            checksum=checksum,
            status=ArchiveStatus.PENDING,
            initiated_by=initiated_by,
            metadata={
                "original_policy": policy.policy_id,
                "action": policy.action.value,
            },
        )
        self.db.add(record)
        self.db.commit()
        self.db.refresh(record)

        # Cập nhật trạng thái sang COMPLETED (giả sử lưu trữ thành công)
        record.status = ArchiveStatus.COMPLETED
        record.completed_at = datetime.now(timezone.utc)
        self.db.commit()
        self.db.refresh(record)

        logger.info(
            "Đã lưu trữ thành công: entity='%s:%s', location='%s', "
            "size=%d bytes, checksum=%s",
            source_entity_type,
            source_entity_id,
            archive_location,
            archive_size,
            checksum[:16],
        )

        return ArchivedRecordRead.model_validate(record)

    def get_archive_record(self, record_id: str) -> ArchivedRecordRead:
        """
        Lấy thông tin bản ghi lưu trữ theo ID.

        Args:
            record_id: UUID của bản ghi lưu trữ.

        Returns:
            ArchivedRecordRead.

        Raises:
            ValueError: Nếu không tìm thấy.
        """
        record = (
