class ExemptionService:
    """
    Service quản lý việc miễn áp dụng chính sách retention.

    Cho phép tạo bản ghi miễn để bảo vệ dữ liệu cụ thể khỏi
    bị archive/purge/erase theo chính sách retention.
    """

    def __init__(self, db: Session) -> None:
        """
        Khởi tạo ExemptionService.

        Args:
            db: SQLAlchemy Session.
        """
        self.db: Session = db

    def create_exemption(self, data: ExemptionRequest, initiated_by: str = "admin") -> ExemptionRead:
        """
        Tạo bản ghi miễn retention cho thực thể cụ thể.

        Args:
            data: Dữ liệu yêu cầu miễn.
            initiated_by: Người tạo miễn.

        Returns:
            ExemptionRead với thông tin bản miễn mới.
        """
        exemption_id = str(uuid.uuid4())

        now = datetime.now(timezone.utc)

        exemption = ExemptionRead(
            id=exemption_id,
            entity_type=data.entity_type,
            entity_id=data.entity_id,
            reason=data.reason,
            expires_at=data.expires_at,
            initiated_by=initiated_by,
            metadata=data.metadata or {},
            created_at=now,
        )

        logger.info(
            "Đã tạo bản miễn retention: entity='%s:%s', reason='%s', expires_at=%s",
            exemption.entity_type,
            exemption.entity_id,
            exemption.reason[:100],
            exemption.expires_at.isoformat() if exemption.expires_at else "vô thời hạn",
        )

        return exemption

    def is_exempted(self, entity_type: str, entity_id: str) -> bool:
        """
        Kiểm tra xem thực thể có được miễn retention không.

        Tra cứu trong các erasure requests đã được EXEMPTED
        để xác định nếu thực thể được miễn xóa.

        Args:
            entity_type: Loại thực thể.
            entity_id: ID của thực thể.

        Returns:
            True nếu thực thể được miễn, False nếu không.
        """
        exempted_count = (
            self.db.query(ErasureRequestModel)
            .filter(
                ErasureRequestModel.target_entity_type == entity_type,
                ErasureRequestModel.target_entity_id == entity_id,
                ErasureRequestModel.status == ErasureStatus.EXEMPTED,
            )
            .count()
        )
        return exempted_count > 0


