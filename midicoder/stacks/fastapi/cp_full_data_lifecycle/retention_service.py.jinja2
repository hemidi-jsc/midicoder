        )

        return ArchivedRecordRead.model_validate(record)

    def archive_batch(
        self,
        policy_id: uuid.UUID,
        entities: list[dict[str, Any]],
        initiated_by: str = "scheduler",
    ) -> dict[str, int]:
        """
        Lưu trữ batch các thực thể cùng lúc.

        Xử lý từng thực thể trong batch, tạo archived record cho mỗi cái,
        và thống kê kết quả (thành công/thất bại).

        Args:
            policy_id: UUID của chính sách áp dụng.
            entities: Danh sách dict chứa entity_type, entity_id, data cho mỗi thực thể.
            initiated_by: Người/quy trình khởi tạo.

        Returns:
            Dict chứa số lượng processed, failed, total.
        """
        processed = 0
        failed = 0

        for entity in entities:
            try:
                self.create_archive_record(
                    policy_id=policy_id,
                    source_entity_type=entity["entity_type"],
                    source_entity_id=entity["entity_id"],
                    archive_location=entity.get("archive_location", f"archive/{entity['entity_type']}/{entity['entity_id']}"),
                    archive_data=entity.get("data", b""),
                    archive_format=entity.get("format", "json"),
                    initiated_by=initiated_by,
                )
                processed += 1
            except Exception as e:
                failed += 1
                logger.error(
                    "Lỗi khi lưu trữ entity '%s:%s': %s",
                    entity.get("entity_type"),
                    entity.get("entity_id"),
                    str(e),
                )

        logger.info(
            "Batch archive hoàn tất: processed=%d, failed=%d, total=%d",
            processed,
            failed,
            len(entities),
        )

        return {
            "processed": processed,
            "failed": failed,
            "total": len(entities),
        }


