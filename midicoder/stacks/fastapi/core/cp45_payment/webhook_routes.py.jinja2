"""
Routes cho Payment Webhook.

Tự động generate — không sửa tay.

Endpoints:
{%- for provider in providers %}
{%- if provider == "stripe" %}
- POST /api/payment/webhooks/stripe — Stripe webhook receiver
{%- elif provider == "paypal" %}
- POST /api/payment/webhooks/paypal — PayPal webhook receiver
{%- endif %}
{%- endfor %}

Auth: Webhook signature verification (không dùng JWT).
Idempotency: Tự động deduplicate events.

CP45: Payment Gateway Abstraction
"""

from __future__ import annotations

import json
import logging
from typing import Any

from fastapi import APIRouter, Request, HTTPException

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/api/payment/webhooks", tags=["Payment Webhooks"])

{%- if "stripe" in providers %}

# ============================================================================
# Stripe Webhook
# ============================================================================

# Import handler — thực tế sẽ import từ webhook_handler module
# from app.services.webhook_handler import StripeWebhookHandler

STRIPE_WEBHOOK_SECRET = getattr(
    __import__("os", fromlist=["environ"]).environ,
    "get",
    lambda x, d=None: d,
)("STRIPE_WEBHOOK_SECRET", "whsec_placeholder")


@router.post(
    "/stripe",
    summary="Stripe Webhook Receiver",
    description="Nhận và xử lý webhook events từ Stripe.",
)
async def stripe_webhook(request: Request) -> dict[str, Any]:
    """
    Stripe webhook endpoint.

    Xử lý các events:
    - payment_intent.succeeded
    - payment_intent.payment_failed
    - charge.refunded
    - customer.subscription.*

    Signature verification được thực hiện trước khi xử lý event.
    """
    # Get raw body
    body = await request.body()
    signature = request.headers.get("stripe-signature", "")
    timestamp = request.headers.get("stripe-signature", "").split("t=")

    # Parse timestamp from signature
    timestamp_value: str | None = None
    for part in signature.split(","):
        if part.startswith("t="):
            timestamp_value = part.split("=", 1)[1]
            break

    # Import handler
    from app.services.webhook_handler import StripeWebhookHandler

    handler = StripeWebhookHandler(
        secret=STRIPE_WEBHOOK_SECRET,
        tolerance=300,
    )

    # Verify signature
    if not handler.verify_signature(body, signature, timestamp_value):
        logger.warning("Stripe webhook signature không hợp lệ")
        raise HTTPException(status_code=400, detail="Invalid signature")

    # Parse event
    event = json.loads(body.decode("utf-8"))
    event_id = event.get("id", "unknown")

    # Idempotency check
    from app.services.webhook_handler import WebhookIdempotencyStore

    idempotency = WebhookIdempotencyStore()
    if idempotency.is_processed(event_id):
        logger.info("Stripe event đã xử lý rồi: %s", event_id)
        return {"status": "already_processed", "event_id": event_id}

    # Handle event
    try:
        result = await handler.handle_event(event)
        idempotency.mark_processed(event_id)
        return result
    except Exception as e:
        logger.error("Lỗi xử lý Stripe event: %s", str(e))
        raise HTTPException(status_code=500, detail=f"Webhook processing error: {str(e)}")


{%- endif %}

{%- if "paypal" in providers %}

# ============================================================================
# PayPal Webhook
# ============================================================================


@router.post(
    "/paypal",
    summary="PayPal Webhook Receiver",
    description="Nhận và xử lý webhook events từ PayPal.",
)
async def paypal_webhook(request: Request) -> dict[str, Any]:
    """
    PayPal webhook endpoint.

    Xử lý các events:
    - PAYMENT.CAPTURE.COMPLETED
    - PAYMENT.CAPTURE.DENIED
    - PAYMENT.CAPTURE.REFUNDED
    - BILLING.SUBSCRIPTION.*
    """
    body = await request.body()
    headers = dict(request.headers)

    # Parse event
    event = json.loads(body.decode("utf-8"))

    # Import handler
    from app.services.webhook_handler import PayPalWebhookHandler

    handler = PayPalWebhookHandler(
        webhook_id="paypal_webhook_id",
        client_id="paypal_client_id",
        client_secret="paypal_client_secret",
    )

    # Verify webhook
    if not await handler.verify_webhook(event, headers):
        logger.warning("PayPal webhook không hợp lệ")
        raise HTTPException(status_code=400, detail="Invalid webhook")

    # Handle event
    try:
        result = await handler.handle_event(event)
        return result
    except Exception as e:
        logger.error("Lỗi xử lý PayPal event: %s", str(e))
        raise HTTPException(status_code=500, detail=f"Webhook processing error: {str(e)}")


{%- endif %}
