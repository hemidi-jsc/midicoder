    def create_gateway_config(
        self,
        data: "PaymentGatewayConfigCreate",
    ) -> PaymentGatewayConfigRead:
        """
        Tạo cấu hình payment gateway mới.

        Args:
            data: Dữ liệu tạo cấu hình.

        Returns:
            PaymentGatewayConfigRead.
        """
        config = PaymentGatewayConfigModel(
            provider=data.provider,
            display_name=data.display_name,
            environment=data.environment,
            is_active=data.is_active,
            is_default=data.is_default,
            api_key_reference=data.api_key_reference,
            secret_key_reference=data.secret_key_reference,
            webhook_secret_reference=data.webhook_secret_reference,
            endpoint_url=data.endpoint_url,
            webhook_url=data.webhook_url,
            max_amount=data.max_amount,
            min_amount=data.min_amount,
            supported_currencies=data.supported_currencies or [],
            supported_methods=data.supported_methods or [],
            config_params=data.config_params or {},
            tenant_id=data.tenant_id,
            metadata=data.metadata or {},
        )

        self.db.add(config)
        self.db.commit()
        self.db.refresh(config)

        self._audit_log(
            "gateway_config_created",
            str(config.config_id),
            provider=config.provider.value,
        )

        return PaymentGatewayConfigRead.model_validate(config)

    def list_gateway_configs(
        self,
        tenant_id: str = "default",
        active_only: bool = True,
    ) -> list[PaymentGatewayConfigRead]:
        """
        Liệt kê cấu hình gateway của tenant.

        Args:
            tenant_id: Tenant ID.
            active_only: Chỉ lấy cấu hình đang hoạt động.

        Returns:
            List của PaymentGatewayConfigRead.
        """
        query = self.db.query(PaymentGatewayConfigModel).filter(
            PaymentGatewayConfigModel.tenant_id == tenant_id
        )

        if active_only:
            query = query.filter(PaymentGatewayConfigModel.is_active == True)

        configs = query.order_by(
            PaymentGatewayConfigModel.is_default.desc(),
            PaymentGatewayConfigModel.provider,
        ).all()

        return [PaymentGatewayConfigRead.model_validate(c) for c in configs]

    # ========================================================================
    # Summary — Thống kê tổng hợp
    # ========================================================================

    def get_payment_summary(
        self,
        tenant_id: str = "default",
        from_date: datetime | None = None,
        to_date: datetime | None = None,
    ) -> PaymentSummary:
        """
        Tính toán tổng hợp thống kê giao dịch thanh toán.

        Args:
            tenant_id: Tenant ID để lọc.
            from_date: Bắt đầu khoảng thời gian.
            to_date: Kết thúc khoảng thời gian.

        Returns:
            PaymentSummary với các số liệu thống kê.
        """
        if from_date is None:
            from_date = datetime.now(timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0)
        if to_date is None:
            to_date = datetime.now(timezone.utc)

        query = self.db.query(PaymentTransactionModel).filter(
            and_(
                PaymentTransactionModel.tenant_id == tenant_id,
                PaymentTransactionModel.created_at >= from_date,
                PaymentTransactionModel.created_at <= to_date,
            )
        )

        all_transactions = query.all()

        total = len(all_transactions)
        completed = [t for t in all_transactions if t.status == PaymentStatus.COMPLETED]
        failed = [t for t in all_transactions if t.status == PaymentStatus.FAILED]
        pending = [t for t in all_transactions if t.status == PaymentStatus.PENDING]

        total_amount = sum(t.amount for t in all_transactions)
        successful_amount = sum(t.amount for t in completed)
        failed_amount = sum(t.amount for t in failed)

        # Tính tổng hoàn tiền
        refunded_amount = 0
        for t in all_transactions:
            if t.status == PaymentStatus.REFUNDED:
                refunded_amount += sum(r.refund_amount for r in t.refunds)

        success_rate = round((len(completed) / total) * 100, 2) if total > 0 else 0.0

        return PaymentSummary(
            total_transactions=total,
            total_amount=total_amount,
            successful_amount=successful_amount,
            failed_amount=failed_amount,
            refunded_amount=refunded_amount,
            pending_count=len(pending),
            success_rate=success_rate,
            period_start=from_date,
            period_end=to_date,
        )

