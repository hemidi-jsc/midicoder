class PaymentService:
    """
    Service layer chính cho payment gateway.

    Quản lý toàn bộ vòng đời của giao dịch thanh toán:
    - Tạo giao dịch mới (với idempotency protection)
    - Xử lý thanh toán qua gateway strategy
    - Hoàn tiền (full/partial)
    - Tra cứu và liệt kê giao dịch
    - Quản lý phương thức thanh toán
    - Quản lý cấu hình gateway
    - Thống kê tổng hợp

    Attributes:
        db: SQLAlchemy Session.
        registry: GatewayStrategyRegistry để lựa chọn handler.
    """

    def __init__(self, db: Session) -> None:
        """Khởi tạo PaymentService.

        Args:
            db: SQLAlchemy Session.
        """
        self.db: Session = db
        self.registry: GatewayStrategyRegistry = GatewayStrategyRegistry()

    # ========================================================================
    # State Machine — Quản lý chuyển trạng thái
    # ========================================================================

    def _validate_status_transition(
        self,
        current: PaymentStatus,
        next_status: PaymentStatus,
    ) -> bool:
        """
        Kiểm tra chuyển trạng thái có hợp lệ trong state machine.

        Chuyển trạng thái hợp lệ:
          pending -> processing, failed, cancelled
          processing -> completed, failed
          completed -> refunded
          expired  -> (không chuyển tiếp được)

        Args:
            current: Trạng thái hiện tại.
            next_status: Trạng thái muốn chuyển sang.

        Returns:
            True nếu chuyển trạng thái hợp lệ, False nếu không.
        """
        valid_transitions: dict[PaymentStatus, list[PaymentStatus]] = {
            PaymentStatus.PENDING: [
                PaymentStatus.PROCESSING,
                PaymentStatus.FAILED,
                PaymentStatus.CANCELLED,
                PaymentStatus.EXPIRED,
            ],
            PaymentStatus.PROCESSING: [
                PaymentStatus.COMPLETED,
                PaymentStatus.FAILED,
            ],
            PaymentStatus.COMPLETED: [
                PaymentStatus.REFUNDED,
            ],
            PaymentStatus.FAILED: [],
            PaymentStatus.REFUNDED: [],
            PaymentStatus.CANCELLED: [],
            PaymentStatus.EXPIRED: [],
        }

        allowed = valid_transitions.get(current, [])
        is_valid = next_status in allowed

        if not is_valid:
            logger.warning(
                "Chuyển trạng thái không hợp lệ: %s -> %s (cho phép: %s)",
                current.value,
                next_status.value,
                [s.value for s in allowed],
            )

        return is_valid

    def _transition_status(
        self,
        transaction: PaymentTransactionModel,
        new_status: PaymentStatus,
    ) -> PaymentTransactionModel:
        """
        Chuyển trạng thái giao dịch một cách an toàn.

        Kiểm tra tính hợp lệ của chuyển trạng thái trước khi cập nhật.
        Tự động cập nhật paid_at khi chuyển sang COMPLETED.

        Args:
            transaction: Giao dịch cần cập nhật.
            new_status: Trạng thái mới.

        Returns:
            PaymentTransactionModel đã cập nhật.

        Raises:
            MidicoderError: Nếu chuyển trạng thái không hợp lệ.
        """
        if not self._validate_status_transition(transaction.status, new_status):
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_INVALID_STATUS_TRANSITION,
                transaction_id=str(transaction.transaction_id),
                current_status=transaction.status.value,
                requested_status=new_status.value,
            )

        transaction.status = new_status
        transaction.updated_at = datetime.now(timezone.utc)

        if new_status == PaymentStatus.COMPLETED:
            transaction.paid_at = datetime.now(timezone.utc)

        self.db.commit()
        self.db.refresh(transaction)

        logger.info(
            "Giao dịch %s chuyển trạng thái: %s -> %s",
            transaction.transaction_id,
            transaction.status.value,
            new_status.value,
        )

        return transaction

    # ========================================================================
    # Idempotency — Chỉ bật khi enable_idempotency
    # ========================================================================

{% if enable_idempotency %}
    def _check_idempotency(
        self,
        idempotency_key: str,
        tenant_id: str,
    ) -> PaymentTransactionRead | None:
        """
        Kiểm tra idempotency key — nếu đã tồn tại, trả về giao dịch cũ.

        Đảm bảo idempotent behavior: cùng một key chỉ tạo một giao dịch duy nhất,
        ngay cả khi client gửi request nhiều lần.

        Args:
            idempotency_key: Idempotency key từ client.
            tenant_id: Tenant ID để isolation.

        Returns:
            PaymentTransactionRead nếu key đã tồn tại, None nếu chưa.
        """
        existing = (
            self.db.query(IdempotencyKeyModel)
            .filter(
                and_(
                    IdempotencyKeyModel.key_value == idempotency_key,
                    IdempotencyKeyModel.tenant_id == tenant_id,
                )
            )
            .first()
        )

        if existing:
            # Key đã tồn tại — trả về giao dịch cũ
            if existing.transaction_id:
                transaction = (
                    self.db.query(PaymentTransactionModel)
                    .filter(PaymentTransactionModel.transaction_id == existing.transaction_id)
                    .first()
                )
                if transaction:
                    logger.info(
                        "Idempotency key %s đã tồn tại — trả về giao dịch cũ %s",
                        idempotency_key,
                        transaction.transaction_id,
                    )
                    return PaymentTransactionRead.model_validate(transaction)

            return None

        return None

    def _save_idempotency_key(
        self,
        idempotency_key: str,
        transaction: PaymentTransactionModel,
        ttl_hours: int = 24,
    ) -> IdempotencyKeyModel:
        """
        Lưu idempotency key kèm transaction_id đã xử lý.

        Args:
            idempotency_key: Idempotency key cần lưu.
            transaction: Giao dịch đã tạo thành công.
            ttl_hours: Thời gian sống của key (mặc định 24 giờ).

        Returns:
            IdempotencyKeyModel đã lưu.
        """
        key_model = IdempotencyKeyModel(
            key_value=idempotency_key,
            transaction_id=transaction.transaction_id,
            request_method="POST",
            tenant_id=transaction.tenant_id,
            customer_id=transaction.customer_id,
            expires_at=datetime.now(timezone.utc) + timedelta(hours=ttl_hours),
        )

        self.db.add(key_model)
        self.db.commit()
        self.db.refresh(key_model)

        logger.debug(
            "Đã lưu idempotency key %s (ttl=%dh, txn=%s)",
            idempotency_key,
            ttl_hours,
            transaction.transaction_id,
        )

        return key_model

