# ============================================================================
# Gateway Registry — Đăng ký và lấy strategy theo provider
# ============================================================================


class GatewayStrategyRegistry:
    """
    Registry cho các gateway strategy.

    Quản lý danh sách các handler đã đăng ký và trả về handler
    phù hợp dựa trên PaymentGatewayProvider.

    Usage:
        registry = GatewayStrategyRegistry()
        handler = registry.get_handler(PaymentGatewayProvider.STRIPE)
    """

    def __init__(self) -> None:
        """Khởi tạo registry với các handler mặc định."""
        self._handlers: dict[PaymentGatewayProvider, PaymentGatewayStrategy] = {}
        self._register_defaults()

    def _register_defaults(self) -> None:
        """Đăng ký các gateway handler mặc định."""
        self.register(StripeGatewayHandler())
        self.register(VNPayGatewayHandler())
        self.register(MoMoGatewayHandler())

    def register(self, handler: PaymentGatewayStrategy) -> None:
        """
        Đăng ký một gateway handler mới.

        Args:
            handler: PaymentGatewayStrategy implementation.
        """
        self._handlers[handler.provider] = handler
        logger.info("Đã đăng ký gateway handler: %s", handler.provider.value)

    def get_handler(self, provider: PaymentGatewayProvider) -> PaymentGatewayStrategy:
        """
        Lấy gateway handler theo provider.

        Args:
            provider: Nhà cung cấp gateway.

        Returns:
            PaymentGatewayStrategy phù hợp.

        Raises:
            MidicoderError: Nếu provider không được hỗ trợ.
        """
        handler = self._handlers.get(provider)
        if not handler:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_GATEWAY_NOT_SUPPORTED,
                provider=provider.value,
                supported=list(p.value for p in self._handlers.keys()),
            )
        return handler

    def list_supported_providers(self) -> list[PaymentGatewayProvider]:
        """Trả về danh sách các provider được hỗ trợ."""
        return list(self._handlers.keys())


