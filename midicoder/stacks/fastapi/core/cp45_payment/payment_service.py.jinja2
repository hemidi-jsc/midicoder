    # ========================================================================
    # Reference Code Generator
    # ========================================================================

    def _generate_reference_code(self, prefix: str = "PAY") -> str:
        """
        Tạo mã tham chiếu duy nhất cho giao dịch.

        Định dạng: {PREFIX}-{YYYY}-{SEQ} (VD: PAY-2026-0001)

        Args:
            prefix: Tiền tố của mã (PAY cho giao dịch, REF cho hoàn tiền).

        Returns:
            Mã tham chiếu duy nhất.
        """
        now = datetime.now(timezone.utc)
        year = now.strftime("%Y")
        # Tạo sequence dựa trên timestamp để đảm bảo duy nhất
        seq = now.strftime("%m%d%H%M%S")
        return f"{prefix}-{year}-{seq}"

    # ========================================================================
    # Gateway Config Selection
    # ========================================================================

    def _get_gateway_config(
        self,
        provider: PaymentGatewayProvider,
        tenant_id: str,
        environment: str = "production",
    ) -> PaymentGatewayConfigModel:
        """
        Lấy cấu hình gateway phù hợp cho provider và tenant.

        Ưu tiên:
        1. Cấu hình active, đúng provider, đúng tenant, đúng environment
        2. Cấu hình default nếu không tìm thấy cấu hình cụ thể

        Args:
            provider: Nhà cung cấp gateway.
            tenant_id: Tenant ID.
            environment: Môi trường (production, sandbox).

        Returns:
            PaymentGatewayConfigModel phù hợp.

        Raises:
            MidicoderError: Nếu không tìm thấy cấu hình phù hợp.
        """
        config = (
            self.db.query(PaymentGatewayConfigModel)
            .filter(
                and_(
                    PaymentGatewayConfigModel.provider == provider,
                    PaymentGatewayConfigModel.tenant_id == tenant_id,
                    PaymentGatewayConfigModel.environment == environment,
                    PaymentGatewayConfigModel.is_active == True,
                )
            )
            .first()
        )

        if not config:
            # Fallback: lấy cấu hình default
            config = (
                self.db.query(PaymentGatewayConfigModel)
                .filter(
                    and_(
                        PaymentGatewayConfigModel.provider == provider,
                        PaymentGatewayConfigModel.tenant_id == tenant_id,
                        PaymentGatewayConfigModel.is_default == True,
                        PaymentGatewayConfigModel.is_active == True,
                    )
                )
                .first()
            )

        if not config:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_GATEWAY_CONFIG_NOT_FOUND,
                provider=provider.value,
                tenant_id=tenant_id,
                environment=environment,
            )

        return config

    # ========================================================================
    # Payment Transaction CRUD
    # ========================================================================

    async def create_payment(
        self,
        data: PaymentTransactionCreate,
    ) -> PaymentTransactionRead:
        """
        Tạo giao dịch thanh toán mới và gửi đến gateway provider.

        Quy trình:
        1. Kiểm tra idempotency key (nếu bật)
        2. Validate số tiền theo giới hạn của gateway config
        3. Tạo PaymentTransactionModel với trạng thái PENDING
        4. Lấy gateway handler theo strategy pattern
        5. Gọi gateway handler.create_payment()
        6. Cập nhật giao dịch với gateway response
        7. Chuyển trạng thái sang PROCESSING
        8. Lưu idempotency key
        9. Emit event và audit log

        Args:
            data: Dữ liệu tạo giao dịch từ client.

        Returns:
            PaymentTransactionRead với thông tin giao dịch mới.

        Raises:
            MidicoderError: Nếu số tiền không hợp lệ, gateway lỗi, hoặc idempotency key trùng.
        """
        # Bước 1: Kiểm tra idempotency
        if data.idempotency_key:
            existing = self._check_idempotency(data.idempotency_key, data.tenant_id)
            if existing:
                return existing

        # Bước 2: Lấy và validate gateway config
        config = self._get_gateway_config(data.gateway_provider, data.tenant_id)

        # Validate số tiền theo giới hạn
        if config.min_amount and data.amount < config.min_amount:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_AMOUNT_BELOW_MINIMUM,
                min_amount=config.min_amount,
                requested_amount=data.amount,
            )
        if config.max_amount and data.amount > config.max_amount:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_AMOUNT_ABOVE_MAXIMUM,
                max_amount=config.max_amount,
                requested_amount=data.amount,
            )

        # Bước 3: Tạo PaymentTransactionModel
        reference_code = self._generate_reference_code("PAY")
        transaction = PaymentTransactionModel(
            reference_code=reference_code,
            amount=data.amount,
            currency=data.currency,
            customer_id=data.customer_id,
            customer_email=data.customer_email,
            customer_phone=data.customer_phone,
            gateway_provider=data.gateway_provider,
            payment_method_type=data.payment_method_type,
            payment_method_id=data.payment_method_id,
            intent=data.intent,
            direction=PaymentDirection.PAYMENT,
            status=PaymentStatus.PENDING,
            description=data.description,
            order_id=data.order_id,
            subscription_id=data.subscription_id,
            redirect_url=data.redirect_url,
            callback_url=data.callback_url,
            tenant_id=data.tenant_id,
            metadata=data.metadata or {},
{% if enable_idempotency %}
            idempotency_key=data.idempotency_key,
{% endif %}
        )

        self.db.add(transaction)
        self.db.commit()
        self.db.refresh(transaction)

        # Bước 4-5: Lấy gateway handler và gọi create_payment
        handler = self.registry.get_handler(data.gateway_provider)

        try:
            gateway_response = await handler.create_payment(transaction, config)

            # Bước 6: Cập nhật giao dịch với gateway response
            transaction.gateway_transaction_id = gateway_response.get("gateway_transaction_id")
            transaction.gateway_request_data = {
                "amount": data.amount,
                "currency": data.currency.value,
                "intent": data.intent.value,
            }
            transaction.gateway_response_data = gateway_response

            if gateway_response.get("redirect_url"):
                transaction.redirect_url = gateway_response["redirect_url"]

            # Bước 7: Chuyển trạng thái sang PROCESSING
            self._transition_status(transaction, PaymentStatus.PROCESSING)

        except Exception as e:
            # Gateway trả về lỗi — cập nhật giao dịch sang FAILED
            transaction.error_code = getattr(e, "code", "GATEWAY_ERROR")
            transaction.error_message = str(e)
            transaction.gateway_response_data = {"error": str(e)}
            self._transition_status(transaction, PaymentStatus.FAILED)
            self.db.commit()

            logger.exception("Giao dịch %s thất bại khi gọi gateway: %s", transaction.transaction_id, str(e))
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_GATEWAY_ERROR,
                provider=data.gateway_provider.value,
                error=str(e),
            )

        # Bước 8: Lưu idempotency key
        if data.idempotency_key:
            self._save_idempotency_key(data.idempotency_key, transaction)

        # Bước 9: Emit event
        self._emit_event(
            "payment.created",
            str(transaction.transaction_id),
            amount=transaction.amount,
            provider=transaction.gateway_provider.value,
        )

        # Audit log
        self._audit_log(
            "payment_created",
            str(transaction.transaction_id),
            amount=transaction.amount,
            provider=transaction.gateway_provider.value,
        )

        return PaymentTransactionRead.model_validate(transaction)

    def get_transaction(self, transaction_id: str) -> PaymentTransactionRead:
        """
        Lấy thông tin chi tiết của một giao dịch thanh toán.

        Args:
            transaction_id: ID của giao dịch.

        Returns:
            PaymentTransactionRead với đầy đủ thông tin.

        Raises:
            MidicoderError: Nếu giao dịch không tồn tại.
        """
        transaction = (
            self.db.query(PaymentTransactionModel)
            .filter(PaymentTransactionModel.transaction_id == transaction_id)
            .first()
        )

        if not transaction:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_TRANSACTION_NOT_FOUND,
                transaction_id=transaction_id,
            )

        return PaymentTransactionRead.model_validate(transaction)

    def list_transactions(
        self,
        filter_data: PaymentTransactionFilter,
    ) -> PaymentTransactionList:
        """
        Liệt kê giao dịch thanh toán với bộ lọc và phân trang.

        Args:
            filter_data: PaymentTransactionFilter chứa các tham số lọc.

        Returns:
            PaymentTransactionList với items và phân trang.
        """
        query = self.db.query(PaymentTransactionModel)

        # Áp dụng các bộ lọc
        if filter_data.status:
            query = query.filter(PaymentTransactionModel.status == filter_data.status.value)
        if filter_data.customer_id:
            query = query.filter(PaymentTransactionModel.customer_id == filter_data.customer_id)
        if filter_data.gateway_provider:
            query = query.filter(PaymentTransactionModel.gateway_provider == filter_data.gateway_provider.value)
        if filter_data.payment_method_type:
            query = query.filter(PaymentTransactionModel.payment_method_type == filter_data.payment_method_type.value)
        if filter_data.order_id:
            query = query.filter(PaymentTransactionModel.order_id == filter_data.order_id)
        if filter_data.tenant_id:
            query = query.filter(PaymentTransactionModel.tenant_id == filter_data.tenant_id)
        if filter_data.from_date:
            query = query.filter(PaymentTransactionModel.created_at >= filter_data.from_date)
        if filter_data.to_date:
            query = query.filter(PaymentTransactionModel.created_at <= filter_data.to_date)
        if filter_data.min_amount is not None:
            query = query.filter(PaymentTransactionModel.amount >= filter_data.min_amount)
        if filter_data.max_amount is not None:
            query = query.filter(PaymentTransactionModel.amount <= filter_data.max_amount)

        # Đếm tổng số
        total = query.count()

        # Phân trang
        offset = (filter_data.page - 1) * filter_data.page_size
        items = (
            query.order_by(PaymentTransactionModel.created_at.desc())
            .offset(offset)
            .limit(filter_data.page_size)
            .all()
        )

        # Tính tổng số tiền trong trang
        total_amount = sum(t.amount for t in items)

        return PaymentTransactionList(
            items=[PaymentTransactionRead.model_validate(t) for t in items],
            total=total,
            page=filter_data.page,
            page_size=filter_data.page_size,
            total_amount=total_amount,
            currency="VND",
        )

    async def cancel_payment(self, transaction_id: str) -> PaymentTransactionRead:
        """
        Hủy giao dịch thanh toán.

        Chỉ cho phép hủy giao dịch ở trạng thái PENDING hoặc PROCESSING.
        Nếu gateway đã capture, cần gọi cancel API của gateway.

        Args:
            transaction_id: ID của giao dịch cần hủy.

        Returns:
            PaymentTransactionRead với trạng thái CANCELLED.

        Raises:
            MidicoderError: Nếu giao dịch không tồn tại hoặc không thể hủy.
        """
        transaction = (
            self.db.query(PaymentTransactionModel)
            .filter(PaymentTransactionModel.transaction_id == transaction_id)
            .first()
        )

        if not transaction:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_TRANSACTION_NOT_FOUND,
                transaction_id=transaction_id,
            )

        if transaction.status not in (PaymentStatus.PENDING, PaymentStatus.PROCESSING):
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_CANNOT_CANCEL,
                transaction_id=transaction_id,
                current_status=transaction.status.value,
            )

        # Gọi gateway cancel API
        config = self._get_gateway_config(transaction.gateway_provider, transaction.tenant_id)
        handler = self.registry.get_handler(transaction.gateway_provider)

        try:
            await handler.cancel_payment(transaction, config)
        except Exception as e:
            logger.warning(
                "Gateway cancel API thất bại cho giao dịch %s: %s (vẫn hủy ở DB)",
                transaction_id,
                str(e),
            )

        # Cập nhật trạng thái
        self._transition_status(transaction, PaymentStatus.CANCELLED)

        self._emit_event("payment.cancelled", str(transaction.transaction_id))
        self._audit_log("payment_cancelled", str(transaction.transaction_id))

        return PaymentTransactionRead.model_validate(transaction)

    async def poll_payment_status(
        self,
        transaction_id: str,
    ) -> PaymentTransactionRead:
        """
        Tra cứu lại trạng thái giao dịch từ gateway provider.

        Hữu ích khi webhook chưa nhận được — client có thể poll
        để lấy trạng thái mới nhất từ gateway.

        Args:
            transaction_id: ID của giao dịch cần tra cứu.

        Returns:
            PaymentTransactionRead đã cập nhật.
        """
        transaction = (
            self.db.query(PaymentTransactionModel)
            .filter(PaymentTransactionModel.transaction_id == transaction_id)
            .first()
        )

        if not transaction:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_TRANSACTION_NOT_FOUND,
                transaction_id=transaction_id,
            )

        if not transaction.gateway_transaction_id:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_NO_GATEWAY_TRANSACTION,
                transaction_id=transaction_id,
            )

        config = self._get_gateway_config(transaction.gateway_provider, transaction.tenant_id)
        handler = self.registry.get_handler(transaction.gateway_provider)

        try:
            status_response = await handler.get_payment_status(
                transaction.gateway_transaction_id,
                config,
            )

            # Map status từ gateway sang PaymentStatus
            gateway_status = status_response.get("status", "")
            if gateway_status in ("succeeded", "00", "completed"):
                if transaction.status in (PaymentStatus.PENDING, PaymentStatus.PROCESSING):
                    self._transition_status(transaction, PaymentStatus.COMPLETED)
            elif gateway_status in ("failed", "01", "error"):
                if transaction.status in (PaymentStatus.PENDING, PaymentStatus.PROCESSING):
                    transaction.error_message = status_response.get("error_message")
                    self._transition_status(transaction, PaymentStatus.FAILED)

            self.db.commit()
            self.db.refresh(transaction)

        except Exception as e:
            logger.exception(
                "Poll status thất bại cho giao dịch %s: %s",
                transaction_id,
                str(e),
            )

        return PaymentTransactionRead.model_validate(transaction)

    # ========================================================================
    # Refund — Hoàn tiền
    # ========================================================================

    async def create_refund(
        self,
        data: PaymentRefundCreate,
    ) -> PaymentRefundRead:
        """
        Tạo yêu cầu hoàn tiền.

        Quy trình:
        1. Kiểm tra giao dịch gốc tồn tại và có thể hoàn tiền
        2. Validate số tiền hoàn không vượt quá số tiền gốc
        3. Kiểm tra tổng hoàn tiền không vượt quá số tiền giao dịch
        4. Tạo PaymentRefundModel
        5. Gọi gateway refund API
        6. Cập nhật trạng thái giao dịch gốc sang REFUNDED (nếu full refund)

        Args:
            data: Dữ liệu tạo hoàn tiền.

        Returns:
            PaymentRefundRead với thông tin hoàn tiền mới.

        Raises:
            MidicoderError: Nếu giao dịch không tồn tại, không thể hoàn, hoặc số tiền không hợp lệ.
        """
        # Lấy giao dịch gốc
        transaction = (
            self.db.query(PaymentTransactionModel)
            .filter(PaymentTransactionModel.transaction_id == data.transaction_id)
            .first()
        )

        if not transaction:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_TRANSACTION_NOT_FOUND,
                transaction_id=data.transaction_id,
            )

        # Kiểm tra giao dịch có thể hoàn tiền không
        if transaction.status not in (PaymentStatus.COMPLETED, PaymentStatus.PROCESSING):
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_CANNOT_REFUND,
                transaction_id=data.transaction_id,
                current_status=transaction.status.value,
            )

        # Validate số tiền hoàn
        if data.refund_amount > transaction.amount:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_REFUND_EXCEEDS_AMOUNT,
                refund_amount=data.refund_amount,
                transaction_amount=transaction.amount,
            )

        # Kiểm tra tổng đã hoàn — không vượt quá số tiền giao dịch
        total_refunded = sum(
            r.refund_amount
            for r in transaction.refunds
            if r.status in (RefundStatus.COMPLETED, RefundStatus.PROCESSING)
        )
        if total_refunded + data.refund_amount > transaction.amount:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_REFUND_EXCEEDS_TOTAL,
                total_refunded=total_refunded,
                refund_amount=data.refund_amount,
                transaction_amount=transaction.amount,
            )

        # Xác định loại hoàn tiền
        if data.refund_amount >= transaction.amount:
            refund_type = RefundType.FULL
        else:
            refund_type = RefundType.PARTIAL

        # Tạo PaymentRefundModel
        reference_code = self._generate_reference_code("REF")
        refund = PaymentRefundModel(
            reference_code=reference_code,
            transaction_id=transaction.transaction_id,
            refund_amount=data.refund_amount,
            currency=transaction.currency,
            refund_type=refund_type,
            status=RefundStatus.PENDING,
            reason=data.reason,
            requested_by=data.requested_by,
            tenant_id=data.tenant_id,
            metadata=data.metadata or {},
        )

        self.db.add(refund)
        self.db.commit()
        self.db.refresh(refund)

        # Gọi gateway refund API
        config = self._get_gateway_config(transaction.gateway_provider, transaction.tenant_id)
        handler = self.registry.get_handler(transaction.gateway_provider)

        try:
            gateway_response = await handler.refund_payment(transaction, refund, config)

            refund.gateway_refund_id = gateway_response.get("gateway_refund_id")
            refund.gateway_response_data = gateway_response
            refund.status = RefundStatus.PROCESSING

            self.db.commit()
            self.db.refresh(refund)

        except Exception as e:
            refund.error_code = getattr(e, "code", "GATEWAY_ERROR")
            refund.error_message = str(e)
            refund.status = RefundStatus.FAILED
            self.db.commit()

            logger.exception("Hoàn tiền %s thất bại khi gọi gateway: %s", refund.refund_id, str(e))
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_REFUND_GATEWAY_ERROR,
                provider=transaction.gateway_provider.value,
                error=str(e),
            )

        # Emit event
        self._emit_event(
            "payment.refund.created",
            str(refund.refund_id),
            transaction_id=str(transaction.transaction_id),
            amount=refund.refund_amount,
        )

        return PaymentRefundRead.model_validate(refund)

    def get_refund(self, refund_id: str) -> PaymentRefundRead:
