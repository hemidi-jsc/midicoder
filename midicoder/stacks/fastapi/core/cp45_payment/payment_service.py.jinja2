# ============================================================================
# Strategy Interface — Giao diện trừu tượng cho gateway handler
# ============================================================================


class PaymentGatewayStrategy(abc.ABC):
    """
    Giao diện strategy cho payment gateway handler.

    Mỗi provider (Stripe, VNPay, MoMo) sẽ implement các phương thức
    trừu tượng này để xử lý giao dịch, hoàn tiền, và tra cứu trạng thái.

    Đây là abstraction layer — các handler cụ thể sẽ gọi API của provider
    tương ứng và trả về kết quả chuẩn hóa.
    """

    @property
    @abc.abstractmethod
    def provider(self) -> PaymentGatewayProvider:
        """Trả về provider này xử lý."""
        ...

    @abc.abstractmethod
    async def create_payment(
        self,
        transaction: PaymentTransactionModel,
        config: PaymentGatewayConfigModel,
    ) -> dict[str, Any]:
        """
        Tạo giao dịch thanh toán mới tại gateway provider.

        Args:
            transaction: PaymentTransactionModel cần xử lý.
            config: PaymentGatewayConfigModel chứa cấu hình kết nối.

        Returns:
            Dict với keys: gateway_transaction_id, redirect_url, status.
        """
        ...

    @abc.abstractmethod
    async def capture_payment(
        self,
        transaction: PaymentTransactionModel,
        config: PaymentGatewayConfigModel,
    ) -> dict[str, Any]:
        """
        Capture (nạp) thanh toán đã được auth.

        Args:
            transaction: Giao dịch đã được authenticate.
            config: Cấu hình gateway.

        Returns:
            Dict với keys: gateway_transaction_id, status.
        """
        ...

    @abc.abstractmethod
    async def refund_payment(
        self,
        transaction: PaymentTransactionModel,
        refund: PaymentRefundModel,
        config: PaymentGatewayConfigModel,
    ) -> dict[str, Any]:
        """
        Tạo yêu cầu hoàn tiền tại gateway provider.

        Args:
            transaction: Giao dịch gốc cần hoàn tiền.
            refund: PaymentRefundModel chứa thông tin hoàn tiền.
            config: Cấu hình gateway.

        Returns:
            Dict với keys: gateway_refund_id, status.
        """
        ...

    @abc.abstractmethod
    async def get_payment_status(
        self,
        gateway_transaction_id: str,
        config: PaymentGatewayConfigModel,
    ) -> dict[str, Any]:
        """
        Tra cứu trạng thái giao dịch từ gateway provider.

        Args:
            gateway_transaction_id: Transaction ID từ gateway.
            config: Cấu hình gateway.

        Returns:
            Dict với keys: status, amount, currency, error_message.
        """
        ...

    @abc.abstractmethod
    async def cancel_payment(
        self,
        transaction: PaymentTransactionModel,
        config: PaymentGatewayConfigModel,
    ) -> dict[str, Any]:
        """
        Hủy giao dịch thanh toán tại gateway provider.

        Args:
            transaction: Giao dịch cần hủy.
            config: Cấu hình gateway.

        Returns:
            Dict với keys: status.
        """
        ...


