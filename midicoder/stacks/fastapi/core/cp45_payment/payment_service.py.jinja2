    # ========================================================================
    # PaymentMethod CRUD
    # ========================================================================

    def create_payment_method(
        self,
        data: PaymentMethodCreate,
    ) -> PaymentMethodRead:
        """
        Đăng ký phương thức thanh toán mới.

        Nếu is_default=True, tắt is_default của các phương thức khác
        thuộc cùng customer.

        Args:
            data: Dữ liệu tạo phương thức thanh toán.

        Returns:
            PaymentMethodRead.
        """
        # Nếu đặt là default, tắt default của các phương thức khác
        if data.is_default:
            existing_methods = (
                self.db.query(PaymentMethodModel)
                .filter(
                    and_(
                        PaymentMethodModel.customer_id == data.customer_id,
                        PaymentMethodModel.is_default == True,
                    )
                )
                .all()
            )
            for method in existing_methods:
                method.is_default = False
            self.db.commit()

        payment_method = PaymentMethodModel(
            method_type=data.method_type,
            display_name=data.display_name,
            customer_id=data.customer_id,
            gateway_provider=data.gateway_provider,
            is_default=data.is_default,
            is_active=True,
            details=data.details or {},
            expired_at=data.expired_at,
            tenant_id=data.tenant_id,
            metadata=data.metadata or {},
        )

        self.db.add(payment_method)
        self.db.commit()
        self.db.refresh(payment_method)

        self._emit_event(
            "payment_method.created",
            str(payment_method.method_id),
            method_type=payment_method.method_type.value,
        )

        return PaymentMethodRead.model_validate(payment_method)

    def list_payment_methods(
        self,
        customer_id: str,
        tenant_id: str = "default",
        active_only: bool = True,
    ) -> list[PaymentMethodRead]:
        """
        Liệt kê phương thức thanh toán của một khách hàng.

        Args:
            customer_id: ID khách hàng.
            tenant_id: Tenant ID.
            active_only: Chỉ lấy phương thức đang hoạt động.

        Returns:
            List của PaymentMethodRead, sắp xếp theo is_default (True trước).
        """
        query = self.db.query(PaymentMethodModel).filter(
            and_(
                PaymentMethodModel.customer_id == customer_id,
                PaymentMethodModel.tenant_id == tenant_id,
            )
        )

        if active_only:
            query = query.filter(PaymentMethodModel.is_active == True)

        methods = query.order_by(
            PaymentMethodModel.is_default.desc(),
            PaymentMethodModel.created_at.desc(),
        ).all()

        return [PaymentMethodRead.model_validate(m) for m in methods]

    def deactivate_payment_method(
        self,
        method_id: str,
    ) -> PaymentMethodRead:
        """
        Vô hiệu hóa một phương thức thanh toán.

        Args:
            method_id: ID phương thức cần vô hiệu hóa.

        Returns:
            PaymentMethodRead đã cập nhật.

        Raises:
            MidicoderError: Nếu không tìm thấy.
        """
        method = (
            self.db.query(PaymentMethodModel)
            .filter(PaymentMethodModel.method_id == method_id)
            .first()
        )

        if not method:
            raise EM.raise_error(
                ErrorCode.CP45_PAYMENT_METHOD_NOT_FOUND,
                method_id=method_id,
            )

        method.is_active = False
        method.updated_at = datetime.now(timezone.utc)
        self.db.commit()
        self.db.refresh(method)

        self._emit_event(
            "payment_method.deactivated",
            str(method.method_id),
        )

        return PaymentMethodRead.model_validate(method)

