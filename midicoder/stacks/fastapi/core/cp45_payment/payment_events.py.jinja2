"""
CP45 Payment Gateway Events — Event-driven payment events.

Module này định nghĩa các event và event handler cho payment gateway:
- PaymentEvent: các loại sự kiện thanh toán (create, success, failed, refund, ...)
- PaymentEventHandler: giao diện trừu tượng cho event handler
- PaymentAuditHandler: handler ghi audit log khi có sự kiện
- PaymentNotificationHandler: handler gửi thông báo khi có sự kiện
- PaymentAnalyticsHandler: handler thu thập số liệu phân tích
- PaymentEventBus: event bus đơn giản để publish/subscribe events

Tích hợp với CP05 (Event Bus), CP14 (Audit), CP12 (Notification).

CP45: Payment Gateway Abstraction Layer
"""

from __future__ import annotations

import asyncio
import logging
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Callable

from pydantic import BaseModel, Field


logger = logging.getLogger(__name__)


# ============================================================================
# Payment Event Types — Phân loại sự kiện thanh toán
# ============================================================================


class PaymentEventType(str, Enum):
    """
    Các loại sự kiện thanh toán.

    Mỗi sự kiện đại diện cho một trạng thái hoặc hành động
    trong vòng đời của giao dịch thanh toán.
    """

    # Giao dịch thanh toán
    PAYMENT_CREATED = "payment.created"
    PAYMENT_PROCESSING = "payment.processing"
    PAYMENT_SUCCEEDED = "payment.succeeded"
    PAYMENT_FAILED = "payment.failed"
    PAYMENT_CANCELLED = "payment.cancelled"
    PAYMENT_EXPIRED = "payment.expired"
    PAYMENT_REFUNDED = "payment.refunded"
    PAYMENT_DISPUTED = "payment.disputed"

    # Hoàn tiền
    REFUND_CREATED = "payment.refund.created"
    REFUND_PROCESSING = "payment.refund.processing"
    REFUND_SUCCEEDED = "payment.refund.succeeded"
    REFUND_FAILED = "payment.refund.failed"

    # Phương thức thanh toán
    PAYMENT_METHOD_ADDED = "payment_method.added"
    PAYMENT_METHOD_REMOVED = "payment_method.removed"
    PAYMENT_METHOD_DEFAULT_CHANGED = "payment_method.default_changed"

    # Cấu hình gateway
    GATEWAY_CONFIG_CREATED = "gateway_config.created"
    GATEWAY_CONFIG_UPDATED = "gateway_config.updated"
    GATEWAY_CONFIG_DEACTIVATED = "gateway_config.deactivated"

    # Webhook
    WEBHOOK_RECEIVED = "webhook.received"
    WEBHOOK_FAILED = "webhook.failed"

    # Idempotency
    IDEMPOTENCY_KEY_USED = "idempotency.key_used"

    # Lỗi hệ thống
    PAYMENT_GATEWAY_TIMEOUT = "payment.gateway_timeout"
    PAYMENT_GATEWAY_ERROR = "payment.gateway_error"


# ============================================================================
# PaymentEvent — Mô hình sự kiện thanh toán
# ============================================================================


class PaymentEvent(BaseModel):
    """
    Mô hình sự kiện thanh toán.

    Mỗi sự kiện chứa:
    - event_type: Loại sự kiện (PaymentEventType)
    - event_id: Định danh duy nhất của sự kiện
    - timestamp: Thời điểm sự kiện xảy ra
    - payload: Dữ liệu chi tiết của sự kiện
    - metadata: Metadata bổ sung

    Attributes:
        event_type: Loại sự kiện.
        event_id: Định danh duy nhất.
        timestamp: Thời điểm xảy ra.
        payload: Dữ liệu chi tiết.
        tenant_id: Tenant ID.
        metadata: Metadata bổ sung.
    """

    model_config = {"frozen": True}

    event_type: PaymentEventType = Field(..., description="Loại sự kiện thanh toán")
    event_id: str = Field(..., description="Định danh duy nhất của sự kiện")
    timestamp: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc),
        description="Thời điểm sự kiện xảy ra",
    )
    payload: dict[str, Any] = Field(
        default_factory=dict,
        description="Dữ liệu chi tiết của sự kiện",
    )
    tenant_id: str = Field(
        default="default",
        max_length=100,
        description="Tenant ID",
    )
    metadata: dict[str, Any] = Field(
        default_factory=dict,
        description="Metadata bổ sung",
    )

    @property
    def transaction_id(self) -> str | None:
        """Lấy transaction_id từ payload (nếu có)."""
        return self.payload.get("transaction_id")

    @property
    def customer_id(self) -> str | None:
        """Lấy customer_id từ payload (nếu có)."""
        return self.payload.get("customer_id")

    @property
    def gateway_provider(self) -> str | None:
        """Lấy gateway provider từ payload (nếu có)."""
        return self.payload.get("gateway_provider")

    @property
    def amount(self) -> int | None:
        """Lấy số tiền từ payload (nếu có)."""
        return self.payload.get("amount")

    def __repr__(self) -> str:
        return (
            f"<PaymentEvent(type={self.event_type.value}, "
            f"id={self.event_id}, txn={self.transaction_id})>"
        )


# ============================================================================
# PaymentEventHandler — Giao diện trừu tượng cho event handler
# ============================================================================


class PaymentEventHandler(BaseModel):
    """
    Giao diện trừu tượng cho payment event handler.

    Mỗi handler sẽ xử lý các sự kiện cụ thể theo tên đăng ký.
    Handler cần implement handle_event() để xử lý sự kiện.

    Attributes:
        name: Tên của handler (dùng để debug/log).
        event_types: Danh sách các loại sự kiện mà handler quan tâm.
        is_async: Handler có xử lý async không.
    """

    name: str = Field(..., description="Tên của handler")
    event_types: list[PaymentEventType] = Field(
        default_factory=list,
        description="Các loại sự kiện mà handler quan tâm",
    )
    is_async: bool = Field(
        default=True,
        description="Handler có xử lý async không",
    )

    def is_interested(self, event: PaymentEvent) -> bool:
        """
        Kiểm tra handler có quan tâm đến sự kiện này không.

        Args:
            event: PaymentEvent cần kiểm tra.

        Returns:
            True nếu handler quan tâm, False nếu không.
        """
        if not self.event_types:
            return True  # Không có filter — quan tâm tất cả
        return event.event_type in self.event_types

    async def handle(self, event: PaymentEvent) -> None:
        """
        Xử lý sự kiện thanh toán.

        Phương thức này cần được override bởi các handler cụ thể.

        Args:
            event: PaymentEvent cần xử lý.
        """
        logger.debug(
            "Handler '%s' nhận sự kiện: %s (event_id: %s)",
            self.name,
            event.event_type.value,
            event.event_id,
        )


# ============================================================================
# PaymentAuditHandler — Handler ghi audit log
# ============================================================================


class PaymentAuditHandler(PaymentEventHandler):
    """
    Handler ghi audit log cho các sự kiện thanh toán.

    Tích hợp với CP14 (Audit Compliance) — ghi lại tất cả
    sự kiện thanh toán vào audit trail.

    Usage:
        handler = PaymentAuditHandler(audit_logger=audit_service)
        await handler.handle(event)
    """

    name: str = "payment_audit_handler"
    event_types: list[PaymentEventType] = [
        PaymentEventType.PAYMENT_CREATED,
        PaymentEventType.PAYMENT_SUCCEEDED,
        PaymentEventType.PAYMENT_FAILED,
        PaymentEventType.PAYMENT_CANCELLED,
        PaymentEventType.PAYMENT_REFUNDED,
        PaymentEventType.REFUND_CREATED,
        PaymentEventType.REFUND_SUCCEEDED,
        PaymentEventType.REFUND_FAILED,
    ]
    is_async: bool = True

    async def handle(self, event: PaymentEvent) -> None:
        """
        Ghi audit log cho sự kiện thanh toán.

        Trong production, phương thức này sẽ gọi audit service
        để ghi vào audit trail table hoặc audit event bus.

        Args:
            event: PaymentEvent cần ghi audit log.
        """
        audit_record = {
            "event_type": event.event_type.value,
            "event_id": event.event_id,
            "timestamp": event.timestamp.isoformat(),
            "tenant_id": event.tenant_id,
            "transaction_id": event.transaction_id,
            "customer_id": event.customer_id,
            "gateway_provider": event.gateway_provider,
            "amount": event.amount,
            "payload": event.payload,
            "metadata": event.metadata,
        }

        logger.info(
            "Audit log: %s — txn=%s, amount=%s, provider=%s",
            event.event_type.value,
            event.transaction_id,
            event.amount,
            event.gateway_provider,
        )

