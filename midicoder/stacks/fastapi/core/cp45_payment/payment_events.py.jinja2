# ============================================================================
# PaymentNotificationHandler — Handler gửi thông báo
# ============================================================================


class PaymentNotificationHandler(PaymentEventHandler):
    """
    Handler gửi thông báo khi có sự kiện thanh toán.

    Tích hợp với CP12 (Notification) — gửi email, SMS, in-app notification
    cho khách hàng và admin khi có các sự kiện quan trọng.

    Các sự kiện gửi thông báo:
    - payment.succeeded: Gửi xác nhận thanh toán thành công cho khách hàng
    - payment.failed: Gửi thông báo thanh toán thất bại
    - payment.refunded: Gửi xác nhận hoàn tiền
    - payment.disputed: Gửi cảnh báo tranh chấp cho admin

    Usage:
        handler = PaymentNotificationHandler(notification_service=notif_service)
        await handler.handle(event)
    """

    name: str = "payment_notification_handler"
    event_types: list[PaymentEventType] = [
        PaymentEventType.PAYMENT_SUCCEEDED,
        PaymentEventType.PAYMENT_FAILED,
        PaymentEventType.PAYMENT_REFUNDED,
        PaymentEventType.PAYMENT_DISPUTED,
        PaymentEventType.REFUND_SUCCEEDED,
        PaymentEventType.REFUND_FAILED,
    ]
    is_async: bool = True

    async def handle(self, event: PaymentEvent) -> None:
        """
        Gửi thông báo cho sự kiện thanh toán.

        Xác định loại thông báo dựa trên event_type và gửi
        đến đối tượng phù hợp (khách hàng hoặc admin).

        Args:
            event: PaymentEvent cần gửi thông báo.
        """
        customer_email = event.payload.get("customer_email")
        customer_phone = event.payload.get("customer_phone")
        transaction_id = event.transaction_id
        amount = event.amount

        notification_config = self._get_notification_config(event.event_type)

        if not notification_config:
            return

        # Gửi thông báo
        notification = {
            "event_type": event.event_type.value,
            "recipient_type": notification_config["recipient_type"],
            "recipient_email": customer_email if notification_config["recipient_type"] == "customer" else None,
            "recipient_phone": customer_phone if notification_config["recipient_type"] == "customer" else None,
            "channels": notification_config["channels"],
            "template": notification_config["template"],
            "template_vars": {
                "transaction_id": transaction_id,
                "amount": amount,
                "currency": event.payload.get("currency", "VND"),
                "timestamp": event.timestamp.isoformat(),
            },
        }

        logger.info(
            "Gửi thông báo: type=%s, template=%s, recipient=%s",
            event.event_type.value,
            notification["template"],
            notification["recipient_type"],
        )

        # TODO: Tích hợp với CP12 Notification Service
        # await self.notification_service.send(notification)

    def _get_notification_config(
        self,
        event_type: PaymentEventType,
    ) -> dict[str, Any] | None:
        """
        Lấy cấu hình thông báo theo loại sự kiện.

        Args:
            event_type: Loại sự kiện.

        Returns:
            Dict cấu hình thông báo, hoặc None nếu không cần gửi.
        """
        config_map: dict[PaymentEventType, dict[str, Any]] = {
            PaymentEventType.PAYMENT_SUCCEEDED: {
                "recipient_type": "customer",
                "channels": ["email"],
                "template": "payment_success_confirmation",
                "description": "Xác nhận thanh toán thành công gửi cho khách hàng",
            },
            PaymentEventType.PAYMENT_FAILED: {
                "recipient_type": "customer",
                "channels": ["email"],
                "template": "payment_failed_notification",
                "description": "Thông báo thanh toán thất bại gửi cho khách hàng",
            },
            PaymentEventType.PAYMENT_REFUNDED: {
                "recipient_type": "customer",
                "channels": ["email", "sms"],
                "template": "refund_confirmation",
                "description": "Xác nhận hoàn tiền gửi cho khách hàng",
            },
            PaymentEventType.PAYMENT_DISPUTED: {
                "recipient_type": "admin",
                "channels": ["email", "in_app"],
                "template": "payment_dispute_alert",
                "description": "Cảnh báo tranh chấp thanh toán gửi cho admin",
            },
            PaymentEventType.REFUND_SUCCEEDED: {
                "recipient_type": "customer",
                "channels": ["email"],
                "template": "refund_success_confirmation",
                "description": "Xác nhận hoàn tiền thành công",
            },
            PaymentEventType.REFUND_FAILED: {
                "recipient_type": "admin",
                "channels": ["email", "in_app"],
                "template": "refund_failed_alert",
                "description": "Cảnh báo hoàn tiền thất bại gửi cho admin",
            },
        }

        return config_map.get(event_type)


# ============================================================================
# PaymentAnalyticsHandler — Handler thu thập số liệu phân tích
# ============================================================================


class PaymentAnalyticsHandler(PaymentEventHandler):
    """
    Handler thu thập số liệu phân tích thanh toán.

    Tích hợp với CP17 (BI Analytics) — thu thập metrics và
    số liệu thống kê cho dashboard và báo cáo.

    Metrics theo dõi:
    - Tổng số giao dịch theo thời gian
    - Tỷ lệ thành công/thất bại theo provider
    - Tổng doanh thu theo khoảng thời gian
    - Số tiền hoàn tiền
    - Thời gian xử lý trung bình

    Usage:
        handler = PaymentAnalyticsHandler(analytics_service=analytics)
        await handler.handle(event)
    """

    name: str = "payment_analytics_handler"
    event_types: list[PaymentEventType] = [
        PaymentEventType.PAYMENT_CREATED,
        PaymentEventType.PAYMENT_SUCCEEDED,
        PaymentEventType.PAYMENT_FAILED,
        PaymentEventType.PAYMENT_REFUNDED,
        PaymentEventType.PAYMENT_GATEWAY_TIMEOUT,
        PaymentEventType.PAYMENT_GATEWAY_ERROR,
    ]
    is_async: bool = True

    async def handle(self, event: PaymentEvent) -> None:
        """
        Thu thập số liệu phân tích từ sự kiện thanh toán.

        Tăng counter metrics và ghi vào analytics store
        để hỗ trợ báo cáo và dashboard.

        Args:
            event: PaymentEvent cần thu thập số liệu.
        """
        metric = self._extract_metric(event)

        if not metric:
            return

        logger.debug(
            "Analytics metric: %s — %s",
            metric["metric_name"],
            metric["metric_value"],
        )

        # TODO: Tích hợp với CP17 BI Analytics
        # await self.analytics_service.record_metric(metric)

    def _extract_metric(self, event: PaymentEvent) -> dict[str, Any] | None:
        """
        Trích xuất metric từ sự kiện thanh toán.

        Args:
            event: PaymentEvent.

        Returns:
            Dict metric hoặc None.
        """
        metric_map: dict[PaymentEventType, dict[str, Any]] = {
            PaymentEventType.PAYMENT_CREATED: {
                "metric_name": "payment.transactions_created",
                "metric_type": "counter",
                "metric_value": 1,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                },
            },
            PaymentEventType.PAYMENT_SUCCEEDED: {
                "metric_name": "payment.transactions_succeeded",
                "metric_type": "counter",
                "metric_value": 1,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                    "amount": event.amount or 0,
                },
            },
            PaymentEventType.PAYMENT_FAILED: {
                "metric_name": "payment.transactions_failed",
                "metric_type": "counter",
                "metric_value": 1,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                    "error_code": event.payload.get("error_code", "unknown"),
                },
            },
            PaymentEventType.PAYMENT_REFUNDED: {
                "metric_name": "payment.refund_amount",
                "metric_type": "gauge",
                "metric_value": event.amount or 0,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                },
            },
            PaymentEventType.PAYMENT_GATEWAY_TIMEOUT: {
                "metric_name": "payment.gateway_timeout",
                "metric_type": "counter",
                "metric_value": 1,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                },
            },
            PaymentEventType.PAYMENT_GATEWAY_ERROR: {
                "metric_name": "payment.gateway_error",
                "metric_type": "counter",
                "metric_value": 1,
                "tags": {
                    "provider": event.gateway_provider or "unknown",
                    "tenant": event.tenant_id,
                    "error_type": event.payload.get("error_type", "unknown"),
                },
            },
        }

        return metric_map.get(event.event_type)


# ============================================================================
# PaymentEventBus — Event bus đơn giản để publish/subscribe
# ============================================================================


class PaymentEventBus:
    """
    Event bus đơn giản cho payment events.

    Quản lý danh sách handler và phân phối sự kiện đến
    các handler phù hợp. Hỗ trợ cả sync và async handler.

    Usage:
        bus = PaymentEventBus()
        bus.register_handler(audit_handler)
        bus.register_handler(notification_handler)
        await bus.publish(event)
    """

    def __init__(self) -> None:
        """Khởi tạo PaymentEventBus."""
        self._handlers: list[PaymentEventHandler] = []
        self._event_log: list[PaymentEvent] = []
        self._max_log_size: int = 10000  # Giới hạn số sự kiện lưu trong bộ nhớ

    def register_handler(self, handler: PaymentEventHandler) -> None:
        """
        Đăng ký handler mới vào event bus.

        Args:
            handler: PaymentEventHandler cần đăng ký.
        """
        self._handlers.append(handler)
        logger.info(
            "Đã đăng ký event handler '%s' (quan tâm: %s)",
            handler.name,
            [et.value for et in handler.event_types] if handler.event_types else "tất cả",
        )

    def unregister_handler(self, handler_name: str) -> bool:
        """
        Hủy đăng ký handler theo tên.

        Args:
            handler_name: Tên của handler cần hủy đăng ký.

        Returns:
            True nếu tìm thấy và hủy đăng ký, False nếu không.
        """
        for i, handler in enumerate(self._handlers):
            if handler.name == handler_name:
                self._handlers.pop(i)
                logger.info("Đã hủy đăng ký event handler '%s'", handler_name)
                return True
        return False

    async def publish(self, event: PaymentEvent) -> None:
        """
        Publish một sự kiện đến tất cả handler phù hợp.

        Sự kiện sẽ được phân phối đến các handler đã đăng ký
        và quan tâm đến loại sự kiện này.

        Args:
            event: PaymentEvent cần publish.
        """
        # Lưu vào event log
        self._event_log.append(event)
        if len(self._event_log) > self._max_log_size:
            self._event_log = self._event_log[-self._max_log_size :]

        # Tìm các handler phù hợp
        interested_handlers = [
            h for h in self._handlers if h.is_interested(event)
        ]

        if not interested_handlers:
            logger.debug(
                "Không có handler nào quan tâm đến sự kiện: %s",
                event.event_type.value,
            )
            return

        logger.info(
            "Publish sự kiện %s đến %d handler(s): %s",
            event.event_type.value,
            len(interested_handlers),
            [h.name for h in interested_handlers],
        )

        # Phân phối sự kiện đến các handler (song song)
        tasks = []
        for handler in interested_handlers:
            task = self._dispatch_to_handler(handler, event)
            tasks.append(task)

        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)

    async def _dispatch_to_handler(
        self,
        handler: PaymentEventHandler,
        event: PaymentEvent,
    ) -> None:
        """
        Gửi sự kiện đến một handler cụ thể.

        Bẫy exception từ handler để sự kiện không bị bỏ lỡ
        nếu một handler gặp lỗi.

        Args:
            handler: PaymentEventHandler cần dispatch.
            event: PaymentEvent cần gửi.
        """
        try:
            await handler.handle(event)
        except Exception as e:
            logger.exception(
                "Handler '%s' gặp lỗi khi xử lý sự kiện %s: %s",
                handler.name,
                event.event_type.value,
                str(e),
            )

    def get_event_log(
        self,
        event_type: PaymentEventType | None = None,
        limit: int = 100,
    ) -> list[PaymentEvent]:
        """
        Lấy lịch sử sự kiện đã publish.

        Args:
            event_type: Lọc theo loại sự kiện (nếu có).
            limit: Số lượng sự kiện tối đa.

        Returns:
            Danh sách PaymentEvent, sắp xếp theo timestamp giảm dần.
        """
        events = self._event_log

        if event_type:
            events = [e for e in events if e.event_type == event_type]

        # Sắp xếp theo timestamp giảm dần và lấy limit
        sorted_events = sorted(
            events,
            key=lambda e: e.timestamp,
            reverse=True,
        )

        return sorted_events[:limit]

    def get_registered_handlers(self) -> list[str]:
        """Trả về danh sách tên handler đã đăng ký."""
        return [h.name for h in self._handlers]


# ============================================================================
# Factory — Tạo event bus với các handler mặc định
# ============================================================================


def create_payment_event_bus(
    enable_audit: bool = True,
    enable_notification: bool = True,
    enable_analytics: bool = True,
) -> PaymentEventBus:
    """
    Tạo PaymentEventBus với các handler mặc định.

    Factory function để khởi tạo event bus với các handler
    đã được cấu hình sẵn.

    Args:
        enable_audit: Bật/tắt audit handler.
        enable_notification: Bật/tắt notification handler.
        enable_analytics: Bật/tắt analytics handler.

    Returns:
        PaymentEventBus đã cấu hình.
    """
    bus = PaymentEventBus()

    if enable_audit:
        audit_handler = PaymentAuditHandler()
        bus.register_handler(audit_handler)

    if enable_notification:
        notification_handler = PaymentNotificationHandler()
        bus.register_handler(notification_handler)

    if enable_analytics:
        analytics_handler = PaymentAnalyticsHandler()
        bus.register_handler(analytics_handler)

    logger.info(
        "Đã tạo PaymentEventBus với %d handler(s): %s",
        len(bus.get_registered_handlers()),
        bus.get_registered_handlers(),
    )

    return bus


