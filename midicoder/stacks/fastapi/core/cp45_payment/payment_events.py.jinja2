def create_payment_event(
    event_type: PaymentEventType,
    transaction_id: str | None = None,
    amount: int | None = None,
    customer_id: str | None = None,
    gateway_provider: str | None = None,
    tenant_id: str = "default",
    **kwargs: Any,
) -> PaymentEvent:
    """
    Tạo PaymentEvent mới.

    Helper function để tạo event nhanh với các thông tin cơ bản.

    Args:
        event_type: Loại sự kiện.
        transaction_id: ID giao dịch (nếu có).
        amount: Số tiền (nếu có).
        customer_id: ID khách hàng (nếu có).
        gateway_provider: Provider gateway (nếu có).
        tenant_id: Tenant ID.
        **kwargs: Các thông tin bổ sung cho payload.

    Returns:
        PaymentEvent đã tạo.
    """
    import uuid

    payload: dict[str, Any] = kwargs.copy()
    if transaction_id:
        payload["transaction_id"] = transaction_id
    if amount is not None:
        payload["amount"] = amount
    if customer_id:
        payload["customer_id"] = customer_id
    if gateway_provider:
        payload["gateway_provider"] = gateway_provider

    event = PaymentEvent(
        event_type=event_type,
        event_id=str(uuid.uuid4()),
        payload=payload,
        tenant_id=tenant_id,
    )

    logger.debug("Tạo PaymentEvent: %s (id: %s)", event_type.value, event.event_id)

    return event


def create_payment_success_event(
    transaction_id: str,
    amount: int,
    gateway_provider: str,
    gateway_transaction_id: str | None = None,
    customer_id: str | None = None,
    customer_email: str | None = None,
    tenant_id: str = "default",
) -> PaymentEvent:
    """
    Tạo sự kiện thanh toán thành công.

    Args:
        transaction_id: ID giao dịch.
        amount: Số tiền.
        gateway_provider: Provider gateway.
        gateway_transaction_id: Transaction ID từ gateway.
        customer_id: ID khách hàng.
        customer_email: Email khách hàng.
        tenant_id: Tenant ID.

    Returns:
        PaymentEvent với loại PAYMENT_SUCCEEDED.
    """
    return create_payment_event(
        event_type=PaymentEventType.PAYMENT_SUCCEEDED,
        transaction_id=transaction_id,
        amount=amount,
        customer_id=customer_id,
        gateway_provider=gateway_provider,
        tenant_id=tenant_id,
        gateway_transaction_id=gateway_transaction_id,
        customer_email=customer_email,
    )


