"""
CP45 Payment Gateway Webhook Handler — Xử lý webhook callback từ gateway provider.

Module này xử lý webhook callback từ các payment gateway provider:
- POST /webhooks/payment/stripe   — Webhook từ Stripe
- POST /webhooks/payment/vnpay    — Webhook từ VNPay
- POST /webhooks/payment/momo     — Webhook từ MoMo
- POST /webhooks/payment/custom   — Webhook generic cho provider tùy chỉnh

Các sự kiện webhook được hỗ trợ:
- payment.success: Thanh toán thành công
- payment.failed: Thanh toán thất bại
- payment.refunded: Hoàn tiền thành công
- payment.expired: Giao dịch hết hạn

Tính năng chính:
- Xác thực webhook signature (HMAC-SHA256) cho từng provider
- Chuẩn hóa webhook payload từ các provider khác nhau
- Cập nhật trạng thái giao dịch theo state machine
- Xử lý idempotent — bỏ qua webhook đã xử lý
- Audit logging và event emission

CP45: Payment Gateway Abstraction Layer
"""

from __future__ import annotations

import hashlib
import hmac
import json
import logging
import time
from datetime import datetime, timezone
from typing import Any

from fastapi import APIRouter, Depends, Header, HTTPException, Request, status
from sqlalchemy.orm import Session

from app.database import get_db
from app.models.payment_models import (
    PaymentGatewayProvider,
    PaymentStatus,
    RefundStatus,
)
from app.services.payment_service import PaymentService

logger = logging.getLogger(__name__)


# ============================================================================
# Router
# ============================================================================

router = APIRouter(prefix="/webhooks/payment", tags=["Payment Webhooks"])


# ============================================================================
# Signature Verification — Xác thực webhook signature
# ============================================================================


def verify_stripe_signature(
    payload: str,
    signature: str,
    secret: str,
    tolerance: int = 300,
) -> bool:
    """
    Xác thực webhook signature của Stripe.

    Stripe gửi signature ở định dạng: t=timestamp,v1=signature,v0=signature
    Sử dụng HMAC-SHA256 với timestamp để bảo vệ chống replay attack.

    Args:
        payload: Raw body của webhook request.
        signature: Giá trị signature từ header X-Stripe-Signature.
        secret: Webhook signing secret (whsec_...).
        tolerance: Dung sai timestamp (giây), mặc định 300s = 5 phút.

    Returns:
        True nếu signature hợp lệ, False nếu không.
    """
    try:
        # Parse signature header
        parts = signature.split(",")
        signature_parts: dict[str, str] = {}
        for part in parts:
            if "=" in part:
                key, value = part.split("=", 1)
                signature_parts[key] = value

        # Lấy timestamp
        timestamp_str = signature_parts.get("t", "")
        if not timestamp_str:
            logger.warning("Stripe webhook signature không có timestamp")
            return False

        timestamp = int(timestamp_str)
        if abs(time.time() - timestamp) > tolerance:
            logger.warning(
                "Stripe webhook timestamp quá cũ: %d (tolerance: %ds)",
                timestamp,
                tolerance,
            )
            return False

        # Tính toán expected signature
        signed_payload = f"{timestamp}.{payload}"
        expected_signature = hmac.new(
            secret.encode("utf-8"),
            signed_payload.encode("utf-8"),
            hashlib.sha256,
        ).hexdigest()

        # So sánh với v1 signature
        signature_v1 = signature_parts.get("v1", "")
        return hmac.compare_digest(expected_signature, signature_v1)

    except (ValueError, KeyError) as e:
        logger.error("Lỗi khi xác thực Stripe webhook signature: %s", str(e))
        return False


def verify_vnpay_signature(
    params: dict[str, str],
    signature: str,
    secret_key: str,
) -> bool:
    """
    Xác thực webhook signature của VNPay.

    VNPay sử dụng HMAC-MD5 với các tham số được sắp xếp theo thứ tự alphabet.
    SecureHash được gửi trong params và cần được verify.

    Args:
        params: Các tham số query từ VNPay webhook.
        signature: Giá trị vnp_SecureHash từ params.
        secret_key: Secret key để tính toán hash.

    Returns:
        True nếu signature hợp lệ, False nếu không.
    """
    try:
        # Loại bỏ secure hash khỏi params
        hash_params = {k: v for k, v in params.items() if k != "vnp_SecureHash"}

        # Sắp xếp theo thứ tự alphabet
        sorted_params = sorted(hash_params.items())
        query_string = "&".join(f"{k}={v}" for k, v in sorted_params)

        # Tính toán expected hash (HMAC-MD5)
        expected_hash = hmac.new(
            secret_key.encode("utf-8"),
            query_string.encode("utf-8"),
            hashlib.md5,
        ).hexdigest().upper()

        return hmac.compare_digest(expected_hash, signature.upper())

    except Exception as e:
        logger.error("Lỗi khi xác thực VNPay webhook signature: %s", str(e))
        return False


def verify_momo_signature(
    payload: dict[str, Any],
    signature: str,
    secret_key: str,
) -> bool:
    """
    Xác thực webhook signature của MoMo.

    MoMo sử dụng HMAC-SHA256 với accessKey, partnerCode, requestID,
    amount, orderID được nối lại.

    Args:
        payload: Payload JSON từ MoMo webhook.
        signature: Giá trị signature từ header hoặc payload.
        secret_key: Secret key của MoMo.

    Returns:
        True nếu signature hợp lệ, False nếu không.
    """
    try:
        # Tạo chuỗi để tính signature
        access_key = payload.get("accessKey", "")
        partner_code = payload.get("partnerCode", "")
        request_id = payload.get("requestId", "")
        amount = str(payload.get("amount", ""))
        order_id = payload.get("orderId", "")

        # MoMo signature: HMAC-SHA256(accessKey+requestId+amount+orderId+partnerCode+lang+extraData)
        raw_data = f"{access_key}{request_id}{amount}{order_id}{partner_code}"
        expected_signature = hmac.new(
            secret_key.encode("utf-8"),
            raw_data.encode("utf-8"),
            hashlib.sha256,
        ).hexdigest()

        return hmac.compare_digest(expected_signature, signature)

    except Exception as e:
        logger.error("Lỗi khi xác thực MoMo webhook signature: %s", str(e))
        return False


