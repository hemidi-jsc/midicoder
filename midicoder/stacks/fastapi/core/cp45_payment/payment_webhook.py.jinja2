# Event Handlers — Xử lý các sự kiện webhook
# ============================================================================


def handle_payment_success(
    db: Session,
    gateway_provider: PaymentGatewayProvider,
    gateway_transaction_id: str,
    amount: int,
    currency: str,
    reference_code: str | None = None,
    metadata: dict[str, Any] | None = None,
) -> bool:
    """
    Xử lý sự kiện thanh toán thành công từ webhook.

    Tìm giao dịch đang ở trạng thái PENDING hoặc PROCESSING,
    cập nhật sang COMPLETED với gateway response data.

    Args:
        db: SQLAlchemy Session.
        gateway_provider: Nhà cung cấp gateway gửi webhook.
        gateway_transaction_id: Transaction ID từ gateway.
        amount: Số tiền giao dịch.
        currency: Mã tiền tệ.
        reference_code: Mã tham chiếu (nếu có).
        metadata: Metadata bổ sung.

    Returns:
        True nếu tìm thấy và cập nhật giao dịch, False nếu không.
    """
    service = PaymentService(db)

    # Tìm giao dịch theo gateway_transaction_id
    from app.models.payment_models import PaymentTransactionModel

    transaction = (
        db.query(PaymentTransactionModel)
        .filter(
            PaymentTransactionModel.gateway_transaction_id == gateway_transaction_id
        )
        .first()
    )

    if not transaction:
        # Fallback: tìm theo reference_code
        if reference_code:
            transaction = (
                db.query(PaymentTransactionModel)
                .filter(PaymentTransactionModel.reference_code == reference_code)
                .first()
            )

    if not transaction:
        logger.warning(
            "Không tìm thấy giao dịch với gateway_tx='%s', ref='%s'",
            gateway_transaction_id,
            reference_code,
        )
        return False

    # Chỉ cập nhật nếu đang ở trạng thái PENDING hoặc PROCESSING
    if transaction.status not in (PaymentStatus.PENDING, PaymentStatus.PROCESSING):
        logger.info(
            "Giao dịch '%s' đang ở trạng thái %s — bỏ qua webhook success",
            transaction.transaction_id,
            transaction.status.value,
        )
        return True  # Đã xử lý rồi, không phải lỗi

    # Cập nhật gateway response data
    existing_response = transaction.gateway_response_data or {}
    existing_response.update(metadata or {})
    existing_response["webhook_received_at"] = datetime.now(timezone.utc).isoformat()
    transaction.gateway_response_data = existing_response

    # Chuyển trạng thái sang COMPLETED
    try:
        service._transition_status(transaction, PaymentStatus.COMPLETED)
    except Exception as e:
        logger.warning(
            "Không thể chuyển trạng thái giao dịch %s sang COMPLETED: %s",
            transaction.transaction_id,
            str(e),
        )
        return False

    logger.info(
        "Giao dịch '%s' đã được cập nhật sang COMPLETED từ webhook (gateway: %s, tx: %s)",
        transaction.transaction_id,
        gateway_provider.value,
        gateway_transaction_id,
    )

    # Emit event
    service._emit_event(
        "payment.completed",
        str(transaction.transaction_id),
        gateway=gateway_provider.value,
        gateway_transaction_id=gateway_transaction_id,
    )

    return True


def handle_payment_failed(
    db: Session,
    gateway_provider: PaymentGatewayProvider,
    gateway_transaction_id: str,
    error_code: str | None = None,
    error_message: str | None = None,
    reference_code: str | None = None,
) -> bool:
    """
    Xử lý sự kiện thanh toán thất bại từ webhook.

    Tìm giao dịch đang ở trạng thái PENDING hoặc PROCESSING,
    cập nhật sang FAILED với thông tin lỗi.

    Args:
        db: SQLAlchemy Session.
        gateway_provider: Nhà cung cấp gateway gửi webhook.
        gateway_transaction_id: Transaction ID từ gateway.
        error_code: Mã lỗi từ gateway.
        error_message: Thông báo lỗi.
        reference_code: Mã tham chiếu (nếu có).

    Returns:
        True nếu tìm thấy và cập nhật giao dịch, False nếu không.
    """
    service = PaymentService(db)

    from app.models.payment_models import PaymentTransactionModel

    transaction = (
        db.query(PaymentTransactionModel)
        .filter(
            PaymentTransactionModel.gateway_transaction_id == gateway_transaction_id
        )
        .first()
    )

    if not transaction and reference_code:
        transaction = (
            db.query(PaymentTransactionModel)
            .filter(PaymentTransactionModel.reference_code == reference_code)
            .first()
        )

    if not transaction:
        logger.warning(
            "Không tìm thấy giao dịch với gateway_tx='%s', ref='%s' cho webhook failed",
            gateway_transaction_id,
            reference_code,
        )
        return False

    # Chỉ cập nhật nếu đang ở trạng thái PENDING hoặc PROCESSING
    if transaction.status not in (PaymentStatus.PENDING, PaymentStatus.PROCESSING):
        logger.info(
            "Giao dịch '%s' đang ở trạng thái %s — bỏ qua webhook failed",
            transaction.transaction_id,
            transaction.status.value,
        )
        return True

    # Cập nhật thông tin lỗi
    transaction.error_code = error_code
    transaction.error_message = error_message or "Giao dịch thất bại từ gateway"

    existing_response = transaction.gateway_response_data or {}
    existing_response["webhook_received_at"] = datetime.now(timezone.utc).isoformat()
    existing_response["error_code"] = error_code
    existing_response["error_message"] = error_message
    transaction.gateway_response_data = existing_response

    # Chuyển trạng thái sang FAILED
    try:
        service._transition_status(transaction, PaymentStatus.FAILED)
    except Exception as e:
        logger.warning(
            "Không thể chuyển trạng thái giao dịch %s sang FAILED: %s",
            transaction.transaction_id,
            str(e),
        )
        return False

    logger.warning(
        "Giao dịch '%s' đã được cập nhật sang FAILED từ webhook (gateway: %s, error: %s)",
        transaction.transaction_id,
        gateway_provider.value,
        error_code or error_message,
    )

    service._emit_event(
        "payment.failed",
        str(transaction.transaction_id),
        gateway=gateway_provider.value,
        error_code=error_code,
    )

    return True


def handle_refund_completed(
    db: Session,
    gateway_provider: PaymentGatewayProvider,
    gateway_refund_id: str,
    gateway_transaction_id: str | None = None,
    metadata: dict[str, Any] | None = None,
) -> bool:
    """
    Xử lý sự kiện hoàn tiền thành công từ webhook.

    Tìm yêu cầu hoàn tiền đang ở trạng thái PENDING hoặc PROCESSING,
    cập nhật sang COMPLETED. Đồng thời cập nhật giao dịch gốc
    sang REFUNDED nếu là full refund.

    Args:
        db: SQLAlchemy Session.
        gateway_provider: Nhà cung cấp gateway gửi webhook.
        gateway_refund_id: Refund ID từ gateway.
        gateway_transaction_id: Transaction ID từ gateway (nếu có).
        metadata: Metadata bổ sung.

    Returns:
        True nếu tìm thấy và cập nhật, False nếu không.
    """
    service = PaymentService(db)

    from app.models.payment_models import PaymentRefundModel

    refund = (
        db.query(PaymentRefundModel)
        .filter(PaymentRefundModel.gateway_refund_id == gateway_refund_id)
        .first()
    )

    if not refund:
        logger.warning("Không tìm thấy hoàn tiền với gateway_refund_id='%s'", gateway_refund_id)
        return False

    # Chỉ cập nhật nếu đang ở trạng thái PENDING hoặc PROCESSING
    if refund.status not in (RefundStatus.PENDING, RefundStatus.PROCESSING):
        logger.info(
            "Hoàn tiền '%s' đang ở trạng thái %s — bỏ qua webhook",
            refund.refund_id,
            refund.status.value,
        )
        return True

    # Cập nhật hoàn tiền
    existing_response = refund.gateway_response_data or {}
    existing_response.update(metadata or {})
    existing_response["webhook_received_at"] = datetime.now(timezone.utc).isoformat()
    refund.gateway_response_data = existing_response
    refund.status = RefundStatus.COMPLETED
    refund.completed_at = datetime.now(timezone.utc)

    db.commit()
    db.refresh(refund)

    # Kiểm tra nếu là full refund — cập nhật giao dịch gốc sang REFUNDED
    from app.models.payment_models import PaymentTransactionModel

    transaction = (
        db.query(PaymentTransactionModel)
        .filter(PaymentTransactionModel.transaction_id == refund.transaction_id)
        .first()
    )

    if transaction and transaction.status == PaymentStatus.COMPLETED:
        total_refunded = sum(
            r.refund_amount
            for r in transaction.refunds
            if r.status == RefundStatus.COMPLETED
        )
        if total_refunded >= transaction.amount:
            try:
                service._transition_status(transaction, PaymentStatus.REFUNDED)
            except Exception:
                # Nếu đã ở trạng thái REFUNDED thì không sao
                pass

    logger.info(
        "Hoàn tiền '%s' đã được cập nhật sang COMPLETED từ webhook (gateway: %s)",
        refund.refund_id,
        gateway_provider.value,
    )

    service._emit_event(
        "payment.refund.completed",
        str(refund.refund_id),
        gateway=gateway_provider.value,
    )

    return True


def handle_refund_failed(
    db: Session,
    gateway_provider: PaymentGatewayProvider,
    gateway_refund_id: str,
    error_code: str | None = None,
    error_message: str | None = None,
) -> bool:
    """
    Xử lý sự kiện hoàn tiền thất bại từ webhook.

    Cập nhật yêu cầu hoàn tiền sang FAILED với thông tin lỗi.

    Args:
        db: SQLAlchemy Session.
        gateway_provider: Nhà cung cấp gateway gửi webhook.
        gateway_refund_id: Refund ID từ gateway.
        error_code: Mã lỗi.
        error_message: Thông báo lỗi.

    Returns:
        True nếu tìm thấy và cập nhật, False nếu không.
    """
    from app.models.payment_models import PaymentRefundModel

    refund = (
        db.query(PaymentRefundModel)
        .filter(PaymentRefundModel.gateway_refund_id == gateway_refund_id)
        .first()
    )

    if not refund:
        logger.warning("Không tìm thấy hoàn tiền với gateway_refund_id='%s' cho webhook failed", gateway_refund_id)
        return False

    if refund.status not in (RefundStatus.PENDING, RefundStatus.PROCESSING):
        return True

    refund.error_code = error_code
    refund.error_message = error_message or "Hoàn tiền thất bại từ gateway"
    refund.status = RefundStatus.FAILED
    refund.updated_at = datetime.now(timezone.utc)

    db.commit()
    db.refresh(refund)

    logger.warning(
        "Hoàn tiền '%s' đã được cập nhật sang FAILED từ webhook (gateway: %s, error: %s)",
        refund.refund_id,
        gateway_provider.value,
        error_code or error_message,
    )

    return True


