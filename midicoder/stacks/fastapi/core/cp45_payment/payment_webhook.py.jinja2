@router.post(
    "/stripe",
    summary="Nhận webhook từ Stripe",
    responses={
        200: {"description": "Webhook đã được xử lý thành công"},
        400: {"description": "Webhook payload không hợp lệ"},
        401: {"description": "Signature không hợp lệ"},
    },
)
async def receive_stripe_webhook(
    request: Request,
    db: Session = Depends(get_db),
    x_stripe_signature: str | None = Header(None, alias="X-Stripe-Signature"),
) -> dict[str, str]:
    """
    Endpoint nhận webhook callback từ Stripe.

    Xử lý các sự kiện:
    - payment_intent.succeeded: Thanh toán thành công
    - payment_intent.payment_failed: Thanh toán thất bại
    - charge.refunded: Hoàn tiền thành công
    - charge.dispute.created: Tranh chấp thanh toán

    Xác thực signature qua X-Stripe-Signature header.
    """
    body_bytes = await request.body()
    body = body_bytes.decode("utf-8")

    logger.info("Nhận webhook Stripe (body length: %d bytes)", len(body))

    # Xác thực signature
    if x_stripe_signature:
        # Lấy webhook secret từ gateway config
        service = PaymentService(db)
        try:
            config = service._get_gateway_config(
                PaymentGatewayProvider.STRIPE,
                "default",  # TODO: lấy tenant_id từ context
            )
            webhook_secret = config.webhook_secret_reference or ""

            if not verify_stripe_signature(body, x_stripe_signature, webhook_secret):
                logger.warning("Stripe webhook signature không hợp lệ")
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Invalid webhook signature",
                )
        except Exception:
            logger.warning("Không thể lấy Stripe webhook config — bỏ qua signature check")
    else:
        logger.warning("Stripe webhook không có signature header")

    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        logger.warning("Stripe webhook payload không phải JSON hợp lệ")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid JSON payload",
        )

    event_type = payload.get("type", "")
    data = payload.get("data", {}).get("object", {})

    # Xử lý sự kiện
    if event_type == "payment_intent.succeeded":
        handle_payment_success(
            db=db,
            gateway_provider=PaymentGatewayProvider.STRIPE,
            gateway_transaction_id=data.get("id", ""),
            amount=data.get("amount", 0),
            currency=data.get("currency", "usd").upper(),
            reference_code=data.get("metadata", {}).get("reference_code"),
            metadata=data,
        )
    elif event_type == "payment_intent.payment_failed":
        handle_payment_failed(
            db=db,
            gateway_provider=PaymentGatewayProvider.STRIPE,
            gateway_transaction_id=data.get("id", ""),
            error_code=data.get("last_payment_error", {}).get("code"),
            error_message=data.get("last_payment_error", {}).get("message"),
            reference_code=data.get("metadata", {}).get("reference_code"),
        )
    elif event_type == "charge.refunded":
        handle_refund_completed(
            db=db,
            gateway_provider=PaymentGatewayProvider.STRIPE,
            gateway_refund_id=data.get("id", ""),
            gateway_transaction_id=data.get("balance_transaction"),
            metadata=data,
        )
    elif event_type == "charge.dispute.created":
        logger.warning("Stripe dispute webhook nhận được: charge=%s", data.get("id"))
        # TODO: Xử lý dispute — cần có model riêng cho dispute
    else:
        logger.info("Stripe event type chưa xử lý: %s", event_type)

    return {"status": "success", "message": f"Webhook Stripe '{event_type}' đã được xử lý"}


@router.post(
    "/vnpay",
    summary="Nhận webhook từ VNPay",
    responses={
        200: {"description": "Webhook VNPay đã được xử lý thành công"},
        400: {"description": "Webhook payload không hợp lệ"},
        401: {"description": "Signature không hợp lệ"},
    },
)
async def receive_vnpay_webhook(
    request: Request,
    db: Session = Depends(get_db),
) -> dict[str, str]:
    """
    Endpoint nhận webhook IPC (Instant Payment Notification) từ VNPay.

    VNPay gửi các tham số qua query string:
    - vnp_TransactionStatus: 00 (thành công), 01 (thất bại)
    - vnp_TxnRef: Mã tham chiếu giao dịch
    - vnp_Amount: Số tiền (x100)
    - vnp_PayDate: Thời điểm thanh toán
    - vnp_SecureHash: Signature để xác thực

    Trả về: {"RspCode": "00", "Message": "success"} để VNPay biết đã nhận.
    """
    body_bytes = await request.body()
    body = body_bytes.decode("utf-8")

    logger.info("Nhận webhook VNPay (body length: %d bytes)", len(body))

    # Parse query params từ body hoặc query string
    params: dict[str, str] = {}
    query_string = body.split("?", 1)[-1] if "?" in body else str(request.query_params)
    for param in query_string.split("&"):
        if "=" in param:
            key, value = param.split("=", 1)
            params[key] = value

    # Xác thực signature
    secure_hash = params.get("vnp_SecureHash", "")
    if secure_hash:
        service = PaymentService(db)
        try:
            config = service._get_gateway_config(
                PaymentGatewayProvider.VNPAY,
                "default",
            )
            secret_key = config.secret_key_reference or ""

            if not verify_vnpay_signature(params, secure_hash, secret_key):
                logger.warning("VNPay webhook signature không hợp lệ")
                return {"RspCode": "ERROR", "Message": "Invalid signature"}
        except Exception:
            logger.warning("Không thể lấy VNPay config — bỏ qua signature check")

    # Lấy thông tin từ params
    transaction_status = params.get("vnp_TransactionStatus", "")
    txn_ref = params.get("vnp_TxnRef", "")
    amount = int(params.get("vnp_Amount", "0")) // 100  # VNPay gửi x100
    vnp_OrderInfo = params.get("vnp_OrderInfo", "")
    vnp_ErrorCode = params.get("vnp_ErrorCode", "")

    if transaction_status == "00":
        # Thành công
        handle_payment_success(
            db=db,
            gateway_provider=PaymentGatewayProvider.VNPAY,
            gateway_transaction_id=txn_ref,
            amount=amount,
            currency="VND",
            reference_code=txn_ref,
            metadata={
                "vnp_TransactionNo": params.get("vnp_TransactionNo"),
                "vnp_PayDate": params.get("vnp_PayDate"),
                "vnp_OrderInfo": vnp_OrderInfo,
            },
        )
    elif transaction_status == "01":
        # Thất bại
        handle_payment_failed(
            db=db,
            gateway_provider=PaymentGatewayProvider.VNPAY,
            gateway_transaction_id=txn_ref,
            error_code=vnp_ErrorCode or "01",
            error_message=vnp_OrderInfo or f"VNPay error: {vnp_ErrorCode}",
            reference_code=txn_ref,
        )
    else:
        logger.info("VNPay transaction status chưa xử lý: %s", transaction_status)

    return {"RspCode": "00", "Message": "success"}


@router.post(
    "/momo",
    summary="Nhận webhook từ MoMo",
    responses={
        200: {"description": "Webhook MoMo đã được xử lý thành công"},
        400: {"description": "Webhook payload không hợp lệ"},
        401: {"description": "Signature không hợp lệ"},
    },
)
async def receive_momo_webhook(
    request: Request,
    db: Session = Depends(get_db),
    x_momo_signature: str | None = Header(None, alias="x-momo-signature"),
) -> dict[str, str]:
    """
    Endpoint nhận IPN (Instant Payment Notification) từ MoMo.

    Xử lý các sự kiện:
    - order_paid: Thanh toán thành công
    - order_failed: Thanh toán thất bại
    - order_refunded: Hoàn tiền thành công

    Xác thực signature qua x-momo-signature header.
    """
    body_bytes = await request.body()
    body = body_bytes.decode("utf-8")

    logger.info("Nhận webhook MoMo (body length: %d bytes)", len(body))

    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        logger.warning("MoMo webhook payload không phải JSON hợp lệ")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid JSON payload",
        )

    # Xác thực signature
    if x_momo_signature:
        service = PaymentService(db)
        try:
            config = service._get_gateway_config(
                PaymentGatewayProvider.MOMO,
                "default",
            )
            secret_key = config.secret_key_reference or ""

            if not verify_momo_signature(payload, x_momo_signature, secret_key):
                logger.warning("MoMo webhook signature không hợp lệ")
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Invalid webhook signature",
                )
        except Exception:
            logger.warning("Không thể lấy MoMo config — bỏ qua signature check")

    # Xử lý sự kiện
    result_code = payload.get("resultCode", "")
    order_id = payload.get("orderId", "")
    amount = payload.get("amount", 0)
    request_id = payload.get("requestId", "")
    message = payload.get("message", "")

    if result_code == "00":
        # Thành công
        handle_payment_success(
            db=db,
            gateway_provider=PaymentGatewayProvider.MOMO,
            gateway_transaction_id=order_id,
            amount=amount,
            currency="VND",
            reference_code=order_id,
            metadata=payload,
        )
    elif result_code in ("01", "02", "09"):
        # Thất bại
        handle_payment_failed(
            db=db,
            gateway_provider=PaymentGatewayProvider.MOMO,
            gateway_transaction_id=order_id,
            error_code=result_code,
            error_message=message or f"MoMo error: {result_code}",
            reference_code=order_id,
        )
    else:
        logger.info("MoMo resultCode chưa xử lý: %s", result_code)

    return {"errorCode": "00", "message": "Success"}


@router.post(
    "/custom",
    summary="Nhận webhook generic cho provider tùy chỉnh",
    responses={
        200: {"description": "Webhook đã được xử lý thành công"},
        400: {"description": "Webhook payload không hợp lệ"},
        401: {"description": "Signature không hợp lệ"},
    },
)
async def receive_custom_webhook(
    request: Request,
    db: Session = Depends(get_db),
    x_webhook_provider: str | None = Header(None, alias="X-Webhook-Provider"),
    x_webhook_signature: str | None = Header(None, alias="X-Webhook-Signature"),
) -> dict[str, str]:
    """
    Endpoint webhook generic cho các provider tùy chỉnh.

    Yêu cầu payload có định dạng:
    {
        "event_type": "payment.success | payment.failed | refund.completed",
        "gateway_transaction_id": "tx-xxx",
        "amount": 100000,
        "currency": "VND",
        "reference_code": "PAY-2026-0001",
        "metadata": {...}
    }

    Xác thực qua X-Webhook-Provider và X-Webhook-Signature headers.
    """
    body_bytes = await request.body()
    body = body_bytes.decode("utf-8")

    logger.info("Nhận webhook custom (provider: %s)", x_webhook_provider or "unknown")

    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        logger.warning("Custom webhook payload không phải JSON hợp lệ")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid JSON payload",
        )

    # Xác thực signature (sử dụng Stripe-like HMAC-SHA256)
    if x_webhook_signature and x_webhook_provider:
        service = PaymentService(db)
        try:
            provider = PaymentGatewayProvider(x_webhook_provider)
            config = service._get_gateway_config(provider, "default")
            webhook_secret = config.webhook_secret_reference or ""

            if not verify_stripe_signature(body, x_webhook_signature, webhook_secret):
                logger.warning("Custom webhook signature không hợp lệ (provider: %s)", x_webhook_provider)
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Invalid webhook signature",
                )
        except ValueError:
            logger.warning("Unknown provider: %s", x_webhook_provider)
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Unknown provider: {x_webhook_provider}",
            )
        except Exception:
            logger.warning("Không thể lấy config cho provider %s", x_webhook_provider)

    event_type = payload.get("event_type", "")
    data = payload.get("data", payload)

    if event_type in ("payment.success", "payment.completed"):
        handle_payment_success(
            db=db,
            gateway_provider=PaymentGatewayProvider(x_webhook_provider) if x_webhook_provider else PaymentGatewayProvider.CUSTOM,
            gateway_transaction_id=data.get("gateway_transaction_id", ""),
            amount=data.get("amount", 0),
            currency=data.get("currency", "VND"),
            reference_code=data.get("reference_code"),
            metadata=data,
        )
    elif event_type in ("payment.failed", "payment.error"):
        handle_payment_failed(
            db=db,
            gateway_provider=PaymentGatewayProvider(x_webhook_provider) if x_webhook_provider else PaymentGatewayProvider.CUSTOM,
            gateway_transaction_id=data.get("gateway_transaction_id", ""),
            error_code=data.get("error_code"),
            error_message=data.get("error_message"),
            reference_code=data.get("reference_code"),
        )
    elif event_type in ("refund.completed", "refund.success"):
        handle_refund_completed(
            db=db,
            gateway_provider=PaymentGatewayProvider(x_webhook_provider) if x_webhook_provider else PaymentGatewayProvider.CUSTOM,
            gateway_refund_id=data.get("gateway_refund_id", ""),
            gateway_transaction_id=data.get("gateway_transaction_id"),
            metadata=data,
        )
    elif event_type in ("refund.failed", "refund.error"):
        handle_refund_failed(
            db=db,
            gateway_provider=PaymentGatewayProvider(x_webhook_provider) if x_webhook_provider else PaymentGatewayProvider.CUSTOM,
            gateway_refund_id=data.get("gateway_refund_id", ""),
            error_code=data.get("error_code"),
            error_message=data.get("error_message"),
        )
    else:
        logger.info("Custom webhook event type chưa xử lý: %s", event_type)

    return {"status": "success", "message": f"Webhook '{event_type}' đã được xử lý"}
