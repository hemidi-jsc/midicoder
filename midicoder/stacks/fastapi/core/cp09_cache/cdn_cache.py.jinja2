import os
from typing import Optional

from fastapi import Request
from fastapi.responses import JSONResponse


CDN_PROVIDER = os.getenv("CDN_PROVIDER", "cloudflare")
CDN_ZONE_ID = os.getenv("CDN_ZONE_ID", "")
CDN_API_KEY = os.getenv("CDN_API_KEY", "")
DEFAULT_CDN_TTL = 3600


def get_cache_control_headers(
    public: bool = True,
    ttl: int | None = None,
    stale_while_revalidate: int = 60,
    stale_if_error: int = 300,
) -> dict[str, str]:
    """Xay dung Cache-Control headers cho CDN responses."""
    actual_ttl = ttl if ttl is not None else DEFAULT_CDN_TTL
    directives = ["public" if public else "private", f"max-age={actual_ttl}"]
    directives.append(f"stale-while-revalidate={stale_while_revalidate}")
    directives.append(f"stale-if-error={stale_if_error}")
    return {"Cache-Control": ", ".join(directives)}


async def cdn_cache_middleware(request: Request, call_next):
    """FastAPI middleware để add CDN cache headers."""
    response = await call_next(request)

    # Chỉ cache GET requests
    if request.method == "GET":
        response.headers["Cache-Control"] = ", ".join([
            "public",
            f"max-age={DEFAULT_CDN_TTL}",
            "stale-while-revalidate=60",
            "stale-if-error=300",
        ])
        response.headers["Vary"] = "Accept-Encoding"

    return response


async def purge_cdn_cache(path: str) -> bool:
    """Purge cache trên CDN cho 1 path cụ thể."""
    import httpx

    if not CDN_ZONE_ID or not CDN_API_KEY:
        return False

    if CDN_PROVIDER == "cloudflare":
        url = f"https://api.cloudflare.com/client/v4/zones/{CDN_ZONE_ID}/purge_cache"
        headers = {"Authorization": f"Bearer {CDN_API_KEY}"}
        async with httpx.AsyncClient() as client:
            resp = await client.post(url, json={"files": [path]}, headers=headers)
            return resp.status_code == 200

    return False


async def purge_cdn_all() -> bool:
    """Purge toàn bộ cache trên CDN."""
    import httpx

    if not CDN_ZONE_ID or not CDN_API_KEY:
        return False

    if CDN_PROVIDER == "cloudflare":
        url = f"https://api.cloudflare.com/client/v4/zones/{CDN_ZONE_ID}/purge_cache"
        headers = {"Authorization": f"Bearer {CDN_API_KEY}"}
        async with httpx.AsyncClient() as client:
            resp = await client.post(url, json={"purge_everything": True}, headers=headers)
            return resp.status_code == 200

    return False
