import os
from typing import Optional


# CloudFront settings
CDN_DOMAIN = os.getenv("CDN_DOMAIN", "{{ collection.cdn_config.domain if collection.cdn_config else '' }}")
CDN_DISTRIBUTION_ID = os.getenv("CDN_DISTRIBUTION_ID", "{{ collection.cdn_config.distribution_id if collection.cdn_config else '' }}")
CDN_SIGNED_URL = os.getenv("CDN_SIGNED_URL", "{{ 'true' if collection.cdn_config and collection.cdn_config.signed_url else 'false' }}").lower() == "true"
CDN_DEFAULT_TTL = int(os.getenv("CDN_DEFAULT_TTL", "{{ collection.cdn_config.default_ttl if collection.cdn_config else 86400 }}"))
CDN_MAX_TTL = int(os.getenv("CDN_MAX_TTL", "{{ collection.cdn_config.max_ttl if collection.cdn_config else 31536000 }}"))
USE_CDN_SIGNED_URL = os.getenv("USE_CDN_SIGNED_URL", "{{ 'true' if collection.presigned_policy and collection.presigned_policy.use_cdn_signed_url else 'false' }}").lower() == "true"
DEFAULT_PRESIGNED_EXPIRATION = int(os.getenv("PRESIGNED_EXPIRATION", "{{ collection.presigned_policy.expiration if collection.presigned_policy else 3600 }}"))

# Origin S3 bucket (cho CloudFront OAI)
CDN_ORIGIN_BUCKET = os.getenv("CDN_ORIGIN_BUCKET", "")
CLOUDFRONT_KEY_PAIR_ID = os.getenv("CLOUDFRONT_KEY_PAIR_ID", "")
CLOUDFRONT_PRIVATE_KEY = os.getenv("CLOUDFRONT_PRIVATE_KEY", "")


def get_cdn_url(key: str) -> str:
    """Trả về CDN URL cho một key."""
    if not CDN_DOMAIN:
        return ""
    return f"https://{CDN_DOMAIN}/{key.lstrip(chr(47))}"


def get_file_url(key: str, tenant_id: Optional[str] = None) -> str:
    """
    Trả về URL tốt nhất cho file:
    - Nếu CDN cấu hình → CDN URL
    - Nếu không → để S3 presigned xử lý
    """
    cdn_url = get_cdn_url(key)
    if cdn_url:
        return cdn_url
    return ""


def should_use_signed_url() -> bool:
    """Trả về True nếu nên dùng signed URL (CloudFront hoặc S3)."""
    return CDN_SIGNED_URL or USE_CDN_SIGNED_URL
