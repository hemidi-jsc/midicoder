# -------------------------------------------------------------------------
# GET /plugins/slots — Danh sách tất cả slots
# -------------------------------------------------------------------------


@router.get(
    "/slots",
    response_model=SlotListResponse,
    status_code=status.HTTP_200_OK,
)
async def list_slots(
    slot_registry: PluginSlotRegistry = Depends(get_slot_registry),
    plugin_registry: PluginRegistry = Depends(get_plugin_registry),
):
    """
    Lấy danh sách tất cả plugin slots.

    Returns:
        SlotListResponse
    """
    all_slots = slot_registry.get_all_slots()
    lifecycle_slots = slot_registry.get_lifecycle_slots()
    hook_slots = slot_registry.get_hook_slots()

    slot_list: list[SlotInfo] = []
    for slot_meta in all_slots:
        # Đếm số plugins hook vào slot này
        slot_id = slot_meta.get("name", slot_meta.get("id", ""))
        hooked_plugins = plugin_registry.get_by_slot(slot_id)
        plugin_count = len(hooked_plugins)

        slot_list.append(SlotInfo(
            id=slot_meta.get("id", slot_id),
            name=slot_id,
            is_tenant_aware=slot_meta.get("is_tenant_aware", False),
            priority_range=slot_meta.get("priority_range", [0, 100]),
            description=slot_meta.get("description", ""),
            plugin_count=plugin_count,
        ))

    return SlotListResponse(
        total=len(all_slots),
        lifecycle_slots=len(lifecycle_slots),
        hook_slots=len(hook_slots),
        slots=slot_list,
    )


# -------------------------------------------------------------------------
# GET /plugins/slots/{slot}/hooks — Plugins hook vào slot
# -------------------------------------------------------------------------


@router.get(
    "/slots/{slot_id}/hooks",
    response_model=SlotHooksResponse,
    status_code=status.HTTP_200_OK,
)
async def get_slot_hooks(
    slot_id: str = Path(..., description="Slot ID"),
    slot_registry: PluginSlotRegistry = Depends(get_slot_registry),
    plugin_registry: PluginRegistry = Depends(get_plugin_registry),
):
    """
    Lấy danh sách plugins hook vào slot cụ thể.

    Args:
        slot_id: Slot ID (ví dụ: "on_request", "before_create_user")

    Returns:
        SlotHooksResponse

    Raises:
        HTTPException 404: Slot không tồn tại
    """
    slot_meta = slot_registry.get_slot_metadata(slot_id)
    if slot_meta is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Slot '{slot_id}' không tìm thấy",
        )

    # Lấy plugins hook vào slot
    hooked_plugins = plugin_registry.get_by_slot(slot_id)

    hooks: list[PluginHookInfo] = []
    for plugin in hooked_plugins:
        entry = plugin_registry.get_entry(plugin.id)
        is_enabled = entry.status == PluginStatus.ENABLED if entry else False

        hooks.append(PluginHookInfo(
            plugin_id=plugin.id,
            plugin_name=plugin.name,
            plugin_version=plugin.version,
            is_enabled=is_enabled,
        ))

    return SlotHooksResponse(
        slot_id=slot_id,
        slot_name=slot_meta.get("name", slot_id),
        hooks=hooks,
    )


# ============================================================================
# Helper Functions
# ============================================================================


def _build_context_from_request(request: Optional[Request]) -> PluginContext:
    """
    Build PluginContext từ FastAPI Request.

    Extract tenant_id, user_id, request_id từ request state/headers.

    Args:
        request: FastAPI Request object

    Returns:
        PluginContext instance
    """
    tenant_id = ""
    user_id = ""
    request_id = ""

    if request:
        # KPI-029: Extract tenant_id từ request state
        tenant_id = getattr(request.state, "tenant_id", "")
        # Extract user_id từ request state
        user_id = getattr(request.state, "user_id", "")
        # Extract request_id từ header
        request_id = request.headers.get("X-Request-Id", "")

    return PluginContext(
        tenant_id=tenant_id,
        user_id=user_id,
        request_id=request_id,
    )
