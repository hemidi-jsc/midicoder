"""
Plugin API Router — tự động sinh bởi CP27.

Module này cung cấp FastAPI router với endpoints:
    GET     /plugins              — Danh sách tất cả plugins
    GET     /plugins/{id}         — Thông tin plugin cụ thể
    POST    /plugins/{id}/enable  — Enable plugin
    POST    /plugins/{id}/disable — Disable plugin
    POST    /plugins/{id}/configure — Cấu hình plugin
    GET     /plugins/{id}/status  — Trạng thái plugin
    GET     /plugins/slots        — Danh sách tất cả slots
    GET     /plugins/slots/{slot}/hooks — Plugins hook vào slot

CP27: Plugin System Generator
"""

from __future__ import annotations

from typing import Any, Optional

from fastapi import APIRouter, Depends, HTTPException, Path, Query, Request, status
from pydantic import BaseModel, Field

from .contracts import PluginContext, PluginStatus
from .manager import PluginManager, PluginStatusInfo
from .registry import PluginRegistry
from .slots import PluginSlotRegistry

# ============================================================================
# Pydantic Models — Request/Response
# ============================================================================


class PluginInfo(BaseModel):
    """
    Response model cho plugin information.

    Attributes:
        id: Plugin ID
        name: Plugin name
        version: Plugin version
        status: Plugin status string
        slots: Danh sách slot IDs
        config: Runtime config
        error: Error message (nếu có)
    """
    id: str = Field(..., description="Plugin ID duy nhất")
    name: str = Field(..., description="Tên plugin")
    version: str = Field(..., description="Version semver")
    status: str = Field(..., description="Trạng thái: disabled/loading/enabled/error")
    slots: list[str] = Field(default_factory=list, description="Danh sách slot IDs")
    config: dict[str, Any] = Field(default_factory=dict, description="Runtime config")
    error: Optional[str] = Field(None, description="Error message nếu có")


class PluginListResponse(BaseModel):
    """Response model cho danh sách plugins."""
    total: int = Field(..., description="Tổng số plugins")
    enabled: int = Field(..., description="Số plugins đang enabled")
    plugins: list[PluginInfo] = Field(default_factory=list, description="Danh sách plugins")


class PluginConfigureRequest(BaseModel):
    """Request model để cấu hình plugin."""
    config: dict[str, Any] = Field(
        default_factory=dict,
        description="Config dict để apply cho plugin",
    )


class SlotInfo(BaseModel):
    """Response model cho slot information."""
    id: str = Field(..., description="Slot ID")
    name: str = Field(..., description="Slot name")
    is_tenant_aware: bool = Field(..., description="Có cần tenant context không")
    priority_range: list[int] = Field(..., description="Priority range [min, max]")
    description: str = Field(..., description="Mô tả slot")
    plugin_count: int = Field(default=0, description="Số plugins hook vào slot này")


class SlotListResponse(BaseModel):
    """Response model cho danh sách slots."""
    total: int = Field(..., description="Tổng số slots")
    lifecycle_slots: int = Field(..., description="Số lifecycle slots")
    hook_slots: int = Field(..., description="Số before/after hook slots")
    slots: list[SlotInfo] = Field(default_factory=list, description="Danh sách slots")


class PluginHookInfo(BaseModel):
    """Thông tin plugin hook vào slot."""
    plugin_id: str = Field(..., description="Plugin ID")
    plugin_name: str = Field(..., description="Plugin name")
    plugin_version: str = Field(..., description="Plugin version")
    is_enabled: bool = Field(..., description="Plugin có enabled không")


class SlotHooksResponse(BaseModel):
    """Response model cho plugins hook vào slot."""
    slot_id: str = Field(..., description="Slot ID")
    slot_name: str = Field(..., description="Slot name")
    hooks: list[PluginHookInfo] = Field(default_factory=list, description="Danh sách plugins")


# ============================================================================
# Router
# ============================================================================

router = APIRouter(
    prefix="/plugins",
    tags=["plugins"],
)

# Dependencies


def get_plugin_manager() -> PluginManager:
    """Dependency — lấy PluginManager instance."""
    return PluginManager()


def get_plugin_registry() -> PluginRegistry:
    """Dependency — lấy PluginRegistry instance."""
    return PluginRegistry.get()


def get_slot_registry() -> PluginSlotRegistry:
    """Dependency — lấy PluginSlotRegistry instance."""
    return PluginSlotRegistry.get()


# -------------------------------------------------------------------------
# GET /plugins — Danh sách tất cả plugins
# -------------------------------------------------------------------------


@router.get("", response_model=PluginListResponse, status_code=status.HTTP_200_OK)
async def list_plugins(
    manager: PluginManager = PluginManager(),
):
    """
    Lấy danh sách tất cả plugins với trạng thái.

    Returns:
        PluginListResponse
    """
    plugins_info = manager.list_plugins()

    enabled_count = sum(
        1 for p in plugins_info if p.status == PluginStatus.ENABLED
    )

    plugin_list = [
        PluginInfo(
            id=p.id,
            name=p.name,
            version=p.version,
            status=p.status.value,
            slots=p.slots,
            config=p.config,
            error=p.error,
        )
        for p in plugins_info
    ]

    return PluginListResponse(
        total=len(plugins_info),
        enabled=enabled_count,
        plugins=plugin_list,
    )


# -------------------------------------------------------------------------
# GET /plugins/{id} — Thông tin plugin cụ thể
# -------------------------------------------------------------------------


@router.get(
    "/{plugin_id}",
    response_model=PluginInfo,
    status_code=status.HTTP_200_OK,
)
async def get_plugin(
    plugin_id: str = Path(..., description="Plugin ID"),
    manager: PluginManager = PluginManager(),
):
    """
    Lấy thông tin chi tiết của plugin.

    Args:
        plugin_id: Plugin ID

    Returns:
        PluginInfo

    Raises:
        HTTPException 404: Plugin không tồn tại
    """
    status_info = manager.get_status(plugin_id)

    if status_info is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Plugin '{plugin_id}' không tìm thấy",
        )

    return PluginInfo(
        id=status_info.id,
        name=status_info.name,
        version=status_info.version,
        status=status_info.status.value,
        slots=status_info.slots,
        config=status_info.config,
        error=status_info.error,
    )


# -------------------------------------------------------------------------
# POST /plugins/{id}/enable — Enable plugin
# -------------------------------------------------------------------------


@router.post(
    "/{plugin_id}/enable",
    response_model=PluginInfo,
    status_code=status.HTTP_200_OK,
)
async def enable_plugin(
    plugin_id: str = Path(..., description="Plugin ID"),
    request: Request = None,
    manager: PluginManager = PluginManager(),
):
    """
    Enable plugin — chạy lifecycle: init → configure → ready.

    Args:
        plugin_id: Plugin ID
        request: HTTP request (để extract tenant/user context)

    Returns:
        PluginInfo với status đã cập nhật

    Raises:
        HTTPException 404: Plugin không tồn tại
        HTTPException 400: Enable thất bại
    """
    # Xây dựng PluginContext từ request
    ctx = _build_context_from_request(request)

    success = manager.enable_plugin(plugin_id, ctx=ctx)

    if not success:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Không thể enable plugin '{plugin_id}'",
        )

    status_info = manager.get_status(plugin_id)
    if status_info is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Plugin '{plugin_id}' không tìm thấy",
        )

    return PluginInfo(
        id=status_info.id,
        name=status_info.name,
        version=status_info.version,
        status=status_info.status.value,
        slots=status_info.slots,
        config=status_info.config,
        error=status_info.error,
    )


