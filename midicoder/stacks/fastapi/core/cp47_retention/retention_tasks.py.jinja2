def cleanup_old_archives() -> None:
    """
    Scheduled task: dọn dẹp các bản ghi lưu trữ thất bại quá cũ.

    Tìm các archived records ở trạng thái FAILED đã tồn tại quá 30 ngày,
    đánh dấu lại sang PENDING để retry. Các records FAILED quá 90 ngày
    sẽ được log cảnh báo và giữ nguyên để audit.

    Chạy định kỳ theo cron: mỗi ngày lúc 3 giờ sáng (0 3 * * *).

    Flow:
        1. Lấy FAILED records < 30 ngày -> chuyển sang PENDING để retry
        2. Lấy FAILED records > 90 ngày -> log cảnh báo
        3. Log kết quả cleanup
    """
    db: Session | None = None
    try:
        db = _get_db_session()

        now = datetime.now(timezone.utc)
        retry_cutoff = now - timedelta(days=30)
        alert_cutoff = now - timedelta(days=90)

        # Lấy các FAILED records < 30 ngày để retry
        retry_records = (
            db.query(ArchivedRecordModel)
            .filter(
                ArchivedRecordModel.status == ArchiveStatus.FAILED,
                ArchivedRecordModel.created_at > retry_cutoff,
            )
            .all()
        )

        for record in retry_records:
            record.status = ArchiveStatus.PENDING
            record.error_message = ""
            retry_metadata = record.metadata or {}
            retry_metadata["retry_count"] = retry_metadata.get("retry_count", 0) + 1
            retry_metadata["last_retry_at"] = now.isoformat()
            record.metadata = retry_metadata

        # Lấy các FAILED records > 90 ngày để cảnh báo
        alert_records = (
            db.query(ArchivedRecordModel)
            .filter(
                ArchivedRecordModel.status == ArchiveStatus.FAILED,
                ArchivedRecordModel.created_at <= alert_cutoff,
            )
            .all()
        )

        db.commit()

        logger.info(
            "Hoàn tất cleanup archives: retry=%d, alert=%d",
            len(retry_records),
            len(alert_records),
        )

        if alert_records:
            for record in alert_records:
                logger.warning(
                    "Bản ghi lưu trữ FAILED quá 90 ngày: id='%s', entity='%s:%s', "
                    "error='%s', created_at='%s'",
                    record.id,
                    record.source_entity_type,
                    record.source_entity_id,
                    record.error_message[:200],
                    record.created_at.isoformat(),
                )

    except Exception as e:
        logger.error("Lỗi nghiêm trọng trong cleanup old archives: %s", str(e), exc_info=True)
    finally:
        if db:
            db.close()


