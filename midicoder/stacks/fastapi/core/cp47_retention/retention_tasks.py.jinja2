def run_archive_job() -> None:
    """
    Scheduled task: xử lý batch các bản ghi cần lưu trữ.

    Tìm tất cả archived records ở trạng thái PENDING, xử lý lưu trữ
    theo batch — tính checksum, tạo archive file, và cập nhật trạng thái.

    Chạy định kỳ theo cron: mỗi 15 phút (*/15 * * * *).
    Cấu hình batch_size từ template context.

    Flow:
        1. Lấy danh sách PENDING archived records (limit = batch_size)
        2. Xử lý từng record: tính checksum, tạo file lưu trữ
        3. Cập nhật trạng thái sang COMPLETED hoặc FAILED
        4. Log kết quả batch
    """
    db: Session | None = None
    try:
        db = _get_db_session()
        archive_service = ArchiveService(db)

        # Lấy danh sách bản ghi PENDING
        pending_records = (
            db.query(ArchivedRecordModel)
            .filter(ArchivedRecordModel.status == ArchiveStatus.PENDING)
            .limit({{ batch_size | default(100) }})
            .all()
        )

        if not pending_records:
            logger.debug("Không có bản ghi PENDING để xử lý archive")
            return

        logger.info(
            "Bắt đầu archive job: %d bản ghi PENDING, batch_size=%d",
            len(pending_records),
            {{ batch_size | default(100) }},
        )

        processed = 0
        failed = 0

        for record in pending_records:
            try:
                # Cập nhật trạng thái sang IN_PROGRESS
                record.status = ArchiveStatus.IN_PROGRESS
                db.commit()

                # Xử lý lưu trữ — tính checksum và tạo archive
                # (Trong production: upload lên S3/cold storage)
                import hashlib
                archive_data = json.dumps({
                    "entity_type": record.source_entity_type,
                    "entity_id": record.source_entity_id,
                    "archived_at": datetime.now(timezone.utc).isoformat(),
                }).encode("utf-8")

                checksum = hashlib.sha256(archive_data).hexdigest()

                # Cập nhật bản ghi sang COMPLETED
                record.status = ArchiveStatus.COMPLETED
                record.checksum = checksum
                record.archive_size_bytes = len(archive_data)
                record.completed_at = datetime.now(timezone.utc)
                processed += 1

            except Exception as e:
                failed += 1
                record.status = ArchiveStatus.FAILED
                record.error_message = str(e)
                logger.error(
                    "Lỗi khi lưu trữ record '%s' (entity: %s:%s): %s",
                    record.id,
                    record.source_entity_type,
                    record.source_entity_id,
                    str(e),
                )

        db.commit()

        logger.info(
            "Hoàn tất archive job: processed=%d, failed=%d, total=%d",
            processed,
            failed,
            len(pending_records),
        )

    except Exception as e:
        logger.error("Lỗi nghiêm trọng trong archive job: %s", str(e), exc_info=True)
    finally:
        if db:
            db.close()

