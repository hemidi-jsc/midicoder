def run_auto_erasure_creator() -> None:
    """
    Scheduled task: tự động tạo erasure requests cho dữ liệu hết hạn.

    Duyệt qua các chính sách retention có action=ERASE, tìm các thực thể
    đã vượt quá retention_days, và tự động tạo erasure requests.

    Chạy định kỳ theo cron: mỗi 12 giờ (0 */12 * * *).

    Flow:
        1. Lấy danh sách active policies có action=ERASE
        2. Với mỗi policy, tìm entities vượt quá retention_days
        3. Tạo erasure request cho từng entity
        4. Log kết quả
    """
    db: Session | None = None
    try:
        db = _get_db_session()
        erasure_service = ErasureService(db)

        # Lấy danh sách policies có action=ERASE
        erase_policies = (
            db.query(RetentionPolicyModel)
            .filter(
                RetentionPolicyModel.status == PolicyStatus.ACTIVE,
                RetentionPolicyModel.action == RetentionAction.ERASE,
            )
            .all()
        )

        if not erase_policies:
            logger.debug("Không có chính sách ERASE active — bỏ qua auto erasure creator")
            return

        logger.info(
            "Bắt đầu auto erasure creator: %d policies có action=ERASE",
            len(erase_policies),
        )

        created = 0

        for policy in erase_policies:
            cutoff_date = datetime.now(timezone.utc) - timedelta(days=policy.retention_days)

            # Tìm archived records đã COMPLETED vượt quá cutoff
            # (Trong production: query thực tế entity table)
            expired_records = (
                db.query(ArchivedRecordModel)
                .filter(
                    ArchivedRecordModel.policy_id == policy.id,
                    ArchivedRecordModel.status == ArchiveStatus.COMPLETED,
                    ArchivedRecordModel.created_at <= cutoff_date,
                )
                .limit({{ batch_size | default(100) }})
                .all()
            )

            for record in expired_records:
                try:
                    erasure_service.create_erasure_request(
                        data=ErasureRequestCreate(
                            target_entity_type=record.source_entity_type,
                            target_entity_id=record.source_entity_id,
                            reason=ErasureReason.DATA_RETENTION_EXPIRED,
                            scope=["users", "sessions", "logs"],
                            initiated_by="auto_erasure_scheduler",
                            metadata={
                                "policy_id": policy.policy_id,
                                "archive_record_id": str(record.id),
                                "retention_days": policy.retention_days,
                                "cutoff_date": cutoff_date.isoformat(),
                            },
                        ),
                        policy_id=policy.id,
                    )
                    created += 1
                except Exception as e:
                    logger.error(
                        "Lỗi khi tạo erasure request cho entity '%s:%s': %s",
                        record.source_entity_type,
                        record.source_entity_id,
                        str(e),
                    )

        logger.info(
            "Hoàn tất auto erasure creator: đã tạo %d erasure requests",
            created,
        )

    except Exception as e:
        logger.error("Lỗi nghiêm trọng trong auto erasure creator: %s", str(e), exc_info=True)
    finally:
        if db:
            db.close()


