def run_retention_scan() -> None:
    """
    Scheduled task: quét retention định kỳ.

    Duyệt qua tất cả chính sách retention đang hoạt động (status=ACTIVE),
    thực hiện scan để tìm các thực thể đã vượt quá retention period,
    và tạo các yêu cầu archive/purge/erase tương ứng.

    Chạy định kỳ theo cron: mỗi 6 giờ (0 */6 * * *).
    Cấu hình batch_size từ template context.

    Flow:
        1. Lấy danh sách active policies
        2. Quét từng policy — tìm entities vượt quá retention_days
        3. Tạo archived records cho action=ARCHIVE
        4. Tạo erasure requests cho action=ERASE
        5. Log kết quả scan chi tiết
    """
    db: Session | None = None
    try:
        db = _get_db_session()
        scan_service = RetentionScanService(db)
        policy_service = RetentionPolicyService(db)

        # Lấy danh sách chính sách đang hoạt động
        active_policies = policy_service.list_policies(status=PolicyStatus.ACTIVE.value)
        active_policy_count = len(active_policies)

        logger.info(
            "Bắt đầu retention scan định kỳ: %d active policies, batch_size=%d",
            active_policy_count,
            {{ batch_size | default(100) }},
        )

        if not active_policy_count:
            logger.info("Không có chính sách active — bỏ qua retention scan")
            return

        # Quét từng chính sách
        total_found = 0
        total_processed = 0
        total_failed = 0

        for policy in active_policies:
            try:
                # Lấy policy model từ database để scan
                policy_model = (
                    db.query(RetentionPolicyModel)
                    .filter(RetentionPolicyModel.policy_id == policy.policy_id)
                    .first()
                )
                if not policy_model:
                    logger.warning("Không tìm thấy model cho policy '%s' — bỏ qua", policy.policy_id)
                    continue

                result: RetentionScanResult = scan_service.scan_policy(
                    policy=policy_model,
                    batch_size={{ batch_size | default(100) }},
                    dry_run=False,
                )

                total_found += result.total_found
                total_processed += result.total_processed
                total_failed += result.total_failed

                if result.total_found > 0:
                    logger.info(
                        "Policy '%s': found=%d, processed=%d, failed=%d, duration=%.2fs",
                        policy.policy_id,
                        result.total_found,
                        result.total_processed,
                        result.total_failed,
                        result.duration_seconds,
                    )

            except Exception as e:
                total_failed += 1
                logger.error(
                    "Lỗi khi quét policy '%s': %s",
                    policy.policy_id,
                    str(e),
                    exc_info=True,
                )

        logger.info(
            "Hoàn tất retention scan định kỳ: total_found=%d, processed=%d, failed=%d, policies=%d",
            total_found,
            total_processed,
            total_failed,
            active_policy_count,
        )

    except Exception as e:
        logger.error("Lỗi nghiêm trọng trong retention scan task: %s", str(e), exc_info=True)
    finally:
        if db:
            db.close()


