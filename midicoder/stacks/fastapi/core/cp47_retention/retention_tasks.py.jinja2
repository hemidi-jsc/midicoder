        "name": "Xử lý yêu cầu xóa dữ liệu",
    })

    # Job 5: Auto erasure creator — mỗi 12 giờ
    jobs.append({
        "id": "auto_erasure_creator",
        "func": run_auto_erasure_creator,
        "trigger": "cron",
        "hour": "*/12",
        "minute": 0,
        "name": "Tự động tạo erasure requests",
    })
{% else %}
    # Job 4 & 5: Erasure jobs (TẮT)
    logger.info("Job 'erasure_processor' và 'auto_erasure_creator' bị tắt (enable_erasure=False)")
{% endif %}

    # Job N: Cleanup old archives — mỗi ngày lúc 3h sáng
    jobs.append({
        "id": "cleanup_old_archives",
        "func": cleanup_old_archives,
        "trigger": "cron",
        "hour": 3,
        "minute": 0,
        "name": "Dọn dẹp archived records thất bại quá cũ",
    })

    scheduler_enabled = {{ "True" if enable_scheduler else "False" }}
    logger.info(
        "Đã cấu hình %d scheduled jobs cho retention system (scheduler=%s)",
        len([j for j in jobs if j.get("func") and j["func"].__name__ != "None"]),
        "BẬT" if scheduler_enabled else "TẮT",
    )

    return jobs
