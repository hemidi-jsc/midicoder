    """
    body_bytes = await request.body()
    body = body_bytes.decode("utf-8")

    logger.info("Nhận webhook scan (body length: %d bytes)", len(body))

    # Xác thực signature nếu có
    if x_webhook_signature:
        webhook_secret = ""  # Lấy từ cấu hình webhook secret
        if not verify_webhook_signature(body, x_webhook_signature, webhook_secret):
            logger.warning("Retention scan webhook signature không hợp lệ")
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Invalid webhook signature",
            )

    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        logger.warning("Scan webhook payload không hợp lệ JSON")
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid JSON payload",
        )

    data = payload.get("data", {})

    handle_scan_completed(
        db=db,
        scan_id=data.get("scan_id", ""),
        policy_id=data.get("policy_id", ""),
        total_found=data.get("total_found", 0),
        total_processed=data.get("total_processed", 0),
        total_failed=data.get("total_failed", 0),
        duration_seconds=data.get("duration_seconds", 0.0),
        metadata=data.get("metadata"),
    )

    return {"status": "success", "message": "Webhook scan đã được xử lý"}
