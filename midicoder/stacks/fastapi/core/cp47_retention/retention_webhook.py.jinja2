def verify_webhook_signature(
    payload: str,
    signature: str,
    secret: str,
    tolerance: int = 300,
) -> bool:
    """
    Xác thực webhook signature chung cho retention events.

    Sử dụng HMAC-SHA256 với timestamp để xác thực nguồn gốc webhook
    và bảo vệ chống lại replay attack.

    Args:
        payload: Raw body của webhook request.
        signature: Giá trị signature từ header (format: t=timestamp,v1=signature).
        secret: Webhook signing secret.
        tolerance: Dung sai timestamp tính bằng giây (mặc định: 300s = 5 phút).

    Returns:
        True nếu signature hợp lệ và timestamp trong giới hạn, False nếu không.
    """
    try:
        # Parse signature header: t=timestamp,v1=signature
        parts = signature.split(",")
        signature_parts: dict[str, str] = {}
        for part in parts:
            key, value = part.split("=", 1)
            signature_parts[key] = value

        # Lấy timestamp
        timestamp_str = signature_parts.get("t", "")
        if not timestamp_str:
            logger.warning("Retention webhook signature không có timestamp")
            return False

        timestamp = int(timestamp_str)
        # Kiểm tra time drift — bảo vệ chống lại replay attack
        if abs(time.time() - timestamp) > tolerance:
            logger.warning(
                "Retention webhook timestamp quá cũ: %d (tolerance: %ds)",
                timestamp,
                tolerance,
            )
            return False

        # Lấy signature v1
        signature_v1 = signature_parts.get("v1", "")
        if not signature_v1:
            logger.warning("Retention webhook signature không có v1")
            return False

        # Tính toán expected signature
        signed_payload = f"{timestamp}.{payload}"
        expected_signature = hmac.new(
            secret.encode("utf-8"),
            signed_payload.encode("utf-8"),
            hashlib.sha256,
        ).hexdigest()

        # So sánh constant-time để tránh timing attack
        return hmac.compare_digest(expected_signature, signature_v1)

    except (ValueError, KeyError) as e:
        logger.error("Lỗi khi xác thực retention webhook signature: %s", str(e))
        return False


