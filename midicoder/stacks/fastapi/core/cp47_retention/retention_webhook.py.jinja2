        metadata: Metadata bổ sung.

    Returns:
        ErasureRequestModel đã cập nhật, hoặc None nếu không tìm thấy.
    """
    request = (
        db.query(ErasureRequestModel)
        .filter(ErasureRequestModel.id == request_id)
        .first()
    )

    if not request:
        logger.warning("Không tìm thấy yêu cầu xóa với id='%s'", request_id)
        return None

    # Chỉ cập nhật nếu đang ở trạng thái IN_PROGRESS
    if request.status != ErasureStatus.IN_PROGRESS:
        logger.info(
            "Yêu cầu xóa '%s' đang ở trạng thái %s — bỏ qua webhook",
            request_id,
            request.status.value,
        )
        return request

    # Cập nhật tiến độ xử lý
    existing_processed = request.systems_processed or []
    request.systems_processed = existing_processed + systems_processed

    # Kiểm tra xem có hệ thống nào thất bại không
    has_failure = any(
        s.get("status") == "failed" for s in systems_processed
    )

    if has_failure:
        request.status = ErasureStatus.FAILED
        failed_systems = [
            s.get("system", "unknown")
            for s in systems_processed
            if s.get("status") == "failed"
        ]
        request.error_message = (
            f"Xóa thất bại ở các hệ thống: {', '.join(failed_systems)}"
        )
    else:
        request.status = ErasureStatus.COMPLETED

    request.completed_at = datetime.now(timezone.utc)

    if metadata:
        existing = request.metadata or {}
        existing.update(metadata)
        request.metadata = existing

    db.commit()
    db.refresh(request)

    logger.info(
        "Yêu cầu xóa '%s' đã được cập nhật sang %s: systems=%d",
        request_id,
        request.status.value,
        len(systems_processed),
    )

    return request


