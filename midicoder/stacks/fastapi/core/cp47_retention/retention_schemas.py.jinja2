class BatchScanRequest(BaseModel):
    """
    Schema yêu cầu quét retention batch.

    Cho phép quét nhiều chính sách hoặc nhiều entity_type cùng lúc
    với kích thước batch tùy chỉnh để tránh overloading hệ thống.
    """

    model_config = ConfigDict(strict=True)

    policy_ids: list[str] | None = Field(
        default=None,
        description="Danh sách policy IDs để quét (nếu None thì quét tất cả active)",
    )
    entity_types: list[str] | None = Field(
        default=None,
        description="Danh sách entity_types để quét (nếu None thì quét tất cả)",
    )
    batch_size: int = Field(
        default={{ batch_size | default(100) }},
        ge=1,
        le=10000,
        description="Số bản ghi xử lý mỗi batch (1 - 10000)",
    )
    dry_run: bool = Field(
        default=False,
        description="Chế độ thử — chỉ đếm số lượng, không thực hiện hành động",
    )

    @model_validator(mode="after")
    def validate_filters(self) -> "BatchScanRequest":
        """Kiểm tra phải có ít nhất một bộ lọc."""
        if self.policy_ids is None and self.entity_types is None:
            return self  # Không có filter -> quét tất cả (hợp lệ)
        if self.policy_ids and not self.policy_ids:
            raise ValueError("Danh sách policy_ids không được để trống")
        if self.entity_types and not self.entity_types:
            raise ValueError("Danh sách entity_types không được để trống")
        return self


