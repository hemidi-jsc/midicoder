@router.get(
    "/exemptions",
    summary="Kiểm tra miễn retention",
    responses={
        200: {"description": "Kết quả kiểm tra miễn retention"},
    },
)
async def check_exemption(
    entity_type: str = Query(..., description="Loại thực thể cần kiểm tra"),
    entity_id: str = Query(..., description="ID của thực thể cần kiểm tra"),
    db=Depends(get_db),
) -> dict[str, object]:
    """
    Kiểm tra xem thực thể có được miễn retention không.

