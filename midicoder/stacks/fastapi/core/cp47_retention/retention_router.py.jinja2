@router.post(
    "/scan",
    summary="Quét retention scan",
    response_model=RetentionScanResult,
    responses={
        200: {"description": "Kết quả quét retention scan"},
        400: {"description": "Dữ liệu đầu vào không hợp lệ"},
        404: {"description": "Chính sách không tồn tại"},
    },
)
async def run_retention_scan(
    policy_id: str = Query(..., description="Policy ID của chính sách cần quét"),
    batch_size: int = Query(
        {{ batch_size | default(100) }},
        ge=1,
        le=10000,
        description="Số bản ghi xử lý mỗi batch",
    ),
    dry_run: bool = Query(
        False,
        description="Chế độ thử — chỉ đếm, không thực hiện hành động",
    ),
    db=Depends(get_db),
) -> RetentionScanResult:
    """
    Quét chính sách retention để tìm dữ liệu vượt quá retention period.

    Tìm các thực thể thuộc entity_type của chính sách đã tồn tại quá
    retention_days, và thực hiện hành động tương ứng hoặc chỉ đếm (dry_run).

    Kết quả bao gồm: số lượng tìm thấy, đã xử lý, thất bại, và lỗi chi tiết.
    """
    scan_service = _get_scan_service(db)
    policy_service = _get_policy_service(db)

    try:
        policy = policy_service.get_policy_by_uuid(policy_id)
    except ValueError:
        # Thử lấy theo policy_id string
        try:
            policy_read = policy_service.get_policy(policy_id)
            # Lấy model từ db
            from app.models.retention_models import RetentionPolicyModel
            policy = (
                db.query(RetentionPolicyModel)
                .filter(RetentionPolicyModel.policy_id == policy_id)
                .first()
            )
        except ValueError:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Không tìm thấy chính sách với id='{policy_id}'",
            )

    if not policy:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Không tìm thấy chính sách với id='{policy_id}'",
        )

    return scan_service.scan_policy(
        policy=policy,
        batch_size=batch_size,
        dry_run=dry_run,
    )


