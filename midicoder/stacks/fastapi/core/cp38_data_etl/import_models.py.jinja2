# ============================================================================
# Model: ImportJob
# ============================================================================

class ImportJob:
    """
    Model theo dõi tiến trình nhập liệu.

    Mỗi import job đại diện cho một lần upload và xử lý file nhập liệu.
    Theo dõi số lượng hàng đã xử lý, lỗi, và trạng thái hiện tại.

    Attributes:
        job_key: Khóa duy nhất của job (UUID)
        filename: Tên file gốc
        file_format: Định dạng file (csv, json)
        status: Trạng thái hiện tại
        total_rows: Tổng số hàng trong file
        processed_rows: Số hàng đã xử lý thành công
        error_count: Số hàng có lỗi
        file_size_bytes: Kích thước file (byte)
        target_table: Bảng đích trong database
        created_by: Người tạo job
        error_message: Thông báo lỗi nếu job thất bại
        started_at: Thời điểm bắt đầu xử lý
        completed_at: Thời điểm hoàn thành
        created_at: Thời điểm tạo job
        updated_at: Thời điểm cập nhật cuối
    """

    __tablename__ = "import_jobs"

    # Khóa duy nhất của job
    job_key: Mapped[str] = mapped_column(
        Uuid,
        primary_key=True,
        default=lambda: str(uuid4()),
        nullable=False,
        index=True,
        comment="Khóa duy nhất của import job (UUID)",
    )

    # Tên file gốc
    filename: Mapped[str] = mapped_column(
        String(512),
        nullable=False,
        comment="Tên file gốc khi upload",
    )

    # Định dạng file
    file_format: Mapped[str] = mapped_column(
        String(16),
        nullable=False,
        comment="Định dạng file: csv hoặc json",
    )

    # Trạng thái job
    status: Mapped[str] = mapped_column(
        String(32),
        nullable=False,
        default=JobStatus.pending.value,
        index=True,
        comment="Trạng thái: pending, running, completed, failed, cancelled",
    )

    # Tổng số hàng
    total_rows: Mapped[int] = mapped_column(
        Integer,
        nullable=True,
        default=0,
        comment="Tổng số hàng trong file",
    )

    # Số hàng đã xử lý thành công
    processed_rows: Mapped[int] = mapped_column(
        Integer,
        nullable=False,
        default=0,
        comment="Số hàng đã xử lý thành công",
    )

    # Số hàng có lỗi
    error_count: Mapped[int] = mapped_column(
        Integer,
        nullable=False,
        default=0,
        comment="Số hàng có lỗi",
    )

    # Kích thước file (byte)
    file_size_bytes: Mapped[int] = mapped_column(
        Integer,
        nullable=True,
        default=0,
        comment="Kích thước file tính bằng byte",
    )

    # Bảng đích
    target_table: Mapped[Optional[str]] = mapped_column(
        String(256),
        nullable=True,
        comment="Tên bảng đích trong database",
    )

    # Người tạo job
    created_by: Mapped[Optional[str]] = mapped_column(
        String(256),
        nullable=True,
        comment="User/tenant tạo job",
    )

    # Thông báo lỗi
    error_message: Mapped[Optional[str]] = mapped_column(
        Text,
        nullable=True,
        comment="Thông báo lỗi chi tiết nếu job thất bại",
    )

    # Thời điểm bắt đầu xử lý
    started_at: Mapped[Optional[datetime]] = mapped_column(
        DateTime,
        nullable=True,
        comment="Thời điểm bắt đầu execute job",
    )

    # Thời điểm hoàn thành
    completed_at: Mapped[Optional[datetime]] = mapped_column(
        DateTime,
        nullable=True,
        comment="Thời điểm hoàn thành (thành công hay thất bại)",
    )

    # Thời điểm tạo job
    created_at: Mapped[datetime] = mapped_column(
        DateTime,
        default=datetime.utcnow,
        nullable=False,
        index=True,
        comment="Thời điểm tạo import job",
    )

    # Thời điểm cập nhật cuối
    updated_at: Mapped[datetime] = mapped_column(
        DateTime,
        default=datetime.utcnow,
        onupdate=datetime.utcnow,
        nullable=False,
        comment="Thời điểm cập nhật cuối cùng",
    )

    # Relationship: các lỗi hàng
    row_errors: Mapped[List["ImportError"]] = relationship(
        "ImportError",
        back_populates="import_job",
        cascade="all, delete-orphan",
        lazy="selectin",
    )

    def to_dict(self, exclude: Optional[List[str]] = None) -> Dict[str, Any]:
        """
        Chuyển model thành dictionary.

        Args:
            exclude: List các field không include

        Returns:
            Dictionary chứa tất cả attributes
        """
        exclude = exclude or []
        result = {}
        for column in self.__table__.columns:
            if column.name not in exclude:
                value = getattr(self, column.name)
                if isinstance(value, datetime):
                    result[column.name] = value.isoformat()
                elif isinstance(value, UUID):
                    result[column.name] = str(value)
                else:
                    result[column.name] = value
        return result

    def progress_percentage(self) -> float:
        """Tính phần trăm tiến trình."""
        if not self.total_rows or self.total_rows == 0:
            return 0.0
        return round((self.processed_rows / self.total_rows) * 100, 2)

    def is_terminal(self) -> bool:
        """Kiểm tra job đã ở trạng thái cuối chưa."""
        return self.status in (
            JobStatus.completed.value,
            JobStatus.failed.value,
            JobStatus.cancelled.value,
        )

    def __repr__(self) -> str:
        return f"<ImportJob(job_key={self.job_key}, status={self.status}, filename={self.filename})>"


