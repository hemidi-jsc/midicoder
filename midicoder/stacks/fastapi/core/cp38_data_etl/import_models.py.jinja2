        error_message: Thông báo lỗi
        started_at: Thời điểm bắt đầu
        completed_at: Thời điểm hoàn thành
        created_at: Thời điểm tạo
        updated_at: Thời điểm cập nhật
    """

    __tablename__ = "etl_jobs"

    # Khóa duy nhất
    job_key: Mapped[str] = mapped_column(
        Uuid,
        primary_key=True,
        default=lambda: str(uuid4()),
        nullable=False,
        index=True,
        comment="Khóa duy nhất của ETL job (UUID)",
    )

    # Tên pipeline
    pipeline_name: Mapped[str] = mapped_column(
        String(256),
        nullable=False,
        comment="Tên của ETL pipeline",
    )

    # Nguồn dữ liệu
    source_type: Mapped[str] = mapped_column(
        String(64),
        nullable=False,
        comment="Loại nguồn: file, database, api",
    )

    # Cấu hình nguồn (JSON)
    source_config: Mapped[Optional[Dict[str, Any]]] = mapped_column(
        JSON,
        nullable=True,
        comment="Cấu hình chi tiết cho nguồn dữ liệu",
    )

    # Các bước transform (JSON list)
    transform_steps: Mapped[Optional[List[Dict[str, Any]]]] = mapped_column(
