    def progress_percentage(self) -> float:
        """Tính phần trăm tiến trình."""
        if not self.total_records or self.total_records == 0:
            return 0.0
        return round((self.processed_records / self.total_records) * 100, 2)

    def is_terminal(self) -> bool:
        """Kiểm tra job đã ở trạng thái cuối chưa."""
        return self.status in (
            JobStatus.completed.value,
            JobStatus.failed.value,
            JobStatus.cancelled.value,
        )

    def __repr__(self) -> str:
        return f"<ETLJob(job_key={self.job_key}, status={self.status}, pipeline={self.pipeline_name})>"


# ============================================================================
# Model: ETLMapping
# ============================================================================

class ETLMapping:
    """
    Model ánh xạ trường cho ETL transform.

    Định nghĩa cách ánh xạ trường từ nguồn sang đích.
    Mỗi mapping liên kết với một ETLJob.

    Attributes:
        id: Khóa chính (auto increment)
        etl_job_key: Khóa của ETL job liên kết
        source_field: Tên trường nguồn
        target_field: Tên trường đích
        transform_type: Loại transform (map, filter, aggregate, convert, rename)
        transform_config: Cấu hình transform (JSON)
        is_required: Trường có bắt buộc không
        default_value: Giá trị mặc định nếu trường trống
        created_at: Thời điểm tạo
    """

    __tablename__ = "etl_mappings"

    # Khóa chính
    id: Mapped[int] = mapped_column(
        Integer,
        primary_key=True,
        autoincrement=True,
        nullable=False,
        comment="Primary key",
    )

    # Khóa ETL job
    etl_job_key: Mapped[str] = mapped_column(
        Uuid,
        ForeignKey("etl_jobs.job_key", ondelete="CASCADE"),
        nullable=False,
        index=True,
        comment="Khóa của ETL job liên kết",
    )

    # Trường nguồn
    source_field: Mapped[str] = mapped_column(
        String(256),
        nullable=False,
        comment="Tên trường ở nguồn dữ liệu",
    )

    # Trường đích
    target_field: Mapped[str] = mapped_column(
        String(256),
        nullable=False,
        comment="Tên trường ở bảng đích",
    )

    # Loại transform
    transform_type: Mapped[Optional[str]] = mapped_column(
        String(64),
        nullable=True,
        comment="Loại transform: map, filter, aggregate, convert, rename",
    )

    # Cấu hình transform (JSON)
    transform_config: Mapped[Optional[Dict[str, Any]]] = mapped_column(
        JSON,
        nullable=True,
        comment="Cấu hình chi tiết cho transform",
    )

    # Có bắt buộc không
    is_required: Mapped[bool] = mapped_column(
        Boolean,
