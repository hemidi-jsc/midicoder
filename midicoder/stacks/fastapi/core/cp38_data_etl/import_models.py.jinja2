        DateTime,
        default=datetime.utcnow,
        onupdate=datetime.utcnow,
        nullable=False,
        comment="Thời điểm cập nhật cuối",
    )

    # Relationship: mappings
    mappings: Mapped[List["ETLMapping"]] = relationship(
        "ETLMapping",
        back_populates="etl_job",
        cascade="all, delete-orphan",
        lazy="selectin",
