        timeout_seconds: Thời gian timeout cho mỗi chunk (giây)
        parallel_workers: Số worker song song
        batch_commit_size: Số bản ghi mỗi lần commit
        continue_on_error: Tiếp tục khi gặp lỗi
        max_error_rate: Tỷ lệ lỗi tối đa (0.0 - 1.0)
