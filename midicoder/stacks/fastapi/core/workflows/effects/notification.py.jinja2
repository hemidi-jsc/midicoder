"""
Mô-đun Notification Effect.

Cung cấp:
- NotificationEffect: Effect cho sending notifications

KPI-029: Tenant Isolation - tenant_id được dùng cho notification filtering
"""

from typing import Any, Optional


class NotificationEffect:
    """
    Effect executor cho notifications.
    
    Send notifications (email, sms, push) khi transition fire.
    KPI-029: tenant_id được thêm vào notification payload.
    """

    async def execute(
        self,
        channel: str,
        template: str,
        recipient: str,
        payload: dict[str, Any] | None = None,
        tenant_id: Optional[str] = None,  # KPI-029: Tenant isolation
    ) -> dict[str, Any]:
        """
        Execute notification effect.
        
        KPI-029: tenant_id được thêm vào payload cho tenant-specific notifications.
        
        Args:
            channel: Notification channel (email, sms, push)
            template: Template name
            recipient: Recipient address
            payload: Template payload (optional)
            tenant_id: KPI-029: Tenant ID cho notification
            
        Returns:
            Result với send status
        """
        # KPI-029: Thêm tenant_id vào payload
        if tenant_id:
            if payload is None:
                payload = {}
            if "tenant_id" not in payload:
                payload["tenant_id"] = tenant_id
        
        # TODO: Integrate với CP12 Notification
        return {
            "status": "sent",
            "channel": channel,
            "template": template,
            "tenant_id": tenant_id,  # KPI-029: String format
        }
