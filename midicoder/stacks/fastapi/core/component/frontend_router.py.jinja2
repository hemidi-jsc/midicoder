"""FastAPI router cho frontend {{ app_name }} — config API + SPA fallback."""

from fastapi import APIRouter, Request
from fastapi.responses import HTMLResponse, JSONResponse
from pathlib import Path

from .frontend_config_service import ConfigService

router = APIRouter(prefix="/api/frontend", tags=["frontend"])


@router.get("/config")
async def get_config():
    """Trả về frontend app config."""
    return ConfigService.get_app_config().model_dump()


@router.get("/routes")
async def get_routes():
    """Trả về frontend routes config."""
    return [r.model_dump() for r in ConfigService.get_routes()]


@router.get("/state-store")
async def get_state_store():
    """Trả về frontend state store config."""
    store = ConfigService.get_state_store()
    return store.model_dump() if store else None


# SPA fallback — serve index.html cho mọi route không khớp
@router.get("/{path:path}")
async def spa_fallback(request: Request, path: str):
    """SPA fallback — serve index.html cho client-side routing."""
    spa_dir = Path(__file__).parent.parent / "static"
    index_file = spa_dir / "index.html"
    if index_file.exists():
        return HTMLResponse(content=index_file.read_text())
    return JSONResponse(status_code=404, content={"detail": "SPA not found"})
