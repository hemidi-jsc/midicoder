"""
Search Service cho FastAPI.

Cung cấp:
- Full-text search
- Filtering & sorting
- Pagination
- Highlighting
- KPI-029: Tenant-specific search filtering

KPI-029: Tenant Isolation - Hỗ trợ tenant filtering trong search operations
CP10: Search & Indexing
"""

import json
from typing import Any, Dict, List, Optional

from .elasticsearch import get_elasticsearch, get_tenant_elasticsearch, get_tenant_index_name


class SearchService:
    """
    Service cho Elasticsearch search operations.

    Hỗ trợ:
    - Full-text search
    - Filtered search
    - Aggregations
    - Highlighting

    KPI-029: Hỗ trợ tenant filtering để isolate search results theo tenant.
    """

    def __init__(self, index: str = "documents", tenant_id: Optional[str] = None) -> None:
        """
        Khởi tạo search service.

        Args:
            index: Default index name
            tenant_id: KPI-029: Tenant ID cho tenant-specific search
        """
        self.index = index
        self.tenant_id = tenant_id  # KPI-029: Tenant context

    async def search(
        self,
        query: str,
        index: Optional[str] = None,
        filters: Optional[Dict[str, Any]] = None,
        sort: Optional[List[str]] = None,
        size: int = 20,
        from_page: int = 0,
        highlight: bool = False,
        tenant_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Thực hiện full-text search.

        Args:
            query: Search query string
            index: Index name (override default)
            filters: Additional filters
            sort: Sort fields
            size: Số lượng kết quả trả về
            from_page: Pagination offset
            highlight: Enable highlighting
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Search results dictionary
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        target_index = get_tenant_index_name(index or self.index, effective_tenant_id)

        client = get_tenant_elasticsearch(effective_tenant_id) if effective_tenant_id else get_elasticsearch()

        # Build query
        search_body = {
            "query": {
                "multi_match": {
                    "query": query,
                    "fields": ["*"],
                    "fuzziness": "AUTO",
                }
            },
            "size": size,
            "from": from_page,
        }

        # KPI-029: Add tenant_id filter if not in custom filters
        if effective_tenant_id:
            tenant_filter = {"term": {"tenant_id": effective_tenant_id}}
            if filters:
                search_body["query"] = {
                    "bool": {
                        "must": [search_body["query"]],
                        "filter": [{"term": {k: v}} for k, v in filters.items()] + [tenant_filter],
                    }
                }
            else:
                search_body["query"] = {
                    "bool": {
                        "must": [search_body["query"]],
                        "filter": [tenant_filter],
                    }
                }
        elif filters:
            search_body["query"] = {
                "bool": {
                    "must": [search_body["query"]],
                    "filter": [{"term": {k: v}} for k, v in filters.items()],
                }
            }

        # Add sorting
        if sort:
            search_body["sort"] = [{"field": s} for s in sort]

        # Add highlighting
        if highlight:
            search_body["highlight"] = {
                "fields": {"*": {}},
                "pre_tags": ["<em>"],
                "post_tags": ["</em>"],
            }

        # Execute search
        response = await client.search(index=target_index, body=search_body)

        return {
            "hits": response["hits"]["hits"],
            "total": response["hits"]["total"]["value"],
            "took": response["took"],
        }

    async def search_multi_tenant(
        self,
        query: str,
        tenant_ids: List[str],
        index: Optional[str] = None,
        filters: Optional[Dict[str, Any]] = None,
        size: int = 20,
    ) -> Dict[str, Any]:
        """
        KPI-029: Search qua multiple tenants.

        Dùng cho admin users cần search qua nhiều tenants.

        Args:
            query: Search query string
            tenant_ids: Danh sách tenant IDs để search
            index: Index name (override default)
            filters: Additional filters
            size: Số lượng kết quả trả về

        Returns:
            Search results dictionary với tenant info
        """
        client = get_elasticsearch()
        target_index = index or self.index

        search_body = {
            "query": {
                "bool": {
                    "must": [
                        {
                            "multi_match": {
                                "query": query,
                                "fields": ["*"],
                                "fuzziness": "AUTO",
                            }
                        },
                    ],
                    "filter": [
                        {"terms": {"tenant_id": tenant_ids}},
                    ],
                }
            },
            "size": size,
        }

        if filters:
            search_body["query"]["bool"]["filter"].extend(
                [{"term": {k: v}} for k, v in filters.items()]
            )

        response = await client.search(index=target_index, body=search_body)

        return {
            "hits": response["hits"]["hits"],
            "total": response["hits"]["total"]["value"],
            "took": response["took"],
            "tenant_ids": tenant_ids,
        }

    async def index_document(
        self,
        doc_id: str,
        document: Dict[str, Any],
        index: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Index một document vào Elasticsearch.

        Args:
            doc_id: Document ID
            document: Document data
            index: Index name (override default)
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Index response
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        target_index = get_tenant_index_name(index or self.index, effective_tenant_id)

        client = get_tenant_elasticsearch(effective_tenant_id) if effective_tenant_id else get_elasticsearch()

        # KPI-029: Add tenant_id to document if not present
        doc_with_tenant = {**document}
        if effective_tenant_id and "tenant_id" not in doc_with_tenant:
            doc_with_tenant["tenant_id"] = effective_tenant_id

        response = await client.index(
            index=target_index,
            id=doc_id,
            body=doc_with_tenant,
            refresh=True,
        )

        return response

    async def delete_document(
        self,
        doc_id: str,
        index: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Xóa document từ Elasticsearch.

        Args:
            doc_id: Document ID
            index: Index name (override default)
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Delete response
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        target_index = get_tenant_index_name(index or self.index, effective_tenant_id)

        client = get_tenant_elasticsearch(effective_tenant_id) if effective_tenant_id else get_elasticsearch()

        response = await client.delete(
            index=target_index,
            id=doc_id,
            refresh=True,
        )

        return response

    async def delete_tenant_documents(
        self,
        tenant_id: str,
        index: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        KPI-029: Xóa tất cả documents của tenant.

        Dùng khi tenant bị xóa để cleanup tenant data.

        Args:
            tenant_id: ID của tenant
            index: Index name (override default)

        Returns:
            Delete response
        """
        target_index = get_tenant_index_name(index or self.index, tenant_id)
        client = get_tenant_elasticsearch(tenant_id)

        response = await client.delete_by_query(
            index=target_index,
            body={
                "query": {"term": {"tenant_id": tenant_id}},
            },
            refresh=True,
        )

        return response

    async def update_document(
        self,
        doc_id: str,
        updates: Dict[str, Any],
        index: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Cập nhật document trong Elasticsearch.

        Args:
            doc_id: Document ID
            updates: Fields to update
            index: Index name (override default)
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Update response
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        target_index = get_tenant_index_name(index or self.index, effective_tenant_id)

        client = get_tenant_elasticsearch(effective_tenant_id) if effective_tenant_id else get_elasticsearch()

        response = await client.update(
            index=target_index,
            id=doc_id,
            body={"doc": updates},
            refresh=True,
        )

        return response

    async def bulk_index(
        self,
        documents: List[Dict[str, Any]],
        index: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Bulk index nhiều documents.

        Args:
            documents: List của documents với doc_id
            index: Index name (override default)
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Bulk response
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        target_index = get_tenant_index_name(index or self.index, effective_tenant_id)

        client = get_tenant_elasticsearch(effective_tenant_id) if effective_tenant_id else get_elasticsearch()

        actions = []
        for doc in documents:
            doc_id = doc.pop("doc_id", None)
            
            # KPI-029: Add tenant_id to document if not present
            doc_with_tenant = {**doc}
            if effective_tenant_id and "tenant_id" not in doc_with_tenant:
                doc_with_tenant["tenant_id"] = effective_tenant_id

            if doc_id:
                actions.append(
                    {"index": {"_index": target_index, "_id": doc_id}}
                )
                actions.append(doc_with_tenant)
            else:
                actions.append({"index": {"_index": target_index}})
                actions.append(doc_with_tenant)

        response = await client.bulk(body=actions)
        return response
