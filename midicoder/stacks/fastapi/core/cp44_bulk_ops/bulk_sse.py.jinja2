        from fastapi import HTTPException
        raise HTTPException(
            status_code=503,
            detail="SSE không được hỗ trợ — cài đặt sse-starlette",
        )

    async def status_generator():
        """Generator chỉ gửi event khi status thay đổi."""
        job = db.query(BulkJobModel).filter(BulkJobModel.job_id == job_id).first()

        if not job:
            yield {
                "event": "error",
                "data": json.dumps({"error": "Job không tồn tại", "job_id": job_id}),
                "id": "0",
