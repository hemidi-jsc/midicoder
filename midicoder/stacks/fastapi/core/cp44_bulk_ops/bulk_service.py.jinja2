    def _calculate_delay(self, attempt: int, strategy: str) -> float:
        """
        Tính toán delay cho retry theo chiến lược.

        Args:
            attempt: Số lần attempt hiện tại (0-based).
            strategy: Tên chiến lược.

        Returns:
            Delay theo giây (float).
        """
        base_delay = 1.0

        if strategy == "exponential_backoff":
            return base_delay * (2 ** attempt)
        elif strategy == "fixed_delay":
            return base_delay
        elif strategy == "linear_backoff":
            return base_delay * attempt

        return base_delay

    # ========================================================================
    # DLQ Management
    # ========================================================================

    def get_dlq_entries(
        self,
        job_id: str | None = None,
    ) -> list[DLQEntryRead]:
        """
        Lấy danh sách DLQ entries, có thể lọc theo job_id.

        Args:
            job_id: Nếu có, chỉ lấy entries thuộc job này.

        Returns:
            List của DLQEntryRead.
        """
        query = self.db.query(DLQEntryModel)

        if job_id:
            query = query.filter(DLQEntryModel.job_id == job_id)

        entries = query.order_by(DLQEntryModel.failed_at.desc()).all()
        return [DLQEntryRead.model_validate(entry) for entry in entries]

    def replay_dlq_entry(self, entry_id: str) -> bool:
        """
        Replay một DLQ entry — đánh dấu entry đã được xử lý lại.

        Args:
            entry_id: ID của DLQ entry cần replay.

        Returns:
            True nếu replay thành công, False nếu entry không tồn tại.
        """
        entry = self.db.query(DLQEntryModel).filter(DLQEntryModel.entry_id == entry_id).first()

        if not entry:
            return False

        # Đánh dấu đã replay
        entry.replayed = True
        entry.replayed_at = datetime.now(timezone.utc)
        self.db.commit()

        # Emit event
        self._emit_event("bulk.dlq.replayed", str(entry.entry_id), entity_id=entry.entity_id)

        # Audit log
        self._audit_log("dlq_entry_replayed", str(entry.entry_id))

        return True

    async def _enqueue_to_dlq(
        self,
        job: BulkJobModel,
        entity_id: str,
        error: str,
        retry_count: int,
    ) -> None:
        """
        Enqueue một entity vào DLQ sau khi hết retry.

        Args:
            job: BulkJobModel gốc.
            entity_id: ID của entity thất bại.
            error: Thông báo lỗi.
            retry_count: Số lần retry đã thực hiện.
        """
        dlq_entry = DLQEntryModel(
            job_id=job.job_id,
            entity_id=entity_id,
            entity_type=job.entity_type,
            error=error,
            error_type=error.split(":")[0] if ":" in error else "Unknown",
            retry_count=retry_count,
            original_data={"entity_id": entity_id, "action": job.action.value},
        )

        self.db.add(dlq_entry)
        self.db.commit()

        logger.warning(
            "Entity %s đã được enqueue vào DLQ (job: %s, retries: %d)",
            entity_id,
            job.job_id,
            retry_count,
        )

