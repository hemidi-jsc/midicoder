    async def process_job_async(self, job_id: str) -> None:
        """
        Xử lý một bulk job theo kiểu async — chia job thành chunks
        và gọi worker.process_chunks để xử lý song song.

        Cập nhật trạng thái job từ PENDING -> PROCESSING -> COMPLETED/FAILED.

        Args:
            job_id: ID của job cần xử lý.

        Raises:
            MidicoderError: Nếu job không tồn tại hoặc đã đang chạy.
        """
        from app.workers.bulk_worker import process_chunks

        job = self.db.query(BulkJobModel).filter(BulkJobModel.job_id == job_id).first()

        if not job:
            raise EM.raise_error(
                ErrorCode.CP44_BULK_JOB_NOT_FOUND,
                job_id=job_id,
            )

        # Kiểm tra job có đang chạy không
        if job.status == BulkJobStatus.PROCESSING:
            raise EM.raise_error(
                ErrorCode.CP44_BULK_JOB_ALREADY_RUNNING,
                job_id=job_id,
            )

        # Cập nhật trạng thái sang PROCESSING
        job.status = BulkJobStatus.PROCESSING
        job.updated_at = datetime.now(timezone.utc)
        self.db.commit()

        # Emit event: job bắt đầu xử lý
        self._emit_event("bulk.job.started", str(job.job_id))

        # Callback: xử lý từng entity trong chunk
        async def process_callback(jid: str, eid: str) -> dict[str, Any]:
            return await self.process_chunk(jid, [eid], 0)

        # Gọi worker để xử lý chunks
        try:
            result = await process_chunks(
                job_id=str(job.job_id),
                all_entity_ids=job.entity_ids,
                chunk_size=job.chunk_size,
                max_concurrency=job.max_concurrency,
                process_callback=process_callback,
            )

            # Cập nhật kết quả thống kê
            job.succeeded = result.get("succeeded", 0)
            job.failed = result.get("failed", 0)
            job.skipped = result.get("skipped", 0)
            job.processed = job.succeeded + job.failed + job.skipped

            # Xác định trạng thái cuối cùng
            if job.failed > 0 and job.succeeded > 0:
                job.status = BulkJobStatus.PARTIALLY_COMPLETED
            elif job.failed > 0:
                job.status = BulkJobStatus.FAILED
            else:
                job.status = BulkJobStatus.COMPLETED

            job.completed_at = datetime.now(timezone.utc)
            job.updated_at = datetime.now(timezone.utc)
            self.db.commit()

            # Emit event: job hoàn thành
            event_type = "bulk.job.completed" if job.status == BulkJobStatus.COMPLETED else "bulk.job.failed"
            self._emit_event(event_type, str(job.job_id), result=result)

            # Audit log
            self._audit_log("bulk_job_finished", str(job.job_id), status=job.status.value, result=result)

        except Exception as e:
            job.status = BulkJobStatus.FAILED
            job.updated_at = datetime.now(timezone.utc)
            job.completed_at = datetime.now(timezone.utc)
            self.db.commit()

            logger.exception("Bulk job thất bại: %s", job_id)
            self._emit_event("bulk.job.failed", str(job.job_id), error=str(e))

    async def process_chunk(
        self,
        job_id: str,
        chunk_ids: list[str],
        chunk_number: int,
    ) -> dict[str, Any]:
        """
        Xử lý các entities trong một chunk với retry logic.

        Với mỗi entity: thử thực hiện operation, nếu thất bại thì retry
        theo max_retries lần. Sau khi hết retry, enqueue vào DLQ.

        Args:
            job_id: ID của job cha.
            chunk_ids: Danh sách entity IDs trong chunk.
            chunk_number: Số thứ tự của chunk.

        Returns:
            Dict với keys: succeeded, failed, skipped, details.
        """
        from app.workers.bulk_worker import calculate_delay

        job = self.db.query(BulkJobModel).filter(BulkJobModel.job_id == job_id).first()
        if not job:
            return {"succeeded": 0, "failed": 0, "skipped": 0, "details": []}

        succeeded = 0
        failed = 0
        skipped = 0
        details: list[dict[str, Any]] = []

        for entity_id in chunk_ids:
            result = await self._process_single_entity(
                job=job,
                entity_id=entity_id,
                max_retries=job.max_retries,
                retry_strategy=job.retry_strategy.value,
            )

            if result["success"]:
                succeeded += 1
            elif result.get("skipped"):
                skipped += 1
            else:
                failed += 1

            details.append(result)

            # Lưu kết quả vào BulkResultModel
            result_model = BulkResultModel(
                entity_id=entity_id,
                success=result["success"],
                error=result.get("error"),
                retry_count=result.get("retry_count", 0),
                metadata=result.get("metadata", {}),
            )
            self.db.add(result_model)

        # Cập nhật tiến độ job
        job.processed += len(chunk_ids)
        job.succeeded += succeeded
        job.failed += failed
        job.skipped += skipped
        job.updated_at = datetime.now(timezone.utc)
        self.db.commit()

        return {
            "succeeded": succeeded,
            "failed": failed,
            "skipped": skipped,
            "details": details,
        }

    async def _process_single_entity(
        self,
        job: BulkJobModel,
        entity_id: str,
        max_retries: int,
        retry_strategy: str,
    ) -> dict[str, Any]:
        """
        Xử lý một entity đơn lẻ với retry logic.

        Args:
            job: BulkJobModel chứa cấu hình.
            entity_id: ID của entity cần xử lý.
            max_retries: Số lần retry tối đa.
            retry_strategy: Chiến lược delay (exponential_backoff, fixed_delay, linear_backoff).

        Returns:
            Dict với keys: entity_id, success, error, retry_count.
        """
        from app.workers.bulk_worker import calculate_delay
        import asyncio

        last_error: str | None = None

        for attempt in range(max_retries + 1):
            try:
                # Thực thi operation cho entity
                # Đây là integration point — callback sẽ được thay thế bằng
                # thực tế operation (create/update/delete entity)
                result = await self._execute_entity_operation(job, entity_id)

                return {
                    "entity_id": entity_id,
                    "success": True,
                    "error": None,
                    "retry_count": attempt,
                    "metadata": {"result": result},
                }

            except Exception as e:
                last_error = str(e)
                logger.warning(
                    "Entity %s thất bại lần thứ %d/%d: %s",
                    entity_id,
                    attempt + 1,
                    max_retries + 1,
                    last_error,
                )

                if attempt < max_retries:
                    # Tính delay và chờ
                    delay = calculate_delay(attempt, retry_strategy)
                    await asyncio.sleep(delay)
                else:
                    # Hết retry — enqueue vào DLQ
                    if {{ dlq_enabled | lower }}:
                        await self._enqueue_to_dlq(job, entity_id, last_error, attempt + 1)

                    return {
                        "entity_id": entity_id,
                        "success": False,
                        "error": last_error,
                        "retry_count": attempt + 1,
                    }

        # Fallback: không nên đến đây, nhưng đảm bảo return
        return {
            "entity_id": entity_id,
            "success": False,
            "error": last_error or "Unknown error",
            "retry_count": max_retries + 1,
        }

