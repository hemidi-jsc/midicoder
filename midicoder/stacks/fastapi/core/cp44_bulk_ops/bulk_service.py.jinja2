    def cancel_job(self, job_id: str) -> BulkJobRead:
        """
        Hủy một bulk job đang chạy hoặc chờ xử lý.

        Chỉ cho phép hủy job có trạng thái PENDING hoặc PROCESSING.
        Job đã COMPLETED, FAILED, hoặc CANCELLED không thể hủy.

        Args:
            job_id: ID của job cần hủy.

        Returns:
            BulkJobRead với trạng thái CANCELLED.

        Raises:
            MidicoderError: Nếu job không tồn tại hoặc không thể hủy.
        """
        job = self.db.query(BulkJobModel).filter(BulkJobModel.job_id == job_id).first()

        if not job:
            raise EM.raise_error(
                ErrorCode.CP44_BULK_JOB_NOT_FOUND,
                job_id=job_id,
            )

        # Chỉ hủy được job đang chạy hoặc đang chờ
        if job.status not in (BulkJobStatus.PENDING, BulkJobStatus.PROCESSING, BulkJobStatus.QUEUED):
            raise EM.raise_error(
                ErrorCode.CP44_BULK_CANCEL_FAILED,
                job_id=job_id,
                current_status=job.status.value,
                reason=f"Không thể hủy job đang ở trạng thái {job.status.value}",
            )

        # Cập nhật trạng thái
        job.status = BulkJobStatus.CANCELLED
        job.updated_at = datetime.now(timezone.utc)
        job.completed_at = datetime.now(timezone.utc)

        self.db.commit()
        self.db.refresh(job)

        # Emit event
        self._emit_event("bulk.job.cancelled", str(job.job_id))

        # Audit log
        self._audit_log("bulk_job_cancelled", str(job.job_id))

        return BulkJobRead.model_validate(job)

