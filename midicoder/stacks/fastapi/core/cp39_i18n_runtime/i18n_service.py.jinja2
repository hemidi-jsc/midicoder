    "backend": "{{ cache_config.backend }}",
    "ttl_seconds": {{ cache_config.ttl_seconds }},
    "max_size": {{ cache_config.max_size }},
    "redis_url": {{ '"%s"'|format(cache_config.redis_url) if cache_config.redis_url else "None" }},
}

__all__ = [
    "TranslationService",
    "DEFAULT_CACHE_CONFIG",
]
