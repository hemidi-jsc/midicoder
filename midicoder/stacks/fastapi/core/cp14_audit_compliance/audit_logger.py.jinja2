import logging
from datetime import datetime
from enum import Enum
from typing import Any, Optional
from dataclasses import dataclass, asdict

logger = logging.getLogger(__name__)


class AuditEvent(str, Enum):
    """
    Audit event types.

    Types:
        USER_LOGIN: User login
        USER_LOGOUT: User logout
        PASSWORD_CHANGE: Password change
        DATA_CREATE: Data creation
        DATA_UPDATE: Data update
        DATA_DELETE: Data deletion
        PERMISSION_CHANGE: Permission change
        CONFIG_CHANGE: Configuration change
        EXPORT: Data export
        IMPORT: Data import
    """
    USER_LOGIN = "user_login"
    USER_LOGOUT = "user_logout"
    PASSWORD_CHANGE = "password_change"
    DATA_CREATE = "data_create"
    DATA_UPDATE = "data_update"
    DATA_DELETE = "data_delete"
    PERMISSION_CHANGE = "permission_change"
    CONFIG_CHANGE = "config_change"
    EXPORT = "export"
    IMPORT = "import"


@dataclass
class AuditRecord:
    """
    Audit record structure.

    Attributes:
        event: Audit event type
        user_id: User ID (nullable cho system events)
        tenant_id: Tenant ID
        resource_type: Resource type (entity name)
        resource_id: Resource ID (nullable)
        action: Action performed
        old_value: Old value (cho updates)
        new_value: New value (cho updates)
        metadata: Additional metadata
        ip_address: Client IP address
        user_agent: User agent string
        timestamp: Event timestamp
    """
    event: AuditEvent
    user_id: Optional[str]
    tenant_id: str
    resource_type: str
    resource_id: Optional[str]
    action: str
    old_value: Optional[dict[str, Any]] = None
    new_value: Optional[dict[str, Any]] = None
    metadata: Optional[dict[str, Any]] = None
    ip_address: Optional[str] = None
    user_agent: Optional[str] = None
    timestamp: datetime = None

    def __post_init__(self) -> None:
        """Set timestamp nếu chưa có."""
        if self.timestamp is None:
            self.timestamp = datetime.utcnow()

    def to_dict(self) -> dict[str, Any]:
        """
        Chuyển AuditRecord sang dictionary.

        Returns:
            Dictionary representation của AuditRecord
        """
        data = asdict(self)
        data["event"] = self.event.value
        data["timestamp"] = self.timestamp.isoformat()
        return data


class AuditLogger:
    """
    Audit Logger - Audit logging cho API.

    Class này:
    1. Log audit events
    2. Store audit records vào database
    3. Support multi-tenant audit logging (KPI-029)
    4. Mask sensitive data

    KPI-029: Tenant Isolation - Tất cả audit logs đều có tenant_id để enforce tenant boundaries.

    Usage:
        audit_logger = AuditLogger(db_session)
        audit_logger.log(AuditEvent.DATA_CREATE, user_id, tenant_id, "Order", order_id)
    """

    def __init__(self, db_session=None) -> None:
        """
        Khởi tạo AuditLogger.

        Args:
            db_session: Database session (optional)
        """
        self._db_session = db_session
        self._sensitive_fields = {"password", "secret", "token", "credit_card", "ssn"}

    async def log(
        self,
