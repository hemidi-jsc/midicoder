# coding: utf-8
"""
Media Transform Service cho FastAPI - Auto-generated by Midicoder CE.

Cung cấp:
- Image resize/thumbnail (Pillow)
- Format transcode (JPEG, PNG, WEBP, GIF)
- TRANSFORMS dict từ collection config

KPI-029: Tenant Isolation - Tenant-aware file operations
CP11: File Storage & Media
"""

import io
from typing import Optional

from PIL import Image


# Định dạng ảnh được phép
ALLOWED_IMAGE_FORMATS = {"JPEG", "PNG", "WEBP", "GIF"}
DEFAULT_QUALITY = 80


# =============================================================================
# TRANSFORMS dict — Sinh tự động từ {{ collection.transforms }}
# =============================================================================
# Format tuple: (transform_type, width, height, quality) cho resize/thumbnail
# Format tuple: (transform_type, None, None, quality, output_format) cho transcode

TRANSFORMS = {
{% for t in collection.transforms %}
    # {{ t.description or t.name }}
{% if t.transform_type.value == "resize" %}
    "{{ t.name }}": ({{ t.width or 800 }}, {{ t.height or 600 }}, {{ t.quality }}),
{% elif t.transform_type.value == "thumbnail" %}
    "{{ t.name }}": ({{ t.width or 100 }}, {{ t.height or 100 }}, {{ t.quality }}),
{% elif t.transform_type.value == "transcode" %}
    "{{ t.name }}": ("{{ t.format or 'jpeg' }}", {{ t.quality }}),
{% endif %}
{% endfor %}
}


# Mapping từ transform type string sang enum giá trị
_TRANSFORM_RESIZE = "resize"
_TRANSFORM_THUMBNAIL = "thumbnail"
_TRANSFORM_TRANSCODE = "transcode"


# =============================================================================
# MediaTransformService
# =============================================================================


class MediaTransformService:
    """
    Service cho media processing operations.

    Hỗ trợ:
    - Resize image theo kích thước tùy chỉnh
    - Tạo thumbnail với aspect ratio preserved
    - Transcode sang định dạng khác (JPEG, PNG, WEBP, GIF)

    KPI-029: Tích hợp tenant prefix khi lưu file transform kết quả.
    """

    def resize_image(
        self,
        image_bytes: bytes,
        width: int,
        height: int,
        quality: int = DEFAULT_QUALITY,
    ) -> bytes:
        """
        Resize image về kích thước cụ thể.

        Lưu ý: Phương thức này sẽ thay đổi aspect ratio nếu width/height
        không giống với tỷ lệ gốc của ảnh. Dùng `create_thumbnail` nếu
        cần giữ aspect ratio.

        Args:
            image_bytes: Nội dung ảnh đầu vào (bytes)
            width: Width target (pixel)
            height: Height target (pixel)
            quality: Chất lượng output (1-100), mặc định 80

        Returns:
            Ảnh đã resize dưới dạng bytes (format JPEG)

        Raises:
            ValueError: Nếu quality ngoài range 1-100
        """
        if quality < 1 or quality > 100:
            raise ValueError(f"Quality phải trong range 1-100, nhận được: {quality}")

        # Mở ảnh từ bytes
        img = Image.open(io.BytesIO(image_bytes))

        # Chuyển RGBA/P sang RGB để tương thích JPEG
        if img.mode in ("RGBA", "P"):
            img = img.convert("RGB")

        # Resize với LANCZOS filter (chất lượng cao nhất)
        img = img.resize((width, height), Image.LANCZOS)

        # Lưu kết quả vào bytes
        output = io.BytesIO()
        img.save(output, format="JPEG", quality=quality)
        return output.getvalue()

    def create_thumbnail(
        self,
        image_bytes: bytes,
        size: int = 100,
        quality: int = DEFAULT_QUALITY,
    ) -> bytes:
        """
        Tạo thumbnail cố định kích cỡ.

        Phương thức này giữ aspect ratio của ảnh gốc — ảnh được co vào
        trong hộp size x size mà không biến dạng.

        Ví dụ: Ảnh 1600x900 với size=200 sẽ thành 200x113.

        Args:
            image_bytes: Nội dung ảnh đầu vào (bytes)
            size: Kích thước thumbnail (pixel), mặc định 100
            quality: Chất lượng output (1-100), mặc định 80

        Returns:
            Thumbnail dưới dạng bytes (format JPEG)

        Raises:
            ValueError: Nếu quality ngoài range 1-100
        """
        if quality < 1 or quality > 100:
            raise ValueError(f"Quality phải trong range 1-100, nhận được: {quality}")

        # Mở ảnh từ bytes
        img = Image.open(io.BytesIO(image_bytes))

        # Chuyển RGBA/P sang RGB để tương thích JPEG
        if img.mode in ("RGBA", "P"):
            img = img.convert("RGB")

        # Tạo thumbnail — giữ aspect ratio
        img.thumbnail((size, size), Image.LANCZOS)

        # Lưu kết quả vào bytes
        output = io.BytesIO()
        img.save(output, format="JPEG", quality=quality)
        return output.getvalue()

    def transcode_image(
        self,
        image_bytes: bytes,
        output_format: str = "JPEG",
        quality: int = DEFAULT_QUALITY,
    ) -> bytes:
        """
        Chuyển đổi định dạng (format) của image.

        Hỗ trợ chuyển đổi giữa các định dạng:
        - JPEG (cần ảnh RGB, không hỗ trợ transparency)
        - PNG (hỗ trợ RGBA, không dùng quality param)
        - WEBP (hỗ trợ RGBA và quality param)
        - GIF (hỗ trợ P mode, không dùng quality param)

        Args:
            image_bytes: Nội dung ảnh đầu vào (bytes)
            output_format: Định dạng output (JPEG, PNG, WEBP, GIF)
            quality: Chất lượng output (1-100), mặc định 80

        Returns:
            Ảnh đã chuyển đổi định dạng (bytes)

        Raises:
            ValueError: Nếu format không được hỗ trợ hoặc quality ngoài range
        """
        fmt = output_format.upper()

        # Validate định dạng
        if fmt not in ALLOWED_IMAGE_FORMATS:
            raise ValueError(
                f"Định dạng không được hỗ trợ: {fmt}. "
                f"Hỗ trợ: {', '.join(sorted(ALLOWED_IMAGE_FORMATS))}"
            )

        if quality < 1 or quality > 100:
            raise ValueError(f"Quality phải trong range 1-100, nhận được: {quality}")

        # Mở ảnh từ bytes
        img = Image.open(io.BytesIO(image_bytes))

        # Chuyển RGBA/P sang RGB nếu chuyển sang JPEG
        if fmt == "JPEG" and img.mode in ("RGBA", "P"):
            img = img.convert("RGB")

        # Chuẩn bị tham số save
        output = io.BytesIO()
        save_kwargs: dict = {"format": fmt}

        # Thêm quality cho các format hỗ trợ
        if fmt in ("JPEG", "WEBP"):
            save_kwargs["quality"] = quality

        # Lưu kết quả
        img.save(output, **save_kwargs)
        return output.getvalue()

    def apply_transform(
        self,
        image_bytes: bytes,
        transform_name: str,
    ) -> bytes:
        """
        Apply transform theo tên từ TRANSFORMS dict.

        Tự động lookup config từ TRANSFORMS và gọi phương thức tương ứng.

        Args:
            image_bytes: Nội dung ảnh đầu vào (bytes)
            transform_name: Tên transform trong TRANSFORMS dict

        Returns:
            Ảnh đã xử lý (bytes)

        Raises:
            ValueError: Nếu transform_name không tìm thấy hoặc loại không hợp lệ
        """
        config = TRANSFORMS.get(transform_name)
        if not config:
            available = ", ".join(sorted(TRANSFORMS.keys()))
            raise ValueError(
                f"Không tìm thấy transform: '{transform_name}'. "
                f"Có sẵn: {available}"
            )

        # Xác định loại transform từ cấu trúc tuple
        # Resize/thumbnail: (width, height, quality) — 3 phần tử, phần 1 là int
        # Transcode: (format_str, quality) — 2 phần tử, phần 1 là str
        if len(config) == 3 and isinstance(config[0], int):
            # Resize: (width, height, quality)
            return self.resize_image(
                image_bytes,
                width=config[0],
                height=config[1],
                quality=config[2],
            )
        elif len(config) == 2 and isinstance(config[0], str):
            # Transcode: (output_format, quality)
            return self.transcode_image(
                image_bytes,
                output_format=config[0],
                quality=config[1],
            )
        else:
            raise ValueError(f"Cấu trúc transform không hợp lệ cho: {transform_name}")
