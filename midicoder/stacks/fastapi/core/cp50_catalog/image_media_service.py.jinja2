"""
Dịch vụ quản lý hình ảnh & phương tiện cho catalog sản phẩm.

Tự động generate — không sửa tay.

Mục đích:
- Tải lên hình ảnh sản phẩm và phương tiện liên quan
- Tạo thumbnail tự động (nhiều kích thước)
- Sinh URL CDN cho hình ảnh
- Trích xuất metadata từ file ảnh (EXIF, kích thước, định dạng)

Pattern: B19 — Catalog Image Media Management
"""

import logging
import uuid
from pathlib import Path
from typing import Any, Dict, List, Optional

from fastapi import HTTPException, UploadFile
from PIL import Image

logger = logging.getLogger(__name__)


class ImageMediaService:
    """Dịch vụ xử lý hình ảnh cho catalog sản phẩm.

    Tích hợp với CP11 File Storage cho lưu trữ, tự động tạo
    nhiều kích thước thumbnail và sinh URL CDN.
    """

    THUMBNAIL_SIZES = {
        "tiny": (48, 48),
        "small": (128, 128),
        "medium": (400, 400),
        "large": (800, 800),
    }
    ALLOWED_TYPES = {"image/jpeg", "image/png", "image/webp", "image/gif"}
    MAX_FILE_SIZE = 10 * 1024 * 1024  # 10 MB

    def __init__(self, storage_service: Any, cdn_base_url: str = ""):
        """Khởi tạo ImageMediaService.

        Args:
            storage_service: Dịch vụ lưu trữ file (CP11 integration).
            cdn_base_url: URL cơ sở của CDN để sinh đường dẫn công khai.
        """
        self.storage = storage_service
        self.cdn_base = cdn_base_url.rstrip("/")

    async def upload_image(
        self,
        file: UploadFile,
        product_id: str,
        tenant_id: str,
        is_primary: bool = False,
    ) -> Dict[str, Any]:
        """Tải lên hình ảnh sản phẩm và tạo thumbnail.

        Args:
            file: File ảnh từ client.
            product_id: ID sản phẩm để gắn hình ảnh.
            tenant_id: ID tenant để cách ly dữ liệu.
            is_primary: Có phải hình chính của sản phẩm không.

        Returns:
            Dictionary chứa image_id, CDN URLs, và metadata.

        Raises:
            HTTPException: Nếu file không hợp lệ hoặc vượt quá dung lượng.
        """
        # Xác thực loại file
        if file.content_type not in self.ALLOWED_TYPES:
            raise HTTPException(
                status_code=400,
                detail=f"Định dạng không hỗ trợ: {file.content_type}",
            )

        # Đọc nội dung và kiểm tra kích thước
        content = await file.read()
        if len(content) > self.MAX_FILE_SIZE:
            raise HTTPException(status_code=413, detail="File quá lớn (tối đa 10 MB)")

        # Trích xuất metadata từ ảnh gốc
        metadata = self._extract_metadata(content)

        # Lưu ảnh gốc lên storage (CP11)
        file_extension = Path(file.filename or "image").suffix
        original_key = f"{tenant_id}/catalog/{product_id}/original/{uuid.uuid4()}{file_extension}"
        await self.storage.save(original_key, content, file.content_type)

        # Tạo và lưu các kích thước thumbnail
        thumbnail_urls = await self._generate_thumbnails(content, tenant_id, product_id, file_extension)

        # Sinh URL CDN cho ảnh gốc
        original_url = f"{self.cdn_base}/{original_key}"

        return {
            "image_id": str(uuid.uuid4()),
            "original_key": original_key,
            "original_url": original_url,
            "thumbnails": thumbnail_urls,
            "metadata": metadata,
            "is_primary": is_primary,
            "product_id": product_id,
        }

    async def _generate_thumbnails(
        self,
        content: bytes,
        tenant_id: str,
        product_id: str,
        extension: str,
    ) -> Dict[str, str]:
        """Tạo thumbnail cho nhiều kích thước và lưu lên storage.

        Args:
            content: Nội dung ảnh gốc.
            tenant_id: ID tenant.
            product_id: ID sản phẩm.
            extension: Phần mở rộng file.

        Returns:
            Mapping từ kích thước tên đến URL CDN.
        """
        import io

        urls: Dict[str, str] = {}
        img = Image.open(io.BytesIO(content))
        img.load()  # đảm bảo nội dung đã được đọc đầy đủ

        for size_name, size_tuple in self.THUMBNAIL_SIZES.items():
            thumb = img.copy()
            thumb.thumbnail(size_tuple, Image.LANCZOS)
            # Chuyển RGBA sang RGB nếu cần (WebP/PNG hỗ trợ alpha)
            if thumb.mode in ("RGBA", "P") and extension.lower() == ".jpg":
                thumb = thumb.convert("RGB")

            buffer = io.BytesIO()
            save_format = "JPEG" if extension.lower() in (".jpg", ".jpeg") else "PNG"
            thumb.save(buffer, format=save_format, quality=85)

            thumb_key = f"{tenant_id}/catalog/{product_id}/{size_name}/{uuid.uuid4()}{extension}"
            await self.storage.save(thumb_key, buffer.getvalue(), "image/jpeg")
            urls[size_name] = f"{self.cdn_base}/{thumb_key}"

        return urls

    @staticmethod
    def _extract_metadata(content: bytes) -> Dict[str, Any]:
        """Trích xuất metadata từ nội dung file ảnh.

        Args:
            content: Byte content của file ảnh.

        Returns:
            Dictionary chứa width, height, format, color mode.
        """
        import io

        img = Image.open(io.BytesIO(content))
        img.load()
        return {
            "width": img.width,
            "height": img.height,
            "format": img.format or "unknown",
            "mode": img.mode,
            "aspect_ratio": round(img.width / img.height, 2) if img.height else 0,
        }

    def get_cdn_url(self, storage_key: str) -> str:
        """Sinh URL CDN từ storage key.

        Args:
            storage_key: Khóa lưu trữ của file.

        Returns:
            URL CDN công khai.
        """
        return f"{self.cdn_base}/{storage_key}"

    async def delete_image_assets(self, tenant_id: str, product_id: str, image_id: str) -> None:
        """Xóa tất cả tài nguyên ảnh (gốc + thumbnail).

        Args:
            tenant_id: ID tenant.
            product_id: ID sản phẩm.
            image_id: ID hình ảnh cần xóa.
        """
        logger.info("Xóa tài nguyên ảnh: tenant=%s product=%s image=%s", tenant_id, product_id, image_id)
        # Implement cleanup logic with storage service
        await self.storage.delete_prefix(f"{tenant_id}/catalog/{product_id}/")
