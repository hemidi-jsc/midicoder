"""
RBAC Decorators - Role-Based Access Control cho FastAPI.

Module này cung cấp decorators và dependencies cho RBAC trong FastAPI.
Hỗ trợ @require_permission, @require_role, và policy evaluation.

CP03 + CP04: Authentication & Authorization + RBAC & Policy Engine
KPI-029: Tenant Isolation - tenant_id được pass vào permission checks
"""

from functools import wraps
from typing import Any, Callable, Optional

from fastapi import Depends, HTTPException, status

from app.core.security.jwt_auth import TokenData, get_current_user
from app.core.security.rbac_service import RBACService, get_rbac_service
from app.core.security.tenant_context import get_tenant_id


# ============================================================================
# RBAC Dependencies
# ============================================================================


async def require_permission(
    permission: str,
    current_user: TokenData = Depends(get_current_user),
    rbac: RBACService = Depends(get_rbac_service),
) -> TokenData:
    """
    Dependency để require permission cụ thể.

    KPI-029: tenant_id được extract từ current_user để check tenant-scoped permission.

    Args:
        permission: Permission ID để require (ví dụ: "order.create")
        current_user: Current user từ JWT token
        rbac: RBAC service

    Returns:
        TokenData nếu user có permission

    Raises:
        HTTPException: Nếu user không có permission
    """
    # KPI-029: Get tenant_id from current_user
    tenant_id = current_user.tenant_id

    if not await rbac.check_permission(current_user, permission, tenant_id=tenant_id):
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Không có permission: {permission}",
        )

    return current_user


async def require_role(
    role: str,
    current_user: TokenData = Depends(get_current_user),
) -> TokenData:
    """
    Dependency để require role cụ thể.

    Args:
        role: Role name để require (ví dụ: "admin")
        current_user: Current user từ JWT token

    Returns:
        TokenData nếu user có role

    Raises:
        HTTPException: Nếu user không có role
    """
    if role not in current_user.roles:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Không có role: {role}",
        )

    return current_user


async def require_any_role(
    roles: list[str],
    current_user: TokenData = Depends(get_current_user),
) -> TokenData:
    """
    Dependency để require ít nhất một role từ danh sách.

    Args:
        roles: Danh sách role names
        current_user: Current user từ JWT token

    Returns:
        TokenData nếu user có ít nhất một role

    Raises:
        HTTPException: Nếu user không có role nào
    """
    if not any(role in current_user.roles for role in roles):
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Không có roles: {', '.join(roles)}",
        )

    return current_user


async def require_all_roles(
    roles: list[str],
    current_user: TokenData = Depends(get_current_user),
) -> TokenData:
    """
    Dependency để require tất cả roles.

    KPI-029: Nếu có tenant-specific roles, verify tenant match.

    Args:
        roles: Danh sách role names cần có tất cả
        current_user: Current user từ JWT token

    Returns:
        TokenData nếu user có tất cả roles

    Raises:
        HTTPException: Nếu user thiếu role
    """
    missing_roles = [role for role in roles if role not in current_user.roles]

    if missing_roles:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Thiếu roles: {', '.join(missing_roles)}",
        )

    # KPI-029: Check tenant-specific roles
    # Example: if "tenant_admin:tenant-123" is required, verify tenant match
    for role in roles:
        if ":" in role:
            role_tenant_id = role.split(":")[1]
            if current_user.tenant_id and current_user.tenant_id != role_tenant_id:
                raise HTTPException(
                    status_code=status.HTTP_403_FORBIDDEN,
                    detail=f"Role {role} không áp dụng cho tenant này",
                )

    return current_user


# ============================================================================
# Policy Evaluation Dependency
# ============================================================================


async def require_policy(
    policy_id: str,
    context: dict[str, Any],
    current_user: TokenData = Depends(get_current_user),
    rbac: RBACService = Depends(get_rbac_service),
) -> TokenData:
    """
    Dependency để require policy evaluation.

    KPI-029: tenant_id được thêm vào context cho policy evaluation.

    Args:
        policy_id: Policy ID để evaluate
        context: Context cho policy evaluation
        current_user: Current user từ JWT token
        rbac: RBAC service

    Returns:
        TokenData nếu policy cho phép

    Raises:
        HTTPException: Nếu policy không cho phép
    """
    # Add user info to context
    context.update({
        "user_id": current_user.user_id,
        "roles": current_user.roles,
        # KPI-029: Add tenant_id to context
        "tenant_id": current_user.tenant_id,
    })

    if not await rbac.check_policy(policy_id, context):
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Policy không cho phép: {policy_id}",
        )

    return current_user


# ============================================================================
# RBAC Decorators
# ============================================================================


def require_permissions(*permissions: str):
    """
    Decorator để require permissions.

    Usage:
        @router.get("/orders")
        @require_permissions("order.read", "order.list")
        async def get_orders(...):
            ...

    Args:
        permissions: Danh sách permission IDs

    Returns:
        Decorated function
    """

    def decorator(func: Callable) -> Callable:
        @wraps(func)
        async def wrapper(*args, **kwargs):
            # Check if all permissions are present in kwargs
            for permission in permissions:
                if permission not in kwargs:
                    raise HTTPException(
                        status_code=status.HTTP_403_FORBIDDEN,
                        detail=f"Không có permission: {permission}",
                    )

            return await func(*args, **kwargs)

        return wrapper

    return decorator


def require_roles(*roles: str):
    """
    Decorator để require roles (any).

    Usage:
        @router.get("/admin")
        @require_roles("admin", "super_admin")
        async def admin_panel(...):
            ...

    Args:
        roles: Danh sách role names (user cần có ít nhất một)

    Returns:
        Decorated function
    """

    def decorator(func: Callable) -> Callable:
        @wraps(func)
        async def wrapper(*args, **kwargs):
            # Get current_user from kwargs
            current_user = kwargs.get("current_user")

            if not current_user:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="User không tìm thấy",
                )

            # Check if user has any of the required roles
            if not any(role in current_user.roles for role in roles):
                raise HTTPException(
                    status_code=status.HTTP_403_FORBIDDEN,
                    detail=f"Không có roles: {', '.join(roles)}",
                )

            return await func(*args, **kwargs)

        return wrapper

    return decorator


# ============================================================================
# Helper Functions
# ============================================================================


def get_required_permissions(permission: str) -> list[str]:
    """
    Lấy required permissions từ permission string.

    Hỗ trợ cả single permission và comma-separated.

    Args:
        permission: Permission string

    Returns:
        Danh sách permission IDs
    """
    if "," in permission:
        return [p.strip() for p in permission.split(",")]

    return [permission]


def get_required_roles(role: str) -> list[str]:
    """
    Lấy required roles từ role string.

    Hỗ trợ cả single role và comma-separated.

    Args:
        role: Role string

    Returns:
        Danh sách role names
    """
    if "," in role:
        return [r.strip() for r in role.split(",")]

    return [role]


# ============================================================================
# KPI-029: Tenant-Specific RBAC
# ============================================================================


async def require_tenant_admin(
    current_user: TokenData = Depends(get_current_user),
) -> TokenData:
    """
    KPI-029: Dependency để require tenant admin role.

    Verify user là admin của tenant hiện tại.

    Args:
        current_user: Current user từ JWT token

    Returns:
        TokenData nếu user là tenant admin

    Raises:
        HTTPException: Nếu user không phải tenant admin
    """
    # Check if user has tenant_admin role or is super admin
    if "tenant_admin" not in current_user.roles and "super_admin" not in current_user.roles:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Cần tenant admin hoặc super admin permission",
        )

    return current_user


async def require_super_admin(
    current_user: TokenData = Depends(get_current_user),
) -> TokenData:
    """
    KPI-029: Dependency để require super admin (multitenant admin).

    Super admin có thể access tất cả tenants.

    Args:
        current_user: Current user từ JWT token

    Returns:
        TokenData nếu user là super admin

    Raises:
        HTTPException: Nếu user không phải super admin
    """
    if "super_admin" not in current_user.roles:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Cần super admin permission",
        )

    return current_user
