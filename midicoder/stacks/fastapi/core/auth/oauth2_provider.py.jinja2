# Pre-configured OAuth2 Providers
# ============================================================================


def get_google_oauth2_config() -> OAuth2ProviderConfig:
    """
    Get Google OAuth2 configuration.

    Returns:
        OAuth2ProviderConfig cho Google
    """
    return OAuth2ProviderConfig(
        name="google",
        client_id="",  # Set từ environment variables
        client_secret="",  # Set từ environment variables
        authorization_url="https://accounts.google.com/o/oauth2/v2/auth",
        token_url="https://oauth2.googleapis.com/token",
        user_info_url="https://www.googleapis.com/oauth2/v3/userinfo",
        scope="openid email profile",
    )


def get_github_oauth2_config() -> OAuth2ProviderConfig:
    """
    Get GitHub OAuth2 configuration.

    Returns:
        OAuth2ProviderConfig cho GitHub
    """
    return OAuth2ProviderConfig(
        name="github",
        client_id="",  # Set từ environment variables
        client_secret="",  # Set từ environment variables
        authorization_url="https://github.com/login/oauth/authorize",
        token_url="https://github.com/login/oauth/access_token",
        user_info_url="https://api.github.com/user",
        scope="user:email",
    )