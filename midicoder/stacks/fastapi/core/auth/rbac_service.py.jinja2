"""
RBAC Service - Role-Based Access Control Service cho FastAPI.

Module này cung cấp RBAC service cho authorization checks.
Hỗ trợ permission checks, role checks, và policy evaluation.

CP03 + CP04: Authentication & Authorization + RBAC & Policy Engine
KPI-029: Tenant Isolation - tenant-scoped permission checks và policies
"""

from typing import Any, Optional

from app.core.security.jwt_auth import TokenData
from app.core.security.permissions import (
    check_tenant_permission,
    get_tenant_scoped_permission,
    Permissions,
)
from midicoder.contracts.rbac_models import (
    Policy,
    PolicyEffect,
    PolicyEvaluationResult,
    Role,
)


# ============================================================================
# RBAC Service
# ============================================================================


class RBACService:
    """
    RBAC Service - Service cho authorization checks.

    Service này cung cấp methods cho:
    - Permission checks
    - Role checks
    - Policy evaluation

    KPI-029: Support tenant-scoped permissions và tenant-specific policies.
    """

    def __init__(self, roles: dict[str, Role]):
        """
        Initialize RBACService.

        Args:
            roles: Mapping từ role name -> Role object
        """
        self._roles = roles

    async def check_permission(
        self, user: TokenData, permission: str, tenant_id: Optional[str] = None
    ) -> bool:
        """
        Check nếu user có permission.

        KPI-029: Support tenant-scoped permissions và super admin bypass.

        Kiểm tra qua user roles và role permissions (bao gồm inheritance).

        Args:
            user: Current user
            permission: Permission ID để check
            tenant_id: KPI-029: Tenant ID cho tenant-scoped permission check

        Returns:
            True nếu user có permission, False nếu không
        """
        # KPI-029: Check nếu user có super admin permission - bypass tenant check
        all_user_permissions = await self.get_user_permissions(user)
        if Permissions.MULTITENANT_ADMIN in all_user_permissions:
            return True

        # Get all roles user has
        user_roles = user.roles

        # Check each role for permission
        for role_name in user_roles:
            if role_name in self._roles:
                role = self._roles[role_name]

                # Get all permissions (including inherited)
                all_permissions = role.get_all_permissions(self._roles)

                # KPI-029: Check tenant-scoped permission
                if tenant_id:
                    tenant_scoped_permission = get_tenant_scoped_permission(permission, tenant_id)
                    if tenant_scoped_permission in all_permissions:
                        return True

                # Check global permission
                if permission in all_permissions:
                    return True

        # KPI-029: Check if user belongs to the tenant
        if tenant_id and user.tenant_id:
            if user.tenant_id == tenant_id:
                # User is in the same tenant, check global permission
                for role_name in user_roles:
                    if role_name in self._roles:
                        all_permissions = self._roles[role_name].get_all_permissions(self._roles)
                        if permission in all_permissions:
                            return True

        return False

    async def check_role(self, user: TokenData, role_name: str) -> bool:
        """
        Check nếu user có role.

        Args:
            user: Current user
            role_name: Role name để check

        Returns:
            True nếu user có role, False nếu không
        """
        return role_name in user.roles

    async def check_policy(
        self, policy_id: str, context: dict[str, Any], tenant_id: Optional[str] = None
    ) -> bool:
        """
        Check nếu policy cho phép action.

        KPI-029: tenant_id được thêm vào context cho tenant-specific policies.

        Args:
            policy_id: Policy ID để check
            context: Context cho policy evaluation
            tenant_id: KPI-029: Tenant ID cho tenant-specific policy

        Returns:
            True nếu policy cho phép, False nếu không
        """
        # KPI-029: Add tenant_id to context if not present
        if tenant_id and "tenant_id" not in context:
            context["tenant_id"] = tenant_id

        # TODO: Load policy từ database/cache
        # For now, return True (allow all)
        # In production, implement policy loading
        return True

    async def get_user_permissions(self, user: TokenData, tenant_id: Optional[str] = None) -> set[str]:
        """
        Lấy tất cả permissions của user.

        KPI-029: Nếu có tenant_id, bao gồm cả tenant-scoped permissions.

        Args:
            user: Current user
            tenant_id: KPI-029: Tenant ID để get tenant-scoped permissions

        Returns:
            Set của tất cả permission IDs
        """
        all_permissions: set[str] = set()

        for role_name in user.roles:
            if role_name in self._roles:
                role = self._roles[role_name]

                # Get all permissions (including inherited)
                role_permissions = role.get_all_permissions(self._roles)
                all_permissions.update(role_permissions)

                # KPI-029: Add tenant-scoped permissions if tenant_id provided
                if tenant_id:
                    for perm in list(role_permissions):
                        tenant_scoped = get_tenant_scoped_permission(perm, tenant_id)
                        all_permissions.add(tenant_scoped)

        return all_permissions

    async def get_user_roles(self, user: TokenData) -> list[str]:
        """
        Lấy tất cả roles của user.

        Args:
            user: Current user

        Returns:
            List của role names
        """
        return user.roles.copy()


# ============================================================================
# Global RBAC Service Instance
# ============================================================================


# Global service instance
_rbac_service: Optional[RBACService] = None


def init_rbac_service(roles: dict[str, Role]) -> None:
    """
    Initialize global RBAC service.

    Called during application startup.

    Args:
        roles: Mapping từ role name -> Role object
    """
    global _rbac_service
    _rbac_service = RBACService(roles)


async def get_rbac_service() -> RBACService:
    """
    Dependency để get RBAC service.

    Returns:
        RBACService instance

    Raises:
        RuntimeError: Nếu RBAC service chưa được initialize
    """
    if _rbac_service is None:
        raise RuntimeError("RBACService chưa được initialize")

    return _rbac_service


# ============================================================================
# Policy Service
# ============================================================================


class PolicyService:
    """
    Policy Service - Service cho policy evaluation.

    Service này cung cấp methods cho:
    - Policy loading
    - Policy evaluation
    - Policy caching
    """

    def __init__(self):
        """Initialize PolicyService."""
        self._policies: dict[str, Policy] = {}
        self._policy_cache: dict[str, bool] = {}

    def add_policy(self, policy: Policy) -> None:
        """
        Thêm policy vào service.

        Args:
            policy: Policy để thêm
        """
        self._policies[policy.id] = policy

    def remove_policy(self, policy_id: str) -> None:
        """
        Xóa policy từ service.

        Args:
            policy_id: Policy ID để xóa
        """
        if policy_id in self._policies:
            del self._policies[policy_id]

    def evaluate_policy(
        self, policy_id: str, context: dict[str, Any]
    ) -> Optional[PolicyEvaluationResult]:
        """
        Evaluate policy với context.

        Args:
            policy_id: Policy ID để evaluate
            context: Context cho evaluation

        Returns:
            PolicyEvaluationResult hoặc None nếu policy không tồn tại
        """
        policy = self._policies.get(policy_id)

        if policy is None:
            return None

        return policy.evaluate(context)

    async def check_allowed(
        self, policy_id: str, context: dict[str, Any]
    ) -> bool:
        """
        Check nếu action được allow.

        Kiểm tra policy và trả về True nếu action được allow.

        Args:
            policy_id: Policy ID để check
            context: Context cho evaluation

        Returns:
            True nếu action được allow, False nếu không
        """
        result = self.evaluate_policy(policy_id, context)

        if result is None:
            # Policy không tồn tại - default deny
            return False

        return result.allowed


# ============================================================================
# Global Policy Service Instance
# ============================================================================


_policy_service: Optional[PolicyService] = None


def init_policy_service(policies: list[Policy]) -> None:
    """
    Initialize global policy service.

    Called during application startup.

    Args:
        policies: Danh sách policies
    """
    global _policy_service
    _policy_service = PolicyService()

    for policy in policies:
        _policy_service.add_policy(policy)


async def get_policy_service() -> PolicyService:
    """
    Dependency để get policy service.

    Returns:
        PolicyService instance

    Raises:
        RuntimeError: Nếu policy service chưa được initialize
    """
    if _policy_service is None:
        raise RuntimeError("PolicyService chưa được initialize")

    return _policy_service


