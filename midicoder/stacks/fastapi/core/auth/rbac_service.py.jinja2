# KPI-029: Tenant-Specific RBAC
# ============================================================================


class TenantRBACService:
    """
    KPI-029: Service cho tenant-specific RBAC operations.

    Multi-tenant RBAC với:
    - Tenant-scoped roles
    - Tenant-specific permissions
    - Cross-tenant admin access
    """

    def __init__(self, rbac_service: RBACService):
        """
        Initialize TenantRBACService.

        Args:
            rbac_service: Base RBAC service
        """
        self._rbac = rbac_service

    async def check_tenant_admin(
        self, user: TokenData, tenant_id: str
    ) -> bool:
        """
        KPI-029: Check nếu user là tenant admin của tenant_id.

        Args:
            user: Current user
            tenant_id: Tenant ID để check

        Returns:
            True nếu user là tenant admin
        """
        # Check nếu user là super admin
        all_perms = await self._rbac.get_user_permissions(user)
        if Permissions.MULTITENANT_ADMIN in all_perms:
            return True

        # Check nếu user có tenant_admin role và belongs to tenant
        if "tenant_admin" in user.roles:
            if user.tenant_id == tenant_id:
                return True

        return False

    async def get_tenant_users(self, tenant_id: str) -> list[str]:
        """
        KPI-029: Lấy list user IDs thuộc tenant.

        Args:
            tenant_id: Tenant ID

        Returns:
            List user IDs
        """
        # TODO: Query users from database
        return []

    async def get_tenant_roles(self, tenant_id: str) -> list[str]:
        """
        KPI-029: Lấy list role names của tenant.

        Args:
            tenant_id: Tenant ID

        Returns:
            List role names
        """
