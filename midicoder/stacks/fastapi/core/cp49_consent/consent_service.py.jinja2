    # Chính sách — Lấy theo ID
    # --------------------------------------------------------------

    async def get_policy(self, policy_id: str) -> Optional[Any]:
        """
        Lay chinh sach dong y theo ID.

        Tham so:
            policy_id: ID chinh sach.

        Tra ve:
            Doi tuong ConsentPolicyModel hoac None neu khong tim thay.
        """
        query = select(self._policy_model()).where(
            self._policy_model().policy_id == policy_id
        )
        result = await self._session.execute(query)
        return result.scalar_one_or_none()

