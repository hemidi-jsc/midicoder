# ----------------------------------------------------------
# CP49 Consent & Preference Management — Dịch vụ quản lý đồng ý
# ----------------------------------------------------------
# Sinh bởi CP49ConsentEmitter
# Class: ConsentService với CRUD đồng ý, chính sách, yêu cầu xóa
# ----------------------------------------------------------

import logging
import uuid
from datetime import datetime, timedelta, timezone
from typing import Any, Dict, List, Optional, Sequence

from sqlalchemy import and_, func, select
from sqlalchemy.ext.asyncio import AsyncSession


logger = logging.getLogger(__name__)


class ConsentService:
    """
    Dịch vụ quản lý đồng ý và tùy chọn — thực hiện cấp/hủy đồng ý,
    kiểm tra chính sách, yêu cầu xóa dữ liệu, và thống kê đồng ý.

    Cách layer: (1) RBAC check trước khi thao tác,
    (2) Audit log sau khi thay đổi trạng thái,
    (3) Retention trigger khi phê duyệt yêu cầu xóa.
    """

    def __init__(
        self,
        session: AsyncSession,
{% if use_audit %}
        _audit_logger=None,
{% endif %}
{% if use_retention %}
        _retention_manager=None,
{% endif %}
    ) -> None:
        """
        Khoi tao dich vu voi phien lam viec SQLAlchemy async va cac thanh phan tuy chon.

        Tham so:
            session: Phien lam viec async de truy cap co so du lieu.
{% if use_audit %}
            _audit_logger: Audit logger de ghi nhat ky kiem toan (tuy chon).
{% endif %}
{% if use_retention %}
            _retention_manager: Retention manager de xu ly chinh sach luu tru (tuy chon).
{% endif %}
        """
        self._session = session
{% if use_audit %}
        self._audit_logger = _audit_logger
{% else %}
        self._audit_logger = None
{% endif %}
{% if use_retention %}
        self._retention_manager = _retention_manager
{% else %}
        self._retention_manager = None
{% endif %}

    # --------------------------------------------------------------
    # Đồng ý — Cấp (Grant)
    # --------------------------------------------------------------

    async def grant_consent(
        self,
        user_id: str,
        tenant_id: str,
        purpose: str,
        category: str,
        ip_address: Optional[str] = None,
        user_agent: Optional[str] = None,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> Any:
        """
        Cap dong y cho nguoi dung.

        Tao ban ghi dong y moi voi trang thai 'granted', kem theo
        thong tin ngu cảnh (IP, user agent) va metadata.

        Tham so:
            user_id: ID nguoi dung cap dong y.
            tenant_id: ID tenant chua ban ghi.
            purpose: Muc dich dong y (essential, analytics, marketing, ...).
            category: Danh muc dong y (cookie, data_processing, ...).
            ip_address: Dia chi IP cua nguoi dung.
            user_agent: User agent cua trinh duyet.
            metadata: Du lieu bo sung (JSON).

        Tra ve:
            Doi tuong ConsentRecordModel moi duoc tao.
        """
        record_id = str(uuid.uuid4())
        now = datetime.now(timezone.utc)

        # Kiem tra RBAC — nguoi dung phai co quyen cap dong y
        await self._check_rbac(user_id, tenant_id)

        record = self._consent_model()(
            record_id=record_id,
            user_id=user_id,
            tenant_id=tenant_id,
            purpose=purpose,
            category=category,
            status="granted",
            granted_at=now,
            revoked_at=None,
            ip_address=ip_address,
            user_agent=user_agent,
            metadata_json=metadata,
            created_at=now,
            updated_at=now,
        )

        self._session.add(record)
        await self._session.commit()
        await self._session.refresh(record)

        # Phat audit event neu co audit logger
{% if use_audit %}
        await self._audit_log(
            action="consent.granted",
            user_id=user_id,
            tenant_id=tenant_id,
            resource_id=record_id,
            details={
                "purpose": purpose,
                "category": category,
                "ip_address": ip_address,
            },
        )
{% endif %}

        logger.info(
            "Da cap dong y: record_id=%s, user=%s, tenant=%s, purpose=%s, category=%s",
            record_id,
            user_id,
            tenant_id,
            purpose,
            category,
        )

        return record

    # --------------------------------------------------------------
    # Đồng ý — Hủy (Revoke)
    # --------------------------------------------------------------

    async def revoke_consent(
        self,
        record_id: str,
        user_id: str,
        tenant_id: str,
    ) -> Any:
        """
        Huy dong y cua nguoi dung.

        Thuc hien soft revoke: cap nhat trang thai thanh 'revoked'
        va ghi nhan thoi diem huy. Kiem tra chinh sach bat buoc
        truoc khi huy.

        Tham so:
            record_id: ID ban ghi dong y can huy.
            user_id: ID nguoi dung thuc hien huy.
            tenant_id: ID tenant.

        Tra ve:
            Doi tuong ConsentRecordModel da duoc cap nhat.

        Nem ra:
            ValueError: Neu ban ghi khong ton tai.
            ValueError: Neu muc dich dong y la bat buoc (khong the huy).
        """
        # Tim ban ghi dong y
        record = await self._get_consent_record(record_id)
        if record is None:
            raise ValueError("Khong tim thay ban ghi dong y voi ID: {}".format(record_id))

        # Kiem tra chinh sach bat buoc
        policy = await self._get_policy_by_purpose_and_category(
            tenant_id, record.purpose, record.category
        )
        if policy and policy.is_mandatory:
            raise ValueError(
                "Khong the huy dong y bat buoc: purpose={}, category={}".format(
                    record.purpose, record.category
                )
            )

        now = datetime.now(timezone.utc)
        record.status = "revoked"
        record.revoked_at = now
        record.updated_at = now

        await self._session.commit()
        await self._session.refresh(record)

        # Phat audit event
{% if use_audit %}
        await self._audit_log(
            action="consent.revoked",
            user_id=user_id,
            tenant_id=tenant_id,
            resource_id=record_id,
            details={
                "purpose": record.purpose,
                "category": record.category,
                "revoked_at": now.isoformat(),
            },
        )
{% endif %}

        logger.info(
            "Da huy dong y: record_id=%s, user=%s, tenant=%s",
            record_id,
            user_id,
            tenant_id,
        )

        return record

    # --------------------------------------------------------------
    # Đồng ý — Kiểm tra (Check)
    # --------------------------------------------------------------

    async def check_consent(
        self,
        user_id: str,
        tenant_id: str,
        purpose: str,
    ) -> bool:
        """
        Kiem tra neu nguoi dung co dong y dang hoat dong cho muc dich.

        Tim ban ghi dong y moi nhat cho user_id, tenant_id, va purpose,
        tra ve True neu trang thai la 'granted'.

        Tham so:
            user_id: ID nguoi dung.
            tenant_id: ID tenant.
            purpose: Muc dich dong y can kiem tra.

        Tra ve:
            True neu co dong y dang hoat dong, False neu khong.
        """
        record = await self._get_latest_consent(user_id, tenant_id, purpose)
        if record is None:
            return False
        return record.status == "granted"

    # --------------------------------------------------------------
    # Đồng ý — Danh sách người dùng
    # --------------------------------------------------------------

    async def get_user_consents(
        self,
        user_id: str,
        tenant_id: str,
    ) -> Sequence[Any]:
        """
        Lay tat ca ban ghi dong y cua nguoi dung.

        Tham so:
            user_id: ID nguoi dung.
            tenant_id: ID tenant.

        Tra ve:
            Danh sach ConsentRecordModel cua nguoi dung.
        """
        query = select(self._consent_model()).where(
            and_(
                self._consent_model().user_id == user_id,
                self._consent_model().tenant_id == tenant_id,
            )
        ).order_by(self._consent_model().created_at.desc())

        result = await self._session.execute(query)
        return list(result.scalars().all())

