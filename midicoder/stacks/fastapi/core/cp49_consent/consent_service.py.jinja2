    # Chính sách — Danh sách tenant
    # --------------------------------------------------------------

    async def list_policies(
        self,
        tenant_id: str,
    ) -> Sequence[Any]:
        """
        Lay tat ca chinh sach dong y cho mot tenant.

        Tham so:
            tenant_id: ID tenant.

