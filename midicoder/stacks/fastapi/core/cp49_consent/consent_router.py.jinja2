# --------------------------------------------------------------
# Route: tạo chính sách mới (admin)
# --------------------------------------------------------------

@router.post(
    "/policies",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tạo chính sách đồng ý",
    description="Tao chinh sach dong y moi cho tenant (admin).",
)
async def create_policy(
    payload: Dict[str, Any],
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Tạo chính sách đồng ý mới cho tenant.

    Payload cần bao gồm:
    - tenant_id: ID tenant
    - purpose: Mục đích chính sách
    - category: Danh mục chính sách
    - is_mandatory: Có bắt buộc không (tùy chọn)
    - description: Mô tả (tùy chọn)
    - expiry_days: Số ngày hết hạn (tùy chọn, mặc định 365)
    - renewal_reminder_days: Số ngày nhắc làm mới (tùy chọn, mặc định 30)
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )
    if not payload.get("purpose"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="purpose la bat buoc",
        )
    if not payload.get("category"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="category la bat buoc",
        )

    policy = await service.create_policy(
        tenant_id=payload["tenant_id"],
        purpose=payload["purpose"],
        category=payload["category"],
        is_mandatory=payload.get("is_mandatory", False),
        description=payload.get("description"),
        expiry_days=payload.get("expiry_days", 365),
        renewal_reminder_days=payload.get("renewal_reminder_days", 30),
    )

    return policy.__dict__


