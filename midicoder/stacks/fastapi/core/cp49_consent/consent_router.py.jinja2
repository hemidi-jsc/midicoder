# ----------------------------------------------------------
# CP49 Consent & Preference Management — Router FastAPI cho quản lý đồng ý
# ----------------------------------------------------------
# Sinh bởi CP49ConsentEmitter
# Routes: CRUD đồng ý, chính sách, cookie preference, communication preference,
#         erasure request, thống kê
# ----------------------------------------------------------

import logging
from typing import Any, Dict, List, Optional

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession


logger = logging.getLogger(__name__)

# Định danh router
router = APIRouter(prefix="/consent", tags=["consent"])


# --------------------------------------------------------------
# Phụ thuộc — injection
# --------------------------------------------------------------

def get_consent_service(session: AsyncSession = Depends(lambda: None)) -> "ConsentService":
    """
    Cung cấp dịch vụ đồng ý cho các route.
    Đây là điểm phụ thuộc injection cho ConsentService.
    """
    from consent_service import ConsentService
    return ConsentService(session)


def get_cookie_banner_service(session: AsyncSession = Depends(lambda: None)) -> "CookieBannerService":
    """
    Cung cấp dịch vụ cookie banner cho các route.
    """
    from cookie_banner_service import CookieBannerService
    return CookieBannerService(session)


def get_erasure_service(session: AsyncSession = Depends(lambda: None)) -> "ErasureService":
    """
    Cung cấp dịch vụ xóa dữ liệu cho các route.
    """
    from erasure_service import ErasureService
    return ErasureService(session)


# --------------------------------------------------------------
# Route: cấp đồng ý
# --------------------------------------------------------------

@router.post(
    "/grant",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Cấp đồng ý",
    description="Tao ban ghi dong y moi cho nguoi dung.",
)
async def grant_consent(
    payload: Dict[str, Any],
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Cấp đồng ý cho người dùng.

    Payload cần bao gồm:
    - user_id: ID người dùng
    - tenant_id: ID tenant
    - purpose: Mục đích đồng ý
    - category: Danh mục đồng ý
    - ip_address: Địa chỉ IP (tùy chọn)
    - user_agent: User agent (tùy chọn)
    - metadata: Dữ liệu bổ sung (tùy chọn)
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("user_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="user_id la bat buoc",
        )
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )
    if not payload.get("purpose"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="purpose la bat buoc",
        )
    if not payload.get("category"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="category la bat buoc",
        )

    try:
        record = await service.grant_consent(
            user_id=payload["user_id"],
            tenant_id=payload["tenant_id"],
            purpose=payload["purpose"],
            category=payload["category"],
            ip_address=payload.get("ip_address"),
            user_agent=payload.get("user_agent"),
            metadata=payload.get("metadata"),
        )
    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(e),
        )

    return record.__dict__


# --------------------------------------------------------------
# Route: hủy đồng ý
# --------------------------------------------------------------

@router.post(
    "/{record_id}/revoke",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Hủy đồng ý",
    description="Huy dong y cua nguoi dung cho mot ban ghi cu the.",
)
async def revoke_consent(
    record_id: str,
    payload: Dict[str, Any],
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Hủy đồng ý của người dùng.

    Payload cần bao gồm:
    - user_id: ID người dùng thực hiện hủy
    - tenant_id: ID tenant
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("user_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="user_id la bat buoc",
        )
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )

    try:
        record = await service.revoke_consent(
            record_id=record_id,
            user_id=payload["user_id"],
            tenant_id=payload["tenant_id"],
        )
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        elif "bat buoc" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )

    return record.__dict__


# --------------------------------------------------------------
# Route: danh sách đồng ý của người dùng
# --------------------------------------------------------------

@router.get(
    "/user/{user_id}",
    response_model=List[Dict[str, Any]],
    status_code=status.HTTP_200_OK,
    summary="Lấy danh sách đồng ý của người dùng",
    description="Lay tat ca ban ghi dong y cua mot nguoi dung.",
)
async def get_user_consents(
    user_id: str,
    tenant_id: str = Query(..., description="ID tenant"),
    service: "ConsentService" = Depends(get_consent_service),
) -> List[Dict[str, Any]]:
    """
    Lấy tất cả bản ghi đồng ý của người dùng theo tenant.
    """
    items = await service.get_user_consents(user_id=user_id, tenant_id=tenant_id)
    return [item.__dict__ for item in items]


# --------------------------------------------------------------
# Route: kiểm tra đồng ý
# --------------------------------------------------------------

@router.get(
    "/check",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Kiểm tra đồng ý",
    description="Kiem tra neu nguoi dung co dong y dang hoat dong cho muc dich.",
)
async def check_consent(
    user_id: str = Query(..., description="ID người dùng"),
    tenant_id: str = Query(..., description="ID tenant"),
    purpose: str = Query(..., description="Mục đích đồng ý cần kiểm tra"),
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Kiểm tra nếu người dùng có đồng ý đang hoạt động cho mục đích.

    Trả về True nếu có đồng ý 'granted', False nếu không.
    """
    has_consent = await service.check_consent(
        user_id=user_id,
        tenant_id=tenant_id,
        purpose=purpose,
    )

    return {
        "user_id": user_id,
        "tenant_id": tenant_id,
        "purpose": purpose,
        "has_consent": has_consent,
    }


