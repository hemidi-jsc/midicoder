@router.put(
    "/communication-preferences",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Cập nhật tùy chọn liên lạc",
    description="Cap nhat tuy chon lien lac cua nguoi dung.",
)
async def update_communication_preference(
    payload: Dict[str, Any],
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Cập nhật tùy chọn liên lạc của người dùng.

    Payload cần bao gồm:
    - user_id: ID người dùng
    - tenant_id: ID tenant
    - channels: Kênh liên lạc (JSON: {"email": true, "sms": false, ...})
    - purposes: Mục đích liên lạc (JSON: {"newsletters": true, ...})
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("user_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="user_id la bat buoc",
        )
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )
    if not payload.get("channels"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="channels la bat buoc",
        )
    if not payload.get("purposes"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="purposes la bat buoc",
        )

    # Lưu vào cookie_banner_service
    from cookie_banner_service import CookieBannerService
    banner_service = CookieBannerService(service._session)

    preference = await banner_service.set_communication_preference(
        user_id=payload["user_id"],
        tenant_id=payload["tenant_id"],
        channels=payload["channels"],
        purposes=payload["purposes"],
    )

    return preference.__dict__


