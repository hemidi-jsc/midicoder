@router.put(
    "/cookie-preferences",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Cập nhật tùy chọn cookie",
    description="Cap nhat tuy chon cookie cua nguoi dung.",
)
async def update_cookie_preference(
    payload: Dict[str, Any],
    service: "CookieBannerService" = Depends(get_cookie_banner_service),
) -> Dict[str, Any]:
    """
    Cập nhật tùy chọn cookie của người dùng.

    Payload cần bao gồm:
    - user_id: ID người dùng
    - tenant_id: ID tenant
    - categories: Danh mục cookie (JSON object với giá trị boolean)
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("user_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="user_id la bat buoc",
        )
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )
    if not payload.get("categories"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="categories la bat buoc",
        )

    preference = await service.set_cookie_preference(
        user_id=payload["user_id"],
        tenant_id=payload["tenant_id"],
        categories=payload["categories"],
    )

    return preference.__dict__


# --------------------------------------------------------------
# Route: lấy cookie preference
# --------------------------------------------------------------

@router.get(
    "/cookie-preferences",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Lấy tùy chọn cookie",
    description="Lay tuy chon cookie cua nguoi dung.",
)
async def get_cookie_preference(
    user_id: str = Query(..., description="ID người dùng"),
    tenant_id: str = Query(..., description="ID tenant"),
    service: "CookieBannerService" = Depends(get_cookie_banner_service),
) -> Dict[str, Any]:
    """
    Lấy tùy chọn cookie của người dùng.
    """
    preference = await service.get_cookie_preference(
        user_id=user_id,
        tenant_id=tenant_id,
    )

    if preference is None:
        return {
            "user_id": user_id,
            "tenant_id": tenant_id,
            "categories": {},
            "message": "Chua co tuy chon cookie",
        }

    return preference.__dict__


