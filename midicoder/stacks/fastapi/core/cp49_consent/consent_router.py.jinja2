# --------------------------------------------------------------
# Route: tạo yêu cầu xóa
# --------------------------------------------------------------

@router.post(
    "/erasure-requests",
    response_model=Dict[str, Any],
    status_code=status.HTTP_201_CREATED,
    summary="Tạo yêu cầu xóa dữ liệu",
    description="Tao yeu cau xoa du lieu cua nguoi dung (Right to be Forgotten).",
)
async def create_erasure_request(
    payload: Dict[str, Any],
    service: "ErasureService" = Depends(get_erasure_service),
) -> Dict[str, Any]:
    """
    Tạo yêu cầu xóa dữ liệu mới.

    Payload cần bao gồm:
    - user_id: ID người dùng
    - tenant_id: ID tenant
    - scope: Phạm vi xóa (all, personal_data, ...)
    - reason: Lý do (tùy chọn)
    """
    # Kiểm tra dữ liệu bắt buộc
    if not payload.get("user_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="user_id la bat buoc",
        )
    if not payload.get("tenant_id"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="tenant_id la bat buoc",
        )
    if not payload.get("scope"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="scope la bat buoc",
        )

    erasure = await service.create_erasure_request(
        user_id=payload["user_id"],
        tenant_id=payload["tenant_id"],
        scope=payload["scope"],
        reason=payload.get("reason"),
    )

    return erasure.__dict__


# --------------------------------------------------------------
# Route: lấy yêu cầu xóa
# --------------------------------------------------------------

@router.get(
    "/erasure-requests/{request_id}",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Lấy yêu cầu xóa",
    description="Lay chi tiet yeu cau xoa du lieu theo ID.",
)
async def get_erasure_request(
    request_id: str,
    service: "ErasureService" = Depends(get_erasure_service),
) -> Dict[str, Any]:
    """
    Lấy chi tiết yêu cầu xóa theo request_id.
    """
    erasure = await service.get_erasure_request(request_id)

    if erasure is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Khong tim thay yeu cau xoa voi ID: {}".format(request_id),
        )

    return erasure.__dict__


# --------------------------------------------------------------
# Route: xử lý yêu cầu xóa (admin)
# --------------------------------------------------------------

@router.post(
    "/erasure-requests/{request_id}/process",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Xử lý yêu cầu xóa",
    description="Phê duyêt hoac tu choi yeu cau xoa du lieu (admin).",
)
async def process_erasure_request(
    request_id: str,
    payload: Dict[str, Any],
    service: "ErasureService" = Depends(get_erasure_service),
) -> Dict[str, Any]:
    """
    Xử lý yêu cầu xóa: phê duyệt hoặc từ chối.

    Payload cần bao gồm:
    - action: "approve" hoặc "reject"
    - reason: Lý do (tùy chọn, bắt buộc nếu reject)
    """
    if not payload.get("action"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="action la bat buoc",
        )
    if payload["action"] not in ("approve", "reject"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="action phai la 'approve' hoac 'reject'",
        )

    try:
        erasure = await service.process_erasure(
            request_id=request_id,
            action=payload["action"],
            reason=payload.get("reason"),
        )
    except ValueError as e:
        error_msg = str(e)
        if "Khong tim thay" in error_msg:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=error_msg,
            )
        else:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=error_msg,
            )

    return erasure.__dict__


# --------------------------------------------------------------
# Route: thống kê đồng ý của tenant (admin)
# --------------------------------------------------------------

@router.get(
    "/stats",
    response_model=Dict[str, Any],
    status_code=status.HTTP_200_OK,
    summary="Thống kê đồng ý của tenant",
    description="Lay thong ke tong quan ve dong y cua tenant (admin).",
)
async def get_consent_stats(
    tenant_id: str = Query(..., description="ID tenant"),
    service: "ConsentService" = Depends(get_consent_service),
) -> Dict[str, Any]:
    """
    Lấy thống kê tổng quan về đồng ý của tenant.

    Trả về: total, active, revoked, expired, pending_renewal
    """
    stats = await service.get_tenant_consent_stats(tenant_id=tenant_id)

    return {
        "tenant_id": tenant_id,
        **stats,
    }
