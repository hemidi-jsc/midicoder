    field_types = {
        "str": str,
        "int": int,
        "float": float,
        "bool": bool,
        "string": str,
        "integer": int,
        "number": float,
        "boolean": bool,
        "email": str,
        "date": str,
        "datetime": str,
        "text": str,
        "password": str,
    }

    for field_def in fields:
        name = field_def["name"]
        type_str = field_def.get("type", "str")
        required = field_def.get("required", False)
        description = field_def.get("description", name)

        py_type = field_types.get(type_str, str)

        if required:
            field_defs[name] = (py_type, Field(description=description))
        else:
            field_defs[name] = (Optional[py_type], Field(default=None, description=description))

    schema = type(f"{entity_id}Schema", (BaseModel,), {
        "__annotations__": {k: v[0] for k, v in field_defs.items()},
        **{f"model_fields__{k}": v[1] for k, v in field_defs.items()},
    })

    return schema


