# coding: utf-8
"""
Compile-time Hooks — Định nghĩa các hook trigger tại lifecycle events.

Hook events:
- on_before_emit:    Trước khi emit file
- on_after_emit:     Sau khi emit file
- on_template_render: Sau khi render template
- on_file_write:     Trước khi write file ra disk

Author: Midicoder Team
Version: 1.0.0
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from typing import Any, Callable

logger = logging.getLogger(__name__)


@dataclass
class Hook:
    """Một compile-time hook."""
    id: str
    event: str
    action: str
    condition: str | None = None
    handler: Callable | None = None


# Registry các hooks đã đăng ký
HOOK_REGISTRY: dict[str, list[Hook]] = {
    "on_before_emit": [],
    "on_after_emit": [],
    "on_template_render": [],
    "on_file_write": [],
}


def register_hook(hook: Hook) -> None:
    """Đăng ký hook vào registry."""
    if hook.event not in HOOK_REGISTRY:
        logger.warning("Hook event '%s' không được hỗ trợ", hook.event)
        return
    HOOK_REGISTRY[hook.event].append(hook)
    logger.debug("Đã đăng ký hook: %s (event=%s)", hook.id, hook.event)


def trigger_hooks(event: str, context: dict[str, Any] | None = None) -> None:
    """
    Trigger tất cả hooks cho một event.

    Args:
        event: Tên event để trigger
        context: Context data cho hooks
    """
    hooks = HOOK_REGISTRY.get(event, [])
    for hook in hooks:
        try:
            if hook.condition and context:
                # Evaluate condition
                if not _evaluate_condition(hook.condition, context):
                    continue
            if hook.handler:
                hook.handler(context or {})
        except Exception as e:
            logger.error("Hook '%s' failed: %s", hook.id, e)


def _evaluate_condition(condition: str, context: dict[str, Any]) -> bool:
    """
    Evaluate condition expression trong context.

    Args:
        condition: Expression string (ví dụ: "file_type == 'command_handler'")
        context: Context variables

    Returns:
        Kết quả boolean
    """
    try:
        return eval(condition, {"__builtins__": {}}, context)  # noqa: S307
    except Exception:
        return True  # Default: execute if condition can't be evaluated
