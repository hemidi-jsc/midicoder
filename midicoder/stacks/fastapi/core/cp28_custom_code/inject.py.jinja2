# coding: utf-8
"""
Custom Code Injector.

Inject custom code blocks vào generated files tại compile-time.
Code được validate syntax và wrap trong try-except để tránh crash.

Author: Midicoder Team
Version: 1.0.0
"""

from __future__ import annotations

import ast
import logging
from typing import Any

logger = logging.getLogger(__name__)


class CustomCodeInjector:
    """
    Engine inject custom code blocks vào generated files.

    Hỗ trợ 3 vị trí:
    - before: inject code trước nội dung gốc
    - after:  inject code sau nội dung gốc
    - replace: thay thế toàn bộ nội dung gốc

    Tất cả injected code được validate Python AST và wrap trong
    try-except để đảm bảo không crash runtime.
    """

    def inject(self, content: str, block_code: str, position: str = "after") -> str:
        """
        Inject code block vào content tại vị trí được chỉ định.

        Args:
            content: Nội dung gốc
            block_code: Code block sẽ inject
            position: Vị trí inject (before, after, replace)

        Returns:
            Nội dung đã inject

        Raises:
            SyntaxError: Nếu block_code không pass Python AST validation
        """
        # Validate syntax
        try:
            ast.parse(block_code)
        except SyntaxError as e:
            logger.error("Syntax error trong custom code block: %s", e)
            raise

        if position == "replace":
            return self._wrap_sandbox(block_code)
        elif position == "before":
            return self._wrap_sandbox(block_code) + "\n\n" + content
        else:  # after
            return content + "\n\n" + self._wrap_sandbox(block_code)

    def _wrap_sandbox(self, code: str) -> str:
        """
        Wrap code trong try-except sandbox để tránh crash runtime.

        Args:
            code: Code cần wrap

        Returns:
            Code đã wrap trong try-except
        """
        indented = "\n".join("    " + line for line in code.split("\n"))
        return f"try:\n{indented}\nexcept Exception as _e:\n    logger.exception('Custom code injection error: %s', _e)\n"


# Singleton instance
injector = CustomCodeInjector()
