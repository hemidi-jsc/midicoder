# coding: utf-8
"""
Custom Code Blocks — Danh sách các code blocks đã đăng ký.

Mỗi block định nghĩa:
- id: Định danh duy nhất
- target: Path pattern của file target
- code:  Nội dung code
- position: Vị trí inject (before/after/replace)

Author: Midicoder Team
Version: 1.0.0
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any


@dataclass
class CodeBlock:
    """Một custom code block đã đăng ký."""
    id: str
    target: str
    code: str
    position: str = "after"
    metadata: dict[str, Any] | None = None


# Danh sách code blocks mặc định
CODE_BLOCKS: list[CodeBlock] = []

# Auto-register blocks từ configuration
# Nếu có custom_code_blocks trong DSL, chúng sẽ được inject tại compile-time
