"""
Dịch vụ xuất dữ liệu GDPR Article 20 — Right to Data Portability.

Tự động generate — không sửa tay.

Hỗ trợ:
- Export toàn bộ dữ liệu người dùng sang JSON/CSV
- Format chuẩn với metadata theo GDPR Article 20
- Background task cho export dữ liệu lớn
- Tenant isolation (khi multi-tenant bật)

CP47: Data Retention & Lifecycle Management
"""

from __future__ import annotations

import asyncio
import csv
import io
import json
import logging
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from sqlalchemy import select
from sqlalchemy.orm import Session

{% if entities %}
{%- for entity in entities %}
from app.models.{{ entity | replace("Model", "") | lower }}_models import {{ entity }}
{%- endfor %}
{% endif %}

{% if tenant_enabled %}
from app.tenant_context import get_current_tenant_id
{% endif %}

logger = logging.getLogger(__name__)


# ============================================================================
# Export metadata schema theo GDPR Article 20
# ============================================================================

EXPORT_METADATA_VERSION = "1.0"
EXPORT_DIR = Path("exports")
EXPORT_EXPIRY_HOURS = 48


class DataExportService:
    """
    Dịch vụ xuất dữ liệu theo GDPR Article 20 (Right to Data Portability).

    Cho phép người dùng xuất toàn bộ dữ liệu cá nhân dưới định dạng
    machine-readable (JSON/CSV) kèm metadata chuẩn.

    Tenant Isolation:
    {% if tenant_enabled %}
    - Tất cả queries tự động filter theo tenant_id hiện tại
    {% else %}
    - Không áp dụng multi-tenant (single-tenant mode)
    {% endif %}

    Usage:
        service = DataExportService(session)
        path = await service.export_user_data(user_id="u-123", format="json")
    """

    def __init__(self, db: Session):
        self.db = db

    # ------------------------------------------------------------------
    # User Data Export
    # ------------------------------------------------------------------

    async def export_user_data(
        self,
        user_id: str,
        export_format: str = "json",
        entity_types: list[str] | None = None,
    ) -> Path:
        """
        Xuất toàn bộ dữ liệu của người dùng.

        Args:
            user_id: ID người dùng cần xuất dữ liệu
            export_format: Định dạng xuất (json hoặc csv)
            entity_types: Danh sách entity cần xuất (None = tất cả)

        Returns:
            Path đến file export đã tạo

        Raises:
            ValueError: Nếu định dạng không hỗ trợ
        """
        if export_format not in ("json", "csv"):
            raise ValueError(f"Định dạng không hỗ trợ: {export_format}")

        # 1. Gather all data from entities
        data = await self._gather_user_data(user_id, entity_types)

        # 2. Generate metadata
        metadata = self.generate_export_metadata(user_id, list(data.keys()), export_format)

        # 3. Format output
        output = self._format_export(data, metadata, export_format)

        # 4. Save to export directory
        EXPORT_DIR.mkdir(parents=True, exist_ok=True)
        filename = f"export_{user_id}_{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}.{export_format}"
        file_path = EXPORT_DIR / filename

        if export_format == "json":
            file_path.write_text(output, encoding="utf-8")
        else:
            file_path.write_text(output, encoding="utf-8")

        logger.info("Export dữ liệu user hoàn tất: user_id=%s, file=%s", user_id, file_path)
        return file_path

    # ------------------------------------------------------------------
    # Tenant Data Export
    # ------------------------------------------------------------------

    async def export_tenant_data(
        self,
        tenant_id: str,
        export_format: str = "json",
    ) -> Path:
        """
        Xuất toàn bộ dữ liệu của tenant.

        Chỉ admin tenant mới được phép thực hiện export này.

        Args:
            tenant_id: ID tenant cần xuất dữ liệu
            export_format: Định dạng xuất (json hoặc csv)

        Returns:
            Path đến file export đã tạo
        """
        {% if tenant_enabled %}
        # Validate tenant ownership
        current_tenant = get_current_tenant_id()
        if current_tenant != tenant_id:
            from app.errors import ErrorCode, MidicoderErrorManager as EM
            raise EM.raise_error(
                ErrorCode.AUTH_FORBIDDEN,
                f"Không có quyền export dữ liệu tenant: {tenant_id}",
            )
        {% endif %}

        data = await self._gather_tenant_data(tenant_id)
        metadata = {
            "version": EXPORT_METADATA_VERSION,
            "export_type": "tenant",
            "tenant_id": tenant_id,
            "exported_at": datetime.now(timezone.utc).isoformat(),
            "expires_at": datetime.now(timezone.utc).isoformat(),
            "format": export_format,
            "entity_counts": {k: len(v) for k, v in data.items()},
        }

        output = self._format_export(data, metadata, export_format)

        EXPORT_DIR.mkdir(parents=True, exist_ok=True)
        filename = f"export_tenant_{tenant_id}_{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}.{export_format}"
        file_path = EXPORT_DIR / filename

        file_path.write_text(output, encoding="utf-8")
        logger.info("Export tenant data hoàn tất: tenant_id=%s, file=%s", tenant_id, file_path)
        return file_path

    # ------------------------------------------------------------------
    # Metadata generation
    # ------------------------------------------------------------------

    def generate_export_metadata(
        self,
        user_id: str,
        entity_types: list[str],
        export_format: str = "json",
    ) -> dict[str, Any]:
        """
        Generate export metadata theo chuẩn GDPR Article 20.

        Metadata bao gồm:
        - Version của export format
        - Timestamp export
        - Thời gian hết hạn của file export
        - Thống kê số lượng entity theo loại

        Args:
            user_id: ID người dùng
            entity_types: Danh sách entity types có trong export
            export_format: Định dạng export

        Returns:
            Dictionary chứa metadata export
        """
        now = datetime.now(timezone.utc)
        return {
            "version": EXPORT_METADATA_VERSION,
            "export_type": "user",
            "user_id": user_id,
            "exported_at": now.isoformat(),
            "expires_at": now.isoformat(),
            "format": export_format,
            "entity_types": entity_types,
            "entity_count": len(entity_types),
            "compliance": {
                "framework": "GDPR",
                "article": "Article 20 - Right to data portability",
                "purpose": "Data portability request",
            },
        }

    # ------------------------------------------------------------------
    # Internal helpers
    # ------------------------------------------------------------------

    async def _gather_user_data(
        self,
        user_id: str,
        entity_types: list[str] | None = None,
    ) -> dict[str, list[dict[str, Any]]]:
        """Gather dữ liệu người dùng từ tất cả các entity."""
        data: dict[str, list[dict[str, Any]]] = {}

        {% if entities %}
        {%- for entity in entities %}
        # {{ entity }} entities
        stmt = select({{ entity }}).where({{ entity }}.user_id == user_id)
        {% if tenant_enabled %}
        stmt = stmt.where({{ entity }}.tenant_id == get_current_tenant_id())
        {% endif %}
        result = self.db.execute(stmt)
        records = result.mappings().all()
        if records:
            data["{{ entity | lower }}s"] = [dict(r) for r in records]

        {%- endfor %}
        {% else %}
        # Placeholder: gather data từ các entity được định nghĩa
        # Thực tế sẽ được generate dựa trên danh sách entities trong context
        logger.warning("Không có entity được định nghĩa cho export")
        {% endif %}

        return data

    async def _gather_tenant_data(
        self,
        tenant_id: str,
    ) -> dict[str, list[dict[str, Any]]]:
        """Gather toàn bộ dữ liệu của tenant."""
        data: dict[str, list[dict[str, Any]]] = {}

        {% if entities %}
        {%- for entity in entities %}
        stmt = select({{ entity }}).where({{ entity }}.tenant_id == tenant_id)
        result = self.db.execute(stmt)
        records = result.mappings().all()
        if records:
            data["{{ entity | lower }}s"] = [dict(r) for r in records]
        {%- endfor %}
        {% endif %}

        return data

    def _format_export(
        self,
        data: dict[str, list[dict[str, Any]]],
        metadata: dict[str, Any],
        export_format: str,
    ) -> str:
        """Format dữ liệu export theo định dạng yêu cầu."""
        if export_format == "json":
            output = {
                "metadata": metadata,
                "data": data,
            }
            return json.dumps(output, ensure_ascii=False, indent=2, default=str)
        elif export_format == "csv":
            buffer = io.StringIO()
            writer = csv.writer(buffer)
            # Write metadata as header comments
            writer.writerow(["# GDPR Data Export"])
            writer.writerow(["# Exported:", metadata.get("exported_at", "")])
            writer.writerow(["# Format:", metadata.get("format", "")])
            writer.writerow([])

            # Write each entity group
            for entity_type, records in data.items():
                writer.writerow([f"## {entity_type}"])
                if records:
                    writer.writerow(list(records[0].keys()))
                    for record in records:
                        writer.writerow([record.get(k, "") for k in records[0].keys()])
                writer.writerow([])

            return buffer.getvalue()
        else:
            raise ValueError(f"Định dạng không hỗ trợ: {export_format}")
