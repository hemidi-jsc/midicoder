from __future__ import annotations

from fastapi import APIRouter, HTTPException, status

from app.models.mfa_models import (
    MFAChallengeRequest,
    MFAEnrollRequest,
    MFAVerifyRequest,
    MFAMethod,
)
from app.schemas.mfa_schemas import (
    MFAChallengeResponse,
    MFAEnrollResponse,
    MFAStatusResponse,
    MFAVerifyResponse,
)
from app.services.mfa_service import MFAService

router = APIRouter(prefix="/api/mfa", tags=["mfa"])
mfa_service = MFAService()


@router.post("/enroll", response_model=MFAEnrollResponse, status_code=status.HTTP_201_CREATED)
async def enroll_mfa(request: MFAEnrollRequest):
    """Đăng ký MFA mới cho user."""
    try:
        enrollment = await mfa_service.enroll(
            user_id=request.user_id,
            method=MFAMethod(request.method),
            phone_number=request.phone_number or "",
            device_name=request.device_name or "",
            issuer=request.issuer,
        )
        return MFAEnrollResponse(
            enrollmentId=enrollment.enrollment_id,
            qrCodeData=enrollment.qr_code_data,
            setupSecret=enrollment.setup_secret,
            method=enrollment.method.value,
            message="MFA enrollment created successfully",
        )
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))


@router.post("/enroll/verify", response_model=MFAEnrollResponse)
async def verify_enrollment(session_id: str, verification_code: str):
    """Xác minh đăng ký MFA."""
    try:
        credential = await mfa_service.verify_enrollment(session_id, verification_code)
        return MFAEnrollResponse(
            enrollmentId=credential.credential_id,
            qrCodeData=None,
            setupSecret=None,
            method=credential.method.value,
            message="MFA enrollment verified successfully",
        )
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))


@router.post("/challenge", response_model=MFAChallengeResponse)
async def create_challenge(request: MFAChallengeRequest):
    """Tạo challenge MFA."""
    try:
        challenge = await mfa_service.create_challenge(
            user_id=request.user_id,
            method=MFAMethod(request.method),
        )
        return MFAChallengeResponse(
            sessionId=challenge.session_id,
            challenge=challenge.challenge.value,
            method=request.method,
            expiresIn=300,
            remainingAttempts=challenge.max_attempts - challenge.attempts,
        )
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))


@router.post("/verify", response_model=MFAVerifyResponse)
async def verify_challenge(request: MFAVerifyRequest):
    """Xác minh challenge MFA."""
    try:
        mfa_session = await mfa_service.verify_challenge(
            session_id=request.session_id,
            otp_code=request.otp_code or "",
            signature=request.signature or "",
        )
        return MFAVerifyResponse(
            sessionId=mfa_session.session_id,
            isVerified=mfa_session.is_verified,
            verifiedAt=mfa_session.verified_at.isoformat() if mfa_session.verified_at else "",
            token=f"mfa_token_{mfa_session.session_id}",
        )
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=str(e))


@router.get("/status/{user_id}", response_model=MFAStatusResponse)
async def get_mfa_status(user_id: str):
    """Lấy trạng thái MFA của user."""
    status_info = await mfa_service.get_status(user_id)
    return MFAStatusResponse(
        userId=status_info["user_id"],
        isMfaEnabled=status_info["is_mfa_enabled"],
        methods=status_info["credentials"],
        defaultMethod="{{ default_method }}",
        requireMfa={{ "true" if require_mfa else "false" }},
    )


@router.post("/disable/{credential_id}")
async def disable_mfa(credential_id: str):
    """Vô hiệu hóa MFA credential."""
    try:
        credential = await mfa_service.disable(credential_id)
        return {"credential_id": credential.credential_id, "status": credential.status.value, "message": "MFA disabled"}
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))


@router.post("/revoke/{credential_id}")
async def revoke_mfa(credential_id: str):
    """Thu hồi MFA credential."""
    try:
        credential = await mfa_service.revoke(credential_id)
        return {"credential_id": credential.credential_id, "status": credential.status.value, "message": "MFA credential revoked"}
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))
