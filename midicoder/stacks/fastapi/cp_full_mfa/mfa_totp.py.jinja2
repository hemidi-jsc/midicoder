class TOTPSecretGenerator:
    """Generate và validate TOTP secrets."""

    @staticmethod
    def generate_secret(length: int = 20) -> str:
        """Generate TOTP secret.

        Args:
            length: Độ dài secret (bytes).

        Returns:
            Base32-encoded secret.
        """
        secret = secrets.token_bytes(length)
        return base64.b32encode(secret).decode("ascii")

    @staticmethod
    def generate_qr_uri(secret: str, user_id: str, issuer: str = "Midicoder") -> str:
        """Generate QR code URI cho TOTP.

        Args:
            secret: Base32-encoded secret.
            user_id: ID của user.
            issuer: Tên issuer.

        Returns:
            otpauth:// URI.
        """
        return f"otpauth://totp/{issuer}:{user_id}?secret={secret}&issuer={issuer}"


class TOTPVerifier:
    """Verify TOTP codes."""

    WINDOW = 1  # Cho phép ±1 time step (30 giây)

    @staticmethod
    def generate_totp(secret: str, time_step: int | None = None, period: int = 30) -> str:
        """Generate TOTP code.

        Args:
            secret: Base32-encoded secret.
            time_step: Time step (default: current).
            period: Period in seconds (default: 30).

        Returns:
            6-digit TOTP code.
        """
        if time_step is None:
            time_step = int(time.time()) // period

        secret_bytes = base64.b32decode(secret)
        msg = hmac.new(
            secret_bytes,
            time_step.to_bytes(8, "big"),
            hashlib.sha1,
        ).digest()

        offset = msg[-1] & 0x0F
        code = (
            ((msg[offset] & 0x7F) << 24)
            | ((msg[offset + 1] & 0xFF) << 16)
            | ((msg[offset + 2] & 0xFF) << 8)
            | (msg[offset + 3] & 0xFF)
        ) % 1000000

        return f"{code:06d}"

    @staticmethod
    def verify_totp(secret: str, code: str, period: int = 30) -> bool:
        """Verify TOTP code.

        Args:
            secret: Base32-encoded secret.
            code: 6-digit code.
            period: Period in seconds.

        Returns:
            True nếu code hợp lệ.
        """
        if len(code) != 6 or not code.isdigit():
            return False

        current_step = int(time.time()) // period

        for offset in range(-TOTPVerifier.WINDOW, TOTPVerifier.WINDOW + 1):
            expected = TOTPVerifier.generate_totp(secret, current_step + offset, period)
            if hmac.compare_digest(expected, code):
                return True

        return False
