class PaymentRefundCreate(BaseModel):
    """
    Schema yêu cầu tạo hoàn tiền.

    Fields bắt buộc: transaction_id, refund_amount
    """

    model_config = ConfigDict(strict=True)

    transaction_id: str = Field(
        ...,
        description="ID của giao dịch thanh toán gốc cần hoàn tiền",
    )
    refund_amount: int = Field(
        ...,
        gt=0,
        description="Số tiền hoàn trả (đơn vị: đơn vị nhỏ nhất)",
    )
    refund_type: RefundType = Field(
        default=RefundType.FULL,
        description="Loại hoàn tiền: full hoặc partial",
    )
    reason: str | None = Field(
        default=None,
        max_length=1000,
        description="Lý do hoàn tiền",
    )
    requested_by: str | None = Field(
        default=None,
        max_length=255,
        description="ID của người khởi tạo yêu cầu hoàn tiền",
    )
    tenant_id: str = Field(
        default="default",
        max_length=100,
        description="Tenant ID",
    )
    metadata: dict[str, Any] | None = Field(
        default=None,
        description="Metadata mở rộng",
    )


class PaymentRefundRead(BaseModel):
    """
    Schema trả về thông tin hoàn tiền.

    Chứa đầy đủ thông tin: số tiền hoàn, trạng thái, gateway response.
    """

    model_config = ConfigDict(from_attributes=True)

    refund_id: str = Field(..., description="Định danh duy nhất của hoàn tiền")
    reference_code: str = Field(..., description="Mã tham chiếu hoàn tiền")
    transaction_id: str = Field(..., description="ID giao dịch gốc")
    refund_amount: int = Field(..., description="Số tiền hoàn trả")
    currency: str = Field(..., description="Mã tiền tệ")
    refund_type: str = Field(..., description="Loại hoàn tiền")
    status: str = Field(..., description="Trạng thái hoàn tiền")
    reason: str | None = Field(default=None, description="Lý do hoàn tiền")
    requested_by: str | None = Field(default=None, description="Người yêu cầu")
    gateway_refund_id: str | None = Field(default=None, description="Refund ID từ gateway")
    error_code: str | None = Field(default=None, description="Mã lỗi từ gateway")
    error_message: str | None = Field(default=None, description="Thông báo lỗi")
    gateway_response_data: dict[str, Any] | None = Field(default=None, description="Response từ gateway")
    metadata: dict[str, Any] | None = Field(default=None, description="Metadata")
    created_at: datetime = Field(..., description="Thời điểm tạo")
    updated_at: datetime = Field(..., description="Thời điểm cập nhật cuối")
    completed_at: datetime | None = Field(default=None, description="Thời điểm hoàn thành")

    @property
    def is_successful(self) -> bool:
        """Kiểm tra hoàn tiền có thành công không."""
        return self.status == RefundStatus.COMPLETED.value


