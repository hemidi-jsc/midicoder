    """

    model_config = ConfigDict(strict=True)

    event_type: str = Field(
        ...,
        description="Loại sự kiện (vd: payment.success, payment.failed, refund.completed)",
    )
    event_id: str = Field(
        ...,
        description="ID duy nhất của sự kiện từ gateway",
    )
    timestamp: datetime = Field(
        ...,
        description="Thời điểm sự kiện xảy ra (từ gateway)",
    )
    gateway_provider: PaymentGatewayProvider = Field(
        ...,
        description="Nhà cung cấp gateway gửi webhook",
    )
    gateway_transaction_id: str = Field(
        ...,
        description="Transaction ID từ gateway provider",
    )
    amount: int = Field(
        ...,
        gt=0,
        description="Số tiền giao dịch",
    )
    currency: str = Field(
        ...,
        description="Mã tiền tệ",
    )
    status: str = Field(
        ...,
        description="Trạng thái giao dịch từ gateway",
    )
    reference_code: str | None = Field(
        default=None,
        description="Mã tham chiếu của giao dịch (nếu có)",
