    """
    Schema trả về cấu hình payment gateway.

    Không bao giờ trả về API key hay secret key — chỉ trả về
    thông tin cấu hình không nhạy cảm.
    """

    model_config = ConfigDict(from_attributes=True)

    config_id: str = Field(..., description="Định danh cấu hình")
    provider: str = Field(..., description="Nhà cung cấp gateway")
    display_name: str = Field(..., description="Tên hiển thị")
    environment: str = Field(..., description="Môi trường")
