# Idempotency Protection
# ============================================================================


class WebhookIdempotencyStore:
    """
    Lưu trữ idempotency keys để tránh xử lý webhook trùng.

    Trong thực tế, nên dùng Redis với TTL cho store này.
    """

    def __init__(self):
        self._processed: dict[str, datetime] = {}

    def is_processed(self, event_id: str) -> bool:
        """Kiểm tra event đã được xử lý chưa."""
        return event_id in self._processed

    def mark_processed(self, event_id: str) -> None:
        """Đánh dấu event đã xử lý."""
        self._processed[event_id] = datetime.now(timezone.utc)

    def cleanup_expired(self, max_age_seconds: int = 86400 * 30) -> None:
        """Xóa các event cũ."""
        cutoff = datetime.now(timezone.utc).timestamp() - max_age_seconds
        self._processed = {
            k: v for k, v in self._processed.items()
            if v.timestamp() > cutoff
        }
