            "action": "payment_canceled",
            "payment_intent_id": intent.get("id"),
        }

    async def handle_charge_succeeded(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý charge.succeeded."""
        charge = event.get("data", {}).get("object", {})
        return {
