class StripeWebhookHandler:
    """
    Handler cho Stripe webhook events.

    Cung cấp:
    - verify_signature(): xác minh chữ ký webhook
    - handle_event(): route event đến handler phù hợp
    - Các handler cho payment lifecycle events

    Usage:
        handler = StripeWebhookHandler(secret=STRIPE_WEBHOOK_SECRET)
        is_valid = handler.verify_signature(payload, signature)
        result = await handler.handle_event(event)
    """

    def __init__(
        self,
        secret: str,
        endpoint_secret: str | None = None,
        tolerance: int = 300,
    ):
        """
        Args:
            secret: Stripe signing secret (whsec_*)
            endpoint_secret: Linear endpoint secret (tùy chọn)
            tolerance: Tolerance cho timestamp drift (giây), mặc định 300s
        """
        self.secret = secret
        self.endpoint_secret = endpoint_secret
        self.tolerance = tolerance

        # Event routing table
        self.ROUTING: dict[str, Callable] = {
            "payment_intent.succeeded": self.handle_payment_succeeded,
            "payment_intent.payment_failed": self.handle_payment_failed,
            "payment_intent.canceled": self.handle_payment_canceled,
            "charge.succeeded": self.handle_charge_succeeded,
            "charge.refunded": self.handle_refund_created,
            "charge.failed": self.handle_charge_failed,
            "invoice.payment_succeeded": self.handle_invoice_paid,
            "invoice.payment_failed": self.handle_invoice_failed,
            "customer.subscription.created": self.handle_subscription_created,
            "customer.subscription.updated": self.handle_subscription_updated,
            "customer.subscription.deleted": self.handle_subscription_deleted,
        }

    def verify_signature(
        self,
        payload: bytes,
        signature: str,
        timestamp: str | None = None,
    ) -> bool:
        """
        Xác minh chữ ký Stripe webhook.

        Stripe ký mỗi webhook payload với signing secret. Phương thức này
        xác minh chữ ký để đảm bảo webhook thực sự từ Stripe.

        Args:
            payload: Raw body từ webhook request
            signature: Chữ ký từ header `Stripe-Signature`
            timestamp: Timestamp tùy chọn từ header

        Returns:
            True nếu chữ ký hợp lệ

        Raises:
            ValueError: Nếu chữ ký không hợp lệ
        """
        # Parse signature header
        parts = signature.split(",")
        sig_dict = {}
        for part in parts:
            key, value = part.strip().split("=")
            sig_dict[key] = value

        # Check timestamp
        if timestamp:
            event_time = int(timestamp)
            if abs(time.time() - event_time) > self.tolerance:
                logger.warning(
                    "Webhook timestamp ngoài tolerance: %d vs %d",
                    event_time,
                    time.time(),
                )
                return False

        # Extract signature
        sig_typed = sig_dict.get("v1", "")
        if not sig_typed:
            return False

        # Construct signed payload
        signed_payload = f"{sig_dict.get('t', '')}.{payload.decode('utf-8')}"

        # Compute expected signature
        expected = hmac.new(
            self.secret.encode("utf-8"),
            signed_payload.encode("utf-8"),
            hashlib.sha256,
        ).hexdigest()

        return hmac.compare_digest(expected, sig_typed)

    async def handle_event(self, event: dict[str, Any]) -> dict[str, Any]:
        """
        Route Stripe event đến handler phù hợp.

        Args:
            event: Stripe event object

        Returns:
            Kết quả xử lý event
        """
        event_type = event.get("type", "")
        event_id = event.get("id", "unknown")

        handler = self.ROUTING.get(event_type)
        if not handler:
            logger.info("Event không được xử lý: type=%s, id=%s", event_type, event_id)
            return {"status": "ignored", "event_type": event_type, "event_id": event_id}

        try:
            result = await handler(event)
            logger.info("Xử lý event thành công: type=%s, id=%s", event_type, event_id)
            return {
                "status": "processed",
                "event_type": event_type,
                "event_id": event_id,
                "result": result,
            }
        except Exception as e:
            logger.error(
                "Lỗi xử lý event: type=%s, id=%s, error=%s",
                event_type,
                event_id,
                str(e),
            )
            return {
                "status": "error",
                "event_type": event_type,
                "event_id": event_id,
                "error": str(e),
            }

    async def handle_payment_succeeded(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý payment_intent.succeeded — cập nhật trạng thái thanh toán."""
        intent = event.get("data", {}).get("object", {})
        payment_id = intent.get("id", "")
        metadata = intent.get("metadata", {})

        return {
            "action": "payment_succeeded",
            "payment_intent_id": payment_id,
            "amount": intent.get("amount"),
            "currency": intent.get("currency"),
            "metadata": metadata,
        }

    async def handle_payment_failed(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý payment_intent.payment_failed — cập nhật trạng thái thất bại."""
        intent = event.get("data", {}).get("object", {})
        return {
            "action": "payment_failed",
            "payment_intent_id": intent.get("id"),
            "failure_reason": intent.get("last_payment_error", {}).get("message"),
        }

    async def handle_payment_canceled(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý payment_intent.canceled."""
        intent = event.get("data", {}).get("object", {})
