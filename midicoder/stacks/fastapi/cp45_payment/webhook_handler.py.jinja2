            "action": "refund_created",
            "charge_id": charge.get("id"),
            "refund_amount": charge.get("amount_refunded"),
            "balance_transaction": charge.get("balance_transaction"),
        }

    async def handle_charge_failed(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý charge.failed."""
        charge = event.get("data", {}).get("object", {})
        return {
            "action": "charge_failed",
            "charge_id": charge.get("id"),
            "failure_code": charge.get("outcome", {}).get("seller_message"),
        }

    async def handle_invoice_paid(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý invoice.payment_succeeded."""
        invoice = event.get("data", {}).get("object", {})
        return {
            "action": "invoice_paid",
            "invoice_id": invoice.get("id"),
            "amount_paid": invoice.get("amount_paid"),
        }

    async def handle_invoice_failed(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý invoice.payment_failed."""
        invoice = event.get("data", {}).get("object", {})
        return {
            "action": "invoice_failed",
            "invoice_id": invoice.get("id"),
        }

    async def handle_subscription_created(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý customer.subscription.created."""
        subscription = event.get("data", {}).get("object", {})
        return {
            "action": "subscription_created",
            "subscription_id": subscription.get("id"),
            "customer_id": subscription.get("customer"),
            "status": subscription.get("status"),
        }

    async def handle_subscription_updated(self, event: dict[str, Any]) -> dict[str, Any]:
        """Xử lý customer.subscription.updated."""
        subscription = event.get("data", {}).get("object", {})
