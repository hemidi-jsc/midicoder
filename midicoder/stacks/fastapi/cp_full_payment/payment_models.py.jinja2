{% if enable_idempotency %}


class IdempotencyKeyModel(Base):
    """
    Mô hình idempotency key — bảo vệ chống trùng lặp giao dịch.

    Mỗi idempotency key được lưu lại kèm với transaction_id đã xử lý.
    Khi nhận được request với key đã tồn tại, trả về kết quả cũ thay
    vì xử lý lại — đảm bảo idempotent behavior.

    Keys tự động hết hạn sau khoảng thời gian cấu hình để giải phóng
    không gian lưu trữ.
    """

    __tablename__ = "payment_idempotency_keys"

    # Định danh
    key_value: Mapped[str] = mapped_column(
        String(255),
        primary_key=True,
        comment="Giá trị idempotency key (hash hoặc UUID)",
    )

    # Liên kết với giao dịch đã xử lý
    transaction_id: Mapped[uuid.UUID | None] = mapped_column(
        UUID(as_uuid=True),
        ForeignKey("payment_transactions.transaction_id", ondelete="SET NULL"),
        nullable=True,
        index=True,
        comment="ID của giao dịch đã xử lý với key này",
    )

    # Thông tin request gốc
    request_body_hash: Mapped[str | None] = mapped_column(
        String(64),
        nullable=True,
        comment="SHA-256 hash của request body để validate",
    )
    request_method: Mapped[str] = mapped_column(
        String(10),
        nullable=False,
        default="POST",
        comment="HTTP method của request gốc",
    )

    # Tenant & khách hàng
    tenant_id: Mapped[str] = mapped_column(
        String(100),
        nullable=False,
        default="default",
        index=True,
        comment="Tenant ID",
    )
    customer_id: Mapped[str | None] = mapped_column(
        String(255),
        nullable=True,
        comment="ID của khách hàng liên quan",
    )

    # Thời gian
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        nullable=False,
        default=lambda: datetime.now(timezone.utc),
        server_default=func.now(),
        comment="Thời điểm tạo key",
    )
    expires_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        nullable=False,
        index=True,
        comment="Thời điểm key hết hạn — sau đó có thể dọn dẹp",
    )

    __table_args__ = (
        index(
            "ix_idempotency_key_expires",
            "expires_at",
        ),
    )

    def __repr__(self) -> str:
        return (
            f"<IdempotencyKeyModel(key={self.key_value}, "
            f"transaction={self.transaction_id}, expires={self.expires_at})>"
        )

