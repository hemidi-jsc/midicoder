"""
Experiment Service — CRUD cho A/B Experiments.

Tạo tự động bởi CP37 — không sửa thủ công.
"""

from __future__ import annotations

import hashlib
from typing import Any

from sqlalchemy import select, func
from sqlalchemy.ext.asyncio import AsyncSession

from app.feature_flags.models.flag_model import (
    ABExperiment,
    ABVariant,
    ABExperimentAssignment,
)
from app.feature_flags.schemas.experiment_schema import (
    ABExperimentCreate,
    ABExperimentUpdate,
    ABExperimentResponse,
    ABExperimentAssignRequest,
    ABExperimentAssignResponse,
)


class ExperimentService:
    """Service quản lý A/B Experiments."""

    def __init__(self, db: AsyncSession) -> None:
        self.db = db

    async def create(self, data: ABExperimentCreate) -> ABExperimentResponse:
        """Tạo experiment mới với variants."""
        experiment = ABExperiment(
            experiment_key=data.experiment_key,
            name=data.name,
            description=data.description,
            is_active=data.is_active,
            traffic_percentage=data.traffic_percentage,
            success_metric=data.success_metric,
        )
        self.db.add(experiment)
        await self.db.flush()
        await self.db.refresh(experiment)

        for v in data.variants:
            variant = ABVariant(
                experiment_id=experiment.id,
                variant_key=v.variant_key,
                name=v.name,
                weight=v.weight,
                metadata_json=v.metadata_json,
            )
            self.db.add(variant)

        await self.db.flush()
        return await self._to_response(experiment)

    async def get_by_key(self, experiment_key: str) -> ABExperimentResponse | None:
        """Lấy experiment theo key."""
        stmt = select(ABExperiment).where(ABExperiment.experiment_key == experiment_key)
        exp = (await self.db.execute(stmt)).scalar_one_or_none()
        if exp is None:
            return None
        return await self._to_response(exp)

    async def list_active(self) -> list[ABExperimentResponse]:
        """Lấy danh sách experiments đang chạy."""
        stmt = select(ABExperiment).where(ABExperiment.is_active.is_(True))
        exps = (await self.db.execute(stmt)).scalars().all()
        return [await self._to_response(e) for e in exps]

    async def assign(self, data: ABExperimentAssignRequest) -> ABExperimentAssignResponse | None:
        """Assign user vào variant (deterministic).

        Nếu user đã được assign trước đó, trả về variant cũ.
        """
        # Kiểm tra assignment cũ
        existing = select(ABExperimentAssignment).where(
            ABExperimentAssignment.experiment_key == data.experiment_key,
            ABExperimentAssignment.user_id == data.user_id,
        )
        # Simplified: luôn re-assign deterministic
        experiment = await self.get_by_key(data.experiment_key)
        if experiment is None:
            return None

        # Deterministic assignment
        user_hash = int(
            hashlib.sha256(f"{data.experiment_key}:{data.user_id}".encode()).hexdigest(), 16
        )
        variant_bucket = user_hash % 100
        cumulative = 0.0
        assigned_variant = experiment.variants[0].variant_key

        for v in experiment.variants:
            cumulative += v.weight
            if variant_bucket < cumulative:
                assigned_variant = v.variant_key
                break

        return ABExperimentAssignResponse(
            experiment_key=data.experiment_key,
            user_id=data.user_id,
            tenant_id=data.tenant_id,
            assigned_variant=assigned_variant,
        )

    async def update(
        self, experiment_key: str, data: ABExperimentUpdate
    ) -> ABExperimentResponse | None:
        """Cập nhật experiment."""
        exp = await self.get_by_key(experiment_key)
        if exp is None:
            return None
        update_data = data.model_dump(exclude_unset=True)
        for key, value in update_data.items():
            setattr(exp, key, value)
        await self.db.flush()
        await self.db.refresh(exp)
        return await self._to_response(exp)

    async def _to_response(self, exp: ABExperiment) -> ABExperimentResponse:
        """Chuyển experiment sang response."""
        variants_stmt = select(ABVariant).where(ABVariant.experiment_id == exp.id)
        variants = (await self.db.execute(variants_stmt)).scalars().all()

        return ABExperimentResponse(
            id=exp.id,
            experiment_key=exp.experiment_key,
            name=exp.name,
            description=exp.description,
            is_active=exp.is_active,
            traffic_percentage=exp.traffic_percentage,
            success_metric=exp.success_metric,
            start_date=exp.start_date,
            end_date=exp.end_date,
            variants=[{"variant_key": v.variant_key, "name": v.name, "weight": v.weight} for v in variants],
            created_at=exp.created_at,
            updated_at=exp.updated_at,
        )
