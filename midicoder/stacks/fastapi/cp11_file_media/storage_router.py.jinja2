from .media_transform import MediaTransformService


@router.post("/transform/{key}")
async def transform_file(
    key: str,
    transform_name: str = Query(..., description="Tên transform từ TRANSFORMS dict"),
    tenant_id: Optional[str] = Query(None, description="KPI-029: Tenant ID"),
) -> dict:
    """
    Apply media transform cho file.

    Tải file từ storage, apply transform (resize/thumbnail/transcode),
    và trả về kết quả.

    KPI-029: Nếu có tenant_id, sẽ thêm tenant prefix vào key.

    Args:
        key: File key (bao gồm folder path)
        transform_name: Tên transform từ TRANSFORMS dict
        tenant_id: KPI-029: Tenant ID cho tenant isolation

    Returns:
        Kết quả transform (transformed bytes metadata)

    Raises:
        HTTPException 400: Nếu transform_name không hợp lệ
        HTTPException 404: Nếu file không tìm thấy
    """
    # Tạo service instances
    upload_service = FileUploadService(tenant_id=tenant_id)
    transform_service = MediaTransformService()

    # Tải file từ storage
    try:
        content = await upload_service.download(key, tenant_id=tenant_id)
    except Exception as e:
        raise HTTPException(
            status_code=404,
            detail=f"Không tìm thấy file: {key} ({e})",
        )

    # Apply transform
    try:
        transformed = transform_service.apply_transform(content, transform_name)
    except ValueError as e:
        raise HTTPException(
            status_code=400,
            detail=f"Transform error: {e}",
        )

    return {
        "key": key,
        "transform": transform_name,
        "original_size": len(content),
        "transformed_size": len(transformed),
        "tenant_id": tenant_id,  # KPI-029: Return tenant_id
    }

{% endif %}
