# coding: utf-8
"""
Storage Router cho FastAPI - Auto-generated by Midicoder CE.

Cung cấp:
- POST /api/storage/upload — Upload file với UploadPolicy enforcement
- GET /api/storage/download/{key} — Download file theo key
- DELETE /api/storage/delete/{key} — Xóa file theo key
- GET /api/storage/presigned/{key} — Lấy presigned URL cho file

Obligation: UploadPolicy validation mandatory — mọi file upload PHẢI được validate
KPI-029: Tenant Isolation — tenant_id query param để isolate files theo tenant
CP11: File Storage & Media
"""

from typing import Optional

from fastapi import APIRouter, UploadFile, File, Query, HTTPException

from .file_upload import FileUploadService


# Khởi tạo router với prefix và tags
router = APIRouter(prefix="/api/storage", tags=["storage"])


# =============================================================================
# UploadPolicy constants — Sinh tự động từ {{ collection.policies }}
# =============================================================================
# Danh sách các policy name hợp lệ — dùng để validate query param

AVAILABLE_POLICIES = [
{% for policy in collection.policies %}
    "{{ policy.name }}",  # {{ policy.description or policy.name }}
{% endfor %}
]

{% if collection.policies %}
DEFAULT_POLICY = "{{ collection.policies[0].name }}"
{% else %}
DEFAULT_POLICY = ""
{% endif %}


# =============================================================================
# Helper: Validate UploadPolicy
# =============================================================================

def _validate_policy(policy_name: str) -> str:
    """
    Validate tên UploadPolicy.

    Obligation enforcement: Nếu có policies được định nghĩa, policy_name
    PHẢI nằm trong danh sách AVAILABLE_POLICIES.

    Args:
        policy_name: Tên policy cần validate

    Returns:
        Tên policy hợp lệ

    Raises:
        HTTPException: Nếu policy không tìm thấy
    """
{% if collection.policies %}
    # Obligation: validate policy name
    if policy_name not in AVAILABLE_POLICIES:
        raise HTTPException(
            status_code=400,
            detail=(
                f"Policy '{policy_name}' không hợp lệ. "
                f"Hãy chọn trong: {', '.join(AVAILABLE_POLICIES)}"
            ),
        )
{% endif %}
    return policy_name


# =============================================================================
# Routes
# =============================================================================


@router.post("/upload")
async def upload_file(
    file: UploadFile = File(..., description="File cần upload"),
    folder: str = Query("uploads", description="Folder lưu trữ"),
    policy: str = Query(DEFAULT_POLICY, description="UploadPolicy name"),
    tenant_id: Optional[str] = Query(None, description="KPI-029: Tenant ID"),
    transform: Optional[str] = Query(None, description="Transform name (optional)"),
) -> dict:
    """
    Upload file với UploadPolicy enforcement.

    Obligation: Mỗi file upload PHẢI đi qua validation bao gồm:
    - Content-type check
    - Size limit check
    - Extension check

    KPI-029: Nếu có tenant_id, file sẽ được lưu với tenant-specific prefix
    để đảm bảo tenant isolation.

    Args:
        file: File upload
        folder: Folder lưu trữ (default: "uploads")
        policy: Tên UploadPolicy để enforce validation
        tenant_id: KPI-029: Tenant ID cho tenant isolation
        transform: Tên transform để áp dụng sau upload (optional)

    Returns:
        Thông tin file đã upload (filename, url, key, size, type, tenant_id)

    Raises:
        HTTPException 400: Nếu vi phạm UploadPolicy
        HTTPException 400: Nếu policy name không hợp lệ
    """
    # Obligation: validate policy name
    validated_policy = _validate_policy(policy)

    # Tạo service instance với tenant context
    service = FileUploadService(tenant_id=tenant_id)

    # Upload file với policy enforcement
    result = await service.upload(
        file,
        folder=folder,
        policy_name=validated_policy,
        tenant_id=tenant_id,
    )

    # KPI-029: Trả về tenant_id trong response
    result["policy"] = validated_policy
    return result


@router.get("/download/{key}")
async def download_file(
    key: str,
    tenant_id: Optional[str] = Query(None, description="KPI-029: Tenant ID"),
) -> dict:
    """
    Download file theo key.

    KPI-029: Nếu có tenant_id, sẽ thêm tenant prefix vào key nếu chưa có
    để đảm bảo tenant isolation.

    Args:
        key: File key (bao gồm folder path)
        tenant_id: KPI-029: Tenant ID cho tenant isolation

    Returns:
        File content và metadata

    Raises:
        HTTPException 404: Nếu file không tìm thấy
    """
    # Tạo service instance với tenant context
    service = FileUploadService(tenant_id=tenant_id)

    # KPI-029: Thêm tenant prefix nếu cần
    try:
        content = await service.download(key, tenant_id=tenant_id)
        return {
            "key": key,
            "size": len(content),
            "tenant_id": tenant_id,  # KPI-029: Return tenant_id
            "downloaded": True,
        }
    except Exception as e:
        raise HTTPException(
            status_code=404,
            detail=f"Không tìm thấy file: {key} ({e})",
        )


@router.delete("/delete/{key}")
async def delete_file(
    key: str,
    tenant_id: Optional[str] = Query(None, description="KPI-029: Tenant ID"),
) -> dict:
    """
    Xóa file theo key.

    KPI-029: Nếu có tenant_id, sẽ thêm tenant prefix vào key nếu chưa có
    để đảm bảo tenant isolation.

    Args:
        key: File key (bao gồm folder path)
        tenant_id: KPI-029: Tenant ID cho tenant isolation

    Returns:
        Kết quả xóa file

    Raises:
        HTTPException 500: Nếu xóa thất bại
    """
    # Tạo service instance với tenant context
    service = FileUploadService(tenant_id=tenant_id)

    # KPI-029: Xóa file với tenant context
    success = await service.delete(key, tenant_id=tenant_id)

    if not success:
        raise HTTPException(
            status_code=500,
            detail=f"Không thể xóa file: {key}",
        )

    return {
        "success": True,
        "key": key,
        "tenant_id": tenant_id,  # KPI-029: Return tenant_id
    }


@router.get("/presigned/{key}")
async def get_presigned_url(
    key: str,
    expiration: int = Query(3600, ge=60, le=86400, description="URL expiration (giây)"),
    tenant_id: Optional[str] = Query(None, description="KPI-029: Tenant ID"),
) -> dict:
    """
    Lấy presigned URL cho file.

    Presigned URL cho phép truy cập trực tiếp file mà không cần qua API server.
    URL có thời hạn (expiration) sau đó sẽ hết hạn.

    KPI-029: Nếu có tenant_id, sẽ thêm tenant prefix vào key nếu chưa có
    để đảm bảo tenant isolation.

    Args:
        key: File key (bao gồm folder path)
        expiration: Thời hạn URL (giây), mặc định 3600 (1 giờ)
        tenant_id: KPI-029: Tenant ID cho tenant isolation

    Returns:
        Presigned URL và metadata

    Raises:
        HTTPException 400: Nếu expiration không hợp lệ
    """
    # Tạo service instance với tenant context
    service = FileUploadService(tenant_id=tenant_id)

    # KPI-029: Tạo presigned URL với tenant context
    url = await service.get_presigned_url(
        key,
        expiration=expiration,
        tenant_id=tenant_id,
    )

    return {
        "url": url,
        "key": key,
        "expiration": expiration,
        "tenant_id": tenant_id,  # KPI-029: Return tenant_id
    }


