"""
Cấu hình i18n — locales và fallback chain.

Tạo tự động bởi CP29 — không sửa thủ công.
"""

from __future__ import annotations

# Locales hỗ trợ
SUPPORTED_LOCALES: list[str] = [
{% for loc in language_profile.locales %}
    "{{ loc }}",
{% endfor %}
]

# Locale mặc định
DEFAULT_LOCALE: str = "{{ language_profile.default_locale }}"

# Fallback chain — thứ tự tìm translation khi không có trong locale mục tiêu
FALLBACK_CHAIN: list[str] = [
{% for loc in language_profile.fallback_chain %}
    "{{ loc }}",
{% endfor %}
]

# Đường dẫn thư mục locale
LOCALE_DIR: str = "i18n/locales"
