"""
Transfer Processing Workflow

Quy trình xử lý chuyển tiền: PENDING → KYC_CHECKED → AML_CHECKED → PROCESSING → COMPLETED/FAILED.
RX02: Double-entry validation. RX03: KYC + AML screening.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from decimal import Decimal
from enum import Enum
from typing import Any, Dict, List, Optional


class TransferState(str, Enum):
    """Trạng thái quy trình chuyển tiền."""
    PENDING = "pending"
    KYC_CHECKED = "kyc_checked"
    AML_CHECKED = "aml_checked"
    PROCESSING = "processing"
    COMPLETED = "completed"
    FAILED = "failed"


class TransferEvent(str, Enum):
    """Sự kiện trong quy trình chuyển tiền."""
    INITIATE = "initiate"
    KYC_PASSED = "kyc_passed"
    KYC_FAILED = "kyc_failed"
    AML_PASSED = "aml_passed"
    AML_FAILED = "aml_failed"
    PROCESS = "process"
    COMPLETED = "completed"
    FAILED = "failed"


@dataclass
class WorkflowTransition:
    """Chuyển trạng thái trong workflow."""
    from_state: TransferState
    to_state: TransferState
    event: TransferEvent
    guard: Optional[str] = None
    effect: Optional[str] = None


TRANSFER_TRANSITIONS: List[WorkflowTransition] = [
    WorkflowTransition(TransferState.PENDING, TransferState.KYC_CHECKED, TransferEvent.KYC_PASSED, "kyc_verified_guard", "write_kyc_audit"),
    WorkflowTransition(TransferState.PENDING, TransferState.FAILED, TransferEvent.KYC_FAILED, None, "write_failure_log"),
    WorkflowTransition(TransferState.KYC_CHECKED, TransferState.AML_CHECKED, TransferEvent.AML_PASSED, "aml_screening_guard", "write_aml_audit"),
    WorkflowTransition(TransferState.KYC_CHECKED, TransferState.FAILED, TransferEvent.AML_FAILED, None, "write_failure_log"),
    WorkflowTransition(TransferState.AML_CHECKED, TransferState.PROCESSING, TransferEvent.PROCESS, "balance_check_guard", "initiate_double_entry"),
    WorkflowTransition(TransferState.PROCESSING, TransferState.COMPLETED, TransferEvent.COMPLETED, "double_entry_balanced_guard", "commit_transaction"),
    WorkflowTransition(TransferState.PROCESSING, TransferState.FAILED, TransferEvent.FAILED, None, "rollback_transaction"),
]


@dataclass
class TransferProcessingWorkflow:
    """Workflow cho quy trình xử lý chuyển tiền.

    State machine: PENDING → KYC_CHECKED → AML_CHECKED → PROCESSING → COMPLETED/FAILED

    RX02: Double-entry validation ở bước PROCESSING
    RX03: KYC + AML screening trước khi PROCESS
    """

    workflow_id: str
    tenant_id: str
    transaction_id: str
    amount: Decimal
    current_state: TransferState = TransferState.PENDING
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.utcnow)
    updated_at: datetime = field(default_factory=datetime.utcnow)

    def can_transition(self, event: TransferEvent) -> bool:
        """Kiểm tra có thể transition với event này không."""
        return any(t.from_state == self.current_state and t.event == event for t in TRANSFER_TRANSITIONS)

    def transition(self, event: TransferEvent, context: Dict[str, Any]) -> TransferState:
        """Transition đến state mới."""
        if not self.can_transition(event):
            raise ValueError(f"Không thể transition từ {self.current_state.value} với event {event.value}")
        transition = next(t for t in TRANSFER_TRANSITIONS if t.from_state == self.current_state and t.event == event)
        self.history.append({"from": self.current_state.value, "to": transition.to_state.value, "event": event.value, "time": datetime.utcnow().isoformat()})
        self.current_state = transition.to_state
        self.updated_at = datetime.utcnow()
        return self.current_state

    @property
    def is_completed(self) -> bool:
        return self.current_state in (TransferState.COMPLETED, TransferState.FAILED)


