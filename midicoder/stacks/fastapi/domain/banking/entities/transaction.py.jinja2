"""
Banking Transaction Entity Model

Giao dịch chuyển tiền giữa các tài khoản.
Mỗi transaction tạo ra một JournalEntry với double-entry bookkeeping.
RX02: Financial Integrity - Transactions trace to journal entries.
"""

from __future__ import annotations

from datetime import datetime
from decimal import Decimal
from enum import Enum

from sqlalchemy import Column, DateTime, Enum as SQLAlchemyEnum, ForeignKey, Index, Numeric, String
from sqlalchemy.orm import relationship

from ...db.base_model import Base
from ...db.tenant_mixin import TenantRowMixin


class TransactionStatus(str, Enum):
    """Trạng thái giao dịch."""
    PENDING = "pending"
    PROCESSING = "processing"
    COMPLETED = "completed"
    FAILED = "failed"
    REVERSED = "reversed"


class TransactionType(str, Enum):
    """Loại giao dịch."""
    TRANSFER = "transfer"
    DEPOSIT = "deposit"
    WITHDRAWAL = "withdrawal"
    FEE = "fee"
    INTEREST = "interest"


class Transaction(Base, TenantRowMixin):
    """Transaction entity model.

    Giao dịch ngân hàng với đầy đủ audit trail.
    Mỗi transaction liên kết với một JournalEntry.

    RX02 Compliance:
    - Linked to journal_entry cho double-entry tracking
    - Immutable sau khi completed
    """

    __tablename__ = "banking_transactions"

    transaction_id = Column(String(50), nullable=False, unique=True)
    transaction_type = Column(SQLAlchemyEnum(TransactionType), nullable=False)
    source_account_id = Column(String(50), nullable=True)
    target_account_id = Column(String(50), nullable=True)
    amount = Column(Numeric(19, 2), nullable=False)
    currency = Column(String(3), nullable=False, default="VND")
    fee = Column(Numeric(19, 2), nullable=False, default=Decimal("0.00"))
    status = Column(SQLAlchemyEnum(TransactionStatus), nullable=False, default=TransactionStatus.PENDING)
    description = Column(String(500), nullable=True)
    reference = Column(String(100), nullable=True)
    journal_entry_id = Column(String(50), nullable=True)

    # KYC/AML flags (RX03)
    kyc_verified = Column(String(1), nullable=False, default="0")
    aml_screening_passed = Column(String(1), nullable=False, default="0")

    # Timestamps
    initiated_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    completed_at = Column(DateTime, nullable=True)

    # Relationships
    source_account = relationship("Account", foreign_keys=[source_account_id])

    __table_args__ = (
        Index("idx_transaction_id", "transaction_id"),
        Index("idx_transaction_status", "status"),
        Index("idx_source_account", "source_account_id"),
        Index("idx_journal_entry", "journal_entry_id"),
    )

    def is_immutable(self) -> bool:
        """Kiểm tra transaction có immutable không."""
        return self.status in (TransactionStatus.COMPLETED, TransactionStatus.REVERSED)

    def can_complete(self) -> bool:
        """Kiểm tra có thể hoàn tất transaction không."""
        return (
            self.status == TransactionStatus.PROCESSING
            and self.kyc_verified == "1"
            and self.aml_screening_passed == "1"
        )