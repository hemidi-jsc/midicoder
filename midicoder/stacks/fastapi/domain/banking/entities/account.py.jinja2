"""
Banking Account Entity Model

Tài khoản ngân hàng với các thuộc tính:
- Số tài khoản duy nhất
- Loại tài khoản (checking/savings/current)
- Số dư hiện tại
- Trạng thái (active/frozen/closed)
- KPI-029: Multi-tenant isolation qua tenant_id
- RX03: KYC status tracking
"""

from __future__ import annotations

from datetime import datetime
from decimal import Decimal
from enum import Enum
from typing import List, Optional

from sqlalchemy import CheckConstraint, Column, DateTime, Enum as SQLAlchemyEnum, Index, Numeric, String
from sqlalchemy.orm import relationship

from ...db.base_model import Base
from ...db.tenant_mixin import TenantRowMixin


class AccountStatus(str, Enum):
    """Trạng thái tài khoản."""
    ACTIVE = "active"
    FROZEN = "frozen"
    CLOSED = "closed"


class AccountType(str, Enum):
    """Loại tài khoản ngân hàng."""
    CHECKING = "checking"
    SAVINGS = "savings"
    CURRENT = "current"


class Account(Base, TenantRowMixin):
    """Account entity model.

    Tài khoản ngân hàng với đầy đủ attributes cho banking operations.

    Tenant Isolation:
    - Kế thừa TenantRowMixin cho row-level isolation
    - tenant_id column tự động thêm vào table

    RX03 Compliance:
    - kyc_verified flag kiểm tra KYC status
    - kyc_verified_at timestamp ghi nhận thời gian KYC
    """

    __tablename__ = "banking_accounts"

    # Fields chính
    account_number = Column(String(50), nullable=False, unique=True)
    account_type = Column(SQLAlchemyEnum(AccountType), nullable=False, default=AccountType.CHECKING)
    currency = Column(String(3), nullable=False, default="VND")
    balance = Column(Numeric(19, 2), nullable=False, default=Decimal("0.00"))
    available_balance = Column(Numeric(19, 2), nullable=False, default=Decimal("0.00"))
    status = Column(SQLAlchemyEnum(AccountStatus), nullable=False, default=AccountStatus.ACTIVE)

    # KYC fields (RX03)
    kyc_verified = Column(String(1), nullable=False, default="0")
    kyc_verified_at = Column(DateTime, nullable=True)

    # Timestamps
    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    closed_at = Column(DateTime, nullable=True)
    updated_at = Column(DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow)

    # Relationships
    transactions = relationship("Transaction", back_populates="source_account")
    ledger_entries = relationship("LedgerEntry", back_populates="account")

    __table_args__ = (
        CheckConstraint("balance >= -1000000", name="chk_account_balance_floor"),
        Index("idx_account_number", "account_number"),
        Index("idx_account_status", "status"),
        Index("idx_account_tenant", "tenant_id"),
    )

    def can_debit(self, amount: Decimal) -> bool:
        """Kiểm tra có thể debit số tiền không."""
        if self.status != AccountStatus.ACTIVE:
            return False
        return (self.balance - amount) >= Decimal("-1000000")

    def can_credit(self) -> bool:
        """Kiểm tra có thể credit không."""
        return self.status == AccountStatus.ACTIVE

    def freeze(self) -> None:
        """Đóng băng tài khoản."""
        self.status = AccountStatus.FROZEN

    def unfreeze(self) -> None:
        """Mở khóa tài khoản."""
        self.status = AccountStatus.ACTIVE

    def close(self) -> None:
        """Đóng tài khoản (chỉ được đóng khi số dư = 0)."""
        if self.balance != Decimal("0.00"):
            raise ValueError("Không thể đóng tài khoản khi số dư khác 0")
        self.status = AccountStatus.CLOSED
        self.closed_at = datetime.utcnow()