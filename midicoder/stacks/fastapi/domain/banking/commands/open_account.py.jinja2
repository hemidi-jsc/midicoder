"""
Open Account Command

Mở tài khoản ngân hàng mới.
RX03: KYC + AML guards trước khi tạo tài khoản.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from decimal import Decimal
from typing import Any, Optional

from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.account import Account, AccountStatus, AccountType


@dataclass
class OpenAccountInput:
    """Input cho lệnh mở tài khoản."""
    account_number: str
    account_type: str
    currency: str = "VND"
    initial_deposit: Decimal = field(default_factory=lambda: Decimal("0.00"))
    customer_id: Optional[str] = None
    kyc_verified: bool = False


@dataclass
class OpenAccountOutput:
    """Output của lệnh mở tài khoản."""
    account_id: str
    account_number: str
    status: str
    created_at: datetime


class OpenAccountCommand(BaseCommand):
    """OpenAccount command.

    Lệnh mở tài khoản mới với các guards:
    - tenant_scope: KPI-029 multi-tenant isolation
    - auth_required: Phải đăng nhập
    - permission: Cần quyền banking:account:create

    RX03 Compliance:
    - KYC verification trước khi mở tài khoản
    - AML screening (optional ở bước này)
    """

    name = "banking.open_account"
    description = "Mở tài khoản ngân hàng mới"

    # Guards: tenant_scope, auth_required, permission
    guards = [
        CommandGuards.tenant_scope,
        CommandGuards.auth_required,
        CommandGuards.permission("banking:account:create"),
    ]

    # Effects: create_record, write_audit_log, publish_event
    effects = [
        "create_record",
        "write_audit_log",
        "publish_event",
    ]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> OpenAccountInput:
        """Validate input data."""
        validator = CommandValidator(data)
        validator.require_string("account_number", min_length=1, max_length=50)
        validator.require_string("account_type", allowed=AccountType.__members__.keys())
        validator.require_string("currency", min_length=3, max_length=3)
        validator.require_decimal("initial_deposit", min_value=Decimal("0.00"))

        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")

        return OpenAccountInput(
            account_number=data["account_number"],
            account_type=data["account_type"],
            currency=data.get("currency", "VND"),
            initial_deposit=data.get("initial_deposit", Decimal("0.00")),
            customer_id=data.get("customer_id"),
            kyc_verified=data.get("kyc_verified", False),
        )

    def execute(self, input_data: OpenAccountInput, context: dict[str, Any]) -> OpenAccountOutput:
        """Execute open account command.

        Args:
            input_data: Input data đã được validate
            context: Context với tenant_id, user_id, db_session

        Returns:
            OpenAccountOutput với account_id và status

        Raises:
            ValueError: Nếu KYC chưa verify (RX03)
        """
        # RX03: Check KYC verification
        if not input_data.kyc_verified:
            raise ValueError("KYC verification chưa pass - không thể mở tài khoản")

        # Create account record
        account = Account(
            tenant_id=context["tenant_id"],
            account_number=input_data.account_number,
            account_type=AccountType(input_data.account_type),
            currency=input_data.currency,
            balance=input_data.initial_deposit,
            available_balance=input_data.initial_deposit,
            status=AccountStatus.ACTIVE,
            kyc_verified="1" if input_data.kyc_verified else "0",
            kyc_verified_at=datetime.utcnow() if input_data.kyc_verified else None,
            opened_at=datetime.utcnow(),
        )

        # Save to database
        db_session = context["db_session"]
        db_session.add(account)
        db_session.commit()

        return OpenAccountOutput(
            account_id=account.id,
            account_number=account.account_number,
            status=account.status.value,
            created_at=account.opened_at,
        )