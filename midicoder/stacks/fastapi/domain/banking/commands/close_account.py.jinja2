"""
Close Account Command

Đóng tài khoản (chỉ được đóng khi số dư = 0).
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from typing import Any

from ....errors import ErrorCode, MidicoderErrorManager as EM
from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.account import Account, AccountStatus


@dataclass
class CloseAccountInput:
    """Input cho lệnh đóng tài khoản."""
    account_id: str
    reason: str = ""


@dataclass
class CloseAccountOutput:
    """Output của lệnh đóng tài khoản."""
    account_id: str
    status: str
    closed_at: datetime


class CloseAccountCommand(BaseCommand):
    """CloseAccount command.

    Guards:
    - tenant_scope, auth_required, permission: banking:account:close
    """

    name = "banking.close_account"
    description = "Đóng tài khoản"

    guards = [
        CommandGuards.tenant_scope,
        CommandGuards.auth_required,
        CommandGuards.permission("banking:account:close"),
    ]

    effects = ["update_record", "write_audit_log", "publish_event"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> CloseAccountInput:
        """Validate input data."""
        validator = CommandValidator(data)
        validator.require_string("account_id", min_length=1)

        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")

        return CloseAccountInput(
            account_id=data["account_id"],
            reason=data.get("reason", ""),
        )

    def execute(self, input_data: CloseAccountInput, context: dict[str, Any]) -> CloseAccountOutput:
        """Execute close account command."""
        db_session = context["db_session"]
        tenant_id = context["tenant_id"]

        account = db_session.query(Account).filter(
            Account.id == input_data.account_id,
            Account.tenant_id == tenant_id,
        ).first()

        if not account:
            EM.raise_error(ErrorCode.CP01_ENTITY_NOT_FOUND, entity="Account", id=input_data.account_id)

        account.close()
        db_session.commit()

        return CloseAccountOutput(
            account_id=account.id,
            status=account.status.value,
            closed_at=account.closed_at,
        )