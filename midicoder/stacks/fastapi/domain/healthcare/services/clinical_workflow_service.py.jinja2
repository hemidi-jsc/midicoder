        audit_logger.info(
            "Clinical decision check",
            extra={
                "case_id": case_id,
                "check_type": check_type,
                "from_state": from_state,
                "to_state": to_state,
                "tenant_id": tenant_id,
                "result": "passed",
            },
        )

        return True

    async def log_phi_access(
        self,
        case_id: str,
        user_id: str,
        phi_fields: list[str],
        action: str,
        tenant_id: str,
    ) -> str:
        """
        Log PHI access (RX04 clinical_audit_trail).

        RX04: PHI encryption required, clinical audit trail, minimum necessary access.
        KPI-029: Tenant-scoped audit logging.

        Args:
            case_id: Clinical case ID
            user_id: User accessing PHI
            phi_fields: PHI fields being accessed
            action: Action performed (view, edit, export, etc.)
            tenant_id: KPI-029: Tenant ID

        Returns:
            Audit log ID
        """
        # Create audit record
        audit_id = f"audit_{tenant_id}_{datetime.now(timezone.utc).timestamp()}"

        audit_record = {
            "audit_id": audit_id,
            "case_id": case_id,
            "tenant_id": tenant_id,
            "user_id": user_id,
            "action": action,
            "phi_fields_accessed": phi_fields,
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "tamper_proof_hash": self._compute_hash(
                audit_id, case_id, user_id, action, phi_fields
            ),
        }

        # Save audit record (tamper-evident)
        await self._clinical_repo.save_phi_audit(audit_record)

        return audit_id

    async def verify_provider_credentials(
        self,
        user_id: str,
        tenant_id: str,
    ) -> bool:
        """
        Verify provider credentials cho clinical actions.

        RX04: Provider credential verification required.

        Args:
            user_id: Provider ID
            tenant_id: KPI-029: Tenant ID

        Returns:
            True nếu provider có chứng chỉ hợp lệ
        """
        # Get provider credentials
        provider = await self._clinical_repo.get_provider_credentials(
            user_id, tenant_id
        )

        if not provider:
            return False

        # Check certification status
        if not provider.get("certified", False):
            return False

        # Check certification expiry
        expiry_date = provider.get("certification_expiry")
        if expiry_date:
            expiry = datetime.fromisoformat(expiry_date)
            if datetime.now(timezone.utc) > expiry:
                return False

        return True

    def _is_valid_transition(self, from_state: str, to_state: str) -> bool:
        """
        Check nếu state transition hợp lệ.

        Args:
            from_state: Source state
            to_state: Target state

        Returns:
            True nếu transition hợp lệ
        """
        valid_to_states = self.VALID_TRANSITIONS.get(from_state, [])
        return to_state in valid_to_states

    def _compute_hash(
        self,
        audit_id: str,
        case_id: str,
        user_id: str,
        action: str,
        phi_fields: list[str],
    ) -> str:
        """
        Compute tamper-proof hash cho audit record.

        RX04: Tamper-evident logging.

        Args:
            audit_id: Audit ID
            case_id: Case ID
            user_id: User ID
            action: Action
            phi_fields: PHI fields

        Returns:
            Hash string
        """
        # TODO: Implement proper hash computation (SHA-256)
        # For now, return simple hash
        import hashlib

        data = f"{audit_id}|{case_id}|{user_id}|{action}|{','.join(phi_fields)}"
        return hashlib.sha256(data.encode()).hexdigest()

    async def get_case(
        self,
        case_id: str,
        tenant_id: str,
    ) -> Optional[dict[str, Any]]:
        """
        Get clinical case details.

        KPI-029: Tenant-scoped case retrieval.

        Args:
            case_id: Case ID
            tenant_id: KPI-029: Tenant ID

        Returns:
            Case dict hoặc None
        """
        return await self._clinical_repo.get_case(case_id, tenant_id)

    async def get_cases_by_state(
        self,
        state: str,
        tenant_id: str,
    ) -> list[dict[str, Any]]:
        """
        Get clinical cases by state.

        KPI-029: Tenant-scoped case query.

        Args:
            state: State to filter
            tenant_id: KPI-029: Tenant ID

        Returns:
            List của cases trong state
        """
        return await self._clinical_repo.get_cases_by_state(state, tenant_id)


