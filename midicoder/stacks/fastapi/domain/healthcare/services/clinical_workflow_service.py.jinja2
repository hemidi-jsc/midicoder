    """
    Dependency để get clinical workflow service.

    Returns:
        ClinicalWorkflowService instance

    Raises:
        RuntimeError: Nếu clinical workflow service chưa được initialize
    """
    if _clinical_workflow_service is None:
        raise RuntimeError("ClinicalWorkflowService chưa được initialize")

    return _clinical_workflow_service