# ============================================================================
# Clinical Workflow Service
# ============================================================================


class ClinicalWorkflowService:
    """
    Clinical Workflow Service - Healthcare workflow service.

    Service này cung cấp methods cho:
    - State transitions (pending → scheduled → in_progress → completed)
    - Clinical decision support checks (guard conditions)
    - PHI audit logging (RX04 clinical_audit_trail)
    - Provider credential verification

    KPI-029: Support tenant-scoped clinical operations.
    RX04: HIPAA compliance - PHI encryption, clinical audit trail, minimum necessary access.
    DP09: Healthcare Provider domain pack.

    Valid state transitions:
        - pending → scheduled
        - scheduled → in_progress
        - in_progress → completed
        - in_progress → cancelled
        - scheduled → cancelled

    Usage:
        clinical_svc = ClinicalWorkflowService(clinical_repo)
        result = await clinical_svc.transition_state(
            case_id="CASE_001", from_state="pending", to_state="scheduled",
            user_id="provider_123", tenant_id="tenant_123"
        )
    """

    # Valid state transitions
    VALID_TRANSITIONS = {
        "pending": ["scheduled", "cancelled"],
        "scheduled": ["in_progress", "cancelled"],
        "in_progress": ["completed", "cancelled"],
        "completed": [],
        "cancelled": [],
    }

    def __init__(self, clinical_repo: ClinicalRepository) -> None:
        """
        Initialize ClinicalWorkflowService.

        Args:
            clinical_repo: Repository cho clinical data storage
        """
        self._clinical_repo = clinical_repo

    async def transition_state(
        self,
        case_id: str,
        from_state: str,
        to_state: str,
        user_id: str,
        tenant_id: str,
    ) -> dict[str, Any]:
        """
        Transition clinical case state.

        KPI-029: Tenant-scoped clinical workflow.
        DP09: Healthcare Provider domain pack.

        Args:
            case_id: Clinical case ID
            from_state: Current state
            to_state: Target state
            user_id: Provider ID thực hiện transition
            tenant_id: KPI-029: Tenant ID

        Returns:
            Dict với transitioned status, new state

        Raises:
            ValueError: Nếu state transition không hợp lệ
        """
        # Validate transition
        if not self._is_valid_transition(from_state, to_state):
            raise ValueError(
                f"Invalid transition: {from_state} → {to_state}"
            )

        # Get case
        case = await self._clinical_repo.get_case(case_id, tenant_id)
        if not case:
            raise ValueError(f"Case not found: {case_id}")

        # Verify current state matches
        if case.get("state") != from_state:
            raise ValueError(
                f"State mismatch: expected {from_state}, current {case.get('state')}"
            )

        # Update case state
        await self._clinical_repo.update_case_state(
            case_id, tenant_id, to_state, user_id
        )

        # Audit log (RX04)
        audit_logger.info(
            "Clinical case state transitioned",
            extra={
                "case_id": case_id,
                "from_state": from_state,
                "to_state": to_state,
                "user_id": user_id,
                "tenant_id": tenant_id,
            },
        )

        return {
            "case_id": case_id,
            "from_state": from_state,
            "to_state": to_state,
            "transitioned": True,
        }

    async def check_clinical_decision(
        self,
        case_id: str,
        check_type: str,
        from_state: str,
        to_state: str,
        tenant_id: str,
