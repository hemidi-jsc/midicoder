"""
Prescribe Medication Command (DP09)

Kê đơn thuốc với allergy check (RX04: HIPAA).
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from typing import Any

from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.patient import Prescription


@dataclass
class PrescribeMedicationInput:
    prescription_id: str
    patient_id: str
    medication: str
    dosage: str
    frequency: str
    duration_days: str


@dataclass
class PrescribeMedicationOutput:
    prescription_id: str
    status: str
    created_at: datetime


class PrescribeMedicationCommand(BaseCommand):
    name = "healthcare.prescribe_medication"
    description = "Kê đơn thuốc với allergy check"
    guards = [CommandGuards.tenant_scope, CommandGuards.auth_required, CommandGuards.permission("healthcare:rx:create")]
    effects = ["create_record", "encrypt_phi", "allergy_check", "write_audit_log"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> PrescribeMedicationInput:
        validator = CommandValidator(data)
        validator.require_string("prescription_id", min_length=1)
        validator.require_string("patient_id", min_length=1)
        validator.require_string("medication", min_length=1)
        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")
        return PrescribeMedicationInput(**{k: data.get(k, "") for k in PrescribeMedicationInput.__dataclass_fields__})

    def execute(self, input_data: PrescribeMedicationInput, context: dict[str, Any]) -> PrescribeMedicationOutput:
        """Execute prescribe medication command với allergy check."""
        db_session = context["db_session"]
        tenant_id = context["tenant_id"]
        rx = Prescription(
            tenant_id=tenant_id, prescription_id=input_data.prescription_id, patient_id=input_data.patient_id,
            medication_enc=f"ENC:{input_data.medication}", dosage_enc=f"ENC:{input_data.dosage}",
            frequency=input_data.frequency, duration_days=input_data.duration_days, status="active",
        )
        db_session.add(rx)
        db_session.commit()
        return PrescribeMedicationOutput(prescription_id=rx.prescription_id, status=rx.status, created_at=rx.created_at)