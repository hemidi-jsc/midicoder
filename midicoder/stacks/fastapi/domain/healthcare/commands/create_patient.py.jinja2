"""
Create Patient Command (DP09)

Tạo bệnh nhân mới với PHI encryption (RX04: HIPAA).
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from typing import Any

from ....errors import ErrorCode, MidicoderErrorManager as EM
from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.patient import Patient, PatientStatus


@dataclass
class CreatePatientInput:
    patient_id: str
    full_name: str
    date_of_birth: str
    gender: str
    phone: str
    address: str


@dataclass
class CreatePatientOutput:
    patient_id: str
    status: str
    created_at: datetime


class CreatePatientCommand(BaseCommand):
    """CreatePatient command.

    RX04: PHI fields encrypted before storage.
    """

    name = "healthcare.create_patient"
    description = "Tạo bệnh nhân mới"

    guards = [CommandGuards.tenant_scope, CommandGuards.auth_required, CommandGuards.permission("healthcare:patient:create")]
    effects = ["create_record", "encrypt_phi", "write_audit_log"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> CreatePatientInput:
        validator = CommandValidator(data)
        validator.require_string("patient_id", min_length=1)
        validator.require_string("full_name", min_length=1)
        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")
        return CreatePatientInput(**{k: data.get(k, "") for k in CreatePatientInput.__dataclass_fields__})

    def execute(self, input_data: CreatePatientInput, context: dict[str, Any]) -> CreatePatientOutput:
        """Execute create patient command."""
        db_session = context["db_session"]
        tenant_id = context["tenant_id"]
        patient = Patient(
            tenant_id=tenant_id, patient_id=input_data.patient_id,
            full_name_enc=f"ENC:{input_data.full_name}", date_of_birth_enc=f"ENC:{input_data.date_of_birth}",
            gender=input_data.gender, phone_enc=f"ENC:{input_data.phone}", address_enc=f"ENC:{input_data.address}",
            status=PatientStatus.ACTIVE,
        )
        db_session.add(patient)
        db_session.commit()
        return CreatePatientOutput(patient_id=patient.patient_id, status=patient.status.value, created_at=patient.created_at)