"""
Lab Workflow (DP10)

Order → Collect → Test → Report.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import Any, Dict, List

class LabState(str, Enum):
    ORDERED = "ordered"
    COLLECTED = "collected"
    TESTING = "testing"
    COMPLETED = "completed"
    CANCELLED = "cancelled"

class LabEvent(str, Enum):
    COLLECT = "collect"
    TEST = "test"
    REPORT = "report"
    CANCEL = "cancel"

@dataclass
class LabWorkflow:
    """Quy trình xét nghiệm: Order → Collect → Test → Report."""
    workflow_id: str
    tenant_id: str
    order_id: str
    current_state: LabState = LabState.ORDERED
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.utcnow)

    def transition(self, event: LabEvent) -> LabState:
        transitions = {
            (LabState.ORDERED, LabEvent.COLLECT): LabState.COLLECTED,
            (LabState.COLLECTED, LabEvent.TEST): LabState.TESTING,
            (LabState.TESTING, LabEvent.REPORT): LabState.COMPLETED,
        }
        for state in LabState:
            transitions[(state, LabEvent.CANCEL)] = LabState.CANCELLED
        new_state = transitions.get((self.current_state, event))
        if not new_state:
            raise ValueError(f"Không thể transition {self.current_state.value} với {event.value}")
        self.history.append({"from": self.current_state.value, "to": new_state.value, "event": event.value})
        self.current_state = new_state
        return new_state

    @property
    def is_completed(self) -> bool:
        return self.current_state in (LabState.COMPLETED, LabState.CANCELLED)