"""
Insurance Policy, Claim, Underwriting, Premium, Beneficiary Entities (DP14)

Hợp đồng bảo hiểm, bồi thường, thẩm định rủi ro, phí, người thụ hưởng.
"""

from __future__ import annotations

from datetime import datetime
from decimal import Decimal
from enum import Enum

from sqlalchemy import Column, Date, DateTime, Enum as SQLAlchemyEnum, Index, Numeric, String, Text

from ....db.base_model import Base
from ....db.tenant_mixin import TenantRowMixin


class PolicyStatus(str, Enum):
    DRAFT = "draft"
    UNDERWRITING = "underwriting"
    ACTIVE = "active"
    EXPIRED = "expired"
    CANCELLED = "cancelled"


class Policy(Base, TenantRowMixin):
    __tablename__ = "insurance_policies"
    policy_id = Column(String(50), nullable=False, unique=True)
    policy_type = Column(String(50), nullable=False)
    insured_name = Column(String(500), nullable=False)
    coverage_amount = Column(Numeric(19, 2), nullable=False)
    premium_amount = Column(Numeric(19, 2), nullable=False)
    start_date = Column(Date, nullable=False)
    end_date = Column(Date, nullable=False)
    status = Column(SQLAlchemyEnum(PolicyStatus), nullable=False, default=PolicyStatus.DRAFT)
    terms = Column(Text, nullable=True)
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    __table_args__ = (Index("idx_policy_id", "policy_id"), Index("idx_policy_status", "status"),)


class InsuranceClaim(Base, TenantRowMixin):
    __tablename__ = "insurance_claims"
    claim_id = Column(String(50), nullable=False, unique=True)
    policy_id = Column(String(50), nullable=False)
    claimant_name = Column(String(500), nullable=False)
    incident_date = Column(Date, nullable=False)
    claimed_amount = Column(Numeric(19, 2), nullable=False)
    assessed_amount = Column(Numeric(19, 2), nullable=True)
    status = Column(String(20), nullable=False, default="submitted")
    description = Column(Text, nullable=True)
    submitted_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    __table_args__ = (Index("idx_iclaim_policy", "policy_id"),)


class Underwriting(Base, TenantRowMixin):
    __tablename__ = "insurance_underwriting"
    underwriting_id = Column(String(50), nullable=False, unique=True)
    policy_id = Column(String(50), nullable=False)
    risk_assessment = Column(Text, nullable=True)
    decision = Column(String(20), nullable=False, default="pending")
    underwriter_id = Column(String(50), nullable=True)
    decided_at = Column(DateTime, nullable=True)
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)


class PremiumPayment(Base, TenantRowMixin):
    __tablename__ = "insurance_premium_payments"
    payment_id = Column(String(50), nullable=False, unique=True)
    policy_id = Column(String(50), nullable=False)
    amount = Column(Numeric(19, 2), nullable=False)
    payment_date = Column(Date, nullable=False)
    status = Column(String(20), nullable=False, default="pending")
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)


class Beneficiary(Base, TenantRowMixin):
    __tablename__ = "insurance_beneficiaries"
    beneficiary_id = Column(String(50), nullable=False, unique=True)
    policy_id = Column(String(50), nullable=False)
    name = Column(String(500), nullable=False)
    relationship = Column(String(100), nullable=True)
    share_percentage = Column(Numeric(5, 2), nullable=False, default=Decimal("100.00"))
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)