"""
Policy Issuance Workflow (DP14)

Application → Underwriting → Issue.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import Any, Dict, List

class PolicyIssuanceState(str, Enum):
    APPLICATION = "application"
    UNDERWRITING = "underwriting"
    ISSUED = "issued"
    REJECTED = "rejected"

class PolicyIssuanceEvent(str, Enum):
    UNDERWRITE = "underwrite"
    APPROVE = "approve"
    REJECT = "reject"
    ISSUE = "issue"

@dataclass
class PolicyIssuanceWorkflow:
    """Quy trình cấp hợp đồng: Application → Underwriting → Issue."""
    workflow_id: str
    tenant_id: str
    policy_id: str
    current_state: PolicyIssuanceState = PolicyIssuanceState.APPLICATION
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.utcnow)

    def transition(self, event: PolicyIssuanceEvent) -> PolicyIssuanceState:
        transitions = {
            (PolicyIssuanceState.APPLICATION, PolicyIssuanceEvent.UNDERWRITE): PolicyIssuanceState.UNDERWRITING,
            (PolicyIssuanceState.UNDERWRITING, PolicyIssuanceEvent.APPROVE): PolicyIssuanceState.UNDERWRITING,
            (PolicyIssuanceState.UNDERWRITING, PolicyIssuanceEvent.REJECT): PolicyIssuanceState.REJECTED,
            (PolicyIssuanceState.UNDERWRITING, PolicyIssuanceEvent.ISSUE): PolicyIssuanceState.ISSUED,
        }
        new_state = transitions.get((self.current_state, event))
        if not new_state:
            raise ValueError(f"Không thể transition {self.current_state.value} với {event.value}")
        self.history.append({"from": self.current_state.value, "to": new_state.value, "event": event.value})
        self.current_state = new_state
        return new_state

    @property
    def is_completed(self) -> bool:
        return self.current_state in (PolicyIssuanceState.ISSUED, PolicyIssuanceState.REJECTED)


@dataclass
class PolicyRenewalState(str, Enum):
    EXPIRY_CHECK = "expiry_check"
    RE_UNDERWRITE = "re_underwrite"
    RENEWED = "renewed"
    EXPIRED = "expired"

class PolicyRenewalEvent(str, Enum):
    RE_UNDERWRITE = "re_underwrite"
    RENEW = "renew"
    EXPIRE = "expire"

@dataclass
class PolicyRenewalWorkflow:
    """Quy trình gia hạn: Expiry Check → Re-underwrite → Renew."""
    workflow_id: str
    tenant_id: str
    policy_id: str
    current_state: PolicyRenewalState = PolicyRenewalState.EXPIRY_CHECK
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.utcnow)

    def transition(self, event: PolicyRenewalEvent) -> PolicyRenewalState:
        transitions = {
            (PolicyRenewalState.EXPIRY_CHECK, PolicyRenewalEvent.RE_UNDERWRITE): PolicyRenewalState.RE_UNDERWRITE,
            (PolicyRenewalState.RE_UNDERWRITE, PolicyRenewalEvent.RENEW): PolicyRenewalState.RENEWED,
            (PolicyRenewalState.RE_UNDERWRITE, PolicyRenewalEvent.EXPIRE): PolicyRenewalState.EXPIRED,
        }
        new_state = transitions.get((self.current_state, event))
        if not new_state:
            raise ValueError(f"Không thể transition {self.current_state.value} với {event.value}")
        self.history.append({"from": self.current_state.value, "to": new_state.value, "event": event.value})
        self.current_state = new_state
        return new_state

    @property
    def is_completed(self) -> bool:
        return self.current_state in (PolicyRenewalState.RENEWED, PolicyRenewalState.EXPIRED)