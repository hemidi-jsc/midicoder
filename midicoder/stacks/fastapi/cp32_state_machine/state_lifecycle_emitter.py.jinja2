    def add_handler(
        self,
        event_pattern: str,
        handler: EventHandler,
    ) -> None:
        """Thêm event handler cho một pattern.

        Args:
            event_pattern: Pattern event (e.g. "order.state_entered").
            handler: Handler callback.
        """
        if event_pattern not in self._handlers:
            self._handlers[event_pattern] = []
        self._handlers[event_pattern].append(handler)

    def emit(self, event: LifecycleEvent) -> None:
        """Emit một lifecycle event.

        Args:
            event: LifecycleEvent.
        """
        # Match pattern: entity_type.event_type
        pattern = f"{event.entity_type}.{event.event_type}"
        handlers = self._handlers.get(pattern, [])
        for fn in handlers:
            fn(event)

        # Also emit to wildcard pattern
        wildcard_handlers = self._handlers.get("*", [])
        for fn in wildcard_handlers:
            fn(event)

    def emit_on_transition(
        self,
        entity_id: str,
        entity_type: str,
        machine_id: str,
        from_state: Optional[str],
        to_state: str,
        user_id: Optional[str] = None,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> None:
        """Emit events cho một transition.

        Args:
            entity_id: ID của entity.
            entity_type: Entity type.
            machine_id: ID state machine.
            from_state: State trước.
            to_state: State sau.
            user_id: ID người thực hiện.
            metadata: Metadata bổ sung.
        """
        # Emit state_exited
        if from_state:
            exit_event = LifecycleEvent(
                event_type="state_exited",
                entity_id=entity_id,
                entity_type=entity_type,
                machine_id=machine_id,
                from_state=from_state,
                to_state=to_state,
                user_id=user_id,
                metadata=metadata or {},
            )
            self.emit(exit_event)

        # Emit state_entered
        enter_event = LifecycleEvent(
            event_type="state_entered",
            entity_id=entity_id,
            entity_type=entity_type,
            machine_id=machine_id,
            from_state=from_state,
            to_state=to_state,
            user_id=user_id,
            metadata=metadata or {},
        )
        self.emit(enter_event)

        # Emit transition_completed
        complete_event = LifecycleEvent(
            event_type="transition_completed",
            entity_id=entity_id,
            entity_type=entity_type,
            machine_id=machine_id,
            from_state=from_state,
            to_state=to_state,
            user_id=user_id,
            metadata=metadata or {},
        )
        self.emit(complete_event)

    def auto_register(self) -> None:
        """Tự động đăng ký handlers được generate."""
