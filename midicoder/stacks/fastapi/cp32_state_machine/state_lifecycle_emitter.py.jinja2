"""
Mô-đun State Lifecycle Emitter — emit lifecycle events.

Tự động tạo bởi Midicoder CE — không chỉnh sửa thủ công.

Kết hợp với CP05 (Event Bus) để emit events khi entity
thay đổi trạng thái.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from typing import Any, Callable, Dict, List, Optional
from uuid import uuid4


@dataclass
class LifecycleEvent:
    """Lifecycle event cho state transition.

    Attributes:
        event_id: ID duy nhất của event.
        event_type: Loại event (state_entered, state_exited, transition_completed).
        entity_id: ID của entity.
        entity_type: Entity type.
        machine_id: ID state machine.
        from_state: State trước (null cho initial).
        to_state: State sau.
        user_id: ID người thực hiện.
        timestamp: Thời gian xảy ra.
        metadata: Metadata bổ sung.
    """

    event_id: str = field(default_factory=lambda: str(uuid4()))
    event_type: str = ""
    entity_id: str = ""
    entity_type: str = ""
    machine_id: str = ""
    from_state: Optional[str] = None
    to_state: str = ""
    user_id: Optional[str] = None
    timestamp: str = field(default_factory=lambda: datetime.utcnow().isoformat())
    metadata: Dict[str, Any] = field(default_factory=dict)


# Event handler callback type
EventHandler = Callable[[LifecycleEvent], None]


class StateLifecycleEmitter:
    """Emit lifecycle events khi entity thay đổi trạng thái.

    Các event types:
    - state_entered: Entity vừa vào một state mới
    - state_exited: Entity vừa rời một state cũ
    - transition_completed: Transition hoàn tất (guard pass + effect done)
    - instance_created: Instance mới được tạo

    Usage:
        emitter = StateLifecycleEmitter()
        emitter.add_handler("order.state_entered", on_order_state_entered)
        emitter.emit_on_transition(ctx)
    """

    def __init__(self):
        """Khởi tạo emitter."""
        self._handlers: Dict[str, List[EventHandler]] = {}

