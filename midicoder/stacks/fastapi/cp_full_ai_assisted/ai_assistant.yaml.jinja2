# Cấu hình AI Assistant cho {{ project_name }}
# Tự động sinh bởi Midicoder CE — CP30

ai_assistant:
  # Kích hoạt AI assistant
  enabled: true

  # Cấu hình LLM (user tự điền provider-specific config)
  default_model: "${AI_MODEL:gpt-4}"
  max_tokens: 4096
  temperature: 0.7
  timeout_seconds: 30

  # API key qua environment variable
  api_key_env: "${AI_API_KEY:}"

  # Cấu hình review policies
  review:
    enabled_policies:
      - policy_hardcoded_secret
      - policy_sql_injection
      - policy_performance_anti_pattern
      - policy_type_safety

  # Cấu hình suggestions
  suggestions:
    enabled: true
    min_confidence: 0.5

  # Đường dẫn prompt templates
  prompt_templates_path: "ai_assistant/templates/"
