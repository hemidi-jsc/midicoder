class ImportJobCreate(BaseModel):
    """
    Schema cho tạo import job mới.

    Dùng khi client gửi yêu cầu tạo job nhập liệu.

    Attributes:
        filename: Tên file cần nhập
        file_format: Định dạng file (csv, json)
        target_table: Bảng đích trong database (optional)
        created_by: Người tạo job (optional)
        chunk_size: Số hàng mỗi chunk (default 1000)
        continue_on_error: Tiếp tục khi gặp lỗi (default True)
    """

    filename: str = Field(
        ...,
        min_length=1,
        max_length=512,
        description="Tên file cần nhập liệu",
        examples=["data.csv", "records.json"],
    )
    file_format: FileFormatEnum = Field(
        ...,
        description="Định dạng file: csv hoặc json",
    )
    target_table: Optional[str] = Field(
        None,
        max_length=256,
        description="Tên bảng đích trong database",
    )
    created_by: Optional[str] = Field(
        None,
        max_length=256,
        description="User hoặc tenant tạo job",
    )
    chunk_size: int = Field(
        1000,
        ge=100,
        le=50000,
        description="Số hàng xử lý mỗi chunk",
    )
    continue_on_error: bool = Field(
        True,
        description="Có tiếp tục xử lý khi gặp lỗi hàng không",
    )

    @field_validator("filename")
    @classmethod
    def validate_filename(cls, v: str) -> str:
        """Validate tên file có phần mở rộng hợp lệ."""
        if "." not in v:
            raise ValueError(f"Tên file '{v}' không có phần mở rộng hợp lệ")
        ext = v.rsplit(".", 1)[-1].lower()
        allowed_extensions = [e.value for e in FileFormatEnum]
        if ext not in allowed_extensions:
            raise ValueError(
                f"Phần mở rộng '.{ext}' không được hỗ trợ. "
                f"Hãy dùng: {', '.join('.' + e for e in allowed_extensions)}"
            )
        return v


class ImportJobRead(BaseModel):
    """
    Schema cho đọc import job.

    Trả về thông tin đầy đủ của một import job.

    Attributes:
        job_key: Khóa duy nhất của job
        filename: Tên file
        file_format: Định dạng
        status: Trạng thái hiện tại
        total_rows: Tổng số hàng
        processed_rows: Số hàng đã xử lý
        error_count: Số hàng có lỗi
        file_size_bytes: Kích thước file
        target_table: Bảng đích
        created_by: Người tạo
        error_message: Thông báo lỗi (nếu có)
        progress_percentage: Phần trăm tiến trình
        started_at: Thời điểm bắt đầu
        completed_at: Thời điểm hoàn thành
        created_at: Thời điểm tạo
        updated_at: Thời điểm cập nhật
    """

    job_key: UUID = Field(..., description="Khóa duy nhất của import job")
    filename: str = Field(..., description="Tên file gốc")
    file_format: str = Field(..., description="Định dạng file")
    status: str = Field(..., description="Trạng thái job")
    total_rows: Optional[int] = Field(None, description="Tổng số hàng trong file")
    processed_rows: int = Field(..., description="Số hàng đã xử lý thành công")
    error_count: int = Field(..., description="Số hàng có lỗi")
    file_size_bytes: Optional[int] = Field(None, description="Kích thước file (byte)")
    target_table: Optional[str] = Field(None, description="Bảng đích")
    created_by: Optional[str] = Field(None, description="Người tạo job")
    error_message: Optional[str] = Field(None, description="Thông báo lỗi nếu thất bại")
    progress_percentage: float = Field(..., description="Phần trăm tiến trình (0-100)")
    started_at: Optional[datetime] = Field(None, description="Thời điểm bắt đầu")
    completed_at: Optional[datetime] = Field(None, description="Thời điểm hoàn thành")
    created_at: datetime = Field(..., description="Thời điểm tạo job")
    updated_at: datetime = Field(..., description="Thời điểm cập nhật cuối")

    model_config = {
        "from_attributes": True,
    }


