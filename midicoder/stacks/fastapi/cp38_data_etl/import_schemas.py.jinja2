    Schema cho tạo ETL mapping.

    Dùng để định nghĩa ánh xạ trường trong ETL pipeline.

    Attributes:
        source_field: Tên trường nguồn
        target_field: Tên trường đích
        transform_type: Loại transform (optional)
        transform_config: Cấu hình transform (optional)
        is_required: Có bắt buộc không
        default_value: Giá trị mặc định (optional)
    """

    source_field: str = Field(
        ...,
        min_length=1,
        max_length=256,
        description="Tên trường ở nguồn dữ liệu",
    )
    target_field: str = Field(
        ...,
        min_length=1,
        max_length=256,
        description="Tên trường ở bảng đích",
    )
    transform_type: Optional[str] = Field(
        None,
        description="Loại transform: map, filter, aggregate, convert, rename",
    )
    transform_config: Optional[Dict[str, Any]] = Field(
        None,
        description="Cấu hình chi tiết cho transform",
    )
    is_required: bool = Field(
        False,
        description="Trường có bắt buộc có giá trị không",
    )
    default_value: Optional[str] = Field(
        None,
        description="Giá trị mặc định nếu trường nguồn trống",
    )


class ETLJobCreate(BaseModel):
    """
    Schema cho tạo ETL job mới.

    Dùng khi client gửi yêu cầu chạy ETL pipeline.

    Attributes:
        pipeline_name: Tên pipeline
        source_type: Nguồn dữ liệu (file, database, api)
        source_config: Cấu hình nguồn (JSON)
        transform_steps: Các bước transform (JSON list)
        mappings: Danh sách ánh xạ trường
        target_table: Bảng đích
        load_mode: Chế độ load (default: insert)
        rollback_enabled: Có rollback không (default: True)
        created_by: Người tạo (optional)
    """

    pipeline_name: str = Field(
        ...,
        min_length=1,
        max_length=256,
        description="Tên của ETL pipeline",
        examples=["import_customers", "sync_products"],
    )
    source_type: ExtractSourceEnum = Field(
        ...,
        description="Loại nguồn dữ liệu: file, database, api",
    )
    source_config: Dict[str, Any] = Field(
        ...,
        description="Cấu hình chi tiết cho nguồn dữ liệu",
        examples=[{"path": "/data/input.csv", "delimiter": ","}],
    )
    transform_steps: Optional[List[Dict[str, Any]]] = Field(
        None,
        description="Danh sách các bước transform",
        examples=[[{"type": "map", "config": {"source": "name", "target": "full_name"}}]],
    )
    mappings: Optional[List[ETLMappingCreate]] = Field(
        None,
        description="Danh sách ánh xạ trường nguồn sang đích",
    )
    target_table: str = Field(
        ...,
        min_length=1,
        max_length=256,
        description="Tên bảng đích trong database",
    )
    load_mode: LoadModeEnum = Field(
        LoadModeEnum.insert,
        description="Chế độ load: insert, update, upsert, delete",
    )
    rollback_enabled: bool = Field(
        True,
        description="Có rollback nếu pipeline thất bại",
    )
    created_by: Optional[str] = Field(
        None,
        max_length=256,
        description="User hoặc tenant tạo job",
    )


