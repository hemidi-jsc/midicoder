class ExportJobCreate(BaseModel):
    """
    Schema cho tạo export job mới.

    Dùng khi client gửi yêu cầu xuất dữ liệu.

    Attributes:
        output_filename: Tên file đầu ra
        file_format: Định dạng xuất (csv, json)
        query_filter: Bộ lọc query (JSON object, optional)
        columns: Danh sách cột cần xuất (optional)
        page_size: Số hàng mỗi trang (default 1000)
        created_by: Người tạo job (optional)
    """

    output_filename: str = Field(
        ...,
        min_length=1,
        max_length=512,
        description="Tên file sẽ xuất ra",
        examples=["export_data.csv", "report.json"],
    )
    file_format: FileFormatEnum = Field(
        ...,
        description="Định dạng file xuất: csv hoặc json",
    )
    query_filter: Optional[Dict[str, Any]] = Field(
        None,
        description="Bộ lọc query dưới dạng JSON object",
        examples=[{"status": "active", "created_after": "2024-01-01"}],
    )
    columns: Optional[List[str]] = Field(
        None,
        description="Danh sách các cột cần xuất",
        examples=[["id", "name", "email", "created_at"]],
    )
    page_size: int = Field(
        1000,
        ge=100,
        le=10000,
        description="Số hàng mỗi trang cho phân trang",
    )
    created_by: Optional[str] = Field(
        None,
        max_length=256,
        description="User hoặc tenant tạo job",
    )

    @field_validator("output_filename")
    @classmethod
    def validate_output_filename(cls, v: str) -> str:
        """Validate tên file đầu ra có phần mở rộng hợp lệ."""
        if "." not in v:
            raise ValueError(f"Tên file '{v}' không có phần mở rộng hợp lệ")
        ext = v.rsplit(".", 1)[-1].lower()
        allowed = [e.value for e in FileFormatEnum]
        if ext not in allowed:
            raise ValueError(
                f"Phần mở rộng '.{ext}' không được hỗ trợ. "
                f"Hãy dùng: {', '.join('.' + e for e in allowed)}"
            )
        return v


