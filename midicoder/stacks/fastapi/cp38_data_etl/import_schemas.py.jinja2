    Attributes:
        items: Danh sách job items
        total: Tổng số jobs
        page: Trang hiện tại
        page_size: Số items mỗi trang
        total_pages: Tổng số trang
    """

    items: List[Any] = Field(..., description="Danh sách job items")
    total: int = Field(..., description="Tổng số jobs")
    page: int = Field(..., description="Trang hiện tại")
    page_size: int = Field(..., description="Số items mỗi trang")
    total_pages: int = Field(..., description="Tổng số trang")


