class BulkConfigResponse(BaseModel):
    """
    Schema cho phản hồi bulk config.

    Attributes:
        id: Khóa chính
        config_name: Tên cấu hình
        chunk_size: Số hàng mỗi chunk
        max_retries: Số lần retry tối đa
        retry_delay_seconds: Thời gian delay giữa retry
        timeout_seconds: Timeout mỗi chunk
        parallel_workers: Số worker song song
        batch_commit_size: Số bản ghi mỗi commit
        continue_on_error: Tiếp tục khi lỗi
        max_error_rate: Tỷ lệ lỗi tối đa
        is_active: Có active không
    """

    id: int = Field(..., description="Khóa chính")
    config_name: str = Field(..., description="Tên cấu hình")
    chunk_size: int = Field(..., description="Số hàng mỗi chunk")
    max_retries: int = Field(..., description="Số lần retry tối đa")
    retry_delay_seconds: float = Field(..., description="Delay giữa retry (giây)")
    timeout_seconds: int = Field(..., description="Timeout mỗi chunk (giây)")
    parallel_workers: int = Field(..., description="Số worker song song")
    batch_commit_size: int = Field(..., description="Số bản ghi mỗi commit")
    continue_on_error: bool = Field(..., description="Tiếp tục khi lỗi")
    max_error_rate: float = Field(..., description="Tỷ lệ lỗi tối đa (0-1)")
    is_active: bool = Field(..., description="Có đang active không")
