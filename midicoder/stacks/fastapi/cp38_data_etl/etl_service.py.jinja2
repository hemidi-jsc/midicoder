    def _apply_transform(
        self,
        records: List[Dict[str, Any]],
        transform_type: str,
        config: Dict[str, Any],
    ) -> List[Dict[str, Any]]:
        """
        Apply một bước transform vào danh sách records.

        Args:
            records: Danh sách records
            transform_type: Loại transform
            config: Config cho transform

        Returns:
            Records sau khi transform

        Raises:
            TransformError: Nếu transform type không hợp lệ
        """
        transform_map = {
            "map": self.transform_map,
            "filter": self.transform_filter,
            "aggregate": self.transform_aggregate,
            "convert": self.transform_convert,
            "rename": self.transform_rename,
        }

        # Kiểm tra custom transform từ registry
        if transform_type in TRANSFORM_REGISTRY:
            transform_fn = TRANSFORM_REGISTRY[transform_type]
            return transform_fn(records, config)

        transform_fn = transform_map.get(transform_type)
        if not transform_fn:
            raise TransformError(
                f"Transform type '{transform_type}' không được hỗ trợ. "
                f"Hãy chọn trong: {', '.join(transform_map.keys())} hoặc custom transform"
            )

        return transform_fn(records, config)

    def _apply_mappings(
        self,
        records: List[Dict[str, Any]],
        mappings: List[ETLMapping],
    ) -> List[Dict[str, Any]]:
        """
        Apply ETL mappings — ánh xạ và validate các trường.

        Args:
            records: Danh sách records
            mappings: Danh sách ETLMapping

        Returns:
            Records đã apply mappings
        """
        result = []
        for record in records:
            new_record = {}
            for mapping in mappings:
                source_value = record.get(mapping.source_field)

                # Kiểm tra required field
                if mapping.is_required and source_value is None:
                    if mapping.default_value is not None:
                        source_value = mapping.default_value
                    else:
                        logger.warning(
                            "Required field '%s' không có giá trị trong record row",
                            mapping.source_field,
                        )

                # Apply transform nếu có
                if mapping.transform_type and source_value is not None:
                    try:
                        source_value = self._convert_value(
                            source_value,
                            mapping.transform_config.get("type", "str") if mapping.transform_config else "str",
                        )
                    except (ValueError, TypeError):
                        pass  # Giữ nguyên nếu convert lỗi

                new_record[mapping.target_field] = source_value

            # Giữ các trường không có mapping
            mapped_sources = {m.source_field for m in mappings}
            for key, value in record.items():
                if key not in mapped_sources:
                    new_record[key] = value

            result.append(new_record)

        return result

    async def _load(
        self,
        job: ETLJob,
        records: List[Dict[str, Any]],
    ) -> Dict[str, int]:
        """
        Load dữ liệu vào bảng đích.

        Hỗ trợ các chế độ: insert, update, upsert, delete.

        Args:
            job: ETL job với target_table và load_mode
            records: Danh sách records cần load

        Returns:
            Dictionary với success_count và error_count
        """
        success_count = 0
        error_count = 0

        if not records:
            return {"success_count": 0, "error_count": 0}

        if job.load_mode == LoadMode.insert.value:
            return await self._load_insert(job.target_table, records)
        elif job.load_mode == LoadMode.update.value:
            return await self._load_update(job.target_table, records)
        elif job.load_mode == LoadMode.upsert.value:
            return await self._load_upsert(job.target_table, records)
        elif job.load_mode == LoadMode.delete.value:
            return await self._load_delete(job.target_table, records)
        else:
            raise LoadError(f"Load mode '{job.load_mode}' không được hỗ trợ")

    async def _load_insert(
        self,
        table: str,
        records: List[Dict[str, Any]],
    ) -> Dict[str, int]:
        """Chế độ insert — chèn mới các bản ghi."""
        success = 0
        errors = 0

        for record in records:
            try:
                columns = list(record.keys())
                col_names = ", ".join(columns)
                placeholders = ", ".join(f":{col}" for col in columns)
                sql = text(f"INSERT INTO {table} ({col_names}) VALUES ({placeholders})")
                await self.db.execute(sql, record)
                success += 1
            except Exception as e:
                errors += 1
                logger.warning("Insert lỗi: %s", str(e))

        return {"success_count": success, "error_count": errors}

    async def _load_update(
        self,
        table: str,
        records: List[Dict[str, Any]],
    ) -> Dict[str, int]:
        """Chế độ update — cập nhật bản ghi theo primary key (id)."""
        success = 0
        errors = 0

        for record in records:
            try:
                # Lấy key (default là "id")
                key_value = record.get("id")
                if key_value is None:
                    errors += 1
                    continue

                # Build SET clause (không bao gồm key)
                set_fields = {k: v for k, v in record.items() if k != "id"}
                if not set_fields:
                    continue

                set_clause = ", ".join(f"{k} = :{k}" for k in set_fields)
                sql = text(f"UPDATE {table} SET {set_clause} WHERE id = :id")
                await self.db.execute(sql, record)
                success += 1
            except Exception as e:
                errors += 1
                logger.warning("Update lỗi: %s", str(e))

        return {"success_count": success, "error_count": errors}

    async def _load_upsert(
        self,
        table: str,
        records: List[Dict[str, Any]],
    ) -> Dict[str, int]:
        """
        Chế độ upsert — insert nếu mới, update nếu tồn tại.

        Dùng ON CONFLICT (PostgreSQL) hoặc INSERT ... ON DUPLICATE KEY (MySQL).
        Hiện tại dùng approach: thử insert, nếu lỗi duplicate thì update.
        """
        success = 0
        errors = 0

        for record in records:
            try:
                # Thử insert
                columns = list(record.keys())
                col_names = ", ".join(columns)
                placeholders = ", ".join(f":{col}" for col in columns)
                sql = text(f"INSERT INTO {table} ({col_names}) VALUES ({placeholders})")

                try:
                    await self.db.execute(sql, record)
                    success += 1
                except Exception:
                    # Nếu insert lỗi (duplicate key), thử update
                    key_value = record.get("id")
                    if key_value:
                        set_fields = {k: v for k, v in record.items() if k != "id"}
                        if set_fields:
                            set_clause = ", ".join(f"{k} = :{k}" for k in set_fields)
                            update_sql = text(f"UPDATE {table} SET {set_clause} WHERE id = :id")
                            await self.db.execute(update_sql, record)
                    success += 1
            except Exception as e:
                errors += 1
                logger.warning("Upsert lỗi: %s", str(e))

        return {"success_count": success, "error_count": errors}

    async def _load_delete(
        self,
        table: str,
        records: List[Dict[str, Any]],
    ) -> Dict[str, int]:
        """Chế độ delete — xóa các bản ghi theo primary key."""
        success = 0
        errors = 0

        for record in records:
            try:
                key_value = record.get("id")
                if key_value is None:
                    errors += 1
                    continue

                sql = text(f"DELETE FROM {table} WHERE id = :id")
                await self.db.execute(sql, {"id": key_value})
                success += 1
            except Exception as e:
                errors += 1
                logger.warning("Delete lỗi: %s", str(e))

        return {"success_count": success, "error_count": errors}

    async def _capture_state_for_rollback(
        self,
        job: ETLJob,
    ) -> List[Dict[str, Any]]:
        """
        Lưu trạng thái hiện tại của bảng đích để rollback sau này.

        Args:
            job: ETL job

        Returns:
            Danh sách records hiện tại trong bảng đích
        """
        sql = text(f"SELECT * FROM {job.target_table}")
        try:
            result = await self.db.execute(sql)
            rows = result.fetchall()
            return [dict(r._mapping) if hasattr(r, "_mapping") else dict(zip(result.keys(), r)) for r in rows]
        except Exception as e:
            logger.warning("Không thể capture state cho rollback: %s", str(e))
            return []

    # ========================================================================
    # Helper: Filter matching
    # ========================================================================

    def _matches_filter(
        self,
        record: Dict[str, Any],
        config: Dict[str, Any],
    ) -> bool:
        """
        Kiểm tra record có khớp với filter config không.

        Args:
            record: Bản ghi cần kiểm tra
            config: Config filter

        Returns:
            True nếu record khớp tất cả điều kiện
        """
        for field, condition in config.items():
            value = record.get(field)

            if isinstance(condition, dict):
                # Format: {"op": "gt", "value": 18}
                op = condition.get("op", "eq")
                cmp_value = condition.get("value")
                if not self._compare(value, op, cmp_value):
                    return False
            else:
                # Format: {"field": "value"} => eq
                if value != condition:
                    return False

        return True

    def _compare(self, value: Any, op: str, cmp_value: Any) -> bool:
        """So sánh giá trị theo operator."""
        try:
            if op == "eq":
                return value == cmp_value
            elif op == "ne":
                return value != cmp_value
            elif op == "gt":
                return value > cmp_value
            elif op == "lt":
                return value < cmp_value
            elif op == "gte":
                return value >= cmp_value
            elif op == "lte":
                return value <= cmp_value
            elif op == "contains":
                return cmp_value in str(value)
            elif op == "in":
                return value in cmp_value
            else:
                return value == cmp_value
        except (TypeError, ValueError):
            return False

    # ========================================================================
    # Helper: Aggregate functions
    # ========================================================================

    def _compute_aggregation(
        self,
        values: List[Any],
        func_name: str,
    ) -> Any:
        """Tính aggregation function trên danh sách values."""
        if not values:
            return 0

        numeric_values = [v for v in values if isinstance(v, (int, float))]

        if func_name == "sum":
            return sum(numeric_values) if numeric_values else 0
        elif func_name == "avg":
            return sum(numeric_values) / len(numeric_values) if numeric_values else 0
        elif func_name == "count":
            return len(values)
        elif func_name == "min":
            return min(numeric_values) if numeric_values else None
        elif func_name == "max":
            return max(numeric_values) if numeric_values else None
        elif func_name == "first":
            return values[0]
        elif func_name == "last":
            return values[-1]
        else:
            return sum(numeric_values)  # Default: sum

    # ========================================================================
    # Helper: Convert value
    # ========================================================================

    def _convert_value(self, value: Any, target_type: str) -> Any:
        """
        Chuyển đổi kiểu dữ liệu của giá trị.

        Args:
            value: Giá trị cần convert
            target_type: Kiểu đích (int, float, str, bool, upper, lower, strip, datetime)

        Returns:
            Giá trị đã convert
        """
        if target_type == "int":
            return int(value)
        elif target_type == "float":
            return float(value)
        elif target_type == "str":
            return str(value)
        elif target_type == "bool":
            if isinstance(value, str):
                return value.lower() in ("true", "1", "yes", "on")
            return bool(value)
        elif target_type == "upper":
            return str(value).upper()
        elif target_type == "lower":
            return str(value).lower()
        elif target_type == "strip":
            return str(value).strip()
        elif target_type == "datetime":
            if isinstance(value, str):
                return datetime.fromisoformat(value.replace("Z", "+00:00"))
            return value
        else:
            return value

    # ========================================================================
    # List ETL jobs
    # ========================================================================

    async def list_etl_jobs(
        self,
        status: Optional[str] = None,
        page: int = 1,
        page_size: int = 20,
    ) -> Dict[str, Any]:
        """
        Lấy danh sách ETL jobs với filter và pagination.

        Args:
            status: Filter theo trạng thái (optional)
            page: Số trang
            page_size: Số jobs mỗi trang

        Returns:
            Dictionary với jobs và pagination
        """
        stmt = select(ETLJob)

        if status:
            stmt = stmt.where(ETLJob.status == status)

        stmt = stmt.order_by(ETLJob.created_at.desc())

        # Count
        count_stmt = select(func.count()).select_from(ETLJob)
        if status:
            count_stmt = count_stmt.where(ETLJob.status == status)
        count_result = await self.db.execute(count_stmt)
        total = count_result.scalar() or 0

        # Pagination
        offset = (page - 1) * page_size
        stmt = stmt.offset(offset).limit(page_size)

        result = await self.db.execute(stmt)
        jobs = list(result.scalars().all())

        return {
            "items": [j.to_dict() for j in jobs],
            "total": total,
            "page": page,
            "page_size": page_size,
            "total_pages": (total + page_size - 1) // page_size if page_size > 0 else 0,
        }

    async def get_etl_status(self, job_key: str) -> Dict[str, Any]:
        """
        Lấy trạng thái của ETL job.

        Args:
            job_key: Khóa ETL job

        Returns:
            Dictionary với thông tin job

        Raises:
            JobNotFoundError: Nếu job không tồn tại
        """
        job = await self._get_job_by_key(job_key)
        if not job:
            raise JobNotFoundError(job_key)

        return {
            "job_key": job.job_key,
            "job_type": "etl",
            "pipeline_name": job.pipeline_name,
            "source_type": job.source_type,
            "target_table": job.target_table,
            "load_mode": job.load_mode,
            "status": job.status,
            "current_step": job.current_step,
            "total_records": job.total_records,
            "processed_records": job.processed_records,
            "error_count": job.error_count,
            "progress_percentage": job.progress_percentage(),
            "is_terminal": job.is_terminal(),
            "error_message": job.error_message,
            "started_at": job.started_at.isoformat() if job.started_at else None,
            "completed_at": job.completed_at.isoformat() if job.completed_at else None,
            "created_at": job.created_at.isoformat(),
        }
