# ============================================================================
# Exception: ETLServiceError
# ============================================================================

class ETLServiceError(Exception):
    """Exception base cho ETLService."""

    def __init__(self, message: str, error_code: str = "ETL_ERROR") -> None:
        self.message = message
        self.error_code = error_code
        super().__init__(self.message)


class JobNotFoundError(ETLServiceError):
    """Lỗi job không tìm thấy."""

    def __init__(self, job_key: str) -> None:
        super().__init__(
            f"ETL job không tìm thấy với key: {job_key}",
            error_code="JOB_NOT_FOUND",
        )


class ExtractError(ETLServiceError):
    """Lỗi khi extract dữ liệu."""

    def __init__(self, message: str) -> None:
        super().__init__(message, error_code="EXTRACT_ERROR")


class TransformError(ETLServiceError):
    """Lỗi khi transform dữ liệu."""

    def __init__(self, message: str) -> None:
        super().__init__(message, error_code="TRANSFORM_ERROR")


class LoadError(ETLServiceError):
    """Lỗi khi load dữ liệu."""

    def __init__(self, message: str) -> None:
        super().__init__(message, error_code="LOAD_ERROR")


# ============================================================================
# Transform Registry
# ============================================================================

# Bản đồ hàm transform — map từ transform type string sang hàm xử lý
TRANSFORM_REGISTRY: Dict[str, Callable] = {}


def register_transform(name: str) -> Callable:
    """
    Decorator để đăng ký hàm transform.

    Usage:
        @register_transform("custom_transform")
        def custom_transform(records, config):
            ...
    """
    def decorator(func: Callable) -> Callable:
        TRANSFORM_REGISTRY[name] = func
        return func
    return decorator


# ============================================================================
# ETLService
# ============================================================================

class ETLService:
    """
    Service chính cho ETL pipeline.

    Quản lý toàn bộ vòng đời của ETL job:
    1. Create: Tạo pipeline với cấu hình source, transforms, target
    2. Extract: Lấy dữ liệu từ nguồn (file, database, api)
    3. Transform: Áp dụng các bước transform (map, filter, aggregate, convert, rename)
    4. Load: Ghi dữ liệu vào bảng đích (insert, update, upsert, delete)
    5. Rollback: Hoàn tác nếu pipeline thất bại

    Flow ETL:
        ┌──────────┐     ┌──────────────┐     ┌──────────┐
        │ Extract  │────>│ Transform    │────>│ Load     │
        │ (source) │     │ (pipeline)   │     │ (target) │
        └──────────┘     └──────────────┘     └──────────┘
             │                │                    │
        file/database       map/filter          insert/upsert
        /api               /aggregate          /update/delete
                          /convert
                          /rename

    Usage:
        service = ETLService(db_session)

        # Tạo pipeline
        job = await service.create_etl_pipeline(
            pipeline_name="import_products",
            source_type="file",
            source_config={"path": "/data/products.csv"},
            target_table="products",
            load_mode="upsert",
        )

        # Chạy pipeline
        await service.run_pipeline(job.job_key)
    """

    def __init__(self, db: AsyncSession) -> None:
        """
        Khởi tạo ETLService.

        Args:
            db: AsyncSession cho database
        """
        self.db = db

    async def create_etl_pipeline(
        self,
        pipeline_name: str,
        source_type: str,
        source_config: Dict[str, Any],
        target_table: str,
        load_mode: str = "insert",
        transform_steps: Optional[List[Dict[str, Any]]] = None,
        mappings: Optional[List[Dict[str, Any]]] = None,
        rollback_enabled: bool = True,
        created_by: Optional[str] = None,
    ) -> ETLJob:
        """
        Tạo ETL pipeline mới.

        Pipeline sẽ ở trạng thái pending, chưa thực thi.

        Args:
            pipeline_name: Tên pipeline (duy nhất trong scope)
            source_type: Loại nguồn dữ liệu (file, database, api)
            source_config: Cấu hình chi tiết cho nguồn dữ liệu
            target_table: Tên bảng đích trong database
            load_mode: Chế độ load (insert, update, upsert, delete)
            transform_steps: Danh sách các bước transform (optional)
            mappings: Danh sách ánh xạ trường (optional)
            rollback_enabled: Có rollback nếu thất bại (default True)
            created_by: Người tạo (optional)

        Returns:
            ETLJob mới tạo

        Raises:
            ETLServiceError: Nếu tham số không hợp lệ
        """
        # Validate source_type
        valid_sources = [s.value for s in ["file", "database", "api"]]
        if source_type not in valid_sources:
            raise ETLServiceError(
                f"Source type '{source_type}' không hợp lệ. "
                f"Hãy chọn trong: {', '.join(valid_sources)}",
                error_code="INVALID_SOURCE_TYPE",
            )

        # Validate load_mode
        valid_modes = [m.value for m in LoadMode]
        if load_mode not in valid_modes:
            raise ETLServiceError(
                f"Load mode '{load_mode}' không hợp lệ. "
                f"Hãy chọn trong: {', '.join(valid_modes)}",
                error_code="INVALID_LOAD_MODE",
            )

        # Validate transform_steps
        if transform_steps:
            valid_types = ["map", "filter", "aggregate", "convert", "rename"]
            for step in transform_steps:
                if step.get("type") not in valid_types:
                    raise ETLServiceError(
                        f"Transform type '{step.get('type')}' không hợp lệ. "
                        f"Hãy chọn trong: {', '.join(valid_types)}",
                        error_code="INVALID_TRANSFORM_TYPE",
                    )

        # Tạo ETL job
        job = ETLJob(
            job_key=str(uuid4()),
            pipeline_name=pipeline_name,
            source_type=source_type,
            source_config=source_config,
            transform_steps=transform_steps or [],
            target_table=target_table,
            load_mode=load_mode,
            status=JobStatus.pending.value,
            rollback_enabled=rollback_enabled,
            created_by=created_by,
        )

        self.db.add(job)
        await self.db.flush()

        # Tạo ETL mappings nếu có
        if mappings:
            for mapping_data in mappings:
                mapping = ETLMapping(
                    etl_job_key=job.job_key,
                    source_field=mapping_data["source_field"],
                    target_field=mapping_data["target_field"],
                    transform_type=mapping_data.get("transform_type"),
                    transform_config=mapping_data.get("transform_config"),
                    is_required=mapping_data.get("is_required", False),
                    default_value=mapping_data.get("default_value"),
                )
                self.db.add(mapping)

        await self.db.flush()

        logger.info(
            "Tạo ETL pipeline: job_key=%s, name=%s, source=%s, target=%s",
            job.job_key,
            pipeline_name,
            source_type,
            target_table,
        )

        return job

    async def run_pipeline(self, job_key: str) -> ETLJob:
        """
        Chạy ETL pipeline hoàn chỉnh: Extract → Transform → Load.

        Thực thi từng bước theo thứ tự và cập nhật trạng thái job sau mỗi bước.

        Flow:
        1. Validate job ở trạng thái pending
        2. Update status = running, current_step = extract
        3. Extract dữ liệu từ nguồn
        4. Update current_step = transform
        5. Áp dụng từng bước transform
        6. Update current_step = load
        7. Load dữ liệu vào bảng đích
        8. Cập nhật trạng thái completed hoặc failed

        Nếu rollback_enabled = True và có lỗi ở bước load,
        sẽ gọi rollback để hoàn tác các thay đổi.

        Args:
            job_key: Khóa của ETL job

        Returns:
            ETLJob đã cập nhật trạng thái

        Raises:
            JobNotFoundError: Nếu job không tồn tại
            ETLServiceError: Nếu job đã ở trạng thái cuối
        """
        # Tìm job
        job = await self._get_job_by_key(job_key)
        if not job:
            raise JobNotFoundError(job_key)

        if job.status == JobStatus.running.value:
            raise ETLServiceError(
                f"ETL pipeline đang chạy: {job_key}",
                error_code="PIPELINE_RUNNING",
            )

        if job.is_terminal():
            raise ETLServiceError(
                f"Pipeline đã ở trạng thái '{job.status}'",
                error_code="PIPELINE_TERMINAL",
            )

        # Cập nhật trạng thái
        job.status = JobStatus.running.value
        job.started_at = datetime.utcnow()
        await self.db.flush()

        start_time = time.time()
        records: List[Dict[str, Any]] = []
        saved_state: Optional[List[Dict[str, Any]]] = None

        logger.info("Bắt đầu chạy ETL pipeline: job_key=%s, name=%s", job_key, job.pipeline_name)

        try:
            # =================================================================
            # Bước 1: Extract
            # =================================================================
            job.current_step = "extract"
            await self.db.flush()

            logger.info("Bước Extract: job_key=%s, source=%s", job_key, job.source_type)

            records = await self._extract(job)

            job.total_records = len(records)
            await self.db.flush()

            logger.info("Extract hoàn thành: %d bản ghi", len(records))

            if not records:
                job.status = JobStatus.completed.value
                job.completed_at = datetime.utcnow()
                job.current_step = "done"
                await self.db.flush()
                logger.warning("Pipeline kết thúc: không có dữ liệu từ extract")
                return job

            # =================================================================
            # Bước 2: Transform
            # =================================================================
            job.current_step = "transform"
            await self.db.flush()

            logger.info("Bước Transform: job_key=%s, steps=%d", job_key, len(job.transform_steps or []))

            if job.transform_steps:
                for step_index, step in enumerate(job.transform_steps):
                    step_type = step.get("type")
                    step_config = step.get("config", {})

                    logger.info(
                        "Apply transform step %d/%d: type=%s",
                        step_index + 1,
                        len(job.transform_steps),
                        step_type,
                    )

                    records = self._apply_transform(records, step_type, step_config)

            # Áp dụng mappings (nếu có)
            mappings = await self._get_mappings_for_job(job_key)
            if mappings:
                records = self._apply_mappings(records, mappings)

            job.processed_records = len(records)
            await self.db.flush()

            logger.info("Transform hoàn thành: %d bản ghi sau transform", len(records))

            # =================================================================
            # Bước 3: Load
            # =================================================================
            job.current_step = "load"
            await self.db.flush()

            logger.info("Bước Load: job_key=%s, target=%s, mode=%s", job_key, job.target_table, job.load_mode)

            # Lưu state để rollback nếu cần
            if job.rollback_enabled:
                saved_state = await self._capture_state_for_rollback(job)

            # Load dữ liệu vào target
            load_result = await self._load(job, records)

            job.processed_records = load_result["success_count"]
            job.error_count = load_result["error_count"]

            if load_result["error_count"] > 0:
                logger.warning(
                    "Load có lỗi: %d thành công, %d lỗi",
                    load_result["success_count"],
                    load_result["error_count"],
                )

            # =================================================================
            # Hoàn thành
            # =================================================================
            job.status = JobStatus.completed.value
            job.completed_at = datetime.utcnow()
            job.current_step = "done"

            duration = time.time() - start_time

            logger.info(
                "ETL pipeline hoàn thành: job_key=%s, processed=%d, errors=%d, duration=%.2fs",
                job_key,
                job.processed_records,
                job.error_count,
                duration,
            )

        except ExtractError as e:
            job.status = JobStatus.failed.value
            job.error_message = f"Lỗi Extract: {str(e)}"
            job.completed_at = datetime.utcnow()

            logger.error("Extract thất bại: job_key=%s, error=%s", job_key, str(e))

        except TransformError as e:
            job.status = JobStatus.failed.value
            job.error_message = f"Lỗi Transform: {str(e)}"
            job.completed_at = datetime.utcnow()

            logger.error("Transform thất bại: job_key=%s, error=%s", job_key, str(e))

        except LoadError as e:
            job.status = JobStatus.failed.value
            job.error_message = f"Lỗi Load: {str(e)}"
            job.completed_at = datetime.utcnow()

            # Rollback nếu enabled
            if job.rollback_enabled and saved_state:
                await self.rollback(job, saved_state)
                job.error_message += " (đã rollback)"

            logger.error("Load thất bại: job_key=%s, error=%s", job_key, str(e))

        except Exception as e:
            job.status = JobStatus.failed.value
            job.error_message = f"Lỗi hệ thống: {str(e)}"
            job.completed_at = datetime.utcnow()

            if job.rollback_enabled and saved_state:
                await self.rollback(job, saved_state)

            logger.error("Pipeline thất bại: job_key=%s, error=%s", job_key, str(e), exc_info=True)

        await self.db.flush()
        return job

    # ========================================================================
    # Transform Methods
    # ========================================================================

    def transform_map(
        self,
        records: List[Dict[str, Any]],
        config: Dict[str, str],
    ) -> List[Dict[str, Any]]:
        """
        Transform Map — ánh xạ trường nguồn sang trường đích.

        Config có dạng: {"source_field": "target_field", ...}

        Example:
            config = {"first_name": "ho_ten", "email_addr": "email"}
            Input:  [{"first_name": "Anh", "email_addr": "a@b.com"}]
            Output: [{"ho_ten": "Anh", "email": "a@b.com"}]

        Args:
            records: Danh sách bản ghi đầu vào
            config: Config mapping {source: target}

        Returns:
            Danh sách bản ghi đã map
        """
        result = []
        for record in records:
            new_record = {}
            for source_field, target_field in config.items():
                value = record.get(source_field)
                if value is not None:
                    new_record[target_field] = value
                # Giữ lại các trường không được map
                if source_field not in config:
                    pass  # Không copy các trường không trong config
            # Copy các trường còn lại
            for key, value in record.items():
                if key not in config:
                    new_record[key] = value
            result.append(new_record)

        logger.debug("Transform map: %d records, config=%s", len(result), config)
        return result

    def transform_filter(
        self,
        records: List[Dict[str, Any]],
        config: Dict[str, Any],
    ) -> List[Dict[str, Any]]:
        """
        Transform Filter — lọc bản ghi theo điều kiện.

        Config có dạng: {"field": "value"} hoặc {"field": {"op": "value"}}
        Các operators: "eq", "ne", "gt", "lt", "gte", "lte", "contains", "in"

        Example:
            config = {"status": "active", "age": {"op": "gt", "value": 18}}
            => Lọc các bản ghi có status="active" và age > 18

        Args:
            records: Danh sách bản ghi đầu vào
            config: Config filter {field: value} hoặc {field: {"op": op, "value": val}}

        Returns:
            Danh sách bản ghi sau khi lọc
        """
        result = []
        for record in records:
            if self._matches_filter(record, config):
                result.append(record)

        logger.debug("Transform filter: %d/%d records passed", len(result), len(records))
        return result

    def transform_aggregate(
        self,
        records: List[Dict[str, Any]],
        config: Dict[str, Any],
    ) -> List[Dict[str, Any]]:
        """
        Transform Aggregate — tổng hợp/gộp dữ liệu theo nhóm.

        Config có dạng:
        {
            "group_by": ["category"],
            "aggregations": {
                "total_price": {"field": "price", "function": "sum"},
                "avg_price": {"field": "price", "function": "avg"},
                "count": {"function": "count"}
            }
        }

        Các aggregation functions: "sum", "avg", "count", "min", "max", "first", "last"

        Example:
            Input:  [{"category": "A", "price": 10}, {"category": "A", "price": 20}]
            Config: group_by=["category"], aggregations={"total": {"field": "price", "function": "sum"}}
            Output: [{"category": "A", "total": 30}]

        Args:
            records: Danh sách bản ghi đầu vào
            config: Config aggregate

        Returns:
            Danh sách bản ghi đã aggregate
        """
        group_by = config.get("group_by", [])
        aggregations = config.get("aggregations", {})

        if not group_by:
            raise TransformError("Aggregate yêu cầu 'group_by' không rỗng")

        # Nhóm records theo group_by fields
        groups: Dict[tuple, List[Dict[str, Any]]] = {}
        for record in records:
            key = tuple(record.get(field, None) for field in group_by)
            if key not in groups:
                groups[key] = []
            groups[key].append(record)

        # Aggregate từng nhóm
        result = []
        for key, group_records in groups.items():
            aggregated = {}
            # Thêm group_by fields
            for field, value in zip(group_by, key):
                aggregated[field] = value

            # Tính aggregations
            for agg_name, agg_config in aggregations.items():
                func_name = agg_config.get("function", "sum")
                field_name = agg_config.get("field")

                values = []
                if field_name:
                    values = [
                        r.get(field_name, 0)
                        for r in group_records
                        if r.get(field_name) is not None
                    ]

                aggregated[agg_name] = self._compute_aggregation(values, func_name)

            result.append(aggregated)

        logger.debug("Transform aggregate: %d groups from %d records", len(result), len(records))
        return result

    def transform_convert(
        self,
        records: List[Dict[str, Any]],
        config: Dict[str, str],
    ) -> List[Dict[str, Any]]:
        """
        Transform Convert — chuyển đổi kiểu dữ liệu của trường.

        Config có dạng: {"field_name": "target_type"}
        Các kiểu: "int", "float", "str", "bool", "datetime", "upper", "lower", "strip"

        Example:
            config = {"age": "int", "name": "upper", "price": "float"}
            Input:  [{"age": "25", "name": "anh", "price": "10.5"}]
            Output: [{"age": 25, "name": "ANH", "price": 10.5}]

        Args:
            records: Danh sách bản ghi đầu vào
            config: Config convert {field: target_type}

        Returns:
            Danh sách bản ghi đã convert kiểu
        """
        result = []
        for record in records:
            new_record = dict(record)
            for field, target_type in config.items():
                if field in new_record and new_record[field] is not None:
                    try:
                        new_record[field] = self._convert_value(new_record[field], target_type)
                    except (ValueError, TypeError) as e:
                        logger.warning(
                            "Convert lỗi field=%s type=%s value=%s: %s",
                            field, target_type, new_record.get(field), str(e),
                        )
                        # Giữ nguyên giá trị gốc nếu convert thất bại
            result.append(new_record)

        logger.debug("Transform convert: %d records, config=%s", len(result), config)
        return result

    def transform_rename(
        self,
        records: List[Dict[str, Any]],
        config: Dict[str, str],
    ) -> List[Dict[str, Any]]:
        """
        Transform Rename — đổi tên trường.

        Config có dạng: {"old_name": "new_name", ...}

        Example:
            config = {"user_name": "username", "user_email": "email"}
            Input:  [{"user_name": "john", "user_email": "j@a.com"}]
            Output: [{"username": "john", "email": "j@a.com"}]

        Args:
            records: Danh sách bản ghi đầu vào
            config: Config rename {old: new}

        Returns:
            Danh sách bản ghi đã đổi tên trường
        """
        result = []
        for record in records:
            new_record = {}
            for key, value in record.items():
                new_key = config.get(key, key)
                new_record[new_key] = value
            result.append(new_record)

        logger.debug("Transform rename: %d records, config=%s", len(result), config)
        return result

    async def rollback(
        self,
        job: ETLJob,
        saved_state: List[Dict[str, Any]],
    ) -> None:
        """
        Rollback các thay đổi từ ETL pipeline.

        Khôi phục trạng thái bảng đích về trước khi load.
        Hiện tại dùng approach đơn giản: xóa các bản ghi đã load
        và chèn lại các bản ghi gốc.

        Args:
            job: ETL job cần rollback
            saved_state: Trạng thái đã lưu trước khi load
        """
        logger.info("Rollback ETL pipeline: job_key=%s, target=%s", job.job_key, job.target_table)

        try:
            # Xóa các bản ghi đã load trong pipeline này
            delete_stmt = text(
                f"DELETE FROM {job.target_table} WHERE etl_job_key = :job_key"
            )
            await self.db.execute(delete_stmt, {"job_key": job.job_key})

            # Khôi phục bản ghi gốc
            for record in saved_state:
                columns = list(record.keys())
                placeholders = ", ".join(f":{col}" for col in columns)
                col_names = ", ".join(columns)
                insert_stmt = text(
                    f"INSERT INTO {job.target_table} ({col_names}) VALUES ({placeholders})"
                )
                await self.db.execute(insert_stmt, record)

            await self.db.flush()
            logger.info("Rollback thành công: job_key=%s", job.job_key)

        except Exception as e:
            logger.error("Rollback thất bại: job_key=%s, error=%s", job.job_key, str(e), exc_info=True)
            raise ETLServiceError(f"Rollback thất bại: {str(e)}", error_code="ROLLBACK_ERROR")

    # ========================================================================
    # Internal methods
    # ========================================================================

    async def _get_job_by_key(self, job_key: str) -> Optional[ETLJob]:
        """Tìm ETL job theo job_key."""
        stmt = select(ETLJob).where(ETLJob.job_key == job_key)
        result = await self.db.execute(stmt)
        return result.scalar_one_or_none()

    async def _get_mappings_for_job(self, job_key: str) -> List[ETLMapping]:
        """Lấy danh sách mappings cho ETL job."""
        stmt = select(ETLMapping).where(ETLMapping.etl_job_key == job_key)
        result = await self.db.execute(stmt)
        return list(result.scalars().all())

    async def _extract(self, job: ETLJob) -> List[Dict[str, Any]]:
        """
        Extract dữ liệu từ nguồn.

        Hỗ trợ 3 loại nguồn:
        - file: Đọc file CSV/JSON từ đường dẫn
        - database: Query từ bảng nguồn trong database
        - api: Gọi API endpoint (mock — cần implement theo API cụ thể)

        Args:
            job: ETL job với source_config

        Returns:
            Danh sách records đã extract
        """
        source_type = job.source_type
        config = job.source_config or {}

        if source_type == "file":
            return await self._extract_from_file(config)
        elif source_type == "database":
            return await self._extract_from_database(config)
        elif source_type == "api":
            return await self._extract_from_api(config)
        else:
            raise ExtractError(f"Source type '{source_type}' không được hỗ trợ")

    async def _extract_from_file(self, config: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Extract từ file CSV/JSON."""
        file_path = config.get("path", "")
        file_format = config.get("format", "csv")

        try:
            with open(file_path, "r", encoding="utf-8") as f:
                content = f.read()

            if file_format == "json":
                parser = JSONParser()
                return parser.parse_sync(content.encode("utf-8"))
            else:
                parser = CSVParser()
                rows, _ = parser.parse_sync(content.encode("utf-8"))
                return rows

        except FileNotFoundError:
            raise ExtractError(f"Không tìm thấy file: {file_path}")
        except Exception as e:
            raise ExtractError(f"Lỗi đọc file {file_path}: {str(e)}")

    async def _extract_from_database(self, config: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Extract từ database table."""
        table = config.get("table", "")
        columns = config.get("columns", ["*"])
        where_clause = config.get("where", "")

        columns_str = ", ".join(columns) if columns else "*"
        where_str = f" WHERE {where_clause}" if where_clause else ""

        sql = text(f"SELECT {columns_str} FROM {table}{where_str}")
        result = await self.db.execute(sql)
        rows = result.fetchall()

        records = []
        for row in rows:
            record = dict(row._mapping) if hasattr(row, "_mapping") else dict(zip(result.keys(), row))
            records.append(record)

        return records

