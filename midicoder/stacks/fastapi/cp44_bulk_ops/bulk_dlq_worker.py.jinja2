            "unreplayed": unreplayed,
            "replayed": replayed,
            "by_error_type": dict(error_type_counter.most_common()),
            "by_entity_type": dict(entity_type_counter.most_common()),
            "oldest_entry": oldest_time.isoformat() if oldest_time else None,
