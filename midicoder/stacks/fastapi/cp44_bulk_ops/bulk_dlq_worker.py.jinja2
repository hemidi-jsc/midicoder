        nếu cần.

        Args:
            days: Số ngày tối thiểu sau khi replay mới được xóa.

        Returns:
            Số entries đã bị xóa.
        """
        cutoff_date = datetime.now(timezone.utc) - timedelta(days=days)

        # Tìm các entries đã replay và đã qua cutoff_date
        entries_to_delete = self.db.query(DLQEntryModel).filter(
            DLQEntryModel.replayed == True,  # noqa: E712
            DLQEntryModel.replayed_at <= cutoff_date,
        ).all()

