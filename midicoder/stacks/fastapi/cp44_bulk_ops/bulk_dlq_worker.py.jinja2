        """
        # Lấy tất cả entries chưa replay của job
        entries = self.db.query(DLQEntryModel).filter(
            DLQEntryModel.job_id == job_id,
            DLQEntryModel.replayed == False,  # noqa: E712
        ).all()

        total = len(entries)
        succeeded = 0
        failed = 0
        results: list[dict[str, Any]] = []

        logger.info(
            "Bắt đầu replay batch job %s: %d entries",
            job_id,
            total,
        )

        for entry in entries:
            retry_result = self._execute_retry(entry)

            if retry_result.get("success"):
                entry.replayed = True
                entry.replayed_at = datetime.now(timezone.utc)
                succeeded += 1
                results.append({
                    "entry_id": str(entry.entry_id),
                    "entity_id": entry.entity_id,
                    "success": True,
                })
            else:
                failed += 1
                results.append({
                    "entry_id": str(entry.entry_id),
                    "entity_id": entry.entity_id,
                    "success": False,
                    "error": retry_result.get("error"),
                })

        # Commit tất cả thay đổi
        self.db.commit()

        logger.info(
            "Replay batch job %s hoàn thành: %d succeeded, %d failed",
            job_id,
            succeeded,
            failed,
        )

        return {
            "total": total,
            "succeeded": succeeded,
            "failed": failed,
            "results": results,
        }

    def cleanup(self, days: int = 30) -> int:
        """
        Xóa các DLQ entries cũ đã được replay thành công.

        Chỉ xóa những entries đã được replay và đã qua số ngày
