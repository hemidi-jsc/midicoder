async def process_chunks(
    job_id: str,
    all_entity_ids: list[str],
    chunk_size: int,
    max_concurrency: int,
    process_callback: Callable[[str, list[str], int], Coroutine[Any, Any, dict[str, Any]]],
) -> dict[str, Any]:
    """
    Chia entity_ids thành chunks và xử lý với semaphore để giới hạn concurrency.

    Phân chia danh sách entity_ids thành các chunk có kích thước chunk_size,
    sau đó tạo asyncio task cho mỗi chunk. Sử dụng semaphore để đảm bảo
    không quá max_concurrency chunks được xử lý đồng thời.

    Args:
        job_id: ID của bulk job đang xử lý.
        all_entity_ids: Toàn bộ danh sách entity IDs cần xử lý.
        chunk_size: Số entity trong mỗi chunk.
        max_concurrency: Số chunk tối đa xử lý song song.
        process_callback: Async callback xử lý 1 chunk.
            Signature: async (job_id, chunk_ids, chunk_number) -> dict

    Returns:
        Dict với keys:
            - succeeded: Tổng số entity thành công
            - failed: Tổng số entity thất bại
            - skipped: Tổng số entity bỏ qua
            - chunks: Danh sách kết quả từng chunk
            - total_chunks: Tổng số chunk
            - processing_time: Thời gian xử lý (giây)
    """
    if not all_entity_ids:
        return {
            "succeeded": 0,
            "failed": 0,
            "skipped": 0,
            "chunks": [],
            "total_chunks": 0,
            "processing_time": 0.0,
        }

    start_time = time.monotonic()

    # Chia entity_ids thành các chunk
    chunks = [
        all_entity_ids[i : i + chunk_size]
        for i in range(0, len(all_entity_ids), chunk_size)
    ]
    total_chunks = len(chunks)

    logger.info(
        "Job %s: Chia %d entities thành %d chunks (chunk_size=%d, concurrency=%d)",
        job_id,
        len(all_entity_ids),
        total_chunks,
        chunk_size,
        max_concurrency,
    )

    # Semaphore để giới hạn số chunk xử lý đồng thời
    semaphore = asyncio.Semaphore(max_concurrency)

    # Tạo task cho mỗi chunk
    tasks: list[asyncio.Task[dict[str, Any]]] = []
    for idx, chunk_ids in enumerate(chunks):
        task = asyncio.create_task(
            _process_single_chunk(
                job_id=job_id,
                chunk_ids=chunk_ids,
                chunk_number=idx + 1,
                semaphore=semaphore,
                process_callback=process_callback,
            ),
            name=f"chunk-{idx + 1}",
        )
        tasks.append(task)

    # Chờ tất cả chunks hoàn thành — bắt exception để tránh crash toàn bộ
    results = await asyncio.gather(*tasks, return_exceptions=True)

    # Aggregate kết quả từ tất cả chunks
    total_succeeded = 0
    total_failed = 0
    total_skipped = 0
    chunk_results: list[dict[str, Any]] = []

    for i, result in enumerate(results):
        if isinstance(result, Exception):
            # Chunk bị exception — tính toàn bộ entities trong chunk là failed
            chunk_ids = chunks[i]
            logger.error(
                "Job %s chunk %d: Exception — %s",
                job_id,
                i + 1,
                str(result),
            )
            total_failed += len(chunk_ids)
            chunk_results.append({
                "chunk_number": i + 1,
                "succeeded": 0,
                "failed": len(chunk_ids),
                "skipped": 0,
                "error": str(result),
            })
        else:
            total_succeeded += result.get("succeeded", 0)
            total_failed += result.get("failed", 0)
            total_skipped += result.get("skipped", 0)
            chunk_results.append(result)

    processing_time = round(time.monotonic() - start_time, 3)

    summary = {
        "succeeded": total_succeeded,
        "failed": total_failed,
        "skipped": total_skipped,
        "chunks": chunk_results,
        "total_chunks": total_chunks,
        "processing_time": processing_time,
    }

    logger.info(
        "Job %s hoàn thành: %d succeeded, %d failed, %d skipped (%.2fs)",
        job_id,
        total_succeeded,
        total_failed,
        total_skipped,
        processing_time,
    )

    return summary


async def _process_single_chunk(
    job_id: str,
    chunk_ids: list[str],
    chunk_number: int,
    semaphore: asyncio.Semaphore,
    process_callback: Callable[[str, list[str], int], Coroutine[Any, Any, dict[str, Any]]],
) -> dict[str, Any]:
    """
    Xử lý một chunk với semaphore control.

   Await semaphore để đảm bảo concurrency không vượt quá giới hạn,
    sau đó gọi process_callback để xử lý các entities trong chunk.

    Args:
        job_id: ID của job cha.
        chunk_ids: Danh sách entity IDs trong chunk.
        chunk_number: Số thứ tự của chunk (1-based).
        semaphore: Asyncio semaphore giới hạn concurrency.
        process_callback: Callback xử lý các entities trong chunk.

    Returns:
        Dict với keys: chunk_number, succeeded, failed, skipped, duration.
    """
    async with semaphore:
        logger.debug(
            "Bắt đầu xử lý chunk %d (job: %s, entities: %d)",
            chunk_number,
            job_id,
            len(chunk_ids),
        )

        chunk_start = time.monotonic()
        succeeded = 0
        failed = 0
        skipped = 0

        try:
            # Gọi callback để xử lý chunk
            result = await process_callback(job_id, chunk_ids, chunk_number)

            succeeded = result.get("succeeded", 0)
            failed = result.get("failed", 0)
            skipped = result.get("skipped", 0)

        except Exception as e:
            # Nếu callback ném exception, toàn bộ chunk thất bại
            failed = len(chunk_ids)
            logger.error(
                "Chunk %d (job: %s) thất bại: %s",
                chunk_number,
                job_id,
                str(e),
                exc_info=True,
            )

        duration = round(time.monotonic() - chunk_start, 3)

        chunk_result = {
            "chunk_number": chunk_number,
            "succeeded": succeeded,
            "failed": failed,
            "skipped": skipped,
            "duration": duration,
        }

        logger.debug(
            "Chunk %d hoàn thành: %d succeeded, %d failed (%.2fs)",
            chunk_number,
            succeeded,
            failed,
            duration,
        )

        return chunk_result


