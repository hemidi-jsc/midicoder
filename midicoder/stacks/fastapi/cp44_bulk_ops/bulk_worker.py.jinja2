async def execute_with_retry(
    job: dict[str, Any],
    entity_id: str,
    max_retries: int,
    retry_strategy: str,
    execute_callback: Callable[[str], Coroutine[Any, Any, Any]],
    base_delay: float = 1.0,
) -> dict[str, Any]:
    """
    Thực thi operation cho 1 entity với retry logic.

    Thử thực hiện execute_callback cho entity_id. Nếu thất bại, retry
    tối đa max_retries lần với delay được tính toán theo retry_strategy.
    Nếu hết retry vẫn thất bại, trả về kết quả với success=False.

    Args:
        job: Dict chứa thông tin job (entity_type, action, ...).
        entity_id: ID của entity cần xử lý.
        max_retries: Số lần retry tối đa.
        retry_strategy: Chiến lược delay ("exponential_backoff", "fixed_delay", "linear_backoff").
        execute_callback: Async callback thực thi operation.
            Signature: async (entity_id) -> Any
        base_delay: Delay cơ bản (giây) cho retry.

    Returns:
        Dict với keys:
            - entity_id: ID của entity
            - success: True/False
            - retry_count: Số lần retry đã thực hiện
            - error: Thông báo lỗi (nếu thất bại)
            - result: Kết quả callback (nếu thành công)
    """
    last_exception: Exception | None = None

    for attempt in range(max_retries + 1):
        try:
            result = await execute_callback(entity_id)
            return {
                "entity_id": entity_id,
                "success": True,
                "retry_count": attempt,
                "result": result,
            }

        except Exception as e:
            last_exception = e
            logger.warning(
                "Entity %s attempt %d/%d thất bại: %s",
                entity_id,
                attempt + 1,
                max_retries + 1,
                str(e),
            )

            if attempt < max_retries:
                # Tính delay và chờ trước khi retry tiếp
                delay = calculate_delay(attempt, retry_strategy, base_delay)
                logger.debug(
                    "Entity %s: chờ %.2fs trước retry lần %d",
                    entity_id,
                    delay,
                    attempt + 2,
                )
                await asyncio.sleep(delay)
            # Nếu attempt == max_retries, vòng lặp kết thúc -> trả về thất bại

    # Đã hết tất cả attempts — trả về thất bại
    return {
        "entity_id": entity_id,
        "success": False,
        "error": str(last_exception),
        "retry_count": max_retries,
    }


def calculate_delay(
    attempt: int,
    strategy: str,
    base_delay: float = 1.0,
) -> float:
    """
    Tính toán delay cho retry theo strategy.

    Sử dụng jitter ngẫu nhiên (0.0 - 0.1s) để tránh thundering herd
    khi nhiều entity cùng retry tại thời điểm giống nhau.

    Chiến lược:
        - exponential_backoff: base * 2^attempt + jitter (tăng gấp đôi mỗi lần)
        - fixed_delay: base + jitter (delay cố định mỗi lần)
        - linear_backoff: base * attempt + jitter (tăng tuyến tính)

    Args:
        attempt: Số lần attempt hiện tại (0-based).
        strategy: Tên chiến lược delay.
        base_delay: Delay cơ bản (giây).

    Returns:
        Delay theo giây (float) với jitter.

    Examples:
        >>> calculate_delay(0, "exponential_backoff")  # ~1.0x + jitter
        1.05
        >>> calculate_delay(1, "exponential_backoff")  # ~2.0x + jitter
        2.03
        >>> calculate_delay(2, "exponential_backoff")  # ~4.0x + jitter
        4.07
        >>> calculate_delay(2, "linear_backoff")       # ~2.0x + jitter
        2.04
        >>> calculate_delay(2, "fixed_delay")          # ~1.0x + jitter
        1.06
    """
    jitter = random.uniform(0, 0.1)

    if strategy == "exponential_backoff":
        delay = base_delay * (2 ** attempt) + jitter
    elif strategy == "fixed_delay":
        delay = base_delay + jitter
    elif strategy == "linear_backoff":
        delay = base_delay * (attempt + 1) + jitter
    else:
        # Mặc định: exponential backoff
        delay = base_delay * (2 ** attempt) + jitter

    return round(delay, 3)
