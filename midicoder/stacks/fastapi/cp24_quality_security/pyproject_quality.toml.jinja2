# =============================================================================
# Code Quality & Security Scanner Generator (CP24)
# =============================================================================
# Ruff configuration cho dự án FastAPI
# Tự động sinh bởi Midicoder CE — không chỉnh sửa thủ công
# =============================================================================

[tool.ruff]
target-version = "py310"
line-length = 120
exclude = {{ profile.exclude | tojson }}

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "A", "C4", "SIM"]
ignore = []

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101", "S106"]
