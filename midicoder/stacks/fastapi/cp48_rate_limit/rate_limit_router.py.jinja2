@router.post(
    "/policies",
    status_code=status.HTTP_201_CREATED,
    summary="Tạo chính sách rate limit mới",
    response_model=RateLimitPolicyRead,
    responses={
        201: {"description": "Chính sách rate limit được tạo thành công"},
        400: {"description": "Dữ liệu đầu vào không hợp lệ"},
        409: {"description": "Chính sách đã tồn tại"},
    },
)
async def create_policy(data: RateLimitPolicyCreate) -> RateLimitPolicyRead:
    """
    Tạo một chính sách rate limit mới.

    Server sẽ tạo policy với policy_id tự động, lưu vào bộ nhớ
    và trả về thông tin chi tiết của policy mới tạo.

    Args:
        data: Dữ liệu tạo policy từ client.

    Returns:
        RateLimitPolicyRead với thông tin policy mới tạo.

    Raises:
        HTTPException: Nếu policy_id đã tồn tại (409).
    """
    policy_id = str(uuid.uuid4())

    # Kiểm tra trùng lặp tên
    for existing in _policies.values():
        if existing.name == data.name:
            raise HTTPException(
                status_code=status.HTTP_409_CONFLICT,
                detail=f"Chính sách có tên '{data.name}' đã tồn tại",
            )

    # Tạo policy mới
    policy = RateLimitPolicy(
        policy_id=policy_id,
        name=data.name,
        strategy=data.strategy,
        max_requests=data.max_requests,
        window_seconds=data.window_seconds,
        refill_rate=data.refill_rate,
        burst_size=data.burst_size,
        enabled=data.enabled,
        bypass_keys=data.bypass_keys,
        metadata=data.metadata or {},
    )

    _policies[policy_id] = policy

    logger.info(
        "Chính sách rate limit được tạo: %s, %s, %s, %d/%ds",
        policy_id,
        data.name,
        data.strategy.value,
        data.max_requests,
        data.window_seconds,
    )

    return RateLimitPolicyRead.model_validate(policy)


