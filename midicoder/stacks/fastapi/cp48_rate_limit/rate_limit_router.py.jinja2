@router.get(
    "/usage/{key}",
    summary="Lấy thống kê sử dụng rate limit",
    response_model=UsageStats,
    responses={
        200: {"description": "Thống kê sử dụng rate limit"},
        404: {"description": "Key không tồn tại trong rate limit storage"},
    },
)
async def get_usage(
    key: str,
    strategy: RateLimitStrategy = Query(
        RateLimitStrategy.FIXED_WINDOW,
        description="Chiến lược rate limit để tra cứu",
    ),
) -> UsageStats:
    """
    Lấy thông tin thống kê sử dụng rate limit cho một key.

    Trả về số yêu cầu đã gửi, giới hạn tối đa, số yêu cầu còn lại,
    và thời điểm reset cửa sổ.

    Args:
        key: Khóa nhận diện client (user_id, IP).
        strategy: Chiến lược rate limit để tra cứu.

    Returns:
        UsageStats với thông tin sử dụng chi tiết.

    Raises:
        HTTPException: Nếu key không tồn tại (404).
    """
    service = _get_service()
    usage = service.get_usage(key, strategy)

    if usage is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Không tìm thấy dữ liệu usage cho key: {key}",
        )

    current_count = usage.get("current_count", 0)
    max_requests = usage.get("max_requests", 0)

    # Tìm policy phù hợp để lấy window_seconds
    window_seconds = 60  # mặc định
    for policy in _policies.values():
        if policy.strategy == strategy:
            window_seconds = policy.window_seconds
            max_requests = policy.max_requests
            break

    reset_at = datetime.fromtimestamp(
        usage.get("reset_at", int(time.time()) + window_seconds),
        tz=timezone.utc,
    )

    return UsageStats(
        key=key,
        current_count=current_count,
        max_requests=max_requests,
        window_seconds=window_seconds,
        reset_at=reset_at,
        remaining=max(0, max_requests - current_count),
        is_limited=current_count >= max_requests,
    )


