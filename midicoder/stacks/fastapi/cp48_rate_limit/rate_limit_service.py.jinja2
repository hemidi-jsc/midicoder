    def _check_token_bucket(
        self,
        key: str,
        refill_rate: float,
        max_tokens: float,
    ) -> tuple[bool, dict[str, Any]]:
        """
        Kiểm tra rate limit bằng Token Bucket strategy.

        Mỗi key có một bucket chứa token. Token được refill liên tục
        theo refill_rate (token/giây). Mỗi yêu cầu tiêu thụ 1 token.
        Nếu bucket trống, yêu cầu bị từ chối.

        Ưu điểm: Cho phép burst traffic, refill mượt, phù hợp API gateway.
        Nhược điểm: Phức tạp hơn, cần tính toán refill liên tục.

        Args:
            key: Khóa nhận diện client.
            refill_rate: Tốc độ refill token/giây.
            max_tokens: Số token tối đa của bucket (burst_size).

        Returns:
            Tuple (allowed, info) với thông tin chi tiết.
        """
        now = time.time()

        # Lấy hoặc tạo entry
        entry = self.token_buckets.get(key)
        if entry is None:
            entry = _TokenBucketEntry(
                tokens=max_tokens,
                last_refill=now,
                max_tokens=max_tokens,
                refill_rate=refill_rate,
            )
            self.token_buckets[key] = entry

        # Refill token dựa trên thời gian đã trôi qua
        elapsed = now - entry.last_refill
        entry.tokens = min(entry.max_tokens, entry.tokens + elapsed * entry.refill_rate)
        entry.last_refill = now

        # Tính các giá trị thông tin
        current_tokens = entry.tokens
        remaining = max(0, int(current_tokens))
        if current_tokens <= 0:
            # Thời gian để refill 1 token
            retry_after = 1.0 / refill_rate if refill_rate > 0 else 60.0
        else:
            retry_after = 0.0
        reset_at = int(now + (entry.max_tokens - current_tokens) / refill_rate) if refill_rate > 0 else int(now + 60)

        # Kiểm tra: cần ít nhất 1 token
        if current_tokens < 1.0:
            return False, {
                "current_count": int(entry.max_tokens - current_tokens),
                "max_requests": int(entry.max_tokens),
                "remaining": 0,
                "retry_after": round(retry_after, 1),
                "reset_at": reset_at,
                "strategy": RateLimitStrategy.TOKEN_BUCKET.value,
            }

        # Tiêu thụ 1 token
        entry.tokens -= 1.0
        remaining = max(0, int(entry.tokens))

        return True, {
            "current_count": int(entry.max_tokens - entry.tokens),
            "max_requests": int(entry.max_tokens),
            "remaining": remaining,
            "retry_after": round(retry_after, 1),
            "reset_at": reset_at,
            "strategy": RateLimitStrategy.TOKEN_BUCKET.value,
        }

