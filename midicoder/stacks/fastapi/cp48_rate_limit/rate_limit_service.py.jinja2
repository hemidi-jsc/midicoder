    def _check_sliding_window(
        self,
        key: str,
        max_requests: int,
        window_seconds: int,
    ) -> tuple[bool, dict[str, Any]]:
        """
        Kiểm tra rate limit bằng Sliding Window strategy.

        Lưu timestamp của từng yêu cầu, loại bỏ các yêu cầu nằm ngoài
        cửa sổ thời gian hiện tại. Tính toán chính xác hơn fixed window,
        tránh được window boundary attack.

        Ưu điểm: Chính xác, mượt mà, không có lỗ hổng biên cửa sổ.
        Nhược điểm: Tốn bộ nhớ hơn (lưu tất cả timestamps trong cửa sổ).

        Args:
            key: Khóa nhận diện client.
            max_requests: Số yêu cầu tối đa trong cửa sổ trượt.
            window_seconds: Kích thước cửa sổ trượt (giây).

        Returns:
            Tuple (allowed, info) với thông tin chi tiết.
        """
        now = time.time()
        window_start = now - window_seconds

        # Lấy hoặc tạo entry
        entry = self.sliding_windows.get(key)
        if entry is None:
            entry = _SlidingWindowEntry(timestamps=[])
            self.sliding_windows[key] = entry

        # Loại bỏ các timestamp nằm ngoài cửa sổ
        entry.timestamps = [ts for ts in entry.timestamps if ts > window_start]
        current_count = len(entry.timestamps)

        # Tính các giá trị thông tin
        remaining = max(0, max_requests - current_count)
        if entry.timestamps:
            oldest_in_window = entry.timestamps[0]
            reset_at = oldest_in_window + window_seconds
            retry_after = max(0, reset_at - now)
        else:
            reset_at = now + window_seconds
            retry_after = 0.0

        # Kiểm tra giới hạn
        if current_count >= max_requests:
            return False, {
                "current_count": current_count,
                "max_requests": max_requests,
                "remaining": 0,
                "retry_after": round(retry_after, 1),
                "reset_at": int(reset_at),
                "strategy": RateLimitStrategy.SLIDING_WINDOW.value,
            }

        # Thêm timestamp hiện tại và trả về cho phép
        entry.timestamps.append(now)
        remaining = max(0, max_requests - len(entry.timestamps))

        return True, {
            "current_count": len(entry.timestamps),
            "max_requests": max_requests,
            "remaining": remaining,
            "retry_after": round(retry_after, 1),
            "reset_at": int(reset_at),
            "strategy": RateLimitStrategy.SLIDING_WINDOW.value,
        }

