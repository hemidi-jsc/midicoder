        """
        Kiểm tra rate limit bằng Fixed Window strategy.

        Chia thời gian thành các cửa sổ cố định có kích thước window_seconds.
        Đếm số yêu cầu trong cửa sổ hiện tại, nếu vượt quá max_requests thì từ chối.

        Ưu điểm: Đơn giản, hiệu suất cao, ít bộ nhớ.
        Nhược điểm: Có thể cho phép gấp đôi giới hạn tại biên cửa sổ
        (client gửi max_requests ở cuối cửa sổ cũ + max_requests ở đầu cửa sổ mới).

        Args:
            key: Khóa nhận diện client.
            max_requests: Số yêu cầu tối đa trong một cửa sổ.
            window_seconds: Kích thước cửa sổ (giây).

        Returns:
            Tuple (allowed, info) với thông tin chi tiết.
        """
        now = time.time()

        # Lấy hoặc tạo entry
        entry = self.fixed_windows.get(key)
        if entry is None:
            entry = _FixedWindowEntry(count=0, window_start=now)
            self.fixed_windows[key] = entry

        # Kiểm tra nếu đã hết cửa sổ cũ — reset
        elapsed = now - entry.window_start
        if elapsed >= window_seconds:
            entry.count = 0
            entry.window_start = now
            elapsed = 0.0

        # Tính các giá trị thông tin
        remaining = max(0, max_requests - entry.count)
        reset_at = entry.window_start + window_seconds
        retry_after = max(0, reset_at - now)

        # Kiểm tra giới hạn
        if entry.count >= max_requests:
            return False, {
                "current_count": entry.count,
                "max_requests": max_requests,
                "remaining": 0,
                "retry_after": round(retry_after, 1),
                "reset_at": int(reset_at),
                "strategy": RateLimitStrategy.FIXED_WINDOW.value,
            }

        # Tăng bộ đếm và trả về cho phép
        entry.count += 1
        remaining = max(0, max_requests - entry.count)

        return True, {
            "current_count": entry.count,
            "max_requests": max_requests,
            "remaining": remaining,
            "retry_after": round(retry_after, 1),
            "reset_at": int(reset_at),
            "strategy": RateLimitStrategy.FIXED_WINDOW.value,
        }

