        Xây dựng khóa duy nhất để lưu usage trong bộ nhớ.

        Khóa được cấu thành từ config_id + scope identifier,
        đảm bảo usage được tách biệt theo cấp độ và đối tượng.

        Args:
            config: QuotaConfig đang xử lý.
            user_id: ID người dùng.
            tenant_id: ID tenant.
            endpoint: Đường dẫn endpoint.

        Returns:
            Khóa duy nhất dạng string.
        """
        parts = [f"quota:{config.config_id}"]

        if config.level == QuotaLevel.USER and user_id:
            parts.append(f"user:{user_id}")
        elif config.level == QuotaLevel.TENANT and tenant_id:
            parts.append(f"tenant:{tenant_id}")
        elif config.level == QuotaLevel.ENDPOINT and endpoint:
            parts.append(f"endpoint:{endpoint}")

        return ":".join(parts)

    def _get_current_usage(self, config: QuotaConfig, usage_key: str) -> int:
        """
        Lấy số lượng đã sử dụng hiện tại cho một usage key.

        Tự động kiểm tra và reset nếu chu kỳ hiện tại đã hết hạn.

        Args:
            config: QuotaConfig đang xử lý.
            usage_key: Khóa usage trong bộ nhớ.

        Returns:
            Số lượng đã sử dụng trong chu kỳ hiện tại.
        """
        entry = self.usage.get(usage_key)
        if not entry:
            return 0

        # Kiểm tra nếu chu kỳ đã hết — tự động reset
        period_seconds = PERIOD_SECONDS[config.period]
        now = time.time()
        elapsed = now - entry.period_start

        if elapsed >= period_seconds:
            # Tính số chu kỳ đã trôi qua để reset đến chu kỳ mới nhất
            cycles_passed = int(elapsed / period_seconds)
            entry.count = 0
            entry.period_start = now
            logger.debug(
                "Quota chu kỳ tự động reset: key=%s, period=%s, cycles_passed=%d",
                usage_key,
                config.period.value,
                cycles_passed,
            )

        return entry.count

    def _increment_usage(self, config: QuotaConfig, usage_key: str) -> int:
        """
        Tăng bộ đếm sử dụng cho một usage key.

        Tạo entry mới nếu chưa tồn tại, hoặc tăng counter của entry hiện có.

        Args:
            config: QuotaConfig đang xử lý.
            usage_key: Khóa usage trong bộ nhớ.

        Returns:
            Số lượng đã sử dụng sau khi tăng.
        """
        period_seconds = PERIOD_SECONDS[config.period]

        if usage_key not in self.usage:
            self.usage[usage_key] = _QuotaUsageEntry(
                count=0,
                period_start=time.time(),
                period_seconds=period_seconds,
            )

        self.usage[usage_key].count += 1
        return self.usage[usage_key].count


