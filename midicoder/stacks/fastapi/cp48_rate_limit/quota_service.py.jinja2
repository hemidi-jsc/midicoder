        Một config áp dụng nếu:
            - Config đang enabled
            - Config level khớp với thông tin được cung cấp:
                - USER: cần có user_id
                - TENANT: cần có tenant_id
                - ENDPOINT: endpoint trống (toàn bộ) hoặc khớp với request endpoint
                - GLOBAL: luôn áp dụng

        Args:
            user_id: ID của người dùng.
            tenant_id: ID của tenant.
            endpoint: Đường dẫn endpoint.

        Returns:
            Danh sách QuotaConfig áp dụng.
        """
        applicable: list[QuotaConfig] = []

        for config in self.configs.values():
            if not config.enabled:
                continue

            if config.level == QuotaLevel.USER:
                if user_id:
                    applicable.append(config)

            elif config.level == QuotaLevel.TENANT:
                if tenant_id:
                    applicable.append(config)

            elif config.level == QuotaLevel.ENDPOINT:
                # Endpoint config chỉ áp dụng nếu endpoint khớp
                if not config.endpoint:
                    # Endpoint trống = áp dụng cho tất cả
                    applicable.append(config)
                elif endpoint and endpoint.startswith(config.endpoint):
                    applicable.append(config)

            elif config.level == QuotaLevel.GLOBAL_:
                # Global luôn áp dụng
                applicable.append(config)

        return applicable

    def _build_usage_key(
        self,
