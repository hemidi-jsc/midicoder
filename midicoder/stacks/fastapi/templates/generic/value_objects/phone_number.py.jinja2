    Số điện thoại.
    
    Attributes:
        country_code: Mã quốc gia (ví dụ: +84)
        number: Số điện thoại (không có dấu +)
    
    Raises:
        ValueError: Nếu số điện thoại không hợp lệ
    """
    
    country_code: str
    number: str

    # KPI-029: Tenant ID cho multi-tenant isolation
    # - Optional field, default=None cho backward compatibility
    # - repr=False: Không hiển thị trong __repr__
    # - compare=False: Không ảnh hưởng đến __eq__ và __hash__
    tenant_id: Optional[str] = field(default=None, repr=False, compare=False)

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate country code
        if not self.country_code or not self.country_code.startswith("+"):
            raise ValueError("Mã quốc gia phải bắt đầu bằng +")
        
        # Validate number (only digits)
        if not self.number or not self.number.isdigit():
            raise ValueError("Số điện thoại chỉ chứa chữ số")
        
        # Validate length
        if len(self.number) < 7 or len(self.number) > 15:
            raise ValueError("Số điện thoại phải có 7-15 chữ số")
    
    @property
    def formatted(self) -> str:
        """Trả về số điện thoại định dạng đầy đủ."""
        return f"{self.country_code} {self.number}"
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, PhoneNumber):
            return False
        return (self.country_code == other.country_code 
                and self.number == other.number)
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash((self.country_code, self.number))
    
    def get_tenant_id(self) -> str | None:
