    @classmethod
    def from_string(cls, phone: str) -> "PhoneNumber":
        """Tạo PhoneNumber từ string (ví dụ: +84912345678)."""
        phone = phone.strip()
        
        # Extract country code
        if phone.startswith("+"):
            # Find where digits start after +
            match = re.match(r'^(\+[\d]+)([\d]+)$', phone.replace(" ", ""))
            if match:
                # Try to find country code boundary (simple heuristic)
                country_digits = match.group(1)[1:]
                number = match.group(2)
                
                # Assume country code is 1-4 digits
                for i in range(min(4, len(country_digits)), 0, -1):
                    cc = "+" + country_digits[:i]
                    num = country_digits[i:] + number
                    if len(num) >= 7 and len(num) <= 15:
                        return cls(country_code=cc, number=num)
            
            raise ValueError("Không thể phân tích số điện thoại")
        
        raise ValueError("Số điện thoại phải bắt đầu bằng +")
    
