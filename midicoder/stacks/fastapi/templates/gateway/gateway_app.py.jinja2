# Tenant extraction middleware
@app.middleware("http")
async def extract_tenant_middleware(request: Request, call_next):
    """
    KPI-029: Middleware để extract tenant_id từ request.
    
    Tenant ID được extract từ:
    1. X-Tenant-Id header
    2. Subdomain (tenant.domain.com)
    3. Path parameter (/api/{tenant_id}/...)
    
    Args:
        request: HTTP request object
        call_next: Next middleware handler
        
    Returns:
        HTTP response với tenant context
    """
    # KPI-029: Extract tenant_id từ header
    tenant_id = request.headers.get("X-Tenant-Id")
    
    # KPI-029: Extract từ subdomain nếu không có trong header
    if not tenant_id:
        host = request.headers.get("host", "")
        parts = host.split(".")
        if len(parts) > 2 and parts[0] not in ["www", "api"]:
            tenant_id = parts[0]
    
    # KPI-029: Extract từ path nếu vẫn chưa có
    if not tenant_id:
        path_parts = request.url.path.strip("/").split("/")
        if path_parts and path_parts[0] not in ["api", "health", "metrics"]:
            tenant_id = path_parts[0]
    
    # KPI-029: Set tenant context nếu có
    if tenant_id:
        request.state.tenant_id = tenant_id
        logger.info(f"Request from tenant: {tenant_id}")
    
    response = await call_next(request)
    
    # KPI-029: Add tenant_id to response headers
    if hasattr(request.state, 'tenant_id'):
        response.headers["X-Tenant-Id"] = request.state.tenant_id
    
    return response


# Request logging middleware
@app.middleware("http")
async def log_requests(request: Request, call_next):
    """
    Middleware ghi log cho mỗi request.
    
    KPI-029: Include tenant_id trong log.
    
    Args:
        request: HTTP request object
        call_next: Next middleware handler
        
    Returns:
        HTTP response
    """
    tenant_id = getattr(request.state, 'tenant_id', None)
    tenant_str = f" [tenant: {tenant_id}]" if tenant_id else ""
    
    logger.info(f"Incoming request: {request.method} {request.url.path}{tenant_str}")
    
    response = await call_next(request)
    
    logger.info(
        f"Outgoing response: {request.method} {request.url.path} - "
        f"Status: {response.status_code}{tenant_str}"
    )
    
    return response


# Exception handlers
@app.exception_handler(RequestValidationError)
async def validation_exception_handler(request: Request, exc: RequestValidationError):
    """
    Exception handler cho validation errors.
    
    Args:
        request: HTTP request
        exc: Validation error
        
    Returns:
        JSONResponse với error details
    """
    logger.error(f"Validation error: {exc.errors()}")
    return JSONResponse(
        status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
        content={
            "detail": "Validation failed",
            "errors": exc.errors(),
        },
    )


@app.exception_handler(RateLimitExceeded)
async def rate_limit_exception_handler(request: Request, exc: RateLimitExceeded):
    """
    Exception handler cho rate limit exceeded.
    
    Args:
        request: HTTP request
        exc: Rate limit exceeded error
        
    Returns:
        JSONResponse 429 Too Many Requests
    """
    logger.warning(f"Rate limit exceeded for {request.client.host}")
    return JSONResponse(
        status_code=status.HTTP_429_TOO_MANY_REQUESTS,
        content={
            "detail": "Rate limit exceeded",
            "message": "Quá nhiều requests. Vui lòng thử lại sau.",
        },
        headers={
            "X-RateLimit-Limit": str(exc.limit),
            "X-RateLimit-Remaining": "0",
            "Retry-After": str(exc.retry_after),
        },
    )


@app.exception_handler(CircuitBreakerOpen)
async def circuit_breaker_exception_handler(request: Request, exc: CircuitBreakerOpen):
    """
    Exception handler cho circuit breaker open.
    
    Args:
        request: HTTP request
        exc: Circuit breaker open error
        
    Returns:
        JSONResponse 503 Service Unavailable
    """
    logger.warning(f"Circuit breaker open for {exc.backend_id}")
    return JSONResponse(
        status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
        content={
            "detail": "Service temporarily unavailable",
            "message": "Backend service tạm thời không khả dụng",
            "circuit_breaker": exc.backend_id,
        },
    )


