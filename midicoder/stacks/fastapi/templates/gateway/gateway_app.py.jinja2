logger = logging.getLogger(__name__)


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None, None]:
    """
    Lifespan context manager cho FastAPI app.
    
    lifespan handler cho startup và shutdown.
    timeout: config timeout cho app.
    
    Xử lý:
    - Startup: Load config, initialize services
    - Shutdown: Cleanup resources
    
    Args:
        app: FastAPI application instance
        
    Yields:
        None
    """
    # Startup - khởi tạo services
    logger.info("Starting Gateway Service...")
    
    # Initialize services
    app.state.gateway_service = GatewayService()
    app.state.route_config = RouteConfigManager()
    app.state.rate_limiter = RateLimiter()
    app.state.circuit_breaker = CircuitBreaker()
    
    # Load route configuration
    await app.state.route_config.load()
    logger.info(f"Loaded {len(app.state.route_config.routes)} routes")
    
    yield
    
    # Shutdown - cleanup resources
    logger.info("Shutting down Gateway Service...")
    await app.state.gateway_service.close()
    logger.info("Gateway Service shutdown complete")


