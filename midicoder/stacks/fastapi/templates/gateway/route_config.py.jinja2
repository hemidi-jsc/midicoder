"""
FastAPI Route Config - Route configuration management.

Module này cung cấp:
- RouteConfig dataclass
- BackendConfig dataclass
- Route matching logic
- Load/reload configuration

CP06: API Gateway & Service Mesh
KPI-029: Tenant Isolation - Tenant-specific routes và backends
"""

import logging
from typing import List, Optional, Dict
from dataclasses import dataclass, field

logger = logging.getLogger(__name__)


@dataclass
class RouteConfig:
    """
    RouteConfig - Cấu hình route.
    
    KPI-029: tenant_ids cho tenant-specific routing.
    
    Attributes:
        id: Route ID
        name: Route name
        paths: Danh sách paths
        methods: HTTP methods
        backend: Backend service ID
        prefix: Prefix để strip
        strip_prefix: Strip prefix flag
        timeout: Timeout (ms)
        weight: Weight cho load balancing
        priority: Priority cho route matching
        enabled: Enabled flag
        tenant_ids: KPI-029: Tenant IDs cho route này (None = global)
    """
    id: str
    name: str
    paths: List[str]
    methods: List[str]
    backend: str
    prefix: Optional[str] = None
    strip_prefix: bool = True
    rewrite: Optional[str] = None  # rewrite pattern
    timeout: int = 30000
    weight: int = 1
    priority: int = 0
    enabled: bool = True
    tenant_ids: Optional[List[str]] = None  # KPI-029: Tenant IDs (None = global)


@dataclass
class BackendConfig:
    """
    BackendConfig - Cấu hình backend.
    
    KPI-029: tenant_ids cho tenant-specific backends.
    
    Attributes:
        id: Backend ID
        name: Backend name
        url: Backend URL
        health_path: Health check path
        enabled: Enabled flag
        tenant_ids: KPI-029: Tenant IDs cho backend này
    """
    id: str
    name: str
    url: str
    health_path: str = "/health"
    enabled: bool = True
    tenant_ids: Optional[List[str]] = None  # KPI-029: Tenant IDs


class RouteConfigManager:
    """
    RouteConfigManager - Quản lý route configuration.
    
    Class này:
    1. Load routes từ config
    2. Match requests với routes
    3. Reload configuration
    4. Validate routes
    
    KPI-029: Support tenant-specific routing.
    
    Attributes:
        routes: Danh sách routes
        backends: Danh sách backends
    """

    def __init__(self):
        """Khởi tạo RouteConfigManager."""
        self.routes: List[RouteConfig] = []
        self.backends: List[BackendConfig] = []
        # KPI-029: Tenant-specific routes cache
        self.tenant_routes: Dict[str, List[RouteConfig]] = {}
        self.tenant_backends: Dict[str, List[BackendConfig]] = {}
    
    async def load(self):
        """
        Load route configuration.
        
        Load routes và backends từ default config.
        """
        # Default routes
        self.routes = [
            RouteConfig(
                id="api-default",
                name="Default API Route",
                paths=["/api/*"],
                methods=["GET", "POST", "PUT", "DELETE", "PATCH"],
                backend="api-backend",
                prefix="/api",
                strip_prefix=True,
                timeout=30000,
                enabled=True,
            ),
            RouteConfig(
                id="graphql-default",
                name="Default GraphQL Route",
                paths=["/graphql"],
                methods=["POST", "GET"],
                backend="graphql-backend",
                timeout=60000,
                enabled=True,
            ),
        ]
        
        # Default backends
        self.backends = [
            BackendConfig(
                id="api-backend",
                name="API Backend",
                url="http://localhost:3000",
                health_path="/health",
                enabled=True,
            ),
            BackendConfig(
                id="graphql-backend",
                name="GraphQL Backend",
                url="http://localhost:4000",
                health_path="/health",
                enabled=True,
            ),
        ]
        
        logger.info(f"Loaded {len(self.routes)} routes and {len(self.backends)} backends")
    
    def find_route(self, path: str, method: str, tenant_id: Optional[str] = None) -> Optional[RouteConfig]:
        """
        Find route cho request.
        
        KPI-029: Support tenant-specific route matching.
        
        Args:
            path: Request path
            method: HTTP method
            tenant_id: KPI-029: Tenant ID cho tenant-specific routing
            
        Returns:
            Matching route hoặc None
        """
        # KPI-029: First, try tenant-specific routes
        if tenant_id:
            for route in self.routes:
                if not route.enabled:
                    continue
                
                # KPI-029: Check nếu route là tenant-specific và match tenant_id
                if route.tenant_ids is not None and tenant_id not in route.tenant_ids:
                    continue
                
                # Method matching
                if method not in route.methods:
                    continue
                
                # Path matching
                for route_path in route.paths:
                    if route_path.endswith("/*"):
                        prefix = route_path[:-1]
                        if path.startswith(prefix):
                            return route
                    elif route_path == path:
                        return route
        
        # Global routes (no tenant filter)
        for route in self.routes:
            if not route.enabled:
                continue
            
            # KPI-029: Skip tenant-specific routes if tenant_id provided
            if tenant_id and route.tenant_ids is not None:
                continue
            
            # Method matching
            if method not in route.methods:
                continue
            
            # Path matching
            for route_path in route.paths:
                if route_path.endswith("/*"):
                    prefix = route_path[:-1]
                    if path.startswith(prefix):
                        return route
                elif route_path == path:
                    return route
        
        return None
    
    def validate(self) -> bool:
        """
        Validate routes.
        
        Returns:
            True nếu tất cả routes valid
        """
        for route in self.routes:
            if not route.id:
                logger.error(f"Route missing id: {route}")
                return False
            if not route.backend:
                logger.error(f"Route missing backend: {route.id}")
                return False
            if not route.paths:
                logger.error(f"Route missing paths: {route.id}")
                return False
        return True
    
    async def reload(self):
        """Reload route configuration."""
        logger.info("Reloading route configuration...")
        await self.load()
        logger.info("Route configuration reloaded")
    
    def get_backend(self, backend_id: str, tenant_id: Optional[str] = None) -> Optional[BackendConfig]:
        """
        Get backend by ID.
        
        KPI-029: Support tenant-specific backend resolution.
        
        Args:
            backend_id: Backend ID
            tenant_id: KPI-029: Tenant ID cho tenant-specific backend
            
        Returns:
            Backend config hoặc None
        """
        # KPI-029: First, try tenant-specific backend
        if tenant_id:
            for backend in self.backends:
                if backend.id == backend_id and backend.enabled:
                    if backend.tenant_ids is None or tenant_id in backend.tenant_ids:
                        return backend
        
        # Global backend (no tenant filter)
        for backend in self.backends:
            if backend.id == backend_id and backend.enabled:
                if backend.tenant_ids is None:
                    return backend
        return None
    
    def add_tenant_backend(self, tenant_id: str, backend: BackendConfig):
        """
        KPI-029: Add tenant-specific backend.
        
        Args:
            tenant_id: Tenant ID
            backend: Backend config
        """
        backend.tenant_ids = [tenant_id]
        self.backends.append(backend)
        logger.info(f"Added tenant {tenant_id} backend: {backend.id}")
    
    def add_route(self, route: RouteConfig):
        """
        Add route.
        
        Args:
            route: Route config
        """
        self.routes.append(route)
        logger.info(f"Added route: {route.id}")
    
    def remove_route(self, route_id: str):
        """
        Remove route.
        
        Args:
            route_id: Route ID
        """
        self.routes = [r for r in self.routes if r.id != route_id]
        logger.info(f"Removed route: {route_id}")
    
    def update_route(self, route_id: str, **kwargs):
        """
        Update route.
        
        Args:
            route_id: Route ID
            **kwargs: Route updates
        """
        for route in self.routes:
            if route.id == route_id:
                for key, value in kwargs.items():
                    if hasattr(route, key):
                        setattr(route, key, value)
                logger.info(f"Updated route: {route_id}")
                break