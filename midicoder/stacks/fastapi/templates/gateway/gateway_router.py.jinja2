"""
FastAPI Gateway Router - Router cho API Gateway endpoints.

Router này xử lý:
- Proxy routes cho backend services
- Health check endpoints
- Route discovery
- Error handling

CP06: API Gateway & Service Mesh
"""

from typing import Any, Dict, Optional

from fastapi import APIRouter, Body, Depends, Header, Path, Query, Request, Response, status
from fastapi.responses import JSONResponse
from pydantic import BaseModel

# Import gateway service
from gateway_service import GatewayService
from rate_limiter import RateLimiter, check_rate_limit
from circuit_breaker import CircuitBreaker

# Router instance
router = APIRouter(
    prefix="/proxy",
    tags=["proxy"],
    responses={
        429: {"description": "Rate limit exceeded"},
        503: {"description": "Service unavailable"},
    },
    # HTTPStatus codes
)


# Request/Response models
class ProxyResponse(BaseModel):
    """Response model cho proxy requests."""
    status: int
    data: Optional[Any] = None
    message: Optional[str] = None


# Dependency injection cho services
def get_gateway_service() -> GatewayService:
    """
    Dependency cho GatewayService.
    
    Returns:
        GatewayService instance
    """
    return GatewayService()


def get_rate_limiter() -> RateLimiter:
    """
    Dependency cho RateLimiter.
    
    Returns:
        RateLimiter instance
    """
    return RateLimiter()


def get_circuit_breaker() -> CircuitBreaker:
    """
    Dependency cho CircuitBreaker.
    
    Returns:
        CircuitBreaker instance
    """
    return CircuitBreaker()


# GET endpoint
@router.get("/resource/{resource_id}", response_model=ProxyResponse, status_code=status.HTTP_200_OK)
async def get_resource(
    resource_id: str = Path(..., description="Resource ID"),
    request: Request = None,
    gateway_service: GatewayService = Depends(get_gateway_service),
):
    """
    GET endpoint cho resource.
    
    Args:
        resource_id: Resource ID từ path
        request: HTTP request
        gateway_service: Gateway service
        
    Returns:
        ProxyResponse
    """
    try:
        result = await gateway_service.get_resource(resource_id)
        return ProxyResponse(status=200, data=result)
    except Exception as e:
        return ProxyResponse(status=500, message=str(e))


# POST endpoint
@router.post("/resource", response_model=ProxyResponse, status_code=status.HTTP_201_CREATED)
async def create_resource(
    body: Dict[str, Any] = Body(..., description="Resource data"),
    request: Request = None,
    gateway_service: GatewayService = Depends(get_gateway_service),
):
    """
    POST endpoint để tạo resource mới.
    
    Args:
        body: Resource data
        request: HTTP request
        gateway_service: Gateway service
        
    Returns:
        ProxyResponse
    """
    try:
        result = await gateway_service.create_resource(body)
        return ProxyResponse(status=201, data=result)
    except Exception as e:
        return ProxyResponse(status=500, message=str(e))


