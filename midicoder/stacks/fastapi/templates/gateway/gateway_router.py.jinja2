        return ProxyResponse(status=500, message=str(e))


# Proxy catch-all route
@router.api_route("/{path:path}", methods=["GET", "POST", "PUT", "DELETE", "PATCH"])
async def proxy_route(
    path: str = Path(..., description="Proxy path"),
    request: Request = None,
    response: Response = None,
    gateway_service: GatewayService = Depends(get_gateway_service),
    rate_limiter: RateLimiter = Depends(get_rate_limiter),
):
    """
    Proxy catch-all route.
    
    Proxy tất cả requests đến backend services.
    
    Args:
        path: Proxy path
        request: HTTP request
        response: HTTP response
        gateway_service: Gateway service
        rate_limiter: Rate limiter
        
    Returns:
        Response
    """
    try:
        # Check rate limit
        await check_rate_limit(request, rate_limiter)
        
        # Forward to backend
        result = await gateway_service.proxy(request, path)
        
        return Response(
            content=result,
            status_code=200,
            media_type="application/json",
        )
    except Exception as e:
        return JSONResponse(
            status_code=500,
            content={"detail": str(e)},
        )