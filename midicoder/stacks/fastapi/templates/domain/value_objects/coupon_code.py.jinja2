        # Validate coupon code format
        if not self.code or not self.code.strip():
            raise ValueError("Mã giảm giá không được để trống")
        
        # Coupon code should be alphanumeric with optional hyphens
        if not re.match(r'^[A-Z0-9-]{4,30}$', self.code.upper()):
            raise ValueError("Mã giảm giá chỉ chứa chữ hoa, số, gạch ngang (4-30 ký tự)")
    
    @property
    def normalized(self) -> str:
        """Trả về code chuẩn hóa (uppercase)."""
        return self.code.upper()
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị (case-insensitive)."""
        if not isinstance(other, CouponCode):
            return False
        return self.code.upper() == other.code.upper()
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash(self.code.upper())
    
    def get_tenant_id(self) -> str | None:
        """
        KPI-029: Lấy tenant_id nếu VO có tenant context.
        
        Returns:
            Tenant ID nếu có, None nếu không
        """
        return None

    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "code": self.code,
            "normalized": self.normalized
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "CouponCode":
        """Tạo CouponCode từ dictionary."""
        return cls(code=data.get("code", data.get("normalized")))
    
    def __str__(self) -> str:
        """String representation."""
        return self.normalized
    
