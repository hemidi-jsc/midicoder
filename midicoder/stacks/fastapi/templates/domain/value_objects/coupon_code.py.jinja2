from dataclasses import dataclass
import re


@dataclass(frozen=True)
class CouponCode:
    """
    Mã mã giảm giá.
    
    Attributes:
        code: Mã giảm giá duy nhất
    
    Raises:
        ValueError: Nếu code không hợp lệ
