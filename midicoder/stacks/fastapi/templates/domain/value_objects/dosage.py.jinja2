from dataclasses import dataclass
from decimal import Decimal
from typing import Optional

# ============================================================================
# Dosage Unit Enum
# ============================================================================


class DosageUnit(str):
    """Đơn vị liều lượng thuốc."""

    MILLIGRAM = "mg"
    MICROGRAM = "mcg"
    GRAM = "g"
    LITER = "L"
    MILLILITER = "mL"
    INTERNATIONAL_UNIT = "IU"
    PERCENT = "%"
    DROP = "drop"


# ============================================================================
# Dosage Value Object
# ============================================================================


@dataclass(frozen=True)
class Dosage:
    """
    Dosage Value Object.

    Đại diện cho liều lượng thuốc với đơn vị và giới hạn an toàn.
    Support dosage calculation và validation.

    Attributes:
        amount: Liều lượng (decimal)
        unit: Đơn vị (DosageUnit)
        frequency: Tần suất (lần/ngày, optional)
        duration_days: Thời gian (số ngày, optional)
        max_daily_dose: Liều tối đa/ngày (optional, cho safety)
        min_daily_dose: Liều tối thiểu/ngày (optional, cho safety)

    Raises:
        ValueError: Nếu validation thất bại

    Examples:
        >>> Dosage(amount=Decimal("500"), unit=DosageUnit.MILLIGRAM, frequency=2)
        >>> Dosage(amount=Decimal("10"), unit=DosageUnit.MILLILITER)
    """

    amount: Decimal
    unit: DosageUnit
    frequency: Optional[int] = None
    duration_days: Optional[int] = None
    max_daily_dose: Optional[Decimal] = None
    min_daily_dose: Optional[Decimal] = None

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate amount là trường bắt buộc
        if self.amount is None:
            raise ValueError("amount là trường bắt buộc")

        # Validate amount > 0
        if self.amount <= 0:
            raise ValueError("amount phải lớn hơn 0")

        # Validate unit là valid DosageUnit
        valid_units = [u.value for u in DosageUnit]
        if self.unit not in valid_units:
            raise ValueError(f"unit phải là giá trị hợp lệ: {valid_units}")

        # Validate frequency (nếu có)
        if self.frequency is not None:
            if self.frequency < 1 or self.frequency > 24:
                raise ValueError("frequency phải trong khoảng 1-24 lần/ngày")

        # Validate duration_days (nếu có)
        if self.duration_days is not None:
            if self.duration_days < 1:
                raise ValueError("duration_days phải lớn hơn 0")

        # Validate daily dose limits (nếu có)
        if self.max_daily_dose is not None:
            if self.max_daily_dose <= 0:
                raise ValueError("max_daily_dose phải lớn hơn 0")

        if self.min_daily_dose is not None:
            if self.min_daily_dose < 0:
                raise ValueError("min_daily_dose không thể âm")

        # Validate max > min (nếu cả hai đều có)
        if self.max_daily_dose and self.min_daily_dose:
            if self.max_daily_dose < self.min_daily_dose:
                raise ValueError("max_daily_dose phải lớn hơn min_daily_dose")

    @property
    def daily_dose(self) -> Decimal:
        """
        Tính liều hàng ngày.

        Returns:
            Liều lượng hàng ngày (amount * frequency)
        """
        freq = self.frequency or 1
        return self.amount * Decimal(freq)

    def is_within_safe_range(self) -> bool:
        """
        Kiểm tra xem liều có trong khoảng an toàn không.

        Returns:
            True nếu trong khoảng an toàn, False nếu không
        """
        daily = self.daily_dose

        if self.min_daily_dose is not None and daily < self.min_daily_dose:
            return False

        if self.max_daily_dose is not None and daily > self.max_daily_dose:
            return False

        return True

    def is_exceeding_max(self) -> bool:
        """
        Kiểm tra xem liều có vượt quá max không.

        Returns:
            True nếu vượt quá, False nếu không
        """
        if self.max_daily_dose is None:
            return False
        return self.daily_dose > self.max_daily_dose

    def convert_to(self, target_unit: DosageUnit) -> "Dosage":
        """
        Chuyển đổi đơn vị liều lượng.

        Args:
            target_unit: Đơn vị đích

        Returns:
            Dosage mới với đơn vị đã chuyển đổi
        """
        # Conversion factors to base unit (mg)
        to_base = {
            DosageUnit.MILLIGRAM: Decimal("1"),
            DosageUnit.MICROGRAM: Decimal("0.001"),
            DosageUnit.GRAM: Decimal("1000"),
            DosageUnit.MILLILITER: Decimal("1"),  # Assumes 1mL = 1mg for aqueous
            DosageUnit.LITER: Decimal("1000000"),
        }

        if self.unit not in to_base or target_unit not in to_base:
            raise ValueError(f"Cannot convert between {self.unit} and {target_unit}")

        # Convert to base, then to target
        base_amount = self.amount * to_base[self.unit]
        target_amount = base_amount / to_base[target_unit]

        return Dosage(
            amount=target_amount.quantize(Decimal("0.001")),
            unit=target_unit,
            frequency=self.frequency,
            duration_days=self.duration_days,
            max_daily_dose=self.max_daily_dose,
            min_daily_dose=self.min_daily_dose,
        )

    def get_total_course_dose(self) -> Optional[Decimal]:
        """
        Tính tổng liều cho toàn bộ疗程.

        Returns:
            Tổng liều hoặc None nếu không có duration
        """
        if self.duration_days is None:
            return None
        return self.daily_dose * Decimal(self.duration_days)

    def format(self, locale: str = "vi_VN") -> str:
        """
        Format liều lượng thành string.

        Args:
            locale: Locale (default: vi_VN)

        Returns:
            Formatted string
        """
        parts = [f"{self.amount} {self.unit}"]

        if self.frequency:
            parts.append(f"{self.frequency} lần/ngày")

        if self.duration_days:
            parts.append(f"{self.duration_days} ngày")

        return ", ".join(parts)

    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "amount": str(self.amount),
            "unit": self.unit,
            "frequency": self.frequency,
            "duration_days": self.duration_days,
            "max_daily_dose": str(self.max_daily_dose) if self.max_daily_dose else None,
            "min_daily_dose": str(self.min_daily_dose) if self.min_daily_dose else None,
        }

    @classmethod
    def from_dict(cls, data: dict) -> "Dosage":
        """Tạo Dosage từ dictionary."""
        return cls(
            amount=Decimal(str(data["amount"])),
            unit=data["unit"],
            frequency=data.get("frequency"),
            duration_days=data.get("duration_days"),
            max_daily_dose=Decimal(str(data["max_daily_dose"])) if data.get("max_daily_dose") else None,
            min_daily_dose=Decimal(str(data["min_daily_dose"])) if data.get("min_daily_dose") else None,
        )

    def __str__(self) -> str:
        """String representation."""
        return self.format()

    def __repr__(self) -> str:
        """Debug representation."""
        return f"Dosage(amount={self.amount!r}, unit={self.unit!r})"

    def __hash__(self) -> int:
        """Hash cho frozen Value Object."""
        return hash((self.amount, self.unit, self.frequency))

    def __eq__(self, other: object) -> bool:
        """So sánh equality."""
        if not isinstance(other, Dosage):
            return False
        return (
            self.amount == other.amount
            and self.unit == other.unit
            and self.frequency == other.frequency
        )