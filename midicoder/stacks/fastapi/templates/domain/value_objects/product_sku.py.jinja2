from dataclasses import dataclass
import re


@dataclass(frozen=True)
class ProductSKU:
    """
    Mã sản phẩm (SKU - Stock Keeping Unit).
    
    Attributes:
        sku: Mã SKU duy nhất cho sản phẩm
    
    Raises:
        ValueError: Nếu SKU không hợp lệ
    """
    
    sku: str
    
    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate SKU format
        if not self.sku or not self.sku.strip():
            raise ValueError("SKU không được để trống")
        
        # SKU should be alphanumeric with optional hyphens/underscores
        if not re.match(r'^[A-Za-z0-9_-]{3,50}$', self.sku):
            raise ValueError("SKU chỉ chứa chữ, số, gạch ngang và gạch dưới (3-50 ký tự)")
    
    @property
    def normalized_sku(self) -> str:
        """Trả về SKU chuẩn hóa (uppercase)."""
        return self.sku.upper()
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị (case-insensitive)."""
        if not isinstance(other, ProductSKU):
            return False
        return self.sku.upper() == other.sku.upper()
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash(self.sku.upper())
    
    def get_tenant_id(self) -> str | None:
        """
        KPI-029: Lấy tenant_id nếu VO có tenant context.
        
        Returns:
            Tenant ID nếu có, None nếu không
        """
        return None

    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "sku": self.sku,
            "normalized_sku": self.normalized_sku
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "ProductSKU":
        """Tạo ProductSKU từ dictionary."""
        return cls(sku=data.get("sku", data.get("normalized_sku")))
    
    def __str__(self) -> str:
        """String representation."""
        return self.normalized_sku
    
    def __repr__(self) -> str:
        """Debug representation."""
        return f"ProductSKU(sku={self.sku!r})"