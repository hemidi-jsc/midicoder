from dataclasses import dataclass
from datetime import date
from decimal import Decimal
from typing import Optional

# ============================================================================
# Interest Rate Type Enum
# ============================================================================


class InterestRateType(str):
    """Loại lãi suất."""

    FIXED = "fixed"  # Lãi suất cố định
    VARIABLE = "variable"  # Lãi suất thả nổi
    COMPOUND = "compound"  # Lãi kép
    SIMPLE = "simple"  # Lãi đơn


# ============================================================================
# Interest Rate Value Object
# ============================================================================


@dataclass(frozen=True)
class InterestRate:
    """
    InterestRate Value Object.

    Đại diện cho lãi suất với loại và thời gian áp dụng.
    Support interest calculation (simple và compound).

    Attributes:
        rate: Tỷ lệ phần trăm (ví dụ: Decimal("5.5") = 5.5%)
        rate_type: Loại lãi suất (InterestRateType)
        currency: Mã tiền tệ (ISO 4217)
        effective_from: Ngày hiệu lực
        effective_to: Ngày hết hiệu lực (optional)
        compounding_periods: Số kỳ ghép lãi/năm (đối với compound interest)

    Raises:
        ValueError: Nếu validation thất bại
    """

    rate: Decimal
    rate_type: InterestRateType
    currency: str
    effective_from: date
    effective_to: Optional[date] = None
    compounding_periods: int = 12  # Monthly by default

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        if self.rate is None:
            raise ValueError("rate là trường bắt buộc")

        if self.rate < 0:
            raise ValueError("rate không thể âm")

        valid_types = [t.value for t in InterestRateType]
        if self.rate_type not in valid_types:
            raise ValueError(f"rate_type phải là giá trị hợp lệ: {valid_types}")

        import re
        if not re.match(r'^[A-Z]{3}$', self.currency):
            raise ValueError("currency phải là mã ISO 4217 hợp lệ")

        if self.effective_from is None:
            raise ValueError("effective_from là trường bắt buộc")

        if self.effective_to is not None:
            if self.effective_to < self.effective_from:
                raise ValueError("effective_to phải sau hoặc bằng effective_from")

        if self.compounding_periods < 1:
            raise ValueError("compounding_periods phải lớn hơn 0")

    @property
    def is_active(self) -> bool:
        """Kiểm tra xem lãi suất có còn hiệu lực không."""
        today = date.today()
        if today < self.effective_from:
            return False
        if self.effective_to and today > self.effective_to:
            return False
        return True

    def calculate_simple_interest(self, principal: Decimal, years: Decimal) -> Decimal:
        """
        Tính lãi đơn.

        Formula: I = P × r × t

        Args:
            principal: Số tiền gốc
            years: Số năm

        Returns:
            Số lãi (decimal)
        """
        return principal * (self.rate / Decimal("100")) * years

    def calculate_compound_interest(
        self, principal: Decimal, years: Decimal
    ) -> Decimal:
        """
        Tính lãi kép.

        Formula: A = P(1 + r/n)^(nt)
        Interest = A - P

        Args:
            principal: Số tiền gốc
            years: Số năm

        Returns:
            Số lãi (decimal)
        """
        r = self.rate / Decimal("100")
        n = Decimal(self.compounding_periods)
        t = years

        amount = principal * ((Decimal("1") + r / n) ** (n * t))
        return amount - principal

    def get_effective_annual_rate(self) -> Decimal:
        """
        Tính effective annual rate (EAR).

        Formula: EAR = (1 + r/n)^n - 1

        Returns:
            EAR (percentage)
        """
        r = self.rate / Decimal("100")
        n = Decimal(self.compounding_periods)

        ear = ((Decimal("1") + r / n) ** n) - Decimal("1")
        return (ear * Decimal("100")).quantize(Decimal("0.01"))

    def format(self) -> str:
        """Format lãi suất thành string."""
        return f"{self.rate}% {self.rate_type}/{self.currency}"

    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "rate": str(self.rate),
            "rate_type": self.rate_type,
            "currency": self.currency,
            "effective_from": self.effective_from.isoformat(),
            "effective_to": self.effective_to.isoformat() if self.effective_to else None,
            "compounding_periods": self.compounding_periods,
        }

    @classmethod
    def from_dict(cls, data: dict) -> "InterestRate":
        """Tạo InterestRate từ dictionary."""
        return cls(
            rate=Decimal(str(data["rate"])),
            rate_type=data["rate_type"],
            currency=data["currency"],
            effective_from=date.fromisoformat(data["effective_from"]),
            effective_to=date.fromisoformat(data["effective_to"]) if data.get("effective_to") else None,
            compounding_periods=data.get("compounding_periods", 12),
        )

    def __str__(self) -> str:
        """String representation."""
        return self.format()

    def __repr__(self) -> str:
        """Debug representation."""
        return f"InterestRate(rate={self.rate!r}, type={self.rate_type!r})"

    def __hash__(self) -> int:
        """Hash cho frozen Value Object."""
        return hash((self.rate, self.rate_type, self.currency, self.effective_from))

    def __eq__(self, other: object) -> bool:
        """So sánh equality."""
        if not isinstance(other, InterestRate):
            return False
        return (
            self.rate == other.rate
            and self.rate_type == other.rate_type
            and self.currency == other.currency
        )