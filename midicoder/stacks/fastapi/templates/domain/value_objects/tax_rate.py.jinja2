    def apply_to(self, amount: Decimal) -> Decimal:
        """
        Tính thuế cho số tiền.
        
        Args:
            amount: Số tiền tính thuế
            
        Returns:
            Số tiền thuế
        """
        return amount * self.decimal_value
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, TaxRate):
            return False
        return self.rate == other.rate and self.name.lower() == other.name.lower()
    
