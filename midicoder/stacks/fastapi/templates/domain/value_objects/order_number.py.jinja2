from dataclasses import dataclass
import re
from datetime import datetime


@dataclass(frozen=True)
class OrderNumber:
    """
    Mã đơn hàng.
    
    Attributes:
        order_number: Mã đơn hàng duy nhất
    
    Raises:
        ValueError: Nếu order_number không hợp lệ
    """
    
    order_number: str
    
    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate order_number format
        if not self.order_number or not self.order_number.strip():
            raise ValueError("Mã đơn hàng không được để trống")
        
        # Order number should be alphanumeric
        if not re.match(r'^[A-Z0-9_-]{6,20}$', self.order_number.upper()):
            raise ValueError("Mã đơn hàng chỉ chứa chữ hoa, số, gạch ngang (6-20 ký tự)")
    
    @property
    def normalized(self) -> str:
        """Trả về order number chuẩn hóa (uppercase)."""
        return self.order_number.upper()
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị (case-insensitive)."""
        if not isinstance(other, OrderNumber):
            return False
        return self.order_number.upper() == other.order_number.upper()
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash(self.order_number.upper())
    
    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "order_number": self.order_number,
            "normalized": self.normalized
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "OrderNumber":
        """Tạo OrderNumber từ dictionary."""
        return cls(order_number=data.get("order_number", data.get("normalized")))
    
    @classmethod
    def generate(cls, prefix: str = "ORD") -> "OrderNumber":
        """
        Tạo order number mới.
        
        Args:
            prefix: Tiền tố (mặc định: ORD)
            
        Returns:
            OrderNumber mới
        """
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        import random
        suffix = ''.join(random.choices('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', k=4))
        order_num = f"{prefix}-{timestamp}-{suffix}"
        return cls(order_number=order_num)
    
    def __str__(self) -> str:
        """String representation."""
        return self.normalized
    
    def __repr__(self) -> str:
        """Debug representation."""
        return f"OrderNumber(order_number={self.order_number!r})"