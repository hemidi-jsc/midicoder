        """
        return cls(
            amount=Decimal(str(data["amount"])),
            currency=data["currency"],
            inclusive_tax=data.get("inclusive_tax", False),
            # KPI-029: tenant_id là optional, default=None
            tenant_id=data.get("tenant_id"),
        )
    
    def __str__(self) -> str:
        """String representation."""
        tax_info = "(bao gồm thuế)" if self.inclusive_tax else "(chưa bao gồm thuế)"
        return f"{self.amount} {self.currency} {tax_info}"
    
    def __repr__(self) -> str:
        """Debug representation."""
        return f"Price(amount={self.amount!r}, currency={self.currency!r}, inclusive_tax={self.inclusive_tax!r})"