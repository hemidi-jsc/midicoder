from dataclasses import dataclass, field
from decimal import Decimal
from typing import Optional


@dataclass(frozen=True)
class Price:
    """
    Giá sản phẩm với thông tin thuế.
    
    Attributes:
        amount: Số tiền
        currency: Mã tiền tệ (3 ký tự)
        inclusive_tax: Có bao gồm thuế hay không
    
    Raises:
        ValueError: Nếu amount < 0 hoặc currency không hợp lệ
    """
    
    amount: Decimal
    currency: str
    inclusive_tax: bool = False

    # KPI-029: Tenant ID cho multi-tenant isolation
    # - Optional field, default=None cho backward compatibility
    # - repr=False: Không hiển thị trong __repr__
    # - compare=False: Không ảnh hưởng đến __eq__ và __hash__
    tenant_id: Optional[str] = field(default=None, repr=False, compare=False)

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate amount >= 0
        if self.amount < 0:
            raise ValueError("Giá không thể âm")
        
        # Validate currency format
        if not self.currency or len(self.currency) != 3:
            raise ValueError("Mã tiền tệ phải là 3 ký tự")
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, Price):
            return False
        return (self.amount == other.amount 
                and self.currency == other.currency 
                and self.inclusive_tax == other.inclusive_tax)
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash((self.amount, self.currency, self.inclusive_tax))
    
    def get_tenant_id(self) -> str | None:
        """
        KPI-029: Lấy tenant ID từ Price.
        
        Returns:
            Tenant ID nếu có, None nếu không
        """
        return self.tenant_id

    def with_tenant(self, tenant_id: str) -> "Price":
        """
        KPI-029: Tạo copy của Price với tenant_id mới.
        
        Đây là phương pháp functional cho tenant context propagation.
        Original VO không thay đổi (frozen=True).
        
        Args:
            tenant_id: Tenant ID để set vào copy
            
        Returns:
            Copy của Price với tenant_id mới, giữ nguyên các fields khác
        """
        from dataclasses import replace
        return replace(self, tenant_id=tenant_id)

    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "amount": str(self.amount),
            "currency": self.currency,
            "inclusive_tax": self.inclusive_tax
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "Price":
        """
