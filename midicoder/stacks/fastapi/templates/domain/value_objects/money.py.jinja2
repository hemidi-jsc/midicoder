from dataclasses import dataclass
from decimal import Decimal


@dataclass(frozen=True)
class Money:
    """
    Tiền tệ với số dư và loại tiền.
    
    Attributes:
        amount: Số tiền (luôn >= 0)
        currency: Mã tiền tệ (3 ký tự, ví dụ: USD, VND)
    
    Raises:
        ValueError: Nếu amount < 0 hoặc currency không hợp lệ
    """
    
    amount: Decimal
    currency: str
    
    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate amount >= 0
        if self.amount < 0:
            raise ValueError("Số tiền không thể âm")
        
        # Validate currency format (3 uppercase letters)
        if not self.currency or len(self.currency) != 3:
            raise ValueError("Mã tiền tệ phải là 3 ký tự")
        
        # Validate currency pattern
        import re
        if not re.match(r'^[A-Z]{3}$', self.currency):
            raise ValueError("Mã tiền tệ không đúng định dạng: ^[A-Z]{3}$")
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, Money):
            return False
        return self.amount == other.amount and self.currency == other.currency
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash((self.amount, self.currency))
    
    def __add__(self, other: "Money") -> "Money":
        """
        Cộng hai Money cùng currency.
        
        Args:
            other: Money khác để cộng
            
        Returns:
            Money mới với tổng amount
            
        Raises:
            ValueError: Nếu currency khác nhau
        """
        if self.currency != other.currency:
            raise ValueError("Không thể cộng tiền tệ khác nhau")
        return Money(amount=self.amount + other.amount, currency=self.currency)
    
    def __sub__(self, other: "Money") -> "Money":
        """Trừ hai Money cùng currency."""
        if self.currency != other.currency:
            raise ValueError("Không thể trừ tiền tệ khác nhau")
        return Money(amount=self.amount - other.amount, currency=self.currency)
    
    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "amount": str(self.amount),
            "currency": self.currency
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "Money":
        """Tạo Money từ dictionary."""
        return cls(
            amount=Decimal(str(data["amount"])),
            currency=data["currency"]
        )
    
    def __str__(self) -> str:
        """String representation."""
        return f"{self.amount} {self.currency}"
    
    def __repr__(self) -> str:
        """Debug representation."""
        return f"Money(amount={self.amount!r}, currency={self.currency!r})"