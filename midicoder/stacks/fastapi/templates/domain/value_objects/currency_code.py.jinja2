from dataclasses import dataclass
import re


@dataclass(frozen=True)
class CurrencyCode:
    """
    Mã tiền tệ (ISO 4217).
    
    Attributes:
        code: Mã tiền tệ 3 ký tự (ví dụ: USD, VND, EUR)
        symbol: Ký hiệu tiền tệ (ví dụ: $, ₫, €)
    
    Raises:
        ValueError: Nếu code không hợp lệ
    """
    
    code: str
    symbol: str = ""
    
    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate currency code format (3 uppercase letters)
        if not self.code or not re.match(r'^[A-Z]{3}$', self.code):
            raise ValueError("Mã tiền tệ phải là 3 ký tự hoa (ISO 4217)")
        
        # Validate symbol (optional)
        if self.symbol and not re.match(r'^[^\s]{1,5}$', self.symbol):
            raise ValueError("Ký hiệu tiền tệ không hợp lệ")
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, CurrencyCode):
            return False
        return self.code == other.code
    
    def __hash__(self) -> int:
        """Hash cho comparable Value Object."""
        return hash(self.code)
    
    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "code": self.code,
            "symbol": self.symbol
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "CurrencyCode":
        """Tạo CurrencyCode từ dictionary."""
        return cls(
            code=data["code"].upper(),
            symbol=data.get("symbol", "")
        )
    
    def __str__(self) -> str:
        """String representation."""
        return self.code
    
    def __repr__(self) -> str:
        """Debug representation."""
        return f"CurrencyCode(code={self.code!r}, symbol={self.symbol!r})"


