from dataclasses import dataclass
from typing import Optional

# ============================================================================
# Address Value Object
# ============================================================================


@dataclass(frozen=True)
class Address:
    """
    Address Value Object.

    Đại diện cho địa chỉ với support cho Vietnam và International formats.
    Support geocoding và address validation.

    Attributes:
        street: Số nhà, đường
        ward: Phường/Xã
        district: Quận/Huyện
        city: Thành phố/Tỉnh
        postal_code: Mã bưu chính (optional)
        country: Mã quốc gia ISO 3166-1 alpha-2 (default: VN)
        latitude: Vĩ độ (optional, cho geocoding)
        longitude: Kinh độ (optional, cho geocoding)

    Raises:
        ValueError: Nếu validation thất bại

    Examples:
        >>> Address(
        ...     street="123 Lê Lợi",
        ...     ward="Bến Nghé",
        ...     district="Quận 1",
        ...     city="TP. Hồ Chí Minh",
        ...     country="VN"
        ... )
    """

    street: str
    ward: str
    district: str
    city: str
    postal_code: Optional[str] = None
    country: str = "VN"
    latitude: Optional[float] = None
    longitude: Optional[float] = None

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate required fields
        if not self.street or not self.street.strip():
            raise ValueError("street là trường bắt buộc")

        if not self.ward or not self.ward.strip():
            raise ValueError("ward là trường bắt buộc")

        if not self.district or not self.district.strip():
            raise ValueError("district là trường bắt buộc")

        if not self.city or not self.city.strip():
            raise ValueError("city là trường bắt buộc")

        # Validate country format (ISO 3166-1 alpha-2)
        import re
        if not re.match(r'^[A-Z]{2}$', self.country):
            raise ValueError("country phải là mã ISO 3166-1 alpha-2 (2 chữ cái viết hoa)")

        # Validate postal code format (nếu có)
        if self.postal_code:
            if not re.match(r'^\d{5,6}$', self.postal_code):
                raise ValueError("postal_code phải là 5-6 chữ số")

        # Validate latitude (nếu có)
        if self.latitude is not None:
            if not -90 <= self.latitude <= 90:
                raise ValueError("latitude phải trong khoảng -90 đến 90")

        # Validate longitude (nếu có)
        if self.longitude is not None:
            if not -180 <= self.longitude <= 180:
                raise ValueError("longitude phải trong khoảng -180 đến 180")

    @property
    def has_coordinates(self) -> bool:
        """Kiểm tra xem có tọa độ không."""
        return self.latitude is not None and self.longitude is not None

    @property
    def province(self) -> str:
        """Alias cho city (để compatibility)."""
        return self.city

    def get_full_address(self, format: str = "vn") -> str:
        """
        Get địa chỉ đầy đủ theo format.

        Args:
            format: Format (vn: Vietnam format, int: International format)

        Returns:
            Full address string
        """
        if format == "vn":
            # Vietnam format: Street, Ward, District, City, Country
            return f"{self.street}, {self.ward}, {self.district}, {self.city}, {self.country}"
        else:
            # International format: Street, Ward, District, City, PostalCode, Country
            postal = f", {self.postal_code}" if self.postal_code else ""
            return f"{self.street}, {self.ward}, {self.district}, {self.city}{postal}, {self.country}"

    def get_short_address(self) -> str:
        """
        Get địa chỉ ngắn gọn.

        Returns:
            Short address string
        """
        return f"{self.street}, {self.district}, {self.city}"

    def get_coordinates(self) -> Optional[tuple[float, float]]:
        """
        Get tọa độ (latitude, longitude).

        Returns:
            Tuple (lat, lng) hoặc None nếu không có
        """
        if self.has_coordinates:
            return (self.latitude, self.longitude)
        return None

    def is_in_vietnam(self) -> bool:
        """Kiểm tra xem địa chỉ có ở Việt Nam không."""
        return self.country == "VN"

    def distance_to(self, other: "Address") -> Optional[float]:
        """
        Tính khoảng cách đến địa chỉ khác (km).

        Sử dụng Haversine formula.

        Args:
            other: Address khác

        Returns:
            Khoảng cách (km) hoặc None nếu thiếu tọa độ
        """
        if not self.has_coordinates or not other.has_coordinates:
            return None

        import math

        # Haversine formula
        lat1, lon1 = math.radians(self.latitude), math.radians(self.longitude)
        lat2, lon2 = math.radians(other.latitude), math.radians(other.longitude)

        dlat = lat2 - lat1
        dlon = lon2 - lon1

        a = math.sin(dlat / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
        c = 2 * math.asin(math.sqrt(a))

        # Earth radius in km
        return 6371 * c

    def to_dict(self) -> dict:
        """
        Chuyển thành dictionary.
        
        KPI-029: to_dict() có thể bao gồm tenant_id nếu được set.
        """
        return {
            "street": self.street,
            "ward": self.ward,
            "district": self.district,
            "city": self.city,
            "postal_code": self.postal_code,
            "country": self.country,
            "latitude": self.latitude,
            "longitude": self.longitude,
        }

    def get_tenant_id(self) -> str | None:
        """
        KPI-029: Lấy tenant_id nếu VO có tenant context.
        
        Returns:
            Tenant ID nếu có, None nếu không
        """
        # KPI-029: Value Objects thường không có tenant_id trực tiếp
        # nhưng có thể được sử dụng trong tenant context
        return None

    @classmethod
    def from_dict(cls, data: dict) -> "Address":
        """Tạo Address từ dictionary."""
        return cls(
            street=data["street"],
            ward=data["ward"],
            district=data["district"],
            city=data["city"],
            postal_code=data.get("postal_code"),
            country=data.get("country", "VN"),
            latitude=data.get("latitude"),
            longitude=data.get("longitude"),
        )

    def __str__(self) -> str:
        """String representation."""
        return self.get_full_address()

    def __repr__(self) -> str:
        """Debug representation."""
        return f"Address(street={self.street!r}, city={self.city!r}, country={self.country!r})"

    def __hash__(self) -> int:
        """Hash cho frozen Value Object."""
        return hash((self.street, self.ward, self.district, self.city, self.country))

    def __eq__(self, other: object) -> bool:
        """So sánh equality."""
        if not isinstance(other, Address):
            return False
        return (
            self.street == other.street
            and self.ward == other.ward
            and self.district == other.district
            and self.city == other.city
            and self.country == other.country
        )