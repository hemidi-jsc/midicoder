from dataclasses import dataclass


@dataclass(frozen=True)
class Address:
    """
    Địa chỉ liên hệ.
    
    Attributes:
        street: Số nhà, tên đường
        ward: Phường/Xã
        district: Quận/Huyện
        city: Thành phố/Tỉnh
        postal_code: Mã bưu điện (tuỳ chọn)
        country: Quốc gia (mặc định: VN)
    
    Raises:
        ValueError: Nếu trường bắt buộc thiếu
    """
    
    street: str
    ward: str
    district: str
    city: str
    postal_code: str = ""
    country: str = "VN"
    
    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate required fields
        if not self.street or not self.street.strip():
            raise ValueError("Đường phố là bắt buộc")
        
        if not self.ward or not self.ward.strip():
            raise ValueError("Phường/Xã là bắt buộc")
        
        if not self.district or not self.district.strip():
            raise ValueError("Quận/Huyện là bắt buộc")
        
        if not self.city or not self.city.strip():
            raise ValueError("Thành phố/Tỉnh là bắt buộc")
        
        # Validate postal_code (Vietnam: 6 digits)
        if self.postal_code and not self.postal_code.isdigit() or len(self.postal_code) != 6:
            if self.postal_code and (not self.postal_code.isdigit() or len(self.postal_code) not in [5, 6]):
                raise ValueError("Mã bưu điện không hợp lệ")
    
    @property
    def full_address(self) -> str:
        """Trả về địa chỉ đầy đủ."""
        parts = [self.street, self.ward, self.district, self.city]
        if self.postal_code:
            parts.append(self.postal_code)
        if self.country != "VN":
            parts.append(self.country)
        return ", ".join(parts)
    
    def __eq__(self, other: object) -> bool:
        """So sánh bằng dựa trên giá trị."""
        if not isinstance(other, Address):
            return False
        return (self.street.lower() == other.street.lower()
                and self.ward.lower() == other.ward.lower()
                and self.district.lower() == other.district.lower()
                and self.city.lower() == other.city.lower()
                and self.country.lower() == other.country.lower())
    
    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "street": self.street,
            "ward": self.ward,
            "district": self.district,
            "city": self.city,
            "postal_code": self.postal_code,
            "country": self.country,
            "full_address": self.full_address
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> "Address":
        """Tạo Address từ dictionary."""
        return cls(
            street=data["street"],
            ward=data["ward"],
            district=data["district"],
            city=data["city"],
            postal_code=data.get("postal_code", ""),
            country=data.get("country", "VN")
        )
    
    def __str__(self) -> str:
        """String representation."""
        return self.full_address
    
    def __repr__(self) -> str:
        """Debug representation."""
        return (f"Address(street={self.street!r}, ward={self.ward!r}, "
                f"district={self.district!r}, city={self.city!r}, "
                f"postal_code={self.postal_code!r}, country={self.country!r})")