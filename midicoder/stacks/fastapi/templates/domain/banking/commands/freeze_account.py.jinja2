"""
Freeze Account Command

Đóng băng tài khoản.
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from typing import Any

from ....errors import ErrorCode, MidicoderErrorManager as EM
from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.account import Account, AccountStatus


@dataclass
class FreezeAccountInput:
    """Input cho lệnh đóng băng tài khoản."""
    account_id: str
    reason: str = ""


@dataclass
class FreezeAccountOutput:
    """Output của lệnh đóng băng."""
    account_id: str
    status: str
    frozen_at: datetime


class FreezeAccountCommand(BaseCommand):
    """FreezeAccount command.

    Guards:
    - tenant_scope, auth_required, permission: banking:account:freeze
    """

    name = "banking.freeze_account"
    description = "Đóng băng tài khoản"

    guards = [
        CommandGuards.tenant_scope,
        CommandGuards.auth_required,
        CommandGuards.permission("banking:account:freeze"),
    ]

    effects = ["update_record", "write_audit_log", "publish_event"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> FreezeAccountInput:
        """Validate input data."""
        validator = CommandValidator(data)
        validator.require_string("account_id", min_length=1)

        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")

        return FreezeAccountInput(
            account_id=data["account_id"],
            reason=data.get("reason", ""),
        )

    def execute(self, input_data: FreezeAccountInput, context: dict[str, Any]) -> FreezeAccountOutput:
        """Execute freeze account command."""
        db_session = context["db_session"]
        tenant_id = context["tenant_id"]

        account = db_session.query(Account).filter(
            Account.id == input_data.account_id,
            Account.tenant_id == tenant_id,
        ).first()

        if not account:
            EM.raise_error(ErrorCode.CP01_ENTITY_NOT_FOUND, entity="Account", id=input_data.account_id)

        account.freeze()
        db_session.commit()

        return FreezeAccountOutput(
            account_id=account.id,
            status=account.status.value,
            frozen_at=datetime.utcnow(),
        )