"""
Reconcile Account Command

Đối chiếu tài khoản hàng ngày.
RX02: Daily reconciliation mandatory.
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from decimal import Decimal
from typing import Any

from ....errors import ErrorCode, MidicoderErrorManager as EM
from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.reconciliation import Reconciliation, ReconciliationStatus


@dataclass
class ReconcileAccountInput:
    """Input cho lệnh đối chiếu."""
    reconciliation_date: str
    account_id: str
    external_balance: Decimal


@dataclass
class ReconcileAccountOutput:
    """Output của lệnh đối chiếu."""
    reconciliation_id: str
    status: str
    is_matched: bool
    variance: Decimal


class ReconcileAccountCommand(BaseCommand):
    """ReconcileAccount command.

    Lệnh đối chiếu tài khoản hàng ngày.

    Guards:
    - tenant_scope: KPI-029 multi-tenant isolation
    - auth_required: Phải đăng nhập
    - permission: Cần quyền banking:reconcile

    RX02 Compliance:
    - Daily reconciliation mandatory
    - Variance phải được investigate
    """

    name = "banking.reconcile_account"
    description = "Đối chiếu tài khoản hàng ngày"

    guards = [
        CommandGuards.tenant_scope,
        CommandGuards.auth_required,
        CommandGuards.permission("banking:reconcile"),
    ]

    effects = [
        "reconciliation_variance_check",
        "write_audit_log",
    ]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> ReconcileAccountInput:
        """Validate input data."""
        validator = CommandValidator(data)
        validator.require_string("reconciliation_date", min_length=1)
        validator.require_string("account_id", min_length=1)
        validator.require_decimal("external_balance")

        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")

        return ReconcileAccountInput(
            reconciliation_date=data["reconciliation_date"],
            account_id=data["account_id"],
            external_balance=Decimal(str(data["external_balance"])),
        )

    def execute(self, input_data: ReconcileAccountInput, context: dict[str, Any]) -> ReconcileAccountOutput:
        """Execute reconcile account command.

        Args:
            input_data: Input data đã được validate
            context: Context với tenant_id, user_id, db_session

        Returns:
            ReconcileAccountOutput với reconciliation_id và status

        Raises:
            MidicoderError: Nếu account không tồn tại
        """
        db_session = context["db_session"]
        tenant_id = context["tenant_id"]

        # Load account
        from ...entities.account import Account
        account = db_session.query(Account).filter(
            Account.id == input_data.account_id,
            Account.tenant_id == tenant_id,
        ).first()

        if not account:
            EM.raise_error(ErrorCode.CP01_ENTITY_NOT_FOUND, entity="Account", id=input_data.account_id)

        # Tính variance
        variance = account.balance - input_data.external_balance
        is_matched = variance == Decimal("0.00")

        # Tạo reconciliation record
        reconciliation = Reconciliation(
            reconciliation_id=f"REC_{input_data.reconciliation_date}_{input_data.account_id}",
            reconciliation_date=datetime.strptime(input_data.reconciliation_date, "%Y-%m-%d").date(),
            account_id=input_data.account_id,
            status=ReconciliationStatus.COMPLETED if is_matched else ReconciliationStatus.VARIANCE_FOUND,
            internal_balance=account.balance,
            external_balance=input_data.external_balance,
            variance=variance,
            is_matched="1" if is_matched else "0",
            tenant_id=tenant_id,
        )

        if not is_matched:
            reconciliation.variance_reason = f"Variance: {variance} - cần investigate"

        db_session.add(reconciliation)
        db_session.commit()

        return ReconcileAccountOutput(
            reconciliation_id=reconciliation.reconciliation_id,
            status=reconciliation.status.value,
            is_matched=is_matched,
            variance=variance,
        )