"""
Banking Ledger Entity Model

Sổ cái kế toán double-entry.
Mỗi giao dịch có ít nhất 2 entries (debit + credit).
RX02: Financial Integrity - Ledger entries immutable sau khi committed.
"""

from __future__ import annotations

from datetime import datetime
from decimal import Decimal
from enum import Enum

from sqlalchemy import Column, DateTime, Enum as SQLAlchemyEnum, Index, Numeric, String, UniqueConstraint
from sqlalchemy.orm import relationship

from ...db.base_model import Base
from ...db.tenant_mixin import TenantRowMixin


class LedgerEntryType(str, Enum):
    """Loại ledger entry."""
    DEBIT = "debit"
    CREDIT = "credit"


class LedgerStatus(str, Enum):
    """Trạng thái ledger."""
    PENDING = "pending"
    COMMITTED = "committed"
    REVERSED = "reversed"


class LedgerEntry(Base, TenantRowMixin):
    """LedgerEntry entity model.

    Bút toán trong sổ cái kế toán.
    Mỗi entry thuộc về một transaction (journal_entry_id).

    RX02 Compliance:
    - immutable sau khi status = COMMITTED
    - debit_total phải bằng credit_total trong cùng transaction
    """

    __tablename__ = "banking_ledger_entries"

    journal_entry_id = Column(String(50), nullable=False)
    account_id = Column(String(50), nullable=False)
    entry_type = Column(SQLAlchemyEnum(LedgerEntryType), nullable=False)
    amount = Column(Numeric(19, 2), nullable=False)
    description = Column(String(500), nullable=True)
    status = Column(SQLAlchemyEnum(LedgerStatus), nullable=False, default=LedgerStatus.PENDING)
    reference = Column(String(100), nullable=True)

    # Timestamps
    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)
    committed_at = Column(DateTime, nullable=True)

    # Relationships
    account = relationship("Account", back_populates="ledger_entries")

    __table_args__ = (
        Index("idx_journal_entry", "journal_entry_id"),
        Index("idx_account_entries", "account_id"),
        Index("idx_entry_status", "status"),
    )

    def is_immutable(self) -> bool:
        """Kiểm tra entry có immutable không (RX02)."""
        return self.status == LedgerStatus.COMMITTED