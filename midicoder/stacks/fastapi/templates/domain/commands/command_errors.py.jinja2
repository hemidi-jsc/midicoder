# KPI-029: Tenant Isolation Error
class TenantIsolationError({{ command.id }}Error):
    """
    KPI-029: Lỗi vi phạm tenant isolation.

    Được throw khi user cố access data của tenant khác.

    HTTP Status: 403 Forbidden
    Error Code: TENANT_ISOLATION_VIOLATION
    """

    def __init__(self, user_tenant_id: str | None, target_tenant_id: str) -> None:
        """
        Khởi tạo error.

        Args:
            user_tenant_id: Tenant ID của user (None nếu chưa authenticated)
            target_tenant_id: Tenant ID của resource bị access
        """
        message = (
            f"User từ tenant {user_tenant_id or 'unknown'} "
            f"không thể access resource của tenant {target_tenant_id}"
        )
        super().__init__(
            message=message,
            http_status=403,
        )
        self.user_tenant_id = user_tenant_id
        self.target_tenant_id = target_tenant_id


