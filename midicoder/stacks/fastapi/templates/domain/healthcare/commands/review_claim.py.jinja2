"""
Review/Pay Claim Commands (DP10)

Xem xét và thanh toán bồi thường bảo hiểm y tế.
"""

from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from decimal import Decimal
from typing import Any

from ....command.command import BaseCommand
from ....command.command_guards import CommandGuards
from ....command.command_validator import CommandValidator
from ...entities.claim import Claim, ClaimStatus


@dataclass
class ReviewClaimInput:
    claim_id: str
    decision: str  # approved hoặc denied
    review_notes: str = ""


@dataclass
class ReviewClaimOutput:
    claim_id: str
    status: str
    reviewed_at: datetime


class ReviewClaimCommand(BaseCommand):
    """ReviewClaim command."""

    name = "healthcare.review_claim"
    description = "Xem xét yêu cầu bồi thường"
    guards = [CommandGuards.tenant_scope, CommandGuards.auth_required, CommandGuards.permission("healthcare:claim:review")]
    effects = ["update_record", "write_audit_log", "publish_event"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> ReviewClaimInput:
        validator = CommandValidator(data)
        validator.require_string("claim_id", min_length=1)
        validator.require_string("decision", allowed=["approved", "denied"])
        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")
        return ReviewClaimInput(claim_id=data["claim_id"], decision=data["decision"], review_notes=data.get("review_notes", ""))

    def execute(self, input_data: ReviewClaimInput, context: dict[str, Any]) -> ReviewClaimOutput:
        """Execute review claim command."""
        db_session = context["db_session"]
        claim = db_session.query(Claim).filter(Claim.claim_id == input_data.claim_id).first()
        if claim:
            claim.status = ClaimStatus.APPROVED if input_data.decision == "approved" else ClaimStatus.DENIED
            claim.reviewed_at = datetime.utcnow()
            db_session.commit()
        return ReviewClaimOutput(claim_id=claim.claim_id, status=claim.status.value, reviewed_at=claim.reviewed_at)


@dataclass
class PayClaimInput:
    claim_id: str
    payment_amount: Decimal


@dataclass
class PayClaimOutput:
    claim_id: str
    status: str
    paid_at: datetime


class PayClaimCommand(BaseCommand):
    """PayClaim command."""

    name = "healthcare.pay_claim"
    description = "Thanh toán bồi thường"
    guards = [CommandGuards.tenant_scope, CommandGuards.auth_required, CommandGuards.permission("healthcare:claim:pay")]
    effects = ["update_record", "payment_processing", "write_audit_log"]

    @classmethod
    def validate_input(cls, data: dict[str, Any]) -> PayClaimInput:
        validator = CommandValidator(data)
        validator.require_string("claim_id", min_length=1)
        validator.require_decimal("payment_amount", min_value=Decimal("0.01"))
        if validator.has_errors():
            raise ValueError(f"Validation failed: {validator.errors}")
        return PayClaimInput(claim_id=data["claim_id"], payment_amount=Decimal(str(data["payment_amount"])))

    def execute(self, input_data: PayClaimInput, context: dict[str, Any]) -> PayClaimOutput:
        """Execute pay claim command."""
        db_session = context["db_session"]
        claim = db_session.query(Claim).filter(Claim.claim_id == input_data.claim_id).first()
        if claim:
            claim.status = ClaimStatus.PAID
            claim.paid_at = datetime.utcnow()
            db_session.commit()
        return PayClaimOutput(claim_id=claim.claim_id, status=claim.status.value, paid_at=claim.paid_at)