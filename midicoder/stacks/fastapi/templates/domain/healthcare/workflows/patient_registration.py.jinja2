"""
Patient Registration Workflow (DP09)

REGISTERED → VERIFIED → ACTIVE.
"""

from __future__ import annotations
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import Any, Dict, List

class RegState(str, Enum):
    REGISTERED = "registered"
    VERIFIED = "verified"
    ACTIVE = "active"
    FAILED = "failed"

class RegEvent(str, Enum):
    VERIFY = "verify"
    ACTIVATE = "activate"
    FAIL = "fail"

@dataclass
class PatientRegistrationWorkflow:
    """Quy trình đăng ký bệnh nhân."""
    workflow_id: str
    tenant_id: str
    patient_id: str
    current_state: RegState = RegState.REGISTERED
    history: List[Dict[str, Any]] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.utcnow)

    def transition(self, event: RegEvent) -> RegState:
        transitions = {
            (RegState.REGISTERED, RegEvent.VERIFY): RegState.VERIFIED,
            (RegState.VERIFIED, RegEvent.ACTIVATE): RegState.ACTIVE,
            (RegState.REGISTERED, RegEvent.FAIL): RegState.FAILED,
            (RegState.VERIFIED, RegEvent.FAIL): RegState.FAILED,
        }
        new_state = transitions.get((self.current_state, event))
        if not new_state:
            raise ValueError(f"Không thể transition {self.current_state.value} với {event.value}")
        self.history.append({"from": self.current_state.value, "to": new_state.value, "event": event.value})
        self.current_state = new_state
        return new_state

    @property
    def is_completed(self) -> bool:
        return self.current_state in (RegState.ACTIVE, RegState.FAILED)