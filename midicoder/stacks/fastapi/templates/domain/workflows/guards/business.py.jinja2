        """
        Evaluate business rule guard.
        
        KPI-029: tenant_id được thêm vào context nếu chưa có.
        
        Args:
            condition: Business condition expression
            context: Transition context với data
            tenant_id: KPI-029: Tenant ID cho guard evaluation
            
        Returns:
            True nếu condition pass, False nếu fail
        """
        # KPI-029: Thêm tenant_id vào context
        if tenant_id and "tenant_id" not in context:
            context["tenant_id"] = tenant_id
        
