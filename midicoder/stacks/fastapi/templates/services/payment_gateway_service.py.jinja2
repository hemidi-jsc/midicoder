class PaymentGatewayService:
    """
    Payment Gateway Service - Payment processing service.

    Service này cung cấp methods cho:
    - Process payment qua external gateway (Stripe, VNPay, MoMo)
    - Handle async callbacks/webhooks
    - Idempotency cho retries (prevent duplicate)
    - Payment cancellation và refund

    KPI-029: Support tenant-scoped payment operations.
    DP12: Payments & Cards domain pack.

    Supported gateways:
        - stripe: Stripe payment gateway
        - vnpay: VNPay gateway (Vietnam)
        - momo: MoMo e-wallet (Vietnam)

    Usage:
        payment_svc = PaymentGatewayService(payment_repo, config)
        result = await payment_svc.process_payment(
            amount=100000, currency="VND", gateway="stripe",
            idempotency_key="txn_123", tenant_id="tenant_123"
        )
    """

    # Gateway configurations
    GATEWAY_CONFIGS = {
        "stripe": {
            "base_url": "https://api.stripe.com/v1",
            "api_key_env": "STRIPE_API_KEY",
        },
        "vnpay": {
            "base_url": "https://sandbox.vnpay.vn",
            "api_key_env": "VNPAY_API_KEY",
        },
        "momo": {
            "base_url": "https://test-payment.momo.vn",
            "api_key_env": "MOMO_API_KEY",
        },
    }

    def __init__(
        self,
        payment_repo: PaymentRepository,
        config: Optional[dict[str, Any]] = None,
    ) -> None:
        """
        Initialize PaymentGatewayService.

        Args:
            payment_repo: Repository cho payment data storage
            config: Configuration dict với API keys, timeout, etc.
        """
        self._payment_repo = payment_repo
        self._config = config or {}

    async def process_payment(
        self,
        amount: float,
        currency: str,
        gateway: str,
        payment_method: str,
        idempotency_key: str,
        customer_id: str,
        description: str,
        user_id: Optional[str],
        tenant_id: str,
    ) -> dict[str, Any]:
        """
        Process payment qua external gateway.

        KPI-029: Tenant-scoped payment processing.
        DP12: Payments domain pack.

        Args:
            amount: Payment amount
            currency: Currency (VND, USD, etc.)
            gateway: Gateway name (stripe, vnpay, momo)
            payment_method: Payment method (card, e-wallet, bank_transfer)
            idempotency_key: Idempotency key để prevent duplicate
            customer_id: Customer ID
            description: Payment description
            user_id: User thực hiện payment
            tenant_id: KPI-029: Tenant ID

        Returns:
            Dict với payment_id, status, transaction_ref

        Raises:
            ValueError: Nếu payment failed
            ConnectionError: Nếu gateway connection error
        """
        # Check idempotency
        existing = await self._payment_repo.get_payment_by_idempotency(
            idempotency_key, tenant_id
        )
        if existing:
            return {
                "payment_id": existing["payment_id"],
                "status": existing["status"],
                "gateway": gateway,
                "transaction_ref": existing.get("transaction_ref"),
                "idempotent": True,
            }

        # Validate gateway
        if gateway not in self.GATEWAY_CONFIGS:
            raise ValueError(f"Unsupported gateway: {gateway}")

        # Process payment based on gateway
        if gateway == "stripe":
            result = await self._process_stripe_payment(
                amount=amount,
                currency=currency,
                customer_id=customer_id,
                description=description,
                idempotency_key=idempotency_key,
                user_id=user_id,
                tenant_id=tenant_id,
            )
        elif gateway == "vnpay":
            result = await self._process_vnpay_payment(
                amount=amount,
                currency=currency,
                customer_id=customer_id,
                description=description,
                idempotency_key=idempotency_key,
                user_id=user_id,
                tenant_id=tenant_id,
            )
        elif gateway == "momo":
            result = await self._process_momo_payment(
                amount=amount,
                currency=currency,
                customer_id=customer_id,
                description=description,
                idempotency_key=idempotency_key,
                user_id=user_id,
                tenant_id=tenant_id,
            )
        else:
            raise ValueError(f"Gateway not implemented: {gateway}")

        # Save payment record
        payment_record = {
            "payment_id": result["payment_id"],
            "tenant_id": tenant_id,
            "amount": amount,
            "currency": currency,
            "gateway": gateway,
            "payment_method": payment_method,
            "status": result["status"],
            "transaction_ref": result.get("transaction_ref"),
            "idempotency_key": idempotency_key,
            "customer_id": customer_id,
            "user_id": user_id,
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
        await self._payment_repo.create_payment(payment_record)

        # Audit log
        audit_logger.info(
            "Payment processed",
            extra={
                "payment_id": result["payment_id"],
                "tenant_id": tenant_id,
                "amount": amount,
                "currency": currency,
                "gateway": gateway,
                "status": result["status"],
                "user_id": user_id,
            },
        )

        return result

