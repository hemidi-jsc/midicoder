    async def verify_payment(
        self,
        payment_id: str,
        gateway: str,
        tenant_id: str,
    ) -> dict[str, Any]:
        """
        Verify payment status từ gateway.

        KPI-029: Tenant-scoped verification.

        Args:
            payment_id: Payment ID
            gateway: Gateway name
            tenant_id: KPI-029: Tenant ID

        Returns:
            Dict với payment status details
        """
        payment = await self._payment_repo.get_payment(payment_id, tenant_id)

        if not payment:
            return {"verified": False, "error": "Payment not found"}

        return {
            "verified": True,
            "status": payment.get("status"),
            "amount": payment.get("amount"),
            "currency": payment.get("currency"),
            "gateway": payment.get("gateway"),
        }


