    # -------------------------------------------------------------------------
    # Compliance Audit Logging (RX02, RX03, RX04)
    # -------------------------------------------------------------------------

    async def log_compliance_check(
        self,
        audit_record: dict[str, Any],
    ) -> None:
        """
        Log compliance check vào audit trail.

        KPI-029: Audit log bao gồm tenant_id cho multi-tenant compliance tracking.
        RX04: clinical_audit_trail - All PHI access phải được log.

        Audit record format:
        {
            "timestamp": "2026-05-04T22:30:00Z",
            "guard_type": "kyc_check" | "aml_screening" | "hipaa_access",
            "user_id": "user_123",
            "tenant_id": "tenant_456",
            "result": "passed" | "failed" | "skipped",
            "command_id": "TransferFunds",
            "details": {...}
        }

        Args:
            audit_record: Audit record để log

        Raises:
            MidicoderError: Nếu ghi audit log thất bại
        """
        try:
            # Add timestamp nếu chưa có
            if "timestamp" not in audit_record:
                audit_record["timestamp"] = datetime.now(timezone.utc).isoformat()

            # KPI-029: Ensure tenant_id is present
            tenant_id = audit_record.get("tenant_id")
            if tenant_id is None:
                audit_record["tenant_id"] = "global"

            # Save to audit log repository
            await self._compliance_repo.save_compliance_audit(audit_record)

            # Also log to application logs
            result = audit_record.get("result", "unknown")
            guard_type = audit_record.get("guard_type", "unknown")
            user_id = audit_record.get("user_id", "unknown")

            if result == "passed":
                audit_logger.info(
                    f"Compliance check passed",
                    extra={
                        "guard_type": guard_type,
                        "user_id": user_id,
                        "tenant_id": tenant_id,
                        **audit_record.get("details", {}),
                    },
                )
            elif result == "failed":
                audit_logger.warning(
                    f"Compliance check failed",
                    extra={
                        "guard_type": guard_type,
                        "user_id": user_id,
                        "tenant_id": tenant_id,
                        **audit_record.get("details", {}),
                    },
                )
            else:
                audit_logger.debug(
                    f"Compliance check skipped",
                    extra={
                        "guard_type": guard_type,
                        "user_id": user_id,
                        "tenant_id": tenant_id,
                        **audit_record.get("details", {}),
                    },
                )

        except Exception as e:
            EM.raise_error(
                ErrorCode.CP01_GUARD_COMPLIANCE_LOG_FAILED,
                guard_type=audit_record.get("guard_type"),
                user_id=audit_record.get("user_id"),
                tenant_id=audit_record.get("tenant_id"),
                error=str(e),
            )

