    # -------------------------------------------------------------------------
    # AML Screening (RX03)
    # -------------------------------------------------------------------------

    async def check_aml(
        self,
        user_id: str,
        transaction_data: dict[str, Any],
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Check AML screening cho transaction.

        KPI-029: Support tenant-scoped AML screening.
        RX03: aml_screening_required - Transactions phải qua AML screening.

        Args:
            user_id: User ID thực hiện transaction
            transaction_data: Transaction data để screening
            tenant_id: KPI-029: Tenant ID cho tenant-scoped AML check

        Returns:
            True nếu transaction AML cleared, False nếu failed

        Raises:
            MidicoderError: Nếu có lỗi khi check AML
        """
        try:
            amount = transaction_data.get("amount", 0)
            transaction_id = transaction_data.get("transaction_id", "")

            # KPI-029: Check tenant-scoped AML rules
            aml_result = await self._compliance_repo.get_aml_screening_result(
                user_id, tenant_id
            )

            if aml_result is None:
                # User chưa có AML screening record - check external API
                if self._external_aml_api_url:
                    return await self._check_external_aml(user_id, transaction_data, tenant_id)

                # No external API and no record - assume cleared for small amounts
                threshold = self._get_aml_threshold(tenant_id)
                return amount < threshold

            # Check nếu AML đã cleared
            return aml_result.cleared and not aml_result.expired

        except Exception as e:
            audit_logger.error(
                "Error checking AML status",
                extra={
                    "user_id": user_id,
                    "tenant_id": tenant_id,
                    "amount": transaction_data.get("amount"),
                    "error": str(e),
                },
            )
            # On error, default to not cleared (fail-safe)
            return False

    async def _check_external_aml(
        self,
