    # -------------------------------------------------------------------------
    # RX03: Suspicious Activity Detection
    # -------------------------------------------------------------------------

    async def check_suspicious_activity(
        self,
        user_id: str,
        transaction_data: dict[str, Any],
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Check nếu transaction có suspicious activity patterns.

        RX03: suspicious_activity_reporting - Flag transactions > threshold.

        Args:
            user_id: User ID
            transaction_data: Transaction data
            tenant_id: KPI-029: Tenant ID

        Returns:
            True nếu có suspicious activity (needs SAR)
        """
        amount = transaction_data.get("amount", 0)
        threshold = self._get_aml_threshold(tenant_id)

        # Flag if amount exceeds threshold
        if amount > threshold:
            await self.log_compliance_check(
                {
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "guard_type": "suspicious_activity",
                    "user_id": user_id,
                    "tenant_id": tenant_id,
                    "result": "flagged",
                    "command_id": transaction_data.get("command_id", ""),
                    "details": {
                        "amount": amount,
                        "threshold": threshold,
                        "reason": "Amount exceeds AML threshold",
                    },
                }
            )
            return True

        return False

    # -------------------------------------------------------------------------
    # RX04: PHI Access Control
    # -------------------------------------------------------------------------

    async def check_phi_access_allowed(
        self,
        user_id: str,
        phi_fields: list[str],
        user_allowed_fields: list[str],
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Check nếu user có quyền access các PHI fields.

        RX04: minimum_necessary_access - Users chỉ access necessary PHI fields.

        Args:
            user_id: User ID
            phi_fields: PHI fields user đang request
            user_allowed_fields: PHI fields user được phép access
            tenant_id: KPI-029: Tenant ID

        Returns:
            True nếu user có quyền access tất cả requested fields
        """
        requested_set = set(phi_fields)
        allowed_set = set(user_allowed_fields)

        # Check nếu tất cả requested fields đều trong allowed set
        excess_access = requested_set - allowed_set

        if excess_access:
            await self.log_compliance_check(
                {
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "guard_type": "minimum_necessary_violation",
                    "user_id": user_id,
                    "tenant_id": tenant_id,
                    "result": "failed",
                    "command_id": "",
                    "details": {
                        "excess_fields": list(excess_access),
                        "reason": "User attempted to access PHI fields without permission",
                    },
                }
            )
            return False

        return True

