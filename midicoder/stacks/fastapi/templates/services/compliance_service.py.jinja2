    async def check_kyc(
        self,
        user_id: str,
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Check KYC verification status của user.

        KPI-029: Support tenant-scoped KYC verification.
        RX03: kyc_verification_required - User phải được KYC verify trước khi thực hiện financial transactions.

        Args:
            user_id: User ID để check
            tenant_id: KPI-029: Tenant ID cho tenant-scoped KYC check

        Returns:
            True nếu user đã được KYC verify, False nếu chưa

        Raises:
            MidicoderError: Nếu có lỗi khi check KYC
        """
        try:
            # KPI-029: Check tenant-scoped KYC verification
            kyc_status = await self._compliance_repo.get_kyc_status(user_id, tenant_id)

            if kyc_status is None:
                # User chưa có KYC record - check external API
                if self._external_kyc_api_url:
                    return await self._check_external_kyc(user_id, tenant_id)

                # No external API - return False (not verified)
                return False

            # Check nếu KYC đã được verify
            return kyc_status.verified and not kyc_status.expired

        except Exception as e:
            audit_logger.error(
                "Error checking KYC status",
                extra={
                    "user_id": user_id,
                    "tenant_id": tenant_id,
                    "error": str(e),
                },
            )
            # On error, default to not verified (fail-safe)
            return False

