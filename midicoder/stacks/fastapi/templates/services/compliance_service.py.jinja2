    async def validate_double_entry(
        self,
        debit: float,
        credit: float,
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Validate double-entry bookkeeping rule (RX02).

        Rule: Debit tổng phải bằng Credit tổng.

        Args:
            debit: Tổng debit
            credit: Tổng credit
            tenant_id: KPI-029: Tenant ID

        Returns:
            True nếu debit == credit (within tolerance)
        """
        # Allow 0.01 tolerance for rounding
        return abs(debit - credit) <= 0.01

