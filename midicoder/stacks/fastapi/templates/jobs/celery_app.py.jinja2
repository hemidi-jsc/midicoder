"""
Celery Configuration cho FastAPI.

Cung cấp:
- Celery app setup
- Redis broker/backend
- Task routing
- Beat scheduler
- Tenant context propagation (KPI-029)

CP13: Background Job & Workflow
KPI-029: Tenant Isolation cho background tasks
"""

import os
from contextvars import ContextVar
from typing import Optional

from celery import Celery
from celery.signals import task_prerun, task_postrun

# Redis settings từ environment
REDIS_URL = os.getenv(
    "REDIS_URL",
    "redis://localhost:6379/0",
)
CELERY_QUEUE = os.getenv("CELERY_QUEUE", "default")
CELERY_RESULT_EXPIRES = int(os.getenv("CELERY_RESULT_EXPIRES", "3600"))  # 1 hour

# Celery settings
CELERY_TASK_TIME_LIMIT = int(os.getenv("CELERY_TASK_TIME_LIMIT", "3600"))  # 1 hour
CELERY_TASK_SOFT_TIME_LIMIT = int(os.getenv("CELERY_TASK_SOFT_TIME_LIMIT", "3000"))  # 50 minutes
CELERY_TASK_MAX_RETRIES = int(os.getenv("CELERY_TASK_MAX_RETRIES", "3"))

# ============================================================================
# Tenant Context - KPI-029: Tenant Isolation cho background tasks
# ============================================================================

# ContextVar để lưu tenant ID xuyên suốt task execution
# KPI-029: Mỗi task chạy với tenant context riêng, không bị leak giữa các tasks
_tenant_id_ctx: ContextVar[Optional[str]] = ContextVar("tenant_id", default=None)


def get_tenant_id_from_context() -> Optional[str]:
    """
    Trích xuất tenant ID từ Celery request context.

    KPI-029: Tenant Isolation - lấy tenant_id từ context cho background tasks.
    
    Hàm này cho phép các tasks truy cập tenant context mà không cần pass
    tenant_id qua tất cả function calls.

    Returns:
        Optional[str]: Tenant ID nếu có, None nếu không tìm thấy.

    Usage:
        @celery_app.task
        def process_order(order_id: str):
            tenant_id = get_tenant_id_from_context()
            # Process with tenant isolation
    """
    return _tenant_id_ctx.get()


def set_tenant_context(tenant_id: Optional[str]) -> None:
    """
    Set tenant ID vào context.

    KPI-029: Cho phép propagate tenant context vào task execution.

    Args:
        tenant_id: Tenant ID để set vào context
    """
    _tenant_id_ctx.set(tenant_id)


def clear_tenant_context() -> None:
    """
    Clear tenant context sau khi task hoàn thành.

    KPI-029: Prevent tenant context leak giữa các tasks.
    """
    _tenant_id_ctx.set(None)


# Celery signals để tự động manage tenant context
@task_prerun.connect
def capture_tenant_on_task_start(task, *args, **kwargs):
    """
    Capture tenant_id từ task kwargs khi task bắt đầu.

    KPI-029: Tự động extract tenant_id và lưu vào context.
    """
    if "tenant_id" in kwargs:
        set_tenant_context(kwargs["tenant_id"])
    elif args and len(args) > 0:
        # Try to get tenant_id from first arg if it's a dict
        try:
            if isinstance(args[0], dict) and "tenant_id" in args[0]:
                set_tenant_context(args[0]["tenant_id"])
        except Exception:
            pass


@task_postrun.connect
def clear_tenant_on_task_end(task, *args, **kwargs):
    """
    Clear tenant context sau khi task hoàn thành.

    KPI-029: Prevent tenant context leak giữa các tasks.
    """
    clear_tenant_context()


# Create Celery app
celery_app = Celery(
    "tasks",
    broker=REDIS_URL,
    backend=REDIS_URL,
)

# Load config từ environment
celery_app.conf.update(
    # Result settings
    result_backend=REDIS_URL,
    result_expires=CELERY_RESULT_EXPIRES,
    result_extended=True,

    # Task settings
    task_time_limit=CELERY_TASK_TIME_LIMIT,
    task_soft_time_limit=CELERY_TASK_SOFT_TIME_LIMIT,
    task_max_retries=CELERY_TASK_MAX_RETRIES,
    task_acks_late=True,
    task_reject_on_worker_lost=True,

    # Queue settings
    task_default_queue=CELERY_QUEUE,
    task_queue_max_priority=10,

    # Beat scheduler settings
    beat_scheduler="celery.schedules:PersistentTimer",
    beat_max_loop_interval=300,

    # Security
    worker_hijack_root_logger=False,
    worker_send_task_events=True,
    task_send_sent_event=True,
)

# Auto-discover tasks
celery_app.autodiscover_tasks(
    packages=["app"],
    related_name="tasks",
)


# Task routing
celery_app.conf.task_routes = {
    "app.tasks.email.*": {"queue": "email"},
    "app.tasks.notification.*": {"queue": "notification"},
    "app.tasks.report.*": {"queue": "report"},
    "app.tasks.sync.*": {"queue": "sync"},
}


# Periodic tasks (Beat)
celery_app.conf.beat_schedule = {
    # Cleanup expired data every day at midnight
    "cleanup-expired-data": {
        "task": "app.tasks.cleanup.expired_data",
        "schedule": 86400,  # Every 24 hours
    },
    # Send daily reports every morning at 8 AM
    "send-daily-reports": {
        "task": "app.tasks.report.daily_summary",
        "schedule": 86400,
        "options": {"queue": "report"},
    },
    # Health check every 5 minutes
    "health-check": {
        "task": "app.tasks.health.check_all",
        "schedule": 300,  # Every 5 minutes
    },
}


def init_celery():
    """
    Khởi tạo Celery app.

    Gọi khi startup application.
    """
    return celery_app


def get_celery():
    """
    Trả về Celery app instance.

    Returns:
        Celery app
    """
    return celery_app