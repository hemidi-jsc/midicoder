def chain_tasks(tasks: list, tenant_id: Optional[str] = None) -> Callable:
    """
    Chain multiple tasks.

    KPI-029: tenant_id được propagate qua tất cả tasks trong chain.

    Args:
        tasks: List of task functions
        tenant_id: KPI-029: Tenant ID cho chain

    Returns:
        Chained task
    """
    @task(queue="default")
    async def chained(*args, **kwargs):
        # KPI-029: Add tenant_id to kwargs
        if tenant_id and "tenant_id" not in kwargs:
            kwargs["tenant_id"] = tenant_id
        for task in tasks:
            result = await task(*args, **kwargs)
        return result

    return chained


def retry_on_failure(max_retries: int = 3, delay: int = 60):
    """
    Decorator để retry task on failure.

    Args:
        max_retries: Max retry attempts
        delay: Delay between retries (seconds)
    """
    def decorator(func):
        @wraps(func)
        async def wrapper(*args, **kwargs):
            for attempt in range(max_retries):
                try:
                    return await func(*args, **kwargs)
                except Exception as e:
                    if attempt == max_retries - 1:
                        raise
                    await asyncio.sleep(delay)
        return wrapper
    return decorator


# KPI-029: Tenant-specific task helpers
def tenant_task(queue: str = "default"):
    """
    KPI-029: Decorator cho tenant-specific tasks.

    Tạo task với tenant_id auto-extracted.

    Args:
        queue: Queue name

    Returns:
        Task decorator
    """
    def decorator(func: Callable) -> Callable:
        decorated = task(queue=queue)(func)
        return decorated
    return decorator


