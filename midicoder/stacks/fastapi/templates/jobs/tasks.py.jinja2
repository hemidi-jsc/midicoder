import asyncio
from functools import wraps
from typing import Any, Callable, Optional

from .celery_app import get_celery

celery = get_celery()


def task(
    name: Optional[str] = None,
    retries: int = 3,
    interval: int = 60,
    queue: str = "default",
):
    """
    Decorator để define Celery task.

    KPI-029: Support tenant_id trong task context.

    Args:
        name: Task name (optional)
        retries: Max retries (default 3)
        interval: Retry interval in seconds (default 60)
        queue: Queue name (default "default")

    Usage:
        @task(queue="email", retries=5)
        async def send_welcome_email(user_id: int, tenant_id: str):
            ...
    """

    def decorator(func: Callable) -> Callable:
        @wraps(func)
        @celery.task(
            name=name or func.__name__,
            max_retries=retries,
            default_retry_delay=interval,
            queue=queue,
            acks_late=True,
        )
        async def wrapper(*args: Any, **kwargs: Any) -> Any:
            try:
                # KPI-029: Ensure tenant_id is in kwargs if not provided
                if "tenant_id" not in kwargs and hasattr(wrapper, "tenant_id"):
                    kwargs["tenant_id"] = wrapper.tenant_id
                
                # Call the async function
                if hasattr(func, "__await__"):
                    return await func(*args, **kwargs)
                return func(*args, **kwargs)
            except Exception as e:
                # Retry on exception
                wrapper.retry(exc=e)
                raise

        return wrapper

    return decorator


