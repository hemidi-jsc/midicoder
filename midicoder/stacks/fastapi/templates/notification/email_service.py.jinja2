"""
Email Service cho FastAPI.

Cung cấp:
- SMTP email sending
- Email templates
- Async email operations
- Tenant-specific email settings (KPI-029)

CP12: Notification & Communication
KPI-029: Tenant Isolation - Multi-tenant email support
"""

import os
from typing import Optional, List
import aiosmtplib
from email.message import EmailMessage

# SMTP settings từ environment
SMTP_HOST = os.getenv("SMTP_HOST", "smtp.gmail.com")
SMTP_PORT = int(os.getenv("SMTP_PORT", "587"))
SMTP_USER = os.getenv("SMTP_USER", "")
SMTP_PASSWORD = os.getenv("SMTP_PASSWORD", "")
SMTP_USE_TLS = os.getenv("SMTP_USE_TLS", "true").lower() == "true"
DEFAULT_FROM = os.getenv("DEFAULT_FROM_EMAIL", "noreply@example.com")


class EmailService:
    """
    Service cho email operations.

    KPI-029: Tenant Isolation - Email service hỗ trợ tenant-specific settings.

    Hỗ trợ:
    - Send emails
    - Send templated emails
    - Send bulk emails
    - Tenant-specific email templates (KPI-029)
    """

    def __init__(self, tenant_id: Optional[str] = None) -> None:
        """
        Khởi tạo email service.

        Args:
            tenant_id: Tenant ID cho tenant-specific settings (KPI-029, optional)
        """
        self.smtp_host = SMTP_HOST
        self.smtp_port = SMTP_PORT
        self.smtp_user = SMTP_USER
        self.smtp_password = SMTP_PASSWORD
        self.use_tls = SMTP_USE_TLS
        self.default_from = DEFAULT_FROM
        self.tenant_id = tenant_id  # KPI-029: Tenant Isolation

    async def send_email(
        self,
        to: str,
        subject: str,
        body: str,
        from_email: Optional[str] = None,
        cc: Optional[List[str]] = None,
        bcc: Optional[List[str]] = None,
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Gửi email đơn giản.

        KPI-029: Tenant Isolation - Hỗ trợ tenant_id để track email sender.

        Args:
            to: Email address người nhận
            subject: Tiêu đề email
            body: Nội dung email (HTML)
            from_email: Email người gửi (optional)
            cc: CC recipients (optional)
            bcc: BCC recipients (optional)
            tenant_id: Tenant ID để track email (KPI-029, optional)

        Returns:
            True nếu gửi thành công
        """
        msg = EmailMessage()
        msg["From"] = from_email or self.default_from
        msg["To"] = to
        msg["Subject"] = subject
        msg.set_content(body)

        if cc:
            msg["Cc"] = ", ".join(cc)

        try:
            await aiosmtplib.send(
                msg,
                hostname=self.smtp_host,
                port=self.smtp_port,
                username=self.smtp_user,
                password=self.smtp_password,
                use_tls=self.use_tls,
            )
            return True
        except Exception as e:
            print(f"Failed to send email: {e}")
            return False

    async def send_html_email(
        self,
        to: str,
        subject: str,
        html_body: str,
        from_email: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Gửi email HTML.

        KPI-029: Tenant Isolation - Hỗ trợ tenant_id để track email sender.

        Args:
            to: Email address người nhận
            subject: Tiêu đề email
            html_body: Nội dung HTML
            from_email: Email người gửi (optional)
            tenant_id: Tenant ID để track email (KPI-029, optional)

        Returns:
            True nếu gửi thành công
        """
        msg = EmailMessage()
        msg["From"] = from_email or self.default_from
        msg["To"] = to
        msg["Subject"] = subject
        msg.set_content(html_body, subtype="html")

        try:
            await aiosmtplib.send(
                msg,
                hostname=self.smtp_host,
                port=self.smtp_port,
                username=self.smtp_user,
                password=self.smtp_password,
                use_tls=self.use_tls,
            )
            return True
        except Exception as e:
            print(f"Failed to send HTML email: {e}")
            return False

    async def send_template_email(
        self,
        to: str,
        template_name: str,
        context: dict,
        subject_template: Optional[str] = None,
        tenant_id: Optional[str] = None,
    ) -> bool:
        """
        Gửi email từ template.

        KPI-029: Tenant Isolation - Template có thể render tenant-specific content.

        Args:
            to: Email address người nhận
            template_name: Tên template file
            context: Context cho template
            subject_template: Subject template (optional)
            tenant_id: Tenant ID để track email (KPI-029, optional)

        Returns:
            True nếu gửi thành công
        """
        # KPI-029: Add tenant_id to context
        context = context.copy() if context else {}
        context["tenant_id"] = tenant_id or self.tenant_id

        # Load template
        from jinja2 import Environment, FileSystemLoader

        env = Environment(loader=FileSystemLoader("templates/emails"))
        template = env.get_template(f"{template_name}.html")
        html_body = template.render(**context)

        # Load subject template
        subject = ""
        if subject_template:
            subject_template_file = env.get_template(f"{subject_template}.subject")
            subject = subject_template_file.render(**context)
        else:
            subject = context.get("subject", "No Subject")

        return await self.send_html_email(to, subject, html_body, tenant_id=tenant_id)

    async def send_bulk_emails(
        self,
        recipients: List[dict],
        template_name: str,
    ) -> dict:
        """
        Gửi bulk emails.

        Args:
            recipients: List của {email, context}
            template_name: Template name

        Returns:
            Result summary
        """
        results = {"success": 0, "failed": 0, "errors": []}

        for recipient in recipients:
            email = recipient["email"]
            context = recipient.get("context", {})

            try:
                success = await self.send_template_email(email, template_name, context)
                if success:
                    results["success"] += 1
                else:
                    results["failed"] += 1
                    results["errors"].append(email)
            except Exception as e:
                results["failed"] += 1
                results["errors"].append(f"{email}: {str(e)}")

        return results