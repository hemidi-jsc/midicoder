"""
Notification Service cho FastAPI.

Cung cấp:
- Multi-channel notifications (email, SMS, push)
- Notification templates
- Notification preferences
- KPI-029: Tenant-specific notifications

KPI-029: Tenant Isolation - Hỗ trợ tenant_id trong notifications
CP12: Notification & Communication
"""

import os
from typing import Optional, Dict, Any, List
from enum import Enum

from .email_service import EmailService

# Notification channels
class NotificationChannel(Enum):
    EMAIL = "email"
    SMS = "sms"
    PUSH = "push"
    IN_APP = "in_app"

# Notification types
class NotificationType(Enum):
    WELCOME = "welcome"
    VERIFICATION = "verification"
    PASSWORD_RESET = "password_reset"
    ORDER_UPDATE = "order_update"
    PAYMENT = "payment"
    ALERT = "alert"
    REMINDER = "reminder"
    CUSTOM = "custom"


class NotificationService:
    """
    Service cho multi-channel notifications.

    Hỗ trợ:
    - Email notifications
    - SMS notifications
    - Push notifications
    - In-app notifications

    KPI-029: Hỗ trợ tenant_id để isolate notifications theo tenant.
    """

    def __init__(self, tenant_id: Optional[str] = None) -> None:
        """Khởi tạo notification service.

        Args:
            tenant_id: KPI-029: Tenant ID cho tenant-specific notifications
        """
        self.email_service = EmailService()
        self.tenant_id = tenant_id  # KPI-029: Tenant context

    async def notify(
        self,
        user_id: str,
        notification_type: NotificationType,
        channel: NotificationChannel,
        data: Dict[str, Any],
        tenant_id: Optional[str] = None,  # KPI-029: Tenant isolation
        template: Optional[str] = None,
    ) -> bool:
        """
        Gửi notification qua channel specified.

        Args:
            user_id: User ID
            notification_type: Loại notification
            channel: Channel để gửi
            data: Notification data
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)
            template: Template name (optional)

        Returns:
            True nếu gửi thành công
        """
        # KPI-029: Use provided tenant_id or instance tenant_id
        effective_tenant_id = tenant_id or self.tenant_id
        # Thêm tenant_id vào data cho các services
        data_with_tenant = {**data, "tenant_id": effective_tenant_id}

        if channel == NotificationChannel.EMAIL:
            return await self.send_email_notification(user_id, notification_type, data_with_tenant, template)
        elif channel == NotificationChannel.SMS:
            return await self.send_sms_notification(user_id, notification_type, data_with_tenant, template)
        elif channel == NotificationChannel.PUSH:
            return await self.send_push_notification(user_id, notification_type, data_with_tenant)
        elif channel == NotificationChannel.IN_APP:
            return await self.create_in_app_notification(user_id, notification_type, data_with_tenant)

        return False

    async def send_email_notification(
        self,
        user_id: str,
        notification_type: NotificationType,
        data: Dict[str, Any],
        template: Optional[str] = None,
    ) -> bool:
        """
        Gửi email notification.

        Args:
            user_id: User ID
            notification_type: Notification type
            data: Notification data (bao gồm tenant_id - KPI-029)
            template: Email template name

        Returns:
            True nếu gửi thành công
        """
        # Get user email
        email = data.get("email")
        if not email:
            return False

        # KPI-029: Get tenant_id từ data
        tenant_id = data.get("tenant_id")

        # Use template or default
        template_name = template or f"notifications/{notification_type.value}"

        return await self.email_service.send_template_email(
            to=email,
            template_name=template_name,
            context={**data, "user_id": user_id},
            tenant_id=tenant_id,  # KPI-029: Pass tenant_id
        )

    async def send_sms_notification(
        self,
        user_id: str,
        notification_type: NotificationType,
        data: Dict[str, Any],
        template: Optional[str] = None,
    ) -> bool:
        """
        Gửi SMS notification.

        Args:
            user_id: User ID
            notification_type: Notification type
            data: Notification data (bao gồm tenant_id - KPI-029)
            template: SMS template name

        Returns:
            True nếu gửi thành công
        """
        phone = data.get("phone")
        if not phone:
            return False

        # KPI-029: Get tenant_id từ data
        tenant_id = data.get("tenant_id")
        tenant_context = f" [Tenant: {tenant_id}]" if tenant_id else ""

        # Get message from template or default
        message = self._get_sms_message(notification_type, data, template)

        # Send SMS (placeholder - integrate with Twilio, etc.)
        try:
            # TODO: Integrate with SMS provider với tenant context
            print(f"Sending SMS to {phone}: {message}{tenant_context}")
            return True
        except Exception as e:
            print(f"Failed to send SMS{tenant_context}: {e}")
            return False

    async def send_push_notification(
        self,
        user_id: str,
        notification_type: NotificationType,
        data: Dict[str, Any],
    ) -> bool:
        """
        Gửi push notification.

        Args:
            user_id: User ID
            notification_type: Notification type
            data: Notification data (bao gồm tenant_id - KPI-029)

        Returns:
            True nếu gửi thành công
        """
        # Get device token
        device_token = data.get("device_token")
        if not device_token:
            return False

        # KPI-029: Get tenant_id từ data
        tenant_id = data.get("tenant_id")
        tenant_context = f" [Tenant: {tenant_id}]" if tenant_id else ""

        # Build push notification
        title = self._get_push_title(notification_type)
        body = self._get_push_body(notification_type, data)

        # Send push (placeholder - integrate with FCM/APNS)
        try:
            # TODO: Integrate with FCM/APNS với tenant context
            print(f"Sending push to {device_token}: {title} - {body}{tenant_context}")
            return True
        except Exception as e:
            print(f"Failed to send push{tenant_context}: {e}")
            return False

    async def create_in_app_notification(
        self,
        user_id: str,
        notification_type: NotificationType,
        data: Dict[str, Any],
    ) -> bool:
        """
        Tạo in-app notification.

        Args:
            user_id: User ID
            notification_type: Notification type
            data: Notification data (bao gồm tenant_id - KPI-029)

        Returns:
            True nếu tạo thành công
        """
        # KPI-029: Get tenant_id từ data
        tenant_id = data.get("tenant_id")
        tenant_context = f" for tenant '{tenant_id}'" if tenant_id else ""

        # TODO: Save to database với tenant_id
        print(f"Creating in-app notification for {user_id}: {notification_type.value}{tenant_context}")
        return True

    async def notify_all_channels(
        self,
        user_id: str,
        notification_type: NotificationType,
        data: Dict[str, Any],
        channels: Optional[List[NotificationChannel]] = None,
        tenant_id: Optional[str] = None,  # KPI-029: Tenant isolation
    ) -> Dict[str, bool]:
        """
        Gửi notification qua multiple channels.

        Args:
            user_id: User ID
            notification_type: Notification type
            data: Notification data
            channels: Channels to use (default: all)
            tenant_id: KPI-029: Tenant ID (override instance tenant_id)

        Returns:
            Results by channel
        """
        if channels is None:
            channels = list(NotificationChannel)

        results = {}
        for channel in channels:
            success = await self.notify(user_id, notification_type, channel, data, tenant_id)
            results[channel.value] = success

        return results

    def _get_sms_message(
        self,
        notification_type: NotificationType,
        data: Dict[str, Any],
        template: Optional[str] = None,
    ) -> str:
        """Get SMS message from template."""
        templates = {
            NotificationType.WELCOME: "Xin chào! Cảm ơn bạn đã đăng ký.",
            NotificationType.VERIFICATION: f"Mã xác nhận của bạn là: {data.get('code', '123456')}",
            NotificationType.PASSWORD_RESET: f"Mã đặt lại mật khẩu: {data.get('code', '123456')}",
            NotificationType.ORDER_UPDATE: f"Đơn hàng {data.get('order_id')} đã được cập nhật.",
            NotificationType.PAYMENT: f"Thanh toán {data.get('amount')} thành công.",
        }
        return templates.get(notification_type, f"Thông báo: {data.get('message', '')}")

    def _get_push_title(self, notification_type: NotificationType) -> str:
        """Get push notification title."""
        titles = {
            NotificationType.WELCOME: "Chào mừng!",
            NotificationType.VERIFICATION: "Xác nhận tài khoản",
            NotificationType.PASSWORD_RESET: "Đặt lại mật khẩu",
            NotificationType.ORDER_UPDATE: "Cập nhật đơn hàng",
            NotificationType.PAYMENT: "Thanh toán thành công",
            NotificationType.ALERT: "Cảnh báo",
            NotificationType.REMINDER: "Nhắc nhở",
        }
        return titles.get(notification_type, "Thông báo")

    def _get_push_body(
        self,
        notification_type: NotificationType,
        data: Dict[str, Any],
    ) -> str:
        """Get push notification body."""
        return data.get("message", "Bạn có thông báo mới.")