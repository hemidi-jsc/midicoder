# CRUD permissions
CRUD_PERMISSIONS = {
    "read": {"user.read", "order.read", "product.read", "customer.read"},
    "create": {"user.create", "order.create", "product.create", "customer.create"},
    "update": {"user.update", "order.update", "product.update", "customer.update"},
    "delete": {"user.delete", "order.delete", "product.delete", "customer.delete"},
}


# All permissions
ALL_PERMISSIONS: Set[str] = set()
for resource_permissions in RESOURCE_PERMISSIONS.values():
    ALL_PERMISSIONS.update(resource_permissions)


# ============================================================================
# Permission Helper Functions
# ============================================================================


def get_resource_permissions(resource: str) -> Set[str]:
    """
    Lấy tất cả permissions cho resource.

    Args:
        resource: Resource name (user, order, product, v.v.)

    Returns:
        Set của permissions cho resource
    """
    return RESOURCE_PERMISSIONS.get(resource, set())


def get_tenant_scoped_permission(permission: str, tenant_id: str) -> str:
    """
    KPI-029: Tạo tenant-scoped permission.

    Example: "order.read" + "tenant-123" → "order.read:tenant-123"

    Args:
        permission: Base permission
        tenant_id: Tenant ID

    Returns:
        Tenant-scoped permission string
    """
    return f"{permission}:{tenant_id}"


def is_tenant_scoped_permission(permission: str) -> bool:
    """
    KPI-029: Check nếu permission là tenant-scoped.

    Args:
        permission: Permission string

    Returns:
        True nếu là tenant-scoped permission
    """
    return ":" in permission and permission.count(":") == 1


def extract_tenant_id_from_permission(permission: str) -> Optional[str]:
    """
    KPI-029: Extract tenant_id từ tenant-scoped permission.

    Args:
        permission: Permission string (có thể tenant-scoped)

    Returns:
        Tenant ID nếu có, None nếu không
    """
    if is_tenant_scoped_permission(permission):
        return permission.split(":")[1]
    return None


def has_permission(permission: str) -> bool:
    """
    Check nếu permission tồn tại.

    Args:
        permission: Permission ID

    Returns:
        True nếu permission tồn tại
    """
    return permission in ALL_PERMISSIONS


def get_permission_by_action(
    resource: str, action: str
) -> str:
    """
    Format permission ID từ resource và action.

    Args:
        resource: Resource name
        action: Action (read, create, update, delete, list)

    Returns:
        Permission ID
    """
    return f"{resource}.{action}"


def get_action_from_permission(permission: str) -> str:
    """
    Extract action từ permission ID.

    Args:
        permission: Permission ID

    Returns:
        Action (read, create, update, delete, v.v.)
    """
    parts = permission.split(".")
    return parts[-1] if len(parts) > 1 else permission


def get_resource_from_permission(permission: str) -> str:
    """
    Extract resource từ permission ID.

    Args:
        permission: Permission ID

    Returns:
        Resource name
    """
    # KPI-029: Remove tenant scope if present
    base_permission = permission.split(":")[0] if ":" in permission else permission
    parts = base_permission.split(".")
    return parts[0] if len(parts) > 0 else permission


def check_tenant_permission(
    user_permissions: Set[str], permission: str, tenant_id: Optional[str] = None
) -> bool:
    """
    KPI-029: Check nếu user có permission với tenant context.

    Args:
        user_permissions: Set của user permissions
        permission: Permission cần check
        tenant_id: KPI-029: Tenant ID để check tenant-scoped permission

    Returns:
        True nếu user có permission (global hoặc tenant-scoped)
    """
    # Check global permission
    if permission in user_permissions:
        return True

    # KPI-029: Check tenant-scoped permission
    if tenant_id:
        tenant_scoped = get_tenant_scoped_permission(permission, tenant_id)
        if tenant_scoped in user_permissions:
            return True

    # KPI-029: Check super admin permission
    if Permissions.MULTITENANT_ADMIN in user_permissions:
        return True

    return False
