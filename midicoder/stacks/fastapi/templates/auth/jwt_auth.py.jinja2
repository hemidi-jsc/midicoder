    return current_user


# ============================================================================
# Refresh Token
# ============================================================================


def create_refresh_token(user_id: str, tenant_id: Optional[str] = None) -> str:
    """
    Tạo refresh token.

    Refresh token có expiration time dài hơn access token.

    Args:
        user_id: User ID
        tenant_id: Tenant ID (optional)

    Returns:
        Refresh token string
    """
    data = {
        "sub": user_id,
        "tenant_id": tenant_id,
        "type": "refresh",
    }
    # Refresh token expire after 7 days
    expires_delta = timedelta(days=7)
    return create_access_token(data=data, expires_delta=expires_delta)


def verify_refresh_token(token: str) -> TokenData:
    """
    Verify refresh token.

    Args:
        token: Refresh token string

    Returns:
        TokenData với decoded data

    Raises:
        HTTPException: Nếu token không valid
    """
    try:
        payload = jwt.decode(token, JWT_SECRET_KEY, algorithms=[JWT_ALGORITHM])
        token_type = payload.get("type")

        # Ensure token is a refresh token
        if token_type != "refresh":
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Invalid token type",
            )

        user_id: Optional[str] = payload.get("sub")
        tenant_id: Optional[str] = payload.get("tenant_id")

        if user_id is None:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Invalid token payload",
            )

        return TokenData(user_id=user_id, tenant_id=tenant_id)
    except jwt.ExpiredSignatureError:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Refresh token đã hết hạn",
        )
    except jwt.InvalidTokenError:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Refresh token không hợp lệ",
        )