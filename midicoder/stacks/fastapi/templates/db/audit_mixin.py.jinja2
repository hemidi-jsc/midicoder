"""
Audit Mixin cho Audit Trail.

Tất cả models cần audit trail phải kế thừa AuditMixin.
Lưu created_by, updated_by, deleted_at (soft delete).

CP08: Database & Data Access
"""

from datetime import datetime
from sqlalchemy import Column, DateTime, String, ForeignKey
from sqlalchemy.orm import Mapped, mapped_column


class AuditMixin:
    """
    Mixin cho audit trail support.

    Cung cấp:
    - created_by: User tạo bản ghi
    - updated_by: User cập nhật bản ghi
    - deleted_at: Thời điểm soft delete (nullable)

    Usage:
        class Order(Base, AuditMixin):
            __tablename__ = "orders"
            ...
    """

    # Created by - user tạo bản ghi
    created_by: Mapped[str | None] = mapped_column(
        String(36),
        ForeignKey("users.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    # Updated by - user cập nhật bản ghi
    updated_by: Mapped[str | None] = mapped_column(
        String(36),
        ForeignKey("users.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    )

    # Deleted at - thời điểm soft delete
    deleted_at: Mapped[datetime | None] = mapped_column(
        DateTime,
        nullable=True,
        index=True,
    )

    def is_deleted(self) -> bool:
        """
        Kiểm tra bản ghi đã soft delete.

        Returns:
            True nếu bản ghi đã được soft delete
        """
        return self.deleted_at is not None

    def soft_delete(self) -> None:
        """
        Soft delete bản ghi.

        Set deleted_at = now() thay vì xóa hẳn.
        """
        self.deleted_at = datetime.utcnow()

    def restore(self) -> None:
        """
        Restore bản ghi từ soft delete.

        Set deleted_at = None.
        """
        self.deleted_at = None