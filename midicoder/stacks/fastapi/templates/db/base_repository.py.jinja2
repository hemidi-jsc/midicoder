"""
Base Repository Pattern cho Async SQLAlchemy.

Repository pattern để abstract database operations.
Tất cả domain repositories kế thừa BaseRepository.

CP08: Database & Data Access
"""

from abc import ABC, abstractmethod
from datetime import datetime
from typing import Any, Generic, TypeVar, Optional

from sqlalchemy import select, update, delete
from sqlalchemy.exc import NoResultFound
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import Mapped, selectinload

from .base_model import Base

# Type variable cho model
ModelType = TypeVar("ModelType", bound=Base)


class RepositoryError(Exception):
    """
    Base exception cho repository errors.
    
    Attributes:
        message: Error message
    """
    
    def __init__(self, message: str) -> None:
        """Khởi tạo exception."""
        self.message = message
        super().__init__(self.message)


class NotFoundError(RepositoryError):
    """
    Exception cho record không tìm thấy.
    """
    
    def __init__(self, model_name: str, id: Any) -> None:
        """Khởi tạo exception."""
        self.model_name = model_name
        self.id = id
        super().__init__(f"{model_name} không tìm thấy với ID: {id}")


class TenantIsolationError(RepositoryError):
    """
    Exception cho tenant isolation violation.
    
    Ném khi cố gắng thay đổi tenant_id của record.
    """
    
    def __init__(self, model_name: str) -> None:
        """Khởi tạo exception."""
        self.model_name = model_name
        super().__init__(f"Không thể thay đổi tenant_id của {model_name}")


class ValidationError(RepositoryError):
    """
    Exception cho validation errors.
    """
    
    def __init__(self, message: str) -> None:
        """Khởi tạo exception."""
        self.message = message
        super().__init__(message)


class BaseRepository(ABC, Generic[ModelType]):
    """
    Base repository với async CRUD operations.
    
    Cung cấp methods:
    - get: Tìm theo ID
    - create: Tạo mới
    - update: Cập nhật
    - delete: Xóa (hoặc soft delete)
    - list: List với pagination/filter
    - count: Đếm records
    - transaction: Wrapper cho transactions
    - bulk_create: Tạo nhiều records cùng lúc
    - bulk_update: Cập nhật nhiều records cùng lúc
    
    Usage:
        class UserRepository(BaseRepository[User]):
            model = User
            ...
    """

    model: type[ModelType]

    def __init__(self, db: AsyncSession) -> None:
        """
        Khởi tạo repository với database session.

        Args:
            db: AsyncSession cho database
        """
        self.db = db

    async def get(
        self,
        id: int,
        tenant_id: Optional[str] = None,
        load_relations: Optional[list[str]] = None,
    ) -> ModelType:
        """
        Tìm record theo ID.
        
        Nếu record không tồn tại, ném NotFoundError.

        Args:
            id: Primary key của record
            tenant_id: Tenant ID (optional filter)
            load_relations: List của relations để load eagerly

        Returns:
            Record nếu tồn tại

        Raises:
            NotFoundError: Nếu record không tìm thấy
        """
        query = select(self.model).where(self.model.id == id)

        # Tenant filter - KPI-029: 100% tenant filter detection
        if tenant_id and hasattr(self.model, "tenant_id"):
            query = query.where(self.model.tenant_id == tenant_id)

        # Load relations nếu có
        if load_relations:
            for relation in load_relations:
                if hasattr(self.model, relation):
                    query = query.options(selectinload(getattr(self.model, relation)))

        result = await self.db.execute(query)
        record = result.scalar_one_or_none()

        if record is None:
            raise NotFoundError(self.model.__name__, id)

        return record

    async def create(
        self,
        data: dict[str, Any],
        tenant_id: Optional[str] = None,
        created_by: Optional[str] = None,
    ) -> ModelType:
        """
        Tạo mới record.

        Args:
            data: Dictionary chứa values cho columns
            tenant_id: Tenant ID (optional)
            created_by: User tạo (optional)

        Returns:
            Record đã tạo

        Raises:
            ValidationError: Nếu data không hợp lệ
        """
        # Validate data
        self._validate_before_create(data)

        # Thêm metadata nếu có
        if tenant_id and hasattr(self.model, "tenant_id"):
            data["tenant_id"] = tenant_id

        if created_by and hasattr(self.model, "created_by"):
            data["created_by"] = created_by

        # Tạo instance
        instance = self.model(**data)

        # Add đến session
        self.db.add(instance)

        # Flush để get ID
        await self.db.flush()

        return instance

    async def update(
        self,
        id: int,
        data: dict[str, Any],
        tenant_id: Optional[str] = None,
        updated_by: Optional[str] = None,
    ) -> ModelType:
        """
        Cập nhật record.
        
        KHIÊN BẢO: Không cho phép thay đổi tenant_id (tenant isolation).

        Args:
            id: Primary key của record
            data: Dictionary chứa values cần update
            tenant_id: Tenant ID để xác thực (optional)
            updated_by: User cập nhật (optional)

        Returns:
            Record đã cập nhật

        Raises:
            NotFoundError: Nếu record không tìm thấy
            TenantIsolationError: Nếu cố gắng thay đổi tenant_id
        """
        # Tenant verification - KPI-029
        if tenant_id and hasattr(self.model, "tenant_id"):
            existing = await self.get(id, tenant_id=tenant_id)
            # Verify tenant match
            if existing.tenant_id != tenant_id:
                raise TenantIsolationError(self.model.__name__)
        else:
            existing = await self.get(id)

        # KHIÊN BẢO: Prevent tenant_id modification
        if "tenant_id" in data or "tenantId" in data:
            raise TenantIsolationError(self.model.__name__)

        # Validate data
        self._validate_before_update(data)

        # Update các fields
        for key, value in data.items():
            if hasattr(existing, key):
                setattr(existing, key, value)

        # Update metadata
        if updated_by and hasattr(existing, "updated_by"):
            existing.updated_by = updated_by

        if hasattr(existing, "updated_at"):
            existing.updated_at = datetime.utcnow()

        await self.db.flush()
        return existing

    async def delete(self, id: int, tenant_id: Optional[str] = None) -> None:
        """
        Xóa record (hard delete hoặc soft delete).

        Args:
            id: Primary key của record
            tenant_id: Tenant ID để xác thực (optional)

        Raises:
            NotFoundError: Nếu record không tìm thấy
        """
        # Tenant verification
        if tenant_id and hasattr(self.model, "tenant_id"):
            await self.get(id, tenant_id=tenant_id)
        else:
            await self.get(id)

        # Soft delete nếu có AuditMixin
        record = await self.get(id)
        if hasattr(record, "soft_delete"):
            record.soft_delete()
            await self.db.flush()
        else:
            await self.db.delete(record)
            await self.db.flush()

    async def list(
        self,
        offset: int = 0,
        limit: int = 100,
        tenant_id: Optional[str] = None,
        filters: Optional[dict[str, Any]] = None,
        order_by: Optional[str] = None,
    ) -> list[ModelType]:
        """
        List records với pagination và filters.
        
        KPI-029: Luôn apply tenant filter nếu model có tenant_id.

        Args:
            offset: Number of records to skip
            limit: Max number of records to return (max 1000)
            tenant_id: Tenant ID filter (optional)
            filters: Additional filters (optional)
            order_by: Field to order by (optional)

        Returns:
            List của records
        """
        # Safety limit
        limit = min(limit, 1000)

        query = select(self.model)

        # Tenant filter - KPI-029: ALWAYS apply if model has tenant_id
        if hasattr(self.model, "tenant_id"):
            if tenant_id:
                query = query.where(self.model.tenant_id == tenant_id)
            # If no tenant_id provided but model requires it, this is a security issue
            # In production, tenant_id should always be provided via dependency injection

        # Additional filters
        if filters:
            for key, value in filters.items():
                if hasattr(self.model, key):
                    query = query.where(getattr(self.model, key) == value)

        # Order by
        if order_by and hasattr(self.model, order_by):
            query = query.order_by(getattr(self.model, order_by))

        # Pagination
        query = query.offset(offset).limit(limit)

        # Exclude soft deleted records
        if hasattr(self.model, "deleted_at"):
            query = query.where(self.model.deleted_at == None)

        result = await self.db.execute(query)
        return list(result.scalars().all())

    async def count(
        self,
        tenant_id: Optional[str] = None,
        filters: Optional[dict[str, Any]] = None,
    ) -> int:
        """
        Đếm số records.

        Args:
            tenant_id: Tenant ID filter (optional)
            filters: Additional filters (optional)

        Returns:
            Số lượng records
        """
        from sqlalchemy import func

        query = select(func.count()).select_from(self.model)

        if tenant_id and hasattr(self.model, "tenant_id"):
            query = query.where(self.model.tenant_id == tenant_id)

        if filters:
            for key, value in filters.items():
                if hasattr(self.model, key):
                    query = query.where(getattr(self.model, key) == value)

        if hasattr(self.model, "deleted_at"):
            query = query.where(self.model.deleted_at == None)

        result = await self.db.execute(query)
        return result.scalar() or 0

    async def bulk_create(
        self,
        items: list[dict[str, Any]],
        tenant_id: Optional[str] = None,
        created_by: Optional[str] = None,
    ) -> list[ModelType]:
        """
        Tạo nhiều records cùng lúc.

        Args:
            items: List của dictionaries chứa data
            tenant_id: Tenant ID (optional)
            created_by: User tạo (optional)

        Returns:
            List của records đã tạo
        """
        results: list[ModelType] = []
        
        for item in items:
            record = await self.create(
                data=item,
                tenant_id=tenant_id,
                created_by=created_by,
            )
            results.append(record)
        
        await self.db.flush()
        return results

    async def bulk_update(
        self,
        ids: list[int],
        data: dict[str, Any],
        tenant_id: Optional[str] = None,
        updated_by: Optional[str] = None,
    ) -> int:
        """
        Cập nhật nhiều records cùng lúc.

        Args:
            ids: List của IDs cần cập nhật
            data: Dictionary chứa values cần update
            tenant_id: Tenant ID để xác thực (optional)
            updated_by: User cập nhật (optional)

        Returns:
            Số records đã cập nhật
        """
        # KHIÊN BẢO: Prevent tenant_id modification
        if "tenant_id" in data or "tenantId" in data:
            raise TenantIsolationError(self.model.__name__)

        updated_count = 0
        
        for id in ids:
            await self.update(
                id=id,
                data=data,
                tenant_id=tenant_id,
                updated_by=updated_by,
            )
            updated_count += 1
        
        return updated_count

    async def transaction(self, func: Any, *args: Any, **kwargs: Any) -> Any:
        """
        Wrapper cho transaction operations.
        
        Tự động rollback nếu có exception.

        Args:
            func: Async function để execute trong transaction
            *args: Positional arguments cho function
            **kwargs: Keyword arguments cho function

        Returns:
            Kết quả của function

        Raises:
            Exception: Nếu function ném exception, transaction sẽ rollback
        """
        try:
            result = await func(*args, **kwargs)
            await self.db.commit()
            return result
        except Exception as e:
            await self.db.rollback()
            raise e

    def _validate_before_create(self, data: dict[str, Any]) -> None:
        """
        Validate data trước khi create.
        
        Override trong derived class cho custom validation.

        Args:
            data: Data cần validate

        Raises:
            ValidationError: Nếu data không hợp lệ
        """
        # Base validation - có thể override
        pass

    def _validate_before_update(self, data: dict[str, Any]) -> None:
        """
        Validate data trước khi update.
        
        Override trong derived class cho custom validation.

        Args:
            data: Data cần validate

        Raises:
            ValidationError: Nếu data không hợp lệ
        """
        # Base validation - có thể override
        pass