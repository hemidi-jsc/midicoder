@dataclass(frozen=True)
class Money:
    """
    Money Value Object.

    Đại diện cho giá tiền tệ với currency code và amount.
    Support multi-currency calculations và conversions.

    Attributes:
        amount: Số tiền (decimal, precision 2)
        currency: Mã tiền tệ (ISO 4217, ví dụ: VND, USD, EUR)
        metadata: Metadata bổ sung (optional)

    Raises:
        ValueError: Nếu validation thất bại

    Examples:
        >>> Money(amount=Decimal("100.00"), currency="USD")
        >>> Money(amount=Decimal("2500000"), currency="VND")
    """

    amount: Decimal
    currency: str
    metadata: Optional[dict] = None

    # KPI-029: Tenant ID cho multi-tenant isolation
    # - Optional field, default=None cho backward compatibility
    # - repr=False: Không hiển thị trong __repr__
    # - compare=False: Không ảnh hưởng đến __eq__ và __hash__
    tenant_id: Optional[str] = field(default=None, repr=False, compare=False)

    def __post_init__(self) -> None:
        """Validate fields sau khi init."""
        # Validate amount là trường bắt buộc
        if self.amount is None:
            raise ValueError("amount là trường bắt buộc")

        # Validate amount >= 0
        if self.amount < 0:
            raise ValueError("amount không thể âm")

        # Validate currency không empty
        if not self.currency or not self.currency.strip():
            raise ValueError("currency là trường bắt buộc")

        # Validate currency format (ISO 4217: 3 uppercase letters)
        import re
        if not re.match(r'^[A-Z]{3}$', self.currency):
            raise ValueError("currency phải là mã ISO 4217 hợp lệ (3 chữ cái viết hoa)")

    @property
    def is_zero(self) -> bool:
        """Kiểm tra xem số tiền có bằng 0 không."""
        return self.amount == Decimal("0")

    @property
    def is_positive(self) -> bool:
        """Kiểm tra xem số tiền có dương không."""
        return self.amount > Decimal("0")

    @property
    def is_negative(self) -> bool:
        """Kiểm tra xem số tiền có âm không."""
        return self.amount < Decimal("0")

    def add(self, other: "Money") -> "Money":
        """
        Thêm hai giá tiền cùng currency.

        Args:
            other: Money khác để thêm

        Returns:
            Money mới với tổng amount

        Raises:
            ValueError: Nếu currency không khớp
        """
        if self.currency != other.currency:
            raise ValueError(f"Không thể cộng tiền khác currency: {self.currency} vs {other.currency}")
        return Money(
            amount=self.amount + other.amount,
            currency=self.currency,
            metadata=self.metadata
        )

    def subtract(self, other: "Money") -> "Money":
        """
        Trừ hai giá tiền cùng currency.

        Args:
            other: Money khác để trừ

        Returns:
            Money mới với hiệu amount
        """
        if self.currency != other.currency:
            raise ValueError(f"Không thể trừ tiền khác currency: {self.currency} vs {other.currency}")
        return Money(
            amount=self.amount - other.amount,
            currency=self.currency,
            metadata=self.metadata
        )

    def multiply(self, factor: Decimal) -> "Money":
        """
        Nhân số tiền với hệ số.

        Args:
            factor: Hệ số nhân

        Returns:
            Money mới với amount đã nhân
        """
        return Money(
            amount=self.amount * factor,
            currency=self.currency,
            metadata=self.metadata
        )

    def convert(self, target_currency: str, exchange_rate: Decimal) -> "Money":
        """
        Chuyển đổi currency với exchange rate.

        Args:
            target_currency: Currency đích (ISO 4217)
            exchange_rate: Tỷ giá chuyển đổi

        Returns:
            Money mới với currency đã chuyển đổi
        """
        converted_amount = self.amount * exchange_rate
        return Money(
            amount=converted_amount.quantize(Decimal("0.01")),
            currency=target_currency,
            metadata={**(self.metadata or {}), "original_currency": self.currency}
        )

    def format(self, locale: str = "en_US") -> str:
        """
        Format tiền tệ theo locale.

        Args:
            locale: Locale (default: en_US)

        Returns:
            Formatted string
        """
        return f"{self.currency} {self.amount:,.2f}"

    def get_tenant_id(self) -> str | None:
        """
        KPI-029: Lấy tenant ID từ Money.
        
        Returns:
            Tenant ID nếu có, None nếu không
        """
        return self.tenant_id

    def with_tenant(self, tenant_id: str) -> "Money":
        """
        KPI-029: Tạo copy của Money với tenant_id mới.
        
        Đây là phương pháp functional cho tenant context propagation.
        Original VO không thay đổi (frozen=True).
        
