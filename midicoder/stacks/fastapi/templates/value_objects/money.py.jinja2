        """
        return cls(
            amount=Decimal(str(data["amount"])),
            currency=data["currency"],
            metadata=data.get("metadata"),
            # KPI-029: tenant_id là optional, default=None
            tenant_id=data.get("tenant_id"),
        )

    def __str__(self) -> str:
        """String representation."""
        return self.format()

    def __repr__(self) -> str:
        """Debug representation."""
        return f"Money(amount={self.amount!r}, currency={self.currency!r})"

    def __hash__(self) -> int:
        """Hash cho frozen Value Object."""
        return hash((self.amount, self.currency))

    def __eq__(self, other: object) -> bool:
        """So sánh equality."""
        if not isinstance(other, Money):
            return False
        return self.amount == other.amount and self.currency == other.currency

    def __lt__(self, other: "Money") -> bool:
        """So sánh less than (same currency only)."""
        if self.currency != other.currency:
            raise ValueError("Cannot compare Money with different currencies")
        return self.amount < other.amount

    def __le__(self, other: "Money") -> bool:
        """So sánh less than or equal."""
        return self == other or self < other

    def __gt__(self, other: "Money") -> bool:
        """So sánh greater than."""
        return not self <= other

    def __ge__(self, other: "Money") -> bool:
        """So sánh greater than or equal."""
