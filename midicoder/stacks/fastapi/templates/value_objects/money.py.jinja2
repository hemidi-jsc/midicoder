    def to_dict(self) -> dict:
        """Chuyển thành dictionary."""
        return {
            "amount": str(self.amount),
            "currency": self.currency,
            "metadata": self.metadata,
        }

    @classmethod
    def from_dict(cls, data: dict) -> "Money":
        """
        Tạo Money từ dictionary.
        
        KPI-029: Bao gồm việc parse tenant_id từ dict (optional).
        
        Args:
            data: Dictionary chứa values cho các fields và tenant_id (optional)
            
        Returns:
