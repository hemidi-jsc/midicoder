"""
Scheduler Service — sinh tự động bởi Midicoder CP31.

Module này cung cấp SchedulerService để quản lý và thực thi
các scheduled jobs với cron/calendar support.

Tích hợp với:
- CP05: Publish events (job.scheduled, job.completed, job.failed)
- CP13: Job execution (JobDefinition, JobInstance)
- CP14: Audit trail logging

CP31: Scheduler & Cron Engine
KPI-029: Tenant Isolation
"""

from __future__ import annotations

import logging
from datetime import datetime, timedelta
from typing import Any, Callable, Optional
from uuid import uuid4

from .cron_parser import CronParser

logger = logging.getLogger(__name__)


{% if schedules %}
# Định nghĩa schedules từ DSL
SCHEDULE_DEFINITIONS = [
{% for schedule in schedules %}
    {
        "schedule_id": "{{ schedule.get("schedule_id", "unknown") }}",
        "type": "{{ schedule.get("type", "cron") }}",
{% if schedule.get("cron_expression") %}
        "cron_expression": "{{ schedule.get("cron_expression") }}",
{% endif %}
{% if schedule.get("frequency") %}
        "frequency": "{{ schedule.get("frequency") }}",
{% endif %}
{% if schedule.get("timezone") %}
        "timezone": "{{ schedule.get("timezone", "UTC") }}",
{% endif %}
        "enabled": {{ "true" if schedule.get("enabled", true) else "false" }},
    },
{% endfor %}
]
{% else %}
# Không có schedule định nghĩa — thêm thủ công hoặc qua config
SCHEDULE_DEFINITIONS: list[dict[str, Any]] = []
{% endif %}


class SchedulerService:
    """Dịch vụ quản lý scheduled jobs.

    Quản lý lifecycle của scheduled jobs:
    - Parse và validate cron expressions
    - Tính toán next run time
    - Execute scheduled jobs
    - Publish events qua CP05 EventBus
    - Ghi audit log qua CP14
    """

    def __init__(
        self,
        event_bus: Any = None,
        audit_logger: Any = None,
    ) -> None:
        """Initialise SchedulerService.

        Args:
            event_bus: CP05 EventBus để publish events.
            audit_logger: CP14 Audit logger.
        """
        self.event_bus = event_bus
        self.audit_logger = audit_logger
        self.schedules = {}
        self._running = False

        # Parse schedule definitions
        for sched_def in SCHEDULE_DEFINITIONS:
            self._register_schedule(sched_def)

    def _register_schedule(self, sched_def: dict[str, Any]) -> None:
        """Register một schedule.

        Args:
            sched_def: Schedule definition dict.
        """
        schedule_id = sched_def["schedule_id"]
        self.schedules[schedule_id] = {
            **sched_def,
            "next_run": None,
            "last_run": None,
            "status": "registered",
        }

        if sched_def.get("cron_expression"):
            parser = CronParser()
            parsed = parser.parse(sched_def["cron_expression"])
            next_run = parser.next_run_time(parsed)
            self.schedules[schedule_id]["next_run"] = next_run
            self.schedules[schedule_id]["parsed"] = parsed

    def start(self) -> None:
        """Bắt đầu scheduler loop."""
        self._running = True
        logger.info("Scheduler đã bắt đầu")
        self._publish_event("scheduler.started", {"status": "running"})
        self._audit("scheduler_started", {"status": "running"})

    def stop(self) -> None:
        """Dừng scheduler loop."""
        self._running = False
        logger.info("Scheduler đã dừng")
        self._publish_event("scheduler.stopped", {"status": "stopped"})

    @property
    def is_running(self) -> bool:
        """Trạng thái scheduler."""
        return self._running

    def get_schedule(self, schedule_id: str) -> Optional[dict[str, Any]]:
        """Lấy thông tin một schedule.

        Args:
            schedule_id: ID của schedule.

        Returns:
            Schedule dict hoặc None.
        """
        return self.schedules.get(schedule_id)

    def list_schedules(self) -> list[dict[str, Any]]:
        """Lấy danh sách tất cả schedules."""
        return list(self.schedules.values())

    def get_due_schedules(self) -> list[dict[str, Any]]:
        """Lấy danh sách schedules cần thực thi.

        Returns:
            Danh sách schedules whose next_run <= now.
        """
        now = datetime.utcnow()
        return [
            s for s in self.schedules.values()
            if s.get("enabled") and s.get("next_run")
            and s["next_run"] <= now
        ]

    def execute_schedule(self, schedule_id: str, handler: Callable) -> dict[str, Any]:
        """Thực thi một scheduled job.

        Args:
            schedule_id: ID của schedule.
            handler: Callable để execute job.

        Returns:
            Result dict.
        """
        schedule = self.schedules.get(schedule_id)
        if not schedule:
            return {"error": f"Schedule {schedule_id} không tồn tại"}

        instance_id = str(uuid4())
        self._publish_event("job.scheduled", {
            "job_id": instance_id,
            "schedule_id": schedule_id,
            "scheduled_time": schedule.get("next_run"),
        })

        try:
            result = handler(schedule)
            self.schedules[schedule_id]["last_run"] = datetime.utcnow()
            self.schedules[schedule_id]["status"] = "completed"

            # Calculate next run
            if schedule.get("parsed"):
                parser = CronParser()
                self.schedules[schedule_id]["next_run"] = parser.next_run_time(
                    schedule["parsed"],
                    datetime.utcnow(),
                )

            self._publish_event("job.completed", {
                "job_id": instance_id,
                "schedule_id": schedule_id,
                "status": "completed",
            })
            self._audit("job_completed", {
                "job_id": instance_id,
                "schedule_id": schedule_id,
            })

            return {"job_id": instance_id, "status": "completed", "result": result}

        except Exception as e:
            self.schedules[schedule_id]["status"] = "failed"
            self._publish_event("job.failed", {
                "job_id": instance_id,
                "schedule_id": schedule_id,
                "error": str(e),
            })
            self._audit("job_failed", {
                "job_id": instance_id,
                "schedule_id": schedule_id,
                "error": str(e),
            })
            return {"job_id": instance_id, "status": "failed", "error": str(e)}

    def _publish_event(self, event_name: str, payload: dict[str, Any]) -> None:
        """Publish event qua CP05 EventBus.

        Args:
            event_name: Tên event.
            payload: Event payload.
        """
        if self.event_bus:
            try:
                self.event_bus.publish(event_name, payload)
            except Exception as e:
                logger.warning("Không thể publish event %s: %s", event_name, e)

    def _audit(self, action: str, metadata: dict[str, Any]) -> None:
        """Ghi audit log qua CP14.

        Args:
            action: Action name.
            metadata: Audit metadata.
        """
        if self.audit_logger:
            try:
                self.audit_logger.log(
                    action=action,
                    actor_type="scheduler",
                    entity="scheduler",
                    metadata=metadata,
                )
            except Exception as e:
                logger.warning("Không thể ghi audit log %s: %s", action, e)
