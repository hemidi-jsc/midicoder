"""
Cron Parser Engine — sinh tự động bởi Midicoder CP31.

Module này cung cấp CronParser để parse và tính toán
cron expression cho scheduled jobs.

CP31: Scheduler & Cron Engine
"""

from __future__ import annotations

import re
from datetime import datetime, timedelta
from typing import Optional


MONTH_NAMES = {
    "JAN": 1, "FEB": 2, "MAR": 3, "APR": 4, "MAY": 5, "JUN": 6,
    "JUL": 7, "AUG": 8, "SEP": 9, "OCT": 10, "NOV": 11, "DEC": 12,
}

DAY_NAMES = {
    "SUN": 0, "MON": 1, "TUE": 2, "WED": 3, "THU": 4, "FRI": 5, "SAT": 6,
}

SPECIAL_STRINGS = {
    "@yearly": "0 0 1 1 *", "@annually": "0 0 1 1 *",
    "@monthly": "0 0 1 * *", "@weekly": "0 0 * * 0",
    "@daily": "0 0 * * *", "@midnight": "0 0 * * *",
    "@hourly": "0 * * * *",
}


class CronParser:
    """Parser cho standard cron expression.

    Support 5 field: minute hour day_of_month month day_of_week
    """

    def parse(self, expression: str) -> dict:
        """Parse cron expression thành dict.

        Args:
            expression: Cron expression string.

        Returns:
            Dict với keys: minute, hour, day_of_month, month, day_of_week
        """
        expr = expression.strip()
        if expr.lower() in SPECIAL_STRINGS:
            expr = SPECIAL_STRINGS[expr.lower()]

        parts = expr.split()
        if len(parts) != 5:
            raise ValueError(f"Invalid cron expression: {expression}")

        minute = self._parse_field(parts[0], 0, 59)
        hour = self._parse_field(parts[1], 0, 23)
        dom = self._parse_field(parts[2], 1, 31)
        month = self._parse_field(parts[3], 1, 12)
        dow = self._parse_field(parts[4], 0, 6)

        return {
            "minute": minute, "hour": hour,
            "day_of_month": dom, "month": month, "day_of_week": dow,
        }

    def _parse_field(self, raw: str, min_val: int, max_val: int) -> list[int]:
        """Parse một field cron thành danh sách giá trị."""
        values = set()
        upper_raw = raw.upper()
        for name, num in {**MONTH_NAMES, **DAY_NAMES}.items():
            upper_raw = upper_raw.replace(name, str(num))

        for part in upper_raw.split(","):
            if "/" in part:
                base, step = part.split("/", 1)
                start = min_val if base == "*" else int(base)
                values.update(range(start, max_val + 1, int(step)))
            elif "-" in part:
                s, e = map(int, part.split("-", 1))
                values.update(range(s, e + 1))
            elif part == "*":
                values.update(range(min_val, max_val + 1))
            else:
                values.add(int(part))

        return sorted(values)

    def next_run_time(self, parsed: dict, after: Optional[datetime] = None) -> datetime:
        """Tính thời điểm chạy tiếp theo.

        Args:
            parsed: Dict đã parse.
            after: Tính từ thời điểm nào.

        Returns:
            DateTime của lần chạy tiếp theo.
        """
        if after is None:
            after = datetime.utcnow()

        candidate = after.replace(second=0, microsecond=0) + timedelta(minutes=1)
        for _ in range(366 * 24 * 60 * 4):  # Max 4 years
            if (candidate.minute in parsed["minute"]
                    and candidate.hour in parsed["hour"]
                    and candidate.month in parsed["month"]
                    and candidate.day in parsed["day_of_month"]
                    and (candidate.weekday() + 1) % 7 in parsed["day_of_week"]):
                return candidate
            candidate += timedelta(minutes=1)

        raise ValueError("Không tìm được thời điểm chạy tiếp theo")


