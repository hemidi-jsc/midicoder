"""

import asyncio
import logging
from typing import Any, Callable

from .redis import get_redis, get_key_with_tenant

logger = logging.getLogger(__name__)

_BATCH_SIZE = 100
_PARALLELISM = 4

WARMUP_KEYS: list[str] = []


async def warm_key(
    key: str,
    loader: Callable,
    ttl: int = 300,
    tenant_id: str | None = None,
) -> bool:
    """Warm 1 key: check if exists, nếu không thì load và set."""
    redis = get_redis()
    full_key = get_key_with_tenant(key, tenant_id)

    existing = await redis.get(full_key)
    if existing is not None:
        return True

    try:
        value = loader(key) if callable(loader) else loader
        if hasattr(value, "__await__"):
            value = await value
        await redis.setex(full_key, ttl, str(value))
        return True
    except Exception as e:
        logger.error(f"[CacheWarmup] Failed to warm key {key}: {e}")
        return False


async def warm_batch(
    keys: list[str],
    loader: Callable,
    ttl: int = 300,
    tenant_id: str | None = None,
) -> dict[str, bool]:
    """Warm batch keys với semaphore để limit concurrency."""
    semaphore = asyncio.Semaphore(_PARALLELISM)
    results: dict[str, bool] = {}

    async def _warm_with_semaphore(key: str) -> tuple[str, bool]:
        async with semaphore:
            success = await warm_key(key, loader, ttl, tenant_id)
            return (key, success)

    tasks = [asyncio.create_task(_warm_with_semaphore(k)) for k in keys]
    for task in asyncio.as_completed(tasks):
        key, success = await task
        results[key] = success

    return results


async def warm_on_startup(
    loader: Callable,
    ttl: int = 300,
    tenant_id: str | None = None,
) -> dict[str, bool]:
    """Warm cache khi service khởi động."""
    logger.info("[CacheWarmup] Starting warmup on startup...")
    results = await warm_batch(WARMUP_KEYS, loader, ttl, tenant_id)
    success_count = sum(1 for v in results.values() if v)
    logger.info(
        f"[CacheWarmup] Warmed {success_count}/{len(results)} keys"
    )
    return results
