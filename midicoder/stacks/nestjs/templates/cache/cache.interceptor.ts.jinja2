/**
 * Cache Interceptor cho NestJS.
 *
 * Tự động cache HTTP responses với TTL.
 * Hỗ trợ cache invalidation.
 * KPI-029: Tenant Isolation - Cache keys được prefix với tenantId.
 *
 * CP09: Caching & Performance
 * KPI-029: Tenant Isolation - Multi-tenant cache support
 */

import {
  Injectable,
  NestInterceptor,
  ExecutionContext,
  CallHandler,
  Logger,
} from "@nestjs/common";
import { Reflector } from "@nestjs/core";
import { Observable, of } from "rxjs";
import { tap, catchError } from "rxjs/operators";
import { Redis } from "ioredis";

// ============================================================================
// Type Definitions - Sử dụng interface thay vì DOM Request type
// ============================================================================

/**
 * Interface cho HTTP Request - tương thích Express/Fastify.
 *
 * KPI-029: Bao gồm tenantId cho tenant isolation.
 */
interface HttpCompatibleRequest {
  method?: string;
  url?: string;
  headers: Record<string, string | string[] | undefined>;
  /** KPI-029: Tenant ID từ middleware hoặc header */
  tenantId?: string;
  [key: string]: unknown;
}

// ============================================================================
// Decorator Metadata Keys
// ============================================================================

export const CACHE_TTL = "cacheTtl";
export const CACHE_KEY = "cacheKey";
export const CACHE_DISABLE = "cacheDisable";

// Default TTL (giây)
const DEFAULT_TTL = 300;

// Logger instance - thay thế console.log
const logger = new Logger("CacheInterceptor");

/**
 * Cache TTL Decorator.
 *
 * @param ttl - Time-to-live (giây)
 *
 * Usage:
 *   @UseInterceptors(CacheInterceptor)
 *   @CacheTTL(600)
 *   @Get(":id")
 *   findOne(@Param('id') id: string) { ... }
 */
export function CacheTTL(ttl: number) {
  return Reflect.metadata(CACHE_TTL, ttl);
}

/**
 * Cache Key Decorator.
 *
 * @param key - Custom cache key
 *
 * Usage:
 *   @CacheTTL(300)
 *   @CacheKey("user:profile")
 *   @Get("profile")
 *   getProfile() { ... }
 */
export function CacheKey(key: string) {
  return Reflect.metadata(CACHE_KEY, key);
}

/**
 * Cache Disable Decorator.
 *
 * Tắt caching cho endpoint.
 *
 * Usage:
 *   @CacheDisable()
 *   @Post()
 *   create() { ... }
 */
export function CacheDisable() {
  return Reflect.metadata(CACHE_DISABLE, true);
}

// ============================================================================
// Tenant ID Sanitization - KPI-029
// ============================================================================

/**
 * Chuẩn hóa tenantId để an toàn cho Redis keys.
 *
 * KPI-029: Tenant Isolation - Đảm bảo tenantId không chứa ký tự đặc biệt
 * có thể làm hỏng format của Redis keys.
 *
 * @param rawTenantId - Tenant ID thô từ request
 * @returns Tenant ID đã được sanitize
 */
function sanitizeTenantId(rawTenantId: string): string {
  // Loại bỏ ký tự đặc biệt, chỉ giữ alphanumeric, dash, underscore
  return String(rawTenantId).replace(/[^a-zA-Z0-9_-]/g, "_");
}

// ============================================================================
// Safe JSON Serialization
// ============================================================================

/**
 * Serialize an toàn thành JSON string.
 *
 * Xử lý các trường hợp JSON.stringify thất bại:
 * - Streams, Buffers, circular objects
 * - Returns null nếu không thể serialize
 *
 * @param data - Data cần serialize
 * @returns JSON string hoặc null
 */
function safeStringify(data: unknown): string | null {
  try {
    // Guard: không serialize undefined, null
    if (data === undefined || data === null) {
      return null;
    }
    return JSON.stringify(data);
  } catch {
    // Nếu serialize thất bại, trả về null
    return null;
  }
}

/**
 * Parse an toàn từ JSON string.
 *
 * @param data - JSON string cần parse
 * @returns Parsed object hoặc null
 */
function safeParse(data: string | null): unknown {
  if (!data) {
    return null;
  }
  try {
    return JSON.parse(data);
  } catch {
    return null;
  }
}

// ============================================================================
// Cache Interceptor
// ============================================================================

/**
 * Cache Interceptor.
 *
 * Tự động cache responses và invalidate khi cần.
 * KPI-029: Tenant Isolation - Cache keys được prefix với tenantId.
 */
@Injectable()
export class CacheInterceptor implements NestInterceptor {
  /**
   * Constructor.
   *
   * @param reflector - NestJS Reflector
   * @param redis - Redis client
   */
  constructor(
    private readonly reflector: Reflector,
    private readonly redis: Redis,
  ) {}

  /**
   * Intercept HTTP requests.
   *
   * @param context - Execution context
   * @param next - Next handler
   * @returns Observable với cache logic
   */
  intercept(
    context: ExecutionContext,
    next: CallHandler,
  ): Observable<unknown> {
    // Check if cache is disabled
    const isDisabled = this.reflector.getAllAndOverride<boolean>(
      CACHE_DISABLE,
      [context.getHandler(), context.getClass()],
    );

    if (isDisabled) {
      return next.handle();
    }

    // Get cache configuration
    const ttl = this.reflector.getAllAndOverride<number>(
      CACHE_TTL,
      [context.getHandler(), context.getClass()],
    ) || DEFAULT_TTL;

    const customKey = this.reflector.getAllAndOverride<string>(
      CACHE_KEY,
      [context.getHandler(), context.getClass()],
    );

    // KPI-029: Tenant Isolation - Lấy tenantId từ request context
    const request = context.switchToHttp().getRequest<HttpCompatibleRequest>();

    // Get tenantId từ headers hoặc request context
    // KPI-029: Nếu không có tenantId, KHÔNG dùng 'default' để tránh cache collision
    const rawTenantId =
      (request.headers["x-tenant-id"] as string) || request.tenantId;

    if (!rawTenantId) {
      // Không có tenantId → không cache (an toàn hơn là dùng default)
      logger.debug("[Cache] SKIP: Missing tenantId, bypassing cache");
      return next.handle();
    }

    // KPI-029: Sanitize tenantId để an toàn cho Redis keys
    const tenantId = sanitizeTenantId(rawTenantId);

    const key = customKey || this.generateKey(request, tenantId);

    // Try get from cache
    return this.redis.get(key).then((cached) => {
      if (cached) {
        // Cache hit
        const parsed = safeParse(cached);
        if (parsed !== null) {
          logger.debug(`[Cache] HIT: ${key}`);
          return of(parsed);
        }
      }

      // Cache miss - call handler
      logger.debug(`[Cache] MISS: ${key}`);
      return next.handle().pipe(
        tap((response) => {
          // Cache the response với safe stringify
          const serialized = safeStringify(response);
          if (serialized) {
            this.redis.setex(key, ttl, serialized);
          }
        }),
        catchError((error) => {
          // Không cache errors
          logger.error(`[Cache] Error: ${key}`, error.stack);
          throw error;
        }),
      );
    });
  }

  /**
   * Generate cache key từ request với tenant prefix.
   *
   * KPI-029: Tenant Isolation - Cache key format: `{tenantId}:{method}:{path}`
   * Điều này đảm bảo cache của tenant A không bị share với tenant B.
   *
   * @param request - HTTP request
   * @param tenantId - Tenant ID đã được sanitize
   * @returns Cache key string với tenant prefix
   */
  private generateKey(request: HttpCompatibleRequest, tenantId: string): string {
    const method = request.method || "GET";
    const path = request.url || "/";
    // KPI-029: Prefix với tenantId để isolate cache theo tenant
    return `${tenantId}:${method}:${path}`;
  }

  /**
   * Invalidate cache theo pattern.
   *
   * @param pattern - Glob pattern
   * @returns Số lượng keys đã xóa
   */
  async invalidate(pattern: string): Promise<number> {
    const keys: string[] = [];
    let cursor = "0";

    do {
      const [newCursor, keysBatch] = await this.redis.scan(
        cursor,
        "MATCH",
        pattern,
        "COUNT",
        "100",
      );
      cursor = newCursor;
      keys.push(...keysBatch);
    } while (cursor !== "0");

    if (keys.length > 0) {
      await this.redis.del(...keys);
      logger.log(`[Cache] Invalidated ${keys.length} keys matching: ${pattern}`);
    }

    return keys.length;
  }

  /**
   * Invalidate single key.
   *
   * @param key - Cache key
   * @returns True nếu xóa thành công
   */
  async invalidateKey(key: string): Promise<boolean> {
    const deleted = await this.redis.del(key);
    return deleted > 0;
  }

  /**
   * Clear tất cả cache - CẢNH BÁO: Chỉ dùng cho development.
   *
   * KPI-029: Trong production, nên xóa theo tenant pattern thay vì clear all.
   * Sử dụng clearTenantCache() từ redis.module.ts thay thế.
   *
   * @returns Số lượng keys đã xóa
   */
  async clearAll(): Promise<number> {
    logger.warn(
      "[Cache] clearAll() gọi - hoạt động nguy hiểm trong production!",
    );
    return this.invalidate("*");
  }
}