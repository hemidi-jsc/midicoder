/**
 * Compliance Service - Regulatory Compliance Service cho NestJS.
 * 
 * Module này cung cấp Compliance service cho:
 * - KYC verification (Know Your Customer - RX03)
 * - AML screening (Anti-Money Laundering - RX03)
 * - HIPAA clearance (Healthcare Privacy - RX04)
 * - Compliance audit logging (RX02, RX03, RX04)
 * 
 * CP01: Domain Guards with Compliance Support
 * KPI-029: Tenant Isolation - tenant-scoped compliance checks và audit logs
 */

import { Injectable, Inject, Optional } from "@nestjs/common";
import { ComplianceRepository } from "../db/compliance.repository";
import { AuditLoggerService } from "../audit/audit.service";

/**
 * KYC Status interface.
 */
interface KycStatus {
  verified: boolean;
  expired: boolean;
  verifiedDate?: Date;
  expiryDate?: Date;
}

/**
 * AML Screening Result interface.
 */
interface AmlScreeningResult {
  cleared: boolean;
  expired: boolean;
  screenedDate?: Date;
  expiryDate?: Date;
}

/**
 * HIPAA Clearance interface.
 */
interface HipaaClearance {
  active: boolean;
  expired: boolean;
  grantedDate?: Date;
  expiryDate?: Date;
}

/**
 * Compliance Audit Record interface.
 */
interface ComplianceAuditRecord {
  timestamp: string;
  guardType: "kyc_check" | "aml_screening" | "hipaa_access" | "suspicious_activity" | "minimum_necessary_violation";
  userId: string;
  tenantId: string;
  result: "passed" | "failed" | "skipped" | "flagged";
  commandId?: string;
  details?: Record<string, any>;
}

/**
 * Compliance Service - Service cho regulatory compliance checks.
 * 
 * Service này cung cấp methods cho:
 * - KYC verification (RX03)
 * - AML screening (RX03)
 * - HIPAA clearance (RX04)
 * - Compliance audit logging
 * 
 * KPI-029: Support tenant-scoped compliance checks và tenant-specific audit logs.
 * 
 * RX02 (Financial Integrity):
 * - Double-entry validation
 * - Transaction immutability
 * - Daily reconciliation
 * 
 * RX03 (AML/KYC):
 * - KYC verification required
 * - AML screening required
 * - Suspicious activity reporting
 * 
 * RX04 (HIPAA):
 * - PHI encryption required
 * - Clinical audit trail
 * - Minimum necessary access
 */
@Injectable()
export class ComplianceService {
  private readonly logger = new ConsoleLogger();
  private readonly defaultAmlThreshold = 100000000; // 100 triệu VND

  constructor(
    @Inject("COMPLIANCE_REPOSITORY")
    private readonly complianceRepo: ComplianceRepository,
    private readonly auditLogger: AuditLoggerService,
    @Optional()
    @Inject("EXTERNAL_AML_API_URL")
    private readonly externalAmlApiUrl?: string,
    @Optional()
    @Inject("EXTERNAL_KYC_API_URL")
    private readonly externalKycApiUrl?: string,
  ) {}

  // -------------------------------------------------------------------------
  // KYC Verification (RX03)
  // -------------------------------------------------------------------------

  /**
   * Check KYC verification status của user.
   * 
   * KPI-029: Support tenant-scoped KYC verification.
   * RX03: kyc_verification_required - User phải được KYC verify trước khi thực hiện financial transactions.
   * 
   * @param userId - User ID để check
   * @param tenantId - KPI-029: Tenant ID cho tenant-scoped KYC check
   * @returns True nếu user đã được KYC verify, False nếu chưa
   */
  async checkKyc(userId: string, tenantId?: string): Promise<boolean> {
    try {
      // KPI-029: Check tenant-scoped KYC verification
      const kycStatus = await this.complianceRepo.getKycStatus(userId, tenantId);

      if (!kycStatus) {
        // User chưa có KYC record - check external API
        if (this.externalKycApiUrl) {
          return this.checkExternalKyc(userId, tenantId);
        }

        // No external API - return False (not verified)
        return false;
      }

      // Check nếu KYC đã được verify
      return kycStatus.verified && !kycStatus.expired;
    } catch (error) {
      this.auditLogger.error("Error checking KYC status", {
        userId,
        tenantId,
        error: error instanceof Error ? error.message : String(error),
      });
      // On error, default to not verified (fail-safe)
      return false;
    }
  }

  /**
   * Check external KYC verification API.
   * 
   * @param userId - User ID
   * @param tenantId - Tenant ID
   * @returns True nếu KYC verified từ external API
   */
  private async checkExternalKyc(userId: string, tenantId?: string): Promise<boolean> {
    // TODO: Implement external KYC API call
    this.auditLogger.info("External KYC check requested", {
      userId,
      tenantId,
      apiUrl: this.externalKycApiUrl,
    });
    return false; // For now, return False (not verified)
  }

  // -------------------------------------------------------------------------
  // AML Screening (RX03)
  // -------------------------------------------------------------------------

  /**
   * Check AML screening cho transaction.
   * 
   * KPI-029: Support tenant-scoped AML screening.
   * RX03: aml_screening_required - Transactions phải qua AML screening.
   * 
   * @param userId - User ID thực hiện transaction
   * @param transactionData - Transaction data để screening
   * @param tenantId - KPI-029: Tenant ID cho tenant-scoped AML check
   * @returns True nếu transaction AML cleared, False nếu failed
   */
  async checkAml(
    userId: string,
    transactionData: Record<string, any>,
    tenantId?: string,
  ): Promise<boolean> {
    try {
      const amount = transactionData.amount ?? 0;

      // KPI-029: Check tenant-scoped AML rules
      const amlResult = await this.complianceRepo.getAmlScreeningResult(userId, tenantId);

      if (!amlResult) {
        // User chưa có AML screening record - check external API
        if (this.externalAmlApiUrl) {
          return this.checkExternalAml(userId, transactionData, tenantId);
        }

        // No external API and no record - assume cleared for small amounts
        const threshold = this.getAmlThreshold(tenantId);
        return amount < threshold;
      }

      // Check nếu AML đã cleared
      return amlResult.cleared && !amlResult.expired;
    } catch (error) {
      this.auditLogger.error("Error checking AML status", {
        userId,
        tenantId,
        amount: transactionData.amount,
        error: error instanceof Error ? error.message : String(error),
      });
      // On error, default to not cleared (fail-safe)
      return false;
    }
  }

  /**
   * Check external AML screening API.
   * 
   * @param userId - User ID
   * @param transactionData - Transaction data
   * @param tenantId - Tenant ID
   * @returns True nếu AML cleared từ external API
   */
  private async checkExternalAml(
    userId: string,
    transactionData: Record<string, any>,
    tenantId?: string,
  ): Promise<boolean> {
    // TODO: Implement external AML API call
    const amount = transactionData.amount ?? 0;
    const threshold = this.getAmlThreshold(tenantId);

    this.auditLogger.info("External AML check requested", {
      userId,
      tenantId,
      amount,
      apiUrl: this.externalAmlApiUrl,
    });

    // Default: amounts below threshold are cleared
    return amount < threshold;
  }

  /**
   * Get AML screening threshold.
   * 
   * KPI-029: Support tenant-specific thresholds.
   * 
   * @param tenantId - Tenant ID
   * @returns AML threshold amount
   */
  private getAmlThreshold(tenantId?: string): number {
    // Default threshold: 100 triệu VND
    let threshold = this.defaultAmlThreshold;

    // TODO: Load tenant-specific threshold from config
    // if (tenantId) {
    //   threshold = await this.loadTenantThreshold(tenantId);
    // }

    return threshold;
  }

  // -------------------------------------------------------------------------
  // HIPAA Clearance (RX04)
  // -------------------------------------------------------------------------

  /**
   * Check HIPAA clearance của user.
   * 
   * KPI-029: Support tenant-scoped HIPAA clearance.
   * RX04: hipaa_compliance_required - Users phải có HIPAA clearance để truy cập PHI data.
   * 
   * @param userId - User ID để check
   * @param tenantId - KPI-029: Tenant ID cho tenant-scoped HIPAA check
   * @returns True nếu user có HIPAA clearance, False nếu không
   */
  async checkHipaaClearance(userId: string, tenantId?: string): Promise<boolean> {
    try {
      // KPI-029: Check tenant-scoped HIPAA clearance
      const clearance = await this.complianceRepo.getHipaaClearance(userId, tenantId);

      if (!clearance) {
        // User chưa có HIPAA clearance record
        return false;
      }

      // Check nếu clearance còn valid
      return clearance.active && !clearance.expired;
    } catch (error) {
      this.auditLogger.error("Error checking HIPAA clearance", {
        userId,
        tenantId,
        error: error instanceof Error ? error.message : String(error),
      });
      // On error, default to no clearance (fail-safe)
      return false;
    }
  }

  // -------------------------------------------------------------------------
  // Compliance Audit Logging (RX02, RX03, RX04)
  // -------------------------------------------------------------------------

  /**
   * Log compliance check vào audit trail.
   * 
   * KPI-029: Audit log bao gồm tenant_id cho multi-tenant compliance tracking.
   * RX04: clinical_audit_trail - All PHI access phải được log.
   * 
   * @param auditRecord - Audit record để log
   */
  async logComplianceCheck(auditRecord: ComplianceAuditRecord): Promise<void> {
    try {
      // Add timestamp nếu chưa có
      if (!auditRecord.timestamp) {
        auditRecord.timestamp = new Date().toISOString();
      }

      // KPI-029: Ensure tenant_id is present
      if (!auditRecord.tenantId) {
        auditRecord.tenantId = "global";
      }

      // Save to audit log repository
      await this.complianceRepo.saveComplianceAudit(auditRecord);

      // Also log to application logs
      const { result, guardType, userId, tenantId, details } = auditRecord;

      if (result === "passed") {
        this.auditLogger.info("Compliance check passed", {
          guardType,
          userId,
          tenantId,
          ...details,
        });
      } else if (result === "failed") {
        this.auditLogger.warn("Compliance check failed", {
          guardType,
          userId,
          tenantId,
          ...details,
        });
      } else {
        this.auditLogger.debug("Compliance check skipped", {
          guardType,
          userId,
          tenantId,
          ...details,
        });
      }
    } catch (error) {
      this.auditLogger.error("Compliance log write failed", {
        guardType: auditRecord.guardType,
        userId: auditRecord.userId,
        tenantId: auditRecord.tenantId,
        error: error instanceof Error ? error.message : String(error),
      });
      // In production, throw an error here
      throw error;
    }
  }

  // -------------------------------------------------------------------------
  // RX02: Financial Integrity Validation Helpers
  // -------------------------------------------------------------------------

  /**
   * Validate double-entry bookkeeping rule (RX02).
   * 
   * Rule: Debit tổng phải bằng Credit tổng.
   * 
   * @param debit - Tổng debit
   * @param credit - Tổng credit
   * @returns True nếu debit == credit (within tolerance)
   */
  validateDoubleEntry(debit: number, credit: number): boolean {
    // Allow 0.01 tolerance for rounding
    return Math.abs(debit - credit) <= 0.01;
  }

  /**
   * Check nếu transaction đã được commit (immutable).
   * 
   * RX02: transaction_immutability - Transactions immutable sau commit.
   * 
   * @param transactionId - Transaction ID
   * @param tenantId - KPI-029: Tenant ID
   * @returns True nếu transaction đã immutable (committed)
   */
  async checkTransactionImmutability(
    transactionId: string,
    tenantId?: string,
  ): Promise<boolean> {
    // TODO: Check transaction status from repository
    return false;
  }

  // -------------------------------------------------------------------------
  // RX03: Suspicious Activity Detection
  // -------------------------------------------------------------------------

  /**
   * Check nếu transaction có suspicious activity patterns.
   * 
   * RX03: suspicious_activity_reporting - Flag transactions > threshold.
   * 
   * @param userId - User ID
   * @param transactionData - Transaction data
   * @param tenantId - KPI-029: Tenant ID
   * @returns True nếu có suspicious activity (needs SAR)
   */
  async checkSuspiciousActivity(
    userId: string,
    transactionData: Record<string, any>,
    tenantId?: string,
  ): Promise<boolean> {
    const amount = transactionData.amount ?? 0;
    const threshold = this.getAmlThreshold(tenantId);

    // Flag if amount exceeds threshold
    if (amount > threshold) {
      await this.logComplianceCheck({
        timestamp: new Date().toISOString(),
        guardType: "suspicious_activity",
        userId,
        tenantId: tenantId ?? "global",
        result: "flagged",
        commandId: transactionData.commandId,
        details: {
          amount,
          threshold,
          reason: "Amount exceeds AML threshold",
        },
      });
      return true;
    }

    return false;
  }

  // -------------------------------------------------------------------------
  // RX04: PHI Access Control
  // -------------------------------------------------------------------------

  /**
   * Check nếu user có quyền access các PHI fields.
   * 
   * RX04: minimum_necessary_access - Users chỉ access necessary PHI fields.
   * 
   * @param userId - User ID
   * @param phiFields - PHI fields user đang request
   * @param userAllowedFields - PHI fields user được phép access
   * @param tenantId - KPI-029: Tenant ID
   * @returns True nếu user có quyền access tất cả requested fields
   */
  async checkPhiAccessAllowed(
    userId: string,
    phiFields: string[],
    userAllowedFields: string[],
    tenantId?: string,
  ): Promise<boolean> {
    const requestedSet = new Set(phiFields);
    const allowedSet = new Set(userAllowedFields);

    // Check nếu tất cả requested fields đều trong allowed set
    const excessAccess = phiFields.filter((field) => !allowedSet.has(field));

    if (excessAccess.length > 0) {
      await this.logComplianceCheck({
        timestamp: new Date().toISOString(),
        guardType: "minimum_necessary_violation",
        userId,
        tenantId: tenantId ?? "global",
        result: "failed",
        details: {
          excessFields: excessAccess,
          reason: "User attempted to access PHI fields without permission",
        },
      });
      return false;
    }

    return true;
  }

  // -------------------------------------------------------------------------
  // Compliance Status Management
  // -------------------------------------------------------------------------

  /**
   * Update KYC verification status.
   * 
   * @param userId - User ID
   * @param verified - KYC verified status
   * @param tenantId - KPI-029: Tenant ID
   * @param expiryDate - KYC expiry date
   */
  async updateKycStatus(
    userId: string,
    verified: boolean,
    tenantId?: string,
    expiryDate?: Date,
  ): Promise<void> {
    await this.complianceRepo.updateKycStatus(userId, verified, tenantId, expiryDate);
  }

  /**
   * Update AML screening status.
   * 
   * @param userId - User ID
   * @param cleared - AML cleared status
   * @param tenantId - KPI-029: Tenant ID
   * @param expiryDate - AML expiry date
   */
  async updateAmlStatus(
    userId: string,
    cleared: boolean,
    tenantId?: string,
    expiryDate?: Date,
  ): Promise<void> {
    await this.complianceRepo.updateAmlStatus(userId, cleared, tenantId, expiryDate);
  }

  /**
   * Update HIPAA clearance status.
   * 
   * @param userId - User ID
   * @param active - HIPAA clearance active status
   * @param tenantId - KPI-029: Tenant ID
   * @param expiryDate - Clearance expiry date
   */
  async updateHipaaClearance(
    userId: string,
    active: boolean,
    tenantId?: string,
    expiryDate?: Date,
  ): Promise<void> {
    await this.complianceRepo.updateHipaaClearance(userId, active, tenantId, expiryDate);
  }
}

/**
 * Simple console logger for development.
 * Replace with Winston/Pino in production.
 */
class ConsoleLogger {
  info(message: string, context?: Record<string, any>): void {
    console.log(`[ComplianceService] INFO: ${message}`, context);
  }

  warn(message: string, context?: Record<string, any>): void {
    console.warn(`[ComplianceService] WARN: ${message}`, context);
  }

  error(message: string, context?: Record<string, any>): void {
    console.error(`[ComplianceService] ERROR: ${message}`, context);
  }

  debug(message: string, context?: Record<string, any>): void {
    console.debug(`[ComplianceService] DEBUG: ${message}`, context);
  }
}