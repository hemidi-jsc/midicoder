/**
 * File Upload Service cho NestJS.
 *
 * Cung cấp:
 * - File upload handling
 * - Validation
 * - S3 integration
 *
 * KPI-029: Tenant Isolation - Hỗ trợ tenant-specific folder prefix
 * CP11: File Storage & Media
 */

import { Injectable, Inject } from "@nestjs/common";
import { v4 as uuidv4 } from "uuid";
import * as AWS from "@aws-sdk/client-s3";
import { PutObjectCommand, DeleteObjectCommand, GetObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";

// Allowed content types
const ALLOWED_IMAGE_TYPES = ["image/jpeg", "image/png", "image/gif", "image/webp"];
const ALLOWED_VIDEO_TYPES = ["video/mp4", "video/webm"];
const ALLOWED_DOCUMENT_TYPES = ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"];

// Max file sizes
const MAX_IMAGE_SIZE = 10 * 1024 * 1024; // 10MB
const MAX_VIDEO_SIZE = 100 * 1024 * 1024; // 100MB
const MAX_DOCUMENT_SIZE = 10 * 1024 * 1024; // 10MB

// KPI-029: Tenant folder prefix settings
const STORAGE_TENANT_PREFIX = process.env.STORAGE_TENANT_PREFIX || "tenant";
const STORAGE_TENANT_ISOLATION = (process.env.STORAGE_TENANT_ISOLATION || "true").toLowerCase() === "true";

/**
 * File Upload Service.
 *
 * KPI-029: Hỗ trợ tenant-specific folder prefix để isolate files theo tenant.
 */
@Injectable()
export class FileUploadService {
  /**
   * Constructor.
   *
   * @param s3Client - AWS S3 client
   * @param tenantId KPI-029: Tenant ID cho tenant-specific operations
   */
  constructor(
    @Inject("S3_CLIENT")
    private readonly s3Client: AWS.S3Client,
    private readonly tenantId?: string,
  ) {}

  private readonly bucket = process.env.S3_BUCKET || "uploads";

  /**
   * KPI-029: Tạo folder path với tenant prefix.
   *
   * @param folder - Folder gốc
   * @param tenantId - Tenant ID (override instance tenantId)
   * @returns Folder path với tenant prefix
   */
  private getTenantFolder(folder: string, tenantId?: string): string {
    const effectiveTenantId = tenantId || this.tenantId;
    if (STORAGE_TENANT_ISOLATION && effectiveTenantId) {
      return `${STORAGE_TENANT_PREFIX}/${effectiveTenantId}/${folder}`;
    }
    return folder;
  }

  /**
   * Upload image file.
   *
   * KPI-029: Support tenant-specific folder prefix.
   *
   * @param buffer - File buffer
   * @param filename - Original filename
   * @param contentType - Content type
   * @param folder - Storage folder
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Upload result
   */
  async uploadImage(
    buffer: Buffer,
    filename: string,
    contentType: string,
    folder: string = "images",
    tenantId?: string,
  ): Promise<{ key: string; url: string; size: number }> {
    if (!ALLOWED_IMAGE_TYPES.includes(contentType)) {
      throw new Error(`Unsupported image type: ${contentType}`);
    }

    if (buffer.length > MAX_IMAGE_SIZE) {
      throw new Error(`Image too large. Max size: ${MAX_IMAGE_SIZE / 1024 / 1024}MB`);
    }

    // KPI-029: Use tenant-specific folder
    const tenantFolder = this.getTenantFolder(folder, tenantId);
    const ext = filename.split(".").pop() || "jpg";
    const key = `${tenantFolder}/${uuidv4()}.${ext}`;

    await this.s3Client.send(
      new PutObjectCommand({
        Bucket: this.bucket,
        Key: key,
        Body: buffer,
        ContentType: contentType,
      }),
    );

    const url = `https://${this.bucket}.s3.${process.env.AWS_REGION || "us-east-1"}.amazonaws.com/${key}`;

    return { key, url, size: buffer.length };
  }

  /**
   * Upload video file.
   *
   * KPI-029: Support tenant-specific folder prefix.
   *
   * @param buffer - File buffer
   * @param filename - Original filename
   * @param contentType - Content type
   * @param folder - Storage folder
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Upload result
   */
  async uploadVideo(
    buffer: Buffer,
    filename: string,
    contentType: string,
    folder: string = "videos",
    tenantId?: string,
  ): Promise<{ key: string; url: string; size: number }> {
    if (!ALLOWED_VIDEO_TYPES.includes(contentType)) {
      throw new Error(`Unsupported video type: ${contentType}`);
    }

    if (buffer.length > MAX_VIDEO_SIZE) {
      throw new Error(`Video too large. Max size: ${MAX_VIDEO_SIZE / 1024 / 1024}MB`);
    }

    // KPI-029: Use tenant-specific folder
    const tenantFolder = this.getTenantFolder(folder, tenantId);
    const ext = filename.split(".").pop() || "mp4";
    const key = `${tenantFolder}/${uuidv4()}.${ext}`;

    await this.s3Client.send(
      new PutObjectCommand({
        Bucket: this.bucket,
        Key: key,
        Body: buffer,
        ContentType: contentType,
      }),
    );

    const url = `https://${this.bucket}.s3.${process.env.AWS_REGION || "us-east-1"}.amazonaws.com/${key}`;

    return { key, url, size: buffer.length };
  }

  /**
   * Upload document file.
   *
   * KPI-029: Support tenant-specific folder prefix.
   *
   * @param buffer - File buffer
   * @param filename - Original filename
   * @param contentType - Content type
   * @param folder - Storage folder
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Upload result
   */
  async uploadDocument(
    buffer: Buffer,
    filename: string,
    contentType: string,
    folder: string = "documents",
    tenantId?: string,
  ): Promise<{ key: string; url: string; size: number }> {
    if (!ALLOWED_DOCUMENT_TYPES.includes(contentType)) {
      throw new Error(`Unsupported document type: ${contentType}`);
    }

    if (buffer.length > MAX_DOCUMENT_SIZE) {
      throw new Error(`Document too large. Max size: ${MAX_DOCUMENT_SIZE / 1024 / 1024}MB`);
    }

    // KPI-029: Use tenant-specific folder
    const tenantFolder = this.getTenantFolder(folder, tenantId);
    const ext = filename.split(".").pop() || "pdf";
    const key = `${tenantFolder}/${uuidv4()}.${ext}`;

    await this.s3Client.send(
      new PutObjectCommand({
        Bucket: this.bucket,
        Key: key,
        Body: buffer,
        ContentType: contentType,
      }),
    );

    const url = `https://${this.bucket}.s3.${process.env.AWS_REGION || "us-east-1"}.amazonaws.com/${key}`;

    return { key, url, size: buffer.length };
  }

  /**
   * Delete file from S3.
   *
   * @param key - File key
   * @returns True if deleted successfully
   */
  async deleteFile(key: string): Promise<boolean> {
    await this.s3Client.send(
      new DeleteObjectCommand({
        Bucket: this.bucket,
        Key: key,
      }),
    );
    return true;
  }

  /**
   * Get file from S3.
   *
   * @param key - File key
   * @returns File buffer
   */
  async getFile(key: string): Promise<Buffer> {
    const response = await this.s3Client.send(
      new GetObjectCommand({
        Bucket: this.bucket,
        Key: key,
      }),
    );

    const body = response.Body;
    if (body instanceof Uint8Array) {
      return Buffer.from(body);
    }

    const chunks: Buffer[] = [];
    if (body instanceof require("stream").Readable) {
      for await (const chunk of body) {
        chunks.push(Buffer.from(chunk));
      }
    }
    return Buffer.concat(chunks);
  }

  /**
   * Generate presigned URL for file.
   *
   * KPI-029: Add tenant prefix if key doesn't have one.
   *
   * @param key - File key
   * @param expiration - URL validity in seconds
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Presigned URL
   */
  async getPresignedUrl(key: string, expiration: number = 3600, tenantId?: string): Promise<string> {
    // KPI-029: Add tenant prefix if not present
    const effectiveTenantId = tenantId || this.tenantId;
    let targetKey = key;
    if (STORAGE_TENANT_ISOLATION && effectiveTenantId && !key.startsWith(`${STORAGE_TENANT_PREFIX}/`)) {
      targetKey = `${STORAGE_TENANT_PREFIX}/${effectiveTenantId}/${key}`;
    }

    const command = new GetObjectCommand({
      Bucket: this.bucket,
      Key: targetKey,
    });

    return getSignedUrl(this.s3Client, command, { expiresIn: expiration });
  }

  /**
   * KPI-029: Delete all files for a tenant.
   *
   * @param tenantId - Tenant ID
   * @param folder - Specific folder (optional, if undefined deletes all folders)
   * @returns Deletion result
   */
  async deleteTenantFiles(tenantId: string, folder?: string): Promise<{ tenantId: string; prefix: string; status: string }> {
    const prefix = folder
      ? `${STORAGE_TENANT_PREFIX}/${tenantId}/${folder}`
      : `${STORAGE_TENANT_PREFIX}/${tenantId}`;

    // TODO: Implement bulk delete with S3 listObjectsV2 and deleteObjects
    return {
      tenantId,
      prefix,
      status: "pending_implementation",
    };
  }
}
