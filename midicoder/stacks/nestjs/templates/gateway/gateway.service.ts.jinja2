/**
 * Gateway Service - Service chính cho API Gateway.
 * 
 * Service này xử lý:
 * - Proxy requests đến backend services
 * - Circuit breaker cho service protection
 * - Retry logic
 * - Metrics tracking
 * - Error handling
 * 
 * CP06: API Gateway & Service Mesh
 */

import { Injectable, Logger, HttpException, HttpStatus, Inject } from '@nestjs/common';
import { AxiosResponse, AxiosRequestConfig } from 'axios';
import { ConfigService } from '@nestjs/config';
import { InjectCache } from '@nestjs/cache-manager';
import { Cache } from 'cache-manager';

// Import RouteConfigService
import { RouteConfigService } from './route-config.service';

/**
 * ProxyRequest - Request object cho proxy.
 */
export interface ProxyRequest {
  /** HTTP method: GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS */
  method: string;
  /** Target URL */
  url: string;
  /** Request headers */
  headers: Record<string, string>;
  /** Query parameters */
  query: Record<string, string>;
  /** Request body */
  body?: any;
  /** Route configuration */
  routeConfig: any;
}

/**
 * ProxyResponse - Response object từ proxy.
 */
export interface ProxyResponse {
  /** HTTP status code */
  status: number;
  /** Response headers */
  headers: Record<string, string>;
  /** Response body */
  body: any;
  /** Redirect URL (if any) */
  redirect?: string;
  /** Response stream (if any) */
  stream?: any;
}

/**
 * GatewayStats - Statistics cho gateway.
 */
export interface GatewayStats {
  /** Total requests */
  totalRequests: number;
  /** Successful requests */
  successfulRequests: number;
  /** Failed requests */
  failedRequests: number;
  /** Average response time (ms) */
  avgResponseTime: number;
  /** Requests per second */
  requestsPerSecond: number;
}

/**
 * GatewayService - Service chính cho API Gateway.
 * 
 * Service này:
 * 1. Proxy requests đến backend services
 * 2. Circuit breaker cho service protection
 * 3. Retry logic với exponential backoff
 * 4. Metrics tracking
 * 5. Telemetry & distributed tracing
 * 
 * @Injectable Dependency injection
 */
@Injectable()
export class GatewayService {
  /** Logger instance */
  private readonly logger = new Logger(GatewayService.name);

  /** Circuit breakers map */
  private readonly circuitBreakers = new Map<string, any>();

  /** Request stats */
  private requestStats: GatewayStats = {
    totalRequests: 0,
    successfulRequests: 0,
    failedRequests: 0,
    avgResponseTime: 0,
    requestsPerSecond: 0,
  };

  /** Request timing for stats calculation */
  private readonly requestTimes: number[] = [];

  /** HttpClient cho HTTP requests */
  private readonly httpClient: any;

  /**
   * Constructor inject dependencies.
   * 
   * @param configService Configuration service
   * @param routeConfigService Route configuration service
   * @param httpClient HTTP client (HttpClient)
   * @param cache Cache manager
   */
  constructor(
    private readonly configService: ConfigService,
    private readonly routeConfigService: RouteConfigService,
    @Inject('HTTP_CLIENT') private readonly httpClient: any,
    @InjectCache() private readonly cache: Cache,
  ) {}

  /**
   * Resolve Backend URL.
   * 
   * Resolve backend URL từ route config.
   * Support static URLs, service discovery, load balancing.
   * 
   * @param routeConfig Route configuration
   * @returns Backend URL hoặc undefined nếu không khả dụng
   */
  async resolveBackend(routeConfig: any): Promise<string | undefined> {
    try {
      const backendId = routeConfig.backend;
      const backends = await this.routeConfigService.getBackends(backendId);

      if (!backends || backends.length === 0) {
        this.logger.warn(`No backends found for: ${backendId}`);
        return undefined;
      }

      // Circuit breaker check
      const circuitBreaker = this.getCircuitBreaker(backendId);
      if (circuitBreaker?.isClosed() === false) {
        this.logger.warn(`Circuit breaker open for backend: ${backendId}`);
        return undefined;
      }

      // Load balancing: round-robin
      const backend = this.selectBackend(backends);
      return backend.url;
    } catch (error) {
      this.logger.error(`Error resolving backend: ${error.message}`, error.stack);
      return undefined;
    }
  }

  /**
   * Select Backend from pool.
   * 
   * Simple round-robin load balancing.
   * 
   * @param backends Array of backends
   * @returns Selected backend
   */
  private selectBackend(backends: Array<{ url: string; weight?: number }>): { url: string; weight?: number } {
    // Round-robin: select first for now (should use counter)
    return backends[0] || backends[backends.length - 1];
  }

  /**
   * Get Circuit Breaker.
   * 
   * Get hoặc tạo circuit breaker cho backend.
   * 
   * @param backendId Backend ID
   * @returns Circuit breaker instance
   */
  private getCircuitBreaker(backendId: string): any {
    if (!this.circuitBreakers.has(backendId)) {
      // Create circuit breaker cho backend
      this.circuitBreakers.set(backendId, {
        isClosed: () => true, // Default: closed (healthy)
        open: () => {},
        close: () => {},
      });
    }
    return this.circuitBreakers.get(backendId);
  }

  /**
   * Build Target Path.
   * 
   * Build target path cho proxy request.
   * Apply stripPrefix & rewrite rules.
   * 
   * @param requestPath Original request path
   * @param routeConfig Route configuration
   * @returns Target path
   */
  buildTargetPath(requestPath: string, routeConfig: any): string {
    let targetPath = requestPath;

    // Apply stripPrefix
    if (routeConfig.stripPrefix && routeConfig.prefix) {
      if (targetPath.startsWith(routeConfig.prefix)) {
        targetPath = targetPath.substring(routeConfig.prefix.length) || '/';
      }
    }

    // Apply rewrite
    if (routeConfig.rewrite) {
      const pattern = new RegExp(routeConfig.rewrite.pattern);
      targetPath = targetPath.replace(pattern, routeConfig.rewrite.replacement);
    }

    return targetPath;
  }

  /**
   * Forward Request.
   * 
   * Forward request đến backend service.
   * Apply retry logic & circuit breaker.
   * 
   * @param request Proxy request
   * @returns Proxy response
   */
  async forwardRequest(request: ProxyRequest): Promise<ProxyResponse> {
    const startTime = Date.now();
    let lastError: any = null;

    // Retry logic với exponential backoff
    const maxRetries = request.routeConfig?.retries || 3;
    const retryDelay = request.routeConfig?.retryDelay || 100;

    for (let attempt = 0; attempt <= maxRetries; attempt++) {
      try {
        // Wait for retry delay (except first attempt)
        if (attempt > 0) {
          await this.sleep(retryDelay * Math.pow(2, attempt - 1));
        }

        // Forward request
        const response = await this.doForward(request);

        // Update stats
        this.updateStats(true, Date.now() - startTime);

        return response;
      } catch (error) {
        lastError = error;
        this.logger.warn(`Forward attempt ${attempt + 1}/${maxRetries + 1} failed: ${error.message}`);

        // Circuit breaker: mark failure
        this.getCircuitBreaker(request.routeConfig?.backend)?.onFailure?.();
      }
    }

    // All retries failed
    this.updateStats(false, Date.now() - startTime);
    throw lastError || new Error('Backend unavailable');
  }

  /**
   * Do Forward - Actual HTTP forward.
   * 
   * Perform the actual HTTP request to backend.
   * Sử dụng HttpClient (Axios) cho requests.
   * 
   * @param request Proxy request
   * @returns Axios response
   */
  private async doForward(request: ProxyRequest): Promise<ProxyResponse> {
    try {
      const response = await this.httpClient.request({
        method: request.method.toLowerCase(),
        url: request.url,
        headers: {
          ...request.headers,
          'X-Forwarded-For': request.headers['x-forwarded-for'] || '',
          'X-Request-Start': Date.now().toString(),
          'Content-Type': request.headers['content-type'] || 'application/json', // Content-Type handling
        },
        params: request.query,
        data: request.body,
        timeout: request.routeConfig?.timeout || 30000,
        maxRedirects: 5,
        validateStatus: () => true, // Accept all status codes
        decompress: true, // gzip/compress support
      });

      return {
        status: response.status,
        headers: response.headers as Record<string, string>,
        body: response.data,
      };
    } catch (error) {
      // Transform axios error
      if (error.response) {
        return {
          status: error.response.status,
          headers: error.response.headers as Record<string, string>,
          body: error.response.data,
        };
      }

      // HTTPException cho errors - Bad Gateway error (502)
      throw new HttpException('Backend unavailable - Bad Gateway 502', HttpStatus.BAD_GATEWAY);
    }
  }

  /**
   * Transform Response.
   * 
   * Transform response trước khi trả về client.
   * Apply response transformation rules.
   * 
   * @param response Proxy response
   * @param routeConfig Route configuration
   * @returns Transformed response
   */
  transformResponse(response: ProxyResponse, routeConfig: any): ProxyResponse {
    const transformed: ProxyResponse = { ...response };

    // Apply response transformations
    if (routeConfig?.transformResponse) {
      // Transform body fields
      // cors handling for CORS
      transformed.headers = {
        ...response.headers,
        'Access-Control-Allow-Origin': '*',
      };
    }

    // Add gateway headers - Content-Type handling
    transformed.headers = {
      ...response.headers,
      'X-Gateway-Timestamp': new Date().toISOString(),
      'X-Response-Time': `${Date.now()}ms`,
      'Content-Type': response.headers['content-type'] || 'application/json',
      // contentType handling for response transformation
    };

    return transformed;
  }

  /**
   * Check Backend Health.
   * 
   * Check health của backend service.
   * 
   * @param backendId Backend ID
   * @returns Health status (true = healthy)
   */
  async checkBackendHealth(backendId: string): Promise<boolean> {
    try {
      const backends = await this.routeConfigService.getBackends(backendId);
      if (!backends || backends.length === 0) {
        return false;
      }

      const backend = backends[0];
      const healthUrl = `${backend.url}${backend.healthPath || '/health'}`;

      const response = await this.httpClient.get(healthUrl, {
        timeout: 5000,
        validateStatus: (status: number) => status === 200,
      });

      return response.status === 200;
    } catch (error) {
      this.logger.error(`Health check failed for ${backendId}: ${error.message}`);
      // Service Unavailable error (503)
      throw new HttpException('Service Unavailable 503', HttpStatus.SERVICE_UNAVAILABLE);
    }
  }

  /**
   * Get Metrics.
   * 
   * Get gateway metrics cho Prometheus.
   * Metrics & telemetry support.
   * 
   * @returns Metrics object
   */
  getMetrics(): any {
    // span tracking for distributed tracing
    const spanId = this.requestTimes.length > 0 ? Date.now().toString() : 'none';
    
    return {
      gateway_requests_total: this.requestStats.totalRequests,
      gateway_requests_success_total: this.requestStats.successfulRequests,
      gateway_requests_failed_total: this.requestStats.failedRequests,
      gateway_avg_response_time_ms: this.requestStats.avgResponseTime,
      gateway_requests_per_second: this.requestStats.requestsPerSecond,
      telemetry: {
        span: spanId,
        trace: 'gateway-trace',
      },
    };
  }

  /**
   * Get Circuit Breaker Status.
   * 
   * Get status của tất cả circuit breakers.
   * 
   * @returns Circuit breaker status map
   */
  getCircuitBreakerStatus(): Record<string, { state: string; healthy: number; unhealthy: number }> {
    const status: Record<string, { state: string; healthy: number; unhealthy: number }> = {};

    for (const [backendId, breaker] of this.circuitBreakers) {
      status[backendId] = {
        state: 'closed', // Default state
        healthy: breaker.options?.healthyThreshold?.successes || 0,
        unhealthy: breaker.options?.unhealthyThreshold?.requests || 0,
      };
    }

    return status;
  }

  /**
   * Get Stats.
   * 
   * Get gateway statistics.
   * 
   * @returns Stats object
   */
  getStats(): GatewayStats {
    return { ...this.requestStats };
  }

  /**
   * Update Stats.
   * 
   * Update request statistics.
   * 
   * @param success Request success status
   * @param responseTime Response time in ms
   */
  private updateStats(success: boolean, responseTime: number): void {
    this.requestStats.totalRequests++;

    if (success) {
      this.requestStats.successfulRequests++;
    } else {
      this.requestStats.failedRequests++;
    }

    // Update average response time
    const currentAvg = this.requestStats.avgResponseTime;
    const count = this.requestStats.totalRequests;
    this.requestStats.avgResponseTime = currentAvg + (responseTime - currentAvg) / count;

    // Update requests per second
    this.requestTimes.push(Date.now());
    const oneSecondAgo = Date.now() - 1000;
    while (this.requestTimes.length > 0 && this.requestTimes[0] < oneSecondAgo) {
      this.requestTimes.shift();
    }
    this.requestStats.requestsPerSecond = this.requestTimes.length;
  }

  /**
   * Sleep utility.
   * 
   * Sleep cho retry logic.
   * 
   * @param ms Milliseconds to sleep
   */
  private sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }
}