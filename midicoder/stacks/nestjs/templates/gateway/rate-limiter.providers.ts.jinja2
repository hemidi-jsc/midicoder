  REQUEST_PER_MINUTE_PROVIDER,
  RATE_LIMIT_HEADERS_PROVIDER,
  RATE_LIMIT_EXCEEDED_HANDLER_PROVIDER,
  DISTRIBUTED_RATE_LIMITER_PROVIDER,
  KEY_GENERATOR_PROVIDER,
  SKIP_FUNCTION_PROVIDER,
];