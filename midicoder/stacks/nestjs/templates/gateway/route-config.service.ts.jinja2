/**
 * Route Config Service - Service quản lý route configuration.
 * 
 * Service này xử lý:
 * - Load route configuration từ file/environment
 * - Route matching & discovery
 * - Dynamic route updates
 * - Backend service registry
 * 
 * CP06: API Gateway & Service Mesh
 */

import { Injectable, Logger, OnModuleInit } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { InjectCache } from '@nestjs/cache-manager';
import { Cache } from 'cache-manager';

/**
 * IRouteConfig - Interface cho route configuration.
 */
export interface IRouteConfig {
  /** Route ID */
  id: string;
  /** Route name */
  name: string;
  /** Matching paths (array of patterns) */
  paths: string[];
  /** HTTP methods */
  methods: string[];
  /** Backend service ID */
  backend: string;
  /** Prefix to strip from request path */
  prefix?: string;
  /** Strip prefix flag */
  stripPrefix?: boolean;
  /** Rewrite configuration */
  rewrite?: {
    pattern: string;
    replacement: string;
  };
  /** Preserve original host header */
  preserveHost?: boolean;
  /** Request timeout (ms) */
  timeout?: number;
  /** Retry count */
  retries?: number;
  /** Retry delay (ms) */
  retryDelay?: number;
  /** Weight for load balancing */
  weight?: number;
  /** Priority for route matching */
  priority?: number;
  /** Enable/disable route */
  enabled?: boolean;
  /** Header matching rules */
  headers?: Record<string, string>;
  /** Query parameter matching rules */
  query?: Record<string, string>;
  /** Response transformation rules */
  transformResponse?: any;
}

/**
 * RouteRules - Rules for route matching.
 */
export interface RouteRules {
  /** Path rules */
  path?: string[];
  /** Method rules */
  method?: string[];
  /** Header rules */
  header?: Record<string, string>;
}

/**
 * BackendConfig - Interface cho backend configuration.
 */
export interface BackendConfig {
  /** Backend ID */
  id: string;
  /** Backend name */
  name: string;
  /** Backend URL(s) */
  url: string;
  /** Alternative URLs for failover */
  urls?: string[];
  /** Health check path */
  healthPath?: string;
  /** Health check interval (ms) */
  healthInterval?: number;
  /** Weight for load balancing */
  weight?: number;
  /** Enable/disable backend */
  enabled?: boolean;
}

/**
 * RouteMatch - Request matching interface.
 */
export interface RouteMatch {
  /** Request path */
  path: string;
  /** HTTP method */
  method: string;
  /** Request headers */
  headers: Record<string, string>;
  /** Query parameters */
  query?: Record<string, string>;
}

/**
 * RouteConfigService - Service quản lý route configuration.
 * 
 * Service này:
 * 1. Load routes từ config file, environment, hoặc service registry
 * 2. Match requests với route configuration
 * 3. Backend service discovery
 * 4. Dynamic route updates
 * 5. Route caching
 * 
 * @Injectable Dependency injection
 * @OnModuleInit Lifecycle hook
 */
@Injectable()
export class RouteConfigService implements OnModuleInit {
  /** Logger instance */
  private readonly logger = new Logger(RouteConfigService.name);

  /** Routes cache */
  private routes: IRouteConfig[] = [];

  /** Backends cache */
  private backends: BackendConfig[] = [];

  /** Routes index for fast lookup */
  private routeIndex: Map<string, IRouteConfig[]> = new Map();

  /**
   * Constructor inject dependencies.
   */
  constructor(
    private readonly configService: ConfigService,
    @InjectCache() private readonly cache: Cache,
  ) {}

  /**
   * OnModuleInit - Load routes khi module khởi tạo.
   */
  async onModuleInit(): Promise<void> {
    this.logger.log('Loading route configuration...');
    await this.load();
    this.logger.log(`Loaded ${this.routes.length} routes, ${this.backends.length} backends`);
  }

  /**
   * Load Configuration.
   * 
   * Load routes & backends từ config.
   * Support multiple sources: env vars, config files, service registry.
   */
  async load(): Promise<void> {
    try {
      // Load từ cache trước
      const cached = await this.cache.get('route-config');
      if (cached) {
        this.logger.log('Loading routes from cache');
        const { routes, backends } = cached;
        this.routes = routes || [];
        this.backends = backends || [];
        this.buildIndex();
        return;
      }

      // Load routes
      this.routes = await this.loadRoutes();

      // Load backends
      this.backends = await this.loadBackends();

      // Build index
      this.buildIndex();

      // Cache for 5 minutes
      await this.cache.set('route-config', { routes: this.routes, backends: this.backends }, 300000);

      this.logger.log(`Loaded ${this.routes.length} routes, ${this.backends.length} backends`);
    } catch (error) {
      this.logger.error('Error loading route configuration:', error);
      throw error;
    }
  }

  /**
   * Load Routes.
   * 
   * Load routes từ config sources.
   * Support ENV environment config.
   * 
   * @returns Array of route configurations
   */
  private async loadRoutes(): Promise<IRouteConfig[]> {
    const routes: IRouteConfig[] = [];

    // Load từ environment variable
    const envRoutes = this.configService.get<string>('GATEWAY_ROUTES');
    if (envRoutes) {
      try {
        const parsed = JSON.parse(envRoutes);
        routes.push(...parsed);
      } catch (error) {
        this.logger.warn('Invalid GATEWAY_ROUTES JSON:', error.message);
      }
    }

    // Default routes nếu chưa có
    if (routes.length === 0) {
      routes.push(
        // Default API route
        {
          id: 'api-default',
          name: 'Default API Route',
          paths: ['/api/**'],
          methods: ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'HEAD', 'OPTIONS'],
          backend: 'api-backend',
          prefix: '/api',
          stripPrefix: true,
          timeout: 30000,
          retries: 3,
          enabled: true,
        },
        // Default GraphQL route
        {
          id: 'graphql-default',
          name: 'Default GraphQL Route',
          paths: ['/graphql'],
          methods: ['POST', 'GET'],
          backend: 'graphql-backend',
          stripPrefix: false,
          timeout: 60000,
          retries: 3,
          enabled: true,
        },
        // Default WebSocket route
        {
          id: 'ws-default',
          name: 'Default WebSocket Route',
          paths: ['/ws/**'],
          methods: ['GET'],
          backend: 'ws-backend',
          prefix: '/ws',
          stripPrefix: true,
          timeout: 30000,
          enabled: true,
        },
      );
    }

    return routes;
  }

  /**
   * Load Backends.
   * 
   * Load backends từ config sources.
   * 
   * @returns Array of backend configurations
   */
  private async loadBackends(): Promise<BackendConfig[]> {
    const backends: BackendConfig[] = [];

    // Load từ environment
    const apiBackend = this.configService.get<string>('API_BACKEND_URL');
    if (apiBackend) {
      backends.push({
        id: 'api-backend',
        name: 'API Backend',
        url: apiBackend,
        healthPath: '/health',
        healthInterval: 30000,
        enabled: true,
      });
    }

    const graphqlBackend = this.configService.get<string>('GRAPHQL_BACKEND_URL');
    if (graphqlBackend) {
      backends.push({
        id: 'graphql-backend',
        name: 'GraphQL Backend',
        url: graphqlBackend,
        healthPath: '/health',
        healthInterval: 30000,
        enabled: true,
      });
    }

    // Default backends nếu chưa có
    if (backends.length === 0) {
      backends.push(
        {
          id: 'api-backend',
          name: 'API Backend (default)',
          url: 'http://localhost:3000',
          healthPath: '/health',
          enabled: true,
        },
        {
          id: 'graphql-backend',
          name: 'GraphQL Backend (default)',
          url: 'http://localhost:4000',
          healthPath: '/health',
          enabled: true,
        },
      );
    }

    return backends;
  }

  /**
   * Build Route Index.
   * 
   * Build index cho fast route lookup.
   */
  private buildIndex(): void {
    this.routeIndex.clear();

    for (const route of this.routes) {
      if (!route.enabled) {
        continue;
      }

      for (const path of route.paths) {
        const paths = this.routeIndex.get(path) || [];
        paths.push(route);
        this.routeIndex.set(path, paths);
      }
    }

    // Sort by priority
    for (const paths of this.routeIndex.values()) {
      paths.sort((a, b) => (b.priority || 0) - (a.priority || 0));
    }
  }

  /**
   * Find Route.
   * 
   * Find matching route cho request.
   * 
   * @param match Route matching criteria
   * @returns Matching route config (RouteConfig) hoặc undefined
   */
  async findRoute(match: RouteMatch): Promise<IRouteConfig | undefined> {
    // Check cache first
    const cacheKey = `route-match:${match.method}:${match.path}`;
    const cached = await this.cache.get(cacheKey);
    if (cached) {
      return cached as IRouteConfig;
    }

    // Find matching route
    let matchedRoute: IRouteConfig | undefined;

    // Check exact paths first
    for (const path of match.path.split('/').slice(0, -1).map((p, i) => '/' + match.path.split('/').slice(0, i + 1).join('/'))) {
      const routes = this.routeIndex.get(path);
      if (routes) {
        for (const route of routes) {
          if (this.matchRoute(route, match)) {
            matchedRoute = route;
            break;
          }
        }
      }
      if (matchedRoute) break;
    }

    // Check wildcard paths
    if (!matchedRoute) {
      for (const [path, routes] of this.routeIndex) {
        if (path.includes('**')) {
          const prefix = path.replace('**', '');
          if (match.path.startsWith(prefix)) {
            for (const route of routes) {
              if (this.matchRoute(route, match)) {
                matchedRoute = route;
                break;
              }
            }
          }
        }
      }
    }

    // Cache result
    if (matchedRoute) {
      await this.cache.set(cacheKey, matchedRoute, 60000);
    }

    return matchedRoute;
  }

  /**
   * Match Route.
   * 
   * Check nếu route match với request.
   * Method matching check.
   * 
   * @param route Route configuration
   * @param match Route matching criteria
   * @returns True if route matches
   */
  private matchRoute(route: IRouteConfig, match: RouteMatch): boolean {
    // Check method matching
    if (route.methods && !route.methods.includes(match.method)) {
      return false;
    }

    // Check headers
    if (route.headers) {
      for (const [key, value] of Object.entries(route.headers)) {
        if (match.headers[key]?.toLowerCase() !== value.toLowerCase()) {
          return false;
        }
      }
    }

    // Check query params
    if (route.query && match.query) {
      for (const [key, value] of Object.entries(route.query)) {
        if (match.query[key] !== value) {
          return false;
        }
      }
    }

    return true;
  }

  /**
   * Get Backends.
   * 
   * Get backends cho backend ID.
   * 
   * @param backendId Backend ID
   * @returns Array of backends
   */
  async getBackends(backendId: string): Promise<BackendConfig[]> {
    return this.backends.filter((b) => b.id === backendId && b.enabled);
  }

  /**
   * Get All Backends.
   * 
   * Get tất cả backends.
   * 
   * @returns Array of all backends
   */
  async getAllBackends(): Promise<BackendConfig[]> {
    return this.backends.filter((b) => b.enabled);
  }

  /**
   * Get All Routes.
   * 
   * Get tất cả routes.
   * 
   * @returns Array of all routes (RouteConfig[])
   */
  async getAllRoutes(): Promise<IRouteConfig[]> {
    return this.routes;
  }

  /**
   * Get Upstream backends.
   * 
   * @param upstreamId Upstream ID
   * @returns Array of backends
   */
  async getUpstream(upstreamId: string): Promise<BackendConfig[]> {
    return this.backends.filter((b) => b.id === upstreamId);
  }

  /**
   * Load Dynamic config from external source.
   * 
   * Dynamic configuration loading support.
   * 
   * @returns Promise<void>
   */
  async loadDynamic(): Promise<void> {
    // reload dynamic config từ external source
    await this.reload();
  }

  /**
   * Reload Configuration.
   * 
   * Reload configuration từ sources.
   * Clear cache & reload.
   */
  async reload(): Promise<void> {
    this.logger.log('Reloading route configuration...');

    // Clear cache
    await this.cache.del('route-config');

    // Reload
    await this.load();

    this.logger.log('Route configuration reloaded');
  }

  /**
   * Add Route.
   * 
   * Add route động.
   * 
   * @param route Route configuration (IRouteConfig)
   */
  async addRoute(route: IRouteConfig): Promise<void> {
    this.routes.push(route);
    this.buildIndex();
    await this.invalidateCache();
    this.logger.log(`Added route: ${route.id}`);
  }

  /**
   * Remove Route.
   * 
   * Remove route.
   * 
   * @param routeId Route ID
   */
  async removeRoute(routeId: string): Promise<void> {
    this.routes = this.routes.filter((r) => r.id !== routeId);
    this.buildIndex();
    await this.invalidateCache();
    this.logger.log(`Removed route: ${routeId}`);
  }

  /**
   * Update Route.
   * 
   * Update route configuration.
   * 
   * @param routeId Route ID
   * @param updates Route updates (Partial<IRouteConfig>)
   */
  async updateRoute(routeId: string, updates: Partial<IRouteConfig>): Promise<void> {
    const index = this.routes.findIndex((r) => r.id === routeId);
    if (index !== -1) {
      this.routes[index] = { ...this.routes[index], ...updates };
      this.buildIndex();
      await this.invalidateCache();
      this.logger.log(`Updated route: ${routeId}`);
    }
  }

  /**
   * Invalidate Cache.
   * 
   * Invalidate route configuration cache.
   */
  private async invalidateCache(): Promise<void> {
    await this.cache.del('route-config');
  }

  /**
   * Validate Configuration.
   * 
   * Validate route configuration.
   * 
   * @returns True if valid
   */
  validate(): boolean {
    for (const route of this.routes) {
      if (!route.id) {
        this.logger.error(`Route missing ID: ${JSON.stringify(route)}`);
        return false;
      }
      if (!route.backend) {
        this.logger.error(`Route missing backend: ${route.id}`);
        return false;
      }
      if (!route.paths || route.paths.length === 0) {
        this.logger.error(`Route missing paths: ${route.id}`);
        return false;
      }
    }
    return true;
  }

  /**
   * Merge Configuration.
   * 
   * Merge external configuration vào current config.
   * 
   * @param external External configuration
   */
  merge(external: { routes?: IRouteConfig[]; backends?: BackendConfig[] }): void {
    if (external.routes) {
      for (const route of external.routes) {
        const index = this.routes.findIndex((r) => r.id === route.id);
        if (index !== -1) {
          this.routes[index] = { ...this.routes[index], ...route };
        } else {
          this.routes.push(route);
        }
      }
    }

    if (external.backends) {
      for (const backend of external.backends) {
        const index = this.backends.findIndex((b) => b.id === backend.id);
        if (index !== -1) {
          this.backends[index] = { ...this.backends[index], ...backend };
        } else {
          this.backends.push(backend);
        }
      }
    }

    this.buildIndex();
  }

  /**
   * Apply upstream config.
   * 
   * @param upstream Upstream configuration
   */
  applyUpstream(upstream: BackendConfig): void {
    this.backends.push(upstream);
  }

  /**
   * Get strip path config.
   * 
   * stripPath configuration getter.
   * 
   * @param routeId Route ID
   * @returns Strip path setting
   */
  getStripPath(routeId: string): boolean | undefined {
    const route = this.routes.find((r) => r.id === routeId);
    return route?.stripPrefix;
  }

  /**
   * Get timeout config for route.
   * 
   * @param routeId Route ID
   * @returns Timeout in milliseconds
   */
  getTimeout(routeId: string): number | undefined {
    const route = this.routes.find((r) => r.id === routeId);
    return route?.timeout;
  }

  /**
   * Check if route is enabled.
   * 
   * @param routeId Route ID
   * @returns True if enabled
   */
  isEnabled(routeId: string): boolean {
    const route = this.routes.find((r) => r.id === routeId);
    return route?.enabled ?? true;
  }
}
