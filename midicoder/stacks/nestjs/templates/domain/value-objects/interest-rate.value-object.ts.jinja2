import { IsNumber, IsString, IsOptional, IsEnum, Min } from 'class-validator';

export enum InterestRateType {
  FIXED = 'fixed',
  VARIABLE = 'variable',
  COMPOUND = 'compound',
  SIMPLE = 'simple',
}

export class InterestRate {
  /**
   * Tỷ lệ phần trăm (ví dụ: 5.5 = 5.5%)
   */
  @IsNumber()
  @Min(0, { message: 'rate không thể âm' })
  rate: number;

  /**
   * Loại lãi suất (InterestRateType)
   */
  @IsEnum(InterestRateType, { message: 'rate_type phải là giá trị hợp lệ' })
  rateType: InterestRateType;

  /**
   * Mã tiền tệ (ISO 4217)
   */
  @IsString()
  currency: string;

  /**
   * Ngày hiệu lực (ISO date string)
   */
  effectiveFrom: string;

  /**
   * Ngày hết hiệu lực (optional)
   */
  @IsOptional()
  effectiveTo?: string;

  /**
   * Số kỳ ghép lãi/năm (đối với compound interest)
   */
  @IsOptional()
  @IsNumber()
  @Min(1, { message: 'compounding_periods phải lớn hơn 0' })
  compoundingPeriods: number = 12;

  /**
   * Kiểm tra xem là lãi suất cố định không
   */
  get isFixed(): boolean {
    return this.rateType === InterestRateType.FIXED;
  }

  /**
   * Kiểm tra xem là lãi suất thả nổi không
   */
  get isVariable(): boolean {
    return this.rateType === InterestRateType.VARIABLE;
  }

  /**
   * Kiểm tra xem là lãi kép không
   */
  get isCompound(): boolean {
    return this.rateType === InterestRateType.COMPOUND;
  }

  /**
   * Kiểm tra xem lãi suất có còn hiệu lực không
   */
  isActive(): boolean {
    const today = new Date();
    const from = new Date(this.effectiveFrom);
    if (today < from) {
      return false;
    }
    if (this.effectiveTo) {
      const to = new Date(this.effectiveTo);
      if (today > to) {
        return false;
      }
    }
    return true;
  }

  /**
   * Tính lãi đơn
   * Formula: I = P × r × t
   * @param principal Số tiền gốc
   * @param years Số năm
   * @returns Số lãi
   */
  calculateSimpleInterest(principal: number, years: number): number {
    return principal * (this.rate / 100) * years;
  }

  /**
   * Tính lãi kép
   * Formula: A = P(1 + r/n)^(nt), Interest = A - P
   * @param principal Số tiền gốc
   * @param years Số năm
   * @returns Số lãi
   */
  calculateCompoundInterest(principal: number, years: number): number {
    const r = this.rate / 100;
    const n = this.compoundingPeriods;
    const t = years;

    const amount = principal * Math.pow((1 + r / n), n * t);
    return amount - principal;
  }

  /**
   * Tính effective annual rate (EAR)
   * Formula: EAR = (1 + r/n)^n - 1
   * @returns EAR (percentage)
   */
  getEffectiveAnnualRate(): number {
    const r = this.rate / 100;
    const n = this.compoundingPeriods;

    const ear = Math.pow((1 + r / n), n) - 1;
    return Math.round(ear * 100 * 100) / 100;
  }

  /**
   * Format lãi suất thành string
   */
  format(): string {
    return `${this.rate}% ${this.rateType}/${this.currency}`;
  }

  /**
   * Chuyển thành dictionary
   */
  toDict(): Record<string, any> {
    return {
      rate: this.rate,
      rate_type: this.rateType,
      currency: this.currency,
      effective_from: this.effectiveFrom,
      effective_to: this.effectiveTo,
      compounding_periods: this.compoundingPeriods,
    };
  }

  /**
   * Tạo InterestRate từ dictionary
   */
  static fromDict(data: Record<string, any>): InterestRate {
    const rate = new InterestRate();
    rate.rate = data.rate;
    rate.rateType = data.rate_type;
    rate.currency = data.currency;
    rate.effectiveFrom = data.effective_from;
    rate.effectiveTo = data.effective_to;
    rate.compoundingPeriods = data.compounding_periods || 12;
    return rate;
  }

  /**
   * String representation
   */
  toString(): string {
    return this.format();
  }
}