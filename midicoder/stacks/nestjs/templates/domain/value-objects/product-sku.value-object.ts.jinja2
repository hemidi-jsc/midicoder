export interface ProductSKUData {
  sku: string;
  normalizedSku?: string;
}

export class ProductSKU {
  readonly sku: string;

  private constructor(sku: string) {
    this.sku = sku;
  }

  /**
   * Tạo ProductSKU với validation.
   */
  static create(sku: string): ProductSKU {
    if (!sku || !sku.trim()) {
      throw new Error('SKU không được để trống');
    }

    if (!/^[A-Za-z0-9_-]{3,50}$/.test(sku)) {
      throw new Error('SKU chỉ chứa chữ, số, gạch ngang và gạch dưới (3-50 ký tự)');
    }

    return new ProductSKU(sku);
  }

  /**
   * Trả về SKU chuẩn hóa (uppercase).
   */
  get normalizedSku(): string {
    return this.sku.toUpperCase();
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): ProductSKUData {
    return {
      sku: this.sku,
      normalizedSku: this.normalizedSku,
    };
  }

  /**
   * Tạo ProductSKU từ object.
   */
  static fromJSON(data: ProductSKUData): ProductSKU {
    return new ProductSKU(data.sku || data.normalizedSku || '');
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.normalizedSku;
  }

  /**
   * So sánh bằng (case-insensitive).
   */
  equals(other: ProductSKU): boolean {
    return this.sku.toUpperCase() === other.sku.toUpperCase();
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return this.normalizedSku.charCodeAt(0);
  }
}