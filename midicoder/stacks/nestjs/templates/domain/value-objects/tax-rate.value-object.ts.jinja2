import { Decimal } from 'decimal.js';

export interface TaxRateData {
  rate: string | number | Decimal;
  name?: string;
  decimalValue?: string;
}

export class TaxRate {
  readonly rate: Decimal;
  readonly name: string;

  private constructor(rate: Decimal, name: string = 'VAT') {
    this.rate = rate;
    this.name = name;
  }

  /**
   * Tạo TaxRate với validation.
   */
  static create(rate: string | number | Decimal, name: string = 'VAT'): TaxRate {
    const rateValue = new Decimal(rate);
    
    if (rateValue.lt(0) || rateValue.gt(100)) {
      throw new Error('Tỷ lệ thuế phải từ 0 đến 100%');
    }

    if (!name || !name.trim()) {
      throw new Error('Tên loại thuế không được để trống');
    }

    return new TaxRate(rateValue, name);
  }

  /**
   * Trả về giá trị thập phân (ví dụ: 10% = 0.10).
   */
  get decimalValue(): Decimal {
    return this.rate.div(100);
  }

  /**
   * Tính thuế cho số tiền.
   */
  applyTo(amount: Decimal): Decimal {
    return amount.multipliedBy(this.decimalValue);
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): TaxRateData {
    return {
      rate: this.rate.toString(),
      name: this.name,
      decimalValue: this.decimalValue.toString(),
    };
  }

  /**
   * Tạo TaxRate từ object.
   */
  static fromJSON(data: TaxRateData): TaxRate {
    return new TaxRate(new Decimal(data.rate), data.name ?? 'VAT');
  }

  /**
   * Tạo TaxRate từ giá trị thập phân.
   */
  static fromDecimal(decimalValue: Decimal, name: string = 'VAT'): TaxRate {
    if (decimalValue.lt(0) || decimalValue.gt(1)) {
      throw new Error('Giá trị thập phân phải từ 0 đến 1');
    }
    return new TaxRate(decimalValue.multipliedBy(100), name);
  }

  /**
   * String representation.
   */
  toString(): string {
    return `${this.rate}% (${this.name})`;
  }

  /**
   * So sánh bằng.
   */
  equals(other: TaxRate): boolean {
    return this.rate.equals(other.rate) && this.name.toLowerCase() === other.name.toLowerCase();
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return `${this.rate}-${this.name.toLowerCase()}`.charCodeAt(0);
  }
}