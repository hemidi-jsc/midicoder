export interface PhoneNumberData {
  countryCode: string;
  number: string;
  formatted?: string;
}

export class PhoneNumber {
  readonly countryCode: string;
  readonly number: string;

  private constructor(countryCode: string, number: string) {
    this.countryCode = countryCode;
    this.number = number;
  }

  /**
   * Tạo PhoneNumber từ country_code và number.
   */
  static create(countryCode: string, number: string): PhoneNumber {
    if (!countryCode || !countryCode.startsWith('+')) {
      throw new Error('Mã quốc gia phải bắt đầu bằng +');
    }

    if (!number || !/^\d+$/.test(number)) {
      throw new Error('Số điện thoại chỉ chứa chữ số');
    }

    if (number.length < 7 || number.length > 15) {
      throw new Error('Số điện thoại phải có 7-15 chữ số');
    }

    return new PhoneNumber(countryCode, number);
  }

  /**
   * Tạo PhoneNumber từ string (ví dụ: +84912345678).
   */
  static fromString(phone: string): PhoneNumber {
    phone = phone.trim();

    if (!phone.startsWith('+')) {
      throw new Error('Số điện thoại phải bắt đầu bằng +');
    }

    const cleaned = phone.replace(/\s/g, '');
    const match = cleaned.match(/^(\+[0-9]+)([0-9]+)$/);

    if (!match) {
      throw new Error('Không thể phân tích số điện thoại');
    }

    const countryDigits = match[1].substring(1);
    const number = match[2];

    // Tìm ranh giới country code (1-4 digits)
    for (let i = Math.min(4, countryDigits.length); i > 0; i--) {
      const cc = '+' + countryDigits.substring(0, i);
      const num = countryDigits.substring(i) + number;
      if (num.length >= 7 && num.length <= 15) {
        return new PhoneNumber(cc, num);
      }
    }

    throw new Error('Không thể phân tích số điện thoại');
  }

  /**
   * Trả về số điện thoại định dạng đầy đủ.
   */
  get formatted(): string {
    return `${this.countryCode} ${this.number}`;
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): PhoneNumberData {
    return {
      countryCode: this.countryCode,
      number: this.number,
      formatted: this.formatted,
    };
  }

  /**
   * Tạo PhoneNumber từ object.
   */
  static fromJSON(data: PhoneNumberData): PhoneNumber {
    return new PhoneNumber(data.countryCode, data.number);
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.formatted;
  }

  /**
   * So sánh bằng.
   */
  equals(other: PhoneNumber): boolean {
    return this.countryCode === other.countryCode && this.number === other.number;
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return `${this.countryCode}-${this.number}`.charCodeAt(0);
  }
}