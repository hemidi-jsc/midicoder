import { IsNumber, IsOptional, IsEnum, Min } from 'class-validator';

export enum DosageUnit {
  MILLIGRAM = 'mg',
  MICROGRAM = 'mcg',
  GRAM = 'g',
  LITER = 'L',
  MILLILITER = 'mL',
  INTERNATIONAL_UNIT = 'IU',
  PERCENT = '%',
  DROP = 'drop',
}

export class Dosage {
  /**
   * Liều lượng (number)
   */
  @IsNumber()
  @Min(0, { message: 'amount phải lớn hơn 0' })
  amount: number;

  /**
   * Đơn vị (DosageUnit)
   */
  @IsEnum(DosageUnit, { message: 'unit phải là giá trị hợp lệ' })
  unit: DosageUnit;

  /**
   * Tần suất (lần/ngày, optional)
   */
  @IsOptional()
  @IsNumber()
  @Min(1, { message: 'frequency phải trong khoảng 1-24' })
  frequency?: number;

  /**
   * Thời gian (số ngày, optional)
   */
  @IsOptional()
  @IsNumber()
  @Min(1, { message: 'duration_days phải lớn hơn 0' })
  durationDays?: number;

  /**
   * Liều tối đa/ngày (optional, cho safety)
   */
  @IsOptional()
  @IsNumber()
  @Min(0, { message: 'max_daily_dose phải lớn hơn 0' })
  maxDailyDose?: number;

  /**
   * Liều tối thiểu/ngày (optional, cho safety)
   */
  @IsOptional()
  @IsNumber()
  @Min(0, { message: 'min_daily_dose không thể âm' })
  minDailyDose?: number;

  /**
   * Tính liều hàng ngày
   */
  get dailyDose(): number {
    const freq = this.frequency || 1;
    return this.amount * freq;
  }

  /**
   * Kiểm tra xem liều có trong khoảng an toàn không
   */
  isWithinSafeRange(): boolean {
    const daily = this.dailyDose;

    if (this.minDailyDose !== undefined && daily < this.minDailyDose) {
      return false;
    }

    if (this.maxDailyDose !== undefined && daily > this.maxDailyDose) {
      return false;
    }

    return true;
  }

  /**
   * Kiểm tra xem liều có vượt quá max không
   */
  isExceedingMax(): boolean {
    if (this.maxDailyDose === undefined) {
      return false;
    }
    return this.dailyDose > this.maxDailyDose;
  }

  /**
   * Chuyển đổi đơn vị liều lượng
   * @param targetUnit Đơn vị đích
   * @returns Dosage mới với đơn vị đã chuyển đổi
   */
  convertTo(targetUnit: DosageUnit): Dosage {
    const toBase: Record<DosageUnit, number> = {
      [DosageUnit.MILLIGRAM]: 1,
      [DosageUnit.MICROGRAM]: 0.001,
      [DosageUnit.GRAM]: 1000,
      [DosageUnit.MILLILITER]: 1,
      [DosageUnit.LITER]: 1000000,
      [DosageUnit.INTERNATIONAL_UNIT]: 1,
      [DosageUnit.PERCENT]: 1,
      [DosageUnit.DROP]: 0.05,
    };

    if (!(this.unit in toBase) || !(targetUnit in toBase)) {
      throw new Error(`Cannot convert between ${this.unit} and ${targetUnit}`);
    }

    const baseAmount = this.amount * toBase[this.unit];
    const targetAmount = Math.round((baseAmount / toBase[targetUnit]) * 1000) / 1000;

    const dosage = new Dosage();
    dosage.amount = targetAmount;
    dosage.unit = targetUnit;
    dosage.frequency = this.frequency;
    dosage.durationDays = this.durationDays;
    dosage.maxDailyDose = this.maxDailyDose;
    dosage.minDailyDose = this.minDailyDose;
    return dosage;
  }

  /**
   * Tính tổng liều cho toàn bộ疗程
   */
  getTotalCourseDose(): number | undefined {
    if (this.durationDays === undefined) {
      return undefined;
    }
    return this.dailyDose * this.durationDays;
  }

  /**
   * Format liều lượng thành string
   */
  format(): string {
    const parts = [`${this.amount} ${this.unit}`];

    if (this.frequency) {
      parts.push(`${this.frequency} lần/ngày`);
    }

    if (this.durationDays) {
      parts.push(`${this.durationDays} ngày`);
    }

    return parts.join(', ');
  }

  /**
   * Chuyển thành dictionary
   */
  toDict(): Record<string, any> {
    return {
      amount: this.amount,
      unit: this.unit,
      frequency: this.frequency,
      duration_days: this.durationDays,
      max_daily_dose: this.maxDailyDose,
      min_daily_dose: this.minDailyDose,
    };
  }

  /**
   * Tạo Dosage từ dictionary
   */
  static fromDict(data: Record<string, any>): Dosage {
    const dosage = new Dosage();
    dosage.amount = data.amount;
    dosage.unit = data.unit;
    dosage.frequency = data.frequency;
    dosage.durationDays = data.duration_days;
    dosage.maxDailyDose = data.max_daily_dose;
    dosage.minDailyDose = data.min_daily_dose;
    return dosage;
  }

  /**
   * String representation
   */
  toString(): string {
    return this.format();
  }
}