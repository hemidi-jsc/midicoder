export interface CouponCodeData {
  code: string;
  normalized?: string;
}

export class CouponCode {
  readonly code: string;

  private constructor(code: string) {
    this.code = code;
  }

  /**
   * Tạo CouponCode với validation.
   */
  static create(code: string): CouponCode {
    if (!code || !code.trim()) {
      throw new Error('Mã giảm giá không được để trống');
    }

    if (!/^[A-Z0-9-]{4,30}$/.test(code.toUpperCase())) {
      throw new Error('Mã giảm giá chỉ chứa chữ hoa, số, gạch ngang (4-30 ký tự)');
    }

    return new CouponCode(code);
  }

  /**
   * Trả về code chuẩn hóa (uppercase).
   */
  get normalized(): string {
    return this.code.toUpperCase();
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): CouponCodeData {
    return {
      code: this.code,
      normalized: this.normalized,
    };
  }

  /**
   * Tạo CouponCode từ object.
   */
  static fromJSON(data: CouponCodeData): CouponCode {
    return new CouponCode(data.code || data.normalized || '');
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.normalized;
  }

  /**
   * So sánh bằng (case-insensitive).
   */
  equals(other: CouponCode): boolean {
    return this.code.toUpperCase() === other.code.toUpperCase();
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return this.normalized.charCodeAt(0);
  }
}