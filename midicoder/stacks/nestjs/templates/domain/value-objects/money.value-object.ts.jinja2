/**
 * Money Value Object
 * 
 * Giá tiền tệ với multi-currency và multi-unit support.
 * Generated by Midicoder - NestJSValueObjectEmitter
 * CP01: Domain Model - Value Objects
 * 
 * @tags finance, currency, monetary
 * @compliance KPI-001, KPI-029
 */

import { IsDecimal, IsString, IsOptional, ValidateNested } from 'class-validator';
import { Type } from 'class-transformer';

export class Money {
  /**
   * Số tiền (decimal, precision 2)
   */
  @IsDecimal()
  amount: number;

  /**
   * Mã tiền tệ (ISO 4217, ví dụ: VND, USD, EUR)
   */
  @IsString()
  currency: string;

  /**
   * Metadata bổ sung (optional)
   */
  @IsOptional()
  metadata?: Record<string, any>;

  /**
   * Kiểm tra xem số tiền có bằng 0 không
   */
  get isZero(): boolean {
    return this.amount === 0;
  }

  /**
   * Kiểm tra xem số tiền có dương không
   */
  get isPositive(): boolean {
    return this.amount > 0;
  }

  /**
   * Kiểm tra xem số tiền có âm không
   */
  get isNegative(): boolean {
    return this.amount < 0;
  }

  /**
   * Thêm hai giá tiền cùng currency
   * @param other Money khác để thêm
   * @returns Money mới với tổng amount
   * @throws Error Nếu currency không khớp
   */
  add(other: Money): Money {
    if (this.currency !== other.currency) {
      throw new Error(`Không thể cộng tiền khác currency: ${this.currency} vs ${other.currency}`);
    }
    return new Money(
      this.amount + other.amount,
      this.currency,
      this.metadata
    );
  }

  /**
   * Trừ hai giá tiền cùng currency
   * @param other Money khác để trừ
   * @returns Money mới với hiệu amount
   */
  subtract(other: Money): Money {
    if (this.currency !== other.currency) {
      throw new Error(`Không thể trừ tiền khác currency: ${this.currency} vs ${other.currency}`);
    }
    return new Money(
      this.amount - other.amount,
      this.currency,
      this.metadata
    );
  }

  /**
   * Nhân số tiền với hệ số
   * @param factor Hệ số nhân
   * @returns Money mới với amount đã nhân
   */
  multiply(factor: number): Money {
    return new Money(
      this.amount * factor,
      this.currency,
      this.metadata
    );
  }

  /**
   * Chuyển đổi currency với exchange rate
   * @param targetCurrency Currency đích (ISO 4217)
   * @param exchangeRate Tỷ giá chuyển đổi
   * @returns Money mới với currency đã chuyển đổi
   */
  convert(targetCurrency: string, exchangeRate: number): Money {
    const convertedAmount = Math.round(this.amount * exchangeRate * 100) / 100;
    return new Money(
      convertedAmount,
      targetCurrency,
      { ...this.metadata, original_currency: this.currency }
    );
  }

  /**
   * Format tiền tệ theo locale
   * @param locale Locale (default: en_US)
   * @returns Formatted string
   */
  format(locale: string = 'en_US'): string {
    return `${this.currency} ${this.amount.toLocaleString(locale, { minimumFractionDigits: 2 })}`;
  }

  /**
   * Chuyển thành dictionary
   * @returns Dictionary representation
   */
  toDict(): Record<string, any> {
    return {
      amount: this.amount.toFixed(2),
      currency: this.currency,
      metadata: this.metadata,
    };
  }

  /**
   * Tạo Money từ dictionary
   * @param data Dictionary data
   * @returns Money instance
   */
  static fromDict(data: Record<string, any>): Money {
    return new Money(
      parseFloat(data.amount),
      data.currency,
      data.metadata
    );
  }

  /**
   * String representation
   */
  toString(): string {
    return this.format();
  }
}