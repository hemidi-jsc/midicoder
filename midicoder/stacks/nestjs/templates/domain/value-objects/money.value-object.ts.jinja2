import { Decimal } from 'decimal.js';

export interface MoneyData {
  amount: string | number | Decimal;
  currency: string;
}

export class Money {
  readonly amount: Decimal;
  readonly currency: string;

  private constructor(amount: Decimal, currency: string) {
    this.amount = amount;
    this.currency = currency;
  }

  /**
   * Tạo Money object với validation.
   * 
   * @param amount - Số tiền (>= 0)
   * @param currency - Mã tiền tệ (3 ký tự)
   * @throws Error Nếu amount < 0 hoặc currency không hợp lệ
   */
  static create(amount: string | number | Decimal, currency: string): Money {
    if (amount < 0) {
      throw new Error('Số tiền không thể âm');
    }

    if (!currency || currency.length !== 3 || !/^[A-Z]{3}$/.test(currency.toUpperCase())) {
      throw new Error('Mã tiền tệ phải là 3 ký tự hoa');
    }

    return new Money(new Decimal(amount), currency.toUpperCase());
  }

  /**
   * Cộng hai Money cùng currency.
   * 
   * @param other - Money khác để cộng
   * @returns Money mới với tổng amount
   * @throws Error Nếu currency khác nhau
   */
  add(other: Money): Money {
    if (this.currency !== other.currency) {
      throw new Error('Không thể cộng tiền tệ khác nhau');
    }
    return new Money(this.amount.plus(other.amount), this.currency);
  }

  /**
   * Trừ hai Money cùng currency.
   * 
   * @param other - Money khác để trừ
   * @returns Money mới với hiệu amount
   * @throws Error Nếu currency khác nhau
   */
  subtract(other: Money): Money {
    if (this.currency !== other.currency) {
      throw new Error('Không thể trừ tiền tệ khác nhau');
    }
    return new Money(this.amount.minus(other.amount), this.currency);
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): MoneyData {
    return {
      amount: this.amount.toString(),
      currency: this.currency,
    };
  }

  /**
   * Tạo Money từ object.
   */
  static fromJSON(data: MoneyData): Money {
    return new Money(new Decimal(data.amount), data.currency);
  }

  /**
   * String representation.
   */
  toString(): string {
    return `${this.amount} ${this.currency}`;
  }

  /**
   * So sánh bằng với Money khác.
   */
  equals(other: Money): boolean {
    return (
      this.amount.equals(other.amount) &&
      this.currency === other.currency
    );
  }

  /**
   * Hash code cho Money.
   */
  hashCode(): number {
    return `${this.amount}-${this.currency}`.charCodeAt(0);
  }
}