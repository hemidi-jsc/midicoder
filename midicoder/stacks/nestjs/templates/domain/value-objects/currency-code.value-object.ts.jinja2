 */

export interface CurrencyCodeData {
  code: string;
  symbol?: string;
}

export class CurrencyCode {
  readonly code: string;
  readonly symbol: string;

  private constructor(code: string, symbol: string = '') {
    this.code = code;
    this.symbol = symbol;
  }

  /**
   * Tạo CurrencyCode với validation (ISO 4217).
   */
  static create(code: string, symbol: string = ''): CurrencyCode {
    if (!code || !/^[A-Z]{3}$/.test(code.toUpperCase())) {
      throw new Error('Mã tiền tệ phải là 3 ký tự hoa (ISO 4217)');
    }

    if (symbol && !/^[^\s]{1,5}$/.test(symbol)) {
      throw new Error('Ký hiệu tiền tệ không hợp lệ');
    }

    return new CurrencyCode(code.toUpperCase(), symbol);
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): CurrencyCodeData {
    return {
      code: this.code,
      symbol: this.symbol,
    };
  }

  /**
   * Tạo CurrencyCode từ object.
   */
  static fromJSON(data: CurrencyCodeData): CurrencyCode {
    return new CurrencyCode(data.code.toUpperCase(), data.symbol ?? '');
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.code;
  }

  /**
   * So sánh bằng.
   */
  equals(other: CurrencyCode): boolean {
    return this.code === other.code;
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return this.code.charCodeAt(0);
  }
}

