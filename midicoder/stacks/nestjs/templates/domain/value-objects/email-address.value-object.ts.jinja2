export interface EmailAddressData {
  localPart: string;
  domain: string;
  email?: string;
}

export class EmailAddress {
  readonly localPart: string;
  readonly domain: string;

  private constructor(localPart: string, domain: string) {
    this.localPart = localPart;
    this.domain = domain;
  }

  /**
   * Tạo EmailAddress từ local_part và domain.
   */
  static create(localPart: string, domain: string): EmailAddress {
    if (!localPart || localPart.length > 64) {
      throw new Error('Phần local của email không hợp lệ (max 64 ký tự)');
    }

    if (!domain || domain.length > 255) {
      throw new Error('Tên miền email không hợp lệ (max 255 ký tự)');
    }

    if (!domain.includes('.')) {
      throw new Error('Tên miền phải có ít nhất một dấu chấm');
    }

    return new EmailAddress(localPart, domain);
  }

  /**
   * Tạo EmailAddress từ email string.
   */
  static fromEmail(email: string): EmailAddress {
    if (!email.includes('@')) {
      throw new Error('Email không hợp lệ: thiếu dấu @');
    }

    const parts = email.rsplit('@', 1);
    if (parts.length !== 2) {
      throw new Error('Email không hợp lệ');
    }

    return new EmailAddress(parts[0], parts[1]);
  }

  /**
   * Trả về email đầy đủ.
   */
  get email(): string {
    return `${this.localPart}@${this.domain}`;
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): EmailAddressData {
    return {
      localPart: this.localPart,
      domain: this.domain,
      email: this.email,
    };
  }

  /**
   * Tạo EmailAddress từ object.
   */
  static fromJSON(data: EmailAddressData): EmailAddress {
    if (data.email) {
      return EmailAddress.fromEmail(data.email);
    }
    return new EmailAddress(data.localPart, data.domain);
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.email;
  }

  /**
   * So sánh bằng (case-insensitive).
   */
  equals(other: EmailAddress): boolean {
    return (
      this.localPart.toLowerCase() === other.localPart.toLowerCase() &&
      this.domain.toLowerCase() === other.domain.toLowerCase()
    );
  }
}