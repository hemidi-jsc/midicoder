export interface AddressData {
  street: string;
  ward: string;
  district: string;
  city: string;
  postalCode?: string;
  country?: string;
  fullAddress?: string;
}

export class Address {
  readonly street: string;
  readonly ward: string;
  readonly district: string;
  readonly city: string;
  readonly postalCode: string;
  readonly country: string;

  private constructor(
    street: string,
    ward: string,
    district: string,
    city: string,
    postalCode: string = '',
    country: string = 'VN'
  ) {
    this.street = street;
    this.ward = ward;
    this.district = district;
    this.city = city;
    this.postalCode = postalCode;
    this.country = country;
  }

  /**
   * Tạo Address với validation.
   */
  static create(
    street: string,
    ward: string,
    district: string,
    city: string,
    postalCode: string = '',
    country: string = 'VN'
  ): Address {
    if (!street || !street.trim()) {
      throw new Error('Đường phố là bắt buộc');
    }

    if (!ward || !ward.trim()) {
      throw new Error('Phường/Xã là bắt buộc');
    }

    if (!district || !district.trim()) {
      throw new Error('Quận/Huyện là bắt buộc');
    }

    if (!city || !city.trim()) {
      throw new Error('Thành phố/Tỉnh là bắt buộc');
    }

    return new Address(street, ward, district, city, postalCode, country);
  }

  /**
   * Trả về địa chỉ đầy đủ.
   */
  get fullAddress(): string {
    const parts = [this.street, this.ward, this.district, this.city];
    if (this.postalCode) {
      parts.push(this.postalCode);
    }
    if (this.country !== 'VN') {
      parts.push(this.country);
    }
    return parts.join(', ');
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): AddressData {
    return {
      street: this.street,
      ward: this.ward,
      district: this.district,
      city: this.city,
      postalCode: this.postalCode,
      country: this.country,
      fullAddress: this.fullAddress,
    };
  }

  /**
   * Tạo Address từ object.
   */
  static fromJSON(data: AddressData): Address {
    return new Address(
      data.street,
      data.ward,
      data.district,
      data.city,
      data.postalCode ?? '',
      data.country ?? 'VN'
    );
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.fullAddress;
  }

  /**
   * So sánh bằng.
   */
  equals(other: Address): boolean {
    return (
      this.street.toLowerCase() === other.street.toLowerCase() &&
      this.ward.toLowerCase() === other.ward.toLowerCase() &&
      this.district.toLowerCase() === other.district.toLowerCase() &&
      this.city.toLowerCase() === other.city.toLowerCase() &&
      this.country.toLowerCase() === other.country.toLowerCase()
    );
  }
}