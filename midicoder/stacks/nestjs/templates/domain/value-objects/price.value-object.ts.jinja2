import { Decimal } from 'decimal.js';

export interface PriceData {
  amount: string | number | Decimal;
  currency: string;
  inclusiveTax?: boolean;
}

export class Price {
  readonly amount: Decimal;
  readonly currency: string;
  readonly inclusiveTax: boolean;

  private constructor(amount: Decimal, currency: string, inclusiveTax: boolean = false) {
    this.amount = amount;
    this.currency = currency;
    this.inclusiveTax = inclusiveTax;
  }

  /**
   * Tạo Price object với validation.
   */
  static create(amount: string | number | Decimal, currency: string, inclusiveTax: boolean = false): Price {
    if (amount < 0) {
      throw new Error('Giá không thể âm');
    }

    if (!currency || currency.length !== 3) {
      throw new Error('Mã tiền tệ phải là 3 ký tự');
    }

    return new Price(new Decimal(amount), currency.toUpperCase(), inclusiveTax);
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): PriceData {
    return {
      amount: this.amount.toString(),
      currency: this.currency,
      inclusiveTax: this.inclusiveTax,
    };
  }

  /**
   * Tạo Price từ object.
   */
  static fromJSON(data: PriceData): Price {
    return new Price(
      new Decimal(data.amount),
      data.currency,
      data.inclusiveTax ?? false
    );
  }

  /**
   * String representation.
   */
  toString(): string {
    const taxInfo = this.inclusiveTax ? '(bao gồm thuế)' : '(chưa bao gồm thuế)';
    return `${this.amount} ${this.currency} ${taxInfo}`;
  }

  /**
   * So sánh bằng với Price khác.
   */
  equals(other: Price): boolean {
    return (
      this.amount.equals(other.amount) &&
      this.currency === other.currency &&
      this.inclusiveTax === other.inclusiveTax
    );
  }

  /**
   * Hash code cho Price.
   */
  hashCode(): number {
    return `${this.amount}-${this.currency}-${this.inclusiveTax}`.charCodeAt(0);
  }
}