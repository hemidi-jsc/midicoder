import { v4 as uuidv4 } from 'uuid';

export interface OrderNumberData {
  orderNumber: string;
  normalized?: string;
}

export class OrderNumber {
  readonly orderNumber: string;

  private constructor(orderNumber: string) {
    this.orderNumber = orderNumber;
  }

  /**
   * Tạo OrderNumber với validation.
   */
  static create(orderNumber: string): OrderNumber {
    if (!orderNumber || !orderNumber.trim()) {
      throw new Error('Mã đơn hàng không được để trống');
    }

    if (!/^[A-Z0-9_-]{6,20}$/.test(orderNumber.toUpperCase())) {
      throw new Error('Mã đơn hàng chỉ chứa chữ hoa, số, gạch ngang (6-20 ký tự)');
    }

    return new OrderNumber(orderNumber);
  }

  /**
   * Trả về order number chuẩn hóa (uppercase).
   */
  get normalized(): string {
    return this.orderNumber.toUpperCase();
  }

  /**
   * Chuyển thành object.
   */
  toJSON(): OrderNumberData {
    return {
      orderNumber: this.orderNumber,
      normalized: this.normalized,
    };
  }

  /**
   * Tạo OrderNumber từ object.
   */
  static fromJSON(data: OrderNumberData): OrderNumber {
    return new OrderNumber(data.orderNumber || data.normalized || '');
  }

  /**
   * Tạo order number mới.
   */
  static generate(prefix: string = 'ORD'): OrderNumber {
    const timestamp = new Date().toISOString().replace(/[-:T.]/g, '').slice(0, 14);
    const suffix = uuidv4().slice(0, 4).toUpperCase();
    const orderNum = `${prefix}-${timestamp}-${suffix}`;
    return new OrderNumber(orderNum);
  }

  /**
   * String representation.
   */
  toString(): string {
    return this.normalized;
  }

  /**
   * So sánh bằng (case-insensitive).
   */
  equals(other: OrderNumber): boolean {
    return this.orderNumber.toUpperCase() === other.orderNumber.toUpperCase();
  }

  /**
   * Hash code.
   */
  hashCode(): number {
    return this.normalized.charCodeAt(0);
  }
}