/**
 * Ledger Service - Double-Entry Bookkeeping Service cho NestJS.
 *
 * Module này cung cấp Ledger service cho:
 * - Double-entry validation (RX02)
 * - Ledger entry creation
 * - Transaction immutability
 * - Balance reconciliation
 *
 * KPI-029: Tenant-aware ledger operations
 * RX02: Financial integrity with double-entry bookkeeping
 */

import { Injectable } from "@nestjs/common";
import { LedgerRepository } from "../db/ledger.repository";
import { AuditLoggerService } from "../audit/audit.service";

/**
 * Ledger Entry interface.
 */
interface LedgerEntry {
  transactionId: string;
  tenantId: string;
  account: string;
  amount: number;
  type: "debit" | "credit";
  description: string;
  transactionRef: string;
  userId?: string;
  timestamp: string;
  immutable: boolean;
}

/**
 * Ledger Entry Result interface.
 */
interface LedgerEntryResult {
  transactionId: string;
  entryIds: string[];
  debitTotal: number;
  creditTotal: number;
  balanced: boolean;
}

/**
 * Ledger Service - Double-entry bookkeeping service.
 *
 * Service này cung cấp methods cho:
 * - Double-entry validation (debit == credit)
 * - Ledger entry creation
 * - Transaction immutability (RX02)
 * - Balance reconciliation
 *
 * KPI-029: Support tenant-scoped ledger operations.
 * RX02: Financial integrity - double-entry required, transaction immutability.
 */
@Injectable()
export class LedgerService {
  private readonly tolerance = 0.01;

  constructor(
    private readonly ledgerRepo: LedgerRepository,
    private readonly auditLogger: AuditLoggerService,
  ) {}

  /**
   * Tạo ledger entries cho double-entry transaction.
   *
   * KPI-029: Tenant-scoped ledger entries.
   * RX02: Double-entry validation và transaction immutability.
   */
  async createLedgerEntries(
    debitEntries: Array<{ account: string; amount: number; description: string }>,
    creditEntries: Array<{ account: string; amount: number; description: string }>,
    transactionRef: string,
    description: string,
    userId: string | undefined,
    tenantId: string,
  ): Promise<LedgerEntryResult> {
    // Validate double-entry balance
    const debitTotal = debitEntries.reduce((sum, e) => sum + e.amount, 0);
    const creditTotal = creditEntries.reduce((sum, e) => sum + e.amount, 0);

    if (Math.abs(debitTotal - creditTotal) > this.tolerance) {
      throw new Error(
        `Double-entry imbalance: debit=${debitTotal}, credit=${creditTotal}`,
      );
    }

    // Create transaction record
    const transactionId = `txn_${tenantId}_${Date.now()}`;
    const timestamp = new Date().toISOString();
    const entryIds: string[] = [];

    // Create debit entries
    for (const entry of debitEntries) {
      const ledgerEntry: LedgerEntry = {
        transactionId,
        tenantId,
        account: entry.account,
        amount: entry.amount,
        type: "debit",
        description: entry.description,
        transactionRef,
        userId,
        timestamp,
        immutable: false,
      };
      const entryId = await this.ledgerRepo.createEntry(ledgerEntry);
      entryIds.push(entryId);
    }

    // Create credit entries
    for (const entry of creditEntries) {
      const ledgerEntry: LedgerEntry = {
        transactionId,
        tenantId,
        account: entry.account,
        amount: entry.amount,
        type: "credit",
        description: entry.description,
        transactionRef,
        userId,
        timestamp,
        immutable: false,
      };
      const entryId = await this.ledgerRepo.createEntry(ledgerEntry);
      entryIds.push(entryId);
    }

    // Mark transaction as immutable (RX02)
    await this.ledgerRepo.markTransactionImmutable(transactionId, tenantId);

    // Audit log
    this.auditLogger.info("Double-entry transaction created", {
      transactionId,
      tenantId,
      debitTotal,
      creditTotal,
      entryCount: entryIds.length,
      userId,
    });

    return {
      transactionId,
      entryIds,
      debitTotal,
      creditTotal,
      balanced: true,
    };
  }

  /**
   * Validate double-entry balance (debit == credit).
   */
  validateBalance(debit: number, credit: number): boolean {
    return Math.abs(debit - credit) <= this.tolerance;
  }

  /**
   * Lấy transaction balance.
   */
  async getTransactionBalance(txnId: string, tenantId: string): Promise<number> {
    const entries = await this.ledgerRepo.getTransactionEntries(txnId, tenantId);

    const debitTotal = entries
      .filter((e) => e.type === "debit")
      .reduce((sum, e) => sum + e.amount, 0);
    const creditTotal = entries
      .filter((e) => e.type === "credit")
      .reduce((sum, e) => sum + e.amount, 0);

    return debitTotal - creditTotal;
  }

  /**
   * Lấy account balance.
   */
  async getAccountBalance(account: string, tenantId: string): Promise<number> {
    const entries = await this.ledgerRepo.getAccountEntries(account, tenantId);

    const debitTotal = entries
      .filter((e) => e.type === "debit")
      .reduce((sum, e) => sum + e.amount, 0);
    const creditTotal = entries
      .filter((e) => e.type === "credit")
      .reduce((sum, e) => sum + e.amount, 0);

    return debitTotal - creditTotal;
  }

  /**
   * Daily reconciliation cho tenant.
   */
  async reconcileDaily(date: string, tenantId: string): Promise<any> {
    const transactions = await this.ledgerRepo.getDailyTransactions(
      date,
      tenantId,
    );

    let totalDebit = 0;
    let totalCredit = 0;
    const imbalancedTransactions: any[] = [];

    for (const txn of transactions) {
      const txnDebit = txn.entries
        .filter((e: any) => e.type === "debit")
        .reduce((sum: number, e: any) => sum + e.amount, 0);
      const txnCredit = txn.entries
        .filter((e: any) => e.type === "credit")
        .reduce((sum: number, e: any) => sum + e.amount, 0);

      totalDebit += txnDebit;
      totalCredit += txnCredit;

      if (Math.abs(txnDebit - txnCredit) > this.tolerance) {
        imbalancedTransactions.push({
          transactionId: txn.id,
          debit: txnDebit,
          credit: txnCredit,
        });
      }
    }

    return {
      date,
      tenantId,
      totalDebit,
      totalCredit,
      balanced: Math.abs(totalDebit - totalCredit) <= this.tolerance,
      transactionCount: transactions.length,
      imbalancedCount: imbalancedTransactions.length,
      imbalancedTransactions,
    };
  }
}