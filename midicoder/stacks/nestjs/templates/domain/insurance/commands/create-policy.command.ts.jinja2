/**
 * Create Policy Command (NestJS/TypeScript)
 *
 * Tạo hợp đồng bảo hiểm với underwriting check.
 */

import { IsString, IsNotEmpty, IsNumber, Min } from 'class-validator';

export class CreatePolicyInput {
  @IsString()
  @IsNotEmpty()
  policyId: string;

  @IsString()
  @IsNotEmpty()
  policyType: string;

  @IsString()
  @IsNotEmpty()
  insuredName: string;

  @IsNumber()
  @Min(0.01)
  coverageAmount: number;

  @IsNumber()
  @Min(0.01)
  premiumAmount: number;

  @IsString()
  @IsNotEmpty()
  startDate: string;

  @IsString()
  @IsNotEmpty()
  endDate: string;
}

export class CreatePolicyCommand {
  name = 'insurance.create_policy';
  description = 'Tạo hợp đồng bảo hiểm mới';
  guards = ['tenant_scope', 'auth_required', 'permission:insurance:policy:create'];
  effects = ['create_record', 'underwriting_check', 'write_audit_log', 'publish_event'];

  async execute(input: CreatePolicyInput, context: any): Promise<void> {
    // INV-INS-001: Underwriting before policy active
  }
}