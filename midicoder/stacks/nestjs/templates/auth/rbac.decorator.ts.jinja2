 * 
 * Guard để evaluate policy từ @Policy() decorator.
 */
export function PolicyGuardFactory() {
  return class PolicyGuard {
    constructor() {}

    async canActivate(context: any): Promise<boolean> {
      // Get required policy từ metadata
      const policyId = context.switchToHttp().getHandler()[POLICY_KEY];
      
      if (!policyId) {
        return true;
      }

      const request = context.switchToHttp().getRequest();
      const user = request.user;

      if (!user) {
        return false;
      }

      // TODO: Implement policy evaluation
      // This would involve:
      // 1. Building context with user info, request data, resource info
      // 2. Evaluating policy against context
      // 3. Returning result

      // For now, return true
      return true;
    }
  };
}

/**
 * AuthConfig interface.
 * 
 * KPI-029: Include tenant_id option.
 */
export interface AuthConfig {
  /** Enable roles guard */
  rolesGuard?: boolean;
  /** Enable permissions guard */
  permissionsGuard?: boolean;
  /** Enable policy guard */
  policyGuard?: boolean;
  /** KPI-029: Tenant ID for tenant-specific auth */
  tenantId?: string | 'current';
  /** KPI-029: Enable tenant-scoped permissions */
  tenantScoped?: boolean;
}

/**
 * Global auth decorators.
 * 
 * KPI-029: Support tenant-specific auth configuration.
 * 
 * Combine multiple auth decorators into one.
 * 
 * Usage:
 * @Auth({ roles: ['admin'], permissions: ['order.create'] })
 * @Post('orders')
 * async createOrder() { ... }
 * 
 * @Auth({ tenantId: 'current', tenantScoped: true, permissions: ['order.create'] })
 * @Post('orders')
 * async createOrder() { ... }
 */
export function Auth(config: AuthConfig) {
  const decorators: any[] = [];

  // KPI-029: Add tenant_id metadata if specified
  if (config.tenantId) {
    decorators.push(SetMetadata(TENANT_ID_KEY, config.tenantId));
  }

  if (config.rolesGuard) {
    // Would need to know specific roles
  }

  if (config.permissionsGuard || config.tenantScoped) {
    // Would need to know specific permissions
  }

  return applyDecorators(...decorators);
}

/**
 * KPI-029: Get tenant ID from request.
 * 
 * Extract tenant_id từ request context.
 * 
 * @param request - Express request
 * @returns Tenant ID nếu có, null nếu không
 */
export function getTenantIdFromRequest(request: any): string | null {
  // Try from request.user first (if authenticated)
  if (request.user?.tenantId) {
    return request.user.tenantId;
  }
  
  // Try from headers
  const tenantId = request.headers['x-tenant-id'];
  if (tenantId) {
    return tenantId;
  }
  
  // Try from URL params
  if (request.params?.tenant_id) {
    return request.params.tenant_id;
  }
  
  return null;
}
