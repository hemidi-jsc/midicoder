/**
 * RBAC Decorators - Role-Based Access Control cho NestJS.
 * 
 * Module này cung cấp decorators cho RBAC trong NestJS.
 * Hỗ trợ @Roles(), @Permissions(), và @Policy() decorators.
 * 
 * KPI-029: Tenant Isolation - Support tenant-specific roles và permissions
 * CP03 + CP04: Authentication & Authorization + RBAC & Policy Engine
 */

import { SetMetadata, applyDecorators } from '@nestjs/common';

/**
 * Metadata keys.
 */
export const ROLES_KEY = 'roles';
export const PERMISSIONS_KEY = 'permissions';
export const POLICY_KEY = 'policy';

// KPI-029: Tenant-specific metadata keys
export const TENANT_ID_KEY = 'tenant_id';
export const TENANT_ROLES_KEY = 'tenant_roles';
export const TENANT_PERMISSIONS_KEY = 'tenant_permissions';

/**
 * Roles decorator.
 * 
 * KPI-029: Support tenant-specific roles với tenant_id option.
 * 
 * Usage:
 * @Roles('admin')
 * @Get('admin')
 * async adminPanel() { ... }
 * 
 * @param roles - Danh sách role names
 */
export function Roles(...roles: string[]) {
  return SetMetadata(ROLES_KEY, roles);
}

/**
 * KPI-029: Tenant-specific roles decorator.
 * 
 * Usage:
 * @TenantRoles('tenant_id', 'tenant_admin')
 * @Get('tenant/:tenant_id/admin')
 * async tenantAdmin(@Param('tenant_id') tenantId: string) { ... }
 * 
 * @param tenantId - Tenant ID hoặc 'current' cho current tenant
 * @param roles - Danh sách role names cho tenant này
 */
export function TenantRoles(tenantId: string | 'current', ...roles: string[]) {
  return applyDecorators(
    SetMetadata(TENANT_ID_KEY, tenantId),
    SetMetadata(TENANT_ROLES_KEY, roles),
  );
}

/**
 * Permissions decorator.
 * 
 * KPI-029: Permissions có thể là tenant-scoped với prefix 'tenant_'.
 * 
 * Usage:
 * @Permissions('order.create', 'order.update')
 * @Post('orders')
 * async createOrder() { ... }
 * 
 * @param permissions - Danh sách permission IDs (có thể tenant-scoped)
 */
export function Permissions(...permissions: string[]) {
  return SetMetadata(PERMISSIONS_KEY, permissions);
}

/**
 * KPI-029: Tenant-specific permissions decorator.
 * 
 * Tự động thêm prefix 'tenant_' vào permissions.
 * 
 * Usage:
 * @TenantPermissions('tenant_id', 'order.create', 'order.update')
 * @Post('tenant/:tenant_id/orders')
 * async createOrder(@Param('tenant_id') tenantId: string) { ... }
 * 
 * @param tenantId - Tenant ID hoặc 'current' cho current tenant
 * @param permissions - Danh sách base permission IDs (sẽ được auto-prefix)
 */
export function TenantPermissions(tenantId: string | 'current', ...permissions: string[]) {
  const tenantScopedPermissions = permissions.map(p => 
    p.startsWith('tenant_') ? p : `tenant_${p}`
  );
  
  return applyDecorators(
    SetMetadata(TENANT_ID_KEY, tenantId),
    SetMetadata(TENANT_PERMISSIONS_KEY, tenantScopedPermissions),
    SetMetadata(PERMISSIONS_KEY, tenantScopedPermissions),
  );
}

/**
 * Policy decorator.
 * 
 * KPI-029: Policies có thể include tenant context.
 * 
 * Usage:
 * @Policy('only_owner_can_edit')
 * @Patch(':id')
 * async updateOrder(@Param('id') id: string) { ... }
 * 
 * @param policyId - Policy ID
 */
export function Policy(policyId: string) {
  return SetMetadata(POLICY_KEY, policyId);
}

/**
 * KPI-029: Tenant-specific policy decorator.
 * 
 * Policy với tenant context.
 * 
 * Usage:
 * @TenantPolicy('tenant_id', 'tenant_owner_can_edit')
 * @Patch('tenant/:tenant_id/orders/:id')
 * async updateOrder(@Param('tenant_id') tenantId: string, @Param('id') id: string) { ... }
 * 
 * @param tenantId - Tenant ID hoặc 'current' cho current tenant
 * @param policyId - Policy ID (có thể tenant-scoped)
 */
export function TenantPolicy(tenantId: string | 'current', policyId: string) {
  const tenantPolicyId = policyId.startsWith('tenant_') ? policyId : `tenant_${policyId}`;
  
  return applyDecorators(
    SetMetadata(TENANT_ID_KEY, tenantId),
    SetMetadata(POLICY_KEY, tenantPolicyId),
  );
}

/**
 * RolesGuard mixin.
 * 
 * Guard để check roles từ @Roles() decorator.
 */
export function RolesGuardFactory() {
  return class RolesGuard {
    constructor() {}

    canActivate(context: any): boolean {
      // Get required roles từ metadata
      const requiredRoles = context.switchToHttp().getHandler()[ROLES_KEY];
      
      if (!requiredRoles) {
        return true;
      }

      const request = context.switchToHttp().getRequest();
      const user = request.user;

      if (!user) {
        return false;
      }

      // Check nếu user có ít nhất một required role
      return requiredRoles.some((role: string) => {
        if (user.roles && Array.isArray(user.roles)) {
          return user.roles.includes(role);
        }
        return user.role === role;
      });
    }
  };
}

/**
 * PermissionsGuard mixin.
 * 
 * Guard để check permissions từ @Permissions() decorator.
 */
export function PermissionsGuardFactory() {
  return class PermissionsGuard {
    constructor() {}

    async canActivate(context: any): Promise<boolean> {
      // Get required permissions từ metadata
      const requiredPermissions = context.switchToHttp().getHandler()[PERMISSIONS_KEY];
      
      if (!requiredPermissions) {
        return true;
      }

      const request = context.switchToHttp().getRequest();
      const user = request.user;

      if (!user) {
        return false;
      }

      // Check nếu user có tất cả required permissions
      // In production, you would check against user's actual permissions
      // For now, we check if user has admin role (bypass)
      if (user.roles && user.roles.includes('admin')) {
        return true;
      }

      // TODO: Implement real permission checking
      // This would typically involve:
      // 1. Getting user's roles
      // 2. Expanding roles to permissions (including inheritance)
      // 3. Checking if user has all required permissions

      return false;
    }
  };
}

