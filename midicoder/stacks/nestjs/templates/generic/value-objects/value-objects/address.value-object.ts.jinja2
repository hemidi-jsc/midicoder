/**
 * Address Value Object
 * 
 * Địa chỉ với multi-format support (Vietnam, International).
 * Generated by Midicoder - NestJSValueObjectEmitter
 * CP01: Domain Model - Value Objects
 * 
 * KPI-029: Tenant Isolation - Value Objects are tenant-scoped when used in tenant contexts
 * 
 * @tags location, address, geospatial
 * @compliance KPI-001, KPI-015, KPI-029
 */

import { IsString, IsOptional, IsLatitude, IsLongitude, Matches } from 'class-validator';

export class Address {
  /**
   * Số nhà, đường
   */
  @IsString()
  street: string;

  /**
   * Phường/Xã
   */
  @IsString()
  ward: string;

  /**
   * Quận/Huyện
   */
  @IsString()
  district: string;

  /**
   * Thành phố/Tỉnh
   */
  @IsString()
  city: string;

  /**
   * Mã bưu chính (optional)
   */
  @IsOptional()
  @Matches(/^\d{5,6}$/, { message: 'postal_code phải là 5-6 chữ số' })
  postalCode?: string;

  /**
   * Mã quốc gia ISO 3166-1 alpha-2 (default: VN)
   */
  @IsString()
  @Matches(/^[A-Z]{2}$/, { message: 'country phải là mã ISO 3166-1 alpha-2' })
  country: string = 'VN';

  /**
   * Vĩ độ (optional, cho geocoding)
   */
  @IsOptional()
  @IsLatitude()
  latitude?: number;

  /**
   * Kinh độ (optional, cho geocoding)
   */
  @IsOptional()
  @IsLongitude()
  longitude?: number;

  /**
   * Kiểm tra xem có tọa độ không
   */
  get hasCoordinates(): boolean {
    return this.latitude !== undefined && this.longitude !== undefined;
  }

  /**
   * Alias cho city (để compatibility)
   */
  get province(): string {
    return this.city;
  }

  /**
   * Get địa chỉ đầy đủ theo format
   * @param format Format (vn: Vietnam format, int: International format)
   * @returns Full address string
   */
  getFullAddress(format: 'vn' | 'int' = 'vn'): string {
    if (format === 'vn') {
      return `${this.street}, ${this.ward}, ${this.district}, ${this.city}, ${this.country}`;
    }
    const postal = this.postalCode ? `, ${this.postalCode}` : '';
    return `${this.street}, ${this.ward}, ${this.district}, ${this.city}${postal}, ${this.country}`;
  }

  /**
   * Get địa chỉ ngắn gọn
   * @returns Short address string
   */
  getShortAddress(): string {
    return `${this.street}, ${this.district}, ${this.city}`;
  }

  /**
   * Get tọa độ (latitude, longitude)
   * @returns Tuple [lat, lng] hoặc undefined nếu không có
   */
  getCoordinates(): [number, number] | undefined {
    if (this.hasCoordinates && this.latitude !== undefined && this.longitude !== undefined) {
      return [this.latitude, this.longitude];
    }
    return undefined;
  }

  /**
   * Kiểm tra xem địa chỉ có ở Việt Nam không
   */
  isInVietnam(): boolean {
    return this.country === 'VN';
  }

  /**
   * Tính khoảng cách đến địa chỉ khác (km) - Haversine formula
   * @param other Address khác
   * @returns Khoảng cách (km) hoặc undefined nếu thiếu tọa độ
   */
  distanceTo(other: Address): number | undefined {
    if (!this.hasCoordinates || !other.hasCoordinates) {
      return undefined;
    }
    if (this.latitude === undefined || this.longitude === undefined ||
        other.latitude === undefined || other.longitude === undefined) {
      return undefined;
    }

    const toRad = (deg: number) => deg * (Math.PI / 180);
    const lat1 = toRad(this.latitude);
    const lon1 = toRad(this.longitude);
    const lat2 = toRad(other.latitude);
    const lon2 = toRad(other.longitude);

    const dlat = lat2 - lat1;
    const dlon = lon2 - lon1;

    const a = Math.sin(dlat / 2) ** 2 +
              Math.cos(lat1) * Math.cos(lat2) * Math.sin(dlon / 2) ** 2;
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return 6371 * c;
  }

  /**
   * KPI-029: Lấy tenant_id nếu VO có tenant context.
   * 
   * @returns Tenant ID nếu có, undefined nếu không
   */
  getTenantId(): string | undefined {
    // KPI-029: Value Objects thường không có tenant_id trực tiếp
    // nhưng có thể được sử dụng trong tenant context
    return undefined;
  }

  /**
   * Chuyển thành dictionary
   */
  toDict(): Record<string, any> {
    return {
      street: this.street,
      ward: this.ward,
      district: this.district,
      city: this.city,
      postal_code: this.postalCode,
      country: this.country,
      latitude: this.latitude,
      longitude: this.longitude,
    };
  }

  /**
   * Tạo Address từ dictionary
   */
  static fromDict(data: Record<string, any>): Address {
    const address = new Address();
    address.street = data.street;
    address.ward = data.ward;
    address.district = data.district;
    address.city = data.city;
    address.postalCode = data.postal_code;
    address.country = data.country || 'VN';
    address.latitude = data.latitude;
    address.longitude = data.longitude;
    return address;
  }

  /**
   * String representation
   */
  toString(): string {
    return this.getFullAddress();
  }
}