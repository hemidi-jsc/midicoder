/**
 * Workflow Guard for NestJS.
 * 
 * KPI-029: Tenant Isolation - Guard checks tenant_id for workflow operations
 * CP04: Workflow Engine
 */

import { Injectable, CanActivate, ExecutionContext, ForbiddenException } from '@nestjs/common';

/**
 * Workflow Guard.
 * 
 * KPI-029: Guards ensure that workflow operations respect tenant isolation.
 * - Validates tenant_id in request matches user's tenant
 * - Prevents cross-tenant workflow manipulation
 */
@Injectable()
export class WorkflowGuard implements CanActivate {
    async canActivate(context: ExecutionContext): Promise<boolean> {
        const request = context.switchToHttp().getRequest();
        const user = request.user;
        
        // KPI-029: Get tenant_id from request body or params
        const workflowTenantId = request.body?.tenant_id || request.params?.tenant_id;
        
        // KPI-029: Check if user has permission to access this tenant's workflow
        if (workflowTenantId && user?.tenantId) {
            if (workflowTenantId !== user.tenantId && !user.isAdmin) {
                throw new ForbiddenException(
                    `User ${user.userId} from tenant ${user.tenantId} cannot access workflow from tenant ${workflowTenantId}`
                );
            }
        }
        
        // Additional workflow-specific guard logic can be added here
        return true;
    }
}
