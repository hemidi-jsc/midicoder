/**
 * {{ entity.id }} entity model với tenant row-level isolation.
 * 
 * {% if entity.description %}
 * {{ entity.description }}
 * {% endif %}
 * 
 * Tenant Isolation (KPI-029):
 * - @TenantRow(): Tự động thêm tenantId column và validation
 * - @Column tenantId: UUID, không nullable
 * - @Index idx_tenant_id: Performance optimization
 * - isTenantOwner(): Check tenant ownership
 */
@Entity('{{ table_name }}')
@TenantRow()
export class {{ entity.id }} {
    /**
     * Primary key (UUID).
     */
    @PrimaryGeneratedColumn('uuid')
    id: string;
    
    /**
     * Tenant ID cho row-level isolation.
     * 
     * KPI-029: Tenant Isolation
     * - Required field (nullable: false)
     * - Indexed cho performance
     * - Foreign key đến Tenant entity (optional)
     * 
     * @TenantRow() decorator tự động thêm field này.
     */
    @Column({ type: 'uuid', nullable: false })
    @Index('idx_tenant_id')
    tenantId: string;
    
    /**
     * Kiểm tra entity thuộc về tenant nào.
     * 
     * @param tenantId - ID của tenant cần kiểm tra
     * @returns True nếu entity thuộc tenantId này
     * 
     * Usage:
     * ```typescript
     * if (entity.isTenantOwner(currentTenantId)) {
     *   // Allow access
     * }
     * ```
     */
    isTenantOwner(tenantId: string): boolean {
        return this.tenantId === tenantId;
    }
    
    /**
     * {{ entity.id }} properties.
     * {% if entity.description %}
     * {{ entity.description }}
     * {% endif %}
     */
     
