{{ prop_def }}
{% endfor %}
    
    /**
     * Validate tenant ID before insert.
     * 
     * Throws error nếu tenantId chưa được set.
     * @TenantRow() decorator tự động thêm hook này.
     */
    @BeforeInsert()
    validateTenantOnInsert() {
        if (!this.tenantId) {
            throw new Error('Tenant ID là bắt buộc. Vui lòng set tenantId trước khi tạo entity.');
        }
    }
    
    /**
     * Validate tenant ID không thay đổi sau khi update.
     * 
     * Tenant ID là immutable sau khi entity được tạo.
     * @TenantRow() decorator tự động thêm hook này.
     */
    @BeforeUpdate()
    preventTenantChange() {
        // Tenant ID không được thay đổi sau khi entity đã tồn tại
