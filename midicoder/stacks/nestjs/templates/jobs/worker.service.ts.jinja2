import { Injectable, Inject } from "@nestjs/common";
import { Process, Processor } from "@nestjs/bull";
import { Job } from "bull";

/**
 * Worker Service.
 *
 * Process jobs from different queues.
 */
@Processor("email")
@Injectable()
export class EmailWorkerService {
  /**
   * Process email jobs.
   *
   * @param job - Bull job
   * @returns Promise<void>
   */
  @Process("send-welcome-email")
  async processWelcomeEmail(job: Job): Promise<void> {
    const { userId, email } = job.data;

    try {
      // TODO: Implement email sending
      console.log(`Sending welcome email to ${email} (user: ${userId})`);
      await this.sendEmail(email, "Welcome", "Xin chào!");
    } catch (error) {
      console.error("Failed to send welcome email:", error);
      throw error; // Will retry
    }
  }

  @Process("send-password-reset")
  async processPasswordReset(job: Job): Promise<void> {
    const { userId, email, token } = job.data;

    try {
      console.log(`Sending password reset to ${email}`);
      await this.sendEmail(email, "Đặt lại mật khẩu", `Token: ${token}`);
    } catch (error) {
      console.error("Failed to send password reset:", error);
      throw error;
    }
  }

  private async sendEmail(to: string, subject: string, body: string): Promise<void> {
    // TODO: Implement email sending
    console.log(`Email: ${to} - ${subject}`);
  }
}

