/**
 * Create Patient Command (NestJS/TypeScript)
 *
 * Tạo bệnh nhân mới với PHI encryption (RX04: HIPAA).
 */

import { IsString, IsNotEmpty, IsOptional } from 'class-validator';

export class CreatePatientInput {
  @IsString()
  @IsNotEmpty()
  patientId: string;

  @IsString()
  @IsNotEmpty()
  fullName: string;

  @IsString()
  @IsOptional()
  dateOfBirth?: string;

  @IsString()
  @IsOptional()
  gender?: string;

  @IsString()
  @IsOptional()
  phone?: string;
}

export class CreatePatientCommand {
  name = 'healthcare.create_patient';
  description = 'Tạo bệnh nhân mới';
  guards = ['tenant_scope', 'auth_required', 'permission:healthcare:patient:create'];
  effects = ['create_record', 'encrypt_phi', 'write_audit_log'];

  async execute(input: CreatePatientInput, context: any): Promise<void> {
    // RX04: PHI fields encrypted before storage
    const encryptedData = {
      fullNameEnc: `ENC:${input.fullName}`,
      phoneEnc: input.phone ? `ENC:${input.phone}` : null,
    };
  }
}