/**
 * Clinical Workflow Service - Healthcare Workflow Service cho NestJS.
 *
 * KPI-029: Tenant-aware clinical workflows
 * RX04: HIPAA compliance
 * DP09: Healthcare Provider domain pack
 */

import { Injectable } from "@nestjs/common";
import { ClinicalRepository } from "../db/clinical.repository";
import { AuditLoggerService } from "../audit/audit.service";
import * as crypto from "crypto";

/**
 * Clinical Workflow Service.
 */
@Injectable()
export class ClinicalWorkflowService {
  private readonly validTransitions: Record<string, string[]> = {
    pending: ["scheduled", "cancelled"],
    scheduled: ["in_progress", "cancelled"],
    in_progress: ["completed", "cancelled"],
    completed: [],
    cancelled: [],
  };

  constructor(
    private readonly clinicalRepo: ClinicalRepository,
    private readonly auditLogger: AuditLoggerService,
  ) {}

  /**
   * Transition clinical case state.
   */
  async transitionState(
    caseId: string,
    fromState: string,
    toState: string,
    userId: string,
    tenantId: string,
  ): Promise<any> {
    // Validate transition
    if (!this._isValidTransition(fromState, toState)) {
      throw new Error(`Invalid transition: ${fromState} → ${toState}`);
    }

    const caseData = await this.clinicalRepo.getCase(caseId, tenantId);
    if (!caseData) {
      throw new Error(`Case not found: ${caseId}`);
    }

    if (caseData.state !== fromState) {
      throw new Error(`State mismatch: expected ${fromState}, current ${caseData.state}`);
    }

    await this.clinicalRepo.updateCaseState(caseId, tenantId, toState, userId);

    this.auditLogger.info("Clinical case state transitioned", {
      caseId,
      fromState,
      toState,
      userId,
      tenantId,
    });

    return { caseId, fromState, toState, transitioned: true };
  }

  /**
   * Clinical decision support check.
   */
  async checkClinicalDecision(
    caseId: string,
    checkType: string,
    fromState: string,
    toState: string,
    tenantId: string,
  ): Promise<boolean> {
    // TODO: Implement clinical decision logic
    this.auditLogger.info("Clinical decision check", {
      caseId,
      checkType,
      fromState,
      toState,
      tenantId,
      result: "passed",
    });
    return true;
  }

  /**
   * Log PHI access (RX04).
   */
  async logPhiAccess(
    caseId: string,
    userId: string,
    phiFields: string[],
    action: string,
    tenantId: string,
  ): Promise<string> {
    const auditId = `audit_${tenantId}_${Date.now()}`;
    const hash = this._computeHash(auditId, caseId, userId, action, phiFields);

    await this.clinicalRepo.savePhiAudit({
      auditId,
      caseId,
      tenantId,
      userId,
      action,
      phiFieldsAccessed: phiFields,
      timestamp: new Date().toISOString(),
      tamperProofHash: hash,
    });

    return auditId;
  }

  /**
   * Verify provider credentials (RX04).
   */
  async verifyProviderCredentials(userId: string, tenantId: string): Promise<boolean> {
    const provider = await this.clinicalRepo.getProviderCredentials(userId, tenantId);
    if (!provider || !provider.certified) return false;

    if (provider.certificationExpiry) {
      if (new Date() > new Date(provider.certificationExpiry)) return false;
    }

    return true;
  }

  private _isValidTransition(fromState: string, toState: string): boolean {
    const validToStates = this.validTransitions[fromState] || [];
    return validToStates.includes(toState);
  }

  private _computeHash(auditId: string, caseId: string, userId: string, action: string, phiFields: string[]): string {
    const data = `${auditId}|${caseId}|${userId}|${action}|${phiFields.join(",")}`;
    return crypto.createHash("sha256").update(data).digest("hex");
  }

  /**
   * Get clinical case.
   */
  async getCase(caseId: string, tenantId: string): Promise<any> {
    return this.clinicalRepo.getCase(caseId, tenantId);
  }

  /**
   * Get cases by state.
   */
  async getCasesByState(state: string, tenantId: string): Promise<any[]> {
    return this.clinicalRepo.getCasesByState(state, tenantId);
  }
}