/**
 * Insurance Policy Entity (NestJS/TypeORM)
 *
 * Hợp đồng bảo hiểm với underwriting fields.
 */

import { Entity, PrimaryColumn, Column, CreateDateColumn, Index } from 'typeorm';

export enum PolicyStatus {
  DRAFT = 'draft',
  UNDERWRITING = 'underwriting',
  ACTIVE = 'active',
  EXPIRED = 'expired',
  CANCELLED = 'cancelled',
}

@Entity('insurance_policies')
@Index('idx_policy_id', ['policyId'])
export class Policy {
  @PrimaryColumn({ name: 'id', length: 50 })
  id: string;

  @Column({ name: 'tenant_id', length: 50 })
  tenantId: string;

  @Column({ name: 'policy_id', length: 50, unique: true })
  policyId: string;

  @Column({ name: 'policy_type', length: 50 })
  policyType: string;

  @Column({ name: 'insured_name', length: 500 })
  insuredName: string;

  @Column({ name: 'coverage_amount', type: 'decimal', precision: 19, scale: 2 })
  coverageAmount: string;

  @Column({ name: 'premium_amount', type: 'decimal', precision: 19, scale: 2 })
  premiumAmount: string;

  @Column({ name: 'start_date', type: 'date' })
  startDate: Date;

  @Column({ name: 'end_date', type: 'date' })
  endDate: Date;

  @Column({ enum: PolicyStatus, default: PolicyStatus.DRAFT })
  status: PolicyStatus;

  @CreateDateColumn()
  createdAt: Date;
}

@Entity('insurance_claims')
@Index('idx_iclaim_policy', ['policyId'])
export class InsuranceClaim {
  @PrimaryColumn({ name: 'id', length: 50 })
  id: string;

  @Column({ name: 'tenant_id', length: 50 })
  tenantId: string;

  @Column({ name: 'claim_id', length: 50, unique: true })
  claimId: string;

  @Column({ name: 'policy_id', length: 50 })
  policyId: string;

  @Column({ name: 'claimant_name', length: 500 })
  claimantName: string;

  @Column({ name: 'claimed_amount', type: 'decimal', precision: 19, scale: 2 })
  claimedAmount: string;

  @Column({ length: 20, default: 'submitted' })
  status: string;

  @CreateDateColumn({ name: 'submitted_at' })
  submittedAt: Date;
}