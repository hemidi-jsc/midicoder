/**
 * Account Opening Workflow (NestJS/TypeScript)
 *
 * Quy trình mở tài khoản: KYC → AML → Create Account.
 */

import { IsString, IsNotEmpty } from 'class-validator';

export enum AccountOpeningState {
  KYC = 'kyc',
  AML_SCREENING = 'aml_screening',
  ACCOUNT_CREATED = 'account_created',
  FAILED = 'failed',
}

export class AccountOpeningInput {
  @IsString()
  @IsNotEmpty()
  applicationId: string;

  @IsString()
  @IsNotEmpty()
  customerId: string;
}

export class AccountOpeningWorkflow {
  name = 'banking.account_opening';
  description = 'Quy trình mở tài khoản: KYC → AML → Create Account';
  currentState: AccountOpeningState = AccountOpeningState.KYC;

  async transition(event: string): Promise<AccountOpeningState> {
    const transitions: Record<string, Record<string, AccountOpeningState>> = {
      [AccountOpeningState.KYC]: {
        'kyc_passed': AccountOpeningState.AML_SCREENING,
        'kyc_failed': AccountOpeningState.FAILED,
      },
      [AccountOpeningState.AML_SCREENING]: {
        'aml_passed': AccountOpeningState.ACCOUNT_CREATED,
        'aml_failed': AccountOpeningState.FAILED,
      },
    };
    return AccountOpeningState.FAILED;
  }
}