import { Injectable } from '@nestjs/common';
import { validate } from 'class-validator';
import { plainToClass } from 'class-transformer';

export interface FieldDefinition {
  name: string;
  type: 'string' | 'number' | 'boolean' | 'email' | 'date' | 'text';
  required?: boolean;
  min?: number;
  max?: number;
  pattern?: string;
  description?: string;
}

export interface FormSchema {
  entity_id: string;
  fields: FieldDefinition[];
}

export interface ValidationErrors {
  field: string;
  errors: string[];
}

@Injectable()
export class FormSchemaService {
  private schemas = new Map<string, FormSchema>();

  /**
   * Register a form schema dynamically
   */
  register(schema: FormSchema): void {
    this.schemas.set(schema.entity_id, schema);
  }

  /**
   * Get registered schema
   */
  get(entity_id: string): FormSchema | undefined {
    return this.schemas.get(entity_id);
  }

  /**
   * Validate data against a registered schema
   */
  async validate(entity_id: string, data: Record<string, any>): Promise<ValidationErrors[]> {
    const schema = this.schemas.get(entity_id);
    if (!schema) {
      throw new Error(`Schema not found for entity: ${entity_id}`);
    }

    const errors: ValidationErrors[] = [];

    for (const field of schema.fields) {
      const value = data[field.name];
      const fieldErrors: string[] = [];

      // Required check
      if (field.required && (value === undefined || value === null || value === '')) {
        fieldErrors.push(`${field.name} is required`);
      }

      if (value !== undefined && value !== null && value !== '') {
        // Type check
        if (field.type === 'number' && typeof value !== 'number') {
          fieldErrors.push(`${field.name} must be a number`);
        }
        if (field.type === 'boolean' && typeof value !== 'boolean') {
          fieldErrors.push(`${field.name} must be a boolean`);
        }
        if (field.type === 'email' && typeof value === 'string') {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(value)) {
            fieldErrors.push(`${field.name} must be a valid email`);
          }
        }
        if (field.type === 'string' && typeof value !== 'string') {
          fieldErrors.push(`${field.name} must be a string`);
        }

        // Min/Max checks
        if (field.type === 'number') {
          if (field.min !== undefined && (value as number) < field.min) {
            fieldErrors.push(`${field.name} must be >= ${field.min}`);
          }
          if (field.max !== undefined && (value as number) > field.max) {
            fieldErrors.push(`${field.name} must be <= ${field.max}`);
          }
        }
        if (field.type === 'string' && typeof value === 'string') {
          if (field.min && value.length < field.min) {
            fieldErrors.push(`${field.name} must be at least ${field.min} characters`);
          }
          if (field.max && value.length > field.max) {
            fieldErrors.push(`${field.name} must be at most ${field.max} characters`);
          }
        }

        // Pattern check
        if (field.pattern && typeof value === 'string') {
          const regex = new RegExp(field.pattern);
          if (!regex.test(value)) {
            fieldErrors.push(`${field.name} does not match required format`);
          }
        }
      }

      if (fieldErrors.length > 0) {
        errors.push({ field: field.name, errors: fieldErrors });
      }
    }

    return errors;
  }

  /**
   * List all registered entity IDs
   */
  listEntityIds(): string[] {
    return Array.from(this.schemas.keys());
  }

  /**
   * Remove a schema
   */
  remove(entity_id: string): boolean {
    return this.schemas.delete(entity_id);
  }
}
