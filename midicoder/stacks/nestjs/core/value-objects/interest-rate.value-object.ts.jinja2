  /**
   * Kiá»ƒm tra xem lÃ  lÃ£i suáº¥t cá»‘ Ä‘á»‹nh khÃ´ng
   */
  get isFixed(): boolean {
    return this.rateType === InterestRateType.FIXED;
  }

  /**
   * Kiá»ƒm tra xem lÃ  lÃ£i suáº¥t tháº£ ná»•i khÃ´ng
   */
  get isVariable(): boolean {
    return this.rateType === InterestRateType.VARIABLE;
  }

  /**
   * Kiá»ƒm tra xem lÃ  lÃ£i kÃ©p khÃ´ng
   */
  get isCompound(): boolean {
    return this.rateType === InterestRateType.COMPOUND;
  }

  /**
   * Kiá»ƒm tra xem lÃ£i suáº¥t cÃ³ cÃ²n hiá»‡u lá»±c khÃ´ng
   */
  isActive(): boolean {
    const today = new Date();
    const from = new Date(this.effectiveFrom);
    if (today < from) {
      return false;
    }
    if (this.effectiveTo) {
      const to = new Date(this.effectiveTo);
      if (today > to) {
        return false;
      }
    }
    return true;
  }

  /**
   * TÃ­nh lÃ£i Ä‘Æ¡n
   * Formula: I = P Ã— r Ã— t
   * @param principal Sá»‘ tiá»n gá»‘c
   * @param years Sá»‘ nÄƒm
   * @returns Sá»‘ lÃ£i
   */
  calculateSimpleInterest(principal: number, years: number): number {
    return principal * (this.rate / 100) * years;
  }

  /**
   * TÃ­nh lÃ£i kÃ©p
   * Formula: A = P(1 + r/n)^(nt), Interest = A - P
   * @param principal Sá»‘ tiá»n gá»‘c
   * @param years Sá»‘ nÄƒm
   * @returns Sá»‘ lÃ£i
   */
  calculateCompoundInterest(principal: number, years: number): number {
    const r = this.rate / 100;
    const n = this.compoundingPeriods;
    const t = years;

    const amount = principal * Math.pow((1 + r / n), n * t);
    return amount - principal;
  }

  /**
   * TÃ­nh effective annual rate (EAR)
   * Formula: EAR = (1 + r/n)^n - 1
   * @returns EAR (percentage)
   */
  getEffectiveAnnualRate(): number {
    const r = this.rate / 100;
    const n = this.compoundingPeriods;

    const ear = Math.pow((1 + r / n), n) - 1;
    return Math.round(ear * 100 * 100) / 100;
  }

  /**
