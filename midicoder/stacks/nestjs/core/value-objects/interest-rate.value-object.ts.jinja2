   */
  toDict(): Record<string, any> {
    return {
      rate: this.rate,
      rate_type: this.rateType,
      currency: this.currency,
      effective_from: this.effectiveFrom,
      effective_to: this.effectiveTo,
      compounding_periods: this.compoundingPeriods,
    };
  }

  /**
