  rate: number;

  /**
   * Loáº¡i lÃ£i suáº¥t (InterestRateType)
   */
  @IsEnum(InterestRateType, { message: 'rate_type pháº£i lÃ  giÃ¡ trá»‹ há»£p lá»‡' })
  rateType: InterestRateType;

  /**
   * MÃ£ tiá»n tá»‡ (ISO 4217)
   */
  @IsString()
  currency: string;

  /**
   * NgÃ y hiá»‡u lá»±c (ISO date string)
   */
  effectiveFrom: string;

  /**
   * NgÃ y háº¿t hiá»‡u lá»±c (optional)
   */
  @IsOptional()
  effectiveTo?: string;

  /**
   * Sá»‘ ká»³ ghÃ©p lÃ£i/nÄƒm (Ä‘á»‘i vá»›i compound interest)
   */
  @IsOptional()
  @IsNumber()
  @Min(1, { message: 'compounding_periods pháº£i lá»›n hÆ¡n 0' })
