/**
 * DTO cho việc tạo định nghĩa thuộc tính mới.
 *
 * Trường bắt buộc:
 * - name: tên thuộc tính
 * - key: khóa thuộc tính
 * - attributeType: loại thuộc tính
 *
 * Trường tùy chọn:
 * - isRequired: có bắt buộc không
 * - validationRules: quy tắc xác thực
 * - options: danh sách tùy chọn
 * - unit: đơn vị
 * - isSearchable: có tìm kiếm không
 * - isFilterable: có lọc không
 * - isVisible: có hiển thị không
 * - sortOrder: thứ tự
 * - metadata: dữ liệu bổ sung
 */
export class CreateAttributeDto {
  /**
   * Tên thuộc tính.
   */
  @IsString()
  @IsNotEmpty()
  @MaxLength(255)
  @ApiProperty({
    description: "Tên thuộc tính",
    example: "Màu sắc",
  })
  name: string;

  /**
   * Khóa thuộc tính.
   */
  @IsString()
  @IsNotEmpty()
  @MaxLength(128)
  @ApiProperty({
    description: "Khóa thuộc tính",
    example: "color",
  })
  key: string;

  /**
   * Loại thuộc tính.
   */
  @IsEnum(ATTRIBUTE_TYPES)
  @IsNotEmpty()
  @ApiProperty({
    description: "Loại thuộc tính",
    enum: ATTRIBUTE_TYPES,
    example: "select",
  })
  attributeType: string;

  /**
   * Có bắt buộc không.
   */
  @IsBoolean()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Thuộc tính có bắt buộc không",
    example: true,
  })
  isRequired?: boolean;

  /**
   * Quy tắc xác thực.
   */
  @IsObject()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Quy tắc xác thực",
    example: { min_length: 1, max_length: 50 },
  })
  validationRules?: Record<string, any>;

  /**
   * Danh sách tùy chọn.
   */
  @IsArray()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Danh sách tùy chọn (cho select/multi_select)",
    example: [{ value: "red", label: "Đỏ" }, { value: "blue", label: "Xanh" }],
  })
  options?: Array<{ value: string; label: string }>;

  /**
   * Đơn vị.
   */
  @IsString()
  @IsOptional()
  @MaxLength(32)
  @ApiPropertyOptional({
    description: "Đơn vị",
    example: "cm",
  })
  unit?: string;

  /**
   * Có thể tìm kiếm.
   */
  @IsBoolean()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Có thể tìm kiếm theo thuộc tính này",
    example: true,
  })
  isSearchable?: boolean;

  /**
   * Có thể lọc.
   */
  @IsBoolean()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Có thể lọc theo thuộc tính này",
    example: true,
  })
  isFilterable?: boolean;

  /**
   * Có hiển thị.
   */
  @IsBoolean()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Có hiển thị cho người dùng",
    example: true,
  })
  isVisible?: boolean;

  /**
   * Thứ tự sắp xếp.
   */
  @IsNumber()
  @IsOptional()
  @Min(0)
  @ApiPropertyOptional({
    description: "Thứ tự sắp xếp",
    example: 0,
  })
  sortOrder?: number;

  /**
   * Dữ liệu bổ sung.
   */
  @IsObject()
  @IsOptional()
  @ApiPropertyOptional({
    description: "Dữ liệu bổ sung dạng JSON",
    example: { group: "appearance" },
  })
  metadata?: Record<string, any>;
}

/**
 * DTO trả về thông tin thuộc tính.
 */
export class AttributeResponseDto {
  @ApiProperty({ description: "Định danh thuộc tính" })
  attributeId: string;

  @ApiProperty({ description: "Tên thuộc tính" })
  name: string;

  @ApiProperty({ description: "Khóa thuộc tính" })
  key: string;

  @ApiProperty({ description: "Loại thuộc tính", enum: ATTRIBUTE_TYPES })
  attributeType: string;

  @ApiProperty({ description: "Có bắt buộc" })
  isRequired: boolean;

  @ApiPropertyOptional({ description: "Quy tắc xác thực" })
  validationRules: Record<string, any> | null;

  @ApiProperty({ description: "Danh sách tùy chọn" })
  options: Array<{ value: string; label: string }>;

  @ApiPropertyOptional({ description: "Đơn vị" })
  unit: string | null;

  @ApiProperty({ description: "Có thể tìm kiếm" })
  isSearchable: boolean;

  @ApiProperty({ description: "Có thể lọc" })
  isFilterable: boolean;

  @ApiProperty({ description: "Có hiển thị" })
  isVisible: boolean;

  @ApiProperty({ description: "Thứ tự sắp xếp" })
  sortOrder: number;

  @ApiPropertyOptional({ description: "Dữ liệu bổ sung" })
  metadata: Record<string, any>;

  @ApiProperty({ description: "Thời điểm tạo" })
  createdAt: Date;

  @ApiProperty({ description: "Thời điểm cập nhật" })
  updatedAt: Date;
}

