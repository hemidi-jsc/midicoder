import { NestFactory } from '@nestjs/core';
import { ValidationPipe, Logger } from '@nestjs/common';

import { AppModule } from './app.module';
import { config } from './config';
import { TenantGuard } from './tenant/tenant.guard';
import { TenantContextService } from './tenant/tenant-context.service';

export async function bootstrap() {
  /**
   * Khởi tạo NestJS application.
   * 
   * KPI-029: Tenant Isolation - Cấu hình TenantGuard để cách ly tenant.
   * 
   * @returns Application instance
   */
  const app = await NestFactory.create(AppModule);
  
  // Global prefix
  app.setGlobalPrefix('api');
  
  // Enable CORS
  app.enableCors();
  
  // Validation pipe
  app.useGlobalPipes(new ValidationPipe({
    whitelist: true,
    forbidNonWhitelisted: true,
    transform: true,
  }));
  
  // ============================================================================
  // KPI-029: Tenant Isolation - Global Tenant Guard
  // ============================================================================
  /**
   * Tenant Isolation - KPI-029.
   * 
   * Tự động trích xuất tenantId từ JWT token hoặc HTTP header và lưu vào request context.
   * Tất cả các endpoint đều phải có tenantId (trừ các endpoint system).
   * 
   * Cấu hình:
   * - enableForSystemEndpoints: false (không enforce cho system endpoints)
   * - skipSystemTenants: true (bỏ qua hệ thống tenants như 'system', 'admin')
   * - tenantHeaderName: 'X-Tenant-ID' (header name để nhận tenantId)
   */
  const tenantContextService = app.get(TenantContextService);
  app.useGlobalGuards(new TenantGuard(tenantContextService, true, false, 'X-Tenant-ID'));
  
  // Log tenant isolation config
  const logger = new Logger('Bootstrap');
  logger.log(`🏢 Tenant Isolation: ${config.tenantStrategy || 'row'}`);
  logger.log(`🏢 Tenant Header: ${config.tenantHeaderName || 'X-Tenant-ID'}`);
  
  // Start server
  const port = config.port || 3000;
  await app.listen(port);
  
  console.log(`🚀 Application is running on: http://localhost:${port}`);
}

bootstrap();
