{% if schedule.get("type") == "cron" || schedule.get("cron_expression") %}
// Schedule: {{ schedule.get("schedule_id", "unknown") }}
export const SCHEDULE_{{ schedule.get("schedule_id", "unknown") | upper | replace("-", "_") }} = '{{ schedule.get("cron_expression", "") }}';
{% endif %}
{% endfor %}
