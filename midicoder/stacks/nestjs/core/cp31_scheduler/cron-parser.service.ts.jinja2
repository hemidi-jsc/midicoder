/**
 * Cron Parser Service — sinh tự động bởi Midicoder CP31.
 *
 * Module này cung cấp CronParserService để parse và tính toán
 * cron expression cho scheduled jobs.
 *
 * CP31: Scheduler & Cron Engine
 */

import { Injectable } from '@nestjs/common';

const MONTH_NAMES: Record<string, number> = {
  JAN: 1, FEB: 2, MAR: 3, APR: 4, MAY: 5, JUN: 6,
  JUL: 7, AUG: 8, SEP: 9, OCT: 10, NOV: 11, DEC: 12,
};

const DAY_NAMES: Record<string, number> = {
  SUN: 0, MON: 1, TUE: 2, WED: 3, THU: 4, FRI: 5, SAT: 6,
};

const SPECIAL_STRINGS: Record<string, string> = {
  '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *',
  '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0',
  '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
  '@hourly': '0 * * * *',
};

export interface ParsedCron {
  minute: number[];
  hour: number[];
  dayOfMonth: number[];
  month: number[];
  dayOfWeek: number[];
}

@Injectable()
export class CronParserService {
  /**
   * Parse cron expression thành dict.
   *
   * @param expression - Cron expression string.
   * @returns ParsedCron object.
   */
  parse(expression: string): ParsedCron {
    let expr = expression.trim();
    if (SPECIAL_STRINGS[expr.toLowerCase()]) {
      expr = SPECIAL_STRINGS[expr.toLowerCase()];
    }

    const parts = expr.split(/\s+/);
    if (parts.length !== 5) {
      throw new Error(`Invalid cron expression: ${expression}`);
    }

    return {
      minute: this._parseField(parts[0], 0, 59),
      hour: this._parseField(parts[1], 0, 23),
      dayOfMonth: this._parseField(parts[2], 1, 31),
      month: this._parseField(parts[3], 1, 12),
      dayOfWeek: this._parseField(parts[4], 0, 6),
    };
  }

  /**
   * Parse một field cron thành danh sách giá trị.
   */
  private _parseField(raw: string, minVal: number, maxVal: number): number[] {
    const values = new Set<number>();
    let upperRaw = raw.toUpperCase();

    for (const [name, num] of Object.entries({ ...MONTH_NAMES, ...DAY_NAMES })) {
      upperRaw = upperRaw.replace(new RegExp(name, 'g'), String(num));
    }

    for (const part of upperRaw.split(',')) {
      if (part.includes('/')) {
        const [base, step] = part.split('/', 2);
        const start = base === '*' ? minVal : parseInt(base, 10);
        for (let i = start; i <= maxVal; i += parseInt(step, 10)) {
          values.add(i);
        }
      } else if (part.includes('-')) {
        const [s, e] = part.split('-').map(Number);
        for (let i = s; i <= e; i++) {
          values.add(i);
        }
      } else if (part === '*') {
        for (let i = minVal; i <= maxVal; i++) {
          values.add(i);
        }
      } else {
        values.add(parseInt(part, 10));
      }
    }

    return Array.from(values).sort((a, b) => a - b);
  }

  /**
   * Tính thời điểm chạy tiếp theo.
   *
   * @param parsed - ParsedCron object.
   * @param after - Tính từ thời điểm nào.
   * @returns DateTime của lần chạy tiếp theo.
   */
  nextRunTime(parsed: ParsedCron, after: Date = new Date()): Date {
    const candidate = new Date(after);
    candidate.setSeconds(0, 0);
    candidate.setMinutes(candidate.getMinutes() + 1);

    const maxIterations = 366 * 24 * 60 * 4; // 4 năm
    for (let i = 0; i < maxIterations; i++) {
      const cronDow = (candidate.getDay() + 6) % 7; // JS: Sun=0, Cron: Sun=0
      if (parsed.minute.includes(candidate.getMinutes()) &&
          parsed.hour.includes(candidate.getHours()) &&
          parsed.month.includes(candidate.getMonth() + 1) &&
          parsed.dayOfMonth.includes(candidate.getDate()) &&
          parsed.dayOfWeek.includes(cronDow)) {
        return candidate;
      }
      candidate.setMinutes(candidate.getMinutes() + 1);
    }

    throw new Error('Không tìm được thời điểm chạy tiếp theo');
  }
}

