/**
 * Custom Code Blocks — Danh sách các code blocks đã đăng ký.
 *
 * Mỗi block định nghĩa:
 * - id:       Định danh duy nhất
 * - target:   Path pattern của file target
 * - code:     Nội dung code
 * - position: Vị trí inject (before/after/replace)
 * - metadata: Thông tin bổ sung tùy chọn
 *
 * @module CodeBlocks
 */

/**
 * Một custom code block đã đăng ký.
 */
export interface CodeBlock {
  /** Định danh duy nhất của block */
  id: string;
  /** Path pattern của file target */
  target: string;
  /** Nội dung code sẽ inject */
  code: string;
  /** Vị trí inject: before, after, hoặc replace */
  position?: "before" | "after" | "replace";
  /** Metadata bổ sung */
  metadata?: Record<string, any>;
}

/**
 * Danh sách code blocks mặc định.
 *
 * Auto-register blocks từ configuration.
 * Nếu có custom_code_blocks trong DSL, chúng sẽ được inject tại compile-time.
 */
export const CODE_BLOCKS: CodeBlock[] = [];
