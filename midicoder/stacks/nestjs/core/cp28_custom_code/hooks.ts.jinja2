/**
 * Compile-time Hooks — Định nghĩa các hook trigger tại lifecycle events.
 *
 * Hook events:
 * - on_before_emit:     Trước khi emit file
 * - on_after_emit:      Sau khi emit file
 * - on_template_render: Sau khi render template
 * - on_file_write:      Trước khi write file ra disk
 *
 * @module Hooks
 */

/**
 * Handler function cho hook events.
 */
export type HookHandler = (context: Record<string, any>) => void;

/**
 * Một compile-time hook.
 */
export interface Hook {
  /** Định danh duy nhất của hook */
  id: string;
  /** Tên event để trigger hook */
  event: string;
  /** Mô tả hành động của hook */
  action: string;
  /** Điều kiện để kích hoạt hook (expression string) */
  condition?: string | null;
  /** Handler function thực thi khi hook được trigger */
  handler?: HookHandler | null;
}

/**
 * Các event được hỗ trợ.
 */
export const SUPPORTED_EVENTS: string[] = [
  "on_before_emit",
  "on_after_emit",
  "on_template_render",
  "on_file_write",
];

/**
 * Registry các hooks đã đăng ký, tổ chức theo event name.
 */
export const HOOK_REGISTRY: Record<string, Hook[]> = {
  on_before_emit: [],
  on_after_emit: [],
  on_template_render: [],
  on_file_write: [],
};

/**
 * Đăng ký hook vào registry.
 *
 * @param hook - Hook cần đăng ký
 */
export function registerHook(hook: Hook): void {
  if (!HOOK_REGISTRY.hasOwnProperty(hook.event)) {
    console.warn(`[Hooks] Hook event '${hook.event}' không được hỗ trợ`);
    return;
  }
  HOOK_REGISTRY[hook.event].push(hook);
  console.debug(`[Hooks] Đã đăng ký hook: ${hook.id} (event=${hook.event})`);
}

/**
 * Trigger tất cả hooks cho một event.
 *
 * @param event   - Tên event để trigger
 * @param context - Context data cho hooks
 */
export function triggerHooks(event: string, context: Record<string, any> = {}): void {
  const hooks = HOOK_REGISTRY[event] || [];
  for (const hook of hooks) {
    try {
      // Evaluate condition nếu có
      if (hook.condition && context) {
        if (!_evaluateCondition(hook.condition, context)) {
          continue;
        }
      }
      // Execute handler
      if (hook.handler) {
        hook.handler(context);
      }
    } catch (error) {
      console.error(`[Hooks] Hook '${hook.id}' failed:`, error);
    }
  }
}

/**
 * Evaluate condition expression trong context.
 *
 * @param condition - Expression string (ví dụ: "fileType === 'command_handler'")
 * @param context   - Context variables
 * @returns Kết quả boolean
 */
export function _evaluateCondition(
  condition: string,
  context: Record<string, any>
): boolean {
  try {
    // Safe eval với limited context — không expose __builtins__
    const safeEval = new Function(...Object.keys(context), `return ${condition}`);
    return safeEval(...Object.values(context));
  } catch {
    // Default: execute nếu không thể evaluate condition
    return true;
  }
}
