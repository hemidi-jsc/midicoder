/**
 * Custom Code Registry — Quản lý tất cả code blocks, hooks, và patch rules.
 *
 * Cung cấp API để discover, register, và query custom code components.
 *
 * @module CustomCodeRegistry
 */

import { Injectable } from "@nestjs/common";

import { CODE_BLOCKS, CodeBlock } from "./blocks";
import { HOOK_REGISTRY, Hook } from "./hooks";
import { PATCH_RULES, PatchRule } from "./patches";

@Injectable()
export class CustomCodeRegistry {
  /**
   * Registry trung tâm cho tất cả custom code components.
   *
   * Quản lý:
   * - CodeBlocks:  Custom code để inject
   * - Hooks:       Compile-time lifecycle hooks
   * - PatchRules:  Regex-based code transforms
   */

  private readonly _blocks: Map<string, CodeBlock> = new Map();
  private readonly _hooks: Map<string, Hook[]> = new Map();
  private readonly _patches: Map<string, PatchRule> = new Map();
  private _initialized: boolean = false;

  /**
   * Khởi tạo registry.
   */
  constructor() {}

  /**
   * Initialize registry từ global lists.
   *
   * Đăng ký tất cả CodeBlocks, Hooks, và PatchRules
   * từ các module tương ứng vào registry nội bộ.
   */
  public initialize(): void {
    if (this._initialized) {
      return;
    }

    // Đăng ký code blocks
    for (const block of CODE_BLOCKS) {
      this._blocks.set(block.id, block);
    }

    // Đăng ký hooks theo event
    for (const [event, hooks] of Object.entries(HOOK_REGISTRY)) {
      this._hooks.set(event, hooks);
    }

    // Đăng ký patch rules
    for (const rule of PATCH_RULES) {
      this._patches.set(rule.id, rule);
    }

    this._initialized = true;
    console.info(
      `[CustomCodeRegistry] Initialized: ${this._blocks.size} blocks, ${this._hooks.size} hook events, ${this._patches.size} patches`
    );
  }

  /**
   * Lấy code block theo ID.
   *
   * @param blockId - ID của code block
   * @returns CodeBlock hoặc null nếu không tìm thấy
   */
  public getBlock(blockId: string): CodeBlock | null {
    this.initialize();
    return this._blocks.get(blockId) ?? null;
  }

  /**
   * Lấy hooks cho một event.
   *
   * @param event - Tên event
   * @returns Danh sách hooks cho event, mảng rỗng nếu không có
   */
  public getHooksForEvent(event: string): Hook[] {
    this.initialize();
    return this._hooks.get(event) ?? [];
  }

  /**
   * Lấy patch rule theo ID.
   *
   * @param ruleId - ID của patch rule
   * @returns PatchRule hoặc null nếu không tìm thấy
   */
  public getPatchRule(ruleId: string): PatchRule | null {
    this.initialize();
    return this._patches.get(ruleId) ?? null;
  }

  /**
   * Lấy tất cả code blocks.
   *
   * @returns Danh sách tất cả code blocks
   */
  public getAllBlocks(): CodeBlock[] {
    this.initialize();
    return Array.from(this._blocks.values());
  }

  /**
   * Lấy tất cả patch rules đang enabled.
   *
   * @returns Danh sách patch rules enabled
   */
  public getAllEnabledPatches(): PatchRule[] {
    this.initialize();
    return Array.from(this._patches.values()).filter((r) => r.enabled !== false);
  }

  /**
   * Lấy statistics của registry.
   *
   * @returns Object chứa thông tin thống kê
   */
  public getStats(): Record<string, number> {
    this.initialize();
    return {
      blocks_count: this._blocks.size,
      hook_events_count: this._hooks.size,
      patches_count: this._patches.size,
      enabled_patches: Array.from(this._patches.values()).filter(
        (r) => r.enabled !== false
      ).length,
    };
  }
}

// Singleton instance
export const registry = new CustomCodeRegistry();
