/**
 * Patch Rules Engine — Regex-based code transformation.
 *
 * Apply patch rules sau khi template render nhưng trước khi write file.
 * Mỗi rule có: targetPattern (regex), replacement, và enabled flag.
 *
 * @module Patches
 */

/**
 * Một patch rule để transform generated code.
 */
export interface PatchRule {
  /** Định danh duy nhất của rule */
  id: string;
  /** Regex pattern để tìm text target */
  targetPattern: string;
  /** Text thay thế (có thể dùng capture group reference) */
  replacement: string;
  /** Flag kích hoạt rule */
  enabled?: boolean;
  /** Metadata bổ sung */
  metadata?: Record<string, any>;
}

/**
 * Danh sách patch rules mặc định.
 */
export const PATCH_RULES: PatchRule[] = [];

export class PatchEngine {
  /**
   * Engine apply patch rules lên generated code content.
   */

  /**
   * Apply tất cả enabled patch rules lên content.
   *
   * Rules được apply theo thứ tự trong list.
   *
   * @param content - Nội dung code cần patch
   * @param rules   - Danh sách rules (default: PATCH_RULES global)
   * @returns Nội dung sau khi apply patches
   */
  public apply(content: string, rules?: PatchRule[]): string {
    const ruleList = rules ?? PATCH_RULES;

    let result = content;
    for (const rule of ruleList) {
      // Bỏ qua rule chưa enabled
      if (!rule.enabled) {
        continue;
      }
      try {
        // Tạo RegExp từ pattern string
        const regex = new RegExp(rule.targetPattern);
        result = result.replace(regex, rule.replacement);
        console.debug(`[PatchEngine] Applied patch rule: ${rule.id}`);
      } catch (error) {
        console.error(`[PatchEngine] Patch rule '${rule.id}' failed:`, error);
        continue;
      }
    }

    return result;
  }
}

// Singleton instance
export const patchEngine = new PatchEngine();
