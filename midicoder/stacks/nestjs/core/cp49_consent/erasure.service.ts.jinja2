/**
 * ErasureService - NestJS Service cho xử lý erasure requests.
 *
 * Cung cấp các method để quản lý vòng đời erasure request:
 * - Tạo yêu cầu xóa dữ liệu (GDPR Art.17)
 * - Phê duyệt/từ chối yêu cầu
 * - Thực thi xóa dữ liệu (tích hợp CP47 retention)
 * - Thống kê erasure requests
 *
 * CP49: Consent & Preference Management
 */

import {
  Injectable,
  NotFoundException,
  BadRequestException,
  Logger,
} from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { Repository } from "typeorm";
import { ErasureRequest } from "./consent.entity";

/**
 * Interface cho ErasureStats.
 */
export interface ErasureStats {
  /** Tổng số requests */
  total: number;
  /** Đang chờ xem xét */
  pending: number;
  /** Đang được xem xét */
  reviewing: number;
  /** Đã phê duyệt */
  approved: number;
  /** Đang xử lý */
  processing: number;
  /** Đã hoàn thành */
  completed: number;
  /** Bị từ chối */
  rejected: number;
}

/**
 * ErasureService - xử lý erasure requests.
 *
 * Quản lý vòng đời erasure request theo GDPR Art.17:
 * - createErasureRequest: tạo yêu cầu xóa (status=PENDING)
 * - approveRequest: phê duyệt yêu cầu (status=APPROVED)
 * - rejectRequest: từ chối yêu cầu (status=REJECTED)
 * - processErasure: thực thi xóa dữ liệu (tích hợp CP47)
 * - getErasureStats: thống kê erasure theo tenant
 */
@Injectable()
export class ErasureService {
  /**
   * Logger instance.
   */
  private readonly logger = new Logger("ErasureService");

  /**
   * Constructor.
   *
   * @param erasureRequestRepo - TypeORM repository cho ErasureRequest
   */
  constructor(
    @InjectRepository(ErasureRequest)
    private readonly erasureRequestRepo: Repository<ErasureRequest>,
  ) {}

  /**
   * Tạo erasure request mới.
   *
   * @param userId - ID người dùng
   * @param tenantId - ID tenant
   * @param scope - Phạm vi xóa
   * @param reason - Lý do xóa
   * @returns ErasureRequest entity
   */
  async createErasureRequest(
    userId: string,
    tenantId: string,
    scope: string,
    reason?: string,
  ): Promise<any> {
    const request = this.erasureRequestRepo.create({
      requestId: `erasure_${Date.now()}`,
      userId,
      tenantId,
      scope,
      status: "pending",
      reason: reason || "",
    });

    const saved = await this.erasureRequestRepo.save(request);

    this.logger.log(
      `Erasure request đã tạo: ${saved.requestId} (userId: ${userId}, scope: ${scope})`,
    );

    return saved;
  }

  /**
   * Lấy erasure request theo ID.
   *
   * @param requestId - ID yêu cầu
   * @returns ErasureRequest entity
   * @throws NotFoundException nếu không tìm thấy
   */
  async getErasureRequest(requestId: string): Promise<any> {
    const request = await this.erasureRequestRepo.findOne({
      where: { requestId },
    });

    if (!request) {
      throw new NotFoundException(`Erasure request '${requestId}' không tồn tại`);
    }

    return request;
  }

  /**
   * Lấy danh sách erasure requests của user.
   *
   * @param userId - ID người dùng
   * @param tenantId - ID tenant (optional)
   * @returns List ErasureRequest
   */
  async listErasureRequests(
    userId: string,
    tenantId?: string,
  ): Promise<any[]> {
    const where: any = { userId };
    if (tenantId) {
      where.tenantId = tenantId;
    }

    return this.erasureRequestRepo.find({
      where,
      order: { requestedAt: "DESC" },
    });
  }

  /**
   * Phê duyệt erasure request.
   *
   * @param requestId - ID yêu cầu
   * @returns ErasureRequest entity đã cập nhật
   * @throws NotFoundException nếu không tìm thấy
   * @throws BadRequestException nếu request đã được xử lý
   */
  async approveRequest(requestId: string): Promise<any> {
    const request = await this.getErasureRequest(requestId);

    const validStatuses = ["pending", "reviewing"];
    if (!validStatuses.includes(request.status)) {
      throw new BadRequestException(
        `Không thể phê duyệt request ở trạng thái '${request.status}'`,
      );
    }

    request.status = "approved";
    request.updatedAt = new Date();

    this.logger.log(`Erasure request đã được phê duyệt: ${requestId}`);

    return this.erasureRequestRepo.save(request);
  }

  /**
   * Từ chối erasure request.
   *
   * @param requestId - ID yêu cầu
   * @param reason - Lý do từ chối
   * @returns ErasureRequest entity đã cập nhật
   * @throws NotFoundException nếu không tìm thấy
   * @throws BadRequestException nếu request đã được xử lý
   */
  async rejectRequest(requestId: string, reason?: string): Promise<any> {
    const request = await this.getErasureRequest(requestId);

    const validStatuses = ["pending", "reviewing"];
    if (!validStatuses.includes(request.status)) {
      throw new BadRequestException(
        `Không thể từ chối request ở trạng thái '${request.status}'`,
      );
    }

    request.status = "rejected";
    request.metadata = {
      ...request.metadata,
      rejectReason: reason || "",
    };
    request.updatedAt = new Date();

    this.logger.log(`Erasure request đã bị từ chối: ${requestId}`);

    return this.erasureRequestRepo.save(request);
  }

  /**
   * Thực thi xóa dữ liệu.
   *
   * Chuyển trạng thái sang PROCESSING rồi COMPLETED.
   * Trong thực tế, tích hợp với CP47 retention để thực sự xóa dữ liệu.
   *
   * @param requestId - ID yêu cầu
   * @returns ErasureRequest entity đã cập nhật
   * @throws NotFoundException nếu không tìm thấy
   * @throws BadRequestException nếu request chưa được approve
   */
  async processErasure(requestId: string): Promise<any> {
    const request = await this.getErasureRequest(requestId);

    if (request.status !== "approved") {
      throw new BadRequestException(
        `Không thể xử lý request ở trạng thái '${request.status}' (phải là 'approved')`,
      );
    }

    // Chuyển sang đang xử lý
    request.status = "processing";
    request.updatedAt = new Date();
    await this.erasureRequestRepo.save(request);

    this.logger.log(`Đang xử lý erasure: ${requestId} (scope: ${request.scope})`);

{% if use_retention %}
    // Tích hợp với CP47 Retention - thực thi xóa dữ liệu
    // const retentionService = this.retentionService;
    // await retentionService.purgeData(request.userId, request.tenantId, request.scope);

    this.logger.log(`CP47 retention: đã xóa dữ liệu cho user ${request.userId}`);
{% endif %}

    // Đánh dấu hoàn thành
    request.status = "completed";
    request.completedAt = new Date();
    request.updatedAt = request.completedAt;

    this.logger.log(`Erasure đã hoàn thành: ${requestId}`);

    return this.erasureRequestRepo.save(request);
  }

  /**
   * Lấy thống kê erasure requests của tenant.
   *
   * @param tenantId - ID tenant
   * @returns ErasureStats object
   */
  async getErasureStats(tenantId: string): Promise<ErasureStats> {
    const requests = await this.erasureRequestRepo.find({
      where: { tenantId },
    });

    const stats: ErasureStats = {
      total: requests.length,
      pending: 0,
      reviewing: 0,
      approved: 0,
      processing: 0,
      completed: 0,
      rejected: 0,
    };

    for (const req of requests) {
      const statusKey = req.status as keyof Omit<ErasureStats, "total">;
      if (statusKey in stats) {
        stats[statusKey] += 1;
      }
    }

    return stats;
  }
}
