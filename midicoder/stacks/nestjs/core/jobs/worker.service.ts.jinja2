import { Injectable, Inject } from "@nestjs/common";
import { Process, Processor } from "@nestjs/bull";
import { Job } from "bull";

/**
 * Email Worker Service.
 *
 * Process email jobs với tenant context support.
 * 
 * KPI-029: Extract tenant_id từ job data để isolate email operations.
 */
@Processor("email")
@Injectable()
export class EmailWorkerService {
  /**
   * Process welcome email jobs.
   *
   * KPI-029: Support tenant_id trong job data.
   *
   * @param job - Bull job
   * @returns Promise<void>
   */
  @Process("send-welcome-email")
  async processWelcomeEmail(job: Job): Promise<void> {
    const { userId, email, tenant_id } = job.data;
    const tenantContext = tenant_id ? ` [Tenant: ${tenant_id}]` : '';

    try {
      console.log(`Sending welcome email to ${email} (user: ${userId})${tenantContext}`);
      await this.sendEmail(email, "Welcome", "Xin chào!", tenant_id);
    } catch (error) {
      console.error(`Failed to send welcome email${tenantContext}:`, error);
      throw error; // Will retry
    }
  }

  @Process("send-password-reset")
  async processPasswordReset(job: Job): Promise<void> {
    const { userId, email, token, tenant_id } = job.data;
    const tenantContext = tenant_id ? ` [Tenant: ${tenant_id}]` : '';

    try {
      console.log(`Sending password reset to ${email}${tenantContext}`);
      await this.sendEmail(email, "Đặt lại mật khẩu", `Token: ${token}`, tenant_id);
    } catch (error) {
      console.error(`Failed to send password reset${tenantContext}:`, error);
      throw error;
    }
  }

  private async sendEmail(
    to: string, 
    subject: string, 
    body: string,
    tenant_id?: string,  // KPI-029: Tenant context
  ): Promise<void> {
    // TODO: Implement email sending với tenant context
    console.log(`Email: ${to} - ${subject}${tenant_id ? ` (tenant: ${tenant_id})` : ''}`);
  }
}

