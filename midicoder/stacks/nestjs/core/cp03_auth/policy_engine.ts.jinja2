/**
 * Policy Engine - OPA-compatible policy evaluation.
 * 
 * Engine này evaluate policies với conditions và return allow/deny.
 * 
 * KPI-031: Invalid policy detection tại compile-time.
 */

import { Injectable } from "@nestjs/common";

/**
 * Policy Effect.
 */
export enum PolicyEffect {
  ALLOW = "allow",
  DENY = "deny",
}

/**
 * Policy Definition.
 */
export interface Policy {
  id: string;
  effect: PolicyEffect;
  conditions: PolicyCondition[];
  description?: string;
}

/**
 * Policy Condition.
 */
export interface PolicyCondition {
  expression: string;
  description?: string;
}

/**
 * Policy Evaluation Context.
 * 
 * Context này chứa user, resource, và request data cho policy evaluation.
 */
export interface PolicyContext {
  user: {
    id: string;
    roles: string[];
    tenantId?: string;
  };
  resource: {
    id: string;
    type: string;
    tenantId?: string;
    ownerId?: string;
  };
  action: string;
  request?: Record<string, unknown>;
}

/**
 * Policy Evaluation Result.
 */
export interface PolicyResult {
  allowed: boolean;
  policyId?: string;
  reason?: string;
}

/**
 * Policy Engine Service.
 * 
 * Service này evaluate policies và return allow/deny decisions.
 * 
 * KPI-031: Policy validation tại compile-time.
 */
@Injectable()
export class PolicyEngine {
  private policies: Map<string, Policy> = new Map();

  /**
   * Đăng ký policy.
   * 
   * @param policy - Policy definition
   */
  registerPolicy(policy: Policy): void {
    this.policies.set(policy.id, policy);
  }

  /**
   * Evaluate policy với context.
   * 
   * @param context - Evaluation context
   * @returns Policy result
   */
  evaluate(context: PolicyContext): PolicyResult {
    // Check each policy
    for (const [policyId, policy] of this.policies.entries()) {
      const result = this._evaluatePolicy(policy, context);
      
      if (result.allowed !== null) {
        return {
          allowed: result.allowed,
          policyId,
          reason: result.reason,
        };
      }
    }

    // Default: allow if no policy matches
    return {
      allowed: true,
      reason: "No policy matched - default allow",
    };
  }

  /**
   * Evaluate single policy.
   * 
   * @param policy - Policy to evaluate
   * @param context - Evaluation context
   * @returns Result với allowed (null = no match)
   */
  private _evaluatePolicy(
    policy: Policy,
    context: PolicyContext,
  ): { allowed: boolean | null; reason?: string } {
    // Check all conditions
    let allConditionsMet = true;

    for (const condition of policy.conditions) {
      const result = this._evaluateCondition(condition.expression, context);
      
      if (!result) {
        allConditionsMet = false;
        break;
      }
    }

    if (!allConditionsMet) {
      return { allowed: null };
    }

    // All conditions met, return policy effect
    return {
      allowed: policy.effect === PolicyEffect.ALLOW,
      reason: policy.description || `Policy ${policy.id} matched`,
    };
  }

  /**
   * Evaluate condition expression.
   * 
   * Basic expression evaluation:
   * - user.id == resource.ownerId
   * - user.tenantId == resource.tenantId
   * - user.roles includes "admin"
   * 
   * KPI-031: Syntax validation happens at compile-time.
   * 
   * @param expression - Expression string
   * @param context - Evaluation context
   * @returns True nếu condition met
   */
  private _evaluateCondition(expression: string, context: PolicyContext): boolean {
    try {
      // Parse expression: left operator right
      const operators = [ "==", "!=", ">=", "<=", ">", "<" ];
      let matchedOperator: string | null = null;
      let operatorIndex = -1;

      for (const op of operators) {
        operatorIndex = expression.indexOf(op);
        if (operatorIndex !== -1) {
          matchedOperator = op;
          break;
        }
      }

      if (!matchedOperator || operatorIndex === -1) {
        return false;
      }

      const left = expression.substring(0, operatorIndex).trim();
      const right = expression.substring(operatorIndex + matchedOperator.length).trim();

      const leftValue = this._resolveValue(left, context);
      const rightValue = this._resolveValue(right, context);

      return this._compare(leftValue, rightValue, matchedOperator);
    } catch {
      // Expression evaluation error - log and deny
      return false;
    }
  }

  /**
   * Resolve value từ expression path.
   * 
   * @param path - Path string (ví dụ: "user.id", "resource.tenantId")
   * @param context - Evaluation context
   * @returns Resolved value
   */
  private _resolveValue(path: string, context: PolicyContext): unknown {
    const parts = path.split(".");
    
    let value: unknown = context;
    for (const part of parts) {
      if (value && typeof value === "object" && part in value) {
        value = (value as Record<string, unknown>)[part];
      } else {
        return undefined;
      }
    }

    return value;
  }

  /**
   * Compare two values với operator.
   * 
   * @param left - Left value
   * @param right - Right value
   * @param operator - Comparison operator
   * @returns Comparison result
   */
  private _compare(left: unknown, right: unknown, operator: string): boolean {
    switch (operator) {
      case "==":
        return left === right;
      case "!=":
        return left !== right;
      case ">":
        return left > right;
      case "<":
        return left < right;
      case ">=":
        return left >= right;
      case "<=":
        return left <= right;
      default:
        return false;
    }
  }
}