import { Module, Global } from '@nestjs/common';
import { EventBusService } from './event-bus.service';
import { EventPublisherService } from './event-publisher.service';
import { EventSubscriberService } from './event-subscriber.service';

/**
* Event module - Global module cho event bus.
*
* KPI-029: Event module hỗ trợ tenant isolation qua:
* - EventBusService với tenant-specific subscriptions
* - EventPublisherService với tenant_id trong events
* - EventSubscriberService với tenant-based filtering
*
* Import module này vào AppModule để sử dụng event bus trong toàn app.
*/
@Global()
@Module({
providers: [
EventBusService, // KPI-029: Tenant-specific event routing
EventPublisherService, // KPI-029: Publish events với tenant_id
EventSubscriberService, // KPI-029: Tenant-based event filtering
],
exports: [
EventBusService,
EventPublisherService,
EventSubscriberService,
],
})
export class EventModule {}