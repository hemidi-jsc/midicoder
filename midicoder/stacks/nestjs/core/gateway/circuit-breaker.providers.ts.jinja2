/**
 * KPI-029: Tenant-specific circuit breaker factory provider.
 * 
 * Factory này tạo circuit breakers riêng cho mỗi tenant-backend pair.
 */
export const TENANT_CIRCUIT_BREAKER_PROVIDER: Provider = {
  provide: 'TENANT_CIRCUIT_BREAKER',
  useFactory: async (
    configService: ConfigService,
    circuitBreakerFactory: { create: (id: string, action: any) => any },
  ): Promise<{ create: (tenantId: string, backendId: string, action: any) => any }> => {
    return {
      /**
       * Create Tenant Circuit Breaker.
       * 
       * KPI-029: Tạo circuit breaker riêng cho tenant-backend pair.
       * 
       * @param tenantId Tenant ID
       * @param backendId Backend ID
       * @param action Action function
       * @returns Circuit breaker instance
       */
      create: (tenantId: string, backendId: string, action: any): any => {
        const id = `${tenantId}:${backendId}`;
        return circuitBreakerFactory.create(id, action);
      },
    };
  },
  inject: [ConfigService, 'CIRCUIT_BREAKER_FACTORY'],
};

