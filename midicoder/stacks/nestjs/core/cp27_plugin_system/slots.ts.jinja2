 * Generated by Midicoder - BackendNestJSEmitter
 * CP27: Plugin System
 */

/**
 * PluginSlot enum defines all extension points in the application lifecycle.
 *
 * Lifecycle events:
 *  - on_request: Before/after each HTTP request
 *  - on_response: Before/after response is sent
 *  - on_error: When an error occurs
 *  - on_init: Plugin initialization
 *  - on_ready: Plugin ready
 *  - on_shutdown: Plugin shutdown
 *
 * Command hooks are generated from the project's command definitions.
 */
export enum PluginSlot {
  // ==========================================================================
  // Lifecycle Events
  // ==========================================================================
  ON_REQUEST = 'on_request',
  ON_RESPONSE = 'on_response',
  ON_ERROR = 'on_error',
  ON_INIT = 'on_init',
  ON_READY = 'on_ready',
  ON_SHUTDOWN = 'on_shutdown',

  // ==========================================================================
  // Command Hooks (generated from command definitions)
  // ==========================================================================
{% for cmd in commands %}
  BEFORE_{{ cmd.get('id', 'Action').upper() }} = 'before_{{ cmd.get('id', 'action').lower() }}',
  AFTER_{{ cmd.get('id', 'Action').upper() }} = 'after_{{ cmd.get('id', 'action').lower() }}',
{% endfor %}
}

/**
 * All available plugin slots as an array for iteration.
 */
export const ALL_PLUGIN_SLOTS: PluginSlot[] = Object.values(PluginSlot);

/**
 * Plugin Slots DI Token for dependency injection.
 *
 * Use `@Inject(PLUGIN_SLOTS)` to inject the PluginSlot enum into providers.
 */
export const PLUGIN_SLOTS = 'PLUGIN_SLOTS';

/**
 * Type-safe slot ID string for use in plugin manifests and configuration.
 */
export type SlotId = `${PluginSlot}`;

/**
 * PluginSlotMetadata holds runtime information about a specific slot.
 */
export interface PluginSlotMetadata {
  slotId: SlotId;
  description: string;
  isLifecycle: boolean;
  isCommandHook: boolean;
  relatedCommand?: string;
}

/**
 * Get metadata for a given PluginSlot.
 *
 * @param slotId - The slot identifier
 * @returns PluginSlotMetadata object
 */
export function getSlotMetadata(slotId: SlotId): PluginSlotMetadata {
  const lifecycleSlots = [
    PluginSlot.ON_REQUEST,
    PluginSlot.ON_RESPONSE,
    PluginSlot.ON_ERROR,
    PluginSlot.ON_INIT,
    PluginSlot.ON_READY,
    PluginSlot.ON_SHUTDOWN,
  ];

  return {
    slotId,
    description: `Plugin slot: ${slotId}`,
    isLifecycle: lifecycleSlots.includes(slotId as PluginSlot),
    isCommandHook: !lifecycleSlots.includes(slotId as PluginSlot),
    relatedCommand: lifecycleSlots.includes(slotId as PluginSlot)
      ? undefined
      : slotId.replace(/^before_/i, '').replace(/^after_/i, ''),
  };
}
