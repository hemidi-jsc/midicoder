// ============================================================================
// RetentionModule — Module chính
// ============================================================================

/**
* RetentionModule — Module chính cho mô-đun quản lý vòng đời dữ liệu.
*
* Cấu hình toàn bộ module:
*
* TypeORM Entities:
* - RetentionPolicyEntity: Chính sách bảo quản dữ liệu
* - ArchivedRecordEntity: Bản ghi đã lưu trữ
* - ErasureRequestEntity: Yêu cầu xóa dữ liệu (GDPR Article 17)
*
* Controllers:
* - RetentionController: REST endpoints cho CRUD chính sách,
* quản lý lưu trữ, yêu cầu xóa, quét dữ liệu, thống kê
* - RetentionWebhookController: Nhận webhook từ hệ thống bên ngoài
* (xóa tài khoản, rút lại đồng ý, hoàn tất lưu trữ, v.v.)
*
* Providers:
* - RetentionService: Service chính với toàn bộ business logic
* - RetentionScheduler: Tự động quét dữ liệu hết hạn định kỳ
* - RetentionAuditLogger: Ghi nhật ký kiểm toán
* - RetentionEventEmitter: Phát sự kiện nội bộ
*
* Export:
* - RetentionService: Để các module khác có thể inject và sử dụng
* - RetentionAuditLogger: Để các module ghi audit log
* - RetentionEventEmitter: Để các module lắng nghe sự kiện
*
* @Global: Module này được đăng ký toàn cục để các module khác
* có thể sử dụng RetentionService mà không cần import.
*/
@Global()
@Module({
imports: [
TypeOrmModule.forFeature([
RetentionPolicyEntity,
ArchivedRecordEntity,
ErasureRequestEntity,
]),
],
controllers: [
RetentionController,
RetentionWebhookController,
],
providers: [
RetentionService,
RetentionScheduler,
RetentionAuditLogger,
RetentionEventEmitter,
{
provide: RETENTION_CONFIG_TOKEN,
useValue: DEFAULT_RETENTION_CONFIG,
},
],
exports: [
RetentionService,
RetentionAuditLogger,
RetentionEventEmitter,
TypeOrmModule,
RETENTION_CONFIG_TOKEN,
],
})
export class RetentionModule {}
