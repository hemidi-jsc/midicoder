/**
* Key injection token cho cấu hình retention.
*/
export const RETENTION_CONFIG_TOKEN = 'RETENTION_CONFIG_TOKEN';

/**
* Giao diện cấu hình cho module retention.
*/
export interface RetentionConfig {
/** Khoảng thời gian giữa các lần quét (phút) */
scanIntervalMinutes: number;
/** Số lần thử lại tối đa khi lưu trữ */
maxArchiveRetries: number;
/** Số ngày tối đa để xử lý yêu cầu xóa (GDPR) */
erasureDeadlineDays: number;
/** Provider lưu trữ mặc định */
defaultStorageProvider: string;
/** Bật/tắt quét tự động */
autoScanEnabled: boolean;
}

/**
* Cấu hình mặc định cho module retention.
*/
export const DEFAULT_RETENTION_CONFIG: RetentionConfig = {
scanIntervalMinutes: 60,
maxArchiveRetries: 3,
erasureDeadlineDays: 30,
defaultStorageProvider: 's3',
autoScanEnabled: true,
};

// ============================================================================
// RetentionScheduler — Tự động quét và xử lý
// ============================================================================

/**
* RetentionScheduler — Service chạy định kỳ để quét dữ liệu hết hạn.
*
* Sử dụng Node.js setInterval để thực hiện quét tự động
* theo khoảng thời gian cấu hình. Ghi log khi bắt đầu và hoàn tất.
*/
@Injectable()
export class RetentionScheduler implements OnModuleInit {
private intervalId: NodeJS.Timeout | null = null;

constructor(
@Inject(RETENTION_CONFIG_TOKEN) private readonly config: RetentionConfig,
private readonly retentionService: RetentionService,
) {}

/**
* Khởi tạo scheduler khi module được tải.
*/
onModuleInit(): void {
if (this.config.autoScanEnabled) {
this.startAutoScan();
}
}

/**
* Bắt đầu quét tự động theo khoảng thời gian cấu hình.
*/
private startAutoScan(): void {
this.intervalId = setInterval(async () => {
try {
const result = await this.retentionService.scanExpiredData();
// Ghi log tóm tắt kết quả quét
if (result.expiredRecords > 0) {
// Có dữ liệu hết hạn cần xử lý
}
} catch (error) {
// Ghi log lỗi — không để scheduler bị dừng
}
}, this.config.scanIntervalMinutes * 60 * 1000);
}

/**
* Dừng quét tự động.
*/
stopAutoScan(): void {
if (this.intervalId) {
clearInterval(this.intervalId);
this.intervalId = null;
}
}
}

