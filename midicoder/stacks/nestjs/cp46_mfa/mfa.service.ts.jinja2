import { Injectable, BadRequestException, NotFoundException } from '@nestjs/common';
import { MFAEngine, MFAMethod } from 'midicoder/emitters/core/cp46_mfa';
import { MfaEnrollDto, MfaChallengeDto } from './dto/mfa.dto';

@Injectable()
export class MfaService {
  private engine = new MFAEngine();

  async enroll(dto: MfaEnrollDto) {
    const enrollment = this.engine.enroll_totp(
      dto.userId,
      dto.deviceName || '',
      dto.issuer || 'Midicoder',
    );
    return {
      enrollmentId: enrollment.enrollment_id,
      qrCodeData: enrollment.qr_code_data,
      setupSecret: enrollment.setup_secret,
      method: enrollment.method,
      message: 'MFA enrollment created successfully',
    };
  }

  async verifyEnrollment(enrollmentId: string, verificationCode: string) {
    try {
      const credential = this.engine.verify_enrollment(enrollmentId, verificationCode);
      return {
        credentialId: credential.credential_id,
        method: credential.method,
        status: credential.status,
        message: 'MFA enrollment verified successfully',
      };
    } catch (error) {
      throw new BadRequestException('Verification code is invalid');
    }
  }

  async createChallenge(userId: string, method: string) {
    try {
      const challenge = this.engine.create_challenge(userId, MFAMethod[method.toUpperCase()] || MFAMethod.TOTP);
      return {
        sessionId: challenge.session_id,
        challenge: challenge.challenge,
        method,
        expiresIn: 300,
        remainingAttempts: challenge.max_attempts - challenge.attempts,
      };
    } catch (error) {
      throw new NotFoundException('MFA credential not found');
    }
  }

  async verifyChallenge(sessionId: string, otpCode?: string, signature?: string) {
    try {
      const session = this.engine.verify_challenge(sessionId, otpCode || '', signature || '');
      return {
        sessionId: session.session_id,
        isVerified: session.is_verified,
        verifiedAt: session.verified_at?.toISOString(),
        token: `mfa_token_${session.session_id}`,
      };
    } catch (error) {
      throw new BadRequestException('MFA verification failed');
    }
  }

  async getStatus(userId: string) {
    const credentials = this.engine.get_user_credentials(userId);
    const isEnabled = this.engine.is_mfa_enabled(userId);
    return {
      userId,
      isMfaEnabled: isEnabled,
      methods: credentials.map((c) => ({
        credentialId: c.credential_id,
        method: c.method,
        status: c.status,
        priority: c.priority,
      })),
      defaultMethod: '{{ default_method }}',
      requireMfa: {{ "true" if require_mfa else "false" }},
    };
  }

  async disable(credentialId: string) {
    try {
      const credential = this.engine.disable_mfa(credentialId);
      return { credentialId, status: credential.status, message: 'MFA disabled' };
    } catch (error) {
      throw new NotFoundException('Credential not found');
    }
  }

  async revoke(credentialId: string) {
    try {
      const credential = this.engine.revoke_credential(credentialId);
      return { credentialId, status: credential.status, message: 'MFA credential revoked' };
    } catch (error) {
      throw new NotFoundException('Credential not found');
    }
  }
}
