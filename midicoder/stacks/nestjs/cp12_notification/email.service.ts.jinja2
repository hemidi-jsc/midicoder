/**
 * Email Service cho NestJS.
 *
 * Cung cấp:
 * - Send emails qua Nodemailer
 * - Email templates
 * - Bulk emails
 *
 * KPI-029: Tenant Isolation - Support tenant-specific email customization
 * CP12: Notification & Communication
 */

import { Injectable, Inject } from "@nestjs/common";
import { Transporter } from "nodemailer";
import * as fs from "fs";
import * as path from "path";

/**
 * Email Service.
 *
 * KPI-029: Support tenant_id cho tenant-specific email customization.
 */
@Injectable()
export class EmailService {
  /**
   * Constructor.
   *
   * @param transporter - Nodemailer transporter
   * @param tenantId KPI-029: Tenant ID cho tenant-specific operations
   */
  constructor(
    @Inject("EMAIL_SERVICE")
    private readonly transporter: Transporter,
    private readonly tenantId?: string,
  ) {}

  /**
   * Gửi email đơn giản.
   *
   * KPI-029: Support tenant_id cho tenant-specific from email.
   *
   * @param to - Email người nhận
   * @param subject - Tiêu đề
   * @param text - Nội dung text
   * @param html - Nội dung HTML (optional)
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Promise<boolean>
   */
  async sendEmail(
    to: string,
    subject: string,
    text: string,
    html?: string,
    tenantId?: string,
  ): Promise<boolean> {
    try {
      // KPI-029: Get effective tenant ID
      const effectiveTenantId = tenantId || this.tenantId;
      
      // KPI-029: Tenant-specific from email if configured
      const fromEmail = effectiveTenantId 
        ? process.env[`TENANT_${effectiveTenantId}_FROM_EMAIL`] || 
          `noreply-${effectiveTenantId}@example.com` || 
          process.env.DEFAULT_FROM_EMAIL || "noreply@example.com"
        : process.env.DEFAULT_FROM_EMAIL || "noreply@example.com";

      await this.transporter.sendMail({
        from: fromEmail,
        to,
        subject,
        text,
        html,
        // KPI-029: Add tenant header for tracking
        headers: effectiveTenantId ? { "X-Tenant-ID": effectiveTenantId } : {},
      });
      return true;
    } catch (error) {
      console.error("Failed to send email:", error);
      return false;
    }
  }

  /**
   * Gửi email HTML.
   *
   * @param to - Email người nhận
   * @param subject - Tiêu đề
   * @param html - Nội dung HTML
   * @returns Promise<boolean>
   */
  async sendHtmlEmail(to: string, subject: string, html: string): Promise<boolean> {
    return this.sendEmail(to, subject, subject, html);
  }

  /**
   * Gửi email từ template.
   *
   * KPI-029: Support tenant_id cho tenant-specific templates và context.
   *
   * @param to - Email người nhận
   * @param templateName - Tên template
   * @param context - Template context
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Promise<boolean>
   */
  async sendTemplateEmail(
    to: string,
    templateName: string,
    context: Record<string, any>,
    tenantId?: string,
  ): Promise<boolean> {
    try {
      const { render } = require("ejs");
      
      // KPI-029: Get effective tenant ID
      const effectiveTenantId = tenantId || this.tenantId;
      
      // KPI-029: Add tenant_id to context for template rendering
      const contextWithTenant = {
        ...context,
        tenant_id: effectiveTenantId,
      };

      // Read template (KPI-029: support tenant-specific templates)
      let templatePath = path.join(__dirname, "../../../templates/emails", `${templateName}.ejs`);
      if (effectiveTenantId && !fs.existsSync(templatePath)) {
        // KPI-029: Try tenant-specific template first
        const tenantTemplatePath = path.join(__dirname, "../../../templates/emails", `tenant_${effectiveTenantId}_${templateName}.ejs`);
        if (fs.existsSync(tenantTemplatePath)) {
          templatePath = tenantTemplatePath;
        }
      }
      
      const template = fs.readFileSync(templatePath, "utf-8");

      // Render template với tenant context
      const html = render(template, contextWithTenant);

      // Get subject from context or template
      const subject = context.subject || "Thông báo từ ứng dụng";

      return this.sendEmail(to, subject, subject, html, effectiveTenantId);
    } catch (error) {
      console.error("Failed to send template email:", error);
      return false;
    }
  }

  /**
   * Gửi bulk emails.
   *
   * KPI-029: Support tenant_id cho tất cả recipients.
   *
   * @param recipients - List of {email, context}
   * @param templateName - Template name
   * @param tenantId KPI-029: Tenant ID (optional)
   * @returns Promise<{success: number, failed: number}>
   */
  async sendBulkEmails(
    recipients: Array<{ email: string; context: Record<string, any> }>,
    templateName: string,
    tenantId?: string,
  ): Promise<{ success: number; failed: number; errors: string[] }> {
    const results = {
      success: 0,
      failed: 0,
      errors: [] as string[],
    };

    for (const recipient of recipients) {
      const success = await this.sendTemplateEmail(
        recipient.email,
        templateName,
        recipient.context,
        tenantId,  // KPI-029: Pass tenant ID
      );

      if (success) {
        results.success++;
      } else {
        results.failed++;
        results.errors.push(recipient.email);
      }
    }

    return results;
  }

  /**
   * Gửi email với attachments.
   *
   * @param to - Email người nhận
   * @param subject - Tiêu đề
   * @param text - Nội dung text
   * @param attachments - List of attachments
   * @returns Promise<boolean>
   */
  async sendEmailWithAttachments(
    to: string,
    subject: string,
    text: string,
    attachments: Array<{ filename: string; content: Buffer | string; contentType?: string }>,
  ): Promise<boolean> {
    try {
      await this.transporter.sendMail({
        from: process.env.DEFAULT_FROM_EMAIL || "noreply@example.com",
        to,
        subject,
        text,
        attachments: attachments.map((att) => ({
          filename: att.filename,
          content: att.content,
          contentType: att.contentType,
        })),
      });
      return true;
    } catch (error) {
      console.error("Failed to send email with attachments:", error);
      return false;
    }
  }
}