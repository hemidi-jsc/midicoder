import { Injectable, BadRequestException } from '@nestjs/common';
import { createHash, timingSafeEqual } from 'crypto';

// ============================================================================
// Policy Type
// ============================================================================

/**
 * PolicyType enum defines the available security checks for plugins.
 */
export enum PolicyType {
  SIGNATURE_VERIFICATION = 'signature_verification',
  VERSION_GATE = 'version_gate',
  ORIGIN_WHITELIST = 'origin_whitelist',
  RESOURCE_LIMIT = 'resource_limit',
  API_SCOPE = 'api_scope',
}

// ============================================================================
// Plugin Policy
// ============================================================================

/**
 * PluginPolicy defines a single security rule to enforce on plugins.
 */
export class PluginPolicy {
  constructor(
    public readonly type: PolicyType,
    public readonly enabled: boolean = true,
    public readonly parameters: Record<string, any> = {},
  ) {}

  /**
   * Check if this policy applies to the given plugin context.
   *
   * @param pluginId - The plugin identifier
   * @returns true if this policy should be enforced
   */
  appliesTo(pluginId: string): boolean {
    if (!this.enabled) {
      return false;
    }

    const allowedPlugins = this.parameters.allowedPlugins as string[] | undefined;
    const deniedPlugins = this.parameters.deniedPlugins as string[] | undefined;

    if (deniedPlugins?.includes(pluginId)) {
      return false;
    }
    if (allowedPlugins && allowedPlugins.length > 0) {
      return allowedPlugins.includes(pluginId);
    }

    return true;
  }
}

// ============================================================================
// Policy Configuration
// ============================================================================

/**
 * PolicyConfig holds all policy settings for the plugin system.
 */
export interface PolicyConfig {
  /** Required signing algorithm for signature verification */
  signatureAlgorithm?: string;

  /** Public key or secret for signature verification */
  signatureSecret?: string;

  /** Minimum midicoder version required */
  minMidicoderVersion?: string;

  /** Maximum midicoder version allowed */
  maxMidicoderVersion?: string;

  /** Allowed plugin origins (npm registry URLs, local paths) */
  allowedOrigins?: string[];

  /** Maximum allowed plugin bundle size in bytes */
  maxBundleSize?: number;

  /** Allowed API scopes a plugin can access */
  allowedApiScopes?: string[];
}

// ============================================================================
// Policy Validator Service
// ============================================================================

/**
 * PolicyValidator enforces security policies on plugin loading and execution.
 *
 * @Injectable() singleton that runs policy checks during plugin lifecycle.
 */
@Injectable()
export class PolicyValidator {
  private policies: Map<PolicyType, PluginPolicy> = new Map();

  /**
   * Initialize the PolicyValidator with configuration.
   *
   * @param config - Policy configuration from application settings
   */
  public init(config: PolicyConfig): void {
    if (config.signatureSecret) {
      this.policies.set(PolicyType.SIGNATURE_VERIFICATION, new PluginPolicy(PolicyType.SIGNATURE_VERIFICATION, true, {
        algorithm: config.signatureAlgorithm ?? 'sha256',
        secret: config.signatureSecret,
      }));
    }

    if (config.minMidicoderVersion || config.maxMidicoderVersion) {
      this.policies.set(PolicyType.VERSION_GATE, new PluginPolicy(PolicyType.VERSION_GATE, true, {
        min: config.minMidicoderVersion,
        max: config.maxMidicoderVersion,
      }));
    }

    if (config.allowedOrigins) {
      this.policies.set(PolicyType.ORIGIN_WHITELIST, new PluginPolicy(PolicyType.ORIGIN_WHITELIST, true, {
        origins: config.allowedOrigins,
      }));
    }

    if (config.maxBundleSize) {
      this.policies.set(PolicyType.RESOURCE_LIMIT, new PluginPolicy(PolicyType.RESOURCE_LIMIT, true, {
        maxBundleSize: config.maxBundleSize,
      }));
    }

    if (config.allowedApiScopes) {
      this.policies.set(PolicyType.API_SCOPE, new PluginPolicy(PolicyType.API_SCOPE, true, {
        scopes: config.allowedApiScopes,
      }));
    }
  }

  /**
   * Verify the cryptographic signature of a plugin manifest.
   *
   * Uses timing-safe comparison to prevent timing attacks.
   *
   * @param manifestContent - Raw JSON content of the plugin manifest
   * @param signature - The signature string from the manifest
   * @returns true if signature is valid
   * @throws BadRequestException if signature is invalid
   */
  public signature_verification(manifestContent: string, signature: string): boolean {
    const policy = this.policies.get(PolicyType.SIGNATURE_VERIFICATION);
    if (!policy || !policy.enabled) {
      return true; // Policy not enabled, skip check
    }

    const params = policy.parameters;
    const secret = params.secret as string;
    const algorithm = params.algorithm as string;

    const expectedHash = createHash(algorithm)
      .update(manifestContent)
      .digest('hex');

    const expectedBuffer = Buffer.from(expectedHash, 'utf8');
    const providedBuffer = Buffer.from(signature, 'utf8');

    if (expectedBuffer.length !== providedBuffer.length) {
      throw new BadRequestException('Plugin signature length mismatch');
    }

    if (!timingSafeEqual(expectedBuffer, providedBuffer)) {
      throw new BadRequestException('Plugin signature verification failed');
    }

    return true;
  }

  /**
   * Check if the plugin's required midicoder version is compatible.
   *
   * @param pluginVersion - The minMidicoderVersion required by the plugin
   * @param currentVersion - The current midicoder version
   * @returns true if version is compatible
   * @throws BadRequestException if version is incompatible
   */
  public version_gate(pluginVersion: string, currentVersion: string): boolean {
    const policy = this.policies.get(PolicyType.VERSION_GATE);
    if (!policy || !policy.enabled) {
      return true; // Policy not enabled, skip check
    }

    const params = policy.parameters;
    const minVersion = params.min as string | undefined;
    const maxVersion = params.max as string | undefined;

    if (minVersion && this.compareVersions(currentVersion, minVersion) < 0) {
      throw new BadRequestException(
        `Plugin requires midicoder >= ${minVersion}, current version is ${currentVersion}`,
      );
    }

    if (maxVersion && this.compareVersions(currentVersion, maxVersion) > 0) {
      throw new BadRequestException(
        `Plugin requires midicoder <= ${maxVersion}, current version is ${currentVersion}`,
      );
    }

    return true;
  }

  /**
   * Verify that the plugin originates from an approved source.
   *
   * @param origin - The source URL or path of the plugin
   * @returns true if origin is allowed
   * @throws BadRequestException if origin is not whitelisted
   */
  public origin_whitelist(origin: string): boolean {
    const policy = this.policies.get(PolicyType.ORIGIN_WHITELIST);
    if (!policy || !policy.enabled) {
      return true; // Policy not enabled, skip check
    }

    const origins = policy.parameters.origins as string[];

    if (!origins.includes(origin)) {
      throw new BadRequestException(
        `Plugin origin '${origin}' is not in the allowed origins whitelist`,
      );
    }

    return true;
  }

  /**
   * Check plugin bundle size against resource limits.
   *
   * @param bundleSize - Size of the plugin bundle in bytes
   * @returns true if within limits
   * @throws BadRequestException if bundle exceeds max size
   */
  public checkResourceLimit(bundleSize: number): boolean {
    const policy = this.policies.get(PolicyType.RESOURCE_LIMIT);
    if (!policy || !policy.enabled) {
      return true; // Policy not enabled, skip check
    }

    const maxBundleSize = policy.parameters.maxBundleSize as number;
    if (bundleSize > maxBundleSize) {
      throw new BadRequestException(
        `Plugin bundle size ${bundleSize} exceeds maximum allowed ${maxBundleSize} bytes`,
      );
    }

    return true;
  }

  /**
   * Validate that the plugin only requests allowed API scopes.
   *
   * @param requestedScopes - API scopes requested by the plugin
   * @returns true if all scopes are allowed
   * @throws BadRequestException if any scope is denied
   */
  public checkApiScope(requestedScopes: string[]): boolean {
    const policy = this.policies.get(PolicyType.API_SCOPE);
    if (!policy || !policy.enabled) {
      return true; // Policy not enabled, skip check
    }

    const allowedScopes = policy.parameters.scopes as string[];

    for (const scope of requestedScopes) {
      if (!allowedScopes.includes(scope)) {
        throw new BadRequestException(
          `Plugin requests denied API scope: '${scope}'`,
        );
      }
    }

    return true;
  }

  /**
   * Run all applicable policies for a plugin.
   *
   * @param pluginId - Plugin identifier
   * @param manifestContent - Raw manifest JSON content
   * @param origin - Plugin origin URL or path
   * @param signature - Cryptographic signature
   * @param bundleSize - Plugin bundle size in bytes
   * @param requestedScopes - API scopes the plugin needs
   */
  public validateAll(
    pluginId: string,
    manifestContent: string,
    origin: string,
    signature?: string,
    bundleSize?: number,
    requestedScopes?: string[],
  ): void {
    // Run all enabled policies that apply to this plugin
    for (const [type, policy] of this.policies) {
      if (!policy.appliesTo(pluginId)) {
        continue;
      }

      switch (type) {
        case PolicyType.SIGNATURE_VERIFICATION:
          if (signature) {
            this.signature_verification(manifestContent, signature);
          }
          break;
        case PolicyType.ORIGIN_WHITELIST:
          this.origin_whitelist(origin);
          break;
        case PolicyType.RESOURCE_LIMIT:
          if (bundleSize !== undefined) {
            this.checkResourceLimit(bundleSize);
          }
          break;
        case PolicyType.API_SCOPE:
          if (requestedScopes) {
            this.checkApiScope(requestedScopes);
          }
          break;
        case PolicyType.VERSION_GATE:
          // Handled in plugin-loader with version context
          break;
      }
    }
  }

  /**
   * Compare two semver-style version strings.
   *
   * @param a - First version string
   * @param b - Second version string
   * @returns Negative if a < b, 0 if equal, positive if a > b
   */
  private compareVersions(a: string, b: string): number {
    const partsA = a.split('.').map(Number);
    const partsB = b.split('.').map(Number);
    const maxLength = Math.max(partsA.length, partsB.length);

    for (let i = 0; i < maxLength; i++) {
      const partA = i < partsA.length ? partsA[i] : 0;
      const partB = i < partsB.length ? partsB[i] : 0;
      if (partA < partB) return -1;
      if (partA > partB) return 1;
    }

    return 0;
  }
}
