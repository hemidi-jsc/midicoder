// ============================================================================
// Plugin Status
// ============================================================================

/**
 * PluginStatus enum tracks the lifecycle state of each plugin.
 */
export enum PluginStatus {
  INACTIVE = 'inactive',
  LOADING = 'loading',
  ENABLED = 'enabled',
  DISABLED = 'disabled',
  ERROR = 'error',
}

// ============================================================================
// Plugin Context
// ============================================================================

/**
 * PluginContext provides runtime information and services to plugins.
 *
 * Each plugin receives a PluginContext instance during initialization,
 * which grants access to application services, configuration, and logging.
 */
export class PluginContext {
  constructor(
    public readonly appName: string,
    public readonly appVersion: string,
    public readonly logger: {
      log: (message: string) => void;
      warn: (message: string) => void;
      error: (message: string) => void;
      debug: (message: string) => void;
    },
    public readonly config: Record<string, any>,
    public readonly services: Record<string, any>,
  ) {}

  /**
   * Log a message through the application logger.
   */
  log(message: string): void {
    this.logger.log(`[${this.appName}] ${message}`);
  }

  /**
   * Log a warning through the application logger.
   */
  warn(message: string): void {
    this.logger.warn(`[${this.appName}] ${message}`);
  }

  /**
   * Log an error through the application logger.
   */
  error(message: string): void {
    this.logger.error(`[${this.appName}] ${message}`);
  }

  /**
   * Access a service by name from the container.
   *
   * @param serviceName - The name of the service to retrieve
   * @returns The service instance or undefined
   */
  getService<T = any>(serviceName: string): T | undefined {
    return this.services[serviceName] as T | undefined;
  }

  /**
   * Get a configuration value by key.
   *
   * @param key - The configuration key
   * @param defaultValue - Default value if key is not found
   * @returns The configuration value or default
   */
  getConfig<T = any>(key: string, defaultValue?: T): T {
    return this.config[key] !== undefined ? this.config[key] : defaultValue;
  }
}

// ============================================================================
// IPlugin Interface
// ============================================================================

/**
 * IPlugin defines the contract that all plugins must implement.
 *
 * A plugin is a reusable module that can hook into the application
 * lifecycle through PluginSlots. Plugins are loaded at runtime and
 * can be enabled/disabled without restarting the application.
 */
export interface IPlugin {
  /** Unique plugin identifier (e.g., 'logging', 'analytics') */
  readonly id: string;

  /** Human-readable plugin name */
  readonly name: string;

  /** Semantic version string (e.g., '1.0.0') */
  readonly version: string;

  /** Array of slot IDs this plugin hooks into */
  readonly slots: SlotId[];

  /**
   * Called when the plugin is first loaded into the registry.
   * Use this to initialize internal state or validate configuration.
   *
   * @param context - PluginContext with runtime services
   */
  onInit(context: PluginContext): Promise<void>;

  /**
   * Called when plugin-specific configuration is applied or updated.
   *
   * @param context - PluginContext with runtime services
   * @param config - Plugin-specific configuration object
   */
  onConfigure?(context: PluginContext, config: Record<string, any>): Promise<void>;

  /**
   * Called when the plugin is fully initialized and ready to handle events.
   * This is the ideal place to register event listeners or start background tasks.
   *
   * @param context - PluginContext with runtime services
   */
  onReady(context: PluginContext): Promise<void>;

  /**
   * Called when the application is shutting down.
   * Use this to release resources, flush buffers, or persist state.
   *
   * @param context - PluginContext with runtime services
   */
  onShutdown(context: PluginContext): Promise<void>;

  /**
   * Called when a plugin slot is triggered.
   *
   * @param slotId - The slot that was triggered
   * @param payload - Data associated with the slot event
   * @param context - PluginContext with runtime services
   */
  onSlotTrigger?(
    slotId: SlotId,
    payload: Record<string, any>,
    context: PluginContext,
  ): Promise<void>;
}

