/**
 * Plugin Loader - Discovers, validates, and loads plugins at runtime.
 *
 * Generated by Midicoder - BackendNestJSEmitter
 * CP27: Plugin System
 */

import { Injectable, Logger, OnModuleInit, OnModuleDestroy } from '@nestjs/common';
import { Inject } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';
import * as util from 'util';

import { PluginManifest, IPlugin, PluginStatus } from './contracts';
import { PluginRegistryService } from './plugin-registry.service';
import { PolicyValidator } from './policies';

const stat = util.promisify(fs.stat);
const readdir = util.promisify(fs.readdir);
const readFile = util.promisify(fs.readFile);

/**
 * PluginLoader discovers plugin directories, validates manifests,
 * and dynamically imports plugin modules.
 *
 * @Injectable() service that runs during application bootstrap.
 */
@Injectable()
export class PluginLoader implements OnModuleInit, OnModuleDestroy {
  private readonly logger = new Logger(PluginLoader.name);

  constructor(
    @Inject('PLUGIN_PATH') private readonly pluginPath: string,
    private readonly registry: PluginRegistryService,
    private readonly policyValidator: PolicyValidator,
  ) {}

  /**
   * Lifecycle hook - discover and load all plugins on module initialization.
   */
  async onModuleInit(): Promise<void> {
    this.logger.log('Initializing PluginLoader...');
    const plugins = await this.discoverPlugins(this.pluginPath);

    for (const manifest of plugins) {
      try {
        await this.loadPlugin(manifest);
        this.logger.log(`Plugin "${manifest.id}" loaded successfully`);
      } catch (error) {
        this.logger.error(`Failed to load plugin "${manifest.id}": ${error.message}`);
      }
    }

    this.logger.log(`PluginLoader initialized. ${plugins.length} plugins discovered.`);
  }

  /**
   * Lifecycle hook - unload all plugins on module destruction.
   */
  async onModuleDestroy(): Promise<void> {
    this.logger.log('Shutting down PluginLoader...');
    const allPlugins = this.registry.getAll();

    for (const plugin of allPlugins) {
      try {
        await this.unloadPlugin(plugin.id);
      } catch (error) {
        this.logger.error(`Error unloading plugin "${plugin.id}": ${error.message}`);
      }
    }

    this.logger.log('PluginLoader shutdown complete.');
  }

  /**
   * Discover all valid plugin directories under the given path.
   *
   * Each plugin directory must contain a valid plugin.json manifest.
   *
   * @param searchPath - Absolute or relative path to scan for plugins
   * @returns Array of PluginManifest objects
   */
  async discoverPlugins(searchPath: string): Promise<PluginManifest[]> {
    const absolutePath = path.resolve(searchPath);

    if (!fs.existsSync(absolutePath)) {
      this.logger.warn(`Plugin directory does not exist: ${absolutePath}`);
      return [];
    }

    const manifests: PluginManifest[] = [];
    const entries = await readdir(absolutePath, { withFileTypes: true });

    for (const entry of entries) {
      if (!entry.isDirectory()) {
        continue;
      }

      const pluginDir = path.join(absolutePath, entry.name);
      const manifestPath = path.join(pluginDir, 'plugin.json');

      if (!fs.existsSync(manifestPath)) {
        this.logger.debug(`Skipping "${entry.name}": no plugin.json found`);
        continue;
      }

      try {
        const manifestContent = await readFile(manifestPath, 'utf-8');
        const manifest = JSON.parse(manifestContent) as PluginManifest;

        if (!manifest.id || !manifest.entryPoint) {
          this.logger.warn(`Skipping "${entry.name}": manifest missing required fields`);
          continue;
        }

        // Resolve the entry point relative to the plugin directory
        manifest.entryPoint = path.resolve(pluginDir, manifest.entryPoint);

        manifests.push(manifest);
      } catch (error) {
        this.logger.error(`Failed to parse manifest in "${entry.name}": ${error.message}`);
      }
    }

    return manifests;
  }

  /**
   * Validate a plugin manifest against all policy rules.
   *
   * Checks include: required fields, version compatibility,
   * origin whitelist, and signature verification.
   *
   * @param manifest - The PluginManifest to validate
   * @returns true if validation passes
   * @throws Error if any policy check fails
   */
  async validatePlugin(manifest: PluginManifest): Promise<boolean> {
    // Check required fields
    const requiredFields: (keyof PluginManifest)[] = ['id', 'name', 'version', 'entryPoint'];
    for (const field of requiredFields) {
      if (!manifest[field]) {
        throw new Error(`Plugin manifest missing required field: ${field}`);
      }
    }

    // Check entry point exists
    if (!fs.existsSync(manifest.entryPoint)) {
      throw new Error(`Plugin entry point not found: ${manifest.entryPoint}`);
    }

    // Run policy validator
    const manifestContent = JSON.stringify(manifest);
    this.policyValidator.validateAll(
      manifest.id,
      manifestContent,
      manifest.entryPoint,
      manifest.signature,
      undefined, // bundle size can be computed from fs if needed
      undefined, // API scopes can be added to manifest if needed
    );

    // Version gate check
    if (manifest.minMidicoderVersion) {
      const currentVersion = process.env.MIDICODER_VERSION ?? '0.0.0';
      this.policyValidator.version_gate(manifest.minMidicoderVersion, currentVersion);
    }

    return true;
  }

  /**
   * Load a plugin from its manifest using dynamic import().
   *
   * The plugin class is instantiated, registered in the PluginRegistry,
   * and the onInit lifecycle method is called.
   *
   * @param manifest - The validated PluginManifest
   * @returns The loaded IPlugin instance
   */
  async loadPlugin(manifest: PluginManifest): Promise<IPlugin> {
    // Validate before loading
    await this.validatePlugin(manifest);

    // Mark as loading
    this.registry.markLoading(manifest.id);

    try {
      // Dynamic import of the plugin module
      const pluginModule = await import(manifest.entryPoint);

      // Expect the default export to be the plugin class
      const PluginClass = pluginModule.default || pluginModule[manifest.id.charAt(0).toUpperCase() + manifest.id.slice(1)];

      if (!PluginClass) {
        throw new Error(`No valid export found in plugin entry point: ${manifest.entryPoint}`);
      }

      // Instantiate the plugin
      const pluginInstance = new PluginClass();

      // Verify the instance implements IPlugin
      if (!pluginInstance.onInit || !pluginInstance.onReady || !pluginInstance.onShutdown) {
        throw new Error(`Plugin "${manifest.id}" does not implement the IPlugin interface`);
      }

      // Register in the registry
      this.registry.register(pluginInstance);

      this.logger.log(`Plugin "${manifest.id}" v${manifest.version} registered successfully`);

      return pluginInstance;
    } catch (error) {
      this.registry.markError(manifest.id, error.message);
      throw error;
    }
  }

  /**
   * Unload a plugin by invoking its onShutdown lifecycle and removing from registry.
   *
   * @param pluginId - The unique identifier of the plugin to unload
   */
  async unloadPlugin(pluginId: string): Promise<void> {
    const plugin = this.registry.get(pluginId);

    if (!plugin) {
      this.logger.warn(`Cannot unload plugin "${pluginId}": not found in registry`);
      return;
    }

    try {
      // PluginContext will be passed by the manager; here we pass a minimal one
      await plugin.onShutdown({
        appName: 'midicoder',
        appVersion: '0.0.0',
        logger: this.logger,
        config: {},
        services: {},
      } as any);
    } catch (error) {
      this.logger.error(`Error during shutdown of plugin "${pluginId}": ${error.message}`);
    }

    this.registry.unregister(pluginId);
    this.logger.log(`Plugin "${pluginId}" unloaded.`);
  }
}
