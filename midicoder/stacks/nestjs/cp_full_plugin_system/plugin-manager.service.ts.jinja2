/**
 * Plugin Manager Service - Lifecycle management for registered plugins.
 *
 * Generated by Midicoder - BackendNestJSEmitter
 * CP27: Plugin System
 */

import { Injectable, Logger, NotFoundException, BadRequestException } from '@nestjs/common';

import { IPlugin, PluginContext, PluginStatus, PluginInfo, PluginListResponse, PluginStatusResponse } from './contracts';
import { PluginRegistryService } from './plugin-registry.service';
import { SlotId, ALL_PLUGIN_SLOTS } from './slots';

/**
 * PluginManagerService handles the operational lifecycle of plugins:
 * enabling, disabling, configuring, and querying plugin state.
 *
 * @Injectable() singleton that coordinates with PluginRegistryService.
 */
@Injectable()
export class PluginManagerService {
  private readonly logger = new Logger(PluginManagerService.name);
  private readonly configMap: Map<string, Record<string, any>> = new Map();

  constructor(
    private readonly registry: PluginRegistryService,
  ) {}

  /**
   * Create a PluginContext for use by plugins.
   *
   * @param appName - Application name
   * @param appVersion - Application version
   * @param services - Optional service map for plugin access
   * @returns PluginContext instance
   */
  private createContext(
    appName: string = 'midicoder',
    appVersion: string = '0.0.0',
    services: Record<string, any> = {},
  ): PluginContext {
    return new PluginContext(
      appName,
      appVersion,
      this.logger,
      {},
      services,
    );
  }

  /**
   * Enable a plugin by ID and call its onReady lifecycle hook.
   *
   * @param id - Plugin identifier
   * @throws NotFoundException if plugin is not registered
   */
  async enablePlugin(id: string): Promise<void> {
    const plugin = this.registry.get(id);
    if (!plugin) {
      throw new NotFoundException(`Plugin "${id}" not found`);
    }

    const currentStatus = this.registry.getStatus(id);
    if (currentStatus === PluginStatus.ENABLED) {
      this.logger.debug(`Plugin "${id}" is already enabled`);
      return;
    }

    try {
      this.registry.enable(id);

      const context = this.createContext();
      await plugin.onReady(context);

      this.logger.log(`Plugin "${id}" enabled and ready.`);
    } catch (error) {
      this.registry.markError(id, error.message);
      this.logger.error(`Failed to enable plugin "${id}": ${error.message}`);
      throw new BadRequestException(`Plugin "${id}" failed to start: ${error.message}`);
    }
  }

  /**
   * Disable a plugin by ID and call its onShutdown lifecycle hook.
   *
   * @param id - Plugin identifier
   * @throws NotFoundException if plugin is not registered
   */
  async disablePlugin(id: string): Promise<void> {
    const plugin = this.registry.get(id);
    if (!plugin) {
      throw new NotFoundException(`Plugin "${id}" not found`);
    }

    const currentStatus = this.registry.getStatus(id);
    if (currentStatus === PluginStatus.DISABLED) {
      this.logger.debug(`Plugin "${id}" is already disabled`);
      return;
    }

    try {
      const context = this.createContext();
      await plugin.onShutdown(context);

      this.registry.disable(id);
      this.logger.log(`Plugin "${id}" disabled.`);
    } catch (error) {
      this.logger.error(`Error during shutdown of plugin "${id}": ${error.message}`);
      // Still disable even if shutdown fails
      this.registry.disable(id);
    }
  }

  /**
   * Configure a plugin with runtime settings.
   *
   * Calls the plugin's onConfigure hook if implemented.
   *
   * @param id - Plugin identifier
   * @param config - Configuration key-value pairs
   * @throws NotFoundException if plugin is not registered
   */
  async configurePlugin(id: string, config: Record<string, any>): Promise<void> {
    const plugin = this.registry.get(id);
    if (!plugin) {
      throw new NotFoundException(`Plugin "${id}" not found`);
    }

    // Merge with existing config
    const existingConfig = this.configMap.get(id) ?? {};
    const mergedConfig = { ...existingConfig, ...config };
    this.configMap.set(id, mergedConfig);

    // Call onConfigure if the plugin supports it
    if (plugin.onConfigure) {
      try {
        const context = this.createContext();
        await plugin.onConfigure(context, mergedConfig);
        this.logger.log(`Plugin "${id}" configured successfully.`);
      } catch (error) {
        this.logger.error(`Failed to configure plugin "${id}": ${error.message}`);
        throw new BadRequestException(`Plugin "${id}" configuration failed: ${error.message}`);
      }
    } else {
      this.logger.debug(`Plugin "${id}" does not support onConfigure; config stored.`);
    }
  }

  /**
   * Get the current status of a plugin.
   *
   * @param id - Plugin identifier
   * @returns PluginStatusResponse with status details
   * @throws NotFoundException if plugin is not registered
   */
  getStatus(id: string): PluginStatusResponse {
    const plugin = this.registry.get(id);
    if (!plugin) {
      throw new NotFoundException(`Plugin "${id}" not found`);
    }

    const status = this.registry.getStatus(id);
    if (!status) {
      throw new NotFoundException(`Plugin "${id}" has no status record`);
    }

    return {
      id: plugin.id,
      name: plugin.name,
      status,
      enabled: this.registry.isEnabled(id),
      slots: plugin.slots,
      loadedAt: this.registry.getLoadedAt(id),
      lastError: this.registry.getError(id),
    };
  }

  /**
   * List all registered plugins with their status and configuration.
   *
   * @returns PluginListResponse with aggregate counts and plugin details
   */
  listPlugins(): PluginListResponse {
    const allInfo = this.registry.getAllInfo();

    const enabled = allInfo.filter((p) => p.enabled).length;
    const disabled = allInfo.length - enabled;

    return {
      total: allInfo.length,
      enabled,
      disabled,
      plugins: allInfo,
    };
  }

  /**
   * Get the stored configuration for a plugin.
   *
   * @param id - Plugin identifier
   * @returns Configuration object or empty object if not configured
   */
  getPluginConfig(id: string): Record<string, any> {
    return this.configMap.get(id) ?? {};
  }

  /**
   * Trigger a slot event to all enabled plugins registered for that slot.
   *
   * Each plugin is invoked with error isolation — a failure in one plugin
   * does not prevent other plugins from handling the event.
   *
   * @param slotId - The slot identifier to trigger
   * @param payload - Data to pass to each plugin's onSlotTrigger handler
   */
  async triggerSlot(slotId: SlotId, payload: Record<string, any> = {}): Promise<void> {
    const plugins = this.registry.getBySlot(slotId);

    if (!plugins.length) {
      this.logger.debug(`No plugins registered for slot "${slotId}"`);
      return;
    }

    this.logger.debug(`Triggering slot "${slotId}" for ${plugins.length} plugin(s)`);

    const context = this.createContext();

    for (const plugin of plugins) {
      // Skip disabled plugins
      if (!this.registry.isEnabled(plugin.id)) {
        continue;
      }

      // Merge plugin config into payload
      const mergedPayload = {
        ...payload,
        _config: this.getPluginConfig(plugin.id),
      };

      // Error isolation: each plugin runs in its own try/catch
      try {
        if (plugin.onSlotTrigger) {
          await plugin.onSlotTrigger(slotId, mergedPayload, context);
        }
      } catch (error) {
        this.logger.error(
          `Plugin "${plugin.id}" failed to handle slot "${slotId}": ${error.message}`,
        );
        // Do not propagate — continue to next plugin
      }
    }
  }

  /**
   * Initialize all enabled plugins on application startup.
   *
   * Calls onInit followed by onReady for each enabled plugin.
   */
  async initializeAll(): Promise<void> {
    const plugins = this.registry.getAll();
    this.logger.log(`Initializing ${plugins.length} plugin(s)...`);

    const context = this.createContext();

    for (const plugin of plugins) {
      if (!this.registry.isEnabled(plugin.id)) {
        this.logger.debug(`Skipping disabled plugin "${plugin.id}"`);
        continue;
      }

      try {
        await plugin.onInit(context);
        await plugin.onReady(context);
        this.logger.log(`Plugin "${plugin.id}" initialized and ready.`);
      } catch (error) {
        this.registry.markError(plugin.id, error.message);
        this.logger.error(`Failed to initialize plugin "${plugin.id}": ${error.message}`);
      }
    }
  }

  /**
   * Shutdown all enabled plugins on application shutdown.
   */
  async shutdownAll(): Promise<void> {
    const plugins = this.registry.getAll();
    this.logger.log(`Shutting down ${plugins.length} plugin(s)...`);

    const context = this.createContext();

    for (const plugin of plugins) {
      if (!this.registry.isEnabled(plugin.id)) {
        continue;
      }

      try {
        await plugin.onShutdown(context);
      } catch (error) {
        this.logger.error(`Error shutting down plugin "${plugin.id}": ${error.message}`);
      }
    }
  }
}
