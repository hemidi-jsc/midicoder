import { Injectable, Logger } from '@nestjs/common';

import { IPlugin, PluginContext } from './contracts';
import { PluginSlot, SlotId } from './slots';

/**
 * ExamplePlugin implements the full IPlugin interface to demonstrate
 * how plugins integrate with the application lifecycle.
 *
 * This plugin hooks into:
 *  - ON_REQUEST: Logs every incoming request
 *  - ON_RESPONSE: Logs response timing
 *  - ON_ERROR: Captures error details
 *
 * @Injectable() so it can be injected by NestJS DI if needed.
 */
@Injectable()
export class ExamplePlugin implements IPlugin {
  readonly id: string = 'example-logger';
  readonly name: string = 'Example Logger Plugin';
  readonly version: string = '1.0.0';
  readonly slots: SlotId[] = [
    PluginSlot.ON_REQUEST,
    PluginSlot.ON_RESPONSE,
    PluginSlot.ON_ERROR,
  ];

  private readonly logger: Logger;
  private initialized: boolean = false;
  private requestCount: number = 0;
  private customConfig: Record<string, any> = {};

  constructor() {
    this.logger = new Logger(ExamplePlugin.name);
  }

  /**
   * Called when the plugin is first loaded into the registry.
   *
   * Use this to initialize internal state or validate prerequisites.
   *
   * @param context - PluginContext with runtime services and logging
   */
  async onInit(context: PluginContext): Promise<void> {
    this.logger.log(`Plugin "${this.id}" initializing...`);
    this.initialized = true;
    this.requestCount = 0;

    // Access application config from context
    const env = context.getConfig<string>('NODE_ENV', 'development');
    this.logger.log(`Running in environment: ${env}`);
  }

  /**
   * Called when plugin-specific configuration is applied or updated.
   *
   * @param context - PluginContext with runtime services
   * @param config - Plugin-specific configuration object
   */
  async onConfigure(context: PluginContext, config: Record<string, any>): Promise<void> {
    this.customConfig = { ...this.customConfig, ...config };
    this.logger.log(`Plugin "${this.id}" configured:`, this.customConfig);
  }

  /**
   * Called when the plugin is fully initialized and ready to handle events.
   *
   * Ideal for registering event listeners or starting background tasks.
   *
   * @param context - PluginContext with runtime services
   */
  async onReady(context: PluginContext): Promise<void> {
    this.logger.log(`Plugin "${this.id}" is ready. Slots: ${this.slots.join(', ')}`);
    this.logger.log(`Total request count will start at: ${this.requestCount}`);
  }

  /**
   * Called when the application is shutting down.
   *
   * Use this to release resources, flush buffers, or persist state.
   *
   * @param context - PluginContext with runtime services
   */
  async onShutdown(context: PluginContext): Promise<void> {
    this.logger.log(`Plugin "${this.id}" shutting down. Total requests handled: ${this.requestCount}`);
    this.initialized = false;
  }

  /**
   * Called when a plugin slot is triggered.
   *
   * Handles ON_REQUEST, ON_RESPONSE, and ON_ERROR lifecycle events.
   *
   * @param slotId - The slot that was triggered
   * @param payload - Data associated with the slot event
   * @param context - PluginContext with runtime services
   */
  async onSlotTrigger(
    slotId: SlotId,
    payload: Record<string, any>,
    context: PluginContext,
  ): Promise<void> {
    switch (slotId) {
      case PluginSlot.ON_REQUEST:
        this.requestCount++;
        this.logger.log(
          `[${this.requestCount}] ${payload.method} ${payload.url} — started at ${payload.startTime}`,
        );
        break;

      case PluginSlot.ON_RESPONSE:
        this.logger.log(
          `${payload.method} ${payload.url} — completed with status ${payload.statusCode} in ${payload.duration}ms`,
        );
        break;

      case PluginSlot.ON_ERROR:
        this.logger.error(
          `Error on ${payload.method} ${payload.url}: ${payload.error}`,
        );
        break;

      default:
        this.logger.debug(`Unhandled slot "${slotId}" for plugin "${this.id}"`);
    }
  }
}

// Default export for dynamic import() in PluginLoader
export default ExamplePlugin;
