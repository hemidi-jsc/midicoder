import {
  Controller,
  Get,
  Post,
  Body,
  Param,
  HttpCode,
  HttpStatus,
} from '@nestjs/common';

import { PluginManagerService } from './plugin-manager.service';
import { PluginRegistryService } from './plugin-registry.service';
import { ConfigurePluginDto, PluginInfo, PluginListResponse, PluginStatusResponse } from './contracts';
import { SlotId, PluginSlot, ALL_PLUGIN_SLOTS, PluginSlotMetadata, getSlotMetadata } from './slots';

/**
 * PluginController exposes REST endpoints for runtime plugin management.
 *
 * Base route: /api/plugins
 */
@Controller('api/plugins')
export class PluginController {
  constructor(
    private readonly pluginManager: PluginManagerService,
    private readonly pluginRegistry: PluginRegistryService,
  ) {}

  /**
   * List all registered plugins with summary counts.
   *
   * GET /api/plugins
   *
   * @returns PluginListResponse with total, enabled, disabled counts and plugin array
   */
  @Get()
  list(): PluginListResponse {
    return this.pluginManager.listPlugins();
  }

  /**
   * Get detailed information about a single plugin.
   *
   * GET /api/plugins/:id
   *
   * @param id - Plugin identifier
   * @returns PluginInfo for the requested plugin
   */
  @Get(':id')
  getById(@Param('id') id: string): PluginInfo {
    return this.pluginRegistry.getInfo(id);
  }

  /**
   * Enable a plugin by ID.
   *
   * POST /api/plugins/:id/enable
   *
   * @param id - Plugin identifier
   * @returns Status confirmation
   */
  @Post(':id/enable')
  @HttpCode(HttpStatus.OK)
  async enable(@Param('id') id: string): Promise<{ success: boolean; message: string }> {
    await this.pluginManager.enablePlugin(id);
    return { success: true, message: `Plugin "${id}" enabled` };
  }

  /**
   * Disable a plugin by ID.
   *
   * POST /api/plugins/:id/disable
   *
   * @param id - Plugin identifier
   * @returns Status confirmation
   */
  @Post(':id/disable')
  @HttpCode(HttpStatus.OK)
  async disable(@Param('id') id: string): Promise<{ success: boolean; message: string }> {
    await this.pluginManager.disablePlugin(id);
    return { success: true, message: `Plugin "${id}" disabled` };
  }

  /**
   * Configure a plugin with runtime settings.
   *
   * POST /api/plugins/:id/configure
   *
   * @param id - Plugin identifier
   * @param dto - Configuration key-value pairs
   * @returns Confirmation with merged config
   */
  @Post(':id/configure')
  @HttpCode(HttpStatus.OK)
  async configure(
    @Param('id') id: string,
    @Body() dto: ConfigurePluginDto,
  ): Promise<{ success: boolean; config: Record<string, any> }> {
    await this.pluginManager.configurePlugin(id, dto.config);
    return {
      success: true,
      config: this.pluginManager.getPluginConfig(id),
    };
  }

  /**
   * Get the current status of a plugin.
   *
   * GET /api/plugins/:id/status
   *
   * @param id - Plugin identifier
   * @returns PluginStatusResponse with status, enabled state, and error info
   */
  @Get(':id/status')
  getStatus(@Param('id') id: string): PluginStatusResponse {
    return this.pluginManager.getStatus(id);
  }

  /**
   * List all available plugin slots.
   *
   * GET /api/plugins/slots
   *
   * @returns Array of all slot IDs with metadata
   */
  @Get('slots')
  listSlots(): PluginSlotMetadata[] {
    return ALL_PLUGIN_SLOTS.map((slot) => getSlotMetadata(slot as SlotId));
  }

  /**
   * Get all hooks (plugins) registered for a specific slot.
   *
   * GET /api/plugins/slots/:slot/hooks
   *
   * @param slot - Slot identifier
   * @returns Array of plugin info objects for plugins registered on this slot
   */
  @Get('slots/:slot/hooks')
  getSlotHooks(@Param('slot') slot: string): PluginInfo[] {
    const slotId = slot as SlotId;
    const plugins = this.pluginRegistry.getBySlot(slotId);
    return plugins.map((plugin) => this.pluginRegistry.getInfo(plugin.id));
  }
}
