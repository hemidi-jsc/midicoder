/**
 * Plugin Registry Service - Central registry for all loaded plugins.
 *
 * Generated by Midicoder - BackendNestJSEmitter
 * CP27: Plugin System
 */

import { Injectable, Logger, NotFoundException } from '@nestjs/common';

import { IPlugin, PluginStatus, PluginInfo } from './contracts';
import { SlotId, PluginSlot } from './slots';

/**
 * PluginRegistryService maintains the central map of all registered plugins.
 *
 * @Injectable() singleton — shared across the entire application.
 * Provides lookup by plugin ID and by slot ID for hook dispatch.
 */
@Injectable()
export class PluginRegistryService {
  private readonly logger = new Logger(PluginRegistryService.name);
  private readonly plugins: Map<string, IPlugin> = new Map();
  private readonly statusMap: Map<string, PluginStatus> = new Map();
  private readonly enabledMap: Map<string, boolean> = new Map();
  private readonly loadedAtMap: Map<string, Date> = new Map();
  private readonly errorMap: Map<string, string> = new Map();

  /**
   * Register a plugin instance in the registry.
   *
   * @param plugin - The IPlugin instance to register
   */
  register(plugin: IPlugin): void {
    if (this.plugins.has(plugin.id)) {
      this.logger.warn(`Plugin "${plugin.id}" is already registered. Overwriting.`);
    }

    this.plugins.set(plugin.id, plugin);
    this.statusMap.set(plugin.id, PluginStatus.ENABLED);
    this.enabledMap.set(plugin.id, true);
    this.loadedAtMap.set(plugin.id, new Date());
    this.errorMap.delete(plugin.id);

    this.logger.log(`Plugin "${plugin.id}" v${plugin.version} registered with slots: ${plugin.slots.join(', ')}`);
  }

  /**
   * Unregister a plugin by ID.
   *
   * @param id - Plugin identifier
   * @returns true if the plugin was found and removed
   */
  unregister(id: string): boolean {
    const existed = this.plugins.delete(id);
    this.statusMap.delete(id);
    this.enabledMap.delete(id);
    this.loadedAtMap.delete(id);
    this.errorMap.delete(id);

    if (existed) {
      this.logger.log(`Plugin "${id}" unregistered.`);
    }

    return existed;
  }

  /**
   * Get a plugin instance by ID.
   *
   * @param id - Plugin identifier
   * @returns The IPlugin instance or undefined
   */
  get(id: string): IPlugin | undefined {
    return this.plugins.get(id);
  }

  /**
   * Get all registered plugins.
   *
   * @returns Array of all IPlugin instances
   */
  getAll(): IPlugin[] {
    return Array.from(this.plugins.values());
  }

  /**
   * Get all plugins registered for a specific slot.
   *
   * Useful for dispatching hooks to all plugins listening on a slot.
   *
   * @param slotId - The slot identifier to filter by
   * @returns Array of plugins that have registered this slot
   */
  getBySlot(slotId: SlotId): IPlugin[] {
    return this.getAll().filter((plugin) => plugin.slots.includes(slotId));
  }

  /**
   * Check if a plugin is currently enabled.
   *
   * @param id - Plugin identifier
   * @returns true if the plugin exists and is enabled
   */
  isEnabled(id: string): boolean {
    return this.enabledMap.get(id) ?? false;
  }

  /**
   * Enable a plugin by ID.
   *
   * @param id - Plugin identifier
   */
  enable(id: string): void {
    this.enabledMap.set(id, true);
    this.statusMap.set(id, PluginStatus.ENABLED);
    this.logger.log(`Plugin "${id}" enabled.`);
  }

  /**
   * Disable a plugin by ID.
   *
   * @param id - Plugin identifier
   */
  disable(id: string): void {
    this.enabledMap.set(id, false);
    this.statusMap.set(id, PluginStatus.DISABLED);
    this.logger.log(`Plugin "${id}" disabled.`);
  }

  /**
   * Mark a plugin as currently loading.
   *
   * @param id - Plugin identifier
   */
  markLoading(id: string): void {
    this.statusMap.set(id, PluginStatus.LOADING);
    this.plugins.set(id, null as any); // placeholder until loaded
  }

  /**
   * Mark a plugin as having an error.
   *
   * @param id - Plugin identifier
   * @param errorMessage - The error message
   */
  markError(id: string, errorMessage: string): void {
    this.statusMap.set(id, PluginStatus.ERROR);
    this.errorMap.set(id, errorMessage);
    this.logger.error(`Plugin "${id}" error: ${errorMessage}`);
  }

  /**
   * Get the current status of a plugin.
   *
   * @param id - Plugin identifier
   * @returns PluginStatus or undefined if plugin not found
   */
  getStatus(id: string): PluginStatus | undefined {
    return this.statusMap.get(id);
  }

  /**
   * Get the error message for a plugin (if any).
   *
   * @param id - Plugin identifier
   * @returns Error message or undefined
   */
  getError(id: string): string | undefined {
    return this.errorMap.get(id);
  }

  /**
   * Get the loaded-at timestamp for a plugin.
   *
   * @param id - Plugin identifier
   * @returns Date or undefined
   */
  getLoadedAt(id: string): Date | undefined {
    return this.loadedAtMap.get(id);
  }

  /**
   * Build a PluginInfo DTO for a specific plugin.
   *
   * @param id - Plugin identifier
   * @returns PluginInfo object
   * @throws NotFoundException if plugin is not found
   */
  getInfo(id: string): PluginInfo {
    const plugin = this.get(id);
    if (!plugin) {
      throw new NotFoundException(`Plugin "${id}" not found in registry`);
    }

    return this.buildPluginInfo(plugin);
  }

  /**
   * Build PluginInfo DTOs for all registered plugins.
   *
   * @returns Array of PluginInfo objects
   */
  getAllInfo(): PluginInfo[] {
    return this.getAll().map((plugin) => this.buildPluginInfo(plugin));
  }

  /**
   * Get the total count of registered plugins.
   *
   * @returns Number of plugins
   */
  count(): number {
    return this.plugins.size;
  }

  /**
   * Build a PluginInfo DTO from an IPlugin instance.
   *
   * @param plugin - The plugin instance
   * @returns PluginInfo DTO
   */
  private buildPluginInfo(plugin: IPlugin): PluginInfo {
    return {
      id: plugin.id,
      name: plugin.name,
      version: plugin.version,
      description: undefined, // Can be extended with manifest data
      author: undefined,
      status: this.statusMap.get(plugin.id) ?? PluginStatus.INACTIVE,
      slots: plugin.slots,
      enabled: this.enabledMap.get(plugin.id) ?? false,
      configured: false, // Can be tracked separately
      loadedAt: this.loadedAtMap.get(plugin.id),
      error: this.errorMap.get(plugin.id),
    };
  }
}
