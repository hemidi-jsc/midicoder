/**
 * Plugin Middleware - HTTP request/response lifecycle hooks for plugins.
 *
 * Generated by Midicoder - BackendNestJSEmitter
 * CP27: Plugin System
 */

import { Injectable, NestMiddleware, Logger } from '@nestjs/common';
import { Request, Response, NextFunction } from 'express';

import { PluginRegistryService } from './plugin-registry.service';
import { PluginSlot } from './slots';

/**
 * PluginMiddleware implements NestJS MiddlewareInterface to invoke
 * enabled plugins' on_request hook before each HTTP request.
 *
 * Each plugin is executed with error isolation — a failure in one
 * plugin never interrupts the request pipeline or affects other plugins.
 *
 * Usage:
 *   import { NestFactory } from '@nestjs/core';
 *   import { PluginMiddleware } from './plugin.middleware';
 *
 *   const app = await NestFactory.create(AppModule);
 *   app.use(PluginMiddleware);
 */
@Injectable()
export class PluginMiddleware implements NestMiddleware {
  private readonly logger = new Logger(PluginMiddleware.name);

  constructor(
    private readonly registry: PluginRegistryService,
  ) {}

  /**
   * Called by NestJS for every incoming HTTP request.
   *
   * Invokes all enabled plugins registered for the ON_REQUEST slot.
   * Wraps the next() call to also invoke ON_RESPONSE hooks after
   * the downstream handlers complete.
   *
   * @param req - Express Request object
   * @param res - Express Response object
   * @param next - Express next middleware function
   */
  resolve(): (req: Request, res: Response, next: NextFunction) => void {
    return async (req: Request, res: Response, next: NextFunction) => {
      const startTime = Date.now();

      // =========================================================================
      // Phase 1: on_request — before the request is processed
      // =========================================================================
      await this.invokeSlot(PluginSlot.ON_REQUEST, req, res, {
        method: req.method,
        url: req.url,
        headers: req.headers,
        startTime,
      });

      // =========================================================================
      // Phase 2: wrap response to capture on_response after downstream handlers
      // =========================================================================
      const originalEnd = res.end.bind(res);
      res.end = function (chunk?: any, encoding?: any, callback?: any): any {
        const duration = Date.now() - startTime;

        // Phase 2: on_response — after the request is processed
        PluginMiddleware.prototype.invokeSlot.call(PluginMiddleware.prototype, PluginSlot.ON_RESPONSE, req, res, {
          method: req.method,
          url: req.url,
          statusCode: res.statusCode,
          duration,
        }).catch((error) => {
          // Never let response-phase errors crash the request
          PluginMiddleware.prototype.logger.error(`on_response hook error: ${error.message}`);
        });

        return originalEnd(chunk, encoding, callback);
      };

      // =========================================================================
      // Phase 3: pass control to downstream handlers
      // =========================================================================
      try {
        next();
      } catch (error) {
        // Phase 3: on_error — if an error occurs during request handling
        this.invokeSlot(PluginSlot.ON_ERROR, req, res, {
          method: req.method,
          url: req.url,
          error: error.message,
          stack: error.stack,
        }).catch((slotError) => {
          // Never let error-slot invocation mask the original error
          this.logger.error(`on_error hook invocation failed: ${slotError.message}`);
        });

        // Re-throw to preserve normal error handling
        throw error;
      }
    };
  }

  /**
   * Invoke a specific slot for all enabled plugins registered on that slot.
   *
   * Each plugin is executed in its own try/catch for error isolation.
   *
   * @param slotId - The PluginSlot to invoke
   * @param req - Express Request for context
   * @param res - Express Response for context
   * @param payload - Additional data to pass to plugins
   */
  private async invokeSlot(
    slotId: PluginSlot,
    req: Request,
    res: Response,
    payload: Record<string, any>,
  ): Promise<void> {
    const plugins = this.registry.getBySlot(slotId);

    if (!plugins.length) {
      return;
    }

    const enrichedPayload = {
      ...payload,
      request: {
        method: req.method,
        url: req.url,
        headers: req.headers as any,
        ip: req.ip,
      },
      response: {
        statusCode: res.statusCode,
      },
    };

    for (const plugin of plugins) {
      // Skip disabled plugins
      if (!this.registry.isEnabled(plugin.id)) {
        continue;
      }

      // Error isolation: each plugin runs independently
      try {
        if (plugin.onSlotTrigger) {
          // Build a minimal PluginContext for middleware execution
          const context = {
            appName: 'midicoder',
            appVersion: '0.0.0',
            logger: this.logger,
            config: {},
            services: {},
            log: (msg: string) => this.logger.log(`[${plugin.id}] ${msg}`),
            warn: (msg: string) => this.logger.warn(`[${plugin.id}] ${msg}`),
            error: (msg: string) => this.logger.error(`[${plugin.id}] ${msg}`),
            debug: (msg: string) => this.logger.debug(`[${plugin.id}] ${msg}`),
            getService: () => undefined,
            getConfig: (key: string, defaultValue?: any) => defaultValue,
          };

          await plugin.onSlotTrigger(slotId, enrichedPayload, context as any);
        }
      } catch (error) {
        // Error isolation: log and continue, never propagate to request pipeline
        this.logger.error(
          `Plugin "${plugin.id}" failed on slot "${slotId}": ${error.message}`,
        );
      }
    }
  }
}
