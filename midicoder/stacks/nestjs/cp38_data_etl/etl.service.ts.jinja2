  // =========================================================================
  // Transform Step
  // =========================================================================

  /**
   * Áp dụng một biến đổi lên toàn bộ dữ liệu.
   *
   * Dispatch đến phương thức transform tương ứng
   * dựa trên loại biến đổi.
   *
   * @param data - Mảng dữ liệu cần biến đổi
   * @param transform - Cấu hình biến đổi { type, config }
   * @returns Dữ liệu sau khi biến đổi
   */
  private async applyTransform(
    data: Record<string, any>[],
    transform: { type: TransformType; config: Record<string, any> },
  ): Promise<Record<string, any>[]> {
    switch (transform.type) {
      case TransformType.MAP:
        return this.transformMap(data, transform.config);

      case TransformType.FILTER:
        return this.transformFilter(data, transform.config);

      case TransformType.AGGREGATE:
        return this.transformAggregate(data, transform.config);

      case TransformType.CONVERT:
        return this.transformConvert(data, transform.config);

      case TransformType.RENAME:
        return this.transformRename(data, transform.config);

      default:
        throw new BadRequestException(`Loại biến đổi không hợp lệ: ${transform.type}`);
    }
  }

  /**
   * Transform MAP: Ánh xạ trường nguồn sang trường đích.
   *
   * Cấu hình:
   * {
   *   mappings: [
   *     { source: 'field_a', target: 'field_b' },
   *     { source: 'field_c', target: 'field_d', defaultValue: 'unknown' }
   *   ]
   * }
   *
   * @param data - Dữ liệu đầu vào
   * @param config - Cấu hình mapping
   * @returns Dữ liệu đã ánh xạ
   */
  transformMap(
    data: Record<string, any>[],
    config: Record<string, any>,
  ): Record<string, any>[] {
    const mappings = config.mappings || [];

    return data.map((row) => {
      const newRow = { ...row };
      for (const mapping of mappings) {
        const sourceValue = newRow[mapping.source];
        if (sourceValue !== undefined && sourceValue !== null) {
          newRow[mapping.target] = sourceValue;
        } else if (mapping.defaultValue !== undefined) {
          newRow[mapping.target] = mapping.defaultValue;
        } else {
          newRow[mapping.target] = null;
        }
      }
      return newRow;
    });
  }

  /**
   * Transform FILTER: Lọc dữ liệu theo điều kiện.
   *
   * Cấu hình:
   * {
   *   field: 'status',
   *   operator: 'eq',       // eq, ne, gt, gte, lt, lte, contains, in, notIn
   *   value: 'active'       // hoặc mảng cho operator 'in'/'notIn'
   * }
   *
   * @param data - Dữ liệu đầu vào
   * @param config - Cấu hình filter
   * @returns Dữ liệu đã lọc
   */
  transformFilter(
    data: Record<string, any>[],
    config: Record<string, any>,
  ): Record<string, any>[] {
    const { field, operator, value } = config;

    if (!field || !operator) {
      throw new BadRequestException('Cấu hình filter phải có field và operator');
    }

    return data.filter((row) => {
      const fieldValue = row[field];

      switch (operator) {
        case 'eq':
          return fieldValue === value;
        case 'ne':
          return fieldValue !== value;
        case 'gt':
          return fieldValue > value;
        case 'gte':
          return fieldValue >= value;
        case 'lt':
          return fieldValue < value;
        case 'lte':
          return fieldValue <= value;
        case 'contains':
          return String(fieldValue).includes(String(value));
        case 'in':
          return Array.isArray(value) && value.includes(fieldValue);
        case 'notIn':
          return Array.isArray(value) && !value.includes(fieldValue);
        case 'isNull':
          return fieldValue === null || fieldValue === undefined;
        case 'isNotNull':
          return fieldValue !== null && fieldValue !== undefined;
        default:
          throw new BadRequestException(`Operator không hợp lệ: ${operator}`);
      }
    });
  }

  /**
   * Transform AGGREGATE: Tổng hợp dữ liệu theo nhóm.
   *
   * Cấu hình:
   * {
   *   groupBy: 'category',
   *   aggregations: [
   *     { field: 'amount', function: 'sum', as: 'totalAmount' },
   *     { field: 'quantity', function: 'avg', as: 'avgQuantity' },
   *     { field: 'id', function: 'count', as: 'totalCount' }
   *   ]
   * }
   *
   * Functions hỗ trợ: sum, avg, count, min, max, first, last
   *
   * @param data - Dữ liệu đầu vào
   * @param config - Cấu hình aggregate
   * @returns Dữ liệu đã tổng hợp
   */
  transformAggregate(
    data: Record<string, any>[],
    config: Record<string, any>,
  ): Record<string, any>[] {
    const { groupBy, aggregations } = config;

    if (!groupBy || !aggregations) {
      throw new BadRequestException(
        'Cấu hình aggregate phải có groupBy và aggregations',
      );
    }

    // Nhóm dữ liệu theo groupBy field
    const groups = new Map<string, Record<string, any>[]>();
    for (const row of data) {
      const key = String(row[groupBy] ?? '__null__');
      if (!groups.has(key)) {
        groups.set(key, []);
      }
      groups.get(key)!.push(row);
    }

    // Tính aggregate cho mỗi nhóm
    const result: Record<string, any>[] = [];
    for (const [groupKey, groupRows] of groups) {
      const aggregated: Record<string, any> = {};
      aggregated[groupBy] = groupKey === '__null__' ? null : groupKey;

      for (const agg of aggregations) {
        const values = groupRows
          .map((r) => Number(r[agg.field]))
          .filter((v) => !isNaN(v));

        let resultValue: number | string;

        switch (agg.function) {
          case 'sum':
            resultValue = values.reduce((a, b) => a + b, 0);
            break;
          case 'avg':
            resultValue = values.length
              ? values.reduce((a, b) => a + b, 0) / values.length
              : 0;
            break;
          case 'count':
            resultValue = groupRows.length;
            break;
          case 'min':
            resultValue = values.length ? Math.min(...values) : 0;
            break;
          case 'max':
            resultValue = values.length ? Math.max(...values) : 0;
            break;
          case 'first':
            resultValue = groupRows[0]?.[agg.field];
            break;
          case 'last':
            resultValue = groupRows[groupRows.length - 1]?.[agg.field];
            break;
          default:
            throw new BadRequestException(
              `Aggregate function không hợp lệ: ${agg.function}`,
            );
        }

        aggregated[agg.as || `${agg.function}_${agg.field}`] = resultValue;
      }

      result.push(aggregated);
    }

    return result;
  }

  /**
   * Transform CONVERT: Chuyển đổi kiểu dữ liệu của trường.
   *
   * Cấu hình:
   * {
   *   field: 'amount',
   *   fromType: 'string',   // string, number, boolean, date, null (auto-detect)
   *   toType: 'number',     // string, number, boolean, date, integer
   *   dateFormat?: 'yyyy-MM-dd'  // chỉ dùng khi toType = 'date'
   * }
   *
   * @param data - Dữ liệu đầu vào
   * @param config - Cấu hình convert
   * @returns Dữ liệu đã chuyển đổi
   */
  transformConvert(
    data: Record<string, any>[],
    config: Record<string, any>,
  ): Record<string, any>[] {
    const { field, toType, dateFormat } = config;

    if (!field || !toType) {
      throw new BadRequestException(
        'Cấu hình convert phải có field và toType',
      );
    }

    return data.map((row) => {
      const newRow = { ...row };
      const value = newRow[field];

      if (value === null || value === undefined) {
        return newRow;
      }

      switch (toType) {
        case 'number':
          newRow[field] = parseFloat(String(value));
          break;
        case 'integer':
          newRow[field] = parseInt(String(value), 10);
          break;
        case 'string':
          newRow[field] = String(value);
          break;
        case 'boolean':
          if (typeof value === 'string') {
            newRow[field] =
              value.toLowerCase() === 'true' ||
              value.toLowerCase() === '1' ||
              value.toLowerCase() === 'yes';
          } else {
            newRow[field] = Boolean(value);
          }
          break;
        case 'date':
          if (dateFormat) {
            // Parse theo format tùy chỉnh (đơn giản)
            newRow[field] = this.parseDate(String(value), dateFormat);
          } else {
            newRow[field] = new Date(value).toISOString();
          }
          break;
        default:
          throw new BadRequestException(`toType không hợp lệ: ${toType}`);
      }

      return newRow;
    });
  }

  /**
   * Transform RENAME: Đổi tên trường.
   *
   * Cấu hình:
   * {
   *   renames: [
   *     { from: 'old_name', to: 'new_name' },
   *     { from: 'first_name', to: 'ten' }
   *   ]
   * }
   *
   * Trường cũ sẽ bị xóa sau khi rename.
   *
   * @param data - Dữ liệu đầu vào
   * @param config - Cấu hình rename
   * @returns Dữ liệu đã đổi tên trường
   */
  transformRename(
    data: Record<string, any>[],
    config: Record<string, any>,
  ): Record<string, any>[] {
    const renames = config.renames || [];

    return data.map((row) => {
      const newRow: Record<string, any> = {};

      // Copy các trường không rename
      for (const [key, value] of Object.entries(row)) {
        const renameConfig = renames.find((r) => r.from === key);
        if (renameConfig) {
          newRow[renameConfig.to] = value;
        } else {
          newRow[key] = value;
        }
      }

      return newRow;
    });
  }

