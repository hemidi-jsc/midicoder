  /**
   * Parse date string theo format tùy chỉnh (đơn giản).
   *
   * @param dateStr - Chuỗi ngày cần parse
   * @param format - Format string (yyyy, MM, dd, hh, mm, ss)
   * @returns ISO string
   */
  private parseDate(dateStr: string, format: string): string {
    // Nếu không parse được theo custom format, fallback về Date constructor
    try {
      const date = new Date(dateStr);
      if (isNaN(date.getTime())) {
        return dateStr; // Trả về nguyên nếu không parse được
      }
      return date.toISOString();
    } catch {
      return dateStr;
    }
  }

  /**
   * Tạo dữ liệu mock cho testing.
   *
   * @param count - Số lượng hàng cần tạo
   * @returns Mảng dữ liệu mock
   */
  private generateMockData(count: number): Record<string, any>[] {
    const data: Record<string, any>[] = [];
    for (let i = 0; i < count; i++) {
      data.push({
        id: i + 1,
        name: `Item ${i + 1}`,
        category: ['A', 'B', 'C'][i % 3],
        amount: Math.round(Math.random() * 10000),
        status: i % 5 === 0 ? 'inactive' : 'active',
        createdAt: new Date().toISOString(),
      });
    }
    return data;
  }
