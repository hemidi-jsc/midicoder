/**
 * ETL Service cho Data Import/Export/ETL.
 *
 * Cung cấp các phương thức:
 * - createPipeline: Tạo pipeline ETL mới
 * - runPipeline: Chạy toàn bộ pipeline Extract -> Transform -> Load
 * - transformMap: Biến đổi ánh xạ trường
 * - transformFilter: Lọc dữ liệu theo điều kiện
 * - transformAggregate: Tổng hợp dữ liệu
 * - transformConvert: Chuyển đổi kiểu dữ liệu
 * - transformRename: Đổi tên trường
 * - rollback: Hoàn tác khi pipeline thất bại
 *
 * CP38: Data Import/Export/ETL
 */

import {
  Injectable,
  BadRequestException,
  NotFoundException,
  Logger,
} from '@nestjs/common';
import { Repository } from 'typeorm';
import { InjectRepository } from '@nestjs/typeorm';
import { v4 as uuidv4 } from 'uuid';
import * as fs from 'fs/promises';

import {
  ETLJob,
  ETLMapping,
  JobStatus,
  TransformType,
  ExtractSource,
  LoadMode,
} from './import.entity';
import { ETLJobCreateDto } from './import.dto';

/**
 * Service cho ETL Pipeline.
 *
 * Xử lý toàn bộ quy trình Extract -> Transform -> Load:
 * 1. Extract: Lấy dữ liệu từ nguồn (file, database, api)
 * 2. Transform: Áp dụng các biến đổi (map, filter, aggregate, convert, rename)
 * 3. Load: Ghi dữ liệu vào đích (insert, update, upsert, delete)
 *
 * Pattern Pipeline:
 * - Mỗi bước là một stage độc lập
 * - Dữ liệu được truyền qua các stage như stream
 * - Hỗ trợ rollback nếu bước Load thất bại
 * - Ghi log chi tiết cho từng bước
 */
@Injectable()
export class ETLService {
  private readonly logger = new Logger(ETLService.name);

  constructor(
    @InjectRepository(ETLJob)
    private readonly etlJobRepo: Repository<ETLJob>,
    @InjectRepository(ETLMapping)
    private readonly etlMappingRepo: Repository<ETLMapping>,
  ) {}

  // =========================================================================
  // Pipeline Creation
  // =========================================================================

  /**
   * Tạo pipeline ETL mới.
   *
   * Tạo ETLJob với các cấu hình extract/transform/load.
   * Nếu có mappings, sẽ lưu vào ETLMapping entities.
   *
   * @param dto - DTO chứa cấu hình pipeline
   * @returns ETLJob mới được tạo
   */
  async createPipeline(dto: ETLJobCreateDto): Promise<ETLJob> {
    // Sinh jobKey định dạng: etl-{timestamp}-{random}
    const timestamp = Date.now().toString(36);
    const random = uuidv4().substring(0, 8);
    const jobKey = `etl-${timestamp}-${random}`;

    const job = this.etlJobRepo.create({
      jobKey,
      pipelineName: dto.pipelineName,
      description: dto.description || null,
      status: JobStatus.PENDING,
      extractSource: dto.extractSource,
      extractConfig: dto.extractConfig || null,
      loadMode: dto.loadMode,
      loadConfig: dto.loadConfig || null,
      transforms: dto.transforms || [],
      batchSize: dto.batchSize || 1000,
      enableRollback: dto.enableRollback ?? true,
      extractedRows: 0,
      loadedRows: 0,
      filteredRows: 0,
    });

    const savedJob = await this.etlJobRepo.save(job);
    this.logger.log(`Tạo ETL Pipeline mới: ${jobKey} - ${dto.pipelineName}`);

    return savedJob;
  }

  // =========================================================================
  // Pipeline Execution
  // =========================================================================

  /**
   * Chạy toàn bộ pipeline: Extract -> Transform -> Load.
   *
   * Quy trình chi tiết:
   * 1. Validate và update trạng thái job thành RUNNING
   * 2. Extract: Lấy dữ liệu từ nguồn (file/database/api)
   * 3. Transform: Áp dụng từng biến đổi theo thứ tự
   * 4. Load: Ghi dữ liệu vào đích theo chế độ (insert/update/upsert/delete)
   * 5. Nếu thất bại ở bước Load và enableRollback = true: rollback
   * 6. Cập nhật trạng thái và thống kê
   *
   * @param jobKey - Mã định danh của job
   * @returns ETLJob đã hoàn thành
   */
  async runPipeline(jobKey: string): Promise<ETLJob> {
    // Lấy job
    const job = await this.etlJobRepo.findOne({ where: { jobKey } });
    if (!job) {
      throw new NotFoundException(`Không tìm thấy ETLJob với jobKey: ${jobKey}`);
    }

    // Kiểm tra trạng thái
    if (job.status === JobStatus.RUNNING) {
      throw new BadRequestException(
        `Pipeline ${jobKey} đang chạy, không thể thực thi lại`,
      );
    }
    if (job.status === JobStatus.COMPLETED) {
      throw new BadRequestException(
        `Pipeline ${jobKey} đã hoàn thành`,
      );
    }

    // Cập nhật trạng thái thành RUNNING
    job.status = JobStatus.RUNNING;
    job.startedAt = new Date();
    job.extractedRows = 0;
    job.loadedRows = 0;
    job.filteredRows = 0;
    job.errorMessage = null;
    await this.etlJobRepo.save(job);

    this.logger.log(`Bắt đầu chạy pipeline: ${jobKey} - ${job.pipelineName}`);

    // Lưu dữ liệu đã load để rollback nếu cần
    let loadedData: Record<string, any>[] = [];

    try {
      // -------------------------------------------------------------------------
      // BƯỚC 1: EXTRACT - Lấy dữ liệu từ nguồn
      // -------------------------------------------------------------------------
      this.logger.log(`[${jobKey}] Bước 1/3: EXTRACT từ ${job.extractSource}`);
      let data = await this.extractData(job);
      job.extractedRows = data.length;
      this.logger.log(`[${jobKey}] Extracted ${data.length} hàng`);

      // -------------------------------------------------------------------------
      // BƯỚC 2: TRANSFORM - Áp dụng các biến đổi
      // -------------------------------------------------------------------------
      this.logger.log(`[${jobKey}] Bước 2/3: TRANSFORM (${job.transforms?.length || 0} biến đổi)`);
      const beforeTransformCount = data.length;

      for (const transform of job.transforms || []) {
        data = await this.applyTransform(data, transform);
      }

      job.filteredRows = beforeTransformCount - data.length;
      this.logger.log(
        `[${jobKey}] Sau transform: ${data.length} hàng (${job.filteredRows} hàng bị lọc)`,
      );

      // -------------------------------------------------------------------------
      // BƯỚC 3: LOAD - Ghi dữ liệu vào đích
      // -------------------------------------------------------------------------
      this.logger.log(`[${jobKey}] Bước 3/3: LOAD chế độ ${job.loadMode}`);
      loadedData = await this.loadData(job, data);
      job.loadedRows = loadedData.length;

      // Hoàn thành pipeline
      job.status = JobStatus.COMPLETED;
      job.finishedAt = new Date();

      this.logger.log(
        `[${jobKey}] Pipeline hoàn thành: ${job.extractedRows} extracted, ` +
        `${job.filteredRows} filtered, ${job.loadedRows} loaded`,
      );

    } catch (error: any) {
      this.logger.error(
        `[${jobKey}] Pipeline thất bại: ${error.message}`,
        error.stack,
      );

      // Rollback nếu được cấu hình
      if (job.enableRollback && loadedData.length > 0) {
        this.logger.log(`[${jobKey}] Bắt đầu rollback ${loadedData.length} hàng`);
        await this.rollback(job, loadedData);
      }

      job.status = JobStatus.FAILED;
      job.errorMessage = error.message || 'Lỗi không xác định khi chạy pipeline';
      job.finishedAt = new Date();
    }

    await this.etlJobRepo.save(job);
    return job;
  }

  // =========================================================================
  // Extract Step
  // =========================================================================

  /**
   * Trích xuất dữ liệu từ nguồn.
   *
   * Hỗ trợ 3 nguồn:
   * - file: Đọc file CSV hoặc JSON từ hệ thống
   * - database: Truy vấn SQL từ database
   * - api: Gọi REST API để lấy dữ liệu
   *
   * @param job - ETLJob chứa cấu hình extract
   * @returns Mảng dữ liệu đã extract
   */
  private async extractData(
    job: ETLJob,
  ): Promise<Record<string, any>[]> {
    switch (job.extractSource) {
      case ExtractSource.FILE:
        return this.extractFromFile(job);

      case ExtractSource.DATABASE:
        return this.extractFromDatabase(job);

      case ExtractSource.API:
        return this.extractFromApi(job);

      default:
        throw new BadRequestException(
          `Nguồn extract không hợp lệ: ${job.extractSource}`,
        );
    }
  }

  /**
   * Extract dữ liệu từ file (CSV hoặc JSON).
   *
   * @param job - ETLJob với extractConfig chứa filePath
   * @returns Mảng dữ liệu
   */
  private async extractFromFile(
    job: ETLJob,
  ): Promise<Record<string, any>[]> {
    if (!job.extractConfig?.filePath) {
      throw new BadRequestException('Thiếu filePath trong extractConfig');
    }

    const content = await fs.readFile(job.extractConfig.filePath, 'utf-8');
    const ext = job.extractConfig.filePath.split('.').pop()?.toLowerCase();

    if (ext === 'json') {
      const parsed = JSON.parse(content);
      return Array.isArray(parsed) ? parsed : parsed.data || [];
    }

    // Parse CSV
    const lines = content
      .split('\n')
      .map((l) => l.trim())
      .filter((l) => l.length > 0);

    if (lines.length === 0) return [];

    const headers = lines[0].split(',').map((h) => h.trim());
    const rows: Record<string, any>[] = [];

    for (let i = 1; i < lines.length; i++) {
      const values = lines[i].split(',').map((v) => v.trim());
      const row: Record<string, any> = {};
      for (let j = 0; j < headers.length; j++) {
        row[headers[j]] = values[j] || '';
      }
      rows.push(row);
    }

    return rows;
  }

