  /**
   * Ghi nhật ký kiểm toán cho sự kiện đồng ý.
   *
   * Phương thức này được gọi sau mỗi thao tác thay đổi trạng thái
   * đồng ý, tùy chọn cookie, hay tùy chọn liên lạc.
   *
   * @param userId - ID người dùng
   * @param tenantId - ID tenant
   * @param eventType - Loại sự kiện (consent_granted, consent_revoked, ...)
   * @param details - Chi tiết sự kiện
   */
  private async logAuditEvent(
    userId: string,
    tenantId: string,
    eventType: string,
    details: Record<string, any>,
  ): Promise<void> {
    // TODO: Tích hợp với hệ thống audit logging
    // Ví dụ: gọi AuditService hoặc ghi vào bảng audit_log
    logger.log(
      "[Audit] userId=" + userId
      + ", tenantId=" + tenantId
      + ", event=" + eventType
      + ", details=" + JSON.stringify(details),
    );
  }
