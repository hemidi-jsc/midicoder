/**
 * CDN Service (AWS CloudFront) - Auto-generated by Midicoder CE.
 *
 * Cung cấp:
 * - CDN URL resolution
 * - Presigned URL helper
 * - Signed URL support
 *
 * Scope: chỉ AWS CloudFront
 * CP11: File Storage & Media
 */

import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

@Injectable({ providedIn: 'root' })
export class CdnService {
  private readonly cdnDomain: string;
  private readonly distributionId: string;
  private readonly useSignedUrl: boolean;
  private readonly defaultExpiration: number;

  constructor(private readonly configService: ConfigService) {
    this.cdnDomain = this.configService.get<string>("CDN_DOMAIN", "{{ collection.cdn_config.domain if collection.cdn_config else '' }}");
    this.distributionId = this.configService.get<string>("CDN_DISTRIBUTION_ID", "{{ collection.cdn_config.distribution_id if collection.cdn_config else '' }}");
    this.useSignedUrl = this.configService.get<boolean>("CDN_SIGNED_URL", {{ 'true' if collection.cdn_config and collection.cdn_config.signed_url else 'false' }});
    this.defaultExpiration = this.configService.get<number>("PRESIGNED_EXPIRATION", {{ collection.presigned_policy.expiration if collection.presigned_policy else 3600 }});
  }

  /**
   * Trả về CDN URL cho một key.
   * Nếu CDN chưa cấu hình — trả về empty string.
   */
  getCdnUrl(key: string): string {
    if (!this.cdnDomain) {
      return "";
    }
    return `https://${this.cdnDomain}/${key.replace(/^\//, '')}`;
  }

  /**
   * Trả về URL tốt nhất cho file.
   * - Nếu CDN cấu hình -> CDN URL
   * - Nếu không -> empty (để S3 presigned xử lý)
   */
  getFileUrl(key: string): string {
    const cdnUrl = this.getCdnUrl(key);
    if (cdnUrl) {
      return cdnUrl;
    }
    return "";
  }

  /**
   * Trả về True nếu nên dùng signed URL.
   */
  shouldUseSignedUrl(): boolean {
    return this.configService.get<boolean>("USE_CDN_SIGNED_URL", {{ 'true' if collection.presigned_policy and collection.presigned_policy.use_cdn_signed_url else 'false' }}) ?? false;
  }

  /**
   * Get default expiration for presigned URLs.
   */
  getDefaultExpiration(): number {
    return this.defaultExpiration;
  }

  /**
   * Get CDN health status.
   */
  isConfigured(): boolean {
    return !!this.cdnDomain && !!this.distributionId;
  }
}
