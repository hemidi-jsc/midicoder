  status: RefundStatus;

  @ApiPropertyOptional({ description: "ID hoàn tiền từ gateway", nullable: true })
  gatewayRefundId: string | null;

  @ApiProperty({ description: "Phản hồi từ gateway", type: "object" })
  gatewayResponse: Record<string, any>;

  @ApiProperty({ description: "Lý do hoàn tiền" })
  reason: string;

  @ApiProperty({ description: "Dữ liệu metadata", type: "object" })
  metadata: Record<string, any>;

  @ApiProperty({ description: "Thời điểm tạo", type: "string", format: "date-time" })
  createdAt: string;

  @ApiProperty({ description: "Thời điểm cập nhật", type: "string", format: "date-time" })
  updatedAt: string;
}
