  /**
   * Tạo tenant mới cho registration (tích hợp CP02 Multi-Tenant).
   *
   * Trong production, sử dụng TenantService từ CP02.
   *
   * @param registration - Registration đã xác minh
   * @returns Tenant ID
   */
  private async createTenantForRegistration(
    registration: TenantRegistration,
  ): Promise<string> {
    // TODO: Tích hợp với TenantService (CP02)
    // const tenantId = await this.tenantService.createTenant({
