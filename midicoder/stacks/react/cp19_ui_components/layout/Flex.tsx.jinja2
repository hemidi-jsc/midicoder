import React from "react";

{% if ui_framework == "material" %}
import { Box as MuiBox } from "@mui/material";
{% elif ui_framework == "carbon" %}
import { Box as CarbonBox } from "@carbon/react";
{% endif %}

export interface FlexProps {
  direction?: 'row' | 'column' | 'row-reverse' | 'column-reverse';
  justify?: 'start' | 'center' | 'end' | 'between' | 'around' | 'evenly';
  align?: 'start' | 'center' | 'end' | 'stretch' | 'baseline';
  wrap?: 'wrap' | 'nowrap' | 'reverse';
  gap?: number;
  fillHeight?: boolean;
  children: React.ReactNode;
  className?: string;
  style?: React.CSSProperties;
  [key: string]: any;
}

export const Flex: React.FC<FlexProps> = ({
  direction = 'row',
  justify = 'start',
  align = 'stretch',
  wrap = 'nowrap',
  gap = 0,
  fillHeight = false,
  children,
  className = '',
  style,
  ...rest
}) => {
  {% if ui_framework == "material" %}
  const justifyMap: Record<string, string> = {
    start: 'flex-start', center: 'center', end: 'flex-end',
    between: 'space-between', around: 'space-around', evenly: 'space-evenly'
  };
  const alignMap: Record<string, string> = {
    start: 'flex-start', center: 'center', end: 'flex-end',
    stretch: 'stretch', baseline: 'baseline'
  };
  const flexStyle: React.CSSProperties = {
    display: 'flex',
    flexDirection: direction,
    flexWrap: wrap,
    justifyContent: justifyMap[justify],
    alignItems: alignMap[align],
    gap: gap,
    height: fillHeight ? '100%' : undefined,
    width: '100%',
    ...style
  };

  return (
    <MuiBox className={className} style={flexStyle} {...rest}>
      {children}
    </MuiBox>
  );
  {% elif ui_framework == "tailwind" %}
  const dirMap: Record<string, string> = {
    row: 'flex-row', column: 'flex-col',
    'row-reverse': 'flex-row-reverse', 'column-reverse': 'flex-col-reverse'
  };
  const justifyMap: Record<string, string> = {
    start: 'justify-start', center: 'justify-center', end: 'justify-end',
    between: 'justify-between', around: 'justify-around', evenly: 'justify-evenly'
  };
  const alignMap: Record<string, string> = {
    start: 'items-start', center: 'items-center', end: 'items-end',
    stretch: 'items-stretch', baseline: 'items-baseline'
  };
  const wrapMap: Record<string, string> = {
    wrap: 'flex-wrap', nowrap: 'flex-nowrap', reverse: 'flex-wrap-reverse'
  };
  const gapClass = gap > 0 ? `gap-${gap / 4}` : '';
  const heightClass = fillHeight ? 'h-full' : '';
  const baseClass = `flex ${dirMap[direction]} ${wrapMap[wrap]} ${justifyMap[justify]} ${alignMap[align]} ${gapClass} ${heightClass}`;

  return (
    <div className={`${baseClass.trim()} ${className}`} style={style} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "bootstrap" %}
  const dirMap: Record<string, string> = {
    row: 'flex-row', column: 'flex-column',
    'row-reverse': 'flex-row-reverse', 'column-reverse': 'flex-column-reverse'
  };
  const justifyMap: Record<string, string> = {
    start: 'justify-content-start', center: 'justify-content-center', end: 'justify-content-end',
    between: 'justify-content-between', around: 'justify-content-around', evenly: 'justify-content-evenly'
  };
  const alignMap: Record<string, string> = {
    start: 'align-items-start', center: 'align-items-center', end: 'align-items-end',
    stretch: 'align-items-stretch', baseline: 'align-items-baseline'
  };
  const wrapMap: Record<string, string> = {
    wrap: 'flex-wrap', nowrap: 'flex-nowrap', reverse: 'flex-wrap-reverse'
  };
  const heightClass = fillHeight ? 'h-100' : '';
  const baseClass = `d-flex ${dirMap[direction]} ${wrapMap[wrap]} ${justifyMap[justify]} ${alignMap[align]} ${heightClass}`;

  const flexStyle: React.CSSProperties = {
    gap: gap > 0 ? `${gap}px` : undefined,
    ...style
  };

  return (
    <div className={`${baseClass} ${className}`} style={flexStyle} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "antd" %}
  const justifyValue = justify === 'between' ? 'space-between'
    : justify === 'around' ? 'space-around'
    : justify === 'evenly' ? 'space-evenly'
    : justify;
  const alignValue = align === 'stretch' ? 'stretch' : align;

  const flexStyle: React.CSSProperties = {
    display: 'flex',
    flexDirection: direction,
    flexWrap: wrap,
    justifyContent: justifyValue,
    alignItems: alignValue,
    gap: gap,
    height: fillHeight ? '100%' : undefined,
    width: '100%',
    ...style
  };

  return (
    <div className={`midicoder-flex ${className}`} style={flexStyle} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "carbon" %}
  const justifyValue = justify === 'between' ? 'space-between'
    : justify === 'around' ? 'space-around'
    : justify === 'evenly' ? 'space-evenly'
    : justify;

  const flexStyle: React.CSSProperties = {
    display: 'flex',
    flexDirection: direction,
    flexWrap: wrap,
    justifyContent: justifyValue,
    alignItems: align,
    gap: gap,
    height: fillHeight ? '100%' : undefined,
    width: '100%',
    ...style
  };

  return (
    <CarbonBox className={`midicoder-flex ${className}`} style={flexStyle} {...rest}>
      {children}
    </CarbonBox>
  );
  {% endif %}
};

Flex.displayName = 'Flex';

export default Flex;
