              <button
                key={index}
                className="btn btn-sm btn-outline-primary"
                onClick={action.onClick}
              >
                {action.icon && <span className="me-1">{action.icon}</span>}
                {action.label}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

export default Card;
{% elif ui_framework == "antd" %}import React from 'react';
import { Card as AntdCard, Button, Space, Typography } from 'antd';
import type { SizeType } from 'antd/lib/configPicker';

interface Action {
  label: string;
  icon?: React.ReactNode;
  onClick: () => void;
}

interface CardComponentProps {
  title?: string;
  subtitle?: string;
  description?: string;
  imageUrl?: string;
  imageAlt?: string;
  actions?: Action[];
  bordered?: boolean;
  hoverable?: boolean;
  size?: SizeType;
  children?: React.ReactNode;
  className?: string;
  style?: React.CSSProperties;
  onClick?: () => void;
}

function Card({
  title,
  subtitle,
  description,
  imageUrl,
  imageAlt = '',
  actions = [],
  bordered = true,
  hoverable = false,
  size = 'default',
  children,
  className,
  style,
  onClick
}: CardComponentProps) {
  const cover = imageUrl ? (
    <img alt={imageAlt} src={imageUrl} />
  ) : undefined;

  const extra = actions.length > 0 ? (
    <Space>
      {actions.map((action, index) => (
        <Button key={index} type="text" icon={action.icon} onClick={action.onClick}>
          {action.label}
        </Button>
      ))}
    </Space>
  ) : undefined;

  return (
    <AntdCard
      title={title}
      extra={extra}
      cover={cover}
      bordered={bordered}
      hoverable={hoverable}
      size={size}
      className={className}
      style={style}
      onClick={onClick}
    >
      {subtitle && <Typography.Text type="secondary">{subtitle}</Typography.Text>}
      {description && <p>{description}</p>}
      {children}
    </AntdCard>
  );
}

export default Card;
