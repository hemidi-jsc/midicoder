{% elif ui_framework == "carbon" %}import React from 'react';

interface AvatarProps {
  name?: string;
  alt?: string;
  src?: string;
  size?: 'sm' | 'md' | 'lg';
  status?: 'online' | 'offline' | 'unknown' | 'warning' | 'error' | 'disabled';
  className?: string;
  onClick?: () => void;
}

function getInitials(name: string): string {
  if (!name) return '?';
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return parts[0].substring(0, 2).toUpperCase();
}

function getStatusColor(status: string): string {
  const colors: Record<string, string> = {
    online: '#198038',
    offline: '#8d8d8d',
    unknown: '#8d8d8d',
    warning: '#d69e2e',
    error: '#da1e28',
    disabled: '#c6c6c6'
  };
  return colors[status] || '#8d8d8d';
}

function Avatar({
  name = '',
  alt = '',
  src,
  size = 'md',
  status = 'unknown',
  className = '',
  onClick
}: AvatarProps) {
  const sizeClasses: Record<string, string> = {
    sm: 'w-6 h-6 text-xs',
    lg: 'w-12 h-12 text-lg',
    md: 'w-8 h-8 text-sm'
  };

  return (
    <div className={`relative inline-block ${className} ${onClick ? 'cursor-pointer' : ''}`} onClick={onClick}>
      {src ? (
        <img
          src={src}
          alt={alt || name}
          className={`${sizeClasses[size]} rounded-full object-cover`}
        />
      ) : (
        <div
          className={`${sizeClasses[size]} rounded-full bg-gray-500 text-white flex items-center justify-center font-medium`}
          title={name}
        >
          {getInitials(name)}
        </div>
      )}
      {status && (
        <span
          className="absolute bottom-0 right-0 blo{% raw %}{{ backgroundColor: getStatusColor(status) }}{% endraw %}"
          style={{ backgroundColor: getStatusColor(status) }}
        />
      )}
    </div>
  );
}

export default Avatar;
