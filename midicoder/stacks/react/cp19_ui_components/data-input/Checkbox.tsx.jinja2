/*
 * Midicoder CP19 - Data Input: Checkbox
 * Standalone checkbox component.
 */
import React from 'react';

interface CheckboxProps {
  label: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  checked?: boolean;
  onChange?: (checked: boolean) => void;
  id?: string;
  className?: string;
}

const Checkbox: React.FC<CheckboxProps> = ({
  label,
  hint,
  required = false,
  disabled = false,
  checked = false,
  onChange,
  id,
  className = '',
}) => {
  return (
{% if ui_framework == "material" %}
    <div className={className} style={% raw %}{{ marginBottom: '16px' }}{% endraw %}>
      <label style={% raw %}{{ display: 'flex', alignItems: 'center', gap: '8px', cursor: 'pointer' }}{% endraw %}>
        <input
          type="checkbox"
          id={id}
          checked={checked}
          disabled={disabled}
          onChange={(e) => onChange?.(e.target.checked)}
          style={% raw %}{{ width: '20px', height: '20px', accentColor: '#3f51b5' }}{% endraw %}
        />
        <span>{label}{required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}</span>
      </label>
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px', marginLeft: '28px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      <div className="flex items-center">
        <input
          type="checkbox"
          id={id}
          checked={checked}
          disabled={disabled}
          onChange={(e) => onChange?.(e.target.checked)}
          className="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 disabled:cursor-not-allowed"
        />
        <label htmlFor={id} className="ml-3 block text-sm text-gray-700 cursor-pointer select-none">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      </div>
      {hint && <p className="mt-1 text-sm text-gray-500 ml-7">{hint}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`form-check w-100 ${className}`}>
      <input
        type="checkbox"
        id={id}
        checked={checked}
        disabled={disabled}
        onChange={(e) => onChange?.(e.target.checked)}
        className="form-check-input"
      />
      <label htmlFor={id} className="form-check-label">
        {label}
        {required && <span className="text-danger">*</span>}
      </label>
      {hint && <small className="form-text text-muted">{hint}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ marginBottom: '16px' }}{% endraw %} className={className}>
      <div style={% raw %}{{ display: 'flex', alignItems: 'center' }}{% endraw %}>
        <input
          type="checkbox"
          id={id}
          checked={checked}
          disabled={disabled}
          onChange={(e) => onChange?.(e.target.checked)}
          style={% raw %}{{ width: '16px', height: '16px', border: '1px solid #d9d9d9', borderRadius: '2px', marginRight: '8px', cursor: 'pointer' }}{% endraw %}
        />
        <label htmlFor={id} style={% raw %}{{ fontSize: '14px', color: '#262626', cursor: 'pointer', userSelect: 'none' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      </div>
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px', marginLeft: '24px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ marginBottom: '1rem' }}{% endraw %} className={className}>
      <div style={% raw %}{{ display: 'flex', alignItems: 'center' }}{% endraw %}>
        <input
          type="checkbox"
          id={id}
          checked={checked}
          disabled={disabled}
          onChange={(e) => onChange?.(e.target.checked)}
          style={% raw %}{{ width: '16px', height: '16px', border: '1px solid #8d8d8d', background: '#fff', marginRight: '8px', cursor: 'pointer' }}{% endraw %}
        />
        <label htmlFor={id} style={% raw %}{{ fontSize: '0.875rem', color: '#161616', cursor: 'pointer', userSelect: 'none' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      </div>
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0', marginLeft: '24px' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Checkbox;
