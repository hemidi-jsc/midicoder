/*
 * Midicoder CP19 - Data Input: Select
 * Standalone dropdown select component.
 */
import React from 'react';

export interface SelectOption {
  value: any;
  label: string;
  disabled?: boolean;
  group?: string;
}

interface SelectProps {
  label?: string;
  placeholder?: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  multiple?: boolean;
  options: SelectOption[];
  value?: any;
  onChange?: (value: any) => void;
  onBlur?: () => void;
  id?: string;
  className?: string;
}

const Select: React.FC<SelectProps> = ({
  label,
  placeholder = 'Select...',
  hint,
  required = false,
  disabled = false,
  multiple = false,
  options = [],
  value,
  onChange,
  onBlur,
  id,
  className = '',
}) => {
  return (
{% if ui_framework == "material" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '4px', textTransform: 'uppercase' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <select
        id={id}
        multiple={multiple}
        disabled={disabled}
        value={value}
        onChange={(e) => onChange?.(multiple ? Array.from(e.target.selectedOptions, (o) => o.value) : e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '12px 16px', border: '1px solid #bdbdbd', borderRadius: '4px', fontSize: '14px', background: '#fff', outline: 'none' }}{% endraw %}
      >
        {!multiple && <option value="">{placeholder}</option>}
        {options.map((opt) => (
          <option key={String(opt.value)} value={opt.value} disabled={opt.disabled}>{opt.label}</option>
        ))}
      </select>
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <select
        id={id}
        multiple={multiple}
        disabled={disabled}
        value={value}
        onChange={(e) => onChange?.(multiple ? Array.from(e.target.selectedOptions, (o) => o.value) : e.target.value)}
        onBlur={onBlur}
        className="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100"
      >
        {!multiple && <option value="">{placeholder}</option>}
        {options.map((opt) => (
          <option key={String(opt.value)} value={opt.value} disabled={opt.disabled}>{opt.label}</option>
        ))}
      </select>
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`form-group w-100 ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <select
        id={id}
        multiple={multiple}
        disabled={disabled}
        value={value}
        onChange={(e) => onChange?.(multiple ? Array.from(e.target.selectedOptions, (o) => o.value) : e.target.value)}
        onBlur={onBlur}
        className="form-select"
      >
        {!multiple && <option value="">{placeholder}</option>}
        {options.map((opt) => (
          <option key={String(opt.value)} value={opt.value} disabled={opt.disabled}>{opt.label}</option>
        ))}
      </select>
      {hint && <small className="form-text text-muted">{hint}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <select
        multiple={multiple}
        disabled={disabled}
        value={value}
        onChange={(e) => onChange?.(multiple ? Array.from(e.target.selectedOptions, (o) => o.value) : e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '8px 11px', border: '1px solid #d9d9d9', borderRadius: '6px', fontSize: '14px', background: '#fff', outline: 'none' }}{% endraw %}
      >
        {!multiple && <option value="">{placeholder}</option>}
        {options.map((opt) => (
          <option key={String(opt.value)} value={opt.value} disabled={opt.disabled}>{opt.label}</option>
        ))}
      </select>
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
        </label>
      )}
      <select
        id={id}
        multiple={multiple}
        disabled={disabled}
        value={value}
        onChange={(e) => onChange?.(multiple ? Array.from(e.target.selectedOptions, (o) => o.value) : e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '10px 12px', border: '1px solid #8d8d8d', fontSize: '0.875rem', background: '#fff', outline: 'none' }}{% endraw %}
      >
        {!multiple && <option value="">{placeholder}</option>}
        {options.map((opt) => (
          <option key={String(opt.value)} value={opt.value} disabled={opt.disabled}>{opt.label}</option>
        ))}
      </select>
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Select;
