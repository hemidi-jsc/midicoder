/*
 * Midicoder CP19 - Data Input: Slider
 * Standalone numeric slider/range component.
 */
import React from 'react';

interface SliderProps {
  label?: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  min?: number;
  max?: number;
  step?: number;
  value?: number;
  onChange?: (value: number) => void;
  id?: string;
  className?: string;
}

const Slider: React.FC<SliderProps> = ({
  label,
  hint,
  required = false,
  disabled = false,
  min = 0,
  max = 100,
  step = 1,
  value = 0,
  onChange,
  id,
  className = '',
}) => {
  return (
{% if ui_framework == "material" %}
    <div className={className} style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %}>
      {label && (
        <div style={% raw %}{{ fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '8px', textTransform: 'uppercase' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </div>
      )}
      <div style={% raw %}{{ display: 'flex', alignItems: 'center', gap: '16px' }}{% endraw %}>
        <input
          id={id}
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange?.(Number(e.target.value))}
          style={% raw %}{{ flex: 1, accentColor: '#3f51b5' }}{% endraw %}
        />
        <span style={% raw %}{{ minWidth: '40px', textAlign: 'right', fontSize: '14px', color: '#757575' }}{% endraw %}>{value}</span>
      </div>
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-2">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <div className="flex items-center gap-4">
        <input
          id={id}
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange?.(Number(e.target.value))}
          className="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer disabled:cursor-not-allowed"
        />
        <span className="text-sm font-medium text-gray-700" style={% raw %}{{ minWidth: '3rem', textAlign: 'right' }}{% endraw %}>{value}</span>
      </div>
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`w-100 ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <div className="d-flex align-items-center gap-3">
        <input
          id={id}
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange?.(Number(e.target.value))}
          className="form-range flex-grow-1"
        />
        <span className="text-muted" style={% raw %}{{ minWidth: '3rem', textAlign: 'right' }}{% endraw %}>{value}</span>
      </div>
      {hint && <small className="form-text text-muted">{hint}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <div style={% raw %}{{ fontSize: '14px', marginBottom: '8px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </div>
      )}
      <div style={% raw %}{{ display: 'flex', alignItems: 'center', gap: '16px' }}{% endraw %}>
        <input
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange?.(Number(e.target.value))}
          style={% raw %}{{ flex: 1, accentColor: '#1677ff' }}{% endraw %}
        />
        <span style={% raw %}{{ minWidth: '3rem', textAlign: 'right', fontSize: '14px', color: '#262626' }}{% endraw %}>{value}</span>
      </div>
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <div style={% raw %}{{ fontSize: '0.875rem', color: '#161616', marginBottom: '0.5rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '4px' }}{% endraw %}>*</span>}
        </div>
      )}
      <div style={% raw %}{{ display: 'flex', alignItems: 'center', gap: '1rem' }}{% endraw %}>
        <input
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          disabled={disabled}
          onChange={(e) => onChange?.(Number(e.target.value))}
          style={% raw %}{{ flex: 1, accentColor: '#0f62fe' }}{% endraw %}
        />
        <span style={% raw %}{{ minWidth: '3rem', textAlign: 'right', fontSize: '0.875rem', color: '#161616' }}{% endraw %}>{value}</span>
      </div>
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Slider;
