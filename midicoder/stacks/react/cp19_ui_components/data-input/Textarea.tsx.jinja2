/*
 * Midicoder CP19 - Data Input: Textarea
 * Standalone multiline text input component.
 */
import React from 'react';

interface TextareaProps {
  label?: string;
  placeholder?: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  rows?: number;
  maxLength?: number;
  value?: string;
  onChange?: (value: string) => void;
  onBlur?: () => void;
  id?: string;
  className?: string;
}

const Textarea: React.FC<TextareaProps> = ({
  label,
  placeholder = '',
  hint,
  required = false,
  disabled = false,
  rows = 4,
  maxLength,
  value = '',
  onChange,
  onBlur,
  id,
  className = '',
}) => {
  return (
{% if ui_framework == "material" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '4px', textTransform: 'uppercase', letterSpacing: '0.5px' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <textarea
        id={id}
        placeholder={placeholder}
        disabled={disabled}
        rows={rows}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '12px 16px', border: '1px solid #bdbdbd', borderRadius: '4px', fontSize: '14px', outline: 'none', resize: 'vertical', fontFamily: 'inherit' }}{% endraw %}
      />
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
      {maxLength && <div style={% raw %}{{ fontSize: '12px', color: '#bdbdbd', marginTop: '4px', textAlign: 'right' }}{% endraw %}>{value.length}/{maxLength}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <textarea
        id={id}
        placeholder={placeholder}
        disabled={disabled}
        rows={rows}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        className="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100 disabled:cursor-not-allowed resize-y"
      />
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
      {maxLength && <p className="mt-1 text-xs text-gray-400 text-right">{value.length}/{maxLength}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`form-group w-100 ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <textarea
        id={id}
        placeholder={placeholder}
        disabled={disabled}
        rows={rows}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        className="form-control"
      />
      {hint && <small className="form-text text-muted">{hint}</small>}
      {maxLength && <small className="form-text text-muted float-end">{value.length}/{maxLength}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <textarea
        placeholder={placeholder}
        disabled={disabled}
        rows={rows}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '8px 11px', border: '1px solid #d9d9d9', borderRadius: '6px', fontSize: '14px', outline: 'none', resize: 'vertical', fontFamily: 'inherit', minHeight: '80px' }}{% endraw %}
      />
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
        </label>
      )}
      <textarea
        id={id}
        placeholder={placeholder}
        disabled={disabled}
        rows={rows}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '10px 12px', border: 'none', borderBottom: '1px solid #8d8d8d', fontSize: '0.875rem', outline: 'none', background: 'transparent', resize: 'vertical', fontFamily: 'inherit', minHeight: '80px' }}{% endraw %}
      />
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Textarea;
