/** Auto-generated React routes config. */

import React from "react";
import { createBrowserRouter, RouteObject } from "react-router-dom";

import { Layout } from "./components/layout";

{% for route in routes %}
const {{ route.component }} = React.lazy(() => import('./components/{{ route.component|lower }}/{{ route.component|lower }}.tsx'));
{% endfor %}

{% macro render_route(route, indent_level) %}
{{ '  ' * indent_level }}{
{{ '  ' * indent_level }}  path: "{{ route.path | lstrip_slash }}",
{{ '  ' * indent_level }}  element: <{{ route.component }} />,
{% if route.children %}
{{ '  ' * indent_level }}  children: [
{% for child in route.children %}
{{ render_route(child, indent_level + 2) }}
{% endfor %}
{{ '  ' * indent_level }}  ],
{% endif %}
{{ '  ' * indent_level }}},
{% endmacro %}

const routeElements: RouteObject[] = [
{
  path: "/",
  element: <Layout />,
  children: [
{% for route in routes %}
{{ render_route(route, 3) }}
{% endfor %}
  ],
},
];

const router = createBrowserRouter(routeElements);

export default router;
