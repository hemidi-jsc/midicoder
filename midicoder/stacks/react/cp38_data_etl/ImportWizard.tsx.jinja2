                                                                                </div>

                                                                                {/* Kích thước lô */}
                                                                                <div>
                                                                                    <label htmlFor="batch-size"
                                                                                        className="block text-sm font-medium text-gray-700 mb-1">
                                                                                        Kích thước lô
                                                                                    </label>
                                                                                    <input id="batch-size" type="number"
                                                                                        min={100} max={10000} step={100}
                                                                                        value={batchSize}
                                                                                        onChange={(e)=>
                                                                                    setBatchSize(Number(e.target.value))}
                                                                                    className="w-full px-3 py-2 border
                                                                                    border-gray-300 rounded-lg text-sm
                                                                                    focus:outline-none focus:ring-2
                                                                                    focus:ring-blue-500"
                                                                                    />
                                                                                </div>
                                                                            </div>

                                                                            {/* Cảnh báo cho chế độ truncate */}
                                                                            {loadMode === 'truncate' && (
                                                                            <div
                                                                                className="bg-amber-50 border border-amber-200 rounded-lg p-4">
                                                                                <div className="flex items-start gap-3">
                                                                                    <svg className="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5"
                                                                                        fill="none" viewBox="0 0 24 24"
                                                                                        stroke="currentColor"
                                                                                        strokeWidth={2}>
                                                                                        <path strokeLinecap="round"
                                                                                            strokeLinejoin="round"
                                                                                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                                                                                    </svg>
                                                                                    <div>
                                                                                        <p
                                                                                            className="text-sm font-medium text-amber-800">
                                                                                            Cảnh báo!</p>
                                                                                        <p
                                                                                            className="text-sm text-amber-700 mt-1">
                                                                                            Chế độ <strong>Truncate
                                                                                                &amp; Insert</strong> sẽ
                                                                                            xóa toàn bộ dữ liệu hiện có
                                                                                            trong{' '}
                                                                                            <strong>{selectedEntityData?.label}</strong>
                                                                                            trước khi chèn dữ liệu mới.
                                                                                            Thao tác này không thể hoàn
                                                                                            tác.
                                                                                        </p>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            )}

                                                                            {/* Nút xác nhận và gửi */}
                                                                            <div
                                                                                className="flex items-center gap-3 pt-4 border-t border-gray-200">
                                                                                <button onClick={handleSubmit}
                                                                                    disabled={importHook.loading}
                                                                                    className="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 shadow-sm">
                                                                                    {importHook.loading ? (
                                                                                    <>
                                                                                        <svg className="w-5 h-5 animate-spin"
                                                                                            fill="none"
                                                                                            viewBox="0 0 24 24">
                                                                                            <circle
                                                                                                className="opacity-25"
                                                                                                cx="12" cy="12" r="10"
                                                                                                stroke="currentColor"
                                                                                                strokeWidth="4" />
                                                                                            <path className="opacity-75"
                                                                                                fill="currentColor"
                                                                                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                                                                        </svg>
                                                                                        Đang xử lý...
                                                                                    </>
                                                                                    ) : (
                                                                                    <>
                                                                                        <svg className="w-5 h-5"
                                                                                            fill="none"
                                                                                            viewBox="0 0 24 24"
                                                                                            stroke="currentColor"
                                                                                            strokeWidth={2}>
                                                                                            <path strokeLinecap="round"
                                                                                                strokeLinejoin="round"
                                                                                                d="M5 13l4 4L19 7" />
                                                                                        </svg>
                                                                                        Bắt đầu import
                                                                                    </>
                                                                                    )}
                                                                                </button>
                                                                            </div>

                                                                            {/* Lỗi hook */}
                                                                            {importHook.error && (
                                                                            <div
                                                                                className="bg-red-50 border border-red-200 rounded-lg p-4">
                                                                                <p
                                                                                    className="text-sm font-medium text-red-800">
                                                                                    Lỗi:</p>
                                                                                <p
                                                                                    className="text-sm text-red-700 mt-1">
                                                                                    {importHook.error}</p>
                                                                            </div>
                                                                            )}
                                                                        </div>
                                                                        );

                                                                        /* ===== Render nội dung bước hiện tại ===== */

                                                                        const renderStepContent = () => {
                                                                        // Nếu job đã được tạo và đang chạy/hoàn thành,
                                                                        hiển thị JobStatusPanel
                                                                        if (createdJobKey && importHook.job) {
                                                                        return (
                                                                        <div className="space-y-6">
                                                                            <JobStatusPanel job={{ jobKey:
                                                                                importHook.job.jobKey, status:
                                                                                importHook.job.status, progress:
                                                                                importHook.job.progress, totalRows:
                                                                                importHook.job.totalRows, successRows:
                                                                                importHook.job.successRows, failedRows:
                                                                                importHook.job.failedRows, skippedRows:
                                                                                importHook.job.skippedRows, startedAt:
                                                                                importHook.job.startedAt, completedAt:
                                                                                importHook.job.completedAt,
                                                                                errorMessage:
                                                                                importHook.job.errorMessage, rowErrors:
                                                                                importHook.rowErrors.map((e)=> ({
                                                                                rowNumber: e.rowNumber,
                                                                                message: e.message,
                                                                                })),
                                                                                fileName: importHook.job.fileName,
                                                                                entity: importHook.job.targetEntity,
                                                                                }}
                                                                                onCancel={async () => {
                                                                                await importHook.cancelJob();
                                                                                }}
                                                                                onRefresh={importHook.refresh}
                                                                                onAutoRefresh={async () => {
                                                                                const job = await
                                                                                importHook.getStatus();
                                                                                return {
                                                                                jobKey: job.jobKey,
                                                                                status: job.status,
                                                                                progress: job.progress,
                                                                                totalRows: job.totalRows,
                                                                                successRows: job.successRows,
                                                                                failedRows: job.failedRows,
                                                                                skippedRows: job.skippedRows,
                                                                                startedAt: job.startedAt,
                                                                                completedAt: job.completedAt,
                                                                                errorMessage: job.errorMessage,
                                                                                };
                                                                                }}
                                                                                />

                                                                                {/* Nút hoàn tất */}
                                                                                {importHook.job.status === 'completed'
                                                                                && (
                                                                                <div
                                                                                    className="flex justify-center pt-4">
                                                                                    <button onClick={handleReset}
                                                                                        className="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                                                                        Import mới
                                                                                    </button>
                                                                                </div>
                                                                                )}
                                                                        </div>
                                                                        );
                                                                        }

                                                                        switch (currentStep) {
                                                                        case 'upload':
                                                                        return renderUploadStep();
                                                                        case 'mapping':
                                                                        return renderMappingStep();
                                                                        case 'preview':
                                                                        return renderPreviewStep();
                                                                        case 'confirm':
                                                                        return renderConfirmStep();
                                                                        default:
                                                                        return null;
                                                                        }
                                                                        };

                                                                        /* ===== Render chính ===== */

                                                                        return (
                                                                        <div className={`max-w-4xl mx-auto
                                                                            ${className}`}>
                                                                            {/* Header wizard */}
                                                                            <div className="mb-8">
                                                                                <h2
                                                                                    className="text-2xl font-bold text-gray-900">
                                                                                    Import dữ liệu</h2>
                                                                                <p
                                                                                    className="text-sm text-gray-500 mt-1">
                                                                                    Hướng dẫn từng bước để import dữ
                                                                                    liệu từ file CSV/JSON
                                                                                </p>
                                                                            </div>

                                                                            {/* Thanh tiến trình */}
                                                                            {renderProgressBar()}

                                                                            {/* Nội dung bước */}
                                                                            <div
                                                                                className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                                                                                {renderStepContent()}
                                                                            </div>

                                                                            {/* Footer: Nút điều hướng */}
                                                                            {!createdJobKey && (
                                                                            <div
                                                                                className="flex items-center justify-between mt-6 pt-4 border-t border-gray-200">
                                                                                {/* Quay lại */}
                                                                                <button onClick={currentStep==='upload'
                                                                                    ? onCancel : handleBack}
                                                                                    disabled={importHook.loading}
                                                                                    className={`inline-flex items-center
                                                                                    gap-2 px-4 py-2.5 text-sm
                                                                                    font-medium rounded-lg border
                                                                                    focus:outline-none focus:ring-2
                                                                                    focus:ring-offset-1
                                                                                    disabled:opacity-50
                                                                                    disabled:cursor-not-allowed ${
                                                                                    currentStep==='upload'
                                                                                    ? 'text-gray-700 bg-white border-gray-300 hover:bg-gray-50 focus:ring-gray-500'
                                                                                    : 'text-gray-700 bg-white border-gray-300 hover:bg-gray-50 focus:ring-gray-500'
                                                                                    }`}>
                                                                                    {currentStep === 'upload' ? 'Hủy' :
                                                                                    'Quay lại'}
                                                                                </button>

                                                                                {/* Tiếp theo */}
                                                                                {currentStep !== 'confirm' && (
                                                                                <button onClick={handleNext} disabled={
                                                                                    importHook.loading ||
                                                                                    (currentStep==='upload' &&
                                                                                    !importHook.selectedFile) ||
                                                                                    (currentStep==='mapping' &&
                                                                                    !selectedEntity) ||
                                                                                    (currentStep==='mapping' &&
                                                                                    mappingErrors.length> 0)
                                                                                    }
                                                                                    className="inline-flex items-center
                                                                                    gap-2 px-6 py-2.5 text-sm
                                                                                    font-medium text-white bg-blue-600
                                                                                    rounded-lg hover:bg-blue-700 border
                                                                                    border-transparent
                                                                                    focus:outline-none focus:ring-2
                                                                                    focus:ring-blue-500
                                                                                    focus:ring-offset-1
                                                                                    disabled:opacity-50
                                                                                    disabled:cursor-not-allowed"
                                                                                    >
                                                                                    Tiếp theo
                                                                                    <svg className="w-4 h-4" fill="none"
                                                                                        viewBox="0 0 24 24"
                                                                                        stroke="currentColor"
                                                                                        strokeWidth={2}>
                                                                                        <path strokeLinecap="round"
                                                                                            strokeLinejoin="round"
                                                                                            d="M9 5l7 7-7 7" />
                                                                                    </svg>
                                                                                </button>
                                                                                )}
                                                                            </div>
                                                                            )}
                                                                        </div>
                                                                        );
                                                                        };

                                                                        export default ImportWizard;