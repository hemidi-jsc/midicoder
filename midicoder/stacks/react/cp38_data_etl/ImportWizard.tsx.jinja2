/**
* ImportWizard Component — CP38: Data Import/Export/ETL.
*{% raw %}
* UI Framework: {{{ ui_framework }}}{% endraw %}
*
* Component wizard da buoc de import du lieu.
* Buoc 1: Tai len file (CSV/JSON) voi vung drag-and-drop va xac thuc.
* Buoc 2: Anh xa cot (chon thuc the muc tieu, dropdown anh xa cot).
* Buoc 3: Xem truoc (hien thi 10 dong dau trong bang).
* Buoc 4: Xac nhan va bat dau import (tom tat, nut gui).
*
* Dieu huong: Nut Tiep theo/Qua lai, thanh tien trinh o tren.
*/

import React, { useState, useCallback, useRef, useMemo } from 'react';
import { ImportService, ImportJob, RowError } from './import.service';
import { useImportJob } from './useImportJob';
import { JobStatusPanel } from './JobStatusPanel';

{% if ui_framework == "material" %}
import { Stepper, Step, StepLabel, Button, Paper, Typography, Table, TableBody, TableCell, TableContainer, TableHead,
TableRow, FormControl, InputLabel, Select, MenuItem, Chip, Alert, LinearProgress } from '@mui/material';
{% elif ui_framework == "tailwind" %}
// Su dung Tailwind utility classes inline
{% elif ui_framework == "bootstrap" %}
import { Button, Table, Form, Alert, Card, ProgressBar } from 'react-bootstrap';
{% elif ui_framework == "antd" %}
import { Steps, Button, Table, Form, Select, Card, Typography, Alert, Tag, Upload } from 'antd';
{% elif ui_framework == "carbon" %}
import { Button, StructuredList, InlineNotification, Tile, Accordion, AccordionItem } from '@carbon/react';
{% endif %}
{% raw %}

/* ===== Loại dữ liệu ===== */

/**
* Bước trong wizard.
*/
type WizardStep = 'upload' | 'mapping' | 'preview' | 'confirm';

/**
* Một cột trong file được tải lên.
*/
interface FileColumn {
/** Tên cột trong file. */
name: string;
/** Loại dữ liệu đã phát hiện. */
detectedType: string;
}

/**
* Trường mục tiêu trong thực thể.
*/
interface TargetField {
/** Khóa trường. */
key: string;
/** Nhãn hiển thị. */
label: string;
/** Loại dữ liệu. */
type: string;
/** Bắt buộc hay không. */
required: boolean;
}

/**
* Một dòng dữ liệu xem trước.
*/
type PreviewRow = Record<string, unknown>;

    /**
    * Bản đồ ánh xạ cột: { tên_cột_file → khóa_trường_mục_tiêu }.
    */
    type ColumnMapping = Record<string, string>;

        /**
        * Props của ImportWizard.
        */
        export interface ImportWizardProps {
        /**
        * Danh sách các thực thể mục tiêu có thể import vào.
        * Mỗi thực thể có danh sách các trường hợp lệ.
        */
        targetEntities: {
        key: string;
        label: string;
        fields: TargetField[];
        }[];
        /** Chế độ tải mặc định. */
        defaultLoadMode?: 'insert' | 'update' | 'upsert' | 'truncate';
        /** Kích thước file tối đa (byte). Mặc định 50MB. */
        maxFileSize?: number;
        /** Định dạng file cho phép. Mặc định ['csv', 'json']. */
        allowedFormats?: string[];
        /** Callback khi import hoàn tất thành công. */
        onSuccess?: (job: ImportJob) => void;
        /** Callback khi wizard bị đóng/hủy. */
        onCancel?: () => void;
        /** Class tên tùy chỉnh cho container. */
        className?: string;
        }

        /* ===== Labels cho các bước ===== */

        const STEP_CONFIG: Record<WizardStep, { label: string; description: string }> = {
            upload: {
            label: 'Tải lên file',
            description: 'Chọn hoặc kéo thả file CSV/JSON',
            },
            mapping: {
            label: 'Ánh xạ cột',
            description: 'Ghép cột file với trường mục tiêu',
            },
            preview: {
            label: 'Xem trước',
            description: 'Kiểm tra dữ liệu trước khi import',
            },
            confirm: {
            label: 'Xác nhận',
            description: 'Xem tóm tắt và bắt đầu import',
            },
            };

            const ALL_STEPS: WizardStep[] = ['upload', 'mapping', 'preview', 'confirm'];

            /* ===== Component chính ===== */

            /**
            * Wizard đa bước để hướng dẫn người dùng import dữ liệu.
            *
            * @example
            * ```tsx
            * <ImportWizard * targetEntities={[ * { * key: 'products' , * label: 'Sản phẩm' , * fields: [ * {
                key: 'name' , label: 'Tên' , type: 'string' , required: true }, * { key: 'price' , label: 'Giá' ,
                type: 'number' , required: true }, * ], * }, * ]} * onSuccess={(job)=> console.log('Import job:', job)}
                * />
                * ```
                */
                export const ImportWizard: React.FC<ImportWizardProps> = ({
                    targetEntities,
                    defaultLoadMode = 'insert',
                    maxFileSize = 50 * 1024 * 1024,
                    allowedFormats = ['csv', 'json'],
                    onSuccess,
                    onCancel,
                    className = '',
                    }) => {
                    // --- Hook quản lý job ---
                    const importHook = useImportJob();

                    // --- Trạng thái wizard ---
                    const [currentStep, setCurrentStep] = useState<WizardStep>('upload');
                        const [isDragging, setIsDragging] = useState(false);

                        // --- Trạng thái Bước 1: Tải lên file ---
                        const [fileValidationErrors, setFileValidationErrors] = useState<string[]>([]);

                            // --- Trạng thái Bước 2: Ánh xạ cột ---
                            const [selectedEntity, setSelectedEntity] = useState<string>('');
                                const [columnMapping, setColumnMapping] = useState<ColumnMapping>({});
                                    const [fileColumns, setFileColumns] = useState<FileColumn[]>([]);
                                        const [mappingErrors, setMappingErrors] = useState<string[]>([]);

                                            // --- Trạng thái Bước 3: Xem trước ---
                                            const [previewData, setPreviewData] = useState<PreviewRow[]>([]);
                                                const [previewLoading, setPreviewLoading] = useState(false);

                                                // --- Trạng thái Bước 4: Xác nhận ---
                                                const [loadMode, setLoadMode] = useState<'insert' | 'update' | 'upsert'
                                                    | 'truncate'>(defaultLoadMode);
                                                    const [batchSize, setBatchSize] = useState(1000);
                                                    const [skipHeader, setSkipHeader] = useState(true);
                                                    const [transformType, setTransformType] = useState<string>('');

                                                        // --- Trạng thái Job đã tạo ---
                                                        const [createdJobKey, setCreatedJobKey] = useState<string |
                                                            null>(null);

                                                            // Ref cho input file ẩn
                                                            const fileInputRef = useRef<HTMLInputElement>(null);

                                                                // --- Tính toán bước hiện tại (số thứ tự) ---
                                                                const currentStepIndex = useMemo(
                                                                () => ALL_STEPS.indexOf(currentStep),
                                                                [currentStep],
                                                                );

                                                                // --- Thực thể mục tiêu đã chọn ---
                                                                const selectedEntityData = useMemo(
                                                                () => targetEntities.find((e) => e.key ===
                                                                selectedEntity) || null,
                                                                [targetEntities, selectedEntity],
                                                                );

                                                                // --- Định dạng kích thước file ---
                                                                const formatFileSize = (bytes: number): string => {
                                                                if (bytes === 0) return '0 B';
                                                                const units = ['B', 'KB', 'MB', 'GB'];
                                                                const i = Math.floor(Math.log(bytes) / Math.log(1024));
                                                                return `${(bytes / Math.pow(1024, i)).toFixed(2)}
                                                                ${units[i]}`;
                                                                };

                                                                /* ===== Xử lý điều hướng ===== */

                                                                /**
                                                                * Chuyển sang bước tiếp theo.
                                                                */
                                                                const handleNext = useCallback(() => {
                                                                // Xác thực trước khi chuyển bước
                                                                if (currentStep === 'upload' &&
                                                                fileValidationErrors.length > 0) return;
                                                                if (currentStep === 'mapping' && mappingErrors.length >
                                                                0) return;

                                                                const nextIndex = currentStepIndex + 1;
                                                                if (nextIndex < ALL_STEPS.length) {
                                                                    setCurrentStep(ALL_STEPS[nextIndex]); } },
                                                                    [currentStep, currentStepIndex,
                                                                    fileValidationErrors, mappingErrors]); /** * Quay
                                                                    lại bước trước. */ const handleBack=useCallback(()=>
                                                                    {
                                                                    const prevIndex = currentStepIndex - 1;
                                                                    if (prevIndex >= 0) {
                                                                    setCurrentStep(ALL_STEPS[prevIndex]);
                                                                    }
                                                                    }, [currentStepIndex]);

                                                                    /**
                                                                    * Reset toàn bộ wizard về trạng thái ban đầu.
                                                                    */
                                                                    const handleReset = useCallback(() => {
                                                                    setCurrentStep('upload');
                                                                    setFileValidationErrors([]);
                                                                    setSelectedEntity('');
                                                                    setColumnMapping({});
                                                                    setFileColumns([]);
                                                                    setMappingErrors([]);
                                                                    setPreviewData([]);
                                                                    setCreatedJobKey(null);
                                                                    setLoadMode(defaultLoadMode);
                                                                    importHook.reset();
                                                                    }, [defaultLoadMode, importHook]);

                                                                    /* ===== Xử lý Bước 1: Tải lên file ===== */

                                                                    /**
                                                                    * Xử lý khi người dùng chọn file.
                                                                    */
                                                                    const handleFileSelect = useCallback(
                                                                    async (file: File) => {
                                                                    // Xác thực file
                                                                    const validation = ImportService.validateFile(file,
                                                                    maxFileSize, allowedFormats);
                                                                    setFileValidationErrors(validation.errors);

                                                                    if (!validation.valid) return;

                                                                    // Lưu file qua hook
                                                                    const hookResult = importHook.selectFile(file);
                                                                    if (!hookResult.valid) return;

                                                                    // Đọc các cột của file
                                                                    try {
                                                                    const columns = await
                                                                    ImportService.extractColumns(file);
                                                                    const fileCols: FileColumn[] = columns.map((name) =>
                                                                    ({
                                                                    name,
                                                                    detectedType: 'string', // Loại sẽ được phát hiện
                                                                    khi đọc dữ liệu
                                                                    }));
                                                                    setFileColumns(fileCols);

                                                                    // Tự động ánh xạ cột (khớp tên cột với tên trường)
                                                                    if (selectedEntityData && fileCols.length > 0) {
                                                                    const autoMapping: ColumnMapping = {};
                                                                    for (const col of fileCols) {
                                                                    const match = selectedEntityData.fields.find(
                                                                    (f) => f.key.toLowerCase() ===
                                                                    col.name.toLowerCase(),
                                                                    );
                                                                    if (match) {
                                                                    autoMapping[col.name] = match.key;
                                                                    }
                                                                    }
                                                                    setColumnMapping(autoMapping);
                                                                    }
                                                                    } catch (err) {
                                                                    setFileValidationErrors([
                                                                    `Không thể đọc cột từ file: ${err instanceof Error ?
                                                                    err.message : 'Lỗi không xác định'}`,
                                                                    ]);
                                                                    }
                                                                    },
                                                                    [importHook, maxFileSize, allowedFormats,
                                                                    selectedEntityData],
                                                                    );

                                                                    /**
                                                                    * Xử lý khi kéo file vào vùng drop.
                                                                    */
                                                                    const handleDragEnter = useCallback((e:
                                                                    React.DragEvent) => {
                                                                    e.preventDefault();
                                                                    e.stopPropagation();
                                                                    setIsDragging(true);
                                                                    }, []);

                                                                    /**
                                                                    * Xử lý khi kéo file ra khỏi vùng drop.
                                                                    */
                                                                    const handleDragLeave = useCallback((e:
                                                                    React.DragEvent) => {
                                                                    e.preventDefault();
                                                                    e.stopPropagation();
                                                                    setIsDragging(false);
                                                                    }, []);

                                                                    /**
                                                                    * Xử lý khi thả file vào vùng drop.
                                                                    */
                                                                    const handleDragOver = useCallback((e:
                                                                    React.DragEvent) => {
                                                                    e.preventDefault();
                                                                    e.stopPropagation();
                                                                    }, []);

                                                                    /**
                                                                    * Xử lý khi thả file.
                                                                    */
                                                                    const handleDrop = useCallback(
                                                                    (e: React.DragEvent) => {
                                                                    e.preventDefault();
                                                                    e.stopPropagation();
                                                                    setIsDragging(false);

                                                                    const files = e.dataTransfer.files;
                                                                    if (files.length > 0) {
                                                                    handleFileSelect(files[0]);
                                                                    }
                                                                    },
                                                                    [handleFileSelect],
                                                                    );

                                                                    /**
                                                                    * Xử lý khi input file thay đổi.
                                                                    */
                                                                    const handleInputChange = useCallback(
                                                                    (e: React.ChangeEvent<HTMLInputElement>) => {
                                                                        const files = e.target.files;
                                                                        if (files && files.length > 0) {
                                                                        handleFileSelect(files[0]);
                                                                        }
                                                                        },
                                                                        [handleFileSelect],
                                                                        );

                                                                        /* ===== Xử lý Bước 2: Ánh xạ cột ===== */

                                                                        /**
                                                                        * Xử lý khi thay đổi thực thể mục tiêu.
                                                                        */
                                                                        const handleEntityChange =
                                                                        useCallback((entityKey: string) => {
                                                                        setSelectedEntity(entityKey);
                                                                        setColumnMapping({}); // Reset ánh xạ khi thay
                                                                        đổi thực thể
                                                                        }, []);

                                                                        /**
                                                                        * Xử lý khi thay đổi ánh xạ cho một cột.
                                                                        */
                                                                        const handleMappingChange =
                                                                        useCallback((fileColumn: string, targetField:
                                                                        string) => {
                                                                        setColumnMapping((prev) => ({
                                                                        ...prev,
                                                                        [fileColumn]: targetField,
                                                                        }));
                                                                        setMappingErrors([]);
                                                                        }, []);

                                                                        /**
                                                                        * Xác thực ánh xạ cột — đảm bảo các trường bắt
                                                                        buộc đều được ánh xạ.
                                                                        */
                                                                        const validateMapping = useCallback((): boolean
                                                                        => {
                                                                        if (!selectedEntityData) {
                                                                        setMappingErrors(['Vui lòng chọn thực thể mục
                                                                        tiêu']);
                                                                        return false;
                                                                        }

                                                                        const errors: string[] = [];
                                                                        const requiredFields =
                                                                        selectedEntityData.fields.filter((f) =>
                                                                        f.required);

                                                                        for (const field of requiredFields) {
                                                                        if
                                                                        (!Object.values(columnMapping).includes(field.key))
                                                                        {
                                                                        errors.push(`Trường bắt buộc "${field.label}"
                                                                        chưa được ánh xạ`);
                                                                        }
                                                                        }

                                                                        // Kiểm tra ánh xạ trùng — nhiều cột ánh xạ vào
                                                                        cùng một trường
                                                                        const targetValues =
                                                                        Object.values(columnMapping).filter(Boolean);
                                                                        const duplicates = targetValues.filter(
                                                                        (v, i) => targetValues.indexOf(v) !== i,
                                                                        );
                                                                        if (duplicates.length > 0) {
                                                                        const uniqueDups = [...new Set(duplicates)];
                                                                        const fieldLabels = uniqueDups.map((key) => {
                                                                        const f = selectedEntityData.fields.find((fld)
                                                                        => fld.key === key);
                                                                        return f ? f.label : key;
                                                                        });
                                                                        errors.push(
                                                                        `Nhiều cột ánh xạ vào cùng một trường:
                                                                        ${fieldLabels.join(', ')}`,
                                                                        );
                                                                        }

                                                                        setMappingErrors(errors);
                                                                        return errors.length === 0;
                                                                        }, [selectedEntityData, columnMapping]);

                                                                        /* ===== Xử lý Bước 3: Xem trước ===== */

                                                                        /**
                                                                        * Tải dữ liệu xem trước từ file.
                                                                        */
                                                                        const loadPreview = useCallback(async () => {
                                                                        if (!importHook.selectedFile) return;

                                                                        setPreviewLoading(true);
                                                                        try {
                                                                        const data = await
                                                                        ImportService.previewFile(importHook.selectedFile,
                                                                        10);
                                                                        // Áp dụng ánh xạ cột — rename keys
                                                                        const mappedData: PreviewRow[] = data.map((row)
                                                                        => {
                                                                        const mapped: PreviewRow = {};
                                                                        for (const [fileCol, targetField] of
                                                                        Object.entries(columnMapping)) {
                                                                        if (targetField && row[fileCol] !== undefined) {
                                                                        mapped[targetField] = row[fileCol];
                                                                        }
                                                                        }
                                                                        // Giữ các cột chưa ánh xạ
                                                                        for (const [key, value] of Object.entries(row))
                                                                        {
                                                                        if (!columnMapping[key]) {
                                                                        mapped[`_ unmapped_${key}`] = value;
                                                                        }
                                                                        }
                                                                        return mapped;
                                                                        });
                                                                        setPreviewData(mappedData);
                                                                        } catch (err) {
                                                                        setPreviewData([]);
                                                                        } finally {
                                                                        setPreviewLoading(false);
                                                                        }
                                                                        }, [importHook.selectedFile, columnMapping]);

                                                                        /* ===== Xử lý Bước 4: Xác nhận và gửi ===== */

                                                                        /**
                                                                        * Xác nhận và bắt đầu import.
                                                                        */
                                                                        const handleSubmit = useCallback(async () => {
                                                                        if (!importHook.selectedFile || !selectedEntity)
                                                                        return;

                                                                        try {
                                                                        // 1. Tải file lên
                                                                        await importHook.uploadFile();

                                                                        // 2. Tạo import job
                                                                        const job = await importHook.createJob({
                                                                        targetEntity: selectedEntity,
                                                                        format:
                                                                        importHook.selectedFile.name.split('.').pop()?.toLowerCase()
                                                                        as 'csv' | 'json',
                                                                        columnMapping,
                                                                        loadMode,
                                                                        skipHeader,
                                                                        batchSize,
                                                                        transformType: transformType || undefined,
                                                                        });

                                                                        setCreatedJobKey(job.jobKey);

                                                                        // 3. Thực thi job
                                                                        await importHook.executeJob();

                                                                        // Callback thành công
                                                                        onSuccess?.(importHook.job!);
                                                                        } catch (err) {
                                                                        // Lỗi đã được hook xử lý và lưu vào state
                                                                        }
                                                                        }, [
                                                                        importHook,
                                                                        selectedEntity,
                                                                        columnMapping,
                                                                        loadMode,
                                                                        skipHeader,
                                                                        batchSize,
                                                                        transformType,
                                                                        onSuccess,
                                                                        ]);

                                                                        /* ===== Render thanh tiến trình ===== */

                                                                        const renderProgressBar = () => (
                                                                        <div className="mb-8">
                                                                            {/* Thanh tiến trình bước */}
                                                                            <div
                                                                                className="flex items-center justify-between mb-4">
                                                                                {ALL_STEPS.map((step, index) => {
                                                                                const isActive = index ===
                                                                                currentStepIndex;
                                                                                const isCompleted = index <
                                                                                    currentStepIndex; const
                                                                                    config=STEP_CONFIG[step]; return (
                                                                                    <div key={step}
                                                                                    className="flex items-center flex-1 last:flex-none">
                                                                                    {/*圆圈 bước */}
                                                                                    <div
                                                                                        className="flex flex-col items-center relative z-10">
                                                                                        <div className={`w-10 h-10
                                                                                            rounded-full flex
                                                                                            items-center justify-center
                                                                                            border-2 transition-colors
                                                                                            duration-200 ${ isCompleted
                                                                                            ? 'bg-emerald-600 border-emerald-600 text-white'
                                                                                            : isActive
                                                                                            ? 'bg-white border-blue-600 text-blue-600'
                                                                                            : 'bg-white border-gray-300 text-gray-400'
                                                                                            }`}>
                                                                                            {isCompleted ? (
                                                                                            {/* Icon kiểm tra */}
                                                                                            <svg className="w-5 h-5"
                                                                                                fill="currentColor"
                                                                                                viewBox="0 0 20 20">
                                                                                                <path fillRule="evenodd"
                                                                                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                                                                    clipRule="evenodd" />
                                                                                            </svg>
                                                                                            ) : (
                                                                                            <span
                                                                                                className="text-sm font-semibold">{index
                                                                                                + 1}</span>
                                                                                            )}
                                                                                        </div>
                                                                                        <span className={`mt-2 text-xs
                                                                                            font-medium text-center
                                                                                            hidden sm:block ${ isActive
                                                                                            ? 'text-blue-600' :
                                                                                            isCompleted
                                                                                            ? 'text-emerald-600'
                                                                                            : 'text-gray-400' }`}>
                                                                                            {config.label}
                                                                                        </span>
                                                                                    </div>

                                                                                    {/* Đường nối giữa các bước */}
                                                                                    {index < ALL_STEPS.length - 1 && (
                                                                                        <div
                                                                                        className="flex-1 mx-2 sm:mx-4">
                                                                                        <div
                                                                                            className="h-0.5 bg-gray-200 rounded">
                                                                                            <div className="h-full bg-emerald-600 rounded transition-all duration-300"
                                                                                                style={{ width:
                                                                                                isCompleted ? '100%'
                                                                                                : '0%' }} />
                                                                                        </div>
                                                                            </div>
                                                                            )}
                                                                        </div>
                                                                        );
                                                                        })}
                                                                        </div>

                                                                        {/* Mô tả bước hiện tại */}
                                                                        <p
                                                                            className="text-sm text-gray-500 text-center">
                                                                            {STEP_CONFIG[currentStep].description}
                                                                        </p>
                                                                        </div>
                                                                        );

                                                                        /* ===== Render Bước 1: Tải lên file ===== */

                                                                        const renderUploadStep = () => (
                                                                        <div className="space-y-6">
                                                                            {/* Vùng drag-and-drop */}
                                                                            <div onDragEnter={handleDragEnter}
                                                                                onDragLeave={handleDragLeave}
                                                                                onDragOver={handleDragOver}
                                                                                onDrop={handleDrop} onClick={()=>
                                                                                fileInputRef.current?.click()}
                                                                                className={`relative border-2
                                                                                border-dashed rounded-xl p-12
                                                                                text-center cursor-pointer
                                                                                transition-all duration-200 ${
                                                                                isDragging
                                                                                ? 'border-blue-500 bg-blue-50
                                                                                scale-[1.02]'
                                                                                : importHook.selectedFile
                                                                                ? 'border-emerald-400 bg-emerald-50'
                                                                                : 'border-gray-300 bg-gray-50
                                                                                hover:border-gray-400 hover:bg-gray-100'
                                                                                }`}
                                                                                role="button"
                                                                                tabIndex={0}
                                                                                aria-label="Kéo thả file hoặc nhấp để
                                                                                chọn"
                                                                                onKeyDown={(e) => {
                                                                                if (e.key === 'Enter' || e.key === ' ')
                                                                                {
                                                                                e.preventDefault();
                                                                                fileInputRef.current?.click();
                                                                                }
                                                                                }}
                                                                                >
                                                                                {/* Input file ẩn */}
                                                                                <input ref={fileInputRef} type="file"
                                                                                    accept={allowedFormats.map((f)=>
                                                                                `.${f}`).join(',')}
                                                                                onChange={handleInputChange}
                                                                                className="hidden"
                                                                                aria-hidden="true"
                                                                                />

                                                                                {importHook.selectedFile ? (
                                                                                /* File đã chọn — hiển thị thông tin */
                                                                                <div className="space-y-3">
                                                                                    {/* Icon file */}
                                                                                    <div
                                                                                        className="mx-auto w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center">
                                                                                        <svg className="w-8 h-8 text-emerald-600"
                                                                                            fill="none"
                                                                                            viewBox="0 0 24 24"
                                                                                            stroke="currentColor"
                                                                                            strokeWidth={1.5}>
                                                                                            <path strokeLinecap="round"
                                                                                                strokeLinejoin="round"
