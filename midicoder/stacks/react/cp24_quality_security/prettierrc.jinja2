{#
    Template: .prettierrc cho React (CP24 - Code Quality & Security Scanner)

    Mô tả:
    Sinh cấu hình Prettier cho dự án React.
    Định dạng: single quote, trailing comma, print width 100.

    Tất cả comments trong tiếng Việt.
#}
{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "bracketSameLine": false,
  "arrowParens": "always"
}
