/**
* Compliance Dashboard Component — CP14: Audit Trail & Compliance
*
* React component: compliance status cards (GDPR/HIPAA/SOX/PCI),
* audit log viewer, tamper detection alerts.
*/

import React, { useState, useEffect, useCallback } from 'react';

export type ComplianceStatus = 'compliant' | 'non-compliant' | 'partial' | 'not-assessed';
export interface ComplianceStandard { id: string; name: string; status: ComplianceStatus; lastAssessed: string;
controlsCount: number; controlsPassed: number; violationsCount: number; }
export interface TamperAlert { id: string; timestamp: string; entityType: string; entityId: string; description: string;
severity: 'low' | 'medium' | 'high' | 'critical'; }

interface ComplianceDashboardProps { apiBaseUrl?: string; }

const STATUS_COLORS: Record<ComplianceStatus, string> = { compliant: '#4caf50', 'non-compliant': '#f44336', partial:
    '#ff9800', 'not-assessed': '#9e9e9e' };
    const STATUS_LABELS: Record<ComplianceStatus, string> = { compliant: 'Tuân thủ', 'non-compliant': 'Vi phạm',
        partial: 'Partial', 'not-assessed': 'Chưa đánh giá' };
        const SEV_COLORS: Record<string, { bg: string; border: string }> = {
            critical: { bg: '#ffebee', border: '#c62828' }, high: { bg: '#fff3e0', border: '#e65100' },
            medium: { bg: '#fffde7', border: '#f9a825' }, low: { bg: '#e8f5e9', border: '#2e7d32' },
            };

            export function ComplianceDashboard({ apiBaseUrl = '/api' }: ComplianceDashboardProps): JSX.Element {
            const [standards, setStandards] = useState<ComplianceStandard[]>([]);
                const [alerts, setAlerts] = useState<TamperAlert[]>([]);
                    const [logs, setLogs] = useState<any[]>([]);
                        const [loading, setLoading] = useState(true);
                        const [error, setError] = useState<string | null>(null);

                            const load = useCallback(async () => {
                            setLoading(true); setError(null);
                            try {
                            const [sr, ar, lr] = await Promise.all([
                            fetch(`${apiBaseUrl}/compliance/standards`),
                            fetch(`${apiBaseUrl}/ledger/alerts`),
                            fetch(`${apiBaseUrl}/audit/logs?limit=10`),
                            ]);
                            if (!sr.ok || !ar.ok || !lr.ok) throw new Error('Khong the tai du lieu');
                            const [s, a, l] = await Promise.all([sr.json(), ar.json(), lr.json()]);
                            setStandards(s); setAlerts(a); setLogs(l);
                            } catch (e: any) { setError(e.message); }
                            finally { setLoading(false); }
                            }, [apiBaseUrl]);

                            useEffect(() => { load(); }, [load]);

                            if (loading) return <div style={{ padding: 24, textAlign: 'center' }}>Đang tải dashboard...
                            </div>;
                            if (error) return <div style={{ padding: 24, color: '#c62828' }}>{error}</div>;

                            return (
                            <div style={{ fontFamily: 'system-ui, sans-serif' , padding: 24, maxWidth: 1200 }}>
                                <h2 style={{ margin: '0 0 24px' , fontSize: '1.5rem' }}>Bảng Điều Khiển Tuân Thủ</h2>

                                {/* Status Cards */}
                                <section style={{ marginBottom: 32 }}>
                                    <h3 style={{ margin: '0 0 16px' , fontSize: '1.1rem' , color: '#333' }}>Tình Trạng
                                        Tuân Thủ</h3>
                                    <div style={{ display: 'grid' ,
                                        gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))' , gap: 16 }}>
                                        {standards.map((s) => (
                                        <div key={s.id} style={{ border: '1px solid #e0e0e0' , borderRadius: 8, padding:
                                            16, borderLeft: `4px solid ${STATUS_COLORS[s.status]}`, }}>
                                            <div style={{ display: 'flex' , alignItems: 'center' , gap: 8, marginBottom:
                                                12 }}>
                                                <span style={{ fontWeight: 600, flex: 1 }}>{s.name}</span>
                                                <span style={{ padding: '2px 8px' , borderRadius: 10, fontSize: '0.7rem'
                                                    , fontWeight: 600, color: '#fff' , background:
                                                    STATUS_COLORS[s.status] }}>
                                                    {STATUS_LABELS[s.status]}
                                                </span>
                                            </div>
                                            <div style={{ height: 6, background: '#e0e0e0' , borderRadius: 3,
                                                marginBottom: 8, overflow: 'hidden' }}>
                                                <div style={{ height: '100%' , width: `${s.controlsCount ?
                                                    s.controlsPassed / s.controlsCount * 100 : 0}%`,
                                                    background: '#4caf50' , borderRadius: 3 }} />
                                            </div>
                                            <div style={{ display: 'flex' , justifyContent: 'space-between' ,
                                                fontSize: '0.85rem' , color: '#666' }}>
                                                <span>Đạt: {s.controlsPassed}/{s.controlsCount}</span>
                                                <span>Violations: {s.violationsCount}</span>
                                            </div>
                                        </div>
                                        ))}
                                    </div>
                                </section>

                                {/* Tamper Alerts */}
                                <section style={{ marginBottom: 32 }}>
                                    <h3 style={{ margin: '0 0 16px' , fontSize: '1.1rem' , color: '#333' }}>Cảnh Báo
                                        Phát Hiện Thay Đổi</h3>
                                    {!alerts.length ? (
                                    <div style={{ padding: 16, textAlign: 'center' , color: '#4caf50' , fontWeight: 500
                                        }}>Không có cảnh báo. Ledger đang toàn vẹn.</div>
                                    ) : alerts.map((a) => {
                                    const sc = SEV_COLORS[a.severity] || SEV_COLORS.low;
                                    return (
                                    <div key={a.id} style={{ display: 'flex' , alignItems: 'center' , gap: 12,
                                        padding: '10px 16px' , borderRadius: 6, marginBottom: 8, background: sc.bg,
                                        borderLeft: `4px solid ${sc.border}`, fontSize: '0.9rem' }}>
                                        <span style={{ fontWeight: 700, fontSize: '0.75rem' , textTransform: 'uppercase'
                                            }}>{a.severity}</span>
                                        <span style={{ flex: 1 }}>{a.description}</span>
                                        <span style={{ fontSize: '0.8rem' , color: '#666' }}>{new
                                            Date(a.timestamp).toLocaleString('vi-VN')}</span>
                                    </div>
                                    );
                                    })}
                                </section>

                                {/* Audit Logs Table */}
                                <section>
                                    <h3 style={{ margin: '0 0 16px' , fontSize: '1.1rem' , color: '#333' }}>Audit Logs
                                        Gần Đây</h3>
                                    {!logs.length ? <div style={{ textAlign: 'center' , padding: 24, color: '#888' }}>
                                        Không có audit logs.</div> : (
                                    <table style={{ width: '100%' , borderCollapse: 'collapse' , fontSize: '0.875rem'
                                        }}>
                                        <thead>
                                            <tr>{['Thời gian', 'Action', 'Entity', 'Actor', 'Hash'].map((h) => (
                                                <th key={h} style={{ padding: '8px 12px' , textAlign: 'left' ,
                                                    borderBottom: '1px solid #eee' , background: '#f5f5f5' }}>{h}</th>
                                                ))}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {logs.map((l, i) => (
                                            <tr key={i}>
                                                <td style={{ padding: '8px 12px' , borderBottom: '1px solid #eee' }}>
                                                    {new Date(l.timestamp).toLocaleString('vi-VN')}</td>
                                                <td style={{ padding: '8px 12px' , borderBottom: '1px solid #eee' }}>
                                                    <span style={{ display: 'inline-block' , padding: '2px 8px' ,
                                                        borderRadius: 3, fontSize: '0.75rem' , fontWeight: 600,
                                                        color: '#fff' , background: '#2196f3' }}>{l.action}</span>
                                                </td>
                                                <td style={{ padding: '8px 12px' , borderBottom: '1px solid #eee' }}>
                                                    {l.entityType}:{l.entityId}</td>
                                                <td style={{ padding: '8px 12px' , borderBottom: '1px solid #eee' }}>
                                                    {l.actorId}</td>
                                                <td style={{ padding: '8px 12px' , borderBottom: '1px solid #eee' ,
                                                    fontFamily: 'monospace' , fontSize: '0.8rem' , color: '#999' }}>
                                                    {(l.hash || '').slice(0, 16)}...</td>
                                            </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                    )}
                                </section>
                            </div>
                            );
                            }

                            export default ComplianceDashboard;