/** MFA Verify Page - CP21.
*
* Trang xác thực hai yếu tố (TOTP/SMS/Email).
*
* UI Framework: [{ui_framework}]
*/

import React, { useState } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";
{% set fw = ui_framework | default("tailwind") %}
{% if fw == "material" %}
import { Container, Paper, TextField, Button, Typography, Box, Alert } from "@mui/material";
{% elif fw == "tailwind" %}
{# Tailwind uses utility classes, no UI library import #}
{% elif fw == "bootstrap" %}
import { Container, Card, Form, Button, Alert } from "react-bootstrap";
{% elif fw == "antd" %}
import { Form, Input, Button, Card, Typography, Alert, Space } from "antd";
{% elif fw == "carbon" %}
import { Form, FormGroup, TextInput, Button, InlineNotification, Grid, Column, Layer } from "@carbon/react";
{% endif %}
import { useAuthContext } from "../auth/AuthContext";

const { Title, Text } = Typography;

export interface MfaVerifyPageProps {}

export const MfaVerify: React.FC<MfaVerifyPageProps> = () => {
    const navigate = useNavigate();
    const [searchParams] = useSearchParams();
    const { login } = useAuthContext();
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);
        const mfaType = searchParams.get("type") || "totp";

        const handleSubmit = async (values: { code: string }) => {
        setLoading(true);
        setError(null);
        try {
        // TODO: gọi API verify MFA
        navigate("/dashboard");
        } catch (err: any) {
        setError(err.message || "Mã xác thực không đúng.");
        } finally {
        setLoading(false);
        }
        };

        const resendCode = async () => {
        // TODO: gọi API resend code
        };

        {% if fw == "antd" %}
        const [form] = Form.useForm();
        const fullFormStyle = { minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center",
        background: "#f0f2f5" };
        const cardStyle = { width: 400 };
        const alertStyle = { marginBottom: 16 };
        const inputStyle = { textAlign: "center", fontSize: 24, letterSpacing: 8 };
        const centerStyle = { width: "100%", justifyContent: "center" };
        const codeRule = { required: true, len: 6, message: "Mã phải có 6 chữ số" };

        return (
        <div style={fullFormStyle}>
            <Card style={cardStyle} title={<Typography.Title level={3}>Xác thực hai yếu tố</Typography.Title>}>
                {error &&
                <Alert message={error} type="error" style={alertStyle} />}
                <Typography.Paragraph>
                    Nhập mã xác thực 6 chữ số từ ứng dụng {mfaType.toUpperCase()} của bạn.
                </Typography.Paragraph>
                <Form form={form} onFinish={handleSubmit}>
                    <Form.Item name="code" rules={[codeRule]}>
                        <Input size="large" placeholder="000000" maxLength={6} style={inputStyle} />
                    </Form.Item>
                    <Form.Item>
                        <Button type="primary" htmlType="submit" size="large" block loading={loading}>
                            Xác thực
                        </Button>
                    </Form.Item>
                </Form>
                <Space style={centerStyle}>
                    <a onClick={resendCode}>Gửi lại mã</a>
                </Space>
            </Card>
        </div>
        );
        {% elif fw == "material" %}
        const loginStyle = { mt: 8 };
        const paperStyle = { p: 4 };
        const btnStyle = { mt: 2, mb: 1 };
        const linkStyle = { mt: 2, textAlign: "center" };
        const codeStyle = { textAlign: "center" as const, fontSize: 24, letterSpacing: 8 };
        const emptyValues = { code: "" };

        return (
        <Container maxWidth="sm" sx={loginStyle}>
            <Paper elevation={3} sx={paperStyle}>
                <Typography variant="h4" align="center" gutterBottom>Xác thực hai yếu tố</Typography>
                <Typography paragraph>
                    Nhập mã xác thực 6 chữ số từ ứng dụng {mfaType.toUpperCase()} của bạn.
                </Typography>
                {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}
                <Box component="form" onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                    <TextField fullWidth label="Mã xác thực (6 chữ số)" type="text" maxLength={6} margin="normal"
                        required InputProps={{ style: codeStyle }} />
                    <Button fullWidth variant="contained" type="submit" sx={btnStyle} disabled={loading}>
                        {loading ? "Đang xác thực..." : "Xác thực"}
                    </Button>
                </Box>
                <Box sx={linkStyle}>
                    <a href="#" onClick={(e)=> { e.preventDefault(); resendCode(); }}>Gửi lại mã</a>
                </Box>
            </Paper>
        </Container>
        );
        {% elif fw == "tailwind" %}
        const emptyValues = { code: "" };

        return (
        <div className="min-h-screen flex items-center justify-center bg-gray-50">
            <div className="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow-md">
                <h2 className="text-3xl font-bold text-center">Xác thực hai yếu tố</h2>
                <p className="text-center text-gray-600">
                    Nhập mã xác thực 6 chữ số từ ứng dụng {mfaType.toUpperCase()} của bạn.
                </p>
                {error && <div className="bg-red-100 text-red-700 p-3 rounded">{error}</div>}
                <form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }} className="space-y-4">
                    <input type="text" placeholder="000000" maxLength={6} required
                        className="w-full p-3 border rounded text-center text-2xl tracking-widest" />
                    <button type="submit" disabled={loading}
                        className="w-full p-3 bg-blue-600 text-white rounded hover:bg-blue-700">
                        {loading ? "Đang xác thực..." : "Xác thực"}
                    </button>
                </form>
                <div className="text-center">
                    <a href="#" onClick={(e)=> { e.preventDefault(); resendCode(); }} className="text-blue-600">
                        Gửi lại mã
                    </a>
                </div>
            </div>
        </div>
        );
        {% elif fw == "bootstrap" %}
        const emptyValues = { code: "" };

        return (
        <Container className="d-flex align-items-center justify-content-center" style={{ minHeight: "100vh" }}>
            <Card style={{ maxWidth: 400, width: "100%" }}>
                <Card.Body>
                    <h2 className="text-center">Xác thực hai yếu tố</h2>
                    <p className="text-center text-muted">
                        Nhập mã xác thực 6 chữ số từ ứng dụng {mfaType.toUpperCase()} của bạn.
                    </p>
                    {error && <Alert variant="danger">{error}</Alert>}
                    <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                        <Form.Group className="mb-3">
                            <Form.Control type="text" placeholder="000000" maxLength={6} required
                                className="text-center fw-bold" style={{ fontSize: "1.5rem" , letterSpacing: "0.5em"
                                }} />
                        </Form.Group>
                        <Button variant="primary" type="submit" disabled={loading} className="w-100">
                            {loading ? "Đang xác thực..." : "Xác thực"}
                        </Button>
                    </Form>
                    <div className="text-center mt-3">
                        <a href="#" onClick={(e)=> { e.preventDefault(); resendCode(); }}>Gửi lại mã</a>
                    </div>
                </Card.Body>
            </Card>
        </Container>
        );
        {% elif fw == "carbon" %}
        const emptyValues = { code: "" };

        return (
        <div style={{ minHeight: "100vh" , display: "flex" , alignItems: "center" , justifyContent: "center" }}>
            <Grid condense>
                <Column>
                    <Layer>
                        <div className="cds--content" style={{ maxWidth: 400, width: "100%" }}>
                            <h2 className="cds--text-truncate">Xác thực hai yếu tố</h2>
                            <p>Nhập mã xác thực 6 chữ số từ ứng dụng {mfaType.toUpperCase()} của bạn.</p>
                            {error && (
                            <InlineNotification kind="error" title="Lỗi" lowContrast onClose={()=> setError(null)}>
                                {error}
                            </InlineNotification>
                            )}
                            <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                                <FormGroup>
                                    <TextInput id="code" label="Mã xác thực (6 chữ số)" placeholder="000000"
                                        maxLength={6} required style={{ textAlign: "center" , fontSize: 24,
                                        letterSpacing: 8 }} />
                                </FormGroup>
                                <Button kind="primary" type="submit" disabled={loading} style={{ width: "100%" }}>
                                    {loading ? "Đang xác thực..." : "Xác thực"}
                                </Button>
                            </Form>
                            <div className="cds--list" style={{ marginTop: 16, textAlign: "center" }}>
                                <a href="#" onClick={(e)=> { e.preventDefault(); resendCode(); }}>Gửi lại mã</a>
                            </div>
                        </div>
                    </Layer>
                </Column>
            </Grid>
        </div>
        );
        {% endif %}
        };

        export default MfaVerify;