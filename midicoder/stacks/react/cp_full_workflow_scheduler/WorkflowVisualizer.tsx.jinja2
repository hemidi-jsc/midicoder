/**
* Workflow Visualizer Component — CP13: Background Job & Workflow Generator
*
* React component hiển thị DAG workflow bằng SVG canvas.
* Nodes/edges với status (running/success/failed), click để xem chi tiết.
*/

import React, { useState, useMemo } from 'react';

export type NodeStatus = 'pending' | 'running' | 'success' | 'failed' | 'skipped';
export interface DAGNode { id: string; label: string; type: string; status: NodeStatus; startTime?: string; endTime?:
string; error?: string; }
export interface DAGEdge { from: string; to: string; label?: string; }
export interface WorkflowGraph { workflowId: string; workflowName: string; nodes: DAGNode[]; edges: DAGEdge[];
overallStatus: NodeStatus; }

interface WorkflowVisualizerProps { graph: WorkflowGraph; onNodeClick?: (node: DAGNode) => void; }

const COLORS: Record<NodeStatus, string> = { pending: '#ff9800', running: '#2196f3', success: '#4caf50', failed:
    '#f44336', skipped: '#9e9e9e' };
    const LABELS: Record<NodeStatus, string> = { pending: 'Đang chờ', running: 'Đang chạy', success: 'Thành công',
        failed: 'Thất bại', skipped: 'Bỏ qua' };
        const NW = 140, NH = 50;

        export function WorkflowVisualizer({ graph, onNodeClick }: WorkflowVisualizerProps): JSX.Element {
        const [sel, setSel] = useState<DAGNode | null>(null);

            /** Tính layout topological tự động. */
            const pos = useMemo(() => {
            const p = new Map<string, { x: number; y: number }>();
                const inDeg = new Map<string, number>(), adj = new Map<string, string[]>();
                        graph.nodes.forEach((n) => { inDeg.set(n.id, 0); adj.set(n.id, []); });
                        graph.edges.forEach((e) => { adj.get(e.from)?.push(e.to); inDeg.set(e.to, (inDeg.get(e.to) || 0)
                        + 1); });
                        const q: string[] = []; inDeg.forEach((d, id) => { if (!d) q.push(id); });
                        let lvl = 0;
                        while (q.length) {
                        q.forEach((id, i) => p.set(id, { x: 20 + lvl * 200, y: 20 + i * 80 }));
                        const next: string[] = [];
                        for (const id of q) for (const nb of adj.get(id) || []) { inDeg.set(nb, inDeg.get(nb)! - 1); if
                        (!inDeg.get(nb)!) next.push(nb); }
                        q.length = 0; q.push(...next); lvl++;
                        }
                        const placed = new Set(p.keys());
                        graph.nodes.forEach((n, i) => { if (!placed.has(n.id)) p.set(n.id, { x: 20 + lvl * 200, y: 20 +
                        i * 80 }); });
                        return p;
                        }, [graph]);

                        return (
                        <div style={{ fontFamily: 'system-ui, sans-serif' , border: '1px solid #e0e0e0' , borderRadius:
                            8, padding: 16, background: '#fafafa' }}>
                            <div style={{ display: 'flex' , justifyContent: 'space-between' , alignItems: 'center' ,
                                marginBottom: 16 }}>
                                <h3 style={{ margin: 0, fontSize: '1.1rem' }}>{graph.workflowName}</h3>
                                <span style={{ padding: '4px 12px' , borderRadius: 12, fontSize: '0.8rem' , fontWeight:
                                    600, color: '#fff' , background: COLORS[graph.overallStatus] }}>
                                    {LABELS[graph.overallStatus]}
                                </span>
                            </div>
                            <div style={{ border: '1px solid #ddd' , borderRadius: 4, background: '#fff' , minHeight:
                                300 }}>
                                <svg viewBox="0 0 800 400" style={{ width: '100%' }}>
                                    <defs>
                                        <marker id="wfa" markerWidth="10" markerHeight="7" refX="10" refY="3.5"
                                            orient="auto">
                                            <polygon points="0 0, 10 3.5, 0 7" fill="#999" />
                                        </marker>
                                    </defs>
                                    {graph.edges.map((e, i) => {
                                    const f = pos.get(e.from), t = pos.get(e.to);
                                    if (!f || !t) return null;
                                    return
                                    <line key={`e-${i}`} x1={f.x + NW} y1={f.y + NH / 2} x2={t.x} y2={t.y + NH / 2}
                                        stroke="#999" strokeWidth={2} markerEnd="url(#wfa)" />;
                                    })}
                                    {graph.nodes.map((n) => {
                                    const p = pos.get(n.id); if (!p) return null;
                                    return (
                                    <g key={n.id} transform={`translate(${p.x},${p.y})`} onClick={()=> setSel(n)}
                                        style={{ cursor: 'pointer' }}>
                                        <rect width={NW} height={NH} rx={6} fill="#fff" stroke={COLORS[n.status]}
                                            strokeWidth={2} />
                                        <text x={NW / 2} y={NH / 2 - 4} textAnchor="middle" fontSize={12}
                                            fontWeight={600}>{n.label}</text>
                                        <text x={NW / 2} y={NH / 2 + 12} textAnchor="middle" fontSize={10}
                                            fill="#888">{n.type}</text>
                                        <circle cx={NW - 12} cy={12} r={5} fill={COLORS[n.status]} />
                                    </g>
                                    );
                                    })}
                                </svg>
                            </div>
                            {sel && (
                            <div style={{ marginTop: 16, padding: 16, background: '#fff' , border: '1px solid #ddd' ,
                                borderRadius: 6 }}>
                                <h4>Chi tiết: {sel.label}</h4>
                                <div style={{ display: 'grid' , gridTemplateColumns: '1fr 1fr' , gap: 8,
                                    margin: '12px 0' , fontSize: '0.9rem' }}>
                                    <div><strong>ID:</strong> {sel.id}</div>
                                    <div><strong>Loại:</strong> {sel.type}</div>
                                    <div><strong>Trạng thái:</strong> <span style={{ color: COLORS[sel.status],
                                            fontWeight: 600 }}>{LABELS[sel.status]}</span></div>
                                    {sel.error && <div style={{ color: '#f44336' }}><strong>Lỗi:</strong> {sel.error}
                                    </div>}
                                </div>
                                <button onClick={()=> setSel(null)} style={{ padding: '6px 16px', border: '1px solid
                                    #ccc', borderRadius: 4, background: '#fff', cursor: 'pointer' }}>Đóng</button>
                            </div>
                            )}
                            <div style={{ display: 'flex' , gap: 16, marginTop: 12, fontSize: '0.8rem' , color: '#666'
                                }}>
                                {(Object.keys(COLORS) as NodeStatus[]).map((s) => (
                                <span key={s} style={{ display: 'flex' , alignItems: 'center' , gap: 4 }}>
                                    <span style={{ width: 10, height: 10, borderRadius: '50%' , background: COLORS[s],
                                        display: 'inline-block' }} />
                                    {LABELS[s]}
                                </span>
                                ))}
                            </div>
                        </div>
                        );
                        }

                        export default WorkflowVisualizer;