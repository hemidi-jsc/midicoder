export default DescriptionList;
{% elif ui_framework == "antd" %}import React from 'react';
import { Descriptions, Typography } from 'antd';
import type { SizeType } from 'antd/lib/configPicker';

interface DescriptionItem {
  term: string;
  description: string;
  icon?: React.ReactNode;
}

interface DescriptionListProps {
  items: DescriptionItem[];
  bordered?: boolean;
  column?: number;
  size?: SizeType;
  title?: string;
  className?: string;
}

function DescriptionList({
  items,
  bordered = true,
  column = 1,
  size = 'default',
  title,
  className
}: DescriptionListProps) {
  const itemsList = items.map((item) => ({
    key: item.term,
    label: (
      <span>
        {item.icon && <span className="mr-1">{item.icon}</span>}
        {item.term}
      </span>
    ),
    children: item.description,
  }));

  return (
    <Descriptions
      title={title}
      bordered={bordered}
      column={column}
      size={size}
      className={className}
    >
      {itemsList.map((item) => (
        <Descriptions.Item key={item.label} label={item.label}>
          {item.children}
        </Descriptions.Item>
      ))}
    </Descriptions>
  );
}

export default DescriptionList;
{% elif ui_framework == "carbon" %}import React from 'react';

interface DescriptionItem {
  term: string;
  description: string;
  icon?: React.ReactNode;
}

interface DescriptionListProps {
  items: DescriptionItem[];
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

function DescriptionList({
  items,
  size = 'md',
  className = ''
}: DescriptionListProps) {
  const sizeClasses: Record<string, string> = {
    sm: 'py-2',
    md: 'py-3',
    lg: 'py-4'
  };

  return (
    <dl className={`cds-description-list border border-gray-200 rounded ${className}`}>
      {items.map((item, index) => (
        <div
          key={index}
          className={`
            flex ${sizeClasses[size]}
            ${index % 2 === 1 ? 'bg-gray-50' : ''}
            ${index < items.length - 1 ? 'border-b border-gray-200' : ''}
          `}
        >
          <dt className="w-1/3 px-4 font-medium text-gray-900 cds--label">
            {item.icon && <span className="mr-2">{item.icon}</span>}
            {item.term}
          </dt>
          <dd className="w-2/3 px-4 text-sm text-gray-600">
            {item.description}
          </dd>
        </div>
      ))}
    </dl>
  );
}

export default DescriptionList;
