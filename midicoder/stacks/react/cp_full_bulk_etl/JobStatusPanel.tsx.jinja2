/**
* JobStatusPanel Component — CP38: Data Import/Export/ETL.
*{% raw %}
* UI Framework: {{{ ui_framework }}}{% endraw %}
*
* Hien thi trang thai va tien trinh cua mot job (import/export/ETL).
* Bao gom: thanh tien trinh, badge trang thai mau, thong ke hang,
* danh sach loi, nut huy, va thoi gian. Tu dong lam moi khi job dang chay.
*/

import React, { useEffect, useCallback, useState } from 'react';

{% if ui_framework == "material" %}
import { Card, CardContent, LinearProgress, Chip, Table, TableBody, TableCell, TableContainer, TableHead, TableRow,
Button, Collapse, Typography, IconButton } from '@mui/material';
import { ExpandMore as ExpandMoreIcon, ExpandLess as ExpandLessIcon, Refresh as RefreshIcon, Cancel as CancelIcon } from
'@mui/icons-material';
{% elif ui_framework == "tailwind" %}
// Su dung Tailwind utility classes inline
{% elif ui_framework == "bootstrap" %}
import { Card, ProgressBar, Badge, Button, Table, Collapse } from 'react-bootstrap';
{% elif ui_framework == "antd" %}
import { Card, Progress, Tag, Table, Button, Collapse, Space, Typography } from 'antd';
{% elif ui_framework == "carbon" %}
import { Tile, ProgressBar, Tag, Button, StructuredList, InlineLoading } from '@carbon/react';
{% endif %}
{% raw %}

/* ===== Loại dữ liệu ===== */

/**
* Trạng thái có thể có của một job.
*/
export type JobStatus = 'pending' | 'running' | 'completed' | 'failed' | 'cancelled';

/**
* Một lỗi theo dòng.
*/
export interface RowError {
/** Số dòng trong file. */
rowNumber: number;
/** Tin nhắn lỗi. */
message: string;
}

/**
* Dữ liệu job để hiển thị.
*/
export interface JobStatusData {
/** Định danh job. */
jobKey: string;
/** Trạng thái hiện tại. */
status: JobStatus;
/** Tiến trình phần trăm (0–100). */
progress: number;
/** Tổng số hàng. */
totalRows: number;
/** Số hàng thành công. */
successRows: number;
/** Số hàng thất bại. */
failedRows: number;
/** Số hàng bỏ qua. */
skippedRows: number;
/** Thời gian bắt đầu (ISO 8601). */
startedAt?: string;
/** Thời gian hoàn thành (ISO 8601). */
completedAt?: string;
/** Tin nhắn lỗi tổng quát. */
errorMessage?: string;
/** Danh sách lỗi theo dòng. */
rowErrors?: RowError[];
/** Tên file (nếu có). */
fileName?: string;
/** Tên thực thể (nếu có). */
entity?: string;
}

/**
* Props của JobStatusPanel.
*/
export interface JobStatusPanelProps {
/** Dữ liệu job. Nếu null, không hiển thị gì. */
job: JobStatusData | null;
/** Đang tải dữ liệu job. */
loading?: boolean;
/** Callback khi nhấn nút hủy. */
onCancel?: () => void;
/** Callback khi nhấn nút làm mới. */
onRefresh?: () => void;
/** Callback khi nhấn nút xem lỗi chi tiết. */
onViewErrors?: (errors: RowError[]) => void;
/** Khoảng thời gian tự động làm mới khi job đang chạy (ms). */
autoRefreshInterval?: number;
/** Callback để fetch dữ liệu job mới (dùng cho auto-refresh). */
onAutoRefresh?: () => Promise<JobStatusData | null>;
    /** Class tên tùy chỉnh cho container. */
    className?: string;
    }

    /* ===== Helper ===== */

    /**
    * Định dạng ngày giờ thành chuỗi dễ đọc (tiếng Việt).
    */
    function formatDateTime(isoString?: string): string {
    if (!isoString) return '—';
    try {
    const date = new Date(isoString);
    return date.toLocaleString('vi-VN', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    });
    } catch {
    return isoString;
    }
    }

    /**
    * Trả về class tên cho badge trạng thái dựa trên màu.
    */
    function getStatusBadgeClass(status: JobStatus): string {
    switch (status) {
    case 'completed':
    return 'bg-green-100 text-green-800 border border-green-200';
    case 'running':
    return 'bg-blue-100 text-blue-800 border border-blue-200';
    case 'failed':
    return 'bg-red-100 text-red-800 border border-red-200';
    case 'cancelled':
    return 'bg-gray-100 text-gray-800 border border-gray-200';
    case 'pending':
    default:
    return 'bg-yellow-100 text-yellow-800 border border-yellow-200';
    }
    }

    /**
    * Trả về nhãn tiếng Việt cho trạng thái.
    */
    function getStatusLabel(status: JobStatus): string {
    switch (status) {
    case 'completed':
    return 'Hoàn thành';
    case 'running':
    return 'Đang chạy';
    case 'failed':
    return 'Thất bại';
    case 'cancelled':
    return 'Đã hủy';
    case 'pending':
    default:
    return 'Đang chờ';
    }
    }

    /**
    * Trả về màu cho thanh tiến trình.
    */
    function getProgressBarColor(status: JobStatus): string {
    switch (status) {
    case 'completed':
    return 'bg-green-600';
    case 'running':
    return 'bg-blue-600';
    case 'failed':
    return 'bg-red-600';
    case 'cancelled':
    return 'bg-gray-400';
    case 'pending':
    default:
    return 'bg-yellow-500';
    }
    }

    /* ===== Component ===== */

    /**
    * Component hiển thị trạng thái và tiến trình của một job.
    *
    * Tự động làm mới khi job đang chạy (nếu cung cấp onAutoRefresh).
    *
    * @example
    * ```tsx
    * function MyPage() {
    * const { job, refresh } = useImportJob('my-job-key');
    *
    * return (
    * <JobStatusPanel * job={job} * onCancel={()=> cancelJob()}
        * onRefresh={refresh}
        * />
        * );
        * }
        * ```
        */
        export const JobStatusPanel: React.FC<JobStatusPanelProps> = ({
            job,
            loading = false,
            onCancel,
            onRefresh,
            onViewErrors,
            autoRefreshInterval = 5_000,
            onAutoRefresh,
            className = '',
            }) => {
            // Theo dõi xem có đang mở danh sách lỗi hay không
            const [errorsExpanded, setErrorsExpanded] = useState(false);
            // Theo dõi thời gian đếm ngược cho auto-refresh
            const [countdown, setCountdown] = useState(0);

            /**
            * Tự động làm mới khi job đang chạy.
            */
            useEffect(() => {
            // Chỉ auto-refresh khi job đang chạy và có callback
            if (!job || job.status !== 'running' || !onAutoRefresh) {
            setCountdown(0);
            return;
            }

            setCountdown(autoRefreshInterval / 1000);

            const intervalId = setInterval(() => {
            onAutoRefresh();
            setCountdown(autoRefreshInterval / 1000);
            }, autoRefreshInterval);

            // Đếm ngược
            const countdownId = setInterval(() => {
            setCountdown((prev) => Math.max(0, prev - 1));
            }, 1000);

            return () => {
            clearInterval(intervalId);
            clearInterval(countdownId);
            };
            }, [job?.status, job?.jobKey, onAutoRefresh, autoRefreshInterval]);

            /**
            * Xử lý khi nhấn hủy.
            */
            const handleCancel = useCallback(() => {
            onCancel?.();
            }, [onCancel]);

            /**
            * Xử lý khi nhấn làm mới.
            */
            const handleRefresh = useCallback(() => {
            onRefresh?.();
            setCountdown(0);
            }, [onRefresh]);

            /**
            * Xử lý khi nhấn xem lỗi.
            */
            const handleViewErrors = useCallback(() => {
            if (job?.rowErrors) {
            onViewErrors?.(job.rowErrors);
            }
            setErrorsExpanded((prev) => !prev);
            }, [job?.rowErrors, onViewErrors]);

            // Không hiển thị gì nếu không có job
            if (!job) {
            if (loading) {
            return (
            <div className={`rounded-lg border border-gray-200 bg-white p-6 ${className}`}>
                <div className="animate-pulse space-y-4">
                    <div className="h-4 bg-gray-200 rounded w-1/4"></div>
                    <div className="h-2 bg-gray-200 rounded w-full"></div>
                    <div className="h-4 bg-gray-200 rounded w-1/2"></div>
                </div>
            </div>
            );
            }
            return null;
            }

            const {
            status,
            progress,
            totalRows,
            successRows,
            failedRows,
            skippedRows,
            startedAt,
            completedAt,
            errorMessage,
            rowErrors,
            fileName,
            entity,
            } = job;

            const isRunning = status === 'running';
            const isTerminal = ['completed', 'failed', 'cancelled'].includes(status);
            const hasErrors = (rowErrors?.length ?? 0) > 0;

            return (
            <div className={`rounded-lg border border-gray-200 bg-white shadow-sm ${className}`}>
                {/* ===== Header: Job key, badge, và nút hành động ===== */}
                <div className="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                    <div className="flex items-center gap-3">
                        {/* Badge trạng thái */}
                        <span className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold
                            ${getStatusBadgeClass(status)}`}>
                            {/* Chấm trạng thái — nhấp nháy khi đang chạy */}
                            <span className={`w-2 h-2 rounded-full ${ status==='running' ? 'bg-blue-500 animate-pulse' :
                                status==='completed' ? 'bg-green-500' : status==='failed' ? 'bg-red-500' :
                                status==='cancelled' ? 'bg-gray-500' : 'bg-yellow-500' }`} />
                            {getStatusLabel(status)}
                        </span>

                        {/* Tên thực thể / file */}
                        {(entity || fileName) && (
                        <span className="text-sm text-gray-500">
                            {entity && <span>{entity}</span>}
                            {entity && fileName && <span> &middot; </span>}
                            {fileName && <span className="font-mono text-xs">{fileName}</span>}
                        </span>
                        )}
                    </div>

                    {/* Nút hành động */}
                    <div className="flex items-center gap-2">
                        {/* Nút hủy — chỉ hiển thị khi đang chạy */}
                        {isRunning && onCancel && (
                        <button onClick={handleCancel}
                            className="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-1"
                            title="Hủy job đang chạy">
                            {/* Icon X */}
                            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                strokeWidth={2}>
                                <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            Hủy
                        </button>
                        )}

                        {/* Nút làm mới */}
                        {onRefresh && (
                        <button onClick={handleRefresh} disabled={loading}
                            className="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-50 border border-gray-200 rounded-md hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1"
                            title="Làm mới trạng thái">
                            {/* Icon làm mới */}
                            <svg className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : '' }`} fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
                                <path strokeLinecap="round" strokeLinejoin="round"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            Làm mới
                        </button>
                        )}
                    </div>
                </div>

                {/* ===== Body ===== */}
                <div className="px-6 py-5 space-y-5">
                    {/* --- Thanh tiến trình --- */}
                    <div>
                        <div className="flex items-center justify-between mb-2">
                            <span className="text-sm font-medium text-gray-700">Tiến trình</span>
                            <span className="text-sm font-mono text-gray-900">{Math.round(progress)}%</span>
                        </div>
                        <div className="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden">
                            <div className={`h-2.5 rounded-full transition-all duration-500 ease-out
                                ${getProgressBarColor(status)}`} style={{ width: `${Math.min(100, Math.max(0,
                                progress))}%` }} role="progressbar" aria-valuenow={progress} aria-valuemin={0}
                                aria-valuemax={100} />
                        </div>
                        {/* Đếm ngược auto-refresh khi đang chạy */}
                        {isRunning && countdown > 0 && (
                        <p className="mt-1 text-xs text-gray-400">
                            Tự động làm mới sau {countdown}s
                        </p>
                        )}
                    </div>

                    {/* --- Thống kê hàng --- */}
                    <div>
                        <h4 className="text-sm font-medium text-gray-700 mb-3">Thống kê hàng</h4>
                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                            {/* Tổng số hàng */}
                            <div className="bg-gray-50 rounded-lg p-3 text-center">
                                <p className="text-2xl font-bold text-gray-900">{totalRows.toLocaleString('vi-VN')}</p>
                                <p className="text-xs text-gray-500 mt-1">Tổng số hàng</p>
                            </div>
                            {/* Thành công */}
                            <div className="bg-green-50 rounded-lg p-3 text-center">
                                <p className="text-2xl font-bold text-green-700">{successRows.toLocaleString('vi-VN')}
                                </p>
                                <p className="text-xs text-green-600 mt-1">Thành công</p>
                            </div>
                            {/* Thất bại */}
                            <div className="bg-red-50 rounded-lg p-3 text-center">
                                <p className="text-2xl font-bold text-red-700">{failedRows.toLocaleString('vi-VN')}</p>
                                <p className="text-xs text-red-600 mt-1">Thất bại</p>
                            </div>
                            {/* Bỏ qua */}
                            <div className="bg-yellow-50 rounded-lg p-3 text-center">
                                <p className="text-2xl font-bold text-yellow-700">{skippedRows.toLocaleString('vi-VN')}
                                </p>
                                <p className="text-xs text-yellow-600 mt-1">Bỏ qua</p>
                            </div>
                        </div>
                    </div>

                    {/* --- Tin nhắn lỗi tổng quát --- */}
                    {errorMessage && (
                    <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                        <div className="flex items-start gap-3">
                            {/* Icon lỗi */}
                            <svg className="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" strokeWidth={2}>
                                <path strokeLinecap="round" strokeLinejoin="round"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                            </svg>
                            <div>
                                <p className="text-sm font-medium text-red-800">Lỗi job</p>
                                <p className="text-sm text-red-700 mt-1">{errorMessage}</p>
                            </div>
                        </div>
                    </div>
                    )}

                    {/* --- Danh sách lỗi theo dòng --- */}
                    {hasErrors && (
                    <div>
                        <button onClick={handleViewErrors}
                            className="flex items-center justify-between w-full text-left"
                            aria-expanded={errorsExpanded}>
                            <h4 className="text-sm font-medium text-red-700">
                                Lỗi theo dòng ({rowErrors!.length} lỗi)
                            </h4>
                            {/* Icon mũi tên */}
                            <svg className={`w-4 h-4 text-red-500 transition-transform duration-200 ${ errorsExpanded
                                ? 'rotate-180' : '' }`} fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                strokeWidth={2}>
                                <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>

                        {errorsExpanded && (
                        <div className="mt-3 max-h-60 overflow-y-auto rounded-lg border border-red-200">
                            <table className="min-w-full text-sm">
                                <thead className="bg-red-50">
                                    <tr>
                                        <th className="px-4 py-2 text-left text-xs font-medium text-red-700">Dòng</th>
                                        <th className="px-4 py-2 text-left text-xs font-medium text-red-700">Lỗi</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-red-100 bg-white">
                                    {rowErrors!.map((err, index) => (
                                    <tr key={index} className="hover:bg-red-50">
                                        <td className="px-4 py-2 text-xs font-mono text-red-600 whitespace-nowrap">
                                            Dòng {err.rowNumber}
                                        </td>
                                        <td className="px-4 py-2 text-xs text-red-700">{err.message}</td>
                                    </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                        )}
                    </div>
                    )}

                    {/* --- Thời gian --- */}
                    {isTerminal && (
                    <div>
                        <h4 className="text-sm font-medium text-gray-700 mb-2">Thời gian</h4>
                        <div className="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span className="text-gray-500">Bắt đầu:</span>
                                <span className="ml-2 font-mono text-gray-900">{formatDateTime(startedAt)}</span>
                            </div>
                            <div>
                                <span className="text-gray-500">Hoàn thành:</span>
                                <span className="ml-2 font-mono text-gray-900">{formatDateTime(completedAt)}</span>
                            </div>
                        </div>
                    </div>
                    )}
                </div>

                {/* ===== Footer (chỉ hiển thị cho trạng thái cuối) ===== */}
                {isTerminal && (
                <div className="px-6 py-3 bg-gray-50 border-t border-gray-100 rounded-b-lg">
                    <p className="text-xs text-gray-400">
                        Job <span className="font-mono">{job.jobKey}</span> đã đạt trạng thái cuối:{' '}
                        <strong>{getStatusLabel(status)}</strong>
                    </p>
                </div>
                )}
            </div>
            );
            };

            export default JobStatusPanel;