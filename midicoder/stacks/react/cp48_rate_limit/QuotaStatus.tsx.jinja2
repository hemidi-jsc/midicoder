/**
* QuotaStatus — Hiển thị trạng thái quota còn lại cho các cấp độ khác nhau.
* Sinh bởi CP48 RateLimitEmitter.
*
* Số lượng quota cấu hình: {{ quotas | length }}
* Có quota: {{ has_quotas | lower }}
*/
import React, { useEffect, useState, useMemo, useCallback } from 'react';

/* ======================================================================
* ĐỊNH NGHĨA INTERFACE
* ====================================================================== */

/**
* Một mục quota với thông tin sử dụng
*/
interface QuotaItem {
/** ID cấu hình quota */
config_id: string;
/** Cấp độ: user, tenant, endpoint, global */
level: string;
/** Chu kỳ: minute, hour, day, week, month */
period: string;
/** Số request tối đa */
max_requests: number;
/** ID tenant (nếu có) */
tenant_id: string | null;
/** Endpoint (nếu có) */
endpoint: string | null;
/** Đã bật chưa */
enabled: boolean;
/** Số request hiện tại */
current_usage: number;
/** Số request còn lại */
remaining: number;
/** Tỷ lệ phần trăm đã sử dụng */
usage_percent: number;
/** Có đang bị giới hạn không */
is_limited: boolean;
/** Thời gian reset (ISO string) */
reset_at: string;
}

/**
* Dữ liệu trả về từ API quota
*/
interface QuotaApiResponse {
quotas: Array<{ config_id: string; level: string; period: string; max_requests: number; tenant_id: string | null;
    endpoint: string | null; enabled: boolean; }>;
    usages: Record<string, { current: number; remaining: number; reset_at: string; is_limited: boolean; }>;
        }

        /* ======================================================================
        * STYLE OBJECTS
        * ====================================================================== */

        const sWrap: React.CSSProperties = {
