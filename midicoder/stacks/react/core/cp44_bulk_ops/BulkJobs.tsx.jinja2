/**
 * BulkJobs — Danh sách jobs với lọc, phân trang, sắp xếp.
 * Sinh bởi CP44 BulkOpsEmitter.
 *
 * DLQ enabled: {{ dlq_enabled }}
 * Sử dụng events: {{ use_events }}
 */
import React, { useState, useMemo, useCallback } from 'react';
import { BulkJob, JobStatus } from './useBulkOps';
import { BulkProgress } from './BulkProgress';

/* ---- Props ---- */
export interface BulkJobsProps {
    jobs: BulkJob[];
    loading?: boolean;
    error?: string | null;
    onJobSelect?: (jobId: string) => void;
    onCancelJob?: (jobId: string) => Promise<void>;
}

/* ---- Các trạng thái có thể lọc ---- */
const ALL_STATUSES: (JobStatus | 'all')[] = [
    'all',
    'pending',
    'queued',
    'running',
    'completed',
    'failed',
    'cancelled',
    'timeout',
];

/* Các loại entity mẫu */
const ENTITY_TYPES = ['all', 'user', 'order', 'product', 'invoice', 'invoice_line'];

/* Các hướng sắp xếp */
type SortField = 'created_at' | 'status' | 'progress' | 'total_records';
type SortDirection = 'asc' | 'desc';

/* Kích thước trang mặc định */
const PAGE_SIZES = [10, 25, 50, 100];

/* ---- Style objects ---- */
