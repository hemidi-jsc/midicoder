    fontFamily: 'system-ui, -apple-system, sans-serif',
    backgroundColor: '#fff',
    borderRadius: '12px',
    boxShadow: '0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)',
    overflow: 'hidden',
};

const sToolbar: React.CSSProperties = {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    padding: '16px 20px',
    borderBottom: '1px solid #f3f4f6',
    flexWrap: 'wrap',
};

const sSearchInput: React.CSSProperties = {
    flex: '1 1 200px',
    padding: '8px 12px',
    border: '1px solid #d1d5db',
    borderRadius: '8px',
    fontSize: '14px',
    outline: 'none',
    minWidth: '0',
};

const sSelect: React.CSSProperties = {
    padding: '8px 12px',
    border: '1px solid #d1d5db',
    borderRadius: '8px',
    fontSize: '13px',
    background: '#fff',
    cursor: 'pointer',
    outline: 'none',
};

const sFilterTags: React.CSSProperties = {
    display: 'flex',
    gap: '6px',
    padding: '0 20px 12px',
    flexWrap: 'wrap',
    borderBottom: '1px solid #f3f4f6',
};

