/**
 * BulkDashboard — Bảng điều khiển tổng quan Bulk Operations: stat cards, jobs gần đây, auto-refresh.
 * Sinh bởi CP44 BulkOpsEmitter.
 *
 * Số lượng jobs mẫu: {{ job_count }}
 * Chunk size mặc định: {{ default_chunk_size }}
 * Concurrency mặc định: {{ default_concurrency }}
 * DLQ enabled: {{ dlq_enabled }}
 * Sử dụng events: {{ use_events }}
 * Sử dụng audit: {{ use_audit }}
 */
import React, { useEffect, useState, useMemo, useCallback } from 'react';
import { useBulkOps } from './useBulkOps';
import { BulkProgress, BulkProgressProps } from './BulkProgress';

/* ---- Interface ---- */
interface BulkJobSummary {
    job_id: string;
    entity_type: string;
    action: string;
    status: string;
    total_records: number;
    processed: number;
    succeeded: number;
    failed: number;
    skipped: number;
    entity_ids?: string[];
    created_at: string;
    updated_at: string;
}

/* ---- Style objects — pre-declared để tránh conflict double-brace trong JSX ---- */
