/**
* PaymentDashboard — Bang dieu khien tong quan he thong thanh toan CP45.
* Hien thi thong ke tong hop cung danh sach giao dich gan day.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import { useCallback, useEffect, useMemo, useState } from "react";
import { formatCurrency } from "@/lib/utils";
import { Button, Card, Typography, Chip, Box, Paper, Grid, Table, TableBody, TableCell, TableHead, TableRow,
TableContainer } from '@mui/material';
{% elif ui_framework == "tailwind" %}
import { useCallback, useEffect, useMemo, useState } from "react";
import { formatCurrency } from "@/lib/utils";
// Su dung Tailwind utility classes trong JSX
{% elif ui_framework == "bootstrap" %}
import { useCallback, useEffect, useMemo, useState } from "react";
import { formatCurrency } from "@/lib/utils";
import { Button, Card, Badge, Table } from 'react-bootstrap';
{% elif ui_framework == "antd" %}
import { useCallback, useEffect, useMemo, useState } from "react";
import { formatCurrency } from "@/lib/utils";
import { Button, Card, Typography, Tag, Space, Table } from 'antd';
{% elif ui_framework == "carbon" %}
import { useCallback, useEffect, useMemo, useState } from "react";
import { formatCurrency } from "@/lib/utils";
import { Button, Layer, Tag, Tile, DataTable, DataTableBody, DataTableRow, TableHeader, TableHeaderCell, TableRow } from
'@carbon/react';
{% endif %}

{% raw %}
// ============================================================================
// Dinh nghia loai du lieu cho bang dieu thanh toan
// ============================================================================

/** Trạng thái giao dịch thanh toán */
export enum PaymentStatus {
Pending = "pending",
Processing = "processing",
Completed = "completed",
Failed = "failed",
Refunded = "refunded",
}

/** Kênh thanh toán được hỗ trợ */
export enum PaymentChannel {
Card = "card",
BankTransfer = "bank_transfer",
EWallet = "ewallet",
Crypto = "crypto",
}

/** Thống kê tổng hợp thanh toán */
export interface PaymentStats {
totalRevenue: number;
pendingAmount: number;
failedCount: number;
successRate: number;
transactionCount: number;
refundedAmount: number;
}

/** Giao dịch thanh toán gần đây */
export interface RecentTransaction {
id: string;
amount: number;
currency: string;
status: PaymentStatus;
channel: PaymentChannel;
customerName: string;
customerEmail: string;
createdAt: string;
description: string;
}

/** Dạng màu hiển thị trạng thái giao dịch */
const STATUS_STYLE: Record<PaymentStatus, { bg: string; text: string; label: string }> = {
    [PaymentStatus.Pending]: { bg: "bg-yellow-100", text: "text-yellow-800", label: "Đang chờ xử lý" },
    [PaymentStatus.Processing]: { bg: "bg-blue-100", text: "text-blue-800", label: "Đang xử lý" },
    [PaymentStatus.Completed]: { bg: "bg-green-100", text: "text-green-800", label: "Hoàn tất" },
    [PaymentStatus.Failed]: { bg: "bg-red-100", text: "text-red-800", label: "Thất bại" },
    [PaymentStatus.Refunded]: { bg: "bg-gray-100", text: "text-gray-800", label: "Đã hoàn tiền" },
    };

    /** Dạng biểu tượng kênh thanh toán */
    const CHANNEL_ICON: Record<PaymentChannel, string> = {
        [PaymentChannel.Card]: "💳",
        [PaymentChannel.BankTransfer]: "🏦",
        [PaymentChannel.EWallet]: "👛",
        [PaymentChannel.Crypto]: "₿",
        };

        // ============================================================================
        // Thành phần thẻ thống kê tổng hợp
        // ============================================================================

        function StatCard({
        title,
        value,
        icon,
        trend,
        trendUp,
        }: {
        title: string;
        value: string;
        icon: string;
        trend?: string;
        trendUp?: boolean;
        }) {
        return (
        <div className="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div className="flex items-center justify-between">
                <div>
                    <p className="text-sm font-medium text-gray-500">{title}</p>
                    <p className="mt-2 text-3xl font-bold text-gray-900">{value}</p>
                    {trend && (
                    <p className={`mt-1 text-sm ${trendUp ? "text-green-600" : "text-red-600" }`}>
                        {trendUp ? "↑" : "↓"} {trend}
                    </p>
                    )}
                </div>
                <span className="text-4xl">{icon}</span>
            </div>
        </div>
        );
        }

        // ============================================================================
        // Thành phần hàng trạng thái giao dịch
        // ============================================================================

        function TransactionBadge({ status }: { status: PaymentStatus }) {
        const style = STATUS_STYLE[status];
        return (
        <span className={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${style.bg}
            ${style.text}`}>
            {style.label}
        </span>
        );
        }

        // ============================================================================
        // Thành phần bảng điều thanh toán chính
        // ============================================================================

        /**
        * PaymentDashboard — Bảng điều khiển tổng quan hệ thống thanh toán CP45.
        * Hiển thị thống kê tổng hợp cùng danh sách giao dịch gần đây.
        */
        export default function PaymentDashboard() {
        const [stats, setStats] = useState<PaymentStats | null>(null);
            const [transactions, setTransactions] = useState<RecentTransaction[]>([]);
                const [isLoading, setIsLoading] = useState(true);
                const [refreshInterval, setRefreshInterval] = useState(30);

                /** Lấy dữ liệu thống kê từ API */
                const fetchStats = useCallback(async () => {
                try {
                const response = await fetch("/api/cp45/payment/stats");
                if (!response.ok) {
                throw new Error(`Lấy thống kê thất bại: ${response.status}`);
                }
                const data = await response.json();
                setStats(data);
                } catch (error) {
                console.error("Lỗi lấy thống kê thanh toán:", error);
                } finally {
                setIsLoading(false);
                }
                }, []);

                /** Lấy danh sách giao dịch gần đây từ API */
                const fetchRecentTransactions = useCallback(async () => {
                try {
                const response = await fetch("/api/cp45/payment/transactions?limit=10");
                if (!response.ok) {
                throw new Error(`Lấy giao dịch thất bại: ${response.status}`);
                }
                const data = await response.json();
                setTransactions(data);
                } catch (error) {
                console.error("Lỗi lấy giao dịch gần đây:", error);
                }
                }, []);

                /** Tự động làm mới dữ liệu theo chu kỳ */
                useEffect(() => {
                fetchStats();
                fetchRecentTransactions();

                const interval = setInterval(() => {
                fetchStats();
                fetchRecentTransactions();
                }, refreshInterval * 1000);

                return () => clearInterval(interval);
                }, [fetchStats, fetchRecentTransactions, refreshInterval]);

                /** Tính toán tỷ lệ thành công từ dữ liệu thống kê */
                const calculatedSuccessRate = useMemo(() => {
                if (!stats) return "0.0";
                const rate = stats.successRate;
                return `${rate.toFixed(1)}%`;
                }, [stats]);

                /** Xử lý thay đổi chu kỳ làm mới */
                const handleRefreshChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
                    setRefreshInterval(Number(e.target.value));
                    };

                    if (isLoading && !stats) {
                    return (
                    <div className="flex h-96 items-center justify-center">
                        <div className="text-center">
                            <div
                                className="mx-auto h-12 w-12 animate-spin rounded-full border-4 border-gray-300 border-t-blue-600" />
                            <p className="mt-4 text-sm text-gray-500">Đang tải dữ liệu thanh toán...</p>
                        </div>
                    </div>
                    );
                    }

                    return (
                    <div className="space-y-6 p-6">
                        {/* Tiêu đề trang */}
                        <div className="flex items-center justify-between">
                            <div>
                                <h1 className="text-2xl font-bold text-gray-900">
                                    Bảng Điều Khiển Thanh Toán
                                </h1>
                                <p className="mt-1 text-sm text-gray-500">
                                    Tổng quan hệ thống thanh toán CP45 Payment Gateway
                                </p>
                            </div>
                            <select value={refreshInterval} onChange={handleRefreshChange}
                                className="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                aria-label="Chu kỳ làm mới dữ liệu">
                                <option value={15}>15 giây</option>
                                <option value={30}>30 giây</option>
                                <option value={60}>1 phút</option>
                                <option value={300}>5 phút</option>
                            </select>
                        </div>

                        {/* Lưới thẻ thống kê tổng hợp */}
                        {stats && (
                        <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            <StatCard title="Doanh thu tổng" value={formatCurrency(stats.totalRevenue)} icon="💰"
                                trend="12.5%" trendUp={true} />
                            <StatCard title="Số lượng giao dịch" value={stats.transactionCount.toLocaleString("vi-VN")}
                                icon="📊" trend="8.2%" trendUp={true} />
                            <StatCard title="Tỷ lệ thành công" value={calculatedSuccessRate} icon="✅" trend="1.3%"
                                trendUp={true} />
                            <StatCard title="Số tiền đang chờ" value={formatCurrency(stats.pendingAmount)} icon="⏳" />
                            <StatCard title="Giao dịch thất bại" value={stats.failedCount.toLocaleString("vi-VN")}
                                icon="❌" trend="3.1%" trendUp={false} />
                            <StatCard title="Số tiền hoàn tiền" value={formatCurrency(stats.refundedAmount)}
                                icon="💸" />
                        </div>
                        )}

                        {/* Bảng giao dịch gần đây */}
                        <div className="rounded-xl border border-gray-200 bg-white shadow-sm">
                            <div className="border-b border-gray-200 px-6 py-4">
                                <h2 className="text-lg font-semibold text-gray-900">
                                    Giao Dịch Gần Đây
                                </h2>
                            </div>
                            <div className="overflow-x-auto">
                                <table className="min-w-full divide-y divide-gray-200">
                                    <thead className="bg-gray-50">
                                        <tr>
                                            <th
                                                className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Mã Giao Dịch
                                            </th>
                                            <th
                                                className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Khách Hàng
                                            </th>
                                            <th
                                                className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Kênh
                                            </th>
                                            <th
                                                className="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Số Tiền
                                            </th>
                                            <th
                                                className="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Trạng Thái
                                            </th>
                                            <th
                                                className="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
                                                Ngày Tạo
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody className="divide-y divide-gray-200 bg-white">
                                        {transactions.length === 0 ? (
                                        <tr>
                                            <td colSpan={6} className="px-6 py-12 text-center text-sm text-gray-500">
                                                Không có giao dịch nào
                                            </td>
                                        </tr>
                                        ) : (
                                        transactions.map((tx) => (
                                        <tr key={tx.id} className="hover:bg-gray-50">
                                            <td
                                                className="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                                                {tx.id}
                                            </td>
                                            <td className="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                                <div>
                                                    <p className="font-medium">{tx.customerName}</p>
                                                    <p className="text-xs text-gray-400">{tx.customerEmail}</p>
                                                </div>
                                            </td>
                                            <td className="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                                <span className="flex items-center gap-2">
                                                    <span>{CHANNEL_ICON[tx.channel]}</span>
                                                    <span>
                                                        {tx.channel === PaymentChannel.Card
                                                        ? "Thẻ"
                                                        : tx.channel === PaymentChannel.BankTransfer
                                                        ? "Chuyển khoản"
                                                        : tx.channel === PaymentChannel.EWallet
                                                        ? "Ví điện tử"
                                                        : "Tiền ảo"}
                                                    </span>
                                                </span>
                                            </td>
                                            <td
                                                className="whitespace-nowrap px-6 py-4 text-right text-sm font-medium text-gray-900">
                                                {formatCurrency(tx.amount, tx.currency)}
                                            </td>
                                            <td className="whitespace-nowrap px-6 py-4 text-center">
                                                <TransactionBadge status={tx.status} />
                                            </td>
                                            <td className="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                                                {new Date(tx.createdAt).toLocaleString("vi-VN")}
                                            </td>
                                        </tr>
                                        ))
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    );
                    }
                    {% endraw %}