import React from "react";

{% if ui_framework == "material" %}
import { Box as MuiBox } from "@mui/material";
{% elif ui_framework == "carbon" %}
import { Box as CarbonBox } from "@carbon/react";
{% endif %}

export interface BoxProps {
  width?: string | number;
  height?: string | number;
  padding?: string | number;
  margin?: string | number;
  borderRadius?: string | number;
  display?: string;
  backgroundColor?: string;
  overflow?: string;
  textAlign?: 'left' | 'center' | 'right';
  children?: React.ReactNode;
  className?: string;
  style?: React.CSSProperties;
  [key: string]: any;
}

export const Box: React.FC<BoxProps> = ({
  width = 'auto',
  height = 'auto',
  padding = 0,
  margin = 0,
  borderRadius = 0,
  display = 'block',
  backgroundColor = '',
  overflow = 'visible',
  textAlign = 'left',
  children,
  className = '',
  style,
  ...rest
}) => {
  {% if ui_framework == "material" %}
  const boxStyle: React.CSSProperties = {
    width: width !== 'auto' ? width : undefined,
    height: height !== 'auto' ? height : undefined,
    padding: padding !== 0 ? padding : undefined,
    margin: margin !== 0 ? margin : undefined,
    borderRadius: borderRadius !== 0 ? borderRadius : undefined,
    display,
    backgroundColor: backgroundColor || undefined,
    overflow: overflow !== 'visible' ? overflow : undefined,
    textAlign: textAlign !== 'left' ? textAlign : undefined,
    ...style
  };

  return (
    <MuiBox className={className} style={boxStyle} {...rest}>
      {children}
    </MuiBox>
  );
  {% elif ui_framework == "tailwind" %}
  const paddingMap: Record<number, string> = {
    0: 'p-0', 1: 'p-1', 2: 'p-2', 3: 'p-3', 4: 'p-4',
    6: 'p-6', 8: 'p-8', 12: 'p-12', 16: 'p-16'
  };
  const marginMap: Record<number, string> = {
    0: 'm-0', 1: 'm-1', 2: 'm-2', 3: 'm-3', 4: 'm-4',
    6: 'm-6', 8: 'm-8', 12: 'm-12', 16: 'm-16'
  };
  const radiusMap: Record<number, string> = {
    0: 'rounded-none', 4: 'rounded-sm', 8: 'rounded',
    12: 'rounded-lg', 16: 'rounded-xl', 9999: 'rounded-full'
  };

  let baseClass = 'box-border';
  if (typeof width === 'number') baseClass += ` w-${width}`;
  if (typeof height === 'number') baseClass += ` h-${height}`;
  if (typeof padding === 'number') baseClass += ` ${paddingMap[padding] || 'p-' + padding}`;
  if (typeof margin === 'number') baseClass += ` ${marginMap[margin] || 'm-' + margin}`;
  if (typeof borderRadius === 'number') baseClass += ` ${radiusMap[borderRadius] || 'rounded-' + borderRadius}`;
  if (display === 'flex') baseClass += ' flex';
  else if (display === 'grid') baseClass += ' grid';
  baseClass += ` text-${textAlign}`;

  const boxStyle: React.CSSProperties = {
    width: typeof width === 'string' ? width : undefined,
    height: typeof height === 'string' ? height : undefined,
    backgroundColor,
    overflow,
    ...style
  };

  return (
    <div className={`${baseClass} ${className}`} style={boxStyle} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "bootstrap" %}
  const paddingMap: Record<number, string> = {
    0: 'p-0', 1: 'p-1', 2: 'p-2', 3: 'p-3', 4: 'p-4', 5: 'p-5'
  };
  const marginMap: Record<number, string> = {
    0: 'm-0', 1: 'm-1', 2: 'm-2', 3: 'm-3', 4: 'm-4', 5: 'm-5'
  };
  const radiusMap: Record<number, string> = {
    0: 'rounded-0', 1: 'rounded-1', 2: 'rounded-2', 3: 'rounded-3', 4: 'rounded-circle'
  };

  let baseClass = '';
  if (typeof padding === 'number') baseClass += ` ${paddingMap[padding] || 'p-3'}`;
  if (typeof margin === 'number') baseClass += ` ${marginMap[margin] || 'm-3'}`;
  if (typeof borderRadius === 'number') baseClass += ` ${radiusMap[borderRadius] || 'rounded'}`;
  if (display === 'flex') baseClass += ' d-flex';
  else if (display === 'grid') baseClass += ' d-grid';
  baseClass += ` text-${textAlign}`;

  const boxStyle: React.CSSProperties = {
    width: width !== 'auto' ? width : undefined,
    height: height !== 'auto' ? height : undefined,
    backgroundColor,
    overflow,
    ...style
  };

  return (
    <div className={`${baseClass} ${className}`} style={boxStyle} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "antd" %}
  const boxStyle: React.CSSProperties = {
    width: width !== 'auto' ? (typeof width === 'number' ? `${width}px` : width) : undefined,
    height: height !== 'auto' ? (typeof height === 'number' ? `${height}px` : height) : undefined,
    padding: padding !== 0 ? (typeof padding === 'number' ? `${padding}px` : padding) : undefined,
    margin: margin !== 0 ? (typeof margin === 'number' ? `${margin}px` : margin) : undefined,
    borderRadius: borderRadius !== 0 ? (typeof borderRadius === 'number' ? `${borderRadius}px` : borderRadius) : undefined,
    display,
    backgroundColor: backgroundColor || undefined,
    overflow: overflow !== 'visible' ? overflow : undefined,
    textAlign: textAlign !== 'left' ? textAlign : undefined,
    ...style
  };

  return (
    <div className={`midicoder-box ${className}`} style={boxStyle} {...rest}>
      {children}
    </div>
  );
  {% elif ui_framework == "carbon" %}
  const boxStyle: React.CSSProperties = {
    width: width !== 'auto' ? (typeof width === 'number' ? `${width}px` : width) : undefined,
    height: height !== 'auto' ? (typeof height === 'number' ? `${height}px` : height) : undefined,
    padding: padding !== 0 ? (typeof padding === 'number' ? `${padding}px` : padding) : undefined,
    margin: margin !== 0 ? (typeof margin === 'number' ? `${margin}px` : margin) : undefined,
    borderRadius: borderRadius !== 0 ? (typeof borderRadius === 'number' ? `${borderRadius}px` : borderRadius) : undefined,
    display,
    backgroundColor: backgroundColor || undefined,
    overflow: overflow !== 'visible' ? overflow : undefined,
    textAlign: textAlign !== 'left' ? textAlign : undefined,
    ...style
  };

  return (
    <CarbonBox className={className} style={boxStyle} {...rest}>
      {children}
    </CarbonBox>
  );
  {% endif %}
};

Box.displayName = 'Box';

export default Box;
