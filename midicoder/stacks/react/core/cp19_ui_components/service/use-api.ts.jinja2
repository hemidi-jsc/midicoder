import { useState, useEffect, useCallback } from 'react';
import { message as antdMessage } from 'antd';
const API_BASE = '{% if api_base_url %}{{ api_base_url }}{% else %}''{% endif %}';

export interface FetchState<T> { data: T | null; loading: boolean; error: Error | null; refetch: () => Promise<void>; }

export function useGet<T>(url: string): FetchState<T> {
  const [state, setState] = useState<FetchState<T>>({ data: null, loading: true, error: null, refetch: async () => {} });
  const fetchData = useCallback(async () => {
    setState((prev) => ({ ...prev, loading: true, error: null }));
    try {
      const r = await fetch(`${API_BASE}${url}`);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const json: T = await r.json();
      setState({ data: json, loading: false, error: null, refetch: fetchData });
    } catch (err) {
      antdMessage.error((err as Error).message);
      setState((prev) => ({ ...prev, loading: false, error: err as Error, refetch: fetchData }));
    }
  }, [url]);
  useEffect(() => { fetchData(); }, [fetchData]);
  return { ...state, refetch: fetchData };
}

export function useMutation<T>() {
  const [loading, setLoading] = useState(false);
  const execute = useCallback(async (url: string, method: string, body?: T) => {
    setLoading(true);
    try {
      const r = await fetch(`${API_BASE}${url}`, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return await r.json();
    } finally { setLoading(false); }
  }, []);
  return { execute, loading };
}

export function useAuth() {
  const [token, setToken] = useState<string | null>(() => { try { return localStorage.getItem('auth_token'); } catch { return null; } });
  const logout = useCallback(() => { localStorage.removeItem('auth_token'); setToken(null); }, []);
  return { token, isAuthenticated: !!token, logout };
}

