/** Icon Component - Renders icons from various icon libraries. */

import React from "react";

export interface IconProps {
  name: string;
  size?: number | string;
  color?: string;
  className?: string;
  onClick?: () => void;
}

export const Icon: React.FC<IconProps> = ({
  name,
  size = 24,
  color,
  className = '',
  onClick,
}) => {
  {% if ui_framework == "material" %}
  const iconModule = await import('@mui/icons-material');
  const IconComponent = (iconModule as any)[name] || (iconModule as any).Info;

  return (
    <IconComponent
      sx={% raw %}{{ fontSize: size, color: color || 'inherit' }}{% endraw %}
      className={className}
      onClick={onClick}
    />
  );
  {% elif ui_framework == "tailwind" %}
  const svgIcons: Record<string, React.ReactNode> = {
    check: (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} style={% raw %}{{ width: size, height: size, color }}{% endraw %}>
        <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    ),
    close: (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} style={% raw %}{{ width: size, height: size, color }}{% endraw %}>
        <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    ),
    search: (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} style={% raw %}{{ width: size, height: size, color }}{% endraw %}>
        <circle cx="11" cy="11" r="8" /><path strokeLinecap="round" d="M21 21l-4.35-4.35" />
      </svg>
    ),
    menu: (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} style={% raw %}{{ width: size, height: size, color }}{% endraw %}>
        <path strokeLinecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    ),
    info: (
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} style={% raw %}{{ width: size, height: size, color }}{% endraw %}>
        <circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" />
      </svg>
    ),
  };

  return (
    <span
      className={`inline-flex items-center justify-center ${className}`}
      style={% raw %}{{ width: '1em', height: '1em', flexShrink: 0, color }}{% endraw %}
      onClick={onClick}
    >
      {svgIcons[name] || name}
    </span>
  );
  {% elif ui_framework == "bootstrap" %}
  const iconClassMap: Record<string, string> = {
    check: 'bi-check-circle',
    close: 'bi-x-circle',
    search: 'bi-search',
    menu: 'bi-list',
    info: 'bi-info-circle',
    warning: 'bi-exclamation-triangle',
    error: 'bi-exclamation-circle',
    settings: 'bi-gear',
    user: 'bi-person',
  };

  return (
    <span
      className={`bi ${iconClassMap[name] || 'bi-info-circle'} ${className}`}
      style={% raw %}{{ fontSize: typeof size === 'number' ? `${size}px` : size, color }}{% endraw %}
      onClick={onClick}
    />
  );
  {% elif ui_framework == "antd" %}
  import { Icons } from 'antd';

  // Map common icon names to Ant Design icons
  const iconMap: Record<string, React.ComponentType<any>> = {
    check: Icons.CheckCircleOutlined,
    close: Icons.CloseOutlined,
    search: Icons.SearchOutlined,
    menu: Icons.MenuOutlined,
    info: Icons.InfoCircleOutlined,
    warning: Icons.WarningOutlined,
    error: Icons.CloseCircleOutlined,
    settings: Icons.SettingsOutlined,
    user: Icons.UserOutlined,
  };

  const IconComponent = iconMap[name];

  return (
    <span
      className={`anticon ${clas{% raw %}{{ fontSize: typeof size === 'number' ? `${size}px` : size, color }}{% endraw %}}px` : size, color }}
      onClick={onClick}
    >
      {IconComponent ? <IconComponent /> : name}
    </span>
  );
  {% elif ui_framework == "carbon" %}
  import { icons } from '@carbon/react/icons';

  // Carbon icon names follow pattern: {Name}20, {Name}24, {Name}32
  const sizeMap: Record<number | string, string> = {
    16: '16',
    20: '20',
    24: '24',
    32: '32',
  };

  const carbonSize = sizeMap[size] || '24';
  const iconName = `${name.charAt(0).toUpperCase()}${name.slice(1)}${carbonSize}` as keyof typeof icons;
  const iconSvg = icons[iconName];

  return (
    <svg
      className={`cds--icon{% raw %}{{ width: `${size}px`, height: `${size}px`, fill: color || 'currentColor' }}{% endraw %}size}px`, fill: color || 'currentColor' }}
      viewBox="0 0 32 32"
      aria-hidden="true"
      onClick={onClick}
    >
      {iconSvg ? (
        <use xlinkHref={`#${iconName}`} />
      ) : (
        <circle cx="16" cy="16" r="8" />
      )}
    </svg>
  );
  {% endif %}
};

export default Icon;
