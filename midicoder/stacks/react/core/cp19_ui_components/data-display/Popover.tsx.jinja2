export default Popover;
{% elif ui_framework == "carbon" %}import React, { useState, useRef, useEffect } from 'react';

interface PopoverProps {
  label?: string;
  description?: string;
  align?: 'top' | 'right' | 'bottom' | 'left';
  dropShadow?: boolean;
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  triggerAction?: 'click' | 'enter' | 'hover';
  children: React.ReactNode;
  content?: React.ReactNode;
  className?: string;
}

function Popover({
  label,
  description,
  align = 'bottom',
  dropShadow = true,
  size = 'sm',
  triggerAction = 'click',
  children,
  content,
  className = ''
}: PopoverProps) {
  const [isOpen, setIsOpen] = useState(false);
  const popoverRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (popoverRef.current && !popoverRef.current.contains(event.target as Node)) {
        setIsOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const toggle = () => {
    setIsOpen(!isOpen);
  };

  const sizeClasses: Record<string, string> = {
    sm: 'w-64',
    md: 'w-80',
    lg: 'w-96',
    xl: 'w-[28rem]',
    '2xl': 'w-[32rem]'
  };

  const alignClasses: Record<string, string> = {
    top: 'bottom-full left-1/2 -translate-x-1/2 mb-3',
    right: 'left-full top-0 ml-3',
    bottom: 'top-full left-1/2 -translate-x-1/2 mt-3',
    left: 'right-full top-0 mr-3'
  };

  return (
    <div
      className={`relative inline-block ${className}`}
      onClick={toggle}
      onMouseEnter={() => triggerAction === 'hover' && setIsOpen(true)}
      onMouseLeave={() => triggerAction === 'hover' && setIsOpen(false)}
      ref={popoverRef}
    >
      {children}
      {isOpen && (
        <div
          className={`absolute z-50 ${alignClasses[align]} ${sizeClasses[size]} bg-white rounded border border-gray-200 ${dropShadow ? 'shadow-lg' : ''}`}
          role="dialog"
        >
          <div className="p-4">
            {label && <h3 className="text-base font-semibold cds--title">{label}</h3>}
            {description && <p className="text-sm text-gray-600 mt-1">{description}</p>}
            {content && <div className="mt-3">{content}</div>}
          </div>
        </div>
      )}
    </div>
  );
}

export default Popover;
{% else %}import React, { useState } from 'react';

interface PopoverProps {
  title?: string;
  content?: string;
  placement?: 'top' | 'bottom' | 'left' | 'right';
  trigger?: 'hover' | 'click';
  children: React.ReactNode;
  className?: string;
}

function Popover({
  title,
  content,
  placement = 'bottom',
  trigger = 'click',
  children,
  className = ''
}: PopoverProps) {
  const [visible, setVisible] = useState(false);

  const toggle = () => {
    if (trigger === 'click') {
      setVisible(!visible);
    }
  };

  return (
    <div
      className={`relative inline-block ${className}`}
      onClick={toggle}
      onMouseEnter={() => trigger === 'hover' && setVisible(true)}
      onMouseLeave={() => trigger === 'hover' && setVisible(false)}
    >
      {children}
      {visible && (
        <div className="absolute z-50 top-full left-1/2 -translate-x-1/2 mt-2 w-64 bg-white border rounded shadow-lg p-4">
          {title && <h3 className="font-semibold mb-2">{title}</h3>}
          {content && <p className="text-sm">{content}</p>}
        </div>
      )}
    </div>
  );
}

export default Popover;
{% endif %}
