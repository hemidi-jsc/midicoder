{% elif ui_framework == "antd" %}import React from 'react';
import { Card, Col, Row, Button, Typography, Space, Pagination } from 'antd';
import type { SizeType } from 'antd/lib/configPicker';

const { Title, Text } = Typography;

interface CardItem {
  id: string;
  title: string;
  subtitle?: string;
  description?: string;
  imageUrl?: string;
  imageAlt?: string;
  actions?: { label: string; icon?: React.ReactNode; onClick: () => void }[];
  [key: string]: any;
}

interface Action {
  label: string;
  icon?: React.ReactNode;
  onClick: () => void;
}

interface CardListProps {
  items?: CardItem[];
  title?: string;
  columns?: number;
  bordered?: boolean;
  hoverable?: boolean;
  size?: SizeType;
  paginated?: boolean;
  pageSize?: number;
  className?: string;
  style?: React.CSSProperties;
  emptyText?: string;
}

function CardList({
  items = [],
  title,
  columns = 3,
  bordered = true,
  hoverable = false,
  size = 'default',
  paginated = false,
  pageSize = 12,
  className,
  style,
  emptyText = 'No items found'
}: CardListProps) {
  const [page, setPage] = React.useState(1);

  const paginatedItems = paginated
    ? items.slice((page - 1) * pageSize, page * pageSize)
    : items;

  const totalPages = paginated ? Math.ceil(items.length / pageSize) : 1;

  const span = Math.floor(24 / columns);

  return (
    <div className={className} style={style}>
      {title && <Title level={3}>{title}</Title>}
      {paginatedItems.length === 0 ? (
        <Text type="secondary">{emptyText}</Text>
      ) : (
        <>
          <Row gutter=% raw %}{{ xs: 8, sm: 16, md: 16, lg: 24 }}{% endraw %}>
            {paginatedItems.map((item) => (
              <Col key={item.id} xs={24} sm={span}>
                <Card
                  title={item.title}
                  bordered={bordered}
                  hoverable={hoverable}
                  size={size}
                  cover={item.imageUrl ? <img alt={item.imageAlt || ''} src={item.imageUrl} /> : undefined}
                >
                  {item.subtitle && <Text type="secondary">{item.subtitle}</Text>}
                  {item.description && <p>{item.description}</p>}
                  {item.actions && item.actions.length > 0 && (
                    <Space>
                      {item.actions.map((action: Action, index: number) => (
                        <Button key={index} type="text" icon={action.icon} onClick={action.onClick}>
                          {action.label}
                        </Button>
                      ))}
                    </Space>
                  )}
                </Card>
              </Col>
            ))}
          </Row>
          {paginated && totalPages > 1 && (
            <div style=% raw %}{{ textAlign: 'center', marginTop: 16 }}{% endraw %}>
              <Pagination
                current={page}
                total={items.length}
                pageSize={pageSize}
                onChange={setPage}
              />
            </div>
          )}
        </>
      )}
    </div>
  );
}

export default CardList;
