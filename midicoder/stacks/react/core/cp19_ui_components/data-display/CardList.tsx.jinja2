{% if ui_framework == "material" %}import React from 'react';
import {
  Card,
  CardMedia,
  CardContent,
  CardActions,
  CardHeader,
  Typography,
  Button,
  Grid,
  Box,
  Divider,
  Pagination,
  SortDirection,
} from '@mui/material';
import { Sort as SortIcon } from '@mui/icons-material';
import type { SxProps, Theme } from '@mui/material/styles';

interface CardItem {
  id: string;
  title: string;
  subtitle?: string;
  description?: string;
  imageUrl?: string;
  imageAlt?: string;
  actions?: { label: string; icon?: React.ReactNode; onClick: () => void }[];
  [key: string]: any;
}

interface Action {
  label: string;
  icon?: React.ReactNode;
  onClick: () => void;
}

interface CardListProps {
  items?: CardItem[];
  title?: string;
  columns?: number;
  variant?: 'grid' | 'list' | 'wrap';
  paginated?: boolean;
  pageSize?: number;
  sortable?: boolean;
  sx?: SxProps<Theme>;
  className?: string;
  emptyText?: string;
  onSort?: (key: string, direction: SortDirection) => void;
}

function CardList({
  items = [],
  title,
  columns = 3,
  variant = 'grid',
  paginated = false,
  pageSize = 12,
  sortable = false,
  sx,
  className,
  emptyText = 'No items found',
  onSort
}: CardListProps) {
  const [page, setPage] = React.useState(1);

  const paginatedItems = paginated
    ? items.slice((page - 1) * pageSize, page * pageSize)
    : items;

  const totalPages = paginated ? Math.ceil(items.length / pageSize) : 1;

  const xs = Math.max(12 / columns, 1);

  return (
    <Box sx={sx} className={className}>
      {title && (
        <Typography variant="h5" component="h2" gutterBottom>
          {title}
        </Typography>
      )}
      {paginatedItems.length === 0 ? (
        <Typography color="text.secondary">{emptyText}</Typography>
      ) : (
        <>
          <Grid container spacing={2}>
            {paginatedItems.map((item) => (
              <Grid item xs={12} sm={6} md={xs} key={item.id}>
                <Card variant="elevated">
                  {item.imageUrl && (
                    <CardMedia
                      component="img"
                      height="200"
                      image={item.imageUrl}
                      alt={item.imageAlt || ''}
                    />
                  )}
                  {(item.title || item.subtitle) && (
                    <CardHeader
                      title={item.title}
                      subheader={item.subtitle}
                      titleTypographyProps=% raw %>{{ variant: 'h6' }}{% endraw %}
                      subheaderTypographyProps=% raw %>{{ variant: 'body2' }}{% endraw %}
                    />
                  )}
                  {item.description && (
                    <CardContent>
                      <Typography variant="body2" color="text.secondary">
                        {item.description}
                      </Typography>
                    </CardContent>
                  )}
                  {item.actions && item.actions.length > 0 && (
                    <>
                      <Divider />
                      <CardActions>
                        {item.actions.map((action: Action, index: number) => (
                          <Button key={index} size="small" onClick={action.onClick} startIcon={action.icon}>
                            {action.label}
                          </Button>
                        ))}
                      </CardActions>
                    </>
                  )}
                </Card>
              </Grid>
            ))}
          </Grid>
          {paginated && totalPages > 1 && (
            <Box sx=% raw %}{{ mt: 2, display: 'flex', justifyContent: 'center' }}{% endraw %}>
              <Pagination
                count={totalPages}
                page={page}
                onChange={(_event, value) => setPage(value)}
                color="primary"
              />
            </Box>
          )}
        </>
      )}
    </Box>
  );
}

export default CardList;
{% elif ui_framework == "tailwind" %}import React from 'react';

interface CardItem {
  id: string;
  title: string;
  subtitle?: string;
  description?: string;
  imageUrl?: string;
  imageAlt?: string;
  actions?: { label: string; icon?: React.ReactNode; onClick: () => void }[];
  [key: string]: any;
}

interface Action {
  label: string;
  icon?: React.ReactNode;
  onClick: () => void;
}

interface CardListProps {
  items?: CardItem[];
  title?: string;
  columns?: number;
  variant?: 'grid' | 'list' | 'masonry';
  spacing?: 'sm' | 'md' | 'lg';
  paginated?: boolean;
  pageSize?: number;
  bordered?: boolean;
  className?: string;
  emptyText?: string;
}

function CardList({
  items = [],
  title,
  columns = 3,
  variant = 'grid',
  spacing = 'md',
  paginated = false,
  pageSize = 12,
  bordered = false,
  className = '',
  emptyText = 'No items found'
}: CardListProps) {
  const [page, setPage] = React.useState(1);

  const paginatedItems = paginated
    ? items.slice((page - 1) * pageSize, page * pageSize)
    : items;

  const totalPages = paginated ? Math.ceil(items.length / pageSize) : 1;

  const gapMap = { sm: 'gap-2', md: 'gap-4', lg: 'gap-6' };
  const gapClass = gapMap[spacing] || 'gap-4';

  const colMap: Record<number, string> = {
    1: 'grid-cols-1',
    2: 'grid-cols-1 sm:grid-cols-2',
    3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
    4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
  };
  const colClass = colMap[columns] || colMap[3];

  return (
    <div className={className}>
      {title && (
        <h2 className="text-2xl font-bold text-gray-900 mb-4">{title}</h2>
      )}
      {paginatedItems.length === 0 ? (
        <p className="text-gray-500">{emptyText}</p>
      ) : (
        <>
          <div className={`grid ${colClass} ${gapClass}`}>
            {paginatedItems.map((item) => {
              const borderClass = bordered ? 'border border-gray-200' : 'shadow-md';
              return (
                <div
                  key={item.id}
                  className={`bg-white rounded-lg overflow-hidden ${borderClass} hover:shadow-lg transition-shadow`}
                >
                  {item.imageUrl && (
                    <img
                      src={item.imageUrl}
                      alt={item.imageAlt || ''}
                      className="w-full h-48 object-cover"
                    />
                  )}
                  {(item.title || item.subtitle) && (
                    <div className="p-5 pb-0">
                      {item.title && (
                        <h3 className="text-lg font-semibold text-gray-900">{item.title}</h3>
                      )}
                      {item.subtitle && (
                        <p className="text-sm text-gray-500 mt-1">{item.subtitle}</p>
                      )}
                    </div>
                  )}
                  {item.description && (
                    <div className="p-5 pt-3">
                      <p className="text-sm text-gray-600">{item.description}</p>
                    </div>
                  )}
                  {item.actions && item.actions.length > 0 && (
                    <div className="flex flex-wrap gap-2 p-5 pt-3 border-t border-gray-100">
                      {item.actions.map((action: Action, index: number) => (
                        <button
                          key={index}
                          onClick={action.onClick}
                          className="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-md transition-colors"
                        >
                          {action.icon}
                          {action.label}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
          {paginated && totalPages > 1 && (
            <div className="flex justify-center mt-6">
              {Array.from(% raw %){ length: totalPages }{% endraw %}.map((_, i) => (
                <button
                  key={i}
                  onClick={() => setPage(i + 1)}
                  className=% raw %}`px-3 py-1 mx-1 rounded ${page === i + 1 ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}{% endraw %}`
                >
                  {i + 1}
                </button>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  );
}

export default CardList;
