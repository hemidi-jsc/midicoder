{% elif ui_framework == "antd" %}import React from 'react';
import { Timeline as AntdTimeline, Typography } from 'antd';

interface TimelineEvent {
  title: string;
  date: string | Date;
  description?: string;
  status?: 'in-progress' | 'finished' | 'error' | 'default';
  icon?: React.ReactNode;
}

interface TimelineProps {
  events: TimelineEvent[];
  pending?: boolean;
  reverse?: boolean;
  mode?: 'default' | 'clear';
  className?: string;
}

function formatDate(date: string | Date): string {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

function Timeline({
  events,
  pending = false,
  reverse = false,
  mode = 'default',
  className
}: TimelineProps) {
  const pendingDot = pending ? <span className="ant-timeline-dot">⋯</span> : undefined;

  return (
    <AntdTimeline
      mode={mode}
      reverse={reverse}
      pending={pending}
      pendingDot={pendingDot}
      className={className}
    >
      {events.map((event, index) => (
        <AntdTimeline.Item
          key={index}
          color={
            event.status === 'finished' ? 'green'
              : event.status === 'in-progress' ? 'blue'
              : event.status === 'error' ? 'red'
              : 'gray'
          }
          dot={event.icon}
        >
          <Typography.Text strong>{event.title}</Typography.Text>
          <Typography.Text className="d-block" type="secondary">
            {formatDate(event.date)}
          </Typography.Text>
          {event.description && <p className="mb-0">{event.description}</p>}
        </AntdTimeline.Item>
      ))}
    </AntdTimeline>
  );
}

export default Timeline;
