{% if ui_framework == "material" %}import React from 'react';
import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  StepConnector,
  stepConnectorClasses,
  Box,
  Stack,
  Typography
} from '@mui/material';
import { styled } from '@mui/material/styles';
import type { SxProps, Theme } from '@mui/material/styles';

interface TimelineEvent {
  title: string;
  date: string | Date;
  description?: string;
  status?: 'in-progress' | 'completed' | 'pending';
  icon?: React.ReactNode;
}

interface TimelineProps {
  events: TimelineEvent[];
  mode?: 'standard' | 'dense';
  alternativeLabel?: boolean;
  sx?: SxProps<Theme>;
  className?: string;
}

const QstepperConnector = styled(StepConnector)(({ theme }) => ({
  [`&.${stepConnectorClasses.alternativeLabel}`]: {
    marginLeft: 12,
  },
  [`&.${stepConnectorClasses.active}`]: {
    [`& .${stepConnectorClasses.line}`]: {
      borderColor: theme.palette.primary.main,
    },
  },
  [`&.${stepConnectorClasses.completed}`]: {
    [`& .${stepConnectorClasses.line}`]: {
      borderColor: theme.palette.primary.main,
    },
  },
  [`& .${stepConnectorClasses.line}`]: {
    borderColor:
      theme.palette.mode === 'dark' ? theme.palette.grey[800] : theme.palette.grey[300],
    borderWidth: 3,
  },
}));

function getStatusColor(status?: string): string {
  switch (status) {
    case 'in-progress': return '#2196f3';
    case 'completed': return '#4caf50';
    case 'pending': return '#ff9800';
    default: return '#757575';
  }
}

function formatDate(date: string | Date): string {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

function Timeline({
  events,
  mode = 'standard',
  alternativeLabel = false,
  sx,
  className
}: TimelineProps) {
  const activeStep = events.findIndex((e) => e.status === 'in-progress');
  const completedSteps = events.filter((e) => e.status === 'completed').length;

  return (
    <Stack sx={sx} className={className} spacing={mode === 'dense' ? 0 : 2}>
      <Stepper
        activeStep={activeStep >= 0 ? activeStep : completedSteps}
        alternativeLabel={alternativeLabel}
        connector={<QstepperConnector />}
      >
        {events.map((event, index) => {
          const stepStatus = event.status === 'completed'
            ? 'completed'
            : event.status === 'in-progress'
              ? 'active'
              : 'waiting';

          return (
            <Step key={index} completed={stepStatus === 'completed'}>
              <StepLabel
                error={stepStatus === 'error'}
                optional={
                  <Typography variant="caption" color="text.secondary">
                    {formatDate(event.date)}
                  </Typography>
                }
              >
                {event.title}
              </StepLabel>
              {event.description && (
                <StepContent>
                  <Typography>{event.description}</Typography>
                </StepContent>
              )}
            </Step>
          );
        })}
      </Stepper>
    </Stack>
  );
}

export default Timeline;
{% elif ui_framework == "tailwind" %}import React from 'react';

interface TimelineEvent {
  title: string;
  date: string | Date;
  description?: string;
  status?: 'in-progress' | 'completed' | 'pending';
  icon?: React.ReactNode;
}

interface TimelineProps {
  events: TimelineEvent[];
  variant?: 'default' | 'alternate';
  direction?: 'left' | 'right';
  hideDates?: boolean;
  className?: string;
}

function getStatusClasses(status?: string): string {
  switch (status) {
    case 'in-progress': return 'bg-blue-500 ring-blue-100';
    case 'completed': return 'bg-green-500 ring-green-100';
    case 'pending': return 'bg-yellow-500 ring-yellow-100';
    default: return 'bg-gray-500 ring-gray-100';
  }
}

function formatDate(date: string | Date): string {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

function Timeline({
  events,
  variant = 'default',
  direction = 'left',
  hideDates = false,
  className = ''
}: TimelineProps) {
  return (
    <div className={`relative ${className}`}>
      <div className="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200" />
      {events.map((event, index) => {
        const isAlternate = variant === 'alternate' && index % 2 === 1;
        return (
          <div
            key={index}
            className={`relative flex items-start mb-6 last:mb-0 ${
              isAlternate ? 'flex-row-reverse' : ''
            }`}
          >
            <div className="absolute left-4 -translate-x-1/2 z-10">
              <div
                className={`w-3 h-3 rounded-full ring-4 ${getStatusClasses(event.status)}`}
              />
            </div>
            <div
              className={`ml-12 ${isAlternate ? 'text-right ml-0 mr-12' : ''}`}
            >
              <div className="bg-white rounded-lg shadow-sm p-4 inline-block">
                {event.icon && (
                  <span className={`mb-2 block ${isAlternate ? 'float-right' : ''}`}>
                    {event.icon}
                  </span>
                )}
                <h4 className="text-sm font-semibold text-gray-900">{event.title}</h4>
                {!hideDates && (
                  <p className="text-xs text-gray-500 mt-1">
                    {formatDate(event.date)}
                  </p>
                )}
                {event.description && (
                  <p className="text-sm text-gray-600 mt-2">{event.description}</p>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default Timeline;
