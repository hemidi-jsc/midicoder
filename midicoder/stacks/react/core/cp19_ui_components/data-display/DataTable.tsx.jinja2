{% elif ui_framework == "bootstrap" %}import React, { useState, useMemo } from 'react';

interface Column<T> {
  key: keyof T;
  label: string;
  sortable?: boolean;
}

interface DataTableProps<T extends Record<string, any>> {
  data: T[];
  columns: Column<T>[];
  withPagination?: boolean;
  withSorting?: boolean;
  withSelection?: boolean;
  withSearch?: boolean;
  isLoading?: boolean;
  pageSize?: number;
  rowHref?: (row: T) => string;
  className?: string;
}

function DataTable<T extends Record<string, any>>({
  data,
  columns,
  withPagination = true,
  withSorting = true,
  withSelection = false,
  withSearch = false,
  isLoading = false,
  pageSize = 10,
  rowHref,
  className = ''
}: DataTableProps<T>) {
  const [page, setPage] = useState(1);
  const [order, setOrder] = useState<'asc' | 'desc'>('asc');
  const [orderBy, setOrderBy] = useState<keyof T | null>(null);
  const [selected, setSelected] = useState<Set<number>>(new Set());
  const [searchQuery, setSearchQuery] = useState('');

  const filteredData = useMemo(() => {
    if (!searchQuery) return data;
    const query = searchQuery.toLowerCase();
    return data.filter(row =>
      Object.values(row).some(val =>
        String(val).toLowerCase().includes(query)
      )
    );
  }, [data, searchQuery]);

  const sortedData = useMemo(() => {
    if (!orderBy || !withSorting) return filteredData;
    return [...filteredData].sort((a, b) => {
      const aVal = String(a[orderBy]);
      const bVal = String(b[orderBy]);
      return order === 'asc' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
    });
  }, [filteredData, orderBy, order, withSorting]);

  const paginatedData = useMemo(() => {
    if (!withPagination) return sortedData;
    const start = (page - 1) * pageSize;
    return sortedData.slice(start, start + pageSize);
  }, [sortedData, page, pageSize, withPagination]);

  const totalPages = Math.ceil(sortedData.length / pageSize);

  const handleSort = (key: keyof T) => {
    if (orderBy === key) {
      setOrder(order === 'asc' ? 'desc' : 'asc');
    } else {
      setOrderBy(key);
      setOrder('asc');
    }
  };

  const getSortIcon = (key: keyof T): string => {
    if (orderBy !== key) return '';
    return order === 'asc' ? ' ↑' : ' ↓';
  };

  return (
    <div className={`table-responsive ${className}`}>
      {withSearch && (
        <div className="mb-3">
          <input
            type="text"
            className="form-control form-control-sm"
            placeholder="Search..."
            value={searchQuery}
            onChange={(e) => { setSearchQuery(e.target.value); setPage(1); }}
          />
        </div>
      )}
      <table className="table table-striped table-hover align-middle">
        <thead className="table-{% raw %}{{ width: '40px' }}{% endraw %}tr>
            {withSelection && <th style={{ width: '40px' }}><input type="checkbox" /></th>}
            {columns.map((col) => (
              <th key={String(col.key)}>
                {withSorting && col.sortable !== false ? (
                  <a href="#" onClick={(e) => { e.preventDefault(); handleSort(col.key); }}>
                    {col.label}{getSortIcon(col.key)}
                  </a>
                ) : (
                  col.label
                )}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {isLoading ? (
            <tr>
              <td colSpan={columns.length + (withSelection ? 1 : 0)} className="text-center py-4">
                <div className="spinner-border spinner-border-sm text-primary" role="status"></div>
              </td>
            </tr>
          ) : paginatedData.length === 0 ? (
            <tr>
              <td colSpan={columns.length + (withSelection ? 1 : 0)} className="text-center text-muted py-4">
                No data available
              </td>
            </tr>
          ) : (
            paginatedData.map((row, index) => {
              const globalIndex = (page - 1) * pageSize + index;
              return (
                <tr key={globalIndex}>
                  {withSelection && (
                    <td>
                      <input
                        type="checkbox"
                        checked={selected.has(globalIndex)}
                        onChange={() => {
                          const newSelected = new Set(selected);
                          if (newSelected.has(globalIndex)) newSelected.delete(globalIndex);
                          else newSelected.add(globalIndex);
                          setSelected(newSelected);
                        }}
                      />
                    </td>
                  )}
                  {columns.map((col) => (
                    <td key={String(col.key)}>
                      {rowHref ? (
                        <a href={rowHref(row)}>{String(row[col.key])}</a>
                      ) : (
                        String(row[col.key])
                      )}
                    </td>
                  ))}
                </tr>
