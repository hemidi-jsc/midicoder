            })
          )}
        </tbody>
      </table>
      {withPagination && totalPages > 0 && (
        <nav>
          <ul className="pagination justify-content-end mb-0">
            <li className={`page-item ${page === 1 ? 'disabled' : ''}`}>
              <a className="page-link" href="#" onClick={(e) => { e.preventDefault(); setPage(Math.max(1, page - 1)); }}>Previous</a>
            </li>
            {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
              const pageNum = i + 1;
              return (
                <li key={pageNum} className={`page-item ${page === pageNum ? 'active' : ''}`}>
                  <a className="page-link" href="#" onClick={(e) => { e.preventDefault(); setPage(pageNum); }}>{pageNum}</a>
                </li>
              );
            })}
            <li className={`page-item ${page === totalPages ? 'disabled' : ''}`}>
              <a className="page-link" href="#" onClick={(e) => { e.preventDefault(); setPage(Math.min(totalPages, page + 1)); }}>Next</a>
            </li>
          </ul>
        </nav>
      )}
    </div>
  );
}

export default DataTable;
{% elif ui_framework == "antd" %}import React, { useState, useMemo } from 'react';
import { Table, Input, Space, Spin } from 'antd';
import type { ColumnsType } from 'antd/es/table';

interface DataTableProps<T extends Record<string, any>> {
  data: T[];
  columns: {
    key: keyof T;
    label: string;
    sortable?: boolean;
    width?: number;
  }[];
  withPagination?: boolean;
  withSorting?: boolean;
  withSelection?: boolean;
  withSearch?: boolean;
  isLoading?: boolean;
  pageSize?: number;
  rowHref?: (row: T) => string;
  className?: string;
}

function DataTable<T extends Record<string, any>>({
  data,
  columns,
  withPagination = true,
  withSorting = true,
  withSelection = false,
  withSearch = false,
  isLoading = false,
  pageSize = 10,
  rowHref,
  className = ''
}: DataTableProps<T>) {
  const [searchQuery, setSearchQuery] = useState('');

  const filteredData = useMemo(() => {
    if (!searchQuery) return data;
    const query = searchQuery.toLowerCase();
    return data.filter(row =>
      Object.values(row).some(val =>
        String(val).toLowerCase().includes(query)
      )
    );
  }, [data, searchQuery]);

  const antdColumns: ColumnsType<T> = useMemo(() => {
    return columns.map(col => ({
      title: col.label,
      dataIndex: col.key,
      key: String(col.key),
      sorter: withSorting && col.sortable !== false,
      width: col.width,
      render: (text: any, record: T) =>
        rowHref ? (
          <a href={rowHref(record)}>{String(text)}</a>
        ) : (
          String(text)
        )
    }));
  }, [columns, withSorting, rowHref]);

  const rowSelection = withSelection ? {
    selectedRowKeys: [],
    onChange: (_: React.Key[]) => {}
  } : undefined;

  return (
    <Spin spinning={isLoadin{% raw %}{{ marginBottom: 16 }}{% endraw %}me={className}>
        {withSearch && (
          <div style={{ marginBottom: 16 }}>
            <Input
              placeholder="Search..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              allowClear
            />
          </div>
        )}
        <Table<T>
          columns={antdColumns}
          dataSource={filteredData}
          rowKey={(_, index) => String(index)}
          pagination={withPagination ? {
            pageSize,
            showSizeChanger: true,
            pageSizeOptions: ['5', '10', '25', '50'],
            showTotal: (total) => `Total ${total} items`
          } : false}
          rowSelection={rowSelection}
          size="middle"
          bordered
        />
      </div>
    </Spin>
  );
}

