/*
 * Midicoder CP19 - Data Input: DatePicker
 * Standalone date picker component.
 */
import React from 'react';

interface DatePickerProps {
  label?: string;
  placeholder?: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  min?: string;
  max?: string;
  value?: string;
  onChange?: (value: string) => void;
  onBlur?: () => void;
  id?: string;
  className?: string;
}

const DatePicker: React.FC<DatePickerProps> = ({
  label,
  placeholder,
  hint,
  required = false,
  disabled = false,
  min,
  max,
  value = '',
  onChange,
  onBlur,
  id,
  className = '',
}) => {
  return (
{% if ui_framework == "material" %}
    <div className={className} style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '4px', textTransform: 'uppercase' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <div style={% raw %}{{ position: 'relative' }}{% endraw %}>
        <input
          id={id}
          type="date"
          placeholder={placeholder}
          disabled={disabled}
          min={min}
          max={max}
          value={value}
          onChange={(e) => onChange?.(e.target.value)}
          onBlur={onBlur}
          style={% raw %}{{ width: '100%', padding: '12px 16px', border: '1px solid #bdbdbd', borderRadius: '4px', fontSize: '14px', outline: 'none', background: '#fff' }}{% endraw %}
        />
        <span style={% raw %}{{ position: 'absolute', right: '12px', top: '50%', transform: 'translateY(-50%)', color: '#9e9e9e', pointerEvents: 'none' }}{% endraw %}>📅</span>
      </div>
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <input
        id={id}
        type="date"
        placeholder={placeholder}
        disabled={disabled}
        min={min}
        max={max}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        className="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100"
      />
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`form-group w-100 ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <input
        id={id}
        type="date"
        placeholder={placeholder}
        disabled={disabled}
        min={min}
        max={max}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        className="form-control"
      />
      {hint && <small className="form-text text-muted">{hint}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        type="date"
        placeholder={placeholder}
        disabled={disabled}
        min={min}
        max={max}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '8px 11px', border: '1px solid #d9d9d9', borderRadius: '6px', fontSize: '14px', outline: 'none' }}{% endraw %}
      />
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        id={id}
        type="date"
        placeholder={placeholder}
        disabled={disabled}
        min={min}
        max={max}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '10px 12px', border: 'none', borderBottom: '1px solid #8d8d8d', fontSize: '0.875rem', outline: 'none', background: 'transparent' }}{% endraw %}
      />
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default DatePicker;
