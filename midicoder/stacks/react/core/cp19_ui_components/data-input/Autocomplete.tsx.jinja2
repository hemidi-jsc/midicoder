/*
 * Midicoder CP19 - Data Input: Autocomplete
 * Standalone autocomplete/search input with dropdown suggestions.
 */
import React, { useState, useRef, useEffect, useCallback } from 'react';

export interface AutocompleteOption {
  value: string;
  label: string;
  [key: string]: any;
}

interface AutocompleteProps {
  label?: string;
  placeholder?: string;
  hint?: string;
  required?: boolean;
  disabled?: boolean;
  options: AutocompleteOption[];
  value?: AutocompleteOption | null;
  onChange?: (option: AutocompleteOption | null) => void;
  onCreateOption?: (inputValue: string) => void;
  allowCreate?: boolean;
  debounceMs?: number;
  id?: string;
  className?: string;
}

const Autocomplete: React.FC<AutocompleteProps> = ({
  label,
  placeholder = 'Search...',
  hint,
  required = false,
  disabled = false,
  options = [],
  value,
  onChange,
  onCreateOption,
  allowCreate = false,
  debounceMs = 200,
  id,
  className = '',
}) => {
  const [inputValue, setInputValue] = useState(value?.label || '');
  const [filteredOptions, setFilteredOptions] = useState<AutocompleteOption[]>([]);
  const [showDropdown, setShowDropdown] = useState(false);
  const [highlightIndex, setHighlightIndex] = useState(0);
  const dropdownRef = useRef<HTMLDivElement>(null);
  const debounceRef = useRef<ReturnType<typeof setTimeout>>();

  useEffect(() => {
    setInputValue(value?.label || '');
  }, [value]);

  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(e.target as Node)) {
        setShowDropdown(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const handleInputChange = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
    const term = e.target.value;
    setInputValue(term);
    setShowDropdown(true);
    setHighlightIndex(0);

    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => {
      if (term.trim().length > 0) {
        setFilteredOptions(
          options.filter(
            (opt) => opt.label.toLowerCase().includes(term.toLowerCase()) || opt.value.toLowerCase().includes(term.toLowerCase())
          ).slice(0, 20)
        );
      } else {
        setFilteredOptions([]);
      }
    }, debounceMs);
  }, [options, debounceMs]);

  const handleSelect = (option: AutocompleteOption) => {
    setInputValue(option.label);
    setShowDropdown(false);
    onChange?.(option);
  };

  const handleCreateOption = () => {
    if (onCreateOption && allowCreate && inputValue.trim()) {
      onCreateOption(inputValue);
      setInputValue(inputValue);
      setShowDropdown(false);
    }
  };

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setHighlightIndex((prev) => Math.min(prev + 1, filteredOptions.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setHighlightIndex((prev) => Math.max(prev - 1, 0));
    } else if (e.key === 'Enter' && filteredOptions[highlightIndex]) {
      e.preventDefault();
      handleSelect(filteredOptions[highlightIndex]);
    } else if (e.key === 'Escape') {
      setShowDropdown(false);
    }
  };

  return (
{% if ui_framework == "material" %}
    <div ref={dropdownRef} className={className} style={% raw %}{{ width: '100%', position: 'relative', marginBottom: '16px' }}{% endraw %}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '4px', textTransform: 'uppercase' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        id={id}
        type="text"
        value={inputValue}
        onChange={handleInputChange}
        onFocus={() => setShowDropdown(true)}
        onKeyDown={handleKeyDown}
        placeholder={placeholder}
        disabled={disabled}
        style={% raw %}{{ width: '100%', padding: '12px 16px', border: '1px solid #bdbdbd', borderRadius: '4px', fontSize: '14px', outline: 'none', background: '#fff' }}{% endraw %}
      />
      {showDropdown && (filteredOptions.length > 0 || (allowCreate && inputValue.trim())) && (
        <ul style={% raw %}{{ position: 'absolute', zIndex: 1050, width: '100%', marginTop: '4px', background: '#fff', border: '1px solid #e0e0e0', borderRadius: '4px', maxHeight: '240px', overflow: 'auto', boxShadow: '0 2px 8px rgba(0,0,0,0.15)' }}{% endraw %}>
          {filteredOptions.map((opt, i) => (
            <li key={opt.value} onClick={() => handleSelect(opt)} style={% raw %}{{ padding: '10px 16px', cursor: 'pointer', fontSize: '14px', background: i === highlightIndex ? '#e8eaf6' : '#fff', color: '#212121' }}{% endraw %}>
              {opt.label}
            </li>
          ))}
          {allowCreate && inputValue.trim() && !filteredOptions.find((o) => o.label === inputValue) && (
            <li onClick={handleCreateOption} style={% raw %}{{ padding: '10px 16px', cursor: 'pointer', fontSize: '14px', color: '#3f51b5', background: '#e8eaf6' }}{% endraw %}>
              Create "{inputValue}"
            </li>
          )}
        </ul>
      )}
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div ref={dropdownRef} className={`w-full relative ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <input
        id={id}
        type="text"
        value={inputValue}
        onChange={handleInputChange}
        onFocus={() => setShowDropdown(true)}
        onKeyDown={handleKeyDown}
        placeholder={placeholder}
        disabled={disabled}
        className="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100"
      />
      {showDropdown && (filteredOptions.length > 0 || (allowCreate && inputValue.trim())) && (
        <ul className="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg max-h-60 overflow-auto">
          {filteredOptions.map((opt, i) => (
            <li key={opt.value} onClick={() => handleSelect(opt)} className={`px-4 py-2 cursor-pointer text-sm ${i === highlightIndex ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}`}>
              {opt.label}
            </li>
          ))}
          {allowCreate && inputValue.trim() && !filteredOptions.find((o) => o.label === inputValue) && (
            <li onClick={handleCreateOption} className="px-4 py-2 cursor-pointer text-sm text-blue-600 bg-blue-50">
              Create "{inputValue}"
            </li>
          )}
        </ul>
      )}
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div ref={dropdownRef} className={`w-100 position-relative ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <input
        id={id}
        type="text"
        value={inputValue}
        onChange={handleInputChange}
        onFocus={() => setShowDropdown(true)}
        onKeyDown={handleKeyDown}
        placeholder={placeholder}
        disabled={disabled}
        className="form-control"
      />
      {showDropdown && (filteredOptions.length > 0 || (allowCreate && inputValue.trim())) && (
        <ul className="position-absolute w-100 mt-1 bg-white border rounded shadow-lg" style={% raw %}{{ maxHeight: '240px', overflow: 'auto', zIndex: 1050 }}{% endraw %}>
          {filteredOptions.map((opt, i) => (
            <li key={opt.value} onClick={() => handleSelect(opt)} className={`px-3 py-2 cursor-pointer text-sm ${i === highlightIndex ? 'bg-light' : ''}`}>
              {opt.label}
            </li>
          ))}
          {allowCreate && inputValue.trim() && !filteredOptions.find((o) => o.label === inputValue) && (
            <li onClick={handleCreateOption} className="px-3 py-2 cursor-pointer text-sm text-primary bg-light">
              Create "{inputValue}"
            </li>
          )}
        </ul>
      )}
      {hint && <small className="form-text text-muted">{hint}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div ref={dropdownRef} style={% raw %}{{ width: '100%', position: 'relative', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        type="text"
        value={inputValue}
        onChange={handleInputChange}
        onFocus={() => setShowDropdown(true)}
        onKeyDown={handleKeyDown}
        placeholder={placeholder}
        disabled={disabled}
        style={% raw %}{{ width: '100%', padding: '8px 11px', border: '1px solid #d9d9d9', borderRadius: '6px', fontSize: '14px', outline: 'none' }}{% endraw %}
      />
      {showDropdown && (filteredOptions.length > 0 || (allowCreate && inputValue.trim())) && (
        <ul style={% raw %}{{ position: 'absolute', zIndex: 1050, width: '100%', marginTop: '4px', background: '#fff', border: '1px solid #d9d9d9', borderRadius: '6px', maxHeight: '240px', overflow: 'auto' }}{% endraw %}>
          {filteredOptions.map((opt, i) => (
            <li key={opt.value} onClick={() => handleSelect(opt)} style={% raw %}{{ padding: '8px 12px', cursor: 'pointer', fontSize: '14px', background: i === highlightIndex ? '#e6f4ff' : '#fff', color: '#262626' }}{% endraw %}>
              {opt.label}
            </li>
          ))}
          {allowCreate && inputValue.trim() && !filteredOptions.find((o) => o.label === inputValue) && (
            <li onClick={handleCreateOption} style={% raw %}{{ padding: '8px 12px', cursor: 'pointer', fontSize: '14px', color: '#1677ff', background: '#e6f4ff' }}{% endraw %}>
              Create "{inputValue}"
            </li>
          )}
        </ul>
      )}
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div ref={dropdownRef} style={% raw %}{{ width: '100%', position: 'relative', marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        id={id}
        type="text"
        value={inputValue}
        onChange={handleInputChange}
        onFocus={() => setShowDropdown(true)}
        onKeyDown={handleKeyDown}
        placeholder={placeholder}
        disabled={disabled}
        style={% raw %}{{ width: '100%', padding: '10px 12px', border: 'none', borderBottom: '1px solid #8d8d8d', fontSize: '0.875rem', outline: 'none', background: 'transparent' }}{% endraw %}
      />
      {showDropdown && (filteredOptions.length > 0 || (allowCreate && inputValue.trim())) && (
        <ul style={% raw %}{{ position: 'absolute', zIndex: 1050, width: '100%', marginTop: '4px', background: '#fff', border: '1px solid #8d8d8d', maxHeight: '240px', overflow: 'auto' }}{% endraw %}>
          {filteredOptions.map((opt, i) => (
            <li key={opt.value} onClick={() => handleSelect(opt)} style={% raw %}{{ padding: '0.5rem 0.75rem', cursor: 'pointer', fontSize: '0.875rem', background: i === highlightIndex ? '#e5e5e5' : '#fff' }}{% endraw %}>
              {opt.label}
            </li>
          ))}
          {allowCreate && inputValue.trim() && !filteredOptions.find((o) => o.label === inputValue) && (
            <li onClick={handleCreateOption} style={% raw %}{{ padding: '0.5rem 0.75rem', cursor: 'pointer', fontSize: '0.875rem', color: '#0f62fe', background: '#e5e5e5' }}{% endraw %}>
              Create "{inputValue}"
            </li>
          )}
        </ul>
      )}
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Autocomplete;
