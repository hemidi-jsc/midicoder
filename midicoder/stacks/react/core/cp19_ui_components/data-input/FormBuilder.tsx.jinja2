            <input type="datetime-local" value={formData[{% raw %}{{ width: '100%', padding: '12px 16px', border: `1px solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px' }}{% endraw %}solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px' }} {...commonProps} />
