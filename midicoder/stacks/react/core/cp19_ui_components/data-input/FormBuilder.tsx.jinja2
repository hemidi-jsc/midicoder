            <select
              value={formData[field.name] ?? ''}
              onChange={(e) => handleChange(field.n{% raw %}{{ width: '100%', padding: '12px 16px', border: `1px solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px', background: '#fff' }}{% endraw %}', fontSize: '14px', background: '#fff' }}
