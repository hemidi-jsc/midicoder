/*
 * Midicoder CP19 - Data Input: FormBuilder
 * Dynamic form builder from JSON schema with layout, conditional fields, validation.
 */
import React, { useState, useMemo, useCallback } from 'react';

interface FieldSchema {
  name: string;
  type: 'text' | 'textarea' | 'select' | 'checkbox' | 'radio' | 'switch' | 'slider' | 'date' | 'datetime' | 'number' | 'email' | 'file' | 'autocomplete';
  label: string;
  placeholder?: string;
  hint?: string;
  required?: boolean;
  minLength?: number;
  maxLength?: number;
  min?: number;
  max?: number;
  pattern?: string;
  options?: Array<{ label: string; value: any }>;
  defaultValue?: any;
  condition?: { field: string; equals: any };
  disabled?: boolean;
}

interface WizardStep {
  title: string;
  fields: string[];
}

interface Schema {
  title?: string;
  description?: string;
  layout: 'single_column' | 'two_column' | 'wizard';
  wizardSteps?: WizardStep[];
  fields: FieldSchema[];
}

interface FormBuilderProps {
  schema: Schema;
  onSubmit: (data: any) => void;
  onCancel?: () => void;
  initialValues?: Record<string, any>;
  className?: string;
}

const FormBuilder: React.FC<FormBuilderProps> = ({
  schema,
  onSubmit,
  onCancel,
  initialValues = {},
  className = '',
}) => {
  const [formData, setFormData] = useState<Record<string, any>>(() => {
    const defaults: Record<string, any> = {};
    schema.fields.forEach((f) => {
      defaults[f.name] = f.defaultValue ?? initialValues[f.name] ?? '';
    });
    return defaults;
  });
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [activeStep, setActiveStep] = useState(0);

  const visibleFields = useMemo(() => {
    return schema.fields.filter((f) => {
      if (!f.condition) return true;
      return formData[f.condition.field] === f.condition.equals;
    });
  }, [schema.fields, formData]);

  const currentStepFields = useMemo(() => {
    if (schema.layout !== 'wizard' || !schema.wizardSteps) return [];
    return schema.wizardSteps[activeStep]?.fields.map((name) => schema.fields.find((f) => f.name === name)).filter(Boolean) as FieldSchema[];
  }, [schema, activeStep]);

  const validate = useCallback((): boolean => {
    const newErrors: Record<string, string> = {};
    const fieldsToValidate = schema.layout === 'wizard' && schema.wizardSteps ? currentStepFields : visibleFields;
    for (const field of fieldsToValidate) {
      if (field.required && (!formData[field.name] || (typeof formData[field.name] === 'string' && !formData[field.name].trim()))) {
        newErrors[field.name] = `${field.label} is required`;
      }
      if (field.type === 'email' && formData[field.name] && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData[field.name])) {
        newErrors[field.name] = 'Invalid email address';
      }
      if (field.minLength && formData[field.name] && formData[field.name].length < field.minLength) {
        newErrors[field.name] = `Minimum ${field.minLength} characters required`;
      }
      if (field.maxLength && formData[field.name] && formData[field.name].length > field.maxLength) {
        newErrors[field.name] = `Maximum ${field.maxLength} characters allowed`;
      }
    }
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  }, [visibleFields, currentStepFields, formData, schema]);

  const handleChange = (name: string, value: any) => {
    setFormData((prev) => ({ ...prev, [name]: value }));
    if (errors[name]) {
      setErrors((prev) => {
        const next = { ...prev };
        delete next[name];
        return next;
      });
    }
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (schema.layout === 'wizard' && schema.wizardSteps) {
      if (activeStep < schema.wizardSteps.length - 1) {
        if (validate()) setActiveStep(activeStep + 1);
      } else {
        if (validate()) onSubmit(formData);
      }
    } else {
      if (validate()) onSubmit(formData);
    }
  };

  const handleReset = () => {
    const defaults: Record<string, any> = {};
    schema.fields.forEach((f) => {
      defaults[f.name] = f.defaultValue ?? '';
    });
    setFormData(defaults);
    setErrors({});
    setActiveStep(0);
  };

  const renderField = (field: FieldSchema) => {
    const hasError = !!errors[field.name];
    const commonProps = {
      placeholder: field.placeholder,
      disabled: field.disabled,
      'aria-invalid': hasError,
      'aria-describedby': field.hint ? `${field.name}-hint` : undefined,
    };

    switch (field.type) {
{% if ui_framework == "material" %}
