            <input type="date" value={formData[field.name] ?? ''} on{% raw %}{{ width: '100%', padding: '12px 16px', border: `1px solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px' }}{% endraw %}d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px' }} {...commonProps} />
