              {field.label}{field.required && <span style={% raw %}{{ color: '#d32f2f' }}{% endraw %}>*</span>}
            </label>
            <input
              type={field.type === 'email' ? 'email' : field.type === 'number' ? 'number' : 'text'}
              value={formData[field.name] ?? ''}
              onChange={(e) => handleChange(field.name, e.target.value)}
              style={% raw %}{{ width: '100%', padding: '12px 16px', border: `1px solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px', outline: 'none' }}{% endraw %}
              {...commonProps}
            />
            {field.hint && <div id={`${field.name}-hint`} style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{field.hint}</div>}
            {hasError && <div style={% raw %}{{ fontSize: '12px', color: '#d32f2f', marginTop: '4px' }}{% endraw %}>{errors[field.name]}</div>}
          </div>
        );
      case 'textarea':
        return (
          <div key={field.name} style={% raw %}{{ marginBottom: '16px' }}{% endraw %}>
            <label style={% raw %}{{ display: 'block', fontSize: '12px', color: '#616161', marginBottom: '4px' }}{% endraw %}>{field.label}{field.required && <span style={% raw %}{{ color: '#d32f2f' }}{% endraw %}>*</span>}</label>
            <textarea
              value={formData[field.name] ?? ''}
              onChange={(e) => handleChange(field.name, e.target.value)}
              rows={4}{% raw %}{{ width: '100%', padding: '12px 16px', border: `1px solid ${hasError ? '#d32f2f' : '#bdbdbd'}`, borderRadius: '4px', fontSize: '14px', outline: 'none', resize: 'vertical' }}{% endraw %}resize: 'vertical' }}
              {...commonProps}
            />
            {hasError && <div style={% raw %}{{ fontSize: '12px', color: '#d32f2f', marginTop: '4px' }}{% endraw %}>{errors[field.name]}</div>}
          </div>
