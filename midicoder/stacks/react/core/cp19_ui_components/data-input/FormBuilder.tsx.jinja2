            <div style={% raw %}{{ fontSize: '12px', color: '#616161', marginBottom: '4px' }}{% endraw %}>{field.label}{field.required && <span style={% raw %}{{ color: '#d32f2f' }}{% endraw %}>*</span>}</div>
