/*
 * Midicoder CP19 - Data Input: Input
 * Standalone text input component.
 */
import React, { useState } from 'react';

interface InputProps {
  label?: string;
  placeholder?: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url';
  hint?: string;
  required?: boolean;
  requiredMessage?: string;
  errorMessage?: string;
  disabled?: boolean;
  readOnly?: boolean;
  maxLength?: number;
  value?: string | number;
  onChange?: (value: string) => void;
  onBlur?: () => void;
  prefixIcon?: React.ReactNode;
  suffixIcon?: React.ReactNode;
  id?: string;
  className?: string;
}

const Input: React.FC<InputProps> = ({
  label,
  placeholder = '',
  type = 'text',
  hint,
  required = false,
  disabled = false,
  readOnly = false,
  maxLength,
  value = '',
  onChange,
  onBlur,
  prefixIcon,
  suffixIcon,
  id,
  className = '',
}) => {
  const [showPassword, setShowPassword] = useState(false);
  const inputType = type === 'password' && showPassword ? 'text' : type;

  return (
{% if ui_framework == "material" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '12px', fontWeight: 500, color: '#616161', marginBottom: '4px', textTransform: 'uppercase', letterSpacing: '0.5px' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <div style={% raw %}{{ position: 'relative' }}{% endraw %}>
        {prefixIcon && <span style={% raw %}{{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)', color: '#9e9e9e' }}{% endraw %}>{prefixIcon}</span>}
        <input
          id={id}
          type={inputType}
          placeholder={placeholder}
          disabled={disabled}
          readOnly={readOnly}
          maxLength={maxLength}
          value={value}
          onChange={(e) => onChange?.(e.target.value)}
          onBlur={onBlur}
          style={% raw %}{{
            width: '100%',
            padding: '12px 16px',
            paddingLeft: prefixIcon ? '40px' : '16px',
            paddingRight: (suffixIcon || type === 'password') ? '40px' : '16px',
            border: '1px solid #bdbdbd',
            borderRadius: '4px',
            fontSize: '14px',
            outline: 'none',
            background: '#fff',
          }}{% endraw %}
        />
        {type === 'password' && (
          <button type="button" onClick={() => setShowPassword(!showPassword)} style={% raw %}{{ position: 'absolute', right: '12px', top: '50%', transform: 'translateY(-50%)', background: 'none', border: 'none', cursor: 'pointer', color: '#9e9e9e' }}{% endraw %}>
            {showPassword ? '🙈' : '👁'}
          </button>
        )}
        {suffixIcon && type !== 'password' && <span style={% raw %}{{ position: 'absolute', right: '12px', top: '50%', transform: 'translateY(-50%)', color: '#9e9e9e' }}{% endraw %}>{suffixIcon}</span>}
      </div>
      {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
      {maxLength && <div style={% raw %}{{ fontSize: '12px', color: '#bdbdbd', marginTop: '4px', textAlign: 'right' }}{% endraw %}>{String(value).length}/{maxLength}</div>}
    </div>
{% elif ui_framework == "tailwind" %}
    <div className={`w-full ${className}`}>
      {label && (
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
          {label}
          {required && <span className="text-red-500 ml-1">*</span>}
        </label>
      )}
      <div className="relative">
        {prefixIcon && <span className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">{prefixIcon}</span>}
        <input
          id={id}
          type={inputType}
          placeholder={placeholder}
          disabled={disabled}
          readOnly={readOnly}
          maxLength={maxLength}
          value={value}
          onChange={(e) => onChange?.(e.target.value)}
          onBlur={onBlur}
          className={`w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100 disabled:cursor-not-allowed ${prefixIcon ? 'pl-10' : ''} ${suffixIcon || type === 'password' ? 'pr-10' : ''}`}
        />
        {type === 'password' && (
          <button type="button" onClick={() => setShowPassword(!showPassword)} className="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
            {showPassword ? '🙈' : '👁'}
          </button>
        )}
        {suffixIcon && type !== 'password' && <span className="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">{suffixIcon}</span>}
      </div>
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
      {maxLength && <p className="mt-1 text-xs text-gray-400 text-right">{String(value).length}/{maxLength}</p>}
    </div>
{% elif ui_framework == "bootstrap" %}
    <div className={`form-group w-100 ${className}`}>
      {label && (
        <label htmlFor={id} className="form-label">
          {label}
          {required && <span className="text-danger">*</span>}
        </label>
      )}
      <div className="input-group">
        {prefixIcon && <span className="input-group-text">{prefixIcon}</span>}
        <input
          id={id}
          type={inputType}
          placeholder={placeholder}
          disabled={disabled}
          readOnly={readOnly}
          maxLength={maxLength}
          value={value}
          onChange={(e) => onChange?.(e.target.value)}
          onBlur={onBlur}
          className="form-control"
        />
        {suffixIcon && <span className="input-group-text">{suffixIcon}</span>}
        {type === 'password' && (
          <button type="button" className="input-group-text" onClick={() => setShowPassword(!showPassword)}>
            {showPassword ? '🙈' : '👁'}
          </button>
        )}
      </div>
      {hint && <small className="form-text text-muted">{hint}</small>}
      {maxLength && <small className="form-text text-muted float-end">{String(value).length}/{maxLength}</small>}
    </div>
{% elif ui_framework == "antd" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      {label && (
        <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
      )}
      <div style={% raw %}{{ position: 'relative' }}{% endraw %}>
        {prefixIcon && <span style={% raw %}{{ position: 'absolute', left: '11px', top: '50%', transform: 'translateY(-50%)', color: '#bfbfbf' }}{% endraw %}>{prefixIcon}</span>}
        <input
          id={id}
          type={inputType}
          placeholder={placeholder}
          disabled={disabled}
          readOnly={readOnly}
          maxLength={maxLength}
          value={value}
          onChange={(e) => onChange?.(e.target.value)}
          onBlur={onBlur}
          style={% raw %}{{
            width: '100%',
            padding: '8px 11px',
            paddingLeft: prefixIcon ? '32px' : '11px',
            paddingRight: (suffixIcon || type === 'password') ? '32px' : '11px',
            border: '1px solid #d9d9d9',
            borderRadius: '6px',
            fontSize: '14px',
            outline: 'none',
          }}{% endraw %}
        />
        {type === 'password' && (
          <button type="button" onClick={() => setShowPassword(!showPassword)} style={% raw %}{{ position: 'absolute', right: '11px', top: '50%', transform: 'translateY(-50%)', background: 'none', border: 'none', cursor: 'pointer', color: '#bfbfbf' }}{% endraw %}>
            {showPassword ? '🙈' : '👁'}
          </button>
        )}
      </div>
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
    </div>
{% elif ui_framework == "carbon" %}
    <div style={% raw %}{{ width: '100%', marginBottom: '1rem' }}{% endraw %} className={className}>
      {label && (
        <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
        </label>
      )}
      <input
        id={id}
        type={inputType}
        placeholder={placeholder}
        disabled={disabled}
        readOnly={readOnly}
        maxLength={maxLength}
        value={value}
        onChange={(e) => onChange?.(e.target.value)}
        onBlur={onBlur}
        style={% raw %}{{ width: '100%', padding: '10px 12px', border: 'none', borderBottom: '1px solid #8d8d8d', fontSize: '0.875rem', outline: 'none', background: 'transparent' }}{% endraw %}
      />
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
    </div>
{% endif %}
  );
};

export default Input;
