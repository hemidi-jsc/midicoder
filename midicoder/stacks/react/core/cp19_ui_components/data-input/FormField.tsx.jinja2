/*
 * Midicoder CP19 - Data Input: FormField
 * Wrapper component for labeled form field with validation display.
 */
import React from 'react';

interface FormFieldProps {
  label: string;
  hint?: string;
  required?: boolean;
  requiredMessage?: string;
  errorMessage?: string;
  patternMessage?: string;
  children: React.ReactNode;
  hasError?: boolean;
  className?: string;
  id?: string;
}

const FormField: React.FC<FormFieldProps> = ({
  label,
  hint,
  required = false,
  requiredMessage,
  errorMessage,
  patternMessage,
  children,
  hasError = false,
  className = '',
  id,
}) => {
{% if ui_framework == "material" %}
  return (
    <div className={`mat-form-field-wrapper ${className}`} style={% raw %}{{ width: '100%' }}{% endraw %}>
      <div style={% raw %}{{ position: 'relative', marginBottom: '16px' }}{% endraw %}>
        <label style={% raw %}{{
          display: 'block',
          fontSize: '12px',
          fontWeight: 500,
          color: '#616161',
          marginBottom: '4px',
          textTransform: 'uppercase',
          letterSpacing: '0.5px',
        }}{% endraw %}>
          {label}
          {required && <span style={% raw %}{{ color: '#d32f2f', marginLeft: '4px' }}{% endraw %}>*</span>}
        </label>
        <div style={% raw %}{{
          border: '1px solid',
          borderColor: hasError ? '#d32f2f' : '#bdbdbd',
          borderRadius: '4px',
          padding: '12px 16px',
          background: '#fff',
          transition: 'border-color 0.2s',
        }}{% endraw %}>
          {children}
        </div>
        {hint && <div style={% raw %}{{ fontSize: '12px', color: '#9e9e9e', marginTop: '4px' }}{% endraw %}>{hint}</div>}
        {hasError && (
          <div style={% raw %}{{ fontSize: '12px', color: '#d32f2f', marginTop: '4px' }}{% endraw %}>
            {errorMessage || requiredMessage || 'This field is required'}
          </div>
        )}
      </div>
    </div>
  );

{% elif ui_framework == "tailwind" %}
  return (
    <div className={`w-full ${className}`}>
      <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
        {label}
        {required && <span className="text-red-500 ml-1">*</span>}
      </label>
      {children}
      {hint && <p className="mt-1 text-sm text-gray-500">{hint}</p>}
      {hasError && (
        <p className="mt-1 text-sm text-red-600">
          {errorMessage || requiredMessage || 'This field is required'}
        </p>
      )}
    </div>
  );

{% elif ui_framework == "bootstrap" %}
  return (
    <div className={`form-group w-100 ${className}`}>
      <label htmlFor={id} className="form-label">
        {label}
        {required && <span className="text-danger">*</span>}
      </label>
      {children}
      {hint && <small className="form-text text-muted">{hint}</small>}
      {hasError && (
        <div className="invalid-feedback d-block">
          {errorMessage || requiredMessage || 'This field is required'}
        </div>
      )}
    </div>
  );

{% elif ui_framework == "antd" %}
  return (
    <div style={% raw %}{{ width: '100%', marginBottom: '16px' }}{% endraw %} className={className}>
      <label style={% raw %}{{ display: 'block', fontSize: '14px', marginBottom: '4px', color: '#262626' }}{% endraw %}>
        {label}
        {required && <span style={% raw %}{{ color: '#ff4d4f', marginLeft: '4px' }}{% endraw %}>*</span>}
      </label>
      {children}
      {hint && <div style={% raw %}{{ color: '#8c8c8c', fontSize: '12px', marginTop: '4px' }}{% endraw %}>{hint}</div>}
      {hasError && (
        <div style={% raw %}{{ color: '#ff4d4f', fontSize: '12px', marginTop: '4px' }}{% endraw %}>
          {errorMessage || requiredMessage || 'This field is required'}
        </div>
      )}
    </div>
  );

{% elif ui_framework == "carbon" %}
  return (
    <div style={% raw %}{{ width: '100%', marginBottom: '1rem' }}{% endraw %} className={className}>
      <label htmlFor={id} style={% raw %}{{ display: 'block', fontSize: '0.75rem', fontWeight: 400, color: '#525252', marginBottom: '0.25rem' }}{% endraw %}>
        {label}
        {required && <span style={% raw %}{{ color: '#da1e28', marginLeft: '0.25rem' }}{% endraw %}>*</span>}
      </label>
      {children}
      {hint && <p style={% raw %}{{ fontSize: '0.75rem', color: '#6f6f6f', margin: '0.25rem 0' }}{% endraw %}>{hint}</p>}
      {hasError && (
        <p style={% raw %}{{ fontSize: '0.75rem', color: '#da1e28', margin: '0.25rem 0' }}{% endraw %}>
          {errorMessage || requiredMessage || 'This field is required'}
        </p>
      )}
    </div>
  );

{% endif %}
};

export default FormField;
