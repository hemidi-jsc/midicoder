                                                                                                                                                                                                            {},
                                                                                                                                                                                                            apiTimeout).catch(()
                                                                                                                                                                                                            =>
                                                                                                                                                                                                            []),
                                                                                                                                                                                                            apiRequest(`${baseUrl}/api/retention/stats`,
                                                                                                                                                                                                            {},
                                                                                                                                                                                                            apiTimeout).catch(()
                                                                                                                                                                                                            =>
                                                                                                                                                                                                            null),
                                                                                                                                                                                                            ]);
                                                                                                                                                                                                            safeSet(setPolicies,
                                                                                                                                                                                                            polData
                                                                                                                                                                                                            ||
                                                                                                                                                                                                            []);
                                                                                                                                                                                                            safeSet(setJobs,
                                                                                                                                                                                                            jobsData
                                                                                                                                                                                                            ||
                                                                                                                                                                                                            []);
                                                                                                                                                                                                            safeSet(setErasureRequests,
                                                                                                                                                                                                            reqData
                                                                                                                                                                                                            ||
                                                                                                                                                                                                            []);
                                                                                                                                                                                                            safeSet(setStats,
                                                                                                                                                                                                            statsData
                                                                                                                                                                                                            ||
                                                                                                                                                                                                            null);
                                                                                                                                                                                                            }
                                                                                                                                                                                                            catch
                                                                                                                                                                                                            (err)
                                                                                                                                                                                                            {
                                                                                                                                                                                                            if
                                                                                                                                                                                                            (isMounted.current)
                                                                                                                                                                                                            {
                                                                                                                                                                                                            setError(err
                                                                                                                                                                                                            instanceof
                                                                                                                                                                                                            Error
                                                                                                                                                                                                            ?
                                                                                                                                                                                                            err.message
                                                                                                                                                                                                            :
                                                                                                                                                                                                            'Lỗi
                                                                                                                                                                                                            làm
                                                                                                                                                                                                            mới
                                                                                                                                                                                                            dữ
                                                                                                                                                                                                            liệu');
                                                                                                                                                                                                            }
                                                                                                                                                                                                            }
                                                                                                                                                                                                            finally
                                                                                                                                                                                                            {
                                                                                                                                                                                                            if
                                                                                                                                                                                                            (isMounted.current)
                                                                                                                                                                                                            {
                                                                                                                                                                                                            setIsLoading(false);
                                                                                                                                                                                                            }
                                                                                                                                                                                                            }
                                                                                                                                                                                                            },
                                                                                                                                                                                                            [baseUrl,
                                                                                                                                                                                                            apiTimeout]);

                                                                                                                                                                                                            /*
                                                                                                                                                                                                            ----
                                                                                                                                                                                                            Tính
                                                                                                                                                                                                            toán衍生值
                                                                                                                                                                                                            ----
                                                                                                                                                                                                            */
                                                                                                                                                                                                            const
                                                                                                                                                                                                            activeJobCount
                                                                                                                                                                                                            =
                                                                                                                                                                                                            useMemo(
                                                                                                                                                                                                            ()
                                                                                                                                                                                                            =>
                                                                                                                                                                                                            jobs.filter((j)
                                                                                                                                                                                                            =>
                                                                                                                                                                                                            !['completed',
                                                                                                                                                                                                            'failed',
                                                                                                                                                                                                            'cancelled'].includes(j.status)).length,
                                                                                                                                                                                                            [jobs],
                                                                                                                                                                                                            );

                                                                                                                                                                                                            /*
                                                                                                                                                                                                            ----
                                                                                                                                                                                                            Memo
                                                                                                                                                                                                            hóa
                                                                                                                                                                                                            giá
                                                                                                                                                                                                            trị
                                                                                                                                                                                                            context
                                                                                                                                                                                                            để
                                                                                                                                                                                                            tránh
                                                                                                                                                                                                            render
                                                                                                                                                                                                            không
                                                                                                                                                                                                            cần
                                                                                                                                                                                                            thiết
                                                                                                                                                                                                            ----
                                                                                                                                                                                                            */
                                                                                                                                                                                                            const
                                                                                                                                                                                                            contextValue
                                                                                                                                                                                                            =
                                                                                                                                                                                                            useMemo
                                                                                                                                                                                                            <RetentionContextValue>
                                                                                                                                                                                                                (()
                                                                                                                                                                                                                =>
                                                                                                                                                                                                                ({
                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Dữ
                                                                                                                                                                                                                liệu
                                                                                                                                                                                                                trạng
                                                                                                                                                                                                                thái
                                                                                                                                                                                                                */
                                                                                                                                                                                                                policies,
                                                                                                                                                                                                                jobs,
                                                                                                                                                                                                                currentJob,
                                                                                                                                                                                                                erasureRequests,
                                                                                                                                                                                                                stats,
                                                                                                                                                                                                                isLoading,
                                                                                                                                                                                                                error,
                                                                                                                                                                                                                activeJobCount,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Chính
                                                                                                                                                                                                                sách
                                                                                                                                                                                                                */
                                                                                                                                                                                                                getPolicies,
                                                                                                                                                                                                                createPolicy,
                                                                                                                                                                                                                updatePolicy,
                                                                                                                                                                                                                deletePolicy,
                                                                                                                                                                                                                togglePolicyStatus,
                                                                                                                                                                                                                triggerPolicy,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Công
                                                                                                                                                                                                                việc
                                                                                                                                                                                                                */
                                                                                                                                                                                                                getJobs,
                                                                                                                                                                                                                getJob,
                                                                                                                                                                                                                refreshJob,
                                                                                                                                                                                                                cancelJob,
                                                                                                                                                                                                                retryJob,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Yêu
                                                                                                                                                                                                                cầu
                                                                                                                                                                                                                xóa
                                                                                                                                                                                                                */
                                                                                                                                                                                                                getErasureRequests,
                                                                                                                                                                                                                createErasureRequest,
                                                                                                                                                                                                                reviewErasureRequest,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Chủ
                                                                                                                                                                                                                thể
                                                                                                                                                                                                                */
                                                                                                                                                                                                                searchSubjects,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Thống
                                                                                                                                                                                                                kê
                                                                                                                                                                                                                */
                                                                                                                                                                                                                getStats,

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                Tiện
                                                                                                                                                                                                                ích
                                                                                                                                                                                                                */
                                                                                                                                                                                                                clearError,
                                                                                                                                                                                                                refreshAll,
                                                                                                                                                                                                                }),
                                                                                                                                                                                                                [
                                                                                                                                                                                                                policies,
                                                                                                                                                                                                                jobs,
                                                                                                                                                                                                                currentJob,
                                                                                                                                                                                                                erasureRequests,
                                                                                                                                                                                                                stats,
                                                                                                                                                                                                                isLoading,
                                                                                                                                                                                                                error,
                                                                                                                                                                                                                activeJobCount,
                                                                                                                                                                                                                getPolicies,
                                                                                                                                                                                                                createPolicy,
                                                                                                                                                                                                                updatePolicy,
                                                                                                                                                                                                                deletePolicy,
                                                                                                                                                                                                                togglePolicyStatus,
                                                                                                                                                                                                                triggerPolicy,
                                                                                                                                                                                                                getJobs,
                                                                                                                                                                                                                getJob,
                                                                                                                                                                                                                refreshJob,
                                                                                                                                                                                                                cancelJob,
                                                                                                                                                                                                                retryJob,
                                                                                                                                                                                                                getErasureRequests,
                                                                                                                                                                                                                createErasureRequest,
                                                                                                                                                                                                                reviewErasureRequest,
                                                                                                                                                                                                                searchSubjects,
                                                                                                                                                                                                                getStats,
                                                                                                                                                                                                                clearError,
                                                                                                                                                                                                                refreshAll,
                                                                                                                                                                                                                ]);

                                                                                                                                                                                                                return
                                                                                                                                                                                                                (
                                                                                                                                                                                                                <RetentionContext.Provider
                                                                                                                                                                                                                    value={contextValue}>
                                                                                                                                                                                                                    {children}
                                                                                                                                                                                                                </RetentionContext.Provider>
                                                                                                                                                                                                                );
                                                                                                                                                                                                                };

                                                                                                                                                                                                                /*
                                                                                                                                                                                                                ===================================================================
                                                                                                                                                                                                                *
                                                                                                                                                                                                                Export
                                                                                                                                                                                                                mặc
                                                                                                                                                                                                                định
                                                                                                                                                                                                                *
                                                                                                                                                                                                                ===================================================================
                                                                                                                                                                                                                */

                                                                                                                                                                                                                export
                                                                                                                                                                                                                default
                                                                                                                                                                                                                RetentionProvider;
                                                                                                                                                                                                                {%
                                                                                                                                                                                                                endraw
                                                                                                                                                                                                                %}