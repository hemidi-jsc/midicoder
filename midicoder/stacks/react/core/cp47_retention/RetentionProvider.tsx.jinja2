{% raw %}/**
* UI Framework: {{{ ui_framework }}}
* RetentionProvider — React Context Provider cho trạng thái và phương thức quản lý vòng đời dữ liệu.
* Sinh bởi CP47 Data Retention & Lifecycle Management.
*
* Cung cấp toàn bộ dữ liệu chính sách, công việc, yêu cầu xóa, thống kê
* cùng các phương thức thao tác cho tất cả component con.
*
* Cách sử dụng:
* <RetentionProvider apiBase="https://api.example.com">
    *
    <App />
    *
</RetentionProvider>
*
* const { policies, jobs, createErasureRequest, stats } = useRetentionContext();
*/
import React, {
createContext,
useContext,
useState,
useEffect,
useCallback,
useRef,
useMemo,
type ReactNode,
} from 'react';

/* ===================================================================
* Interface dữ liệu — tái sử dụng cho toàn bộ hệ thống lưu trữ
* =================================================================== */

/** Trạng thái chính sách lưu trữ */
export type RetentionPolicyStatus = 'active' | 'inactive' | 'expired' | 'draft';

/** Loại dữ liệu áp dụng chính sách */
export type DataType = 'user_data' | 'log_data' | 'session_data' | 'audit_trail' | 'file_attachment' | 'analytics';

/** Hành động sau khi hết hạn */
export type ExpiryAction = 'archive' | 'erase' | 'anonymize';

/** Trạng thái yêu cầu xóa */
export type ErasureRequestStatus = 'submitted' | 'under_review' | 'approved' | 'in_progress' | 'completed' | 'denied' |
'expired';

/** Loại định danh chủ thể */
export type IdentityType = 'email' | 'phone' | 'national_id' | 'passport' | 'user_id';

/** Phạm vi xóa */
export type ErasureScope = 'all_personal_data' | 'account_data' | 'communication_data' | 'usage_data' | 'file_data' |
'consent_data';

/** Trạng thái công việc */
export type JobProgressStatus = 'queued' | 'initializing' | 'processing' | 'verifying' | 'finalizing' | 'completed' |
'failed' | 'cancelled';

/** Loại công việc */
export type JobType = 'archive' | 'erase' | 'anonymize' | 'bulk_delete' | 'data_export';

/* ---- Entity interfaces ---- */

/** Một chính sách lưu trữ */
export interface RetentionPolicy {
id: string;
name: string;
description: string;
data_type: DataType;
retention_days: number;
archive_after_days: number | null;
action_after_expiry: ExpiryAction;
status: RetentionPolicyStatus;
applied_count: number;
created_at: string;
updated_at: string;
created_by?: string;
}

/** Một bước trong công việc */
export interface JobStep {
key: string;
label: string;
description: string;
status: 'pending' | 'active' | 'completed' | 'failed' | 'skipped';
icon: string;
duration_ms?: number;
records_processed?: number;
error_message?: string;
}

/** Một công việc lưu trữ/xóa */
export interface RetentionJob {
id: string;
type: JobType;
policy_id?: string;
policy_name?: string;
status: JobProgressStatus;
total_records: number;
processed_records: number;
steps: JobStep[];
created_at: string;
started_at?: string;
completed_at?: string;
error_message?: string;
estimated_remaining_seconds?: number;
}

/** Một yêu cầu xóa GDPR */
export interface ErasureRequest {
id: string;
subject_id: string;
subject_email: string;
subject_name: string;
status: ErasureRequestStatus;
reason: string;
legal_basis: string;
scope: ErasureScope[];
requested_by: string;
identity_verified: boolean;
records_found: number;
records_erased: number;
created_at: string;
reviewed_at?: string;
completed_at?: string;
denial_reason?: string;
notes?: string;
}

/** Một chủ thể dữ liệu (kết quả tìm kiếm) */
export interface DataSubject {
id: string;
email: string;
phone?: string;
display_name: string;
national_id?: string;
last_activity: string;
data_sources_count: number;
estimated_records: number;
}

/** Dữ liệu thống kê tổng quan */
export interface RetentionStats {
total_policies: number;
active_policies: number;
total_data_size_gb: number;
archived_size_gb: number;
erased_size_gb: number;
pending_jobs: number;
running_jobs: number;
expired_records_count: number;
}

/* ---- Payload interfaces ---- */

/** Dữ liệu tạo/sửa chính sách */
export interface PolicyPayload {
name: string;
description: string;
data_type: DataType;
retention_days: number;
archive_after_days?: number | null;
action_after_expiry: ExpiryAction;
status?: RetentionPolicyStatus;
}

/** Dữ liệu tạo yêu cầu xóa */
export interface ErasurePayload {
subject_identifier: string;
identity_type: IdentityType;
subject_id?: string;
reason: string;
legal_basis: string;
scope: ErasureScope[];
notes?: string;
}

/** Bộ lọc lấy danh sách chính sách */
export interface PolicyFilters {
status?: RetentionPolicyStatus | 'all';
data_type?: DataType | 'all';
search?: string;
}

/** Bộ lọc lấy danh sách yêu cầu xóa */
export interface ErasureFilters {
status?: ErasureRequestStatus | 'all';
own_only?: boolean;
}

/* ===================================================================
* Interface Context — mô tả dữ liệu và phương thức tiếp xúc qua context
* =================================================================== */

export interface RetentionContextValue {
/* ---- Dữ liệu trạng thái ---- */
/** Danh sách chính sách lưu trữ */
policies: RetentionPolicy[];
/** Danh sách công việc */
jobs: RetentionJob[];
/** Công việc hiện tại đang theo dõi */
currentJob: RetentionJob | null;
/** Danh sách yêu cầu xóa GDPR */
erasureRequests: ErasureRequest[];
/** Thống kê tổng quan */
stats: RetentionStats | null;
/** Đang tải dữ liệu */
isLoading: boolean;
/** Thông báo lỗi */
error: string | null;
/** Số công việc đang chạy */
activeJobCount: number;

/* ---- Phương thức: Chính sách ---- */
/** Lấy danh sách chính sách (có bộ lọc) */
getPolicies: (filters?: PolicyFilters) => Promise<RetentionPolicy[]>;
    /** Tạo chính sách mới */
    createPolicy: (payload: PolicyPayload) => Promise<RetentionPolicy | null>;
        /** Cập nhật chính sách */
        updatePolicy: (id: string, payload: Partial<PolicyPayload>) => Promise<RetentionPolicy | null>;
                /** Xóa chính sách */
                deletePolicy: (id: string) => Promise<boolean>;
                    /** Chuyển đổi trạng thái chính sách */
                    togglePolicyStatus: (id: string, status: RetentionPolicyStatus) => Promise<boolean>;
                        /** Kích hoạt chính sách (tạo công việc) */
                        triggerPolicy: (id: string) => Promise<RetentionJob | null>;

                            /* ---- Phương thức: Công việc ---- */
                            /** Lấy danh sách công việc */
                            getJobs: (limit?: number) => Promise<RetentionJob[]>;
                                /** Lấy chi tiết công việc */
                                getJob: (id: string) => Promise<RetentionJob | null>;
                                    /** Làm mới công việc */
                                    refreshJob: (id: string) => Promise<RetentionJob | null>;
                                        /** Hủy công việc */
                                        cancelJob: (id: string) => Promise<boolean>;
                                            /** Thử lại công việc thất bại */
                                            retryJob: (id: string) => Promise<RetentionJob | null>;

                                                /* ---- Phương thức: Yêu cầu xóa ---- */
                                                /** Lấy danh sách yêu cầu xóa */
                                                getErasureRequests: (filters?: ErasureFilters) => Promise
                                                <ErasureRequest[]>;
                                                    /** Tạo yêu cầu xóa mới */
                                                    createErasureRequest: (payload: ErasurePayload) => Promise
                                                    <ErasureRequest | null>;
                                                        /** Xem xét (duyệt/từ chối) yêu cầu xóa */
                                                        reviewErasureRequest: (id: string, action: 'approve' | 'deny',
                                                        reason?: string) => Promise<ErasureRequest | null>;

                                                            /* ---- Phương thức: Chủ thể ---- */
                                                            /** Tìm kiếm chủ thể dữ liệu */
                                                            searchSubjects: (query: string) => Promise<DataSubject[]>;

                                                                /* ---- Phương thức: Thống kê ---- */
                                                                /** Lấy thống kê tổng quan */
                                                                getStats: () => Promise<RetentionStats | null>;

                                                                    /* ---- Tiện ích ---- */
                                                                    /** Xóa thông báo lỗi */
                                                                    clearError: () => void;
                                                                    /** Làm mới tất cả dữ liệu */
                                                                    refreshAll: () => Promise<void>;
                                                                        }

                                                                        /*
                                                                        ===================================================================
                                                                        * Tạo Context với giá trị mặc định null để phát
                                                                        hiện lỗi dùng ngoài Provider
                                                                        *
                                                                        ===================================================================
                                                                        */

                                                                        const RetentionContext = createContext
                                                                        <RetentionContextValue | null>(null);

                                                                            /**
                                                                            * Hook useRetentionContext — truy cập
                                                                            RetentionContext từ bất kỳ component con
                                                                            nào.
                                                                            *
                                                                            * @throws Lỗi nếu gọi bên ngoài
                                                                            RetentionProvider
                                                                            * @returns Đối tượng chứa toàn bộ trạng thái
                                                                            và phương thức quản lý vòng đời dữ liệu
                                                                            */
                                                                            export function useRetentionContext():
                                                                            RetentionContextValue {
                                                                            const context =
                                                                            useContext(RetentionContext);
                                                                            if (context === null) {
                                                                            throw new Error(
                                                                            'useRetentionContext() phải được gọi bên
                                                                            trong <RetentionProvider>. '
                                                                                + 'Vui lòng bọc ứng dụng bằng
                                                                                <RetentionProvider> ở cấp độ cao nhất.'
                                                                                    );
                                                                                    }
                                                                                    return context;
                                                                                    }

                                                                                    /*
                                                                                    ===================================================================
                                                                                    * API helper — gửi yêu cầu fetch với
                                                                                    timeout và xử lý lỗi
                                                                                    *
                                                                                    ===================================================================
                                                                                    */

                                                                                    async function apiRequest(
                                                                                    url: string,
                                                                                    options: RequestInit = {},
                                                                                    apiTimeout: number,
                                                                                    ): Promise<any> {
                                                                                        const controller = new
                                                                                        AbortController();
                                                                                        const timeoutId = setTimeout(()
                                                                                        => controller.abort(),
                                                                                        apiTimeout);

                                                                                        try {
                                                                                        const res = await fetch(url, {
                                                                                        ...options,
                                                                                        headers: {
                                                                                        'Content-Type':
                                                                                        'application/json',
                                                                                        ...(options.headers as Record
                                                                                        <string, string>),
                                                                                            },
                                                                                            signal: controller.signal,
                                                                                            });

                                                                                            clearTimeout(timeoutId);

                                                                                            if (!res.ok) {
                                                                                            const errorBody = await
                                                                                            res.json().catch(() =>
                                                                                            null);
                                                                                            throw new Error(
                                                                                            errorBody?.detail ||
                                                                                            errorBody?.message || `Lỗi
                                                                                            API: ${res.status}
                                                                                            ${res.statusText}`
                                                                                            );
                                                                                            }

                                                                                            const contentType =
                                                                                            res.headers.get('content-type')
                                                                                            || '';
                                                                                            if
                                                                                            (contentType.includes('application/json'))
                                                                                            {
                                                                                            return res.json();
                                                                                            }
                                                                                            return null;
                                                                                            } catch (err: any) {
                                                                                            clearTimeout(timeoutId);
                                                                                            if (err.name ===
                                                                                            'AbortError') {
                                                                                            throw new Error('Yêu cầu hết
                                                                                            giờ — vui lòng thử lại');
                                                                                            }
                                                                                            throw err;
                                                                                            }
                                                                                            }

                                                                                            /*
                                                                                            ===================================================================
                                                                                            * RetentionProvider Props
                                                                                            *
                                                                                            ===================================================================
                                                                                            */

                                                                                            export interface
                                                                                            RetentionProviderProps {
                                                                                            /** Các component con sẽ
                                                                                            được cung cấp context quản
                                                                                            lý vòng đời dữ liệu */
                                                                                            children: ReactNode;
                                                                                            /** URL API cơ sở */
                                                                                            apiBase?: string;
                                                                                            /** Thời gian chờ API (ms)
                                                                                            */
                                                                                            apiTimeout?: number;
                                                                                            /** Tự động tải dữ liệu khi
                                                                                            mount */
                                                                                            autoFetch?: boolean;
                                                                                            /** Khoảng thời gian tự động
                                                                                            làm mới công việc đang chạy
                                                                                            (ms), 0 = tắt */
                                                                                            jobRefreshInterval?: number;
                                                                                            }

                                                                                            /*
                                                                                            ===================================================================
                                                                                            * RetentionProvider
                                                                                            Component — cung cấp
                                                                                            RetentionContext cho toàn bộ
                                                                                            tree con
                                                                                            *
                                                                                            ===================================================================
                                                                                            */

                                                                                            export const
                                                                                            RetentionProvider: React.FC
                                                                                            <RetentionProviderProps> =
                                                                                                ({
                                                                                                children,
                                                                                                apiBase,
                                                                                                apiTimeout:
                                                                                                propApiTimeout,
                                                                                                autoFetch:
                                                                                                propAutoFetch,
                                                                                                jobRefreshInterval:
                                                                                                propJobRefreshInterval,
                                                                                                }) => {
                                                                                                const baseUrl = apiBase
                                                                                                || '/api';
                                                                                                const apiTimeout =
                                                                                                propApiTimeout || 30000;
                                                                                                const autoFetch =
                                                                                                propAutoFetch ?? true;
                                                                                                const jobRefreshInterval
                                                                                                = propJobRefreshInterval
                                                                                                ?? 5000;

                                                                                                /* ---- State ---- */
                                                                                                const [policies,
                                                                                                setPolicies] = useState
                                                                                                <RetentionPolicy[]>([]);
                                                                                                    const [jobs,
                                                                                                    setJobs] = useState
                                                                                                    <RetentionJob[]>
                                                                                                        ([]);
                                                                                                        const
                                                                                                        [currentJob,
                                                                                                        setCurrentJob] =
                                                                                                        useState
                                                                                                        <RetentionJob |
                                                                                                            null>(null);
                                                                                                            const
                                                                                                            [erasureRequests,
                                                                                                            setErasureRequests]
                                                                                                            = useState
                                                                                                            <ErasureRequest[]>
                                                                                                                ([]);
                                                                                                                const
                                                                                                                [stats,
                                                                                                                setStats]
                                                                                                                =
                                                                                                                useState
                                                                                                                <RetentionStats
                                                                                                                    |
                                                                                                                    null>
                                                                                                                    (null);
                                                                                                                    const
                                                                                                                    [isLoading,
                                                                                                                    setIsLoading]
                                                                                                                    =
                                                                                                                    useState(false);
                                                                                                                    const
                                                                                                                    [error,
                                                                                                                    setError]
                                                                                                                    =
                                                                                                                    useState
                                                                                                                    <string
                                                                                                                        |
                                                                                                                        null>
                                                                                                                        (null);

                                                                                                                        /*
                                                                                                                        Ref
                                                                                                                        theo
                                                                                                                        dõi
                                                                                                                        mount/unmount
                                                                                                                        để
                                                                                                                        tránh
                                                                                                                        setState
                                                                                                                        sau
                                                                                                                        unmount
                                                                                                                        */
                                                                                                                        const
                                                                                                                        isMounted
                                                                                                                        =
                                                                                                                        useRef(true);

                                                                                                                        useEffect(()
                                                                                                                        =>
                                                                                                                        {
                                                                                                                        isMounted.current
                                                                                                                        =
                                                                                                                        true;
                                                                                                                        return
                                                                                                                        ()
                                                                                                                        =>
                                                                                                                        {
                                                                                                                        isMounted.current
                                                                                                                        =
                                                                                                                        false;
                                                                                                                        };
                                                                                                                        },
                                                                                                                        []);

                                                                                                                        /*
                                                                                                                        Hàm
                                                                                                                        an
                                                                                                                        toàn
                                                                                                                        —
                                                                                                                        chỉ
                                                                                                                        cập
                                                                                                                        nhật
                                                                                                                        state
                                                                                                                        nếu
                                                                                                                        component
                                                                                                                        vẫn
                                                                                                                        mount
                                                                                                                        */
                                                                                                                        const
                                                                                                                        safeSet
                                                                                                                        =
                                                                                                                        useCallback(
                                                                                                                        <T,>(setter:
                                                                                                                            (val:
                                                                                                                            T)
                                                                                                                            =>
                                                                                                                            void,
                                                                                                                            value:
                                                                                                                            T)
                                                                                                                            =>
                                                                                                                            {
                                                                                                                            if
                                                                                                                            (isMounted.current)
                                                                                                                            {
                                                                                                                            setter(value);
                                                                                                                            }
                                                                                                                            },
                                                                                                                            []);

                                                                                                                            /*
                                                                                                                            ----
                                                                                                                            Tự
                                                                                                                            động
                                                                                                                            tải
                                                                                                                            dữ
                                                                                                                            liệu
                                                                                                                            ban
                                                                                                                            đầu
                                                                                                                            ----
                                                                                                                            */
                                                                                                                            useEffect(()
                                                                                                                            =>
                                                                                                                            {
                                                                                                                            if
                                                                                                                            (!autoFetch)
                                                                                                                            return;

                                                                                                                            const
                                                                                                                            initialLoad
                                                                                                                            =
                                                                                                                            async
                                                                                                                            ()
                                                                                                                            =>
                                                                                                                            {
                                                                                                                            setIsLoading(true);
                                                                                                                            setError(null);
                                                                                                                            try
                                                                                                                            {
                                                                                                                            const
                                                                                                                            [polData,
                                                                                                                            jobsData,
                                                                                                                            reqData,
                                                                                                                            statsData]
                                                                                                                            =
                                                                                                                            await
                                                                                                                            Promise.all([
                                                                                                                            apiRequest(`${baseUrl}/api/retention/policies`,
                                                                                                                            {},
                                                                                                                            apiTimeout).catch(()
                                                                                                                            =>
                                                                                                                            []),
                                                                                                                            apiRequest(`${baseUrl}/api/retention/jobs?limit=20`,
                                                                                                                            {},
                                                                                                                            apiTimeout).catch(()
                                                                                                                            =>
                                                                                                                            []),
                                                                                                                            apiRequest(`${baseUrl}/api/retention/erasure-requests`,
                                                                                                                            {},
                                                                                                                            apiTimeout).catch(()
                                                                                                                            =>
                                                                                                                            []),
                                                                                                                            apiRequest(`${baseUrl}/api/retention/stats`,
                                                                                                                            {},
                                                                                                                            apiTimeout).catch(()
                                                                                                                            =>
                                                                                                                            null),
                                                                                                                            ]);
                                                                                                                            safeSet(setPolicies,
                                                                                                                            polData
                                                                                                                            ||
                                                                                                                            []);
                                                                                                                            safeSet(setJobs,
                                                                                                                            jobsData
                                                                                                                            ||
                                                                                                                            []);
                                                                                                                            safeSet(setErasureRequests,
                                                                                                                            reqData
                                                                                                                            ||
                                                                                                                            []);
                                                                                                                            safeSet(setStats,
                                                                                                                            statsData
                                                                                                                            ||
                                                                                                                            null);
                                                                                                                            }
                                                                                                                            catch
                                                                                                                            (err)
                                                                                                                            {
                                                                                                                            if
                                                                                                                            (isMounted.current)
                                                                                                                            {
                                                                                                                            setError(err
                                                                                                                            instanceof
                                                                                                                            Error
                                                                                                                            ?
                                                                                                                            err.message
                                                                                                                            :
                                                                                                                            'Lỗi
                                                                                                                            tải
                                                                                                                            dữ
                                                                                                                            liệu
                                                                                                                            ban
                                                                                                                            đầu');
                                                                                                                            }
                                                                                                                            }
                                                                                                                            finally
                                                                                                                            {
                                                                                                                            if
                                                                                                                            (isMounted.current)
                                                                                                                            {
                                                                                                                            setIsLoading(false);
                                                                                                                            }
                                                                                                                            }
                                                                                                                            };

                                                                                                                            initialLoad();
                                                                                                                            },
                                                                                                                            []);
                                                                                                                            //
                                                                                                                            eslint-disable-line
                                                                                                                            react-hooks/exhaustive-deps

                                                                                                                            /*
                                                                                                                            ----
                                                                                                                            Tự
                                                                                                                            động
                                                                                                                            làm
                                                                                                                            mới
                                                                                                                            công
                                                                                                                            việc
                                                                                                                            đang
                                                                                                                            chạy
                                                                                                                            ----
                                                                                                                            */
                                                                                                                            useEffect(()
                                                                                                                            =>
                                                                                                                            {
                                                                                                                            if
                                                                                                                            (jobRefreshInterval
                                                                                                                            <= 0)
                                                                                                                                return;
                                                                                                                                const
                                                                                                                                terminalStatuses=['completed', 'failed'
                                                                                                                                , 'cancelled'
                                                                                                                                ];
                                                                                                                                const
                                                                                                                                activeJobs=jobs.filter((j)=>
                                                                                                                                !terminalStatuses.includes(j.status));
                                                                                                                                if
                                                                                                                                (!activeJobs.length)
                                                                                                                                return;

                                                                                                                                const
                                                                                                                                id
                                                                                                                                =
                                                                                                                                setInterval(async
                                                                                                                                ()
                                                                                                                                =>
                                                                                                                                {
                                                                                                                                for
                                                                                                                                (const
                                                                                                                                job
                                                                                                                                of
                                                                                                                                activeJobs)
                                                                                                                                {
                                                                                                                                try
                                                                                                                                {
                                                                                                                                const
                                                                                                                                res
                                                                                                                                =
                                                                                                                                await
                                                                                                                                fetch(`${baseUrl}/api/retention/jobs/${job.id}`);
                                                                                                                                if
                                                                                                                                (res.ok)
                                                                                                                                {
                                                                                                                                const
                                                                                                                                updated
                                                                                                                                =
                                                                                                                                await
                                                                                                                                res.json();
                                                                                                                                safeSet(setJobs,
                                                                                                                                (prev)
                                                                                                                                =>
                                                                                                                                prev.map((j)
                                                                                                                                =>
                                                                                                                                (j.id
                                                                                                                                ===
                                                                                                                                job.id
                                                                                                                                ?
                                                                                                                                updated
                                                                                                                                :
                                                                                                                                j))
                                                                                                                                );
                                                                                                                                if
                                                                                                                                (currentJob?.id
                                                                                                                                ===
                                                                                                                                job.id)
                                                                                                                                {
                                                                                                                                safeSet(setCurrentJob,
                                                                                                                                updated);
                                                                                                                                }
                                                                                                                                }
                                                                                                                                }
                                                                                                                                catch
                                                                                                                                {
                                                                                                                                //
                                                                                                                                Bỏ
                                                                                                                                qua
                                                                                                                                lỗi
                                                                                                                                làm
                                                                                                                                mới
                                                                                                                                từng
                                                                                                                                công
                                                                                                                                việc
                                                                                                                                }
                                                                                                                                }
                                                                                                                                },
                                                                                                                                jobRefreshInterval);

                                                                                                                                return
                                                                                                                                ()
                                                                                                                                =>
                                                                                                                                clearInterval(id);
                                                                                                                                },
                                                                                                                                [jobs,
                                                                                                                                currentJob,
                                                                                                                                baseUrl,
