/** Màu và nhãn cho trạng thái yêu cầu xóa */
function erasureStatusStyle(status: ErasureRequestStatus): React.CSSProperties {
    const map: Record<ErasureRequestStatus, { bg: string; color: string }> = {
        submitted:     { bg: '#dbeafe', color: '#1e40af' },
        under_review:  { bg: '#fef3c7', color: '#92400e' },
        approved:      { bg: '#d1fae5', color: '#065f46' },
        in_progress:   { bg: '#e0e7ff', color: '#3730a3' },
        completed:     { bg: '#d1fae5', color: '#065f46' },
        denied:        { bg: '#fee2e2', color: '#991b1b' },
        expired:       { bg: '#f1f5f9', color: '#475569' },
    };
    const c = map[status] || { bg: '#f1f5f9', color: '#475569' };
    return { ...sBadgeBase, backgroundColor: c.bg, color: c.color };
}

function erasureStatusLabel(status: ErasureRequestStatus): string {
    const map: Record<ErasureRequestStatus, string> = {
        submitted:     'Đã gửi',
        under_review:  'Đang xem xét',
        approved:      'Đã duyệt',
        in_progress:   'Đang xử lý',
        completed:     'Hoàn thành',
        denied:        'Bị từ chối',
        expired:       'Đã hết hạn',
    };
    return map[status] || status;
}

