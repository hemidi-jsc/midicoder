function formatDateTime(iso: string | null | undefined): string {
    if (!iso) return '—';
    return new Date(iso).toLocaleDateString('vi-VN', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
    });
}

/* ---- Xác thực biểu mẫu ---- */

function validateErasureForm(data: ErasureFormData): ErasureFormErrors {
    const errors: ErasureFormErrors = {};

    if (!data.subject_identifier.trim()) {
        errors.subject_identifier = 'Vui lòng nhập thông tin định danh chủ thể';
    }

    if (!data.identity_type) {
        errors.identity_type = 'Vui lòng chọn loại định danh';
    }

    if (!data.reason.trim()) {
        errors.reason = 'Lý do xóa không được để trống';
    } else if (data.reason.trim().length < 10) {
        errors.reason = 'Lý do xóa cần ít nhất 10 ký tự';
    }

    if (!data.legal_basis) {
        errors.legal_basis = 'Vui lòng chọn cơ sở pháp lý';
    }

    if (!data.scope.length) {
        errors.scope = 'Vui lòng chọn ít nhất một phạm vi dữ liệu cần xóa';
    }

    return errors;
}

/* ---- Component chính ---- */

export const RetentionErasure: React.FC<RetentionErasureProps> = ({
    apiBase,
    onErasureRequest,
    ownRequestsOnly = false,
}) => {
    const baseUrl = apiBase || '/api';

    /* Trạng thái tìm kiếm chủ thể */
    const [searchQuery, setSearchQuery] = useState('');
    const [searchResults, setSearchResults] = useState<DataSubject[]>([]);
    const [searching, setSearching] = useState(false);
    const [selectedSubject, setSelectedSubject] = useState<DataSubject | null>(null);

    /* Trạng thái danh sách yêu cầu xóa */
    const [requests, setRequests] = useState<ErasureRequest[]>([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);
    const [success, setSuccess] = useState<string | null>(null);

    /* Bộ lọc */
    const [filterStatus, setFilterStatus] = useState<ErasureRequestStatus | 'all'>('all');

    /* Modal biểu mẫu */
    const [showForm, setShowForm] = useState(false);
    const [formData, setFormData] = useState<ErasureFormData>({ ...emptyForm });
    const [formErrors, setFormErrors] = useState<ErasureFormErrors>({});
    const [submitting, setSubmitting] = useState(false);

    /* Chi tiết yêu cầu */
    const [selectedRequest, setSelectedRequest] = useState<ErasureRequest | null>(null);

    /* Tìm kiếm chủ thể dữ liệu */
    const searchSubjects = useCallback(async (query: string) => {
        if (!query.trim() || query.trim().length < 2) {
            setSearchResults([]);
            return;
        }
        setSearching(true);
        try {
            const res = await fetch(
                `${baseUrl}/api/retention/subjects?q=${encodeURIComponent(query.trim())}`
            );
            const data = await res.json();
            setSearchResults(data || []);
        } catch {
            setSearchResults([]);
        } finally {
            setSearching(false);
        }
    }, [baseUrl]);

    /* Debounce tìm kiếm */
    const handleSearchChange = useCallback((value: string) => {
        setSearchQuery(value);
        setFormData((prev) => ({ ...prev, subject_identifier: value }));
        const timer = setTimeout(() => {
            searchSubjects(value);
        }, 400);
        return () => clearTimeout(timer);
    }, [searchSubjects]);

    /* Tải danh sách yêu cầu xóa */
    const loadRequests = useCallback(async () => {
        setLoading(true);
        setError(null);
        try {
            const params = new URLSearchParams();
            if (filterStatus !== 'all') params.set('status', filterStatus);
            if (ownRequestsOnly) params.set('own_only', 'true');

            const res = await fetch(`${baseUrl}/api/retention/erasure-requests?${params.toString()}`);
            const data = await res.json();
            setRequests(data || []);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Không thể tải danh sách yêu cầu xóa');
        } finally {
            setLoading(false);
        }
    }, [baseUrl, filterStatus, ownRequestsOnly]);

    useEffect(() => {
        loadRequests();
    }, [loadRequests]);

    /* Sắp xếp yêu cầu — ưu tiên chưa hoàn thành */
    const sortedRequests = useMemo(() => {
        const priority: Record<ErasureRequestStatus, number> = {
            submitted: 0,
            under_review: 1,
            approved: 2,
            in_progress: 3,
            denied: 4,
            expired: 5,
            completed: 6,
        };
        return [...requests].sort((a, b) => {
            const pDiff = priority[a.status] - priority[b.status];
            if (pDiff !== 0) return pDiff;
            return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
        });
    }, [requests]);

    /* Mở form tạo yêu cầu xóa */
    const openCreateForm = useCallback(() => {
        setFormData({ ...emptyForm });
        setFormErrors({});
        setSelectedSubject(null);
        setSearchQuery('');
        setSearchResults([]);
        setShowForm(true);
    }, []);

    const closeForm = useCallback(() => {
        setShowForm(false);
        setFormErrors({});
    }, []);

    /* Chọn chủ thể từ kết quả tìm kiếm */
    const selectSubject = useCallback((subject: DataSubject) => {
        setSelectedSubject(subject);
        setFormData((prev) => ({
            ...prev,
            subject_identifier: subject.email,
            identity_type: 'email',
        }));
        setSearchResults([]);
    }, []);

    /* Cập nhật trường biểu mẫu */
    const updateField = useCallback(<K extends keyof ErasureFormData>(field: K, value: ErasureFormData[K]) => {
        setFormData((prev) => ({ ...prev, [field]: value }));
        setFormErrors((prev) => {
            const next = { ...prev };
            delete next[field];
            return next;
        });
    }, []);

    /* Toggle phạm vi xóa */
    const toggleScope = useCallback((scope: ErasureScope) => {
        setFormData((prev) => {
            const exists = prev.scope.includes(scope);
            return {
                ...prev,
                scope: exists
                    ? prev.scope.filter((s) => s !== scope)
                    : [...prev.scope, scope],
            };
        });
        setFormErrors((prev) => {
            const next = { ...prev };
            delete next.scope;
            return next;
        });
    }, []);

    /* Gửi yêu cầu xóa */
    const handleSubmit = useCallback(async () => {
        const errors = validateErasureForm(formData);
        if (Object.keys(errors).length > 0) {
            setFormErrors(errors);
            return;
        }

        setSubmitting(true);
        setError(null);
        setSuccess(null);

        try {
            const payload = {
                subject_identifier: formData.subject_identifier.trim(),
                identity_type: formData.identity_type,
                subject_id: selectedSubject?.id,
                reason: formData.reason.trim(),
                legal_basis: formData.legal_basis,
                scope: formData.scope,
                notes: formData.notes.trim() || undefined,
            };

            const res = await fetch(`${baseUrl}/api/retention/erasure-requests`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            if (!res.ok) {
                const errBody = await res.json().catch(() => null);
                throw new Error(errBody?.detail || errBody?.message || `Lỗi (${res.status})`);
            }

            const newRequest = await res.json();
            setSuccess('Yêu cầu xóa đã được gửi thành công');
            closeForm();
            await loadRequests();
            onErasureRequest?.(newRequest);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Không thể gửi yêu cầu xóa');
        } finally {
            setSubmitting(false);
        }
    }, [formData, selectedSubject, baseUrl, closeForm, loadRequests, onErasureRequest]);

    /* Xem chi tiết yêu cầu */
    const viewRequestDetail = useCallback((request: ErasureRequest) => {
        setSelectedRequest(request);
    }, []);

    /* Tính tỷ lệ hoàn thành xóa */
    const eraseProgress = useCallback((r: ErasureRequest): number => {
        if (r.records_found <= 0) return 0;
        return Math.min(100, Math.round((r.records_erased / r.records_found) * 100));
    }, []);

    /* Nút phê duyệt/từ chối yêu cầu */
    const handleReview = useCallback(async (requestId: string, action: 'approve' | 'deny', reason?: string) => {
        try {
            const payload: Record<string, any> = { action };
            if (reason) payload.reason = reason;

            const res = await fetch(`${baseUrl}/api/retention/erasure-requests/${requestId}/review`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            if (!res.ok) throw new Error('Không thể xử lý yêu cầu xem xét');

            setSuccess(action === 'approve' ? 'Đã phê duyệt yêu cầu xóa' : 'Đã từ chối yêu cầu xóa');
            await loadRequests();
            setSelectedRequest(null);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Lỗi khi xử lý xem xét');
        }
    }, [baseUrl, loadRequests]);

    return (
        <div style={sWrap}>
            {/* Header */}
            <div style={sHeader}>
                <div>
                    <h1 style={sHeaderTitle}>Yêu cầu xóa dữ liệu (GDPR)</h1>
                    <p style={sHeaderSub}>
                        Quản lý yêu cầu xóa dữ liệu cá nhân theo quy định GDPR và luật bảo vệ dữ liệu
                    </p>
                </div>
                <button onClick={openCreateForm} style={sBtnDanger}>
                    + Yêu cầu xóa mới
                </button>
            </div>

            {/* Cảnh báo pháp lý */}
            <div style={sWarning}>
                <strong>Lưu ý pháp lý:</strong> Yêu cầu xóa dữ liệu tuân thủ Điều 17 GDPR (Quyền bị quên).
                Quá trình xóa có thể mất thời gian và sẽ được ghi nhận trong dấu vết kiểm toán.
            </div>

            {/* Thông báo */}
            {error && <div style={sError}><strong>Lỗi:</strong> {error}</div>}
            {success && <div style={sSuccess}><strong>Thành công:</strong> {success}</div>}

            {/* Bộ lọc */}
            <div style={{ marginBottom: '16px', display: 'flex', gap: '10px', alignItems: 'center' }}>
                <span style={{ fontSize: '14px', fontWeight: 600, color: '#334155' }}>Trạng thái:</span>
                <select
                    value={filterStatus}
                    onChange={(e) => setFilterStatus(e.target.value as ErasureRequestStatus | 'all')}
                    style={{ padding: '8px 12px', borderRadius: '8px', border: '1px solid #e2e8f0', fontSize: '14px' }}
                >
                    <option value="all">Tất cả</option>
                    <option value="submitted">Đã gửi</option>
                    <option value="under_review">Đang xem xét</option>
                    <option value="approved">Đã duyệt</option>
                    <option value="in_progress">Đang xử lý</option>
                    <option value="completed">Hoàn thành</option>
                    <option value="denied">Bị từ chối</option>
                    <option value="expired">Đã hết hạn</option>
                </select>
                <button onClick={loadRequests} style={sBtnSuccess}>Làm mới</button>
            </div>

            {/* Bảng yêu cầu xóa */}
            <div style={sCard}>
                <h2 style={sCardTitle}>Danh sách yêu cầu xóa ({sortedRequests.length})</h2>
                {loading ? (
                    <div style={sLoading}>Đang tải yêu cầu xóa...</div>
                ) : (
                    <div style={{ overflowX: 'auto' }}>
                        <table style={sTable}>
                            <thead>
                                <tr>
                                    <th style={sTh}>ID</th>
                                    <th style={sTh}>Chủ thể</th>
                                    <th style={sTh}>Email</th>
                                    <th style={sTh}>Lý do</th>
                                    <th style={sTh}>Phạm vi</th>
                                    <th style={sTh}>Tiến độ</th>
                                    <th style={sTh}>Trạng thái</th>
                                    <th style={sTh}>Ngày tạo</th>
                                    <th style={sTh}>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                {sortedRequests.map((r) => {
                                    const progress = eraseProgress(r);
                                    return (
                                        <tr key={r.id}>
                                            <td style={sTd}>
                                                <span style={sTdCode}>{r.id.slice(0, 12)}</span>
                                            </td>
                                            <td style={{ ...sTd, fontWeight: 500 }}>{r.subject_name}</td>
                                            <td style={sTd}>{r.subject_email}</td>
                                            <td style={sTd}>
                                                <div style={{ maxWidth: '200px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                    {r.reason}
                                                </div>
                                            </td>
                                            <td style={sTd}>
                                                {r.scope.length} mục
                                                <span style={{ fontSize: '11px', color: '#64748b', display: 'block' }}>
                                                    {r.scope.slice(0, 2).map((s) => scopeLabels[s] || s).join(', ')}
                                                    {r.scope.length > 2 ? '...' : ''}
                                                </span>
                                            </td>
                                            <td style={{ ...sTd, minWidth: '100px' }}>
                                                {r.records_found > 0 ? (
                                                    <>
                                                        <div style={{ fontSize: '12px', color: '#64748b', marginBottom: '4px' }}>
                                                            {r.records_erased}/{r.records_found}
                                                        </div>
                                                        <div style={sProgressBar}>
                                                            <div
                                                                style={{
                                                                    ...sProgressFill,
                                                                    width: `${progress}%`,
                                                                    backgroundColor:
                                                                        r.status === 'completed' ? '#22c55e'
                                                                            : r.status === 'in_progress' ? '#3b82f6'
                                                                            : '#94a3b8',
                                                                }}
                                                            />
                                                        </div>
                                                    </>
                                                ) : (
                                                    <span style={{ fontSize: '12px', color: '#94a3b8' }}>—</span>
                                                )}
                                            </td>
                                            <td style={sTd}>
                                                <span style={erasureStatusStyle(r.status)}>
                                                    {erasureStatusLabel(r.status)}
                                                </span>
                                            </td>
                                            <td style={sTd}>{formatDateTime(r.created_at)}</td>
                                            <td style={{ ...sTd, whiteSpace: 'nowrap' }}>
                                                <button
                                                    onClick={() => viewRequestDetail(r)}
                                                    style={{ ...sBtnSmall, marginRight: '6px' }}
                                                >
                                                    Chi tiết
                                                </button>
                                                {(r.status === 'under_review' || r.status === 'submitted') && (
                                                    <>
                                                        <button
                                                            onClick={() => handleReview(r.id, 'approve')}
                                                            style={{ ...sBtnSmall, ...sBtnSuccess, marginRight: '6px' }}
                                                        >
                                                            Duyệt
                                                        </button>
                                                        <button
                                                            onClick={() => handleReview(r.id, 'deny')}
                                                            style={{ ...sBtnSmall, ...sBtnDanger }}
                                                        >
                                                            Từ chối
                                                        </button>
                                                    </>
                                                )}
                                            </td>
                                        </tr>
                                    );
                                })}
                                {!sortedRequests.length && (
                                    <tr>
                                        <td colSpan={9} style={sEmptyState}>
                                            Chưa có yêu cầu xóa nào. Nhấn "Yêu cầu xóa mới" để tạo.
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                )}
            </div>

            {/* Modal biểu mẫu yêu cầu xóa */}
            {showForm && (
                <div style={sOverlay} onClick={closeForm}>
                    <div style={sModal} onClick={(e) => e.stopPropagation()}>
                        <h2 style={sModalTitle}>Yêu cầu xóa dữ liệu mới</h2>

                        {/* Tìm kiếm chủ thể */}
                        <div style={sFormField}>
                            <label style={sFormLabel}>Tìm kiếm chủ thể dữ liệu *</label>
                            <input
                                type="text"
                                value={searchQuery}
                                onChange={(e) => handleSearchChange(e.target.value)}
                                style={sFormInput}
                                placeholder="Nhập email, số điện thoại, hoặc ID..."
                            />
                            {searching && (
                                <div style={{ fontSize: '12px', color: '#64748b', marginTop: '4px' }}>Đang tìm kiếm...</div>
                            )}
                        </div>

                        {/* Kết quả tìm kiếm */}
                        {searchResults.length > 0 && (
                            <div style={{ marginBottom: '16px', maxHeight: '160px', overflowY: 'auto' }}>
                                {searchResults.map((subject) => (
                                    <div
                                        key={subject.id}
                                        style={selectedSubject?.id === subject.id ? sSubjectCardSelected : sSubjectCard}
                                        onClick={() => selectSubject(subject)}
                                    >
                                        <div style={{ fontWeight: 600, fontSize: '14px' }}>{subject.display_name}</div>
                                        <div style={{ fontSize: '12px', color: '#64748b' }}>
                                            {subject.email}
                                            {subject.phone ? ` | ${subject.phone}` : ''}
                                        </div>
                                        <div style={{ fontSize: '11px', color: '#94a3b8' }}>
                                            {subject.data_sources_count} nguồn dữ liệu
                                            {' '}• ~{subject.estimated_records.toLocaleString('vi-VN')} bản ghi
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}

                        <div style={sFormField}>
                            <label style={sFormLabel}>Loại định danh *</label>
                            <select
                                value={formData.identity_type}
                                onChange={(e) => updateField('identity_type', e.target.value as IdentityType)}
                                style={formErrors.identity_type ? sFormInputError : sFormInput}
                            >
                                <option value="">-- Chọn loại --</option>
                                {Object.entries(identityLabels).map(([val, lbl]) => (
                                    <option key={val} value={val}>{lbl}</option>
                                ))}
                            </select>
                            {formErrors.identity_type && <div style={sFormErrorText}>{formErrors.identity_type}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Cơ sở pháp lý *</label>
                            <select
                                value={formData.legal_basis}
                                onChange={(e) => updateField('legal_basis', e.target.value)}
                                style={formErrors.legal_basis ? sFormInputError : sFormInput}
                            >
                                <option value="">-- Chọn cơ sở pháp lý --</option>
                                {legalBasisOptions.map((opt) => (
                                    <option key={opt.value} value={opt.value}>{opt.label}</option>
                                ))}
                            </select>
                            {formErrors.legal_basis && <div style={sFormErrorText}>{formErrors.legal_basis}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Phạm vi dữ liệu cần xóa *</label>
                            <div style={sCheckboxGroup}>
                                {(Object.entries(scopeLabels) as [ErasureScope, string][]).map(([val, lbl]) => (
                                    <label key={val} style={sCheckboxItem}>
                                        <input
                                            type="checkbox"
                                            checked={formData.scope.includes(val)}
                                            onChange={() => toggleScope(val)}
                                        />
                                        {lbl}
                                    </label>
                                ))}
                            </div>
                            {formErrors.scope && <div style={sFormErrorText}>{formErrors.scope}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Lý do xóa *</label>
                            <textarea
                                value={formData.reason}
                                onChange={(e) => updateField('reason', e.target.value)}
                                style={formErrors.reason ? sFormTextarea : sFormTextarea}
                                placeholder="Mô tả lý do yêu cầu xóa dữ liệu..."
                            />
                            {formErrors.reason && <div style={sFormErrorText}>{formErrors.reason}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Ghi chú (tùy chọn)</label>
                            <textarea
                                value={formData.notes}
                                onChange={(e) => updateField('notes', e.target.value)}
                                style={sFormTextarea}
                                placeholder="Thông tin bổ sung cho bộ phận xử lý..."
                            />
                        </div>

                        <div style={sFormActions}>
                            <button onClick={closeForm} style={sBtnBase} disabled={submitting}>
                                Hủy
                            </button>
                            <button onClick={handleSubmit} style={sBtnDanger} disabled={submitting}>
                                {submitting ? 'Đang gửi...' : 'Gửi yêu cầu xóa'}
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* Modal chi tiết yêu cầu */}
            {selectedRequest && (
                <div style={sOverlay} onClick={() => setSelectedRequest(null)}>
                    <div style={sModal} onClick={(e) => e.stopPropagation()}>
                        <h2 style={sModalTitle}>Chi tiết yêu cầu xóa</h2>
                        <div style={{ fontSize: '14px', color: '#334155' }}>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>ID:</strong>{' '}
                                <span style={{ ...sTdCode, marginLeft: '8px' }}>{selectedRequest.id}</span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Chủ thể:</strong>{' '}
                                <span style={{ marginLeft: '8px' }}>{selectedRequest.subject_name} ({selectedRequest.subject_email})</span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Trạng thái:</strong>{' '}
                                <span style={{ marginLeft: '8px' }}>
                                    <span style={erasureStatusStyle(selectedRequest.status)}>
                                        {erasureStatusLabel(selectedRequest.status)}
                                    </span>
                                </span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Cơ sở pháp lý:</strong>{' '}
                                <span style={{ marginLeft: '8px' }}>
                                    {legalBasisOptions.find((o) => o.value === selectedRequest.legal_basis)?.label || selectedRequest.legal_basis}
                                </span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Lý do:</strong>
                                <div style={{ marginTop: '4px', paddingLeft: '16px', color: '#475569' }}>
                                    {selectedRequest.reason}
                                </div>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Phạm vi:</strong>
                                <div style={{ marginTop: '4px', paddingLeft: '16px' }}>
                                    {selectedRequest.scope.map((s) => (
                                        <div key={s} style={{ fontSize: '13px' }}>
                                            {scopeLabels[s] || s}
                                        </div>
                                    ))}
                                </div>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Tiến độ xóa:</strong>{' '}
                                {selectedRequest.records_found > 0
                                    ? `${selectedRequest.records_erased}/${selectedRequest.records_found} bản ghi`
                                    : 'Chưa bắt đầu'}
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Đã xác minh danh tính:</strong>{' '}
                                <span style={{ color: selectedRequest.identity_verified ? '#16a34a' : '#dc2626' }}>
                                    {selectedRequest.identity_verified ? 'Đã xác minh' : 'Chưa xác minh'}
                                </span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Người gửi:</strong>{' '}
                                <span style={{ marginLeft: '8px' }}>{selectedRequest.requested_by}</span>
                            </div>
                            <div style={{ marginBottom: '12px' }}>
                                <strong>Ngày tạo:</strong>{' '}
                                <span style={{ marginLeft: '8px' }}>{formatDateTime(selectedRequest.created_at)}</span>
                            </div>
                            {selectedRequest.completed_at && (
                                <div style={{ marginBottom: '12px' }}>
                                    <strong>Ngày hoàn thành:</strong>{' '}
                                    <span style={{ marginLeft: '8px' }}>{formatDateTime(selectedRequest.completed_at)}</span>
                                </div>
                            )}
                            {selectedRequest.denial_reason && (
                                <div style={{ marginBottom: '12px', padding: '10px', background: '#fef2f2', borderRadius: '6px', color: '#991b1b' }}>
                                    <strong>Lý do từ chối:</strong> {selectedRequest.denial_reason}
                                </div>
                            )}
                            {selectedRequest.notes && (
                                <div style={{ marginBottom: '12px', padding: '10px', background: '#f8fafc', borderRadius: '6px', color: '#475569' }}>
                                    <strong>Ghi chú:</strong> {selectedRequest.notes}
                                </div>
                            )}
                        </div>
                        <div style={sFormActions}>
                            {(selectedRequest.status === 'under_review' || selectedRequest.status === 'submitted') && (
                                <>
                                    <button
                                        onClick={() => handleReview(selectedRequest.id, 'approve')}
                                        style={sBtnSuccess}
                                    >
                                        Phê duyệt
                                    </button>
                                    <button
                                        onClick={() => handleReview(selectedRequest.id, 'deny')}
                                        style={sBtnDanger}
                                    >
                                        Từ chối
                                    </button>
                                </>
                            )}
                            <button onClick={() => setSelectedRequest(null)} style={sBtnBase}>
                                Đóng
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
};

export default RetentionErasure;
{% endraw %}
