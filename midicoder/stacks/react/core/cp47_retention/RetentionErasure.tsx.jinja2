{% raw %}/**
 * RetentionErasure — Thành phần yêu cầu xóa dữ liệu theo GDPR: tìm kiếm chủ thể,
 * biểu mẫu xóa, theo dõi trạng thái, nhật ký xóa đã thực hiện.
 * Sinh bởi CP47 Data Retention & Lifecycle Management.
 */
import React, { useEffect, useState, useMemo, useCallback } from 'react';

/* ---- Interface dữ liệu ---- */

/** Trạng thái yêu cầu xóa */
export type ErasureRequestStatus = 'submitted' | 'under_review' | 'approved' | 'in_progress' | 'completed' | 'denied' | 'expired';

/** Loại bằng chứng/định danh chủ thể */
export type IdentityType = 'email' | 'phone' | 'national_id' | 'passport' | 'user_id';

/** Loại dữ liệu cần xóa */
export type ErasureScope = 'all_personal_data' | 'account_data' | 'communication_data' | 'usage_data' | 'file_data' | 'consent_data';

/** Một chủ thể dữ liệu (kết quả tìm kiếm) */
export interface DataSubject {
    id: string;
    email: string;
    phone?: string;
    display_name: string;
    national_id?: string;
    last_activity: string;
    data_sources_count: number;
    estimated_records: number;
}

/** Một yêu cầu xóa dữ liệu */
export interface ErasureRequest {
    id: string;
    subject_id: string;
    subject_email: string;
    subject_name: string;
    status: ErasureRequestStatus;
    reason: string;
    legal_basis: string;
    scope: ErasureScope[];
    requested_by: string;
    identity_verified: boolean;
    records_found: number;
    records_erased: number;
    created_at: string;
    reviewed_at?: string;
    completed_at?: string;
    denial_reason?: string;
    notes?: string;
}

/** Dữ liệu biểu mẫu yêu cầu xóa */
export interface ErasureFormData {
    subject_identifier: string;
    identity_type: IdentityType | '';
    reason: string;
    legal_basis: string;
    scope: ErasureScope[];
    notes: string;
}

/** Lỗi biểu mẫu */
export interface ErasureFormErrors {
    subject_identifier?: string;
    identity_type?: string;
    reason?: string;
    legal_basis?: string;
    scope?: string;
    general?: string;
}

/** Props của component */
export interface RetentionErasureProps {
    /** URL API cơ sở */
    apiBase?: string;
    /** Callback khi yêu cầu xóa được gửi/xử lý */
    onErasureRequest?: (request: ErasureRequest) => void;
    /** Chỉ hiển thị yêu cầu của người dùng hiện tại */
    ownRequestsOnly?: boolean;
}

