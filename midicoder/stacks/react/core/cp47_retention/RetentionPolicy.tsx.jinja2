import React, { useEffect, useState, useMemo, useCallback } from 'react';

/* ---- Interface dữ liệu ---- */

/** Trạng thái chính sách lưu trữ */
export type RetentionPolicyStatus = 'active' | 'inactive' | 'expired' | 'draft';

/** Loại dữ liệu áp dụng chính sách */
export type DataType = 'user_data' | 'log_data' | 'session_data' | 'audit_trail' | 'file_attachment' | 'analytics';

/** Hành động sau khi hết hạn */
export type ExpiryAction = 'archive' | 'erase' | 'anonymize';

/** Một chính sách lưu trữ */
export interface RetentionPolicy {
id: string;
name: string;
description: string;
data_type: DataType;
retention_days: number;
archive_after_days: number | null;
action_after_expiry: ExpiryAction;
status: RetentionPolicyStatus;
applied_count: number;
created_at: string;
updated_at: string;
created_by?: string;
}

/** Dữ liệu biểu mẫu chính sách (có thể trống khi tạo mới) */
export interface PolicyFormData {
name: string;
description: string;
data_type: DataType | '';
retention_days: string;
archive_after_days: string;
action_after_expiry: ExpiryAction | '';
status: RetentionPolicyStatus | '';
}

/** Thông báo lỗi biểu mẫu */
export interface PolicyFormErrors {
name?: string;
description?: string;
data_type?: string;
retention_days?: string;
archive_after_days?: string;
action_after_expiry?: string;
status?: string;
general?: string;
}

/** Props của component */
export interface RetentionPolicyProps {
/** URL API cơ sở */
apiBase?: string;
/** Callback khi chính sách được tạo/cập nhật/xóa */
onPolicyChange?: () => void;
/** Chỉ đọc — ẩn các nút chỉnh sửa */
readOnly?: boolean;
}

/* ---- Giá trị mặc định cho biểu mẫu ---- */

const emptyForm: PolicyFormData = {
name: '',
description: '',
data_type: '',
retention_days: '',
archive_after_days: '',
action_after_expiry: '',
status: '',
};

