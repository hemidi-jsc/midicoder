/* ---- Helper functions ---- */

/** Nhãn loại dữ liệu */
const dataTypeLabels: Record<DataType, string> = {
    user_data: 'Dữ liệu người dùng',
    log_data: 'Nhật ký hệ thống',
    session_data: 'Dữ liệu phiên',
    audit_trail: 'Dấu vết kiểm toán',
    file_attachment: 'Tập tin đính kèm',
    analytics: 'Dữ liệu phân tích',
    };

    const dataTypeOptions: { value: DataType; label: string }[] = Object.entries(dataTypeLabels).map(
    ([value, label]) => ({ value: value as DataType, label })
    );

    /** Nhãn hành động */
    const actionLabels: Record<ExpiryAction, string> = {
        archive: 'Lưu trữ',
        erase: 'Xóa vĩnh viễn',
        anonymize: 'Ẩn danh hóa',
        };

        const actionOptions: { value: ExpiryAction; label: string }[] = Object.entries(actionLabels).map(
        ([value, label]) => ({ value: value as ExpiryAction, label })
        );

        /** Nhãn trạng thái */
        const statusLabels: Record<RetentionPolicyStatus, string> = {
            active: 'Đang hoạt động',
            inactive: 'Không hoạt động',
            expired: 'Đã hết hạn',
            draft: 'Bản nháp',
            };

            const statusColors: Record<RetentionPolicyStatus, { bg: string; color: string }> = {
                active: { bg: '#d1fae5', color: '#065f46' },
                inactive: { bg: '#f1f5f9', color: '#475569' },
                expired: { bg: '#fee2e2', color: '#991b1b' },
                draft: { bg: '#fef3c7', color: '#92400e' },
                };

                const statusOptions: { value: RetentionPolicyStatus; label: string }[] =
                Object.entries(statusLabels).map(
                ([value, label]) => ({ value: value as RetentionPolicyStatus, label })
                );

                function policyStatusBadgeStyle(status: RetentionPolicyStatus): React.CSSProperties {
                const c = statusColors[status] || { bg: '#f1f5f9', color: '#475569' };
                return { ...sBadgeBase, backgroundColor: c.bg, color: c.color };
                }

                function formatDateTime(iso: string | null | undefined): string {
                if (!iso) return '—';
                return new Date(iso).toLocaleDateString('vi-VN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                });
                }

                /* ---- Xác thực biểu mẫu ---- */

                function validateForm(data: PolicyFormData): PolicyFormErrors {
                const errors: PolicyFormErrors = {};

                if (!data.name.trim()) {
                errors.name = 'Tên chính sách không được để trống';
                } else if (data.name.trim().length < 3) { errors.name='Tên chính sách cần ít nhất 3 ký tự' ; } else if
                    (data.name.trim().length> 200) {
                    errors.name = 'Tên chính sách không được vượt quá 200 ký tự';
                    }

                    if (!data.description.trim()) {
                    errors.description = 'Mô tả không được để trống';
                    }

                    if (!data.data_type) {
                    errors.data_type = 'Vui lòng chọn loại dữ liệu';
                    }

                    const retention = parseInt(data.retention_days, 10);
                    if (!data.retention_days || isNaN(retention) || retention < 1) {
                        errors.retention_days='Số ngày lưu trữ phải là số nguyên dương' ; } else if (retention> 99999) {
                        errors.retention_days = 'Số ngày lưu trữ không hợp lệ';
                        }

                        if (data.archive_after_days) {
                        const archive = parseInt(data.archive_after_days, 10);
                        if (isNaN(archive) || archive < 0) {
                            errors.archive_after_days='Số ngày lưu trữ phải là số không âm' ; } else if (retention> 0 &&
                            archive >= retention) {
                            errors.archive_after_days = 'Phải nhỏ hơn số ngày lưu trữ';
                            }
                            }

                            if (!data.action_after_expiry) {
                            errors.action_after_expiry = 'Vui lòng chọn hành động sau khi hết hạn';
                            }

                            if (!data.status) {
                            errors.status = 'Vui lòng chọn trạng thái';
                            }

                            return errors;
                            }

                            /* ---- Component chính ---- */

                            export const RetentionPolicy: React.FC<RetentionPolicyProps> = ({
                                apiBase,
                                onPolicyChange,
                                readOnly = false,
                                }) => {
                                const baseUrl = apiBase || '/api';

                                const [policies, setPolicies] = useState<RetentionPolicy[]>([]);
                                    const [loading, setLoading] = useState(true);
                                    const [error, setError] = useState<string | null>(null);
                                        const [success, setSuccess] = useState<string | null>(null);

                                            /* Bộ lọc */
                                            const [filterStatus, setFilterStatus] = useState<RetentionPolicyStatus
                                                | 'all'>('all');
                                                const [filterType, setFilterType] = useState<DataType | 'all'>('all');
                                                    const [searchQuery, setSearchQuery] = useState('');

                                                    /* Modal tạo/sửa */
                                                    const [showForm, setShowForm] = useState(false);
                                                    const [editingPolicy, setEditingPolicy] = useState<RetentionPolicy |
                                                        null>(null);
                                                        const [formData, setFormData] = useState<PolicyFormData>({
                                                            ...emptyForm });
                                                            const [formErrors, setFormErrors] = useState
                                                            <PolicyFormErrors>({});
                                                                const [submitting, setSubmitting] = useState(false);

                                                                /* Xác nhận xóa */
                                                                const [deletingId, setDeletingId] = useState<string |
                                                                    null>(null);

                                                                    /* Tải danh sách chính sách */
                                                                    const loadPolicies = useCallback(async () => {
                                                                    setLoading(true);
                                                                    setError(null);
                                                                    try {
                                                                    const params = new URLSearchParams();
                                                                    if (filterStatus !== 'all') params.set('status',
                                                                    filterStatus);
                                                                    if (filterType !== 'all') params.set('data_type',
                                                                    filterType);
                                                                    if (searchQuery.trim()) params.set('q',
                                                                    searchQuery.trim());

                                                                    const res = await
                                                                    fetch(`${baseUrl}/api/retention/policies?${params.toString()}`);
                                                                    const data = await res.json();
                                                                    setPolicies(data || []);
                                                                    } catch (err) {
                                                                    setError(err instanceof Error ? err.message : 'Không
                                                                    thể tải danh sách chính sách');
                                                                    } finally {
                                                                    setLoading(false);
                                                                    }
                                                                    }, [baseUrl, filterStatus, filterType,
                                                                    searchQuery]);

                                                                    useEffect(() => {
                                                                    loadPolicies();
                                                                    }, [loadPolicies]);

                                                                    /* Lọc và tìm kiếm tại client */
                                                                    const filteredPolicies = useMemo(() => {
                                                                    let result = policies;
                                                                    if (filterStatus !== 'all') {
                                                                    result = result.filter((p) => p.status ===
                                                                    filterStatus);
                                                                    }
                                                                    if (filterType !== 'all') {
                                                                    result = result.filter((p) => p.data_type ===
                                                                    filterType);
                                                                    }
                                                                    if (searchQuery.trim()) {
                                                                    const q = searchQuery.toLowerCase();
                                                                    result = result.filter(
                                                                    (p) => p.name.toLowerCase().includes(q) ||
                                                                    p.description.toLowerCase().includes(q)
                                                                    );
                                                                    }
                                                                    return result;
                                                                    }, [policies, filterStatus, filterType,
                                                                    searchQuery]);

                                                                    /* Mở form tạo mới */
                                                                    const openCreateForm = useCallback(() => {
                                                                    setEditingPolicy(null);
                                                                    setFormData({ ...emptyForm, status: 'draft' });
                                                                    setFormErrors({});
                                                                    setShowForm(true);
                                                                    }, []);

                                                                    /* Mở form sửa */
                                                                    const openEditForm = useCallback((policy:
                                                                    RetentionPolicy) => {
                                                                    setEditingPolicy(policy);
                                                                    setFormData({
                                                                    name: policy.name,
                                                                    description: policy.description,
                                                                    data_type: policy.data_type,
                                                                    retention_days: String(policy.retention_days),
                                                                    archive_after_days: policy.archive_after_days !=
                                                                    null ? String(policy.archive_after_days) : '',
                                                                    action_after_expiry: policy.action_after_expiry,
                                                                    status: policy.status,
                                                                    });
                                                                    setFormErrors({});
                                                                    setShowForm(true);
                                                                    }, []);

                                                                    /* Đóng form */
                                                                    const closeForm = useCallback(() => {
                                                                    setShowForm(false);
                                                                    setEditingPolicy(null);
                                                                    setFormErrors({});
                                                                    }, []);

                                                                    /* Cập nhật trường biểu mẫu */
                                                                    const updateField = useCallback(<K extends keyof
                                                                        PolicyFormData>(field: K, value:
                                                                        PolicyFormData[K]) => {
                                                                        setFormData((prev) => ({ ...prev, [field]: value
                                                                        }));
                                                                        // Xóa lỗi của trường này khi người dùng nhập
                                                                        setFormErrors((prev) => {
                                                                        const next = { ...prev };
                                                                        delete next[field];
                                                                        return next;
                                                                        });
                                                                        }, []);

                                                                        /* Gửi biểu mẫu */
                                                                        const handleSubmit = useCallback(async () => {
                                                                        const errors = validateForm(formData);
                                                                        if (Object.keys(errors).length > 0) {
                                                                        setFormErrors(errors);
                                                                        return;
                                                                        }

                                                                        setSubmitting(true);
                                                                        setError(null);
                                                                        setSuccess(null);

                                                                        try {
                                                                        const payload: Record<string, any> = {
                                                                            name: formData.name.trim(),
                                                                            description: formData.description.trim(),
                                                                            data_type: formData.data_type,
                                                                            retention_days:
                                                                            parseInt(formData.retention_days, 10),
                                                                            archive_after_days:
                                                                            formData.archive_after_days ?
                                                                            parseInt(formData.archive_after_days, 10) :
                                                                            null,
                                                                            action_after_expiry:
                                                                            formData.action_after_expiry,
                                                                            status: formData.status,
                                                                            };

                                                                            const url = editingPolicy
                                                                            ?
                                                                            `${baseUrl}/api/retention/policies/${editingPolicy.id}`
                                                                            : `${baseUrl}/api/retention/policies`;
                                                                            const method = editingPolicy ? 'PUT' :
                                                                            'POST';

                                                                            const res = await fetch(url, {
                                                                            method,
                                                                            headers: { 'Content-Type':
                                                                            'application/json' },
                                                                            body: JSON.stringify(payload),
                                                                            });

                                                                            if (!res.ok) {
                                                                            const errBody = await res.json().catch(() =>
                                                                            null);
                                                                            throw new Error(errBody?.detail ||
                                                                            errBody?.message || `Lỗi ${method}
                                                                            (${res.status})`);
                                                                            }

                                                                            const message = editingPolicy ? 'Cập nhật
                                                                            chính sách thành công' : 'Tạo chính sách mới
                                                                            thành công';
                                                                            setSuccess(message);
                                                                            closeForm();
                                                                            await loadPolicies();
                                                                            onPolicyChange?.();
                                                                            } catch (err) {
                                                                            setError(err instanceof Error ? err.message
                                                                            : 'Không thể lưu chính sách');
                                                                            } finally {
                                                                            setSubmitting(false);
                                                                            }
                                                                            }, [formData, editingPolicy, baseUrl,
                                                                            closeForm, loadPolicies, onPolicyChange]);

                                                                            /* Xóa chính sách */
                                                                            const handleDelete = useCallback(async () =>
                                                                            {
                                                                            if (!deletingId) return;
                                                                            try {
                                                                            const res = await
                                                                            fetch(`${baseUrl}/api/retention/policies/${deletingId}`,
                                                                            { method: 'DELETE' });
                                                                            if (!res.ok) {
                                                                            const errBody = await res.json().catch(() =>
                                                                            null);
                                                                            throw new Error(errBody?.detail ||
                                                                            errBody?.message || `Lỗi DELETE
                                                                            (${res.status})`);
                                                                            }
                                                                            setSuccess('Xóa chính sách thành công');
                                                                            setDeletingId(null);
                                                                            await loadPolicies();
                                                                            onPolicyChange?.();
                                                                            } catch (err) {
                                                                            setError(err instanceof Error ? err.message
                                                                            : 'Không thể xóa chính sách');
                                                                            setDeletingId(null);
                                                                            }
                                                                            }, [deletingId, baseUrl, loadPolicies,
                                                                            onPolicyChange]);

                                                                            /* Chuyển đổi trạng thái (active/inactive)
                                                                            */
                                                                            const toggleStatus = useCallback(async
                                                                            (policy: RetentionPolicy) => {
                                                                            const newStatus = policy.status === 'active'
                                                                            ? 'inactive' : 'active';
                                                                            try {
                                                                            const res = await
                                                                            fetch(`${baseUrl}/api/retention/policies/${policy.id}`,
                                                                            {
                                                                            method: 'PATCH',
                                                                            headers: { 'Content-Type':
                                                                            'application/json' },
                                                                            body: JSON.stringify({ status: newStatus }),
                                                                            });
                                                                            if (!res.ok) throw new Error('Không thể
                                                                            chuyển đổi trạng thái');
                                                                            setSuccess(`Đã ${newStatus === 'active' ?
                                                                            'kích hoạt' : 'tắt'} chính sách`);
                                                                            await loadPolicies();
                                                                            onPolicyChange?.();
                                                                            } catch (err) {
                                                                            setError(err instanceof Error ? err.message
                                                                            : 'Lỗi khi chuyển đổi trạng thái');
                                                                            }
                                                                            }, [baseUrl, loadPolicies, onPolicyChange]);

                                                                            /* Chạy chính sách ngay lập tức */
                                                                            const triggerPolicy = useCallback(async
                                                                            (policy: RetentionPolicy) => {
                                                                            try {
                                                                            const res = await
                                                                            fetch(`${baseUrl}/api/retention/policies/${policy.id}/trigger`,
                                                                            {
                                                                            method: 'POST',
                                                                            headers: { 'Content-Type':
                                                                            'application/json' },
                                                                            });
                                                                            if (!res.ok) throw new Error('Không thể kích
                                                                            hoạt chính sách');
                                                                            setSuccess('Đã tạo công việc xử lý chính
                                                                            sách');
                                                                            onPolicyChange?.();
                                                                            } catch (err) {
                                                                            setError(err instanceof Error ? err.message
                                                                            : 'Lỗi khi chạy chính sách');
                                                                            }
                                                                            }, [baseUrl, onPolicyChange]);

                                                                            return (
                                                                            <div style={sWrap}>
                                                                                {/* Header */}
                                                                                <div style={sHeader}>
                                                                                    <h1 style={sHeaderTitle}>Quản lý
                                                                                        chính sách lưu trữ</h1>
                                                                                    {!readOnly && (
                                                                                    <button onClick={openCreateForm}
                                                                                        style={sBtnPrimary}>
                                                                                        + Tạo chính sách mới
                                                                                    </button>
                                                                                    )}
                                                                                </div>

                                                                                {/* Thông báo lỗi/Thành công */}
                                                                                {error && <div style={sError}>
                                                                                    <strong>Lỗi:</strong> {error}</div>}
                                                                                {success && <div style={sSuccess}>
                                                                                    <strong>Thành công:</strong>
                                                                                    {success}</div>}

                                                                                {/* Bộ lọc */}
                                                                                <div style={sCard}>
                                                                                    <div style={sFilterBar}>
                                                                                        <input type="text"
                                                                                            placeholder="Tìm kiếm chính sách..."
                                                                                            value={searchQuery}
                                                                                            onChange={(e)=>
                                                                                        setSearchQuery(e.target.value)}
                                                                                        style={{ ...sFormInput, width:
                                                                                        '260px' }}
                                                                                        />
                                                                                        <select value={filterStatus}
                                                                                            onChange={(e)=>
                                                                                            setFilterStatus(e.target.value
                                                                                            as RetentionPolicyStatus |
                                                                                            'all')}
                                                                                            style={sFormSelect}
                                                                                            >
                                                                                            <option value="all">Tất cả
                                                                                                trạng thái</option>
                                                                                            {statusOptions.map((s) => (
                                                                                            <option key={s.value}
                                                                                                value={s.value}>
                                                                                                {s.label}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                        <select value={filterType}
                                                                                            onChange={(e)=>
                                                                                            setFilterType(e.target.value
                                                                                            as DataType | 'all')}
                                                                                            style={sFormSelect}
                                                                                            >
                                                                                            <option value="all">Tất cả
                                                                                                loại dữ liệu</option>
                                                                                            {dataTypeOptions.map((t) =>
                                                                                            (
                                                                                            <option key={t.value}
                                                                                                value={t.value}>
                                                                                                {t.label}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                        <button onClick={loadPolicies}
                                                                                            style={sBtnSuccess}>
                                                                                            Áp dụng bộ lọc
                                                                                        </button>
                                                                                    </div>

                                                                                    {/* Bảng chính sách */}
                                                                                    {loading ? (
                                                                                    <div style={sLoading}>Đang tải chính
                                                                                        sách...</div>
                                                                                    ) : (
                                                                                    <div style={{ overflowX: 'auto' }}>
                                                                                        <table style={sTable}>
                                                                                            <thead>
                                                                                                <tr>
                                                                                                    <th style={sTh}>ID
                                                                                                    </th>
                                                                                                    <th style={sTh}>Tên
                                                                                                    </th>
                                                                                                    <th style={sTh}>Loại
                                                                                                        dữ liệu</th>
                                                                                                    <th style={sTh}>Ngày
                                                                                                        giữ</th>
                                                                                                    <th style={sTh}>Lưu
                                                                                                        trữ sau</th>
                                                                                                    <th style={sTh}>Hành
                                                                                                        động hết hạn
                                                                                                    </th>
                                                                                                    <th style={sTh}>Đã
                                                                                                        áp dụng</th>
                                                                                                    <th style={sTh}>
                                                                                                        Trạng thái</th>
                                                                                                    <th style={sTh}>Cập
                                                                                                        nhật</th>
                                                                                                    {!readOnly && <th
                                                                                                        style={sTh}>Thao
                                                                                                        tác</th>}
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                {filteredPolicies.map((p)
                                                                                                => (
                                                                                                <tr key={p.id}>
                                                                                                    <td style={sTd}>
                                                                                                        <span
                                                                                                            style={sTdCode}>{p.id.slice(0,
                                                                                                            12)}</span>
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        <div>
                                                                                                            <div style={{
                                                                                                                fontWeight:
                                                                                                                600 }}>
                                                                                                                {p.name}
                                                                                                            </div>
                                                                                                            <div style={{
                                                                                                                fontSize: '12px'
                                                                                                                ,
                                                                                                                color: '#64748b'
                                                                                                                }}>
                                                                                                                {p.description.slice(0,
                                                                                                                60)}
                                                                                                                {p.description.length
                                                                                                                > 60 ?
                                                                                                                '...' :
                                                                                                                ''}
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        {dataTypeLabels[p.data_type]
                                                                                                        || p.data_type}
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        {p.retention_days}
                                                                                                        ngày</td>
                                                                                                    <td style={sTd}>
                                                                                                        {p.archive_after_days
                                                                                                        ?
                                                                                                        `${p.archive_after_days}
                                                                                                        ngày` : '—'}
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        {actionLabels[p.action_after_expiry]
                                                                                                        ||
                                                                                                        p.action_after_expiry}
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        {p.applied_count.toLocaleString('vi-VN')}
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        <span
                                                                                                            style={policyStatusBadgeStyle(p.status)}>
                                                                                                            {statusLabels[p.status]}
                                                                                                        </span>
                                                                                                    </td>
                                                                                                    <td style={sTd}>
                                                                                                        {formatDateTime(p.updated_at)}
                                                                                                    </td>
                                                                                                    {!readOnly && (
                                                                                                    <td style={{ ...sTd,
                                                                                                        whiteSpace: 'nowrap'
                                                                                                        }}>
                                                                                                        <button
                                                                                                            onClick={()=>
                                                                                                            openEditForm(p)}
                                                                                                            style={{
                                                                                                            ...sBtnSmall,
                                                                                                            marginRight:
                                                                                                            '6px' }}
                                                                                                            >
                                                                                                            Sửa
                                                                                                        </button>
                                                                                                        <button
                                                                                                            onClick={()=>
                                                                                                            toggleStatus(p)}
                                                                                                            style={{
                                                                                                            ...sBtnSmall,
                                                                                                            marginRight:
                                                                                                            '6px',
                                                                                                            color:
                                                                                                            p.status ===
                                                                                                            'active' ?
                                                                                                            '#dc2626' :
                                                                                                            '#16a34a' }}
                                                                                                            >
                                                                                                            {p.status
                                                                                                            === 'active'
                                                                                                            ? 'Tắt' :
                                                                                                            'Bật'}
                                                                                                        </button>
                                                                                                        <button
                                                                                                            onClick={()=>
                                                                                                            triggerPolicy(p)}
                                                                                                            style={{
                                                                                                            ...sBtnSmall,
                                                                                                            marginRight:
                                                                                                            '6px',
                                                                                                            background:
                                                                                                            '#3b82f6',
                                                                                                            color:
                                                                                                            '#fff',
                                                                                                            border:
                                                                                                            'none' }}
                                                                                                            >
                                                                                                            Chạy
                                                                                                        </button>
                                                                                                        <button
                                                                                                            onClick={()=>
                                                                                                            setDeletingId(p.id)}
                                                                                                            style={{
                                                                                                            ...sBtnSmall,
                                                                                                            ...sBtnDanger
                                                                                                            }}
                                                                                                            >
                                                                                                            Xóa
                                                                                                        </button>
                                                                                                    </td>
                                                                                                    )}
                                                                                                </tr>
                                                                                                ))}
                                                                                                {!filteredPolicies.length
                                                                                                && (
                                                                                                <tr>
                                                                                                    <td colSpan={!readOnly
                                                                                                        ? 10 : 9}
                                                                                                        style={sEmptyState}>
                                                                                                        Không tìm thấy
                                                                                                        chính sách nào
                                                                                                        khớp với bộ lọc.
                                                                                                    </td>
                                                                                                </tr>
                                                                                                )}
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                    )}
                                                                                </div>

                                                                                {/* Modal tạo/sửa chính sách */}
                                                                                {showForm && (
                                                                                <div style={sOverlay}
                                                                                    onClick={closeForm}>
                                                                                    <div style={sModal} onClick={(e)=>
                                                                                        e.stopPropagation()}>
                                                                                        <h2 style={sModalTitle}>
                                                                                            {editingPolicy ? 'Sửa chính
                                                                                            sách' : 'Tạo chính sách
                                                                                            mới'}
                                                                                        </h2>

                                                                                        <div style={sFormField}>
                                                                                            <label
                                                                                                style={sFormLabel}>Tên
                                                                                                chính sách *</label>
                                                                                            <input type="text"
                                                                                                value={formData.name}
                                                                                                onChange={(e)=>
                                                                                            updateField('name',
                                                                                            e.target.value)}
                                                                                            style={formErrors.name ?
                                                                                            sFormInputError :
                                                                                            sFormInput}
                                                                                            placeholder="VD: Chính sách
                                                                                            lưu trữ nhật ký 90 ngày"
                                                                                            />
                                                                                            {formErrors.name && <div
                                                                                                style={sFormErrorText}>
                                                                                                {formErrors.name}</div>}
                                                                                        </div>

                                                                                        <div style={sFormField}>
                                                                                            <label style={sFormLabel}>Mô
                                                                                                tả *</label>
                                                                                            <textarea
                                                                                                value={formData.description}
                                                                                                onChange={(e)=> updateField('description', e.target.value)}
                                style={formErrors.description ? sFormTextarea : sFormTextarea}
                                placeholder="Mô tả mục đích và phạm vi áp dụng..."
                            />
                            {formErrors.description && <div style={sFormErrorText}>{formErrors.description}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Loại dữ liệu *</label>
                            <select
                                value={formData.data_type}
                                onChange={(e) => updateField('data_type', e.target.value as DataType)}
                                style={formErrors.data_type ? sFormSelect : sFormSelect}
                            >
                                <option value="">-- Chọn loại dữ liệu --</option>
                                {dataTypeOptions.map((t) => (
                                    <option key={t.value} value={t.value}>{t.label}</option>
                                ))}
                            </select>
                            {formErrors.data_type && <div style={sFormErrorText}>{formErrors.data_type}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Số ngày lưu trữ *</label>
                            <input
                                type="number"
                                min="1"
                                value={formData.retention_days}
                                onChange={(e) => updateField('retention_days', e.target.value)}
                                style={formErrors.retention_days ? sFormInputError : sFormInput}
                                placeholder="VD: 90"
                            />
                            {formErrors.retention_days && <div style={sFormErrorText}>{formErrors.retention_days}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Lưu trữ sau (ngày) — tùy chọn</label>
                            <input
                                type="number"
                                min="0"
                                value={formData.archive_after_days}
                                onChange={(e) => updateField('archive_after_days', e.target.value)}
                                style={formErrors.archive_after_days ? sFormInputError : sFormInput}
                                placeholder="VD: 60 (trống = không lưu trữ trung gian)"
                            />
                            {formErrors.archive_after_days && <div style={sFormErrorText}>{formErrors.archive_after_days}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Hành động sau khi hết hạn *</label>
                            <select
                                value={formData.action_after_expiry}
                                onChange={(e) => updateField('action_after_expiry', e.target.value as ExpiryAction)}
                                style={formErrors.action_after_expiry ? sFormSelect : sFormSelect}
                            >
                                <option value="">-- Chọn hành động --</option>
                                {actionOptions.map((a) => (
                                    <option key={a.value} value={a.value}>{a.label}</option>
                                ))}
                            </select>
                            {formErrors.action_after_expiry && <div style={sFormErrorText}>{formErrors.action_after_expiry}</div>}
                        </div>

                        <div style={sFormField}>
                            <label style={sFormLabel}>Trạng thái *</label>
                            <select
                                value={formData.status}
                                onChange={(e) => updateField('status', e.target.value as RetentionPolicyStatus)}
                                style={formErrors.status ? sFormSelect : sFormSelect}
                            >
                                <option value="">-- Chọn trạng thái --</option>
                                {statusOptions.map((s) => (
                                    <option key={s.value} value={s.value}>{s.label}</option>
                                ))}
                            </select>
                            {formErrors.status && <div style={sFormErrorText}>{formErrors.status}</div>}
                        </div>

                        {formErrors.general && (
                            <div style={sFormErrorText}>{formErrors.general}</div>
                        )}

                        <div style={sFormActions}>
                            <button onClick={closeForm} style={sBtnBase} disabled={submitting}>
                                Hủy
                            </button>
                            <button onClick={handleSubmit} style={sBtnPrimary} disabled={submitting}>
                                {submitting ? 'Đang lưu...' : editingPolicy ? 'Cập nhật' : 'Tạo chính sách'}
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* Modal xác nhận xóa */}
            {deletingId && (
                <div style={sOverlay}>
                    <div style={sModal}>
                        <h2 style={sModalTitle}>Xác nhận xóa chính sách</h2>
                        <p style={{ color: '#334155', fontSize: '15px' }}>
                            Bạn có chắc chắn muốn xóa chính sách{' '}
                            <strong>{policies.find((p) => p.id === deletingId)?.name || deletingId}</strong>?
                            Hành động này không thể hoàn tác.
                        </p>
                        <div style={sFormActions}>
                            <button onClick={() => setDeletingId(null)} style={sBtnBase}>
                                Hủy
                            </button>
                            <button onClick={handleDelete} style={sBtnDanger}>
                                Xóa chính sách
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
};

export default RetentionPolicy;
{% endraw %}