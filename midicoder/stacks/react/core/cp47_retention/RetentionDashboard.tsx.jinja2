{% raw %}/**
 * RetentionDashboard — Bảng điều khiển tổng quan chính sách lưu trữ và vòng đời dữ liệu:
 * thống kê lưu trữ, bảng lưu trữ gần đây, tổng quan chính sách.
 * Sinh bởi CP47 Data Retention & Lifecycle Management.
 */
import React, { useEffect, useState, useMemo, useCallback } from 'react';

/* ---- Interface dữ liệu ---- */

/** Trạng thái chính sách lưu trữ */
export type RetentionPolicyStatus = 'active' | 'inactive' | 'expired' | 'draft';

/** Loại dữ liệu áp dụng chính sách */
export type DataType = 'user_data' | 'log_data' | 'session_data' | 'audit_trail' | 'file_attachment' | 'analytics';

/** Trạng thái công việc lưu trữ/xóa */
export type JobStatus = 'pending' | 'running' | 'completed' | 'failed' | 'cancelled';

/** Một bản ghi chính sách lưu trữ */
export interface RetentionPolicy {
    id: string;
    name: string;
    description: string;
    data_type: DataType;
    retention_days: number;
    archive_after_days: number | null;
    action_after_expiry: 'archive' | 'erase' | 'anonymize';
    status: RetentionPolicyStatus;
    created_at: string;
    updated_at: string;
    applied_count: number;
}

/** Một công việc lưu trữ hoặc xóa */
export interface RetentionJob {
    id: string;
    policy_id: string;
    policy_name: string;
    data_type: DataType;
    status: JobStatus;
    total_records: number;
    processed_records: number;
    created_at: string;
    completed_at?: string;
    error_message?: string;
}

/** Dữ liệu thống kê tổng quan */
export interface RetentionStats {
    total_policies: number;
    active_policies: number;
    total_data_size_gb: number;
    archived_size_gb: number;
    erased_size_gb: number;
    pending_jobs: number;
    running_jobs: number;
    expired_records_count: number;
}

/** Props của component */
export interface RetentionDashboardProps {
    /** URL API cơ sở để gọi dữ liệu */
    apiBase?: string;
    /** Callback khi nhấn hành động nhanh */
    onAction?: (action: string) => void;
    /** Refresh interval tính bằng mili giây (mặc định 30s) */
    refreshInterval?: number;
}

