/* ---- Helper functions ---- */

/** Màu và nhãn cho trạng thái chính sách */
function policyStatusStyle(status: RetentionPolicyStatus): React.CSSProperties {
    const map: Record<RetentionPolicyStatus, { bg: string; color: string }> = {
        active:   { bg: '#d1fae5', color: '#065f46' },
        inactive: { bg: '#f1f5f9', color: '#475569' },
        expired:  { bg: '#fee2e2', color: '#991b1b' },
        draft:    { bg: '#fef3c7', color: '#92400e' },
    };
    const c = map[status] || { bg: '#f1f5f9', color: '#475569' };
    return { ...sBadgeBase, backgroundColor: c.bg, color: c.color };
}

function policyStatusLabel(status: RetentionPolicyStatus): string {
    const map: Record<RetentionPolicyStatus, string> = {
        active:   'Đang hoạt động',
        inactive: 'Không hoạt động',
        expired:  'Đã hết hạn',
        draft:    'Bản nháp',
    };
    return map[status] || status;
}

/** Màu và nhãn cho trạng thái công việc */
function jobStatusStyle(status: JobStatus): React.CSSProperties {
    const map: Record<JobStatus, { bg: string; color: string }> = {
        pending:   { bg: '#fef3c7', color: '#92400e' },
        running:   { bg: '#dbeafe', color: '#1e40af' },
        completed: { bg: '#d1fae5', color: '#065f46' },
        failed:    { bg: '#fee2e2', color: '#991b1b' },
        cancelled: { bg: '#f1f5f9', color: '#475569' },
    };
    const c = map[status] || { bg: '#f1f5f9', color: '#475569' };
    return { ...sBadgeBase, backgroundColor: c.bg, color: c.color };
}

function jobStatusLabel(status: JobStatus): string {
    const map: Record<JobStatus, string> = {
        pending:   'Đang chờ',
        running:   'Đang chạy',
        completed: 'Hoàn thành',
        failed:    'Thất bại',
        cancelled: 'Đã hủy',
    };
    return map[status] || status;
}

/** Nhãn loại dữ liệu bằng tiếng Việt */
const dataTypeLabels: Record<DataType, string> = {
    user_data:       'Dữ liệu người dùng',
    log_data:        'Nhật ký hệ thống',
    session_data:    'Dữ liệu phiên',
    audit_trail:     'Dấu vết kiểm toán',
    file_attachment: 'Tập tin đính kèm',
    analytics:       'Dữ liệu phân tích',
};

/** Nhãn hành động sau khi hết hạn */
const actionLabels: Record<string, string> = {
    archive:    'Lưu trữ',
    erase:      'Xóa vĩnh viễn',
    anonymize:  'Ẩn danh hóa',
};

/** Định dạng ngày giờ */
function formatDateTime(iso: string | null | undefined): string {
    if (!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleDateString('vi-VN', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
    });
}

/** Định dạng dung lượng */
function formatSize(gb: number): string {
    if (gb >= 1000) return `${(gb / 1000).toFixed(2)} TB`;
    if (gb >= 1) return `${gb.toFixed(2)} GB`;
    return `${(gb * 1024).toFixed(1)} MB`;
}

/** Tính tỷ lệ phần trăm hoàn thành */
function calcProgress(total: number, processed: number): number {
    if (total <= 0) return 0;
    return Math.min(100, Math.round((processed / total) * 100));
}

/* ---- Sub-components ---- */

const StatCard: React.FC<{
    title: string;
    value: string | number;
    color: string;
    barColor: string;
    delta?: string;
    deltaColor?: string;
}> = ({ title, value, color, barColor, delta, deltaColor }) => (
    <div style={sStatCard}>
        <div style={{ ...sStatBar, backgroundColor: barColor }} />
        <p style={sStatLabel}>{title}</p>
        <p style={{ ...sStatValue, color }}>
            {typeof value === 'number' ? value.toLocaleString('vi-VN') : value}
        </p>
        {delta && (
            <p style={{ ...sStatDelta, color: deltaColor || '#64748b' }}>{delta}</p>
        )}
    </div>
);

const StatusBadge: React.FC<{
    style: React.CSSProperties;
    children: React.ReactNode;
}> = ({ style, children }) => (
    <span style={style}>{children}</span>
);

const ProgressBar: React.FC<{
    percent: number;
    status: JobStatus;
}> = ({ percent, status }) => {
    const colorMap: Record<JobStatus, string> = {
        pending:   '#f59e0b',
        running:   '#3b82f6',
        completed: '#22c55e',
        failed:    '#ef4444',
        cancelled: '#94a3b8',
    };
    return (
        <div style={sProgressBar}>
            <div
                style={{
                    ...sProgressFill,
                    width: `${percent}%`,
                    backgroundColor: colorMap[status] || '#94a3b8',
                }}
            />
        </div>
    );
};

/* ---- Component chính ---- */

export const RetentionDashboard: React.FC<RetentionDashboardProps> = ({
    apiBase,
    onAction,
    refreshInterval = 30000,
}) => {
    const baseUrl = apiBase || '/api';

    const [stats, setStats] = useState<RetentionStats | null>(null);
    const [jobs, setJobs] = useState<RetentionJob[]>([]);
    const [policies, setPolicies] = useState<RetentionPolicy[]>([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);

    /* Tải dữ liệu từ API */
    const loadData = useCallback(async () => {
        setLoading(true);
        setError(null);
        try {
            const [statsRes, jobsRes, policiesRes] = await Promise.all([
                fetch(`${baseUrl}/api/retention/stats`).then((r) => r.json()),
                fetch(`${baseUrl}/api/retention/jobs?limit=15`).then((r) => r.json()),
                fetch(`${baseUrl}/api/retention/policies`).then((r) => r.json()),
            ]);
            setStats(statsRes);
            setJobs(jobsRes || []);
            setPolicies(policiesRes || []);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Không thể tải dữ liệu chính sách lưu trữ');
        } finally {
            setLoading(false);
        }
    }, [baseUrl]);

    useEffect(() => {
        loadData();
    }, [loadData]);

    /* Tự động làm mới theo khoảng thời gian */
    useEffect(() => {
        const id = setInterval(loadData, refreshInterval);
        return () => clearInterval(id);
    }, [loadData, refreshInterval]);

    /* Sắp xếp công việc theo thời gian, ưu tiên đang chạy */
    const sortedJobs = useMemo(() => {
        const priority: Record<JobStatus, number> = {
            running: 0,
            pending: 1,
            failed: 2,
            completed: 3,
            cancelled: 4,
        };
        return [...jobs].sort((a, b) => {
            const pDiff = priority[a.status] - priority[b.status];
            if (pDiff !== 0) return pDiff;
            return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
        });
    }, [jobs]);

    /* Tính tổng dữ liệu còn lại */
    const remainingData = useMemo(() => {
        if (!stats) return '—';
        return formatSize(Math.max(0, stats.total_data_size_gb - stats.archived_size_gb - stats.erased_size_gb));
    }, [stats]);

    /* Xử lý hành động nhanh */
    const handleQuickAction = useCallback(
        (action: string) => {
            onAction?.(action);
            console.log(`[RetentionDashboard] Hành động: ${action}`);
        },
        [onAction],
    );

    return (
        <div style={sWrap}>
            {/* Header */}
            <div style={sHeader}>
                <div>
                    <h1 style={sHeaderTitle}>Bảng điều khiển lưu trữ dữ liệu</h1>
                    <p style={sHeaderSub}>
                        Quản lý vòng đời dữ liệu, chính sách lưu trữ và yêu cầu xóa GDPR
                    </p>
                </div>
                <div>
                    <button
                        onClick={loadData}
                        style={sBtnPrimary}
                        disabled={loading}
                    >
                        {loading ? 'Đang tải...' : 'Làm mới dữ liệu'}
                    </button>
                </div>
            </div>

            {/* Thông báo lỗi */}
            {error && (
                <div style={sError}>
                    <strong>Lỗi:</strong> {error}
                </div>
            )}

            {/* Thống kê tổng quan */}
            {loading && !stats ? (
                <div style={sLoading}>Đang tải thống kê lưu trữ...</div>
            ) : stats ? (
                <div style={sStatsRow}>
                    <StatCard
                        title="Tổng chính sách"
                        value={stats.total_policies}
                        color="#6366f1"
                        barColor="#6366f1"
                        delta={`${stats.active_policies} đang hoạt động`}
                        deltaColor="#22c55e"
                    />
                    <StatCard
                        title="Dung lượng dữ liệu"
                        value={formatSize(stats.total_data_size_gb)}
                        color="#3b82f6"
                        barColor="#3b82f6"
                        delta={`Còn lại: ${remainingData}`}
                        deltaColor="#64748b"
                    />
                    <StatCard
                        title="Đã lưu trữ"
                        value={formatSize(stats.archived_size_gb)}
                        color="#22c55e"
                        barColor="#22c55e"
                    />
                    <StatCard
                        title="Đã xóa"
                        value={formatSize(stats.erased_size_gb)}
                        color="#ef4444"
                        barColor="#ef4444"
                    />
                    <StatCard
                        title="Công việc đang chờ"
                        value={stats.pending_jobs}
                        color="#f59e0b"
                        barColor="#f59e0b"
                        delta={`${stats.running_jobs} đang chạy`}
                        deltaColor="#3b82f6"
                    />
                    <StatCard
                        title="Bản ghi hết hạn"
                        value={stats.expired_records_count.toLocaleString('vi-VN')}
                        color="#8b5cf6"
                        barColor="#8b5cf6"
                    />
                </div>
            ) : null}

            {/* Hành động nhanh */}
            <div style={sQuickActions}>
                <button onClick={() => handleQuickAction('create_policy')} style={sBtnPrimary}>
                    Tạo chính sách mới
                </button>
                <button onClick={() => handleQuickAction('manage_policies')} style={sBtnSuccess}>
                    Quản lý chính sách
                </button>
                <button onClick={() => handleQuickAction('new_erasure')} style={sBtnDanger}>
                    Yêu cầu xóa GDPR
                </button>
                <button onClick={() => handleQuickAction('view_jobs')} style={sBtnInfo}>
                    Xem công việc
                </button>
                <button onClick={() => handleQuickAction('export_report')} style={sBtnBase}>
                    Xuất báo cáo
                </button>
            </div>

            {/* Grid 2 cột: Chính sách + Công việc */}
            <div style={sGrid2Col}>
                {/* Tổng quan chính sách */}
                <div style={sCard}>
                    <h2 style={sCardTitle}>Chính sách lưu trữ ({policies.length})</h2>
                    {loading && !policies.length ? (
                        <div style={sLoading}>Đang tải chính sách...</div>
                    ) : (
                        <div style={{ overflowX: 'auto' }}>
                            <table style={sTable}>
                                <thead>
                                    <tr>
                                        <th style={sTh}>Tên</th>
                                        <th style={sTh}>Loại</th>
                                        <th style={sTh}>Ngày giữ</th>
                                        <th style={sTh}>Hành động</th>
                                        <th style={sTh}>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {policies.slice(0, 8).map((p) => (
                                        <tr key={p.id}>
                                            <td style={sTd}>
                                                <span style={{ fontWeight: 500 }}>{p.name}</span>
                                            </td>
                                            <td style={sTd}>{dataTypeLabels[p.data_type] || p.data_type}</td>
                                            <td style={sTd}>{p.retention_days} ngày</td>
                                            <td style={sTd}>{actionLabels[p.action_after_expiry] || p.action_after_expiry}</td>
                                            <td style={sTd}>
                                                <StatusBadge style={policyStatusStyle(p.status)}>
                                                    {policyStatusLabel(p.status)}
                                                </StatusBadge>
                                            </td>
                                        </tr>
                                    ))}
                                    {!policies.length && (
                                        <tr>
                                            <td colSpan={5} style={sEmptyState}>
                                                Chưa có chính sách lưu trữ nào được cấu hình.
                                            </td>
                                        </tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>

                {/* Công việc gần đây */}
                <div style={sCard}>
                    <h2 style={sCardTitle}>Công việc gần đây ({sortedJobs.length})</h2>
                    {loading && !sortedJobs.length ? (
                        <div style={sLoading}>Đang tải công việc...</div>
                    ) : (
                        <div style={{ overflowX: 'auto' }}>
                            <table style={sTable}>
                                <thead>
                                    <tr>
                                        <th style={sTh}>ID</th>
                                        <th style={sTh}>Chính sách</th>
                                        <th style={sTh}>Tiến độ</th>
                                        <th style={sTh}>Trạng thái</th>
                                        <th style={sTh}>Ngày tạo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {sortedJobs.slice(0, 8).map((j) => {
                                        const progress = calcProgress(j.total_records, j.processed_records);
                                        return (
                                            <tr key={j.id}>
                                                <td style={sTd}>
                                                    <span style={sTdCode}>{j.id.slice(0, 12)}</span>
                                                </td>
                                                <td style={sTd}>{j.policy_name}</td>
                                                <td style={{ ...sTd, minWidth: '120px' }}>
                                                    <div style={{ marginBottom: '4px' }}>
                                                        <span style={{ fontSize: '12px', color: '#64748b' }}>
                                                            {j.processed_records}/{j.total_records}
                                                        </span>
                                                    </div>
                                                    <ProgressBar percent={progress} status={j.status} />
                                                </td>
                                                <td style={sTd}>
                                                    <StatusBadge style={jobStatusStyle(j.status)}>
                                                        {jobStatusLabel(j.status)}
                                                    </StatusBadge>
                                                </td>
                                                <td style={sTd}>{formatDateTime(j.created_at)}</td>
                                            </tr>
                                        );
                                    })}
                                    {!sortedJobs.length && (
                                        <tr>
                                            <td colSpan={5} style={sEmptyState}>
                                                Chưa có công việc nào được tạo.
                                            </td>
                                        </tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
};

export default RetentionDashboard;
