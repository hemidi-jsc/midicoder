        <path
            d="M14.1 27.2l7.1 7.2 16.7-16.8"
            fill="none"
            stroke="#22c55e"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
        />
    </svg>
);

/* ---- SVG Error X ---- */

const ErrorIcon: React.FC<{ size: number }> = ({ size }) => (
    <svg
        width={size}
        height={size}
        viewBox="0 0 52 52"
        style={{ display: 'block', margin: '0 auto' }}
    >
        <circle cx="26" cy="26" r="25" fill="none" stroke="#ef4444" strokeWidth="2" />
        <path
            d="M17 17l18 18M35 17l-18 18"
            fill="none"
            stroke="#ef4444"
            strokeWidth="3"
            strokeLinecap="round"
        />
    </svg>
);

/* ---- Sub-component: StepIcon ---- */

const StepIcon: React.FC<{ step: JobStep; iconSize: number; isCurrentActive: boolean }> = ({
    step, iconSize, isCurrentActive,
}) => {
    const iconStyle = stepIconStyle(step.status, iconSize, isCurrentActive);

    let content: React.ReactNode;
    switch (step.status) {
        case 'active':
            content = <div style={spinnerStyle(iconSize * 0.4)} />;
            break;
        case 'completed':
            content = <span style={{ color: '#22c55e', fontWeight: 700 }}>&#10003;</span>;
            break;
        case 'failed':
            content = <span style={{ color: '#ef4444', fontWeight: 700 }}>&#10005;</span>;
            break;
        case 'skipped':
            content = <span style={{ color: '#9ca3af' }}>&#8212;</span>;
            break;
        default:
            content = step.icon;
    }

    return <div style={iconStyle}>{content}</div>;
};

/* ---- Helper functions ---- */

function jobStatusLabel(status: JobProgressStatus): string {
    const map: Record<JobProgressStatus, string> = {
        queued: 'Đang xếp hàng',
        initializing: 'Đang khởi tạo',
        processing: 'Đang xử lý',
        verifying: 'Đang xác thực',
        finalizing: 'Đang hoàn tất',
        completed: 'Hoàn thành',
        failed: 'Thất bại',
        cancelled: 'Đã hủy',
    };
    return map[status];
}

function jobTypeLabel(type: JobType): string {
    const map: Record<JobType, string> = {
        archive: 'Lưu trữ dữ liệu',
        erase: 'Xóa dữ liệu',
        anonymize: 'Ẩn danh hóa',
        bulk_delete: 'Xóa hàng loạt',
        data_export: 'Xuất dữ liệu',
    };
    return map[type];
}

function calcProgressPercent(job: RetentionJob): number {
    if (job.total_records <= 0) return 0;
    return Math.min(100, Math.round((job.processed_records / job.total_records) * 100));
}

function formatDuration(seconds: number): string {
    if (seconds <= 0) return '< 1s';
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    if (mins > 0) return `${mins}p ${secs}s`;
    return `${secs}s`;
}

/* ---- Component chính: RetentionProgress ---- */

export const RetentionProgress: React.FC<RetentionProgressProps> = ({
    job,
    apiBase,
    refreshInterval = 5000,
    retryEnabled = true,
    onRetry,
    onCancel,
    onComplete,
    onClose,
    size = 'medium',
    showDebug = false,
}) => {
    const baseUrl = apiBase || '/api';
    const config = SIZE_CONFIG[size] || SIZE_CONFIG.medium;

    /* State local cho job (làm mới từ API) */
    const [localJob, setLocalJob] = useState<RetentionJob>(job);
    const [showSuccessAnim, setShowSuccessAnim] = useState(false);
    const [showErrorAnim, setShowErrorAnim] = useState(false);
    const [countdown, setCountdown] = useState<number | null>(null);

    /* Sync job prop vào local state */
    useEffect(() => {
        setLocalJob(job);
    }, [job]);

    /* Inject CSS keyframes */
    useEffect(() => {
        const styleId = 'cp47-retention-progress-styles';
        if (!document.getElementById(styleId)) {
            const styleEl = document.createElement('style');
            styleEl.id = styleId;
            styleEl.textContent = animationKeyframes;
            document.head.appendChild(styleEl);
        }
        return () => {
            const existing = document.getElementById(styleId);
            if (existing) existing.remove();
        };
    }, []);

    /* Tự động làm mới công việc */
    useEffect(() => {
        const terminalStatuses = ['completed', 'failed', 'cancelled'];
        if (terminalStatuses.includes(localJob.status) || refreshInterval <= 0) return;

        const id = setInterval(async () => {
            try {
                const res = await fetch(`${baseUrl}/api/retention/jobs/${localJob.id}`);
                if (res.ok) {
                    const updated = await res.json();
                    setLocalJob(updated);
                }
            } catch {
                // Bỏ qua lỗi làm mới — công việc vẫn chạy
            }
        }, refreshInterval);

        return () => clearInterval(id);
    }, [localJob.id, localJob.status, baseUrl, refreshInterval]);

    /* Countdown từ estimated_remaining_seconds */
    useEffect(() => {
        if (localJob.estimated_remaining_seconds && localJob.estimated_remaining_seconds > 0) {
            setCountdown(localJob.estimated_remaining_seconds);
        } else {
            setCountdown(null);
        }
    }, [localJob.estimated_remaining_seconds]);

    useEffect(() => {
        if (countdown === null || countdown <= 0) return;
        const id = setInterval(() => {
            setCountdown((prev) => {
                if (prev === null || prev <= 1) {
                    clearInterval(id);
                    return 0;
                }
                return prev - 1;
            });
        }, 1000);
        return () => clearInterval(id);
    }, [countdown]);

    /* Kích hoạt animation thành công/thất bại */
    useEffect(() => {
        if (localJob.status === 'completed') {
            setShowSuccessAnim(true);
            setShowErrorAnim(false);
            onComplete?.(localJob);
        } else if (localJob.status === 'failed') {
            setShowErrorAnim(true);
            setShowSuccessAnim(false);
        } else {
            setShowSuccessAnim(false);
            setShowErrorAnim(false);
        }
    }, [localJob.status]); // eslint-disable-line react-hooks/exhaustive-deps

    /* Tính toán */
    const progressPercent = useMemo(() => calcProgressPercent(localJob), [localJob]);
    const activeStep = useMemo(
        () => localJob.steps.find((s) => s.status === 'active'),
        [localJob.steps],
    );

    const debugInfo = useMemo(() => {
        if (!showDebug) return null;
        return localJob.steps
            .map(
                (s) =>
                    `[${s.key}] status=${s.status}`
                    + (s.duration_ms ? `, duration=${s.duration_ms}ms` : '')
                    + (s.records_processed != null ? `, records=${s.records_processed}` : '')
                    + (s.error_message ? `, error=${s.error_message}` : '')
            )
            .join('\n');
    }, [localJob.steps, showDebug]);

    /* Callbacks */
    const handleRetry = useCallback(() => {
        onRetry?.(localJob.id);
    }, [localJob.id, onRetry]);

    const handleCancel = useCallback(() => {
        onCancel?.(localJob.id);
    }, [localJob.id, onCancel]);

    const handleClose = useCallback(() => {
        onClose?.();
    }, [onClose]);

    const isTerminal = ['completed', 'failed', 'cancelled'].includes(localJob.status);

    return (
        <div style={containerStyle(size)}>
            {/* Header */}
            <div style={headerStyle()}>
                <h2 style={headerTitleStyle(size)}>
                    {jobTypeLabel(localJob.type)}
                </h2>
                <span style={statusTagStyle(localJob.status)}>
                    {jobStatusLabel(localJob.status)}
                </span>
            </div>

            {/* Thông tin phụ */}
            {localJob.policy_name && (
                <div style={{ fontSize: '13px', color: '#64748b', marginBottom: '8px' }}>
                    Chính sách: <strong>{localJob.policy_name}</strong>
                </div>
            )}

            {/* Thanh tiến độ tổng */}
            <div style={progressBarTrackStyle()}>
                <div style={progressBarFillStyle(progressPercent, localJob.status)} />
            </div>

            {/* Thống kê nhanh */}
            <div style={statsRowStyle()}>
                <div style={statItemStyle()}>
                    <p style={statValueStyle()}>{localJob.total_records.toLocaleString('vi-VN')}</p>
                    <p style={statLabelStyle()}>Tổng bản ghi</p>
                </div>
                <div style={statItemStyle()}>
                    <p style={statValueStyle()}>{localJob.processed_records.toLocaleString('vi-VN')}</p>
                    <p style={statLabelStyle()}>Đã xử lý</p>
                </div>
                <div style={statItemStyle()}>
                    <p style={statValueStyle()}>{progressPercent}%</p>
                    <p style={statLabelStyle()}>Tiến độ</p>
                </div>
            </div>

            {/* Countdown */}
            {countdown !== null && countdown > 0 && !isTerminal && (
                <div style={countdownStyle(size)}>
                    Thời gian ước tính c&#242;n lại: {formatDuration(countdown)}
                </div>
            )}

            {/* Hiệu ứng thành công */}
            {showSuccessAnim && (
                <div
                    style={{
                        textAlign: 'center',
                        marginBottom: '20px',
                        animation: 'rp-fadeInUp 0.5s ease-out',
                    }}
                >
                    <SuccessCheckmark size={config.stepIconSize * 2} />
                    <p
                        style={{
                            margin: '10px 0 0',
                            fontSize: `${config.stepLabelSize + 2}px`,
                            fontWeight: 700,
                            color: '#22c55e',
                        }}
                    >
                        C&#244;ng việc hoàn tất th&#224;nh c&#244;ng!
                    </p>
                    {localJob.completed_at && (
                        <p style={{ fontSize: '12px', color: '#64748b', marginTop: '4px' }}>
                            Hoàn thành l&#224;c {new Date(localJob.completed_at).toLocaleString('vi-VN')}
                        </p>
                    )}
                </div>
            )}

            {/* Hiệu ứng thất bại */}
            {showErrorAnim && (
                <div
                    style={{
                        textAlign: 'center',
                        marginBottom: '20px',
                        animation: 'rp-fadeInUp 0.5s ease-out',
                    }}
                >
                    <ErrorIcon size={config.stepIconSize * 2} />
                    <p
                        style={{
                            margin: '10px 0 0',
                            fontSize: `${config.stepLabelSize + 2}px`,
                            fontWeight: 700,
                            color: '#ef4444',
                        }}
                    >
                        C&#244;ng việc th&#224;t bại
                    </p>
                    {localJob.error_message && (
                        <p style={{ fontSize: '13px', color: '#991b1b', marginTop: '4px' }}>
                            {localJob.error_message}
                        </p>
                    )}
                </div>
            )}

            {/* Các bước */}
            <div style={stepContainerStyle(size)}>
                {localJob.steps.map((step, index) => {
                    const isLast = index === localJob.steps.length - 1;
                    const isActive = step === activeStep;
                    return (
                        <React.Fragment key={step.key}>
                            <div style={stepRowStyle(step.status)}>
                                <StepIcon step={step} iconSize={config.stepIconSize} isCurrentActive={isActive} />
                                <div style={{ flex: 1 }}>
                                    <p style={stepLabelStyle(step.status, config.stepLabelSize)}>
                                        {step.label}
                                    </p>
                                    <p style={stepDescStyle(config.stepDescSize, step.status)}>
                                        {step.status === 'failed' && step.error_message
                                            ? step.error_message
                                            : step.description}
                                        {step.records_processed != null && step.status === 'completed' && (
                                            <span style={{ marginLeft: '8px', color: '#22c55e' }}>
                                                ({step.records_processed.toLocaleString('vi-VN')} bản ghi)
                                            </span>
                                        )}
                                    </p>
                                </div>
                            </div>
                            {!isLast && (
                                <div style={stepLineStyle(size, step.status, config.stepIconSize)} />
                            )}
                        </React.Fragment>
                    );
                })}
            </div>

            {/* Debug */}
            {debugInfo && <div style={debugStyle}>{debugInfo}</div>}

            {/* Hành động */}
            <div style={actionBarStyle()}>
                {localJob.status === 'failed' && retryEnabled && (
                    <button onClick={handleRetry} style={btnStyle('primary')}>
                        Th&#259; l&#224;i
                    </button>
                )}
                {!isTerminal && (
                    <button onClick={handleCancel} style={btnStyle('danger')}>
                        H&#417;y c&#244;ng việc
                    </button>
                )}
                {isTerminal && (
                    <button onClick={handleClose} style={btnStyle('secondary')}>
                        &#1088;ng
                    </button>
                )}
            </div>
        </div>
    );
};

export default RetentionProgress;
