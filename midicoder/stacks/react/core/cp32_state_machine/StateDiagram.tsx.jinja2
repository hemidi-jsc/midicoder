/**
 * Cấu hình state machine từ backend.
 */
interface StateMachineConfig {
  machineId: string;
  entityType: string;
  states: string[];
  initialState: string;
  transitions: Record<string, string[]>;
  finalStates?: string[];
}

/**
 * Vị trí tính toán của node trong SVG.
 */
interface NodePosition {
  state: string;
  x: number;
  y: number;
  isInitial: boolean;
  isFinal: boolean;
}

/**
 * Props của StateDiagram.
 */
interface StateDiagramProps {
  /** Cấu hình state machine. */
  config: StateMachineConfig;
  /** State hiện tại đang được highlight. */
  currentState?: string;
  /** Class tên tùy chỉnh cho container. */
  className?: string;
  /** Callback khi click vào một state. */
  onStateClick?: (state: string) => void;
}

