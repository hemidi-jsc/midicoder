/** Form Field Component - Generic form field với Material/Tailwind/Bootstrap support. */

import React from "react";
{% if ui_framework == "material" %}
import { TextField, MenuItem, Checkbox, FormControlLabel, Select, InputLabel, FormControl } from "@mui/material";
{% endif %}

export type FieldType = 'text' | 'number' | 'email' | 'date' | 'boolean' | 'select' | 'textarea' | 'radio' | 'switch';

export interface FormFieldProps {
label: string;
fieldType?: FieldType;
value: string | number | boolean;
onChange: (value: any) => void;
required?: boolean;
options?: string[];
error?: string;
placeholder?: string;
}

export const FormField: React.FC<FormFieldProps> = ({
    label,
    fieldType = 'text',
    value,
    onChange,
    required = false,
    options = [],
    error,
    placeholder,
    }) => {
    {% if ui_framework == "material" %}
    if (fieldType === 'boolean') {
    return (
    <FormControlLabel control={<Checkbox checked={Boolean(value)} onChange={(e)=> onChange(e.target.checked)} />}
        label={label}
        />
        );
        }

        if (fieldType === 'select') {
        return (
        <FormControl fullWidth error={!!error}>
            <InputLabel>{label}</InputLabel>
            <Select value={String(value)} onChange={(e)=> onChange(e.target.value)} required={required}>
                {options.map((opt) => (
                <MenuItem key={opt} value={opt}>{opt}</MenuItem>
                ))}
            </Select>
            {% raw %}{error && <span style={{color: 'red' , fontSize: 12}}>{error}</span>}{% endraw %}
        </FormControl>
        );
        }

        return (
        <TextField label={label} type={fieldType} value={String(value)} onChange={(e)=> onChange(e.target.value)}
            required={required}
            error={!!error}
            helperText={error}
            placeholder={placeholder}
            fullWidth
            variant="outlined"
            />
            );
            {% elif ui_framework == "tailwind" %}
            const baseClasses = "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2
            focus:ring-blue-500";
            const errorClasses = error ? "border-red-500" : "border-gray-300";

            if (fieldType === 'boolean') {
            return (
            <div className="flex items-center gap-2">
                <input type="checkbox" id={label} checked={Boolean(value)} onChange={(e)=> onChange(e.target.checked)}
                className="w-4 h-4 text-blue-600 rounded" />
                <label htmlFor={label} className="text-sm font-medium text-gray-700">{label}</label>
            </div>
            );
            }

            if (fieldType === 'select') {
            return (
            <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">{label}{required && '*'}</label>
                <select value={String(value)} onChange={(e)=> onChange(e.target.value)}
                    className={`${baseClasses} ${errorClasses}`}>
                    {options.map((opt) => (
                    <option key={opt} value={opt}>{opt}</option>
                    ))}
                </select>
                {error && <span className="text-red-500 text-xs">{error}</span>}
            </div>
            );
            }

            if (fieldType === 'textarea') {
            return (
            <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">{label}{required && '*'}</label>
                <textarea value={String(value)} onChange={(e)=> onChange(e.target.value)}
                  required={required} placeholder={placeholder}
                  className={`${baseClasses} ${errorClasses}`} rows={4} />
        {error && <span className="text-red-500 text-xs">{error}</span>}
      </div>
    );
  }

  return (
    <div>
      <label className="block text-sm font-medium text-gray-700 mb-1">{label}{required && '*'}</label>
      <input type={fieldType} value={String(value)} onChange={(e) => onChange(e.target.value)}
             required={required} placeholder={placeholder}
             className={`${baseClasses} ${errorClasses}`} />
      {error && <span className="text-red-500 text-xs">{error}</span>}
    </div>
  );
  {% else %}
  return (
    <div className="form-field">
      <label>{label}{required && '*'}</label>
      <input type={fieldType} value={String(value)} onChange={(e) => onChange(e.target.value)}
             required={required} placeholder={placeholder} />
      {error && <span className="error">{error}</span>}
    </div>
  );
  {% endif %}
};

export default FormField;