/** Card List Component - Card grid layout. */

import React from "react";

export interface CardItem {
id: string;
title: string;
subtitle?: string;
description?: string;
avatar?: string;
actions?: CardAction[];
[key: string]: any;
}

export interface CardAction {
label: string;
icon?: string;
action: string;
}

export interface CardListProps {
items: CardItem[];
gridCols?: number;
onCardClick?: (item: CardItem) => void;
onCardAction?: (item: CardItem, action: CardAction) => void;
}

export const CardList: React.FC<CardListProps> = ({
    items,
    gridCols = 3,
    onCardClick,
    onCardAction,
    }) => {
    {% if ui_framework == "material" %}
    return (
    <div {% raw %}style={{ display: "grid" , gridTemplateColumns: `repeat(${gridCols}, 1fr)`, gap: "1rem" }}{% endraw
        %}>
        {items.map((item) => (
        <Card key={item.id} onClick={()=> onCardClick?.(item)}
            {% raw %}style={{ cursor: onCardClick ? 'pointer' : 'default' }}{% endraw %}
            >
            <CardContent>
                <Typography variant="h6" component="h3">{item.title}</Typography>
                {item.subtitle && <Typography color="textSecondary" variant="body2">{item.subtitle}</Typography>}
                {item.description && <Typography variant="body2" paragraph>{item.description}</Typography>}
            </CardContent>
            {item.actions && item.actions.length > 0 && (
            <CardActions>
                {item.actions.map((action) => (
                <Button key={action.action} size="small" onClick={(e)=> {
                    e.stopPropagation();
                    onCardAction?.(item, action);
                    }}
                    >
                    {action.label}
                </Button>
                ))}
            </CardActions>
            )}
        </Card>
        ))}
    </div>
    );
    {% elif ui_framework == "tailwind" %}
    return (
    <div className="grid gap-6" {% raw %}style={{ gridTemplateColumns: `repeat(${gridCols}, 1fr)` }}{% endraw %}>
        {items.map((item) => (
        <div key={item.id} onClick={()=> onCardClick?.(item)}
            className="bg-white rounded-lg shadow-md p-6 cursor-pointer hover:shadow-lg transition-shadow"
            >
            <h3 className="text-lg font-semibold text-gray-900">{item.title}</h3>
            {item.subtitle && <p className="text-sm text-gray-500 mt-1">{item.subtitle}</p>}
            {item.description && <p className="text-gray-700 mt-2">{item.description}</p>}
            {item.actions && item.actions.length > 0 && (
            <div className="mt-4 flex gap-2">
                {item.actions.map((action) => (
                <button key={action.action} onClick={(e)=> {
                    e.stopPropagation();
                    onCardAction?.(item, action);
                    }}
                    className="px-3 py-1 text-sm bg-blue-500 text-white rounded hover:bg-blue-600"
                    >
                    {action.label}
                </button>
                ))}
            </div>
            )}
        </div>
        ))}
    </div>
    );
    {% else %}
    return (
    <div className="card-grid" {% raw %}style={{ display: "grid" , gridTemplateColumns: `repeat(${gridCols}, 1fr)`,
        gap: "1rem" }}{% endraw %}>
        {items.map((item) => (
        <div key={item.id} className="card" onClick={()=> onCardClick?.(item)}>
            <h3>{item.title}</h3>
            {item.subtitle && <p>{item.subtitle}</p>}
            {item.description && <p>{item.description}</p>}
            {item.actions && item.actions.length > 0 && (
            <div className="card-actions">
                {item.actions.map((action) => (
                <button key={action.action} onClick={(e)=> {
                    e.stopPropagation();
                    onCardAction?.(item, action);
                    }}
                    >
                    {action.label}
                </button>
                ))}
            </div>
            )}
        </div>
        ))}
    </div>
    );
    {% endif %}
    };

    export default CardList;