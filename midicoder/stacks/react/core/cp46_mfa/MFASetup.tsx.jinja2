import React, { useState } from 'react';
import { useMFA } from '../../hooks/mfa/useMFA';
import { MFAMethod } from '../../types/mfa-types';

export function MFASetup() {
  const { enroll, loading, error } = useMFA();
  const [method, setMethod] = useState(MFAMethod.TOTP);
  const [deviceName, setDeviceName] = useState('');
  const [qrCode, setQrCode] = useState<string | null>(null);
  const [verificationCode, setVerificationCode] = useState('');

  const methods = [
    { value: MFAMethod.TOTP, label: 'TOTP (Authenticator App)' },
    { value: MFAMethod.SMS_OTP, label: 'SMS OTP' },
    { value: MFAMethod.WEBAUTHN_FIDO2, label: 'WebAuthn/FIDO2' },
    { value: MFAMethod.BIOMETRIC, label: 'Biometric' },
  ];

  const handleEnroll = async () => {
    const result = await enroll('current-user', method, deviceName);
    if (result?.qrCodeData) {
      setQrCode(result.qrCodeData);
    }
  };

  const handleVerify = async () => {
    // Verify enrollment with code
    console.log('Verifying enrollment with code:', verificationCode);
  };

  return (
    <div className="mfa-setup">
      <h2>Setup Multi-Factor Authentication</h2>
      {error && <div className="error">{error}</div>}
      <div className="form-group">
        <label>Authentication Method</label>
        <select value={method} onChange={(e) => setMethod(e.target.value)}>
          {methods.map((m) => (
            <option key={m.value} value={m.value}>{m.label}</option>
          ))}
        </select>
      </div>
      <div className="form-group">
        <label>Device Name</label>
        <input
          type="text"
          value={deviceName}
          onChange={(e) => setDeviceName(e.target.value)}
          placeholder="My phone"
        />
      </div>
      <button onClick={handleEnroll} disabled={loading}>
        {loading ? 'Processing...' : 'Enroll'}
      </button>
      {qrCode && (
        <div className="qr-code">
          <h3>Scan QR Code with your authenticator app</h3>
          <pre>{qrCode}</pre>
        </div>
      )}
      {qrCode && (
        <div className="form-group">
          <label>Enter verification code</label>
          <input
            type="text"
            value={verificationCode}
            onChange={(e) => setVerificationCode(e.target.value)}
            placeholder="123456"
            maxLength={6}
          />
          <button onClick={handleVerify}>Verify</button>
        </div>
      )}
    </div>
  );
}

export default MFASetup;
