import React, { useState } from 'react';
import { useMFA } from '../../hooks/mfa/useMFA';
import { MFAMethod } from '../../types/mfa-types';

export function MFAVerify() {
const { createChallenge, verifyChallenge, loading, error } = useMFA();
const [method, setMethod] = useState(MFAMethod.TOTP);
const [otpCode, setOtpCode] = useState('');
const [sessionId, setSessionId] = useState<string | null>(null);
    const [remainingAttempts, setRemainingAttempts] = useState(5);

    const methods = [
    { value: MFAMethod.TOTP, label: 'TOTP' },
    { value: MFAMethod.SMS_OTP, label: 'SMS OTP' },
    { value: MFAMethod.WEBAUTHN_FIDO2, label: 'WebAuthn' },
    { value: MFAMethod.BIOMETRIC, label: 'Biometric' },
    ];

    const handleCreateChallenge = async () => {
    const result = await createChallenge('current-user', method);
    if (result) {
    setSessionId(result.sessionId);
    setRemainingAttempts(result.remainingAttempts);
    }
    };

    const handleVerify = async () => {
    if (!sessionId) return;
    await verifyChallenge(sessionId, otpCode);
    };

    return (
    <div className="mfa-verify">
        <h2>Multi-Factor Authentication</h2>
        {error && <div className="error">{error}</div>}
        {!sessionId ? (
        <>
            <div className="form-group">
                <label>Select Method</label>
                <select value={method} onChange={(e)=> setMethod(e.target.value)}>
                    {methods.map((m) => (
                    <option key={m.value} value={m.value}>{m.label}</option>
                    ))}
                </select>
            </div>
            <button onClick={handleCreateChallenge} disabled={loading}>
                {loading ? 'Processing...' : 'Request Code'}
            </button>
        </>
        ) : (
        <>
            <p>Remaining attempts: {remainingAttempts}</p>
            <div className="form-group">
                <label>Enter OTP Code</label>
                <input type="text" value={otpCode} onChange={(e)=> setOtpCode(e.target.value)}
                placeholder="123456"
                maxLength={6}
                />
            </div>
            <button onClick={handleVerify} disabled={loading}>
                {loading ? 'Verifying...' : 'Verify'}
            </button>
        </>
        )}
    </div>
    );
    }

    export default MFAVerify;