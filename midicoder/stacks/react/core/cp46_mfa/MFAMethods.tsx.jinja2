import React, { useEffect, useState } from 'react';
import { mfaApi } from '../../api/mfa-api';
import { MFACredential, MFAStatus } from '../../types/mfa-types';

export function MFAMethods() {
const [status, setStatus] = useState<MFAStatus | null>(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);

        useEffect(() => {
        loadStatus();
        }, []);

        const loadStatus = async () => {
        setLoading(true);
        try {
        const data = await mfaApi.getStatus('current-user');
        setStatus(data);
        } catch (err: any) {
        setError(err.message || 'Failed to load MFA status');
        } finally {
        setLoading(false);
        }
        };

        const handleDisable = async (credentialId: string) => {
        try {
        await mfaApi.disable(credentialId);
        await loadStatus();
        } catch (err: any) {
        setError(err.message || 'Failed to disable credential');
        }
        };

        const handleRevoke = async (credentialId: string) => {
        try {
        await mfaApi.revoke(credentialId);
        await loadStatus();
        } catch (err: any) {
        setError(err.message || 'Failed to revoke credential');
        }
        };

        if (loading) return <div>Loading...</div>;
        if (error) return <div className="error">{error}</div>;

        return (
        <div className="mfa-methods">
            <h2>MFA Methods</h2>
            <div className="mfa-status">
                <span>MFA Enabled: </span>
                <strong>{status?.isMfaEnabled ? 'Yes' : 'No'}</strong>
            </div>
            <ul className="credential-list">
                {status?.methods.map((cred: MFACredential) => (
                <li key={cred.credentialId} className="credential-item">
                    <div>
                        <strong>{cred.method}</strong>
                        <span className="status">[{cred.status}]</span>
                        {cred.deviceName && <span className="device-name"> — {cred.deviceName}</span>}
                    </div>
                    <div className="actions">
                        <button onClick={()=> handleDisable(cred.credentialId)}>Disable</button>
                        <button onClick={()=> handleRevoke(cred.credentialId)}>Revoke</button>
                    </div>
                </li>
                ))}
            </ul>
        </div>
        );
        }

        export default MFAMethods;