/** Register Page - CP21.
*
* Trang đăng ký tài khoản mới.
*
* UI Framework: [{ui_framework}]
*/

import React, { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
{% set fw = ui_framework | default("tailwind") %}
{% if fw == "material" %}
import { Container, Paper, TextField, Button, Typography, Box, Divider, Alert } from "@mui/material";
{% elif fw == "tailwind" %}
{# Tailwind uses utility classes, no UI library import #}
{% elif fw == "bootstrap" %}
import { Container, Card, Form, Button, Alert } from "react-bootstrap";
{% elif fw == "antd" %}
import { Form, Input, Button, Card, Typography, Alert, Divider } from "antd";
{% elif fw == "carbon" %}
import { Form, FormGroup, TextInput, Button, InlineNotification, Grid, Column, Layer } from "@carbon/react";
{% endif %}

const { Title, Text } = Typography;

/** Register Page Props */
export interface RegisterPageProps {
redirectPath?: string;
}

/** Register Page Component. */
export const Register: React.FC<RegisterPageProps> = ({
    redirectPath = "/login",
    }) => {
    const navigate = useNavigate();
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);
        const [success, setSuccess] = useState(false);

        const handleSubmit = async (values: { email: string; password: string; confirmPassword: string; fullName: string
        }) => {
        if (values.password !== values.confirmPassword) {
        setError("Mật khẩu xác nhận không khớp.");
        return;
        }
        setLoading(true);
        setError(null);
        try {
        // TODO: gọi API đăng ký
        setSuccess(true);
        setTimeout(() => navigate(redirectPath), 2000);
        } catch (err: any) {
        setError(err.message || "Đăng ký thất bại.");
        } finally {
        setLoading(false);
        }
        };

        {% if fw == "antd" %}
        const [form] = Form.useForm();
        const fullFormStyle = { minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center",
        background: "#f0f2f5" };
        const cardStyle = { width: 400 };
        const alertStyle = { marginBottom: 16 };
        const mtStyle = { marginTop: 16, textAlign: "center" };
        const nameRule = { required: true };
        const emailRule = { required: true, type: "email" };
        const passRule = { required: true, min: 8 };

        if (success) {
        return (
        <div style={fullFormStyle}>
            <Card style={cardStyle} title={<Typography.Title level={3}>Đăng ký thành công</Typography.Title>}>
                <Alert message="Đăng ký thành công! Đang chuyển đến trang đăng nhập..." type="success"
                    style={alertStyle} />
            </Card>
        </div>
        );
        }

        return (
        <div style={fullFormStyle}>
            <Card style={cardStyle} title={<Typography.Title level={3}>Đăng ký tài khoản</Typography.Title>}>
                {error &&
                <Alert message={error} type="error" style={alertStyle} />}
                <Form form={form} onFinish={handleSubmit}>
                    <Form.Item name="fullName" rules={[nameRule]}>
                        <Input size="large" placeholder="Họ và tên" />
                    </Form.Item>
                    <Form.Item name="email" rules={[emailRule]}>
                        <Input size="large" placeholder="Email" />
                    </Form.Item>
                    <Form.Item name="password" rules={[passRule]}>
                        <Input.Password size="large" placeholder="Mật khẩu" />
                    </Form.Item>
                    <Form.Item name="confirmPassword" rules={[nameRule]}>
                        <Input.Password size="large" placeholder="Xác nhận mật khẩu" />
                    </Form.Item>
                    <Form.Item>
                        <Button type="primary" htmlType="submit" size="large" block loading={loading}>
                            Đăng ký
                        </Button>
                    </Form.Item>
                </Form>
                <Divider>
                    <Typography.Text type="secondary">hoặc</Typography.Text>
                </Divider>
                <div style={mtStyle}>
                    <Link to="/login">Đã có tài khoản? Đăng nhập</Link>
                </div>
            </Card>
        </div>
        );
        {% elif fw == "material" %}
        const loginStyle = { mt: 8 };
        const paperStyle = { p: 4 };
        const btnStyle = { mt: 2, mb: 1 };
        const linkStyle = { mt: 2, textAlign: "center" };
        const emptyValues = { email: "", password: "", confirmPassword: "", fullName: "" };

        if (success) {
        return (
        <Container maxWidth="sm" sx={loginStyle}>
            <Paper elevation={3} sx={paperStyle}>
                <Typography variant="h4" align="center" gutterBottom>Đăng ký thành công</Typography>
                <Alert severity="success" sx={{ mb: 2 }}>Đăng ký thành công! Đang chuyển đến trang đăng nhập...</Alert>
            </Paper>
        </Container>
        );
        }

        return (
        <Container maxWidth="sm" sx={loginStyle}>
            <Paper elevation={3} sx={paperStyle}>
                <Typography variant="h4" align="center" gutterBottom>Đăng ký tài khoản</Typography>
                {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}
                <Box component="form" onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                    <TextField fullWidth label="Họ và tên" margin="normal" required />
                    <TextField fullWidth label="Email" type="email" margin="normal" required />
                    <TextField fullWidth label="Mật khẩu" type="password" margin="normal" required />
                    <TextField fullWidth label="Xác nhận mật khẩu" type="password" margin="normal" required />
                    <Button fullWidth variant="contained" type="submit" sx={btnStyle} disabled={loading}>
                        {loading ? "Đang đăng ký..." : "Đăng ký"}
                    </Button>
                </Box>
                <Box sx={linkStyle}>
                    <Link to="/login">Đã có tài khoản? Đăng nhập</Link>
                </Box>
            </Paper>
        </Container>
        );
        {% elif fw == "tailwind" %}
        const emptyValues = { email: "", password: "", confirmPassword: "", fullName: "" };

        if (success) {
        return (
        <div className="min-h-screen flex items-center justify-center bg-gray-50">
            <div className="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow-md">
                <h2 className="text-3xl font-bold text-center">Đăng ký thành công</h2>
                <div className="bg-green-100 text-green-700 p-3 rounded">
                    Đăng ký thành công! Đang chuyển đến trang đăng nhập...
                </div>
            </div>
        </div>
        );
        }

        return (
        <div className="min-h-screen flex items-center justify-center bg-gray-50">
            <div className="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow-md">
                <h2 className="text-3xl font-bold text-center">Đăng ký tài khoản</h2>
                {error && <div className="bg-red-100 text-red-700 p-3 rounded">{error}</div>}
                <form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }} className="space-y-4">
                    <input type="text" placeholder="Họ và tên" required className="w-full p-3 border rounded" />
                    <input type="email" placeholder="Email" required className="w-full p-3 border rounded" />
                    <input type="password" placeholder="Mật khẩu" required className="w-full p-3 border rounded" />
                    <input type="password" placeholder="Xác nhận mật khẩu" required
                        className="w-full p-3 border rounded" />
                    <button type="submit" disabled={loading}
                        className="w-full p-3 bg-blue-600 text-white rounded hover:bg-blue-700">
                        {loading ? "Đang đăng ký..." : "Đăng ký"}
                    </button>
                </form>
                <div className="text-center">
                    <Link to="/login" className="text-blue-600">Đã có tài khoản? Đăng nhập</Link>
                </div>
            </div>
        </div>
        );
        {% elif fw == "bootstrap" %}
        const emptyValues = { email: "", password: "", confirmPassword: "", fullName: "" };

        if (success) {
        return (
        <Container className="d-flex align-items-center justify-content-center" style={{ minHeight: "100vh" }}>
            <Card style={{ maxWidth: 400, width: "100%" }}>
                <Card.Body>
                    <h2 className="text-center">Đăng ký thành công</h2>
                    <Alert variant="success">Đăng ký thành công! Đang chuyển đến trang đăng nhập...</Alert>
                </Card.Body>
            </Card>
        </Container>
        );
        }

        return (
        <Container className="d-flex align-items-center justify-content-center" style={{ minHeight: "100vh" }}>
            <Card style={{ maxWidth: 400, width: "100%" }}>
                <Card.Body>
                    <h2 className="text-center">Đăng ký tài khoản</h2>
                    {error && <Alert variant="danger">{error}</Alert>}
                    <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                        <Form.Group className="mb-3">
                            <Form.Control type="text" placeholder="Họ và tên" required />
                        </Form.Group>
                        <Form.Group className="mb-3">
                            <Form.Control type="email" placeholder="Email" required />
                        </Form.Group>
                        <Form.Group className="mb-3">
                            <Form.Control type="password" placeholder="Mật khẩu" required />
                        </Form.Group>
                        <Form.Group className="mb-3">
                            <Form.Control type="password" placeholder="Xác nhận mật khẩu" required />
                        </Form.Group>
                        <Button variant="primary" type="submit" disabled={loading} className="w-100">
                            {loading ? "Đang đăng ký..." : "Đăng ký"}
                        </Button>
                    </Form>
                    <div className="text-center mt-3">
                        <Link to="/login">Đã có tài khoản? Đăng nhập</Link>
                    </div>
                </Card.Body>
            </Card>
        </Container>
        );
        {% elif fw == "carbon" %}
        const emptyValues = { email: "", password: "", confirmPassword: "", fullName: "" };

        if (success) {
        return (
        <div style={{ minHeight: "100vh" , display: "flex" , alignItems: "center" , justifyContent: "center" }}>
            <Grid condense>
                <Column>
                    <Layer>
                        <div className="cds--content" style={{ maxWidth: 400, width: "100%" }}>
                            <h2 className="cds--text-truncate">Đăng ký thành công</h2>
                            <InlineNotification kind="success" title="Thành công" lowContrast>
                                Đăng ký thành công! Đang chuyển đến trang đăng nhập...
                            </InlineNotification>
                        </div>
                    </Layer>
                </Column>
            </Grid>
        </div>
        );
        }

        return (
        <div style={{ minHeight: "100vh" , display: "flex" , alignItems: "center" , justifyContent: "center" }}>
            <Grid condense>
                <Column>
                    <Layer>
                        <div className="cds--content" style={{ maxWidth: 400, width: "100%" }}>
                            <h2 className="cds--text-truncate">Đăng ký tài khoản</h2>
                            {error && (
                            <InlineNotification kind="error" title="Lỗi" lowContrast onClose={()=> setError(null)}>
                                {error}
                            </InlineNotification>
                            )}
                            <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                                <FormGroup>
                                    <TextInput id="fullName" label="Họ và tên" placeholder="Họ và tên" required />
                                    <TextInput id="email" label="Email" type="email" placeholder="Email" required />
                                    <TextInput id="password" label="Mật khẩu" type="password" placeholder="Mật khẩu"
                                        required />
                                    <TextInput id="confirmPassword" label="Xác nhận mật khẩu" type="password"
                                        placeholder="Xác nhận mật khẩu" required />
                                </FormGroup>
                                <Button kind="primary" type="submit" disabled={loading} style={{ width: "100%" }}>
                                    {loading ? "Đang đăng ký..." : "Đăng ký"}
                                </Button>
                            </Form>
                            <div className="cds--list" style={{ marginTop: 16, textAlign: "center" }}>
                                <Link to="/login">Đã có tài khoản? Đăng nhập</Link>
                            </div>
                        </div>
                    </Layer>
                </Column>
            </Grid>
        </div>
        );
        {% endif %}
        };

        export default Register;