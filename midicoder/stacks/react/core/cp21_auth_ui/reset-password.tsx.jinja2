/** Reset Password Page - CP21.
*
* Trang đặt lại mật khẩu mới (sau khi click link từ email).
*
* UI Framework: [{ui_framework}]
*/

import React, { useState } from "react";
import { Link, useNavigate, useSearchParams } from "react-router-dom";
{% set fw = ui_framework | default("tailwind") %}
{% if fw == "material" %}
import { Container, Paper, TextField, Button, Typography, Box, Alert } from "@mui/material";
{% elif fw == "tailwind" %}
{# Tailwind uses utility classes, no UI library import #}
{% elif fw == "bootstrap" %}
import { Container, Card, Form, Button, Alert } from "react-bootstrap";
{% elif fw == "antd" %}
import { Form, Input, Button, Card, Typography, Alert, message } from "antd";
{% elif fw == "carbon" %}
import { Form, FormGroup, TextInput, Button, InlineNotification, Grid, Column, Layer } from "@carbon/react";
{% endif %}

const { Title, Text } = Typography;

export interface ResetPasswordPageProps {}

export const ResetPassword: React.FC<ResetPasswordPageProps> = () => {
    const navigate = useNavigate();
    const [searchParams] = useSearchParams();
    const token = searchParams.get("token") || "";
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);

        const handleSubmit = async (values: { password: string; confirmPassword: string }) => {
        if (values.password !== values.confirmPassword) {
        setError("Mật khẩu xác nhận không khớp.");
        return;
        }
        setLoading(true);
        setError(null);
        try {
        // TODO: gọi API reset password với token
        navigate("/login", { state: { message: "Mật khẩu đã được đặt lại." } });
        } catch (err: any) {
        setError(err.message || "Đặt lại mật khẩu thất bại.");
        } finally {
        setLoading(false);
        }
        };

        {% if fw == "antd" %}
        const [form] = Form.useForm();
        const fullFormStyle = { minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center",
        background: "#f0f2f5" };
        const cardStyle = { width: 400 };
        const alertStyle = { marginBottom: 16 };
        const mtStyle = { textAlign: "center" };
        const passRule = { required: true, min: 8 };
        const nameRule = { required: true };

        return (
        <div style={fullFormStyle}>
            <Card style={cardStyle} title={<Typography.Title level={3}>Đặt lại mật khẩu</Typography.Title>}>
                {error &&
                <Alert message={error} type="error" style={alertStyle} />}
                <Form form={form} onFinish={handleSubmit}>
                    <Form.Item name="password" rules={[passRule]}>
                        <Input.Password size="large" placeholder="Mật khẩu mới" />
                    </Form.Item>
                    <Form.Item name="confirmPassword" rules={[nameRule]}>
                        <Input.Password size="large" placeholder="Xác nhận mật khẩu mới" />
                    </Form.Item>
                    <Form.Item>
                        <Button type="primary" htmlType="submit" size="large" block loading={loading}>
                            Đặt lại mật khẩu
                        </Button>
                    </Form.Item>
                </Form>
                <div style={mtStyle}>
                    <Link to="/login">Quay lại đăng nhập</Link>
                </div>
            </Card>
        </div>
        );
        {% elif fw == "material" %}
        const loginStyle = { mt: 8 };
        const paperStyle = { p: 4 };
        const btnStyle = { mt: 2, mb: 1 };
        const linkStyle = { mt: 2, textAlign: "center" };
        const emptyValues = { password: "", confirmPassword: "" };

        return (
        <Container maxWidth="sm" sx={loginStyle}>
            <Paper elevation={3} sx={paperStyle}>
                <Typography variant="h4" align="center" gutterBottom>Đặt lại mật khẩu</Typography>
                {error && <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>}
                <Box component="form" onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                    <TextField fullWidth label="Mật khẩu mới" type="password" margin="normal" required />
                    <TextField fullWidth label="Xác nhận mật khẩu mới" type="password" margin="normal" required />
                    <Button fullWidth variant="contained" type="submit" sx={btnStyle} disabled={loading}>
                        {loading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
                    </Button>
                </Box>
                <Box sx={linkStyle}>
                    <Link to="/login">Quay lại đăng nhập</Link>
                </Box>
            </Paper>
        </Container>
        );
        {% elif fw == "tailwind" %}
        const emptyValues = { password: "", confirmPassword: "" };

        return (
        <div className="min-h-screen flex items-center justify-center bg-gray-50">
            <div className="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow-md">
                <h2 className="text-3xl font-bold text-center">Đặt lại mật khẩu</h2>
                {error && <div className="bg-red-100 text-red-700 p-3 rounded">{error}</div>}
                <form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }} className="space-y-4">
                    <input type="password" placeholder="Mật khẩu mới" required className="w-full p-3 border rounded" />
                    <input type="password" placeholder="Xác nhận mật khẩu mới" required
                        className="w-full p-3 border rounded" />
                    <button type="submit" disabled={loading}
                        className="w-full p-3 bg-blue-600 text-white rounded hover:bg-blue-700">
                        {loading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
                    </button>
                </form>
                <div className="text-center">
                    <Link to="/login" className="text-blue-600">Quay lại đăng nhập</Link>
                </div>
            </div>
        </div>
        );
        {% elif fw == "bootstrap" %}
        const emptyValues = { password: "", confirmPassword: "" };

        return (
        <Container className="d-flex align-items-center justify-content-center" style={{ minHeight: "100vh" }}>
            <Card style={{ maxWidth: 400, width: "100%" }}>
                <Card.Body>
                    <h2 className="text-center">Đặt lại mật khẩu</h2>
                    {error && <Alert variant="danger">{error}</Alert>}
                    <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                        <Form.Group className="mb-3">
                            <Form.Control type="password" placeholder="Mật khẩu mới" required />
                        </Form.Group>
                        <Form.Group className="mb-3">
                            <Form.Control type="password" placeholder="Xác nhận mật khẩu mới" required />
                        </Form.Group>
                        <Button variant="primary" type="submit" disabled={loading} className="w-100">
                            {loading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
                        </Button>
                    </Form>
                    <div className="text-center mt-3">
                        <Link to="/login">Quay lại đăng nhập</Link>
                    </div>
                </Card.Body>
            </Card>
        </Container>
        );
        {% elif fw == "carbon" %}
        const emptyValues = { password: "", confirmPassword: "" };

        return (
        <div style={{ minHeight: "100vh" , display: "flex" , alignItems: "center" , justifyContent: "center" }}>
            <Grid condense>
                <Column>
                    <Layer>
                        <div className="cds--content" style={{ maxWidth: 400, width: "100%" }}>
                            <h2 className="cds--text-truncate">Đặt lại mật khẩu</h2>
                            {error && (
                            <InlineNotification kind="error" title="Lỗi" lowContrast onClose={()=> setError(null)}>
                                {error}
                            </InlineNotification>
                            )}
                            <Form onSubmit={(e)=> { e.preventDefault(); handleSubmit(emptyValues); }}>
                                <FormGroup>
                                    <TextInput id="password" label="Mật khẩu mới" type="password"
                                        placeholder="Mật khẩu mới" required />
                                    <TextInput id="confirmPassword" label="Xác nhận mật khẩu mới" type="password"
                                        placeholder="Xác nhận mật khẩu mới" required />
                                </FormGroup>
                                <Button kind="primary" type="submit" disabled={loading} style={{ width: "100%" }}>
                                    {loading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
                                </Button>
                            </Form>
                            <div className="cds--list" style={{ marginTop: 16, textAlign: "center" }}>
                                <Link to="/login">Quay lại đăng nhập</Link>
                            </div>
                        </div>
                    </Layer>
                </Column>
            </Grid>
        </div>
        );
        {% endif %}
        };

        export default ResetPassword;