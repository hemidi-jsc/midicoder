import React, { useState, useCallback, useMemo, createContext, useContext } from 'react';
import { useChannelSubscription } from './useChannelSubscription';

/**
* LiveCursor component — hiển thị con trỏ multi-user collaborative editing
* Sinh bởi CP22 RealtimeComponentEmitter
*/

interface CursorData {
userId: string;
x: number;
y: number;
color?: string;
label?: string;
timestamp: string;
}

interface LiveCursorContextType {
cursors: Map<string, CursorData>;
    addCursor: (cursor: CursorData) => void;
    removeCursor: (userId: string) => void;
    }

    {% if ui_framework == "material" %}
    import { Tooltip } from '@mui/material';
    {% elif ui_framework == "tailwind" %}
    const cursorClasses = {
    container: 'relative w-full h-full',
    pointer: 'absolute w-0.5 h-5 transition-all duration-100 ease-linear pointer-events-none',
    label: 'absolute -top-5 left-0 px-1.5 py-0.5 text-[10px] text-white rounded truncate pointer-events-none',
    };
    {% elif ui_framework == "bootstrap" %}
    import { Tooltip } from 'react-bootstrap';
    {% elif ui_framework == "antd" %}
    import { Tooltip } from 'antd';
    {% elif ui_framework == "carbon" %}
    import { Tooltip } from '@carbon/react';
    {% endif %}

    const LiveCursorContext = createContext<LiveCursorContextType>({
        cursors: new Map(),
        addCursor: () => {},
        removeCursor: () => {},
        });

        export const LiveCursorProvider: React.FC<{ channel?: string; tenantId?: string; children: React.ReactNode; }> =
            ({ channel = 'cursor.sync', tenantId, children }) => {
            const [cursors, setCursors] = useState<Map<string, CursorData>>(new Map());
                const { isConnected } = useChannelSubscription(channel, {
                tenantId,
                {% if has_tenant_scope %}
                tenantId,
                {% endif %}
                onMessage: (payload) => {
                const data = payload.data as CursorData;
                if (data && data.userId) {
                setCursors((prev) => {
                const next = new Map(prev);
                next.set(data.userId, {
                userId: data.userId,
                x: data.x || 0,
                y: data.y || 0,
                color: data.color || '#1976d2',
                label: data.label || data.userId,
                timestamp: data.timestamp || new Date().toISOString(),
                });
                return next;
                });
                }
                },
                });

                const addCursor = useCallback((cursor: CursorData) => {
                setCursors((prev) => {
                const next = new Map(prev);
                next.set(cursor.userId, cursor);
                return next;
                });
                }, []);

                const removeCursor = useCallback((userId: string) => {
                setCursors((prev) => {
                const next = new Map(prev);
                next.delete(userId);
                return next;
                });
                }, []);

                const contextValue = useMemo(
                () => ({ cursors, addCursor, removeCursor }),
                [cursors, addCursor, removeCursor],
                );

                return (
                <LiveCursorContext.Provider value={contextValue}>
                    {children}
                </LiveCursorContext.Provider>
                );
                };

                export const useLiveCursor = () => useContext(LiveCursorContext);

                interface LiveCursorProps {
                showLabels?: boolean;
                className?: string;
                }

                /**
                * Hiển thị con trỏ của multiple users trong collaborative editing
                */
                export const LiveCursor: React.FC<LiveCursorProps> = ({
                    showLabels = true,
                    className = '',
                    }) => {
                    const { cursors } = useLiveCursor();

                    {% if ui_framework == "tailwind" %}
                    return (
                    <div className={`midicoder-live-cursor ${cursorClasses.container} ${className}`}>
                        {Array.from(cursors.values()).map((cursor) => (
                        <div key={cursor.userId} className={cursorClasses.pointer} style={{ left: cursor.x, top:
                            cursor.y, backgroundColor: cursor.color || '#1976d2' , zIndex: 1000 }}
                            title={`${cursor.label}: (${Math.round(cursor.x)}, ${Math.round(cursor.y)})`}>
                            {showLabels && (
                            <div className={cursorClasses.label} style={{ backgroundColor: cursor.color || '#1976d2' }}>
                                {cursor.label}
                            </div>
                            )}
                        </div>
                        ))}
                    </div>
                    );
                    {% else %}
                    return (
                    <div className={`midicoder-live-cursor ${className}`} style={{ position: 'relative' , width: '100%'
                        , height: '100%' }}>
                        {Array.from(cursors.values()).map((cursor) => (
                        <div key={cursor.userId} style={{ position: 'absolute' , left: cursor.x, top: cursor.y, width:
                            2, height: 20, backgroundColor: cursor.color || '#1976d2' ,
                            transition: 'left 0.1s ease, top 0.1s ease' , pointerEvents: 'none' , zIndex: 1000, }}
                            title={`${cursor.label}: (${Math.round(cursor.x)}, ${Math.round(cursor.y)})`}>
                            {showLabels && (
                            <div style={{ position: 'absolute' , top: -20, left: 0, padding: '2px 6px' ,
                                backgroundColor: cursor.color || '#1976d2' , color: 'white' , fontSize: 10,
                                borderRadius: 2, whiteSpace: 'nowrap' , pointerEvents: 'none' , }}>
                                {cursor.label}
                            </div>
                            )}
                        </div>
                        ))}
                    </div>
                    );
                    {% endif %}
                    };

                    export default LiveCursor;