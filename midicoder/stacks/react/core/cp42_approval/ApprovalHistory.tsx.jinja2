/**
* ApprovalHistory — lich su approvals: table voi sort/filter/pagination, date range, export.
* Sinh boi CP42 ApprovalEmitter.
*
{% raw %} * UI Framework: {{{ ui_framework }}}{% endraw %}
*/
{% if ui_framework == "material" %}
import React, { useState, useMemo, useCallback } from 'react';
import { Button, Chip, Table, TableBody, TableCell, TableContainer, TableHead, TableRow, Paper, TablePagination,
TextField, MenuItem, InputLabel, FormControl, Select } from '@mui/material';
{% elif ui_framework == "tailwind" %}
import React, { useState, useMemo, useCallback } from 'react';
// Su dung Tailwind utility classes trong JSX
{% elif ui_framework == "bootstrap" %}
import React, { useState, useMemo, useCallback } from 'react';
import { Button, Table, Form, Badge as BsBadge, Pagination } from 'react-bootstrap';
{% elif ui_framework == "antd" %}
import React, { useState, useMemo, useCallback } from 'react';
import { Button, Table, Tag, Space, Select, Input, Pagination } from 'antd';
{% elif ui_framework == "carbon" %}
import React, { useState, useMemo, useCallback } from 'react';
import { Button, DataTable, DataTableBody, DataTableRow, TableHeader, TableHeaderCell, TableRow, Tag, TextInput, Select,
SelectItem } from '@carbon/react';
{% endif %}

/* ---- Loai trang thai ---- */
export type ApprovalStatus = 'pending' | 'approved' | 'rejected' | 'escalated' | 'delegated' | 'expired' | 'cancelled';

/* ---- Interface du lieu ---- */
export interface ApprovalHistoryItem {
request_id: string;
title: string;
status: ApprovalStatus;
initiator_id: string;
current_step: number;
total_steps: number;
created_at: string | null;
updated_at: string | null;
deadline: string | null;
}

export interface ApprovalHistoryProps {
requests: ApprovalHistoryItem[];
onExport?: (data: ApprovalHistoryItem[]) => void;
onSelectRequest?: (requestId: string) => void;
}

/* ---- Style objects ---- */
const sWrap: React.CSSProperties = {
display: 'flex',
flexDirection: 'column' as const,
height: '100%',
fontFamily: 'system-ui, sans-serif',
backgroundColor: '#f3f4f6',
};
const sHeader: React.CSSProperties = {
padding: '16px 20px',
backgroundColor: '#fff',
borderBottom: '1px solid #e5e7eb',
display: 'flex',
alignItems: 'center',
justifyContent: 'space-between',
};
const sHeaderTitle: React.CSSProperties = {
fontSize: '18px',
fontWeight: 700,
margin: 0,
color: '#111827',
};
const sExportBtn: React.CSSProperties = {
padding: '6px 14px',
backgroundColor: '#3b82f6',
color: '#fff',
border: 'none',
borderRadius: '6px',
fontSize: '12px',
fontWeight: 600,
cursor: 'pointer',
};

/* Filter bar */
const sFilterBar: React.CSSProperties = {
display: 'flex',
gap: '10px',
padding: '12px 20px',
backgroundColor: '#fff',
borderBottom: '1px solid #e5e7eb',
flexWrap: 'wrap' as const,
alignItems: 'center',
};
const sInput: React.CSSProperties = {
padding: '6px 10px',
border: '1px solid #d1d5db',
borderRadius: '6px',
fontSize: '13px',
fontFamily: 'inherit',
};
const sSelect: React.CSSProperties = {
padding: '6px 10px',
border: '1px solid #d1d5db',
borderRadius: '6px',
fontSize: '13px',
fontFamily: 'inherit',
backgroundColor: '#fff',
};

/* Table */
const sTableWrap: React.CSSProperties = {
flex: 1,
overflow: 'auto' as const,
padding: '0 20px',
};
const sTable: React.CSSProperties = {
width: '100%',
borderCollapse: 'collapse' as const,
fontSize: '13px',
backgroundColor: '#fff',
};
const sTh: React.CSSProperties = {
padding: '10px 12px',
textAlign: 'left' as const,
borderBottom: '2px solid #e5e7eb',
fontWeight: 600,
color: '#374151',
cursor: 'pointer',
userSelect: 'none' as const,
whiteSpace: 'nowrap' as const,
position: 'sticky' as const,
top: 0,
backgroundColor: '#f9fafb',
};
const sTd: React.CSSProperties = {
padding: '8px 12px',
borderBottom: '1px solid #f3f4f6',
color: '#374151',
};
const sClickableRow: React.CSSProperties = {
cursor: 'pointer',
};

/* Pagination */
const sPagination: React.CSSProperties = {
display: 'flex',
alignItems: 'center',
justifyContent: 'center',
gap: '6px',
padding: '12px 20px',
backgroundColor: '#fff',
borderTop: '1px solid #e5e7eb',
};
const sPageBtn: React.CSSProperties = {
padding: '4px 10px',
border: '1px solid #d1d5db',
borderRadius: '4px',
fontSize: '12px',
cursor: 'pointer',
backgroundColor: '#fff',
color: '#374151',
};
const sPageBtnActive: React.CSSProperties = {
...sPageBtn,
backgroundColor: '#3b82f6',
color: '#fff',
borderColor: '#3b82f6',
};
const sPageBtnDisabled: React.CSSProperties = {
...sPageBtn,
opacity: 0.4,
cursor: 'not-allowed',
};
const sPageInfo: React.CSSProperties = {
fontSize: '12px',
color: '#6b7280',
margin: '0 8px',
};

/* Pre-declared inline styles to avoid double-brace conflict */
const sSearchInput: React.CSSProperties = { ...sInput, minWidth: '180px' };
const sResultCount: React.CSSProperties = { fontSize: '12px', color: '#6b7280' };
const sEmptyCell: React.CSSProperties = { ...sTd, textAlign: 'center', padding: '32px', color: '#9ca3af' };
const sIdCell: React.CSSProperties = { ...sTd, fontFamily: 'monospace', fontSize: '12px' };
const sCenterCell: React.CSSProperties = { ...sTd, textAlign: 'center' };

/* Badge style — helper function */
function badgeStyle(status: ApprovalStatus): React.CSSProperties {
const base: React.CSSProperties = {
display: 'inline-block',
padding: '2px 8px',
borderRadius: '10px',
fontSize: '11px',
fontWeight: 600,
textTransform: 'capitalize' as const,
};
const map: Record<ApprovalStatus, { bg: string; color: string }> = {
    pending: { bg: '#fef3c7', color: '#92400e' },
    approved: { bg: '#d1fae5', color: '#065f46' },
    rejected: { bg: '#fee2e2', color: '#991b1b' },
    escalated: { bg: '#fce7f3', color: '#9d174d' },
    delegated: { bg: '#e0e7ff', color: '#3730a3' },
    expired: { bg: '#f3f4f6', color: '#4b5563' },
    cancelled: { bg: '#f3f4f6', color: '#6b7280' },
    };
    const c = map[status] || map.pending;
    return { ...base, backgroundColor: c.bg, color: c.color };
    }

    /* Helper: icon sort */
    function sortIcon(key: string, sortKey: string | null, sortDir: 'asc' | 'desc'): string {
    if (sortKey !== key) return ' \u2195';
    return sortDir === 'asc' ? ' \u2191' : ' \u2193';
    }

    /* ---- Utility ---- */
    function formatDate(iso: string | null): string {
    if (!iso) return '\u2014';
    const d = new Date(iso);
    return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    /* ---- So luong trang mac dinh ---- */
    const PAGE_SIZE = 15;

    /* ---- Component: ApprovalHistory ---- */
    export function ApprovalHistory({
    requests,
    onExport,
    onSelectRequest,
    }: ApprovalHistoryProps) {
    /* Filter state */
    const [statusFilter, setStatusFilter] = useState<ApprovalStatus | 'all'>('all');
        const [dateFrom, setDateFrom] = useState('');
        const [dateTo, setDateTo] = useState('');
        const [searchText, setSearchText] = useState('');

        /* Sort state */
        const [sortKey, setSortKey] = useState<string | null>('created_at');
            const [sortDir, setSortDir] = useState<'asc' | 'desc'>('desc');

                /* Pagination state */
                const [currentPage, setCurrentPage] = useState(1);

                /* Xy ly click vao column header de sort */
                const handleSort = useCallback(
                (key: string) => {
                if (sortKey === key) {
                setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'));
                } else {
                setSortKey(key);
                setSortDir('asc');
                }
                },
                [sortKey],
                );

                /* Loc va sap xep du lieu */
                const processedData = useMemo(() => {
                let data = [...requests];

                /* Loc theo status */
                if (statusFilter !== 'all') {
                data = data.filter((r) => r.status === statusFilter);
                }

                /* Loc theo search text */
                if (searchText.trim()) {
                const q = searchText.trim().toLowerCase();
                data = data.filter(
                (r) =>
                (r.title || '').toLowerCase().includes(q) ||
                r.request_id.toLowerCase().includes(q) ||
                (r.initiator_id || '').toLowerCase().includes(q),
                );
                }

                /* Loc theo date range */
                if (dateFrom) {
                const from = new Date(dateFrom).getTime();
                data = data.filter((r) => r.created_at && new Date(r.created_at).getTime() >= from);
                }
                if (dateTo) {
                const to = new Date(dateTo);
                to.setHours(23, 59, 59, 999);
                const toTs = to.getTime();
                data = data.filter((r) => r.created_at && new Date(r.created_at).getTime() <= toTs); } /* Sap xep */ if
                    (sortKey) { data.sort((a, b)=> {
                    let valA: string | number = '';
                    let valB: string | number = '';

                    switch (sortKey) {
                    case 'request_id':
                    valA = a.request_id;
                    valB = b.request_id;
                    break;
                    case 'title':
                    valA = a.title || '';
                    valB = b.title || '';
                    break;
                    case 'status':
                    valA = a.status;
                    valB = b.status;
                    break;
                    case 'initiator_id':
                    valA = a.initiator_id;
                    valB = b.initiator_id;
                    break;
                    case 'current_step':
                    valA = a.current_step;
                    valB = b.current_step;
                    break;
                    case 'created_at':
                    valA = a.created_at || '';
                    valB = b.created_at || '';
                    break;
                    case 'updated_at':
                    valA = a.updated_at || '';
                    valB = b.updated_at || '';
                    break;
                    case 'deadline':
                    valA = a.deadline || '';
                    valB = b.deadline || '';
                    break;
                    default:
                    valA = a.request_id;
                    valB = b.request_id;
                    }

                    if (valA < valB) return sortDir==='asc' ? -1 : 1; if (valA> valB) return sortDir === 'asc' ? 1 : -1;
                        return 0;
                        });
                        }

                        return data;
                        }, [requests, statusFilter, searchText, dateFrom, dateTo, sortKey, sortDir]);

                        /* Pagination */
                        const totalPages = Math.max(1, Math.ceil(processedData.length / PAGE_SIZE));
                        const safeCurrentPage = Math.min(currentPage, totalPages);
                        const paginatedData = processedData.slice(
                        (safeCurrentPage - 1) * PAGE_SIZE,
                        safeCurrentPage * PAGE_SIZE,
                        );

                        /* Reset ve trang 1 khi thay doi filter */
                        React.useEffect(() => {
                        setCurrentPage(1);
                        }, [statusFilter, searchText, dateFrom, dateTo]);

                        /* Xuat du lieu */
                        const handleExport = useCallback(() => {
                        onExport?.(processedData);
                        }, [processedData, onExport]);

                        /* Xy li chon request */
                        const handleSelect = useCallback(
                        (id: string) => {
                        onSelectRequest?.(id);
                        },
                        [onSelectRequest],
                        );

                        /* Danh sach column */
                        const columns = [
                        { key: 'request_id', label: 'Request ID' },
                        { key: 'title', label: 'Tieu de' },
                        { key: 'status', label: 'Trang thai' },
                        { key: 'initiator_id', label: 'Nguoi khoi tao' },
                        { key: 'current_step', label: 'Buoc' },
                        { key: 'created_at', label: 'Ngay tao' },
                        { key: 'deadline', label: 'Han' },
                        ];

                        return (
                        <div style={sWrap}>
                            {/* Header */}
                            <div style={sHeader}>
                                <h2 style={sHeaderTitle}>Lich su phe duyet</h2>
                                <button style={sExportBtn} onClick={handleExport}>
                                    \u{1F4E5} Xuat du lieu
                                </button>
                            </div>

                            {/* Filter bar */}
                            <div style={sFilterBar}>
                                <input style={sSearchInput} type="text" placeholder="Tim kiem..." value={searchText}
                                    onChange={(e)=> setSearchText(e.target.value)}
                                />
                                <select style={sSelect} value={statusFilter} onChange={(e)=>
                                    setStatusFilter(e.target.value as ApprovalStatus | 'all')}
                                    >
                                    <option value="all">Tat ca trang thai</option>
                                    <option value="pending">Dang cho</option>
                                    <option value="approved">Da phe duyet</option>
                                    <option value="rejected">Bi tu choi</option>
                                    <option value="escalated">Da leo thang</option>
                                    <option value="delegated">Da uy quyen</option>
                                    <option value="expired">Het han</option>
                                    <option value="cancelled">Bi huy</option>
                                </select>
                                <input style={sInput} type="date" value={dateFrom} onChange={(e)=>
                                setDateFrom(e.target.value)}
                                title="Tu ngay"
                                />
                                <input style={sInput} type="date" value={dateTo} onChange={(e)=>
                                setDateTo(e.target.value)}
                                title="Den ngay"
                                />
                                <span style={sResultCount}>
                                    {processedData.length} ket qua
                                </span>
                            </div>

                            {/* Table */}
                            <div style={sTableWrap}>
                                <table style={sTable}>
                                    <thead>
                                        <tr>
                                            {columns.map((col) => (
                                            <th key={col.key} style={sTh} onClick={()=> handleSort(col.key)}>
                                                {col.label}
                                                {sortIcon(col.key, sortKey, sortDir)}
                                            </th>
                                            ))}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {paginatedData.length === 0 && (
                                        <tr>
                                            <td colSpan={columns.length} style={sEmptyCell}>
                                                Khong co ket qua tim kiem.
                                            </td>
                                        </tr>
                                        )}
                                        {paginatedData.map((req) => (
                                        <tr key={req.request_id} style={sClickableRow} onClick={()=>
                                            handleSelect(req.request_id)}
                                            >
                                            <td style={sIdCell}>{req.request_id}</td>
                                            <td style={sTd}>{req.title || '\u2014'}</td>
                                            <td style={sTd}>
                                                <span style={badgeStyle(req.status)}>{req.status}</span>
                                            </td>
                                            <td style={sTd}>{req.initiator_id}</td>
                                            <td style={sCenterCell}>
                                                {req.current_step}/{req.total_steps}
                                            </td>
                                            <td style={sTd}>{formatDate(req.created_at)}</td>
                                            <td style={sTd}>{formatDate(req.deadline)}</td>
                                        </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>

                            {/* Pagination */}
                            <div style={sPagination}>
                                <button style={safeCurrentPage <=1 ? sPageBtnDisabled : sPageBtn} onClick={()=>
                                    setCurrentPage((p) => Math.max(1, p - 1))}
                                    disabled={safeCurrentPage <= 1}>
                                        \u25C4 Tro ve
                                </button>
                                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                                let pageNum: number;
                                if (totalPages <= 5) { pageNum=i + 1; } else if (safeCurrentPage <=3) { pageNum=i + 1; }
                                    else if (safeCurrentPage>= totalPages - 2) {
                                    pageNum = totalPages - 4 + i;
                                    } else {
                                    pageNum = safeCurrentPage - 2 + i;
                                    }
                                    return (
                                    <button key={pageNum} style={safeCurrentPage===pageNum ? sPageBtnActive : sPageBtn}
                                        onClick={()=> setCurrentPage(pageNum)}
                                        >
                                        {pageNum}
                                    </button>
                                    );
                                    })}
                                    <span style={sPageInfo}>
                                        Trang {safeCurrentPage}/{totalPages}
                                    </span>
                                    <button style={safeCurrentPage>= totalPages ? sPageBtnDisabled : sPageBtn}
                                        onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
                                        disabled={safeCurrentPage >= totalPages}
                                        >
                                        Tien len \u25B6
                                    </button>
                            </div>
                        </div>
                        );
                        }

                        export default ApprovalHistory;