/**
 * API Client Hook - CP06.
 *
 * Custom hook cung cấp HTTP client tự động sinh từ route definitions.
 * Hỗ trợ auto-attach JWT token, error handling, và tenant isolation (KPI-029).
 *
 * Auto-generated bởi Midicoder CE - Không sửa tay.
 */
import { useCallback, useEffect, useRef } from 'react';

// ============================================================================
// Interfaces
// ============================================================================

/**
 * Cấu hình API Client.
 */
export interface ApiClientConfig {
  /** Base URL của API backend. */
  baseUrl: string;
  /** API prefix (ví dụ: /api/v1). */
  apiPrefix: string;
  /** Có tự động attach JWT token không. */
  autoAuth: boolean;
  /** Có enforce tenant scope không (KPI-029). */
  tenantScoped: boolean;
}

/**
 * Response wrapper cho API calls.
 */
export interface ApiResponse<T = any> {
  data: T;
  status: number;
  statusText: string;
  tenantId?: string;
}

/**
 * State cho API request.
 */
export interface RequestState<T = any> {
  data: T | null;
  loading: boolean;
  error: string | null;
}

// ============================================================================
// Default Config
// ============================================================================

const DEFAULT_CONFIG: ApiClientConfig = {
  baseUrl: '',
  apiPrefix: '/api',
  autoAuth: true,
  tenantScoped: true,
};

// ============================================================================
// useApi Hook
// ============================================================================

/**
 * Custom hook để tạo API client.
 *
 * @param config - Cấu hình tùy chọn cho API client
 * @returns API methods (get, post, put, patch, delete)
 */
export function useApi(config?: Partial<ApiClientConfig>) {
  const mergedConfig = { ...DEFAULT_CONFIG, ...config };
  const configRef = useRef(mergedConfig);

  /**
   * Build full URL từ endpoint.
   *
   * @param endpoint - API endpoint
   * @returns Full URL string
   */
  const buildUrl = useCallback(
    (endpoint: string): string => {
      const prefix = configRef.current.apiPrefix;
      const path = endpoint.startsWith('/') ? endpoint : `/${endpoint}`;
      return `${configRef.current.baseUrl}${prefix}${path}`;
    },
    [],
  );

  /**
   * Build headers với auto-auth và tenant isolation.
   *
   * @returns Headers object
   */
  const buildHeaders = useCallback((): Record<string, string> => {
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
    };

    // Tự động attach JWT token
    if (configRef.current.autoAuth) {
      const token = localStorage.getItem('access_token');
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
    }

    // KPI-029: Tenant isolation
    if (configRef.current.tenantScoped) {
      const tenantId = localStorage.getItem('tenant_id');
      if (tenantId) {
        headers['X-Tenant-ID'] = tenantId;
      }
    }

    return headers;
  }, []);

  /**
   * Handle API errors.
   *
   * @param error - Error object
   * @returns Error message string
   */
  const handleError = useCallback((error: any): string => {
    if (error?.message) {
      return error.message;
    }
    if (error?.error?.detail) {
      return error.error.detail;
    }
    if (error?.status === 0) {
      return 'Không thể kết nối đến server. Kiểm tra kết nối mạng.';
    }
    if (error?.status === 401) {
      localStorage.removeItem('access_token');
      localStorage.removeItem('refresh_token');
      window.location.href = '/login';
      return 'Phiên đăng nhập hết hạn. Vui lòng đăng nhập lại.';
    }
    if (error?.status === 403) {
      return 'Không có quyền truy cập tài nguyên này.';
    }
    if (error?.status >= 500) {
      return 'Lỗi server nội bộ. Vui lòng thử lại sau.';
    }
    return 'Lỗi không xác định từ server';
  }, []);

  /**
   * GET request với auto-auth và tenant isolation.
   *
   * @param endpoint - API endpoint
   * @param params - Query parameters
   * @returns Promise response
   */
  const get = useCallback(
    async <T = any>(endpoint: string, params?: Record<string, any>): Promise<ApiResponse<T>> => {
      const url = new URL(buildUrl(endpoint), window.location.origin);
      if (params) {
        Object.entries(params).forEach(([key, value]) => {
          if (value !== undefined && value !== null) {
            url.searchParams.append(key, String(value));
          }
        });
      }

      const response = await fetch(url.toString(), {
        method: 'GET',
        headers: buildHeaders(),
        credentials: 'include',
      });

      if (!response.ok) {
        throw { status: response.status, message: handleError(response) };
      }

      const data = await response.json();
      return {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
      };
    },
    [buildUrl, buildHeaders, handleError],
  );

  /**
   * POST request với auto-auth và tenant isolation.
   *
   * @param endpoint - API endpoint
   * @param body - Request body
   * @returns Promise response
   */
  const post = useCallback(
    async <T = any>(endpoint: string, body?: any): Promise<ApiResponse<T>> => {
      const response = await fetch(buildUrl(endpoint), {
        method: 'POST',
        headers: buildHeaders(),
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'include',
      });

      if (!response.ok) {
        throw { status: response.status, message: handleError(response) };
      }

      const data = await response.json();
      return {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
      };
    },
    [buildUrl, buildHeaders, handleError],
  );

  /**
   * PUT request với auto-auth và tenant isolation.
   *
   * @param endpoint - API endpoint
   * @param body - Request body
   * @returns Promise response
   */
  const put = useCallback(
    async <T = any>(endpoint: string, body?: any): Promise<ApiResponse<T>> => {
      const response = await fetch(buildUrl(endpoint), {
        method: 'PUT',
        headers: buildHeaders(),
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'include',
      });

      if (!response.ok) {
        throw { status: response.status, message: handleError(response) };
      }

      const data = await response.json();
      return {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
      };
    },
    [buildUrl, buildHeaders, handleError],
  );

  /**
   * PATCH request với auto-auth và tenant isolation.
   *
   * @param endpoint - API endpoint
   * @param body - Request body
   * @returns Promise response
   */
  const patch = useCallback(
    async <T = any>(endpoint: string, body?: any): Promise<ApiResponse<T>> => {
      const response = await fetch(buildUrl(endpoint), {
        method: 'PATCH',
        headers: buildHeaders(),
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'include',
      });

      if (!response.ok) {
        throw { status: response.status, message: handleError(response) };
      }

      const data = await response.json();
      return {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
      };
    },
    [buildUrl, buildHeaders, handleError],
  );

  /**
   * DELETE request với auto-auth và tenant isolation.
   *
   * @param endpoint - API endpoint
   * @returns Promise response
   */
  const del = useCallback(
    async <T = any>(endpoint: string): Promise<ApiResponse<T>> => {
      const response = await fetch(buildUrl(endpoint), {
        method: 'DELETE',
        headers: buildHeaders(),
        credentials: 'include',
      });

      if (!response.ok) {
        throw { status: response.status, message: handleError(response) };
      }

      const data = await response.json();
      return {
        data: data as T,
        status: response.status,
        statusText: response.statusText,
      };
    },
    [buildUrl, buildHeaders, handleError],
  );

  return {
    get,
    post,
    put,
    patch,
    delete: del,
  };
}
