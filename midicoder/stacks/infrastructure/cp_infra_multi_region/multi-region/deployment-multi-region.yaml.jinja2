# Multi-Region Deployment — generated by Midicoder CP28
# Deploys application to multiple cloud regions with geo-replication

{% for region in regions %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name | default("app") }}-{{ region.name }}
  namespace: {{ region.name }}
  labels:
    app: {{ app_name | default("app") }}
    region: {{ region.name }}
    provider: {{ region.cloud_provider }}
spec:
  replicas: {{ region.replicas | default(2) }}
  selector:
    matchLabels:
      app: {{ app_name | default("app") }}
      region: {{ region.name }}
  template:
    metadata:
      labels:
        app: {{ app_name | default("app") }}
        region: {{ region.name }}
    spec:
      containers:
        - name: {{ app_name | default("app") }}
          image: {{ region.image | default(app_name ~ ":latest") }}
          ports:
            - containerPort: {{ region.port | default(8000) }}
              protocol: TCP
          env:
            - name: REGION
              value: "{{ region.name }}"
            - name: PRIMARY_REGION
              value: "{% if region.primary %}true{% else %}false{% endif %}"
            - name: ENDPOINT_URL
              value: "{{ region.endpoint_url | default('https://' ~ region.name ~ '.example.com') }}"
          resources:
            limits:
              cpu: {{ region.resources_cpu | default("500m") }}
              memory: {{ region.resources_memory | default("512Mi") }}
            requests:
              cpu: {{ region.resources_cpu | default("250m") }}
              memory: {{ region.resources_memory | default("256Mi") }}
          livenessProbe:
            httpGet:
              path: /health
              port: {{ region.port | default(8000) }}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ region.port | default(8000) }}
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name | default("app") }}-{{ region.name }}
  namespace: {{ region.name }}
spec:
  type: {{ region.service_type | default("ClusterIP") }}
  selector:
    app: {{ app_name | default("app") }}
    region: {{ region.name }}
  ports:
    - port: 80
      targetPort: {{ region.port | default(8000) }}
      protocol: TCP
{% endfor %}
