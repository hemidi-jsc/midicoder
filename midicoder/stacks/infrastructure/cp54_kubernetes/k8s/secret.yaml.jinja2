# CP54: Kubernetes Secret Manifest
# {{ "=".center(66, "=") }}
{% for secret in secrets %}
apiVersion: v1
kind: Secret
metadata:
  name: {{ secret.name }}
  labels:
    app: {{ secret.name }}
type: {{ secret.secret_type }}
data:
{% for key, value in secret.data.items() %}
  {{ key }}: {{ value }}
{% endfor %}
{% if not loop.last %}
---
{% endif %}
{% endfor %}
