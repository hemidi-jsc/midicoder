# terraform.tf
# AWS Infrastructure for {{ config.app_name }}
# Generated by Midicoder - DO NOT EDIT MANUALLY

terraform {
  required_version = ">= 1.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# AWS Provider
provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "{{ config.app_name }}"
      Environment = "{{ config.environment }}"
      ManagedBy   = "midicoder"
    }
  }
}

# ============================================================================
# VPC Configuration
# ============================================================================

resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "{{ config.app_name }}-vpc"
  }
}

# Internet Gateway
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "{{ config.app_name }}-igw"
  }
}

# Public Subnets
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "${data.aws_region.current.name}a"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ config.app_name }}-public-a"
    Type = "public"
  }
}

resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "${data.aws_region.current.name}b"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ config.app_name }}-public-b"
    Type = "public"
  }
}

# Private Subnets
resource "aws_subnet" "private_a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.10.0/24"
  availability_zone = "${data.aws_region.current.name}a"

  tags = {
    Name = "{{ config.app_name }}-private-a"
    Type = "private"
  }
}

resource "aws_subnet" "private_b" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.20.0/24"
  availability_zone = "${data.aws_region.current.name}b"

  tags = {
    Name = "{{ config.app_name }}-private-b"
    Type = "private"
  }
}

# Route Table for Public Subnets
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "{{ config.app_name }}-public-rt"
  }
}

# Route Table for Private Subnets (with NAT Gateway)
resource "aws_eip" "nat" {
  domain = "vpc"

  tags = {
    Name = "{{ config.app_name }}-nat-eip"
  }
}

resource "aws_nat_gateway" "main" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.public_a.id

  tags = {
    Name = "{{ config.app_name }}-nat-gw"
  }
}

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.main.id
  }

  tags = {
    Name = "{{ config.app_name }}-private-rt"
  }
}

# Route Table Associations
resource "aws_route_table_association" "public_a" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "public_b" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "private_a" {
  subnet_id      = aws_subnet.private_a.id
  route_table_id = aws_route_table.private.id
}

resource "aws_route_table_association" "private_b" {
  subnet_id      = aws_subnet.private_b.id
  route_table_id = aws_route_table.private.id
}

# ============================================================================
# Security Groups
# ============================================================================

# API Security Group
resource "aws_security_group" "api" {
  name_prefix = "{{ config.app_name }}-api-"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow HTTP from anywhere"
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow HTTPS from anywhere"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ config.app_name }}-api-sg"
  }
}

# Database Security Group
resource "aws_security_group" "database" {
  name_prefix = "{{ config.app_name }}-db-"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.api.id]
    description     = "Allow PostgreSQL from API"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ config.app_name }}-db-sg"
  }
}

# Redis Security Group
resource "aws_security_group" "redis" {
  name_prefix = "{{ config.app_name }}-redis-"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port       = 6379
    to_port         = 6379
    protocol        = "tcp"
    security_groups = [aws_security_group.api.id]
    description     = "Allow Redis from API"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ config.app_name }}-redis-sg"
  }
}

# ============================================================================
# Data Sources
# ============================================================================

data "aws_region" "current" {}

data "aws_availability_zones" "available" {
  state = "available"
}

# ============================================================================
# Modules
# ============================================================================

{% if config.use_ecs %}
# API Module (ECS Fargate)
module "api" {
  source              = "./modules/api"
  app_name            = "{{ config.app_name }}"
  environment         = "{{ config.environment }}"
  vpc_id              = aws_vpc.main.id
  subnet_ids          = [aws_subnet.private_a.id, aws_subnet.private_b.id]
  security_group_ids  = [aws_security_group.api.id]
  aws_region          = var.aws_region
  ecs_cpu             = {{ config.ecs_cpu }}
  ecs_memory          = {{ config.ecs_memory }}
  
  depends_on = [aws_internet_gateway.main]
}
{% endif %}

{% if config.db_engine == "postgres" %}
# RDS Module (PostgreSQL)
module "rds" {
  source                  = "./modules/rds"
  app_name                = "{{ config.app_name }}"
  vpc_id                  = aws_vpc.main.id
  subnet_ids              = [aws_subnet.private_a.id, aws_subnet.private_b.id]
  security_group_ids      = [aws_security_group.database.id]
  engine                  = "{{ config.db_engine }}"
  engine_version          = "{{ config.db_version }}"
  instance_class          = "{{ config.db_instance_class }}"
  allocated_storage       = {{ config.db_allocated_storage }}
  postgres_password       = var.postgres_password
  
  depends_on = [aws_internet_gateway.main]
}
{% endif %}

{% if config.use_redis %}
# ElastiCache Module (Redis)
module "redis" {
  source             = "./modules/redis"
  app_name           = "{{ config.app_name }}"
  vpc_id             = aws_vpc.main.id
  subnet_ids         = [aws_subnet.private_a.id, aws_subnet.private_b.id]
  security_group_ids = [aws_security_group.redis.id]
  node_type          = "{{ config.redis_node_type }}"
  num_cache_nodes    = {{ config.redis_num_nodes }}
}
{% endif %}

{% if config.use_s3 %}
# S3 Module
module "s3" {
  source            = "./modules/s3"
  app_name          = "{{ config.app_name }}"
  bucket_prefix     = "{{ config.s3_bucket_prefix }}"
  environment       = "{{ config.environment }}"
}
{% endif %}

# Secrets Manager Module
module "secrets" {
  source             = "./modules/secrets"
  app_name           = "{{ config.app_name }}"
  environment        = "{{ config.environment }}"
  postgres_password  = var.postgres_password
  neo4j_password     = var.neo4j_password
  jwt_secret         = var.jwt_secret
}