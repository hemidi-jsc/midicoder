# outputs.tf
# Terraform Outputs for {{ config.app_name }}
# Generated by Midicoder - DO NOT EDIT MANUALLY

# ============================================================================
# VPC Outputs
# ============================================================================

output "vpc_id" {
  description = "ID of the VPC"
  value       = aws_vpc.main.id
}

output "public_subnet_ids" {
  description = "List of public subnet IDs"
  value       = [aws_subnet.public_a.id, aws_subnet.public_b.id]
}

output "private_subnet_ids" {
  description = "List of private subnet IDs"
  value       = [aws_subnet.private_a.id, aws_subnet.private_b.id]
}

# ============================================================================
# Security Group Outputs
# ============================================================================

output "api_security_group_id" {
  description = "ID of the API security group"
  value       = aws_security_group.api.id
}

output "database_security_group_id" {
  description = "ID of the database security group"
  value       = aws_security_group.database.id
}

output "redis_security_group_id" {
  description = "ID of the Redis security group"
  value       = aws_security_group.redis.id
}

# ============================================================================
# API Outputs
# ============================================================================

{% if config.use_ecs %}
output "api_url" {
  description = "URL of the API"
  value       = module.api.alb_dns_name
}

output "api_cluster_arn" {
  description = "ARN of the ECS cluster"
  value       = module.api.cluster_arn
}

output "api_task_arn" {
  description = "ARN of the ECS task"
  value       = module.api.task_arn
}
{% endif %}

# ============================================================================
# Database Outputs
# ============================================================================

{% if config.db_engine == "postgres" %}
output "rds_endpoint" {
  description = "RDS endpoint"
  value       = module.rds.endpoint
  sensitive   = true
}

output "rds_port" {
  description = "RDS port"
  value       = module.rds.port
}

output "rds_arn" {
  description = "ARN of the RDS instance"
  value       = module.rds.arn
}
{% endif %}

# ============================================================================
# Redis Outputs
# ============================================================================

{% if config.use_redis %}
output "redis_endpoint" {
  description = "Redis endpoint"
  value       = module.redis.endpoint
  sensitive   = true
}

output "redis_port" {
  description = "Redis port"
  value       = module.redis.port
}
{% endif %}

# ============================================================================
# S3 Outputs
# ============================================================================

{% if config.use_s3 %}
output "s3_bucket_name" {
  description = "Name of the S3 bucket"
  value       = module.s3.bucket_name
}

output "s3_bucket_arn" {
  description = "ARN of the S3 bucket"
  value       = module.s3.bucket_arn
}
{% endif %}

# ============================================================================
# Secrets Outputs
# ============================================================================

output "secrets_arns" {
  description = "ARNs of secrets in AWS Secrets Manager"
  value       = module.secrets.secrets_arns
  sensitive   = true
}