# CP54: Kubernetes HorizontalPodAutoscaler Manifest
# {{ "=".center(66, "=") }}
{% for hpa in hpas %}
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ hpa.id }}
  labels:
    app: {{ hpa.deployment_id }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ hpa.deployment_id }}
  minReplicas: {{ hpa.min_replicas }}
  maxReplicas: {{ hpa.max_replicas }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ hpa.target_cpu }}
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: {{ hpa.target_memory }}
{% if not loop.last %}
---
{% endif %}
{% endfor %}
