# Cross-Region VPC Peering — generated by Midicoder CP28
# Creates VPC peering connections between regions for low-latency replication

locals {
  regions = [
    {% for region in regions %}
    {
      name         = "{{ region.name }}"
      provider     = "{{ region.cloud_provider | default("aws") }}"
      cidr_block   = "{{ region.cidr_block | default("10." ~ loop.index ~ ".0.0/16") }}"
      availability_zones = [
        {% for az in region.availability_zones %}
        "{{ az }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {% endfor %}
  ]
}

# Provider for each region
{% for region in regions %}
provider "aws" {
  alias  = "{{ region.name }}"
  region = "{{ region.name }}"
}

resource "aws_vpc" "{{ region.name }}" {
  provider            = aws.{{ region.name }}
  cidr_block          = "10.{{ loop.index }}.0.0/16"
  enable_dns_support  = true
  enable_dns_hostnames = true

  tags = {
    Name        = "{{ app_name | default("app") }}-{{ region.name }}"
    Environment = "{{ environment | default("production") }}"
    ManagedBy   = "midicoder-cp28"
  }
}

resource "aws_subnet" "{{ region.name }}_public" {
  provider             = aws.{{ region.name }}
  vpc_id               = aws_vpc.{{ region.name }}.id
  cidr_block           = "10.{{ loop.index }}.1.0/24"
  availability_zone    = "{{ region.availability_zones[0] if region.availability_zones else region.name ~ "a" }}"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ app_name | default("app") }}-{{ region.name }}-public"
  }
}
{% endfor %}

# VPC Peering connections between primary and each secondary region
{% for region in regions %}
{% if not region.primary %}
resource "aws_vpc_peering_connection" "primary_to_{{ region.name }}" {
  vpc_id      = aws_vpc.us_east_1.id
  peer_vpc_id = aws_vpc.{{ region.name }}.id
  auto_accept = true

  tags = {
    Name = "peering-primary-{{ region.name }}"
  }
}

resource "aws_vpc_peering_connection_route_table_association" "primary_to_{{ region.name }}_primary" {
  route_table_id            = aws_vpc.us_east_1.main_route_table_id
  vpc_peering_connection_id = aws_vpc_peering_connection.primary_to_{{ region.name }}.id
  route_cidr_block          = "10.{{ loop.index }}.0.0/16"
}

resource "aws_vpc_peering_connection_route_table_association" "primary_to_{{ region.name }}_peer" {
  route_table_id            = aws_vpc.{{ region.name }}.main_route_table_id
  vpc_peering_connection_id = aws_vpc_peering_connection.primary_to_{{ region.name }}.id
  route_cidr_block          = "10.1.0.0/16"
}
{% endif %}
{% endfor %}
