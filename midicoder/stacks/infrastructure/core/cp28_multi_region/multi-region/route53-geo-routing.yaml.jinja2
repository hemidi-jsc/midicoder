# Route53 Geo-Routing DNS Records — generated by Midicoder CP28
{% if geo_routing_rules %}
route53:
  hosted_zone: "{{ hosted_zone | default('example.com') }}"
  records:
    {% for rule in geo_routing_rules %}
    - name: "{{ rule.name }}"
      type: A
      alias_target:
        dns_name: "{{ rule.dns_name }}"
        evaluate_target_health: true
      geo_routing:
        strategy: "{{ rule.strategy | default('latency') }}"
        {% for region_entry in rule.regions %}
        regions:
          - region: "{{ region_entry.region }}"
            weight: {{ region_entry.weight | default(1) }}
            endpoint: "{{ region_entry.endpoint }}"
            health_check_id: "{{ region_entry.health_check_id | default(region_entry.region ~ '-health') }}"
        {% endfor %}
      fallback_region: "{{ rule.fallback_region | default('us-east-1') }}"
    {% endfor %}
{% else %
route53:
  hosted_zone: "{{ hosted_zone | default('example.com') }}"
  records:
    - name: "{{ app_name | default('app') }}.example.com"
      type: A
      alias_target:
        dns_name: "app-us-east-1.example.com"
        evaluate_target_health: true
      geo_routing:
        strategy: "latency"
        regions:
          - region: "us-east-1"
            weight: 1
            endpoint: "app-us-east-1.example.com"
          - region: "eu-west-1"
            weight: 1
            endpoint: "app-eu-west-1.example.com"
      fallback_region: "us-east-1"
{% endif %}
