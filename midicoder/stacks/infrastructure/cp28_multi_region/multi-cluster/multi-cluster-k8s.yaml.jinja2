# Multi-Cluster Kubernetes Configuration — generated by Midicoder CP28
# Manages multiple K8s clusters across regions with unified config

apiVersion: v1
kind: Config
preferences: {}
clusters:
{% for region in regions %}
  - cluster:
      certificate-authority-data: {{ region.ca_cert | default("CHANGE_ME_CA_CERT_" ~ region.name) }}
      server: {{ region.k8s_api_endpoint | default("https://k8s-" ~ region.name ~ ".example.com:6443") }}
    name: {{ app_name | default("app") }}-{{ region.name }}
{% endfor %}

contexts:
{% for region in regions %}
  - context:
      cluster: {{ app_name | default("app") }}-{{ region.name }}
      namespace: {{ app_name | default("app") }}-{{ region.name }}
      user: {{ app_name | default("app") }}-{{ region.name }}
    name: {{ app_name | default("app") }}-{{ region.name }}
{% endfor %}

current-context: {{ (regions | selectattr("primary") | first).name | default("us-east-1") }}

users:
{% for region in regions %}
  - name: {{ app_name | default("app") }}-{{ region.name }}
    user:
      token: {{ region.k8s_token | default("CHANGE_ME_TOKEN_" ~ region.name) }}
{% endfor %}

# --- Multi-cluster service mesh configuration ---
{% if service_mesh | default(false) %}
---
apiVersion: multicluster.x-k8s.io/v1alpha1
kind: ServiceImport
metadata:
  name: {{ app_name | default("app") }}-headless
  namespace: {{ app_name | default("app") }}
spec:
  type: Headless
  ports:
    - name: http
      port: {{ default_port | default(8000) }}
      protocol: TCP
  sessionAffinity: None
{% endif %}
