"""
Automated Failover Lambda — generated by Midicoder CP28

Monitors region health and triggers DNS failover when primary region becomes
unavailable. Uses Route53 API to update weighted/latency-based DNS records.
"""

import json
import logging
import os
import boto3
from typing import Any

logger = logging.getLogger()
logger.setLevel(logging.INFO)

ROUTE53_CLIENT = boto3.client("route53")
HOSTED_ZONE_ID = os.environ.get("HOSTED_ZONE_ID", "")
PRIMARY_REGION = os.environ.get("PRIMARY_REGION", "us-east-1")
FAILOVER_REGIONS = json.loads(os.environ.get("FAILOVER_REGIONS", '[{"region": "eu-west-1", "weight": 100}]'))

# Region health endpoints to check
REGION_ENDPOINTS = json.loads(os.environ.get("REGION_ENDPOINTS", "{}"))


def check_region_health(region: str) -> bool:
    """Check if a region is healthy via HTTP health endpoint."""
    import urllib.request
    import urllib.error

    endpoint = REGION_ENDPOINTS.get(region)
    if not endpoint:
        return False

    try:
        req = urllib.request.Request(endpoint, method="GET")
        with urllib.request.urlopen(req, timeout=5) as response:
            return response.status == 200
    except (urllib.error.URLError, urllib.error.HTTPError, Exception):
        return False


def update_dns_records(healthy_regions: list[str]) -> None:
    """Update Route53 DNS records to route traffic to healthy regions."""
    changes = []

    for i, failover_region in enumerate(FAILOVER_REGIONS):
        region_name = failover_region["region"]
        is_healthy = region_name in healthy_regions
        weight = failover_region.get("weight", 100) if is_healthy else 0

        change = {
            "Action": "UPSERT",
            "ResourceRecordSet": {
                "Name": os.environ.get("DNS_NAME", "app.example.com"),
                "Type": "A",
                "SetIdentifier": region_name,
                "Region": region_name,
                "Weight": weight,
                "AliasTarget": {
                    "HostedZoneId": failover_region.get("hosted_zone_id", ""),
                    "DNSName": failover_region.get("dns_name", ""),
                    "EvaluateTargetHealth": True,
                },
            },
        }
        changes.append(change)

    if changes:
        ROUTE53_CLIENT.change_resource_record_sets(
            HostedZoneId=HOSTED_ZONE_ID,
            ChangeBatch={"Changes": changes},
        )
        logger.info(f"DNS records updated for {len(changes)} regions")


def lambda_handler(event: dict[str, Any], context: Any) -> dict[str, Any]:
    """Lambda entry point — check all regions and failover if needed."""
    healthy_regions = []

    # Check primary region
    if check_region_health(PRIMARY_REGION):
        healthy_regions.append(PRIMARY_REGION)

    # Check all configured regions
    for failover_region in FAILOVER_REGIONS:
        region_name = failover_region["region"]
        if check_region_health(region_name):
            healthy_regions.append(region_name)

    if not healthy_regions:
        logger.critical("No healthy regions found!")
        return {"status": "CRITICAL", "healthy_regions": []}

    if PRIMARY_REGION not in healthy_regions:
        logger.warning(f"Primary region {PRIMARY_REGION} is DOWN! Initiating failover...")

    update_dns_records(healthy_regions)

    return {
        "status": "OK" if PRIMARY_REGION in healthy_regions else "FAILOVER_ACTIVE",
        "healthy_regions": healthy_regions,
        "primary_region": PRIMARY_REGION,
    }


if __name__ == "__main__":
    logger.info("Running failover check locally...")
    result = lambda_handler({}, None)
    print(json.dumps(result, indent=2))
